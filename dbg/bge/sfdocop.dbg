      590   procedure xmlchar-decode :
      591   define input parameter p-in-string      as character        no-undo.
      592   define output parameter p-out-string    as character        no-undo.
      593       define variable v-position      as integer      no-undo.
      594       define variable v-last-position as integer      no-undo.
      595       define variable v-temp-integer  as integer      no-undo.
      596       define variable v-current-char  as character    no-undo.
      597       define variable v-next-char     as character    no-undo.
      598       define variable v-success       as logical      no-undo.
      599   do
      600   on error undo, return error
      601   :
      602       assign
      603           p-out-string = "":U
      604           v-position   = 0
      605       .
      606       replace-cycle:
      607       do while yes
      608       on error undo, return error
      609       :
      610           assign
      611               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      612           .
      613           if v-last-position <= v-position
      614           then do:
      615               if v-position = 0
      616               then do:
      617                   assign
      618                       p-out-string = p-in-string
      619                   .
      620               end.
      621               else do:
      622                   assign
      623                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      624                   .
      625               end.
      626               leave replace-cycle.
      627           end.
      628           else do:
      629               assign
      630                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      631                   v-position      = v-last-position
      632                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      633               .
      634               if v-current-char = "#":U
      635               then do:
      636                   assign
      637                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      638                   .
      639                   if v-last-position > 0
      640                   then do:
      641                       run xmlchar-read-integer in this-procedure
      642                        (
      643                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      644                           , output v-temp-integer
      645                           , output v-success
      646                       ).
      647                       if v-success = yes
      648                       and v-temp-integer >= 1
      649                       and v-temp-integer <= 255
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + chr( v-temp-integer )
      653                               v-position   = v-last-position + 1
      654                           .
      655                       end.
      656                       else do:
      657                           assign
      658                               p-out-string = p-out-string + "&":U
      659                               v-position   = v-position   + 1
      660                           .
      661                       end.
      662                   end.
      663                   else do:
      664                       assign
      665                           p-out-string = p-out-string + "&":U
      666                           v-position   = v-position   + 1
      667                       .
      668                   end.
      669               end.
      670               else do:
      671                   case substring( p-in-string, v-position + 1, 3 )
      672                   :
      673                       when "lt;":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + "<":U
      677                               v-position   = v-position   + 3
      678                           .
      679                       end.
      680                       when "gt;":U
      681                       then do:
      682                           assign
      683                               p-out-string = p-out-string + ">":U
      684                               v-position   = v-position   + 3
      685                           .
      686                       end.
      687                       otherwise do:
      688                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      689                           then do:
      690                               assign
      691                                   p-out-string = p-out-string + "&":U
      692                                   v-position   = v-position   + 4
      693                               .
      694                           end.
      695                           else do:
      696                               case substring( p-in-string, v-position + 1, 5 )
      697                               :
      698                                   when "quot;":U
      699                                   then do:
      700                                       assign
      701                                           p-out-string = p-out-string + '"':U
      702                                           v-position   = v-position   + 5
      703                                       .
      704                                   end.
      705                                   when "apos;":U
      706                                   then do:
      707                                       assign
      708                                           p-out-string = p-out-string + "'":U
      709                                           v-position   = v-position   + 5
      710                                       .
      711                                   end.
      712                                   otherwise do:
      713                                       assign
      714                                           p-out-string = p-out-string + "&":U
      715                                       .
      716                                   end.
      717                               end case.
      718                           end.
      719                       end.
      720                   end case.
      721               end.
      722           end.
      723       end.
      724   end.
      725   end .
      726   procedure xmlchar-read-integer :
      727   define input parameter p-input-string      as character        no-undo.
      728   define output parameter p-output-integer   as integer          no-undo.
      729   define output parameter p-success       as logical          no-undo.
      730   do
      731   on error undo, return error
      732   :
      733       assign
      734           p-output-integer = integer( p-input-string )
      735       no-error.
      736       if error-status :error
      737       then do:
      738           assign
      739               p-success           = no
      740               p-output-integer    = 0
      741           .
      742       end.
      743       else do:
      744           assign
      745               p-success           = yes
      746           .
      747       end.
      748   end.
      749   end.
      750   define variable v-bgelib-bgeclall           as logical      no-undo.
      751   define variable v-bgelib-bgedict            as logical      no-undo.
      752   define temp-table temp_ext-doc-type no-undo
      753       field edt-key               as integer
      754       field ext-doc-type          as character
      755       field ext-doc-type-label    as character
      756       index pi is primary unique
      757           edt-key
      758   .
      759   define temp-table temp_bgelib_goods no-undo
      760       field gds-code as integer
      761       index pi is primary unique
      762           gds-code
      763   .
      764   define temp-table temp_bgelib_clients no-undo
      765       field obj-type as character
      766       field obj-code as integer
      767       index pi is primary unique
      768           obj-type
      769           obj-code
      770   .
      771   define temp-table temp_bgelib_dis-card no-undo
      772       field d-card as character
      773       index pi is primary unique
      774           d-card
      775   .
      776   define temp-table temp_bgelib_trn-doc no-undo
      777       field doc-code as integer
      778   .
      779   procedure bgelib-tag-open:
      780   do
      781   on error undo, return error
      782   :
      783   define input parameter v-tag-level  as integer      no-undo.
      784   define input parameter v-tag-name   as character    no-undo.
      785   define input parameter v-tag-value  as character    no-undo.
      786       put stream stmXMLOut unformatted
      787           chr(10)
      788           + fill(" ", 4 * v-tag-level)
      789           + "<" + v-tag-name
      790           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      791           + v-tag-value + ">"
      792       .
      793   end.
      794   end procedure.
      795   procedure bgelib-tag-put:
      796   do
      797   on error undo, return error
      798   :
      799   define input parameter v-tag-level      as integer      no-undo.
      800   define input parameter v-tag-name       as character    no-undo.
      801   define input parameter v-tag-value      as character    no-undo.
      802   define input parameter v-empty-mode     as integer      no-undo.
      803       v-tag-name = trim(v-tag-name).
      804       if  v-empty-mode = 1
      805       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      806       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      807       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      808       then do:
      809           run xmlchar-encode in this-procedure (
      810                 input v-tag-value
      811               , output v-tag-value
      812           ).
      813           put stream stmXMLOut unformatted
      814               chr(10) + fill(" ", 4 * v-tag-level)
      815                           + '<' + v-tag-name + '>'
      816                           + v-tag-value
      817                           + '</' + v-tag-name + '>'
      818           .
      819       end.
      820   end.
      821   end procedure.
      822   procedure bgelib-tag-close:
      823   do
      824   on error undo, return error
      825   :
      826   define input parameter v-tag-level as integer      no-undo.
      827   define input parameter v-tag-name  as character    no-undo.
      828       put stream stmXMLOut unformatted
      829           chr(10)
      830           + fill( " ", 4 * v-tag-level)
      831           + '</' + v-tag-name + '>'
      832       .
      833   end.
      834   end procedure.
      835   procedure bgelib-write-log:
      836   do
      837   on error undo, return error
      838   :
      839   define input parameter v-filename   as character    no-undo.
      840   define input parameter v-log-level  as integer      no-undo.
      841   define input parameter v-out-string as character    no-undo.
      842       output stream stmXMLLog to value( v-filename ) append.
      843       put stream stmXMLLog unformatted
      844           chr(10)
      845       .
      846       put stream stmXMLLog unformatted
      847           ( if v-log-level = 0
      848             or v-out-string = "&DLine"
      849             or v-out-string = "&Line"
      850             then ""
      851             else cur-time-string-sec() + " " )
      852       .
      853       put stream stmXMLLog unformatted
      854           ( if v-out-string = "&Line"
      855             then fill( "-", 80 )
      856             else if v-out-string = "&DLine"
      857                  then fill( "=", 80 )
      858                  else v-out-string )
      859       .
      860       output stream stmXMLLog close.
      861   end.
      862   end procedure.
      863   procedure bgelib-write-edt:
      864   do
      865   on error undo, return error
      866   :
      867   define input parameter v-editor-handle    as handle       no-undo.
      868   define input parameter v-log-level        as integer      no-undo.
      869   define input parameter v-out-string       as character    no-undo.
      870       if valid-handle ( v-editor-handle )
      871       then do:
      872           v-editor-handle :move-to-eof().
      873           v-editor-handle :insert-string( ( if v-log-level = 0
      874                                             or v-out-string = "&DLine"
      875                                             or v-out-string = "&Line"
      876                                             then ""
      877                                             else cur-time-string-sec() + " "
      878                                         ) ).
      879           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      880                                             then fill( "-", 80 )
      881                                             else if v-out-string = "&DLine" then fill("=", 80)
      882                                             else fill( " ", v-log-level) + v-out-string
      883                                         ) ).
      884           v-editor-handle :insert-string( chr(10) ).
      885       end.
      886       process events.
      887       output to 'bgescn.txt' append.
      888           put unformatted
      889               chr(10)
      890               string( ( if v-log-level = 0
      891                         or v-out-string = "&DLine"
      892                         or v-out-string = "&Line"
      893                         then ""
      894                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      895                     ) )
      896               string( ( if v-out-string = "&Line"
      897                         then fill( "-", 80 )
      898                         else if v-out-string = "&DLine"
      899                              then fill( "=", 80 )
      900                              else fill( " ", v-log-level ) + v-out-string
      901                     ) )
      902           .
      903       output close.
      904   end.
      905   end procedure.
      906   procedure bgelib-show-cnt:
      907   do
      908   on error undo, return error
      909   :
      910   define input parameter v-fillin-handle     as handle   no-undo.
      911       if valid-handle( v-fillin-handle )
      912       then do:
      913           assign
      914               v-fillin-handle :visible = true
      915           .
      916       end.
      917   end.
      918   end procedure.
      919   procedure bgelib-hide-cnt:
      920   do
      921   on error undo, return error
      922   :
      923   define input parameter v-fillin-handle     as handle   no-undo.
      924       if valid-handle( v-fillin-handle )
      925       then do:
      926           assign v-fillin-handle :visible = false.
      927       end.
      928   end.
      929   end procedure.
      930   procedure bgelib-write-cnt:
      931   do
      932   on error undo, return error
      933   :
      934   define input parameter v-fillin-handle    as handle       no-undo.
      935   define input parameter v-fillin-string    as character    no-undo.
      936       if valid-handle( v-fillin-handle )
      937       then do:
      938           assign
      939               v-fillin-handle :SCREEN-value = v-fillin-string
      940           .
      941       end.
      942   end.
      943   end procedure.
      944   procedure bgelib-write-header:
      945   do
      946   on error undo, return error
      947   :
      948   define input parameter p-first-file     as logical      no-undo.
      949   define input parameter p-xml-file-name  as character    no-undo.
      950   define input parameter p-list-file-name as character    no-undo.
      951   define input parameter p-file-number    as integer      no-undo.
      952   define input parameter p-have-prev      as logical      no-undo.
      953   define input parameter p-prev-filename  as character    no-undo.
      954   define input parameter p-obj-list       as character    no-undo.
      955   define input parameter p-doc-type-list  as character    no-undo.
      956   define input parameter p-parameter-list as character    no-undo.
      957       define variable v-counter    as integer        no-undo.
      958       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      959       put stream stmXMLOut unformatted
      960           "<?xml version='1.0' encoding='windows-1251'?>"
      961       .
      962       run bgelib-tag-open( input 0, input "root"  , input "" ).
      963       run bgelib-tag-open( input 0, input "header", input "" ).
      964       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      965       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      966       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      967       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      968       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      969       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      970       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      971       :
      972           run bgelib-tag-put(
      973                 input 1
      974               , input entry( 2 * v-counter, p-parameter-list )
      975               , input entry( 2 * v-counter + 1, p-parameter-list )
      976               , input 0
      977           ).
      978       end.
      979       run bgelib-tag-close( input 0, input "header" ).
      980       output stream stmXMLOut close.
      981       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      982       if p-first-file = yes
      983       then do:
      984           put stream stmXMLOut unformatted
      985               "<?xml version='1.0' encoding='windows-1251'?>"
      986           .
      987           run bgelib-tag-open( input 0, input "export", input "" ).
      988       end.
      989       run bgelib-tag-open( input 1, input "file", input "" ).
      990       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      991       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      992       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      993       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      994       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      995       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      996       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      997       :
      998           run bgelib-tag-put(
      999                 input 2
     1000               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1001               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1002               , input 0
     1003           ).
     1004       end.
     1005       run bgelib-tag-close( input 1, input "file" ).
     1006       output stream stmXMLOut close.
     1007   end.
     1008   end procedure.
     1009   procedure bgelib-write-footer:
     1010   do
     1011   on error undo, return error
     1012   :
     1013   define input parameter p-last-file      as logical      no-undo.
     1014   define input parameter p-xml-file-name  as character    no-undo.
     1015   define input parameter p-list-file-name as character    no-undo.
     1016   define input parameter p-have-next      as logical      no-undo.
     1017   define input parameter p-next-file-name as character    no-undo.
     1018       define variable v-error-num     as integer           no-undo.
     1019       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1020       if p-have-next = yes
     1021       then do:
     1022           run bgelib-tag-open( input 0, input "footer", "" ).
     1023           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1024           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1025           run bgelib-tag-close( input 0, input "footer" ).
     1026       end.
     1027       run bgelib-tag-close( input 0, input "root" ).
     1028       output stream stmXMLOut close.
     1029       run bge/os_copy.p (
     1030             input "M"
     1031           , input p-xml-file-name + "tmp"
     1032           , input p-xml-file-name + "xml"
     1033           , output v-error-num
     1034       ).
     1035       if p-last-file = yes
     1036       then do:
     1037           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1038               run bgelib-tag-close( input 0, input "export" ).
     1039           output stream stmXMLOut close.
     1040           run bge/os_copy.p (
     1041                 input "M"
     1042               , input p-list-file-name + "tmp"
     1043               , input p-list-file-name + "xml"
     1044               , output v-error-num
     1045           ).
     1046       end.
     1047   end.
     1048   end procedure.
     1049   procedure bgelib-filename :
     1050   do
     1051   on error undo, return error
     1052   :
     1053   define input parameter p-prefix             as character    no-undo.
     1054   define output parameter p-xml-file-name     as character    no-undo.
     1055   define output parameter p-log-file-name     as character    no-undo.
     1056   define output parameter p-list-file-name    as character    no-undo.
     1057       define variable v-home-dir  as character    no-undo.
     1058       define variable v-error-num as integer      no-undo.
     1059       get-key-value section "BGE" key "outdir" value v-home-dir.
     1060       if v-home-dir = ?
     1061       then do:
     1062           message
     1063             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1064             skip(1)
     1065             skip "Обратитесь к администратору."
     1066           view-as alert-box error.
     1067           undo, return error .
     1068       end.
     1069       run gbl/dir-cre.p (
     1070           input v-home-dir
     1071       ) no-error.
     1072       if error-status :error
     1073       then do:
     1074           message
     1075             skip "Неверно задан каталог экспорта."
     1076             skip(1)
     1077             skip "Обратитесь к администратору."
     1078           view-as alert-box error.
     1079           undo, return error .
     1080       end.
     1081       run bge/genfname.p (
     1082             input v-home-dir
     1083           , input p-prefix
     1084           , input ""
     1085           , input "xml"
     1086           , input "tmp"
     1087           , output p-xml-file-name
     1088       ).
     1089       assign
     1090           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1091           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1092           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1093       .
     1094   end.
     1095   end procedure.
     1096   procedure bgelib-read-config :
     1097   do
     1098   on error undo, return error
     1099   :
     1100   define variable v-par-type as character     no-undo.
     1101     define variable v-param-type      as character  no-undo .
     1102     define variable v-value-character as character  no-undo .
     1103     define variable v-value-date      as date       no-undo .
     1104     define variable v-value-decimal   as decimal    no-undo .
     1105     define variable v-value-integer   as integer    no-undo .
     1106     define variable v-value-logical   as logical    no-undo .
     1107     define variable v-tth             as handle     no-undo .
     1108       assign
     1109           v-bgelib-bgeclall = no
     1110           v-bgelib-bgedict  = no
     1111       .
     1112       run adm/shattri.p ( input "get":U
     1113                         , input  '':u
     1114                         , input  0
     1115                         , input  'bge-export':U
     1116                         , input  'bgeclall':U
     1117                         , output v-value-character
     1118                         , output v-value-date
     1119                         , output v-value-decimal
     1120                         , output v-value-integer
     1121                         , output v-value-logical
     1122                         , output v-param-type
     1123                         , input-output table-handle v-tth
     1124                         ) no-error .
     1125       if error-status :error
     1126       then do:
     1127         assign
     1128           v-bgelib-bgeclall = no
     1129         .
     1130       end.
     1131       else do:
     1132         assign
     1133           v-bgelib-bgeclall = v-value-logical
     1134         .
     1135       end.
     1136       delete object v-tth.
     1137       run adm/shattri.p ( input "get":U
     1138                         , input  '':u
     1139                         , input  0
     1140                         , input  'bge-export':U
     1141                         , input  'bgedict':U
     1142                         , output v-value-character
     1143                         , output v-value-date
     1144                         , output v-value-decimal
     1145                         , output v-value-integer
     1146                         , output v-value-logical
     1147                         , output v-param-type
     1148                         , input-output table-handle v-tth
     1149                         ) no-error .
     1150       if error-status :error
     1151       then do:
     1152         assign
     1153           v-bgelib-bgedict = no
     1154         .
     1155       end.
     1156       else do:
     1157         assign
     1158           v-bgelib-bgedict = v-value-logical
     1159         .
     1160       end.
     1161       delete object v-tth.
     1162       run adm/shattri.p ( input "get":U
     1163                         , input  '':u
     1164                         , input  0
     1165                         , input  'bge-export':U
     1166                         , input  'bgefmt':U
     1167                         , output v-value-character
     1168                         , output v-value-date
     1169                         , output v-value-decimal
     1170                         , output v-value-integer
     1171                         , output v-value-logical
     1172                         , output v-param-type
     1173                         , input-output table-handle v-tth
     1174                         ) no-error .
     1175       if error-status :error
     1176       then do:
     1177         assign
     1178           v-bgelib-bgefmt  = "xml":U
     1179         .
     1180       end.
     1181       else do:
     1182         assign
     1183           v-bgelib-bgefmt  = v-value-character
     1184         .
     1185       end.
     1186       delete object v-tth.
     1187       run adm/shattri.p ( input "get":U
     1188                         , input  '':u
     1189                         , input  0
     1190                         , input  'bge-export':U
     1191                         , input  'bgeflold':U
     1192                         , output v-value-character
     1193                         , output v-value-date
     1194                         , output v-value-decimal
     1195                         , output v-value-integer
     1196                         , output v-value-logical
     1197                         , output v-param-type
     1198                         , input-output table-handle v-tth
     1199                         ) no-error .
     1200       if error-status :error
     1201       then do:
     1202         assign
     1203           v-bgelib-bgeflold  = "old":U
     1204         .
     1205       end.
     1206       else do:
     1207         assign
     1208           v-bgelib-bgeflold  = v-value-character
     1209         .
     1210       end.
     1211       delete object v-tth.
     1212   end.
     1213   end procedure.
     1214   procedure bgelib-check-file-size :
     1215   do
     1216   on error undo, return error
     1217   :
     1218   define input parameter p-out-filename   as character    no-undo.
     1219   define output parameter p-is-big        as logical      no-undo.
     1220       define variable v-current-position    as integer        no-undo.
     1221       assign
     1222           v-current-position = seek( stmXMLOut )
     1223       .
     1224       if v-current-position / 1024 / 1024  >= 100
     1225       then do:
     1226           assign
     1227               p-is-big = yes
     1228           .
     1229       end.
     1230   end.
     1231   end procedure.
     1232   procedure bgelib-init-ext-doc-type :
     1233       define variable v-counter    as integer      no-undo.
     1234       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1235   do
     1236   for buf_temp_ext-doc-type
     1237   on error undo, return error
     1238   :
     1239       empty temp-table buf_temp_ext-doc-type.
     1240       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1241       :
     1242           create buf_temp_ext-doc-type.
     1243           assign
     1244               buf_temp_ext-doc-type.edt-key               = v-counter
     1245               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1246               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1247           .
     1248       end.
     1249   end.
     1250   end procedure.
     1251   do
     1252   on error undo, return error
     1253   :
     1254     define variable g#db-num as integer   no-undo .
     1255     run get-db-num  in parParentProc ( output g#db-num ).
     1256     define variable v-exists-operation          as logical      no-undo.
     1257     define variable p-doc-code        like ub.trn-doc.doc-code   no-undo.
     1258     define variable v-doc-date        like ub.trn-doc.doc-date   no-undo.
     1259     define variable v-fact-date       like ub.trn-doc.fact-date  no-undo.
     1260     define variable v-last-file-position        as integer       no-undo.
     1261     define variable v-i as integer   no-undo .
     1262     define variable v-obj-list as character no-undo .
     1263       ASSIGN  v-exists-operation = NO.
     1264       RUN bgelib-write-cnt( hCNT, "" ).
     1265       assign p-last-xml-file-name = p-xml-file-name  .
     1266       run export-documents in this-procedure (
     1267             input p-obj-list
     1268           , input p-doc-type-list
     1269           , input p-parameter-list
     1270           , input p-xml-file-name
     1271           , input p-log-file-name
     1272           , input p-list-file-name
     1273           , input p-xml-file-number
     1274           , output p-last-xml-file-name
     1275           , output p-last-xml-file-number
     1276       ).
     1277   end.
     1278   procedure export-documents :
     1279   do
     1280   on error undo, return error
     1281   :
     1282     define input parameter p-obj-list               as character    no-undo.
     1283     define input parameter p-doc-type-list          as character    no-undo.
     1284     define input parameter p-parameter-list         as character    no-undo.
     1285     define input parameter p-xml-file-name          as character    no-undo.
     1286     define input parameter p-log-file-name          as character    no-undo.
     1287     define input parameter p-list-file-name         as character    no-undo.
     1288     define input parameter p-xml-file-number        as integer      no-undo.
     1289     define output parameter p-last-xml-file-name    as character    no-undo.
     1290     define output parameter p-last-xml-file-number  as integer      no-undo.
     1291     define variable v-exists-before as logical      no-undo.
     1292     define variable v-exists-after  as logical      no-undo.
     1293     define variable v-need-new-file  as logical     no-undo.
     1294     define variable v-need-disk-spc  as logical     no-undo.
     1295     define variable v-cancel         as logical     no-undo.
     1296     define variable v-prev-filename  as character   no-undo.
     1297     define variable v-void-string    as character   no-undo.
     1298   define variable vss-include-info3 as character format "X(65)" no-undo
     1299   initial "@(#)$Workfile$".
     1300     define buffer buf_schet-fact-doc  for ub.schet-fact-doc.
     1301     define buffer buf_schet-fact-line for ub.schet-fact-line.
     1302     assign
     1303       p-last-xml-file-name    = p-xml-file-name
     1304       p-last-xml-file-number  = p-xml-file-number
     1305     .
     1306     output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1307   export-documents:
     1308     for each buf_schet-fact-doc no-lock
     1309       where buf_schet-fact-doc.host-code = p-host-code
     1310         AND buf_schet-fact-doc.fact-order >= p-fact-order-from
     1311         AND buf_schet-fact-doc.fact-order <= p-fact-order-to
     1312         AND buf_schet-fact-doc.status_ = 'факт':U
     1313     on error undo, return error
     1314     :
     1315       if v-need-new-file = yes then do:
     1316         output stream stmxmlout close.
     1317         assign v-prev-filename = p-xml-file-name .
     1318         run bgelib-filename in this-procedure ( input "s-f", output p-xml-file-name, output v-void-string, output v-void-string ).
     1319         run bgelib-write-footer in this-procedure ( input no, input v-prev-filename, input p-list-file-name, input yes, input p-xml-file-name + "xml":U ).
     1320         run bgelib-write-log in this-procedure ( input p-log-file-name, input 1
     1321               , input substitute( "Данные выгружены в файл &1", replace( p-xml-file-name, "/", "\" ) + "xml" ) ).
     1322         assign
     1323           p-last-xml-file-number   = p-xml-file-number + 1
     1324           p-last-xml-file-name     = p-xml-file-name
     1325         .
     1326         run bgelib-write-header in this-procedure (
     1327                 input no
     1328               , input p-last-xml-file-name
     1329               , input p-list-file-name
     1330               , input p-last-xml-file-number
     1331               , input yes
     1332               , input v-prev-filename + "xml":U
     1333               , input p-obj-list
     1334               , input p-doc-type-list
     1335               , input p-parameter-list
     1336           ).
     1337         output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1338         assign v-need-new-file = no .
     1339       end.
     1340       assign p-doc-code = buf_schet-fact-doc.doc-code .
     1341       if not v-exists-operation then do:
     1342         run bgelib-write-edt in this-procedure ( hEDT, 4, "Операция " + string( p-oper-name ) ).
     1343         run bgelib-write-log in this-procedure ( p-log-file-name, 0, "&Line" ).
     1344         run bgelib-write-log in this-procedure ( p-log-file-name, 1, "XML - Вывод операции " + string( p-oper-name )  ).
     1345         assign v-exists-operation = yes .
     1346       end.
     1347       assign
     1348         p-doc-code  = buf_schet-fact-doc.doc-code
     1349         v-doc-date  = buf_schet-fact-doc.doc-date
     1350         v-fact-date = buf_schet-fact-doc.fact-date
     1351       .
     1352       run bgelib-write-cnt( hcnt, "   " + string( p-doc-code ) + " от " + string( v-fact-date ) ) .
     1353       process events.
     1354   define variable vss-include-info4 as character format "X(65)" no-undo
     1355   initial "@(#)$Workfile$".
     1356   run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'schet-fact-doc'),  "" ).
     1357   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'doc-code'),  input string(buf_schet-fact-doc.doc-code), input 1 ).
     1358   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'doc-date'),  input string(buf_schet-fact-doc.doc-date, '99.99.9999'), input 1 ).
     1359   if buf_schet-fact-doc.pay-date <> ? then do:
     1360         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'pay-date'),  input string(buf_schet-fact-doc.pay-date, '99.99.9999'), input 1 ).
     1361   end.
     1362   if buf_schet-fact-doc.in-date <> ? then do:
