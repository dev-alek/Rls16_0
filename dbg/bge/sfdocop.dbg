     1468   end.
     1469       if v-last-file-position = 0 or seek( stmxmlout ) - v-last-file-position > 1048576 then do:
     1470         run gbl/chkfree.p ( input substring( p-xml-file-name, 1, 1 ), input 200, output v-need-disk-spc ) .
     1471         if v-need-disk-spc = yes then do:
     1472           run gbl/waitfrsp.w ( input substring( p-xml-file-name, 1, 1 ), input 200, output v-cancel ) .
     1473           if v-cancel = yes then undo, return error.
     1474         end.
     1475         assign v-last-file-position = seek( stmxmlout ) .
     1476       end.
     1477       run bgelib-check-file-size in this-procedure ( input p-xml-file-name + "tmp", output v-need-new-file ).
     1478     end.
     1479     output stream stmxmlout close.
     1480   end.
     1481   end procedure.
