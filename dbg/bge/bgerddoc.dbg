     1283                       v-xmlvdoc-current-tag   = 1
     1284                   .
     1285               end.
     1286           end.
     1287           when 'flat':U
     1288           then do:
     1289           end.
     1290       end case.
     1291   end.
     1292   end procedure.
     1293   procedure cb-xmlparse-tag-start-codeOperation :
     1294   define input parameter p-parameters-string  as character        no-undo.
     1295   do
     1296   on error undo, return error
     1297   :
     1298       case v-xmlview-format-type
     1299       :
     1300           when 'tree':U
     1301           then do:
     1302               if v-xmlvdoc-current-tag = 1
     1303               then do:
     1304                   assign
     1305                       v-xmlvdoc-tag-list[ 2 ] = "codeOperation":U
     1306                       v-xmlvdoc-current-tag   = 2
     1307                   .
     1308               end.
     1309           end.
