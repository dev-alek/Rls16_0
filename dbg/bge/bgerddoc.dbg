     1726   procedure cb-xmlparse-text :
     1727   define input parameter p-input-string  as character        no-undo.
     1728       define variable v-success    as logical      no-undo.
     1729       define buffer buf_temp_xmlview      for temp_xmlview.
     1730   do
     1731   for buf_temp_xmlview
     1732   on error undo, return error
     1733   :
     1734       if v-xmlvdoc-current-tag > 0
     1735       then do:
     1736           case v-xmlvdoc-tag-list[ v-xmlvdoc-current-tag ]
     1737           :
     1738               when "docID":U
     1739               then do:
     1740                   find first buf_temp_xmlview
     1741                        where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1742                   no-error.
     1743                   if available buf_temp_xmlview
     1744                   then do:
     1745                       assign
     1746                           buf_temp_xmlview.doc-code = p-input-string
     1747                       .
     1748                   end.
     1749               end.
     1750               when "dateDoc":U
     1751               then do:
     1752                   find first buf_temp_xmlview
     1753                       where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1754                   no-error.
     1755                   if available buf_temp_xmlview
     1756                   then do:
     1757                       run xmlvdoc-assign-date in this-procedure (
     1758                           input p-input-string
     1759                           , output buf_temp_xmlview.doc-date
     1760                           , output v-success
     1761                       ).
     1762                   end.
     1763               end.
     1764               when "dateFact":U
     1765               then do:
     1766                   find first buf_temp_xmlview
     1767                        where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1768                   no-error.
     1769                   if available buf_temp_xmlview
     1770                   then do:
     1771                       run xmlvdoc-assign-date in this-procedure (
     1772                             input p-input-string
     1773                           , output buf_temp_xmlview.fact-date
     1774                           , output v-success
     1775                       ).
     1776                   end.
     1777               end.
     1778               when "codeOperation":U
     1779               then do:
     1780                   find first buf_temp_xmlview
     1781                       where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1782                   no-error.
     1783                   if available buf_temp_xmlview
     1784                   then do:
     1785                       assign
     1786                           buf_temp_xmlview.ext-doc-type = p-input-string
     1787                       .
     1788                   end.
     1789               end.
     1790               when "referenceNo":U
     1791               then do:
     1792                   find first buf_temp_xmlview
     1793                       where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1794                   no-error.
     1795                   if available buf_temp_xmlview
     1796                   then do:
     1797                       assign
     1798                           buf_temp_xmlview.doc-code = p-input-string
     1799                       .
     1800                   end.
     1801               end.
     1802               when "sumr":U
     1803               then do:
     1804                   find first buf_temp_xmlview
     1805                        where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1806                   no-error.
     1807                   if available buf_temp_xmlview
     1808                   then do:
     1809                       run xmlvdoc-assign-decimal in this-procedure (
     1810                             input p-input-string
     1811                           , output buf_temp_xmlview.doc-sum
     1812                           , output v-success
     1813                       ).
     1814                   end.
     1815               end.
     1816               when "comment":U
     1817               then do:
     1818                   find first buf_temp_xmlview
     1819                        where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1820                   no-error.
     1821                   if available buf_temp_xmlview
     1822                   then do:
     1823                       assign
     1824                           buf_temp_xmlview.ps = buf_temp_xmlview.ps + p-input-string
     1825                       .
     1826                   end.
     1827               end.
     1828           end case.
     1829       end.
     1830   end.
     1831   end procedure.
     1832   procedure xmlvdoc-assign-decimal :
     1833   define input parameter p-input-string       as character        no-undo.
     1834   define output parameter p-output-decimal    as decimal          no-undo.
     1835   define output parameter p-success           as logical          no-undo.
     1836   do
     1837   on error undo, return error
     1838   :
     1839       assign
     1840           p-output-decimal = decimal( p-input-string )
     1841       no-error.
     1842       if error-status :error
     1843       then do:
     1844           assign
     1845               p-success           = no
     1846               p-output-decimal    = 0.0
     1847           .
     1848       end.
     1849       else do:
     1850           assign
     1851               p-success           = yes
     1852           .
     1853       end.
     1854   end.
     1855   end procedure.
     1856   procedure xmlvdoc-assign-date :
     1857   define input parameter p-input-string       as character        no-undo.
     1858   define output parameter p-output-date       as date             no-undo.
     1859   define output parameter p-success           as logical          no-undo.
     1860   do
     1861   on error undo, return error
     1862   :
     1863       assign
     1864           p-success       = no
     1865           p-output-date   = ?
     1866       .
     1867       if num-entries( p-input-string, ".":U ) = 3
     1868       then do:
     1869           assign
     1870               p-output-date = date(
     1871                         integer( entry( 2, p-input-string, ".":U ) )
     1872                       , integer( entry( 1, p-input-string, ".":U ) )
     1873                       , integer( entry( 3, p-input-string, ".":U ) ) )
     1874           no-error.
     1875           if error-status :error <> yes
     1876           then do:
     1877               assign
     1878                   p-success           = yes
     1879               .
     1880           end.
     1881       end.
     1882   end.
     1883   end procedure.
