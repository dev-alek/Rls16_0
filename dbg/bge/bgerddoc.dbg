     1269                                           , chr(10)
     1270                                           , "При закрытии тэга номера документа"
     1271                                           , "не был закрыт тэг предыдущего уровня. Список открытых тэгов:"
     1272                                           , v-xmlvdoc-tag-list[ 1 ]
     1273                                           , v-xmlvdoc-tag-list[ 2 ]
     1274                                           , v-xmlvdoc-tag-list[ 3 ]
     1275                                       )
     1276                   ).
     1277               end.
     1278               if v-xmlvdoc-tag-list[ 2 ] = "referenceNo":U
     1279               and v-xmlvdoc-current-tag   = 2
     1280               then do:
