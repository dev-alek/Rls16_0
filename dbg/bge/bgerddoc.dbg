     1142                   buf_temp_xmlview.record-id  = v-xmlvdoc-current-id
     1143                   v-xmlvdoc-current-tag       = 1
     1144                   buf_temp_xmlview.filename   = v-xmlvdoc-current-filename
     1145               .
