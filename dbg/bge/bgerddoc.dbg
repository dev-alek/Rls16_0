     1113   :
     1114       case v-xmlview-format-type
     1115       :
     1116           when 'tree':U
     1117           then do:
     1118           end.
     1119           when 'flat':U
     1120           then do:
     1121               assign
     1122                   v-xmlvdoc-current-tag = 0
