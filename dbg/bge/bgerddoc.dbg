        1   define input parameter p-mainmenu-handle    as handle           no-undo.
        2   define input parameter p-format-type        as character        no-undo.
        3   define input parameter p-export-type        as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Просмотр документов, экспортированных в каталог".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "X(65)" no-undo
       71   initial "@(#)$Workfile$ $Revision$".
       72   procedure xmlchar-test :
       73   define input parameter p-in-string          as character        no-undo.
       74   define output parameter p-out-string-enc    as character        no-undo.
       75   define output parameter p-out-string-dec    as character        no-undo.
       76   do
       77   on error undo, return error
       78   :
       79          run xmlchar-encode in this-procedure
       80       (
       81             input p-in-string
       82           , output p-out-string-enc
       83       ).
       84          run xmlchar-decode in this-procedure
       85       (
       86             input p-out-string-enc
       87           , output p-out-string-dec
       88       ).
       89   end.
       90   end .
       91   procedure xmlchar-encode :
       92   define input parameter p-in-string      as character        no-undo.
       93   define output parameter p-out-string    as character        no-undo.
       94       define variable v-position      as integer      no-undo.
       95       define variable v-current-char  as character    no-undo.
       96   do
       97   on error undo, return error
       98   :
       99       assign
      100           p-out-string = "":U
      101       .
      102       case p-in-string
      103       :
      104           when ?
      105           then do:
      106               assign
      107                   p-out-string = "?":U
      108               .
      109           end.
      110           when "?":U
      111           then do:
      112               assign
      113                   p-out-string = "&#63;":U
      114               .
      115           end.
      116           otherwise do:
      117               do v-position = 1 to length( p-in-string )
      118               :
      119                   assign
      120                       v-current-char = substring( p-in-string, v-position, 1 )
      121                   .
      122                   case v-current-char
      123                   :
      124                       when "&":U
      125                       then do:
      126                           assign
      127                               p-out-string = p-out-string + "&amp;":U
      128                           .
      129                       end.
      130                       when ">":U
      131                       then do:
      132                           assign
      133                               p-out-string = p-out-string + "&gt;":U
      134                           .
      135                       end.
      136                       when "<":U
      137                       then do:
      138                           assign
      139                               p-out-string = p-out-string + "&lt;":U
      140                           .
      141                       end.
      142                       when "'":U
      143                       then do:
      144                           assign
      145                               p-out-string = p-out-string + "&apos;":U
      146                           .
      147                       end.
      148                       when '"':U
      149                       then do:
      150                           assign
      151                               p-out-string = p-out-string + "&quot;":U
      152                           .
      153                       end.
      154                       when chr(1)
      155                       then do:
      156                           assign
      157                               p-out-string = p-out-string + "":U
      158                           .
      159                       end.
      160                       when chr(2)
      161                       then do:
      162                           assign
      163                               p-out-string = p-out-string + "":U
      164                           .
      165                       end.
      166                       when chr(3)
      167                       then do:
      168                           assign
      169                               p-out-string = p-out-string + "":U
      170                           .
      171                       end.
      172                       when chr(4)
      173                       then do:
      174                           assign
      175                               p-out-string = p-out-string + "":U
      176                           .
      177                       end.
      178                       when chr(5)
      179                       then do:
      180                           assign
      181                               p-out-string = p-out-string + "":U
      182                           .
      183                       end.
      184                       when chr(6)
      185                       then do:
      186                           assign
      187                               p-out-string = p-out-string + "":U
      188                           .
      189                       end.
      190                       when chr(7)
      191                       then do:
      192                           assign
      193                               p-out-string = p-out-string + "":U
      194                           .
      195                       end.
      196                       when chr(8)
      197                       then do:
      198                           assign
      199                               p-out-string = p-out-string + "":U
      200                           .
      201                       end.
      202                       when chr(9)
      203                       then do:
      204                           assign
      205                               p-out-string = p-out-string + "":U
      206                           .
      207                       end.
      208                       when chr(29)
      209                       then do:
      210                           assign
      211                               p-out-string = p-out-string + "":U
      212                           .
      213                       end.
      214                       when chr(10)
      215                       then do:
      216                           assign
      217                               p-out-string = p-out-string + "&#10;":U
      218                           .
      219                       end.
      220                       when chr(13)
      221                       then do:
      222                           assign
      223                               p-out-string = p-out-string + "&#13;":U
      224                           .
      225                       end.
      226                       otherwise do:
      227                           assign
      228                               p-out-string = p-out-string + v-current-char
      229                           .
      230                       end.
      231                   end case.
      232               end.
      233           end.
      234       end case.
      235   end.
      236   end .
      237   procedure xmlchar-encode-1c :
      238   define input parameter p-in-string      as character        no-undo.
      239   define output parameter p-out-string    as character        no-undo.
      240       define variable v-position      as integer      no-undo.
      241       define variable v-current-char  as character    no-undo.
      242   do
      243   on error undo, return error
      244   :
      245       assign
      246           p-out-string = "":U
      247       .
      248       case p-in-string
      249       :
      250           when ?
      251           then do:
      252               assign
      253                   p-out-string = "?":U
      254               .
      255           end.
      256           otherwise do:
      257               do v-position = 1 to length( p-in-string )
      258               :
      259                   assign
      260                       v-current-char = substring( p-in-string, v-position, 1 )
      261                   .
      262                   case v-current-char
      263                   :
      264                       when chr(1)
      265                       then do:
      266                           assign
      267                               p-out-string = p-out-string + " ":U
      268                           .
      269                       end.
      270                       when chr(2)
      271                       then do:
      272                           assign
      273                               p-out-string = p-out-string + " ":U
      274                           .
      275                       end.
      276                       when chr(3)
      277                       then do:
      278                           assign
      279                               p-out-string = p-out-string + " ":U
      280                           .
      281                       end.
      282                       when chr(4)
      283                       then do:
      284                           assign
      285                               p-out-string = p-out-string + " ":U
      286                           .
      287                       end.
      288                       when chr(5)
      289                       then do:
      290                           assign
      291                               p-out-string = p-out-string + " ":U
      292                           .
      293                       end.
      294                       when chr(6)
      295                       then do:
      296                           assign
      297                               p-out-string = p-out-string + " ":U
      298                           .
      299                       end.
      300                       when chr(7)
      301                       then do:
      302                           assign
      303                               p-out-string = p-out-string + " ":U
      304                           .
      305                       end.
      306                       when chr(8)
      307                       then do:
      308                           assign
      309                               p-out-string = p-out-string + " ":U
      310                           .
      311                       end.
      312                       when chr(9)
      313                       then do:
      314                           assign
      315                               p-out-string = p-out-string + " ":U
      316                           .
      317                       end.
      318                       when chr(29)
      319                       then do:
      320                           assign
      321                               p-out-string = p-out-string + " ":U
      322                           .
      323                       end.
      324                       when chr(10)
      325                       then do:
      326                           assign
      327                               p-out-string = p-out-string + " ":U
      328                           .
      329                       end.
