     1194           then do:
     1195           end.
     1196           when 'flat':U
     1197           then do:
     1198               if v-xmlvdoc-current-tag = 1
     1199               then do:
     1200                   assign
     1201                       v-xmlvdoc-tag-list[ 2 ] = "docID":U
     1202                       v-xmlvdoc-current-tag   = 2
     1203                   .
     1204               end.
     1205           end.
     1206       end case.
     1207   end.
     1208   end procedure.
     1209   procedure cb-xmlparse-tag-end-docID :
