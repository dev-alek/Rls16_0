      347   procedure xmlchar-decode :
      348   define input parameter p-in-string      as character        no-undo.
      349   define output parameter p-out-string    as character        no-undo.
      350       define variable v-position      as integer      no-undo.
      351       define variable v-last-position as integer      no-undo.
      352       define variable v-temp-integer  as integer      no-undo.
      353       define variable v-current-char  as character    no-undo.
      354       define variable v-next-char     as character    no-undo.
      355       define variable v-success       as logical      no-undo.
      356   do
      357   on error undo, return error
      358   :
      359       assign
      360           p-out-string = "":U
      361           v-position   = 0
      362       .
      363       replace-cycle:
      364       do while yes
      365       on error undo, return error
      366       :
      367           assign
      368               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      369           .
      370           if v-last-position <= v-position
      371           then do:
      372               if v-position = 0
      373               then do:
      374                   assign
      375                       p-out-string = p-in-string
      376                   .
      377               end.
      378               else do:
      379                   assign
      380                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      381                   .
      382               end.
      383               leave replace-cycle.
      384           end.
      385           else do:
      386               assign
      387                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      388                   v-position      = v-last-position
      389                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      390               .
      391               if v-current-char = "#":U
      392               then do:
      393                   assign
      394                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      395                   .
      396                   if v-last-position > 0
      397                   then do:
      398                       run xmlchar-read-integer in this-procedure
      399                        (
      400                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      401                           , output v-temp-integer
      402                           , output v-success
      403                       ).
      404                       if v-success = yes
      405                       and v-temp-integer >= 1
      406                       and v-temp-integer <= 255
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + chr( v-temp-integer )
      410                               v-position   = v-last-position + 1
      411                           .
      412                       end.
      413                       else do:
      414                           assign
      415                               p-out-string = p-out-string + "&":U
      416                               v-position   = v-position   + 1
      417                           .
      418                       end.
      419                   end.
      420                   else do:
      421                       assign
      422                           p-out-string = p-out-string + "&":U
      423                           v-position   = v-position   + 1
      424                       .
      425                   end.
      426               end.
      427               else do:
      428                   case substring( p-in-string, v-position + 1, 3 )
      429                   :
      430                       when "lt;":U
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + "<":U
      434                               v-position   = v-position   + 3
      435                           .
      436                       end.
      437                       when "gt;":U
      438                       then do:
      439                           assign
      440                               p-out-string = p-out-string + ">":U
      441                               v-position   = v-position   + 3
      442                           .
      443                       end.
      444                       otherwise do:
      445                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      446                           then do:
      447                               assign
      448                                   p-out-string = p-out-string + "&":U
      449                                   v-position   = v-position   + 4
      450                               .
      451                           end.
      452                           else do:
      453                               case substring( p-in-string, v-position + 1, 5 )
      454                               :
      455                                   when "quot;":U
      456                                   then do:
      457                                       assign
      458                                           p-out-string = p-out-string + '"':U
      459                                           v-position   = v-position   + 5
      460                                       .
      461                                   end.
      462                                   when "apos;":U
      463                                   then do:
      464                                       assign
      465                                           p-out-string = p-out-string + "'":U
      466                                           v-position   = v-position   + 5
      467                                       .
      468                                   end.
      469                                   otherwise do:
      470                                       assign
      471                                           p-out-string = p-out-string + "&":U
      472                                       .
      473                                   end.
      474                               end case.
      475                           end.
      476                       end.
      477                   end case.
      478               end.
      479           end.
      480       end.
      481   end.
      482   end .
      483   procedure xmlchar-read-integer :
      484   define input parameter p-input-string      as character        no-undo.
      485   define output parameter p-output-integer   as integer          no-undo.
      486   define output parameter p-success       as logical          no-undo.
      487   do
      488   on error undo, return error
      489   :
      490       assign
      491           p-output-integer = integer( p-input-string )
      492       no-error.
      493       if error-status :error
      494       then do:
      495           assign
      496               p-success           = no
      497               p-output-integer    = 0
      498           .
      499       end.
      500       else do:
      501           assign
      502               p-success           = yes
      503           .
      504       end.
      505   end.
      506   end.
      507   define variable vss-include-info1 as character format "X(65)" no-undo
      508   initial "@(#)$Workfile$ $Revision$".
      509   define temp-table temp_xmlparse-attrs no-undo
      510   field field-name as character
      511   field attr-code as character
      512   field attr-value as character
      513   index pi is unique primary
      514   field-name attr-code
      515   .
      516   procedure xmlparse :
      517   define input parameter p-handle         as handle           no-undo.
      518   define input parameter p-XML-buffer     as character        no-undo.
      519   define input parameter p-call-mode      as character        no-undo.
      520       define variable v-procedure-type        as character    no-undo.
      521       define variable v-procedure-name        as character    no-undo.
      522       define variable v-temp-string           as character    no-undo.
      523       define variable v-current-position      as integer      no-undo.
      524       define variable v-end-position          as integer      no-undo.
      525       define variable v-text-position         as integer      no-undo.
      526       define variable v-input-buffer-length   as integer      no-undo.
      527       define variable v-handle                as handle       no-undo.
      528       define variable v-call-mode             as character    no-undo.
      529       define variable v-proc-type             as character    no-undo.
      530       define variable v-proc-name             as character    no-undo.
      531       define variable v-decode-string         as character    no-undo.
      532   do
      533   on error undo, return error
      534   :
      535       if not valid-handle( p-handle )
      536       then do:
      537           return.
      538       end.
      539       assign
      540           v-end-position          = 1
      541           v-current-position      = 1
      542           v-input-buffer-length   = length( p-XML-buffer )
      543       .
      544       do
      545       while v-end-position < v-input-buffer-length
      546       :
      547           assign
      548               v-current-position = index( p-XML-buffer, "<":U, v-end-position )
      549           .
      550           if v-current-position = 0
      551           then do:
      552               assign
      553                   v-decode-string = substring( p-XML-buffer, v-end-position )
      554               .
      555               run xmlchar-decode in this-procedure (
      556                     input v-decode-string
      557                   , output v-temp-string
      558               ).
      559               assign
      560                   v-handle     = p-handle
      561                   v-call-mode  = p-call-mode
      562                   v-proc-type  = 'text':U
      563                   v-proc-name  = '':U
      564               .
      565               run run-callback-procedure in this-procedure (
      566                     input v-handle
      567                   , input v-call-mode
      568                   , input v-proc-type
      569                   , input v-proc-name
      570                   , input v-temp-string
      571               ).
      572               assign
      573                   v-end-position = v-input-buffer-length
      574               .
      575           end.
      576           else do:
      577               if v-current-position > v-end-position
      578               then do:
      579                   assign
      580                       v-decode-string = substring( p-XML-buffer, v-end-position, v-current-position - v-end-position )
      581                   .
      582                   run xmlchar-decode in this-procedure (
      583                         input v-decode-string
      584                       , output v-temp-string
      585                   ).
      586                   assign
      587                       v-end-position = v-current-position
      588                   .
      589                   assign
      590                       v-handle     = p-handle
      591                       v-call-mode  = p-call-mode
      592                       v-proc-type  = 'text':U
      593                       v-proc-name  = '':U
      594                   .
      595                   run run-callback-procedure in this-procedure (
      596                         input v-handle
      597                       , input v-call-mode
      598                       , input v-proc-type
      599                       , input v-proc-name
      600                       , input v-temp-string
      601                   ).
      602               end.
      603               assign
      604                   v-decode-string = substring( p-XML-buffer, v-end-position + 1, 1 )
      605               .
      606               if v-decode-string = "/":U
      607               then do:
      608                   assign
      609                       v-procedure-type    = "tag-end":U
      610                       v-end-position      = v-current-position + 1
      611                   .
      612               end.
      613               else do:
      614                   assign
      615                       v-procedure-type    = "tag-start":U
      616                       v-end-position      = v-current-position
      617                   .
      618               end.
      619               assign
      620                   v-current-position  = index(p-XML-buffer, "/>":U, v-end-position)
      621               .
      622               if v-current-position <= v-end-position
      623               then do:
      624                   assign
      625                       v-current-position  = index(p-XML-buffer, ">":U, v-end-position)
      626                   .
      627               end.
      628               assign
      629                   v-end-position      = v-end-position + 1
      630               .
      631               if v-current-position <= v-end-position
      632               then do:
      633                   run run-cb-xmlparse-error in this-procedure
      634                                           (   input p-handle
      635                                           ,   input 'Ошибка: знак < без завершающего > на той же строке'
      636                                           ).
      637                   assign
      638                       v-temp-string   = "<":U + substring(p-XML-buffer, v-end-position)
      639                       v-end-position  = v-input-buffer-length
      640                   .
      641                   assign
      642                       v-handle     = p-handle
      643                       v-call-mode  = p-call-mode
      644                       v-proc-type  = 'text':U
      645                       v-proc-name  = '':U
      646                   .
      647                   run run-callback-procedure in this-procedure (
      648                         input v-handle
      649                       , input v-call-mode
      650                       , input v-proc-type
      651                       , input v-proc-name
      652                       , input v-temp-string
      653                   ).
      654               end.
      655               else do:
      656                   assign
      657                       v-temp-string   = trim( substring(      p-XML-buffer
      658                                                           ,   v-end-position
      659                                                           ,   v-current-position - v-end-position
      660                                             )          )
      661                       v-text-position = index( v-temp-string, " ":U )
      662                   .
      663                   if v-text-position <> 0
      664                   then do:
      665                       assign
      666                           v-procedure-name    =   trim( substring(      v-temp-string
      667                                                                       ,   1
      668                                                                       ,   v-text-position
      669                                                         )          )
      670                           v-temp-string       =   trim( substring(    v-temp-string
      671                                                                   ,   v-text-position + 1
      672                                                       )          )
      673                       .
      674                   end.
      675                   else do:
      676                       assign
      677                           v-procedure-name    =   v-temp-string
      678                           v-temp-string       =   "":U
      679                       .
      680                   end.
      681                   assign
      682                       v-end-position      = v-current-position + 1
      683                   .
      684                   assign
      685                       v-handle          = p-handle
      686                       v-call-mode       = p-call-mode
      687                   .
      688                   run run-callback-procedure in this-procedure (
      689                         input v-handle
      690                       , input v-call-mode
      691                       , input v-procedure-type
      692                       , input v-procedure-name
      693                       , input v-temp-string
      694                   ).
      695               end.
      696           end.
      697       end.
      698   end.
      699   end procedure.
      700   procedure run-callback-procedure :
      701   define input parameter p-handle             as handle           no-undo.
      702   define input parameter p-call-mode          as character        no-undo.
      703   define input parameter p-procedure-type     as character        no-undo.
      704   define input parameter p-procedure-name     as character        no-undo.
      705   define input parameter p-param-value        as character        no-undo.
      706       define variable v-data-type         as character            no-undo.
      707       define variable v-data-value        as character            no-undo.
      708       define variable v-procedure-name    as character            no-undo.
      709       define variable v-procedure-exists  as logical      no-undo.
      710   do
      711   on error undo, return error
      712   :
      713       if p-call-mode = "call-all":U
      714       or p-call-mode = "call-named":U
      715       then do:
      716           case p-procedure-type :
      717               when "text":U
      718               then do:
      719                   assign
      720                       v-procedure-name = "cb-xmlparse-text":U
      721                   .
      722               end.
      723               when "tag-end":U
      724               then do:
      725                   assign
      726                       v-procedure-name = "cb-xmlparse-tag-end-":U + p-procedure-name
      727                   .
      728               end.
      729               when "tag-start":U
      730               then do:
      731                   assign
      732                       v-procedure-name = "cb-xmlparse-tag-start-":U + p-procedure-name
      733                   .
      734               end.
      735               otherwise do:
      736                   assign
      737                       v-procedure-name = p-procedure-name
      738                   .
      739               end.
      740           end case.
      741           if p-handle :get-signature( v-procedure-name ) = "":U
      742           then do:
      743               assign
      744                   v-procedure-exists = no
      745               .
      746           end.
      747           else do:
      748               assign
      749                   v-procedure-exists = yes
      750               .
      751           end.
      752           if v-procedure-exists = yes
      753           then do:
      754               run value(v-procedure-name) in p-handle (input p-param-value) no-error.
      755               if error-status :error
      756               then do:
      757                   run run-cb-xmlparse-error in this-procedure (
      758                       input p-handle
      759                       , input "Ошибка при вызове программы " + v-procedure-name
      760                   ).
      761               end.
      762           end.
      763       end.
      764       if ( p-call-mode = "call-all":U
      765           and v-procedure-exists <> yes )
      766       or p-call-mode = "call-unnamed":U
      767       then do:
      768           case p-procedure-type :
      769               when 'text':U
      770               then do:
      771                   assign
      772                       v-data-type     = 'text':U
      773                       v-data-value    = p-param-value
      774                   .
      775               end.
      776               when 'tag-end':U
      777               then do:
      778                   assign
      779                       v-data-type     = 'tag-end':U
      780                       v-data-value    = p-procedure-name
      781                   .
      782               end.
      783               when 'tag-start':U
      784               then do:
      785                   assign
      786                       v-data-type     = 'tag-start':U
      787                       v-data-value    = p-procedure-name
      788                   .
      789               end.
      790               otherwise do:
      791                   assign
      792                       v-data-type     = 'text':U
      793                       v-data-value    = p-procedure-name
      794                   .
      795               end.
      796           end case.
      797           run run-cb-xmlparse-procedure-not-found in this-procedure (
      798                 input p-handle
      799               , input v-data-type
      800               , input v-data-value
      801               , input p-param-value
      802           ).
      803       end.
      804   end.
      805   end procedure.
      806   procedure run-cb-xmlparse-error :
      807   do
      808   on error undo, return error
      809   :
      810       def input parameter p-handle            as handle no-undo.
      811       def input parameter p-error-message as char no-undo.
      812       if lookup("cb-xmlparse-error", p-handle :internal-entries) > 0
      813       then do:
      814           run cb-xmlparse-error in p-handle  (input p-error-message).
      815       end.
      816   end.
      817   end procedure.
      818   procedure run-cb-xmlparse-procedure-not-found :
      819   do
      820   on error undo, return error
      821   :
      822       def input parameter p-handle            as handle no-undo.
      823       def input parameter p-data-type         as char no-undo.
      824       def input parameter p-data-value        as char no-undo.
      825       def input parameter p-param-value       as char no-undo.
      826       if lookup("cb-xmlparse-procedure-not-found", p-handle :internal-entries) > 0
      827       then do:
      828           run cb-xmlparse-procedure-not-found in p-handle    (   input p-data-type
      829                                                             , input p-data-value
      830                                                             , input p-param-value
      831                                                           ) no-error.
      832           if error-status :error
      833           then do:
      834               run run-cb-xmlparse-error in this-procedure
      835                                       (   input p-handle
      836                                       ,   input "Ошибка при вызове программы cb-xmlparse-procedure-not-found"
      837                                       ).
      838           end.
      839       end.
      840       else do:
      841           run run-cb-xmlparse-error in this-procedure
      842                                   (   input p-handle
      843                                   ,   input "Ошибка: Не определена программа cb-xmlparse-procedure-not-found"
      844                                   ).
      845       end.
      846   end.
      847   end procedure.
      848   procedure cb-xmlparse-attributes :
      849   define input  parameter p-handle            as handle no-undo.
      850   define input  parameter p-field-name        as character no-undo .
      851   define input  parameter p-field-value       as character no-undo .
      852   define variable ii as integer no-undo init 1.
      853   define variable v-input-buffer-length   as integer no-undo.
      854   define variable v-dc as logical no-undo .
      855   define variable v-sc as logical no-undo .
      856   define variable v-eq as logical no-undo .
      857   define variable v-char as character no-undo .
      858   define variable v-code as character no-undo .
      859   define variable v-value as character no-undo .
      860   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
      861     do
      862     on error undo, return error
      863     :
      864       if index(p-field-value, '>':U) > 0 then do:
      865         run run-cb-xmlparse-error in this-procedure
      866                                 (   input p-handle
      867                                 ,   input substitute("Ошибка: тэг &1 содержит другие тэги", p-field-name)
      868                                 ).
      869       end.
      870       assign
      871       p-field-value = trim(p-field-value)
      872       .
      873       for each buf_temp_xmlparse-attrs where
      874               buf_temp_xmlparse-attrs.field-name = p-field-name:
      875         delete buf_temp_xmlparse-attrs.
      876       end.
      877       assign
      878       v-input-buffer-length = length( p-field-value )
      879       .
      880       do while ii <= v-input-buffer-length:
      881         assign
      882         v-char = substr(p-field-value, ii, 1)
      883         ii = ii + 1
      884         .
      885         CASE v-char:
      886           when "=":U then do:
      887             if v-eq
      888             and not v-dc
      889             and not v-sc then do:
      890               return error.
      891             end.
      892             assign
      893             v-eq = yes
      894             .
      895           end.
      896           when chr(34) then do:
      897           if v-eq then
      898           assign
      899           v-dc = not(v-dc)
      900           .
      901           else return error.
      902           end.
      903           when chr(39) then do:
      904           if v-eq then
      905           assign
      906           v-sc = not(v-sc)
      907           .
      908           else return error.
      909           end.
      910           when chr(32) then do:
      911             if not v-dc
      912             and not v-sc
      913             then do:
      914               assign
      915               v-sc = no
      916               v-dc = no
      917               v-eq = no
      918               .
      919               create buf_temp_xmlparse-attrs.
      920               assign
      921               buf_temp_xmlparse-attrs.field-name = p-field-name
      922               buf_temp_xmlparse-attrs.attr-code  = v-code
      923               buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
      924               v-code = "":U
      925               v-value = "":U
      926               .
      927             end.
      928           end.
      929         END CASE.
      930         if not v-eq
      931         then do:
      932           if not v-char = chr(32) then
      933           assign
      934           v-code = v-code + v-char
      935           .
      936         end.
      937         else do:
      938           if v-char <> "=":U
      939           then
      940           assign
      941           v-value = v-value + v-char
      942           .
      943         end.
      944       end.
      945       if v-code <> "":U then do:
      946         create buf_temp_xmlparse-attrs.
      947         assign
      948         buf_temp_xmlparse-attrs.field-name = p-field-name
      949         buf_temp_xmlparse-attrs.attr-code  = v-code
      950         buf_temp_xmlparse-attrs.attr-value = trim(v-value, (if v-value begins chr(34) then chr(34) else chr(39)))
      951         .
      952       end.
      953     end.
      954   end procedure.
      955   FUNCTION cb-xmlparse-get-attr returns character (
      956         input p-handle        as handle
      957       , input p-field-name    as character
      958       , input p-field-value   as character
      959       , input p-attr-code     as character
      960       , input p-reparse       as logical
      961   ) :
      962   define buffer buf_temp_xmlparse-attrs for temp_xmlparse-attrs.
      963     do
      964     on error undo, return error
      965     :
      966       if p-reparse then do:
      967         run cb-xmlparse-attributes in this-procedure (
      968                                                       input p-handle
      969                                                     , input p-field-name
      970                                                     , input p-field-value) no-error .
      971         if error-status:error then return ? .
      972       end.
      973       find first buf_temp_xmlparse-attrs no-lock where
      974                 buf_temp_xmlparse-attrs.field-name = p-field-name
      975             AND buf_temp_xmlparse-attrs.attr-code   = p-attr-code no-error .
      976       if not avail buf_temp_xmlparse-attrs then return ?.
      977       return buf_temp_xmlparse-attrs.attr-value.
      978     end.
      979   end FUNCTION.
      980   FUNCTION cb-xmlparse-get-date returns date (
      981                                               input p-string as character):
      982   define variable v-date as date.
      983   if index(p-string, "-":U) = 0
      984   or NOT (length(p-string) = 10
      985           or
      986           length(p-string) = 19)
      987   then return error.
      988   assign
      989   v-date =  date(
      990             int( substr( p-string, 6, 2 ) ) ,
      991             int( substr( p-string, 9, 2 ) ),
      992             int( substr( p-string, 1, 4 ) )
      993               )
      994   no-error .
      995   if error-status:error then return error.
      996   return v-date.
      997   END FUNCTION.
      998   FUNCTION cb-xmlparse-get-time returns integer (input p-string as character):
      999   define variable v-time as integer no-undo .
     1000   define variable v-shift as integer no-undo .
     1001   if index(p-string, ":":U) = 0
     1002   or not (
     1003           length(p-string) = 19
     1004           or
     1005           length(p-string) = 8
     1006           )
     1007   then return error.
     1008   if length(p-string) = 19 then v-shift = 11.
     1009   assign
     1010   v-time =  int( substr( p-string, v-shift + 1, 2 ) ) * 3600 +
     1011             int( substr( p-string, v-shift + 4, 2 ) ) * 60  +
     1012             int( substr( p-string, v-shift + 7, 2) )
     1013   no-error .
     1014   if error-status:error then return error.
     1015   return v-time.
     1016   END FUNCTION.
     1017   define variable vss-include-info2 as character format "X(65)" no-undo
     1018   initial "@(#)$Workfile$ $Revision$".
     1019   define temp-table temp_xmlview no-undo
     1020       field record-id     as integer
     1021       field filename      as character
     1022       field doc-code      as character
     1023       field ext-doc-type  as character
     1024       field fact-date     as date
     1025       field doc-date      as date
     1026       field doc-sum       as decimal
     1027       field ps            as character
     1028       index pi is primary unique record-id
     1029       index dc doc-code
     1030       index et ext-doc-type
     1031   .
     1032   define variable v-xmlview-format-type   as character    no-undo.
     1033   define variable v-xmlview-export-type   as character    no-undo.
     1034   procedure xmlview-clear-temp_xmlview :
     1035       define buffer buf_temp_xmlview      for temp_xmlview.
     1036   do
     1037   for buf_temp_xmlview
     1038   on error undo, return error
     1039   :
     1040       for each buf_temp_xmlview
     1041       :
     1042           delete buf_temp_xmlview.
     1043       end.
     1044   end.
     1045   end procedure.
     1046   define variable vss-include-info3 as character format "X(65)" no-undo
     1047   initial "@(#)$Workfile$ $Revision$".
     1048   define stream xmlvdoc-in.
     1049   define variable v-xmlvdoc-current-file-row  as integer      no-undo.
     1050   define variable v-xmlvdoc-current-rowid     as rowid        no-undo.
     1051   define variable v-xmlvdoc-current-id        as integer      no-undo.
     1052   define variable v-xmlvdoc-current-tag-path  as character    no-undo.
     1053   define variable v-xmlvdoc-tag-list          as character extent 3 init[ "operation":U, "":U, "":U ]  no-undo.
     1054   define variable v-xmlvdoc-current-tag       as integer              no-undo.
     1055   define variable v-xmlvdoc-current-filename  as character    no-undo.
     1056   procedure xmlvdoc-parse-file :
     1057   define input parameter p-filename       as character        no-undo.
     1058   define input parameter p-full-filename  as character        no-undo.
     1059       define variable v-buffer-string    as character    no-undo.
     1060   do
     1061   on error undo, return error
     1062   :
     1063       assign
     1064           v-xmlvdoc-current-filename  = p-filename
     1065           v-xmlview-export-type       = 'DOC':U
     1066       .
     1067       input stream xmlvdoc-in from value( p-full-filename ).
     1068       repeat
     1069       :
     1070           import stream xmlvdoc-in unformatted
     1071               v-buffer-string
     1072           .
     1073           assign
     1074               v-xmlvdoc-current-file-row = v-xmlvdoc-current-file-row + 1
     1075           .
     1076           run xmlparse in this-procedure (
     1077                 input this-procedure
     1078               , input v-buffer-string
     1079               , input "call-named":U
     1080           ).
     1081       end.
     1082   end.
     1083   end procedure.
     1084   procedure cb-xmlparse-tag-start-doc :
     1085   define input parameter p-parameters-string  as character        no-undo.
     1086       define buffer buf_temp_xmlview      for temp_xmlview.
     1087   do
     1088   for buf_temp_xmlview
     1089   on error undo, return error
     1090   :
     1091       case v-xmlview-format-type
     1092       :
     1093           when 'tree':U
     1094           then do:
     1095           end.
     1096           when 'flat':U
     1097           then do:
     1098               create buf_temp_xmlview.
     1099               assign
     1100                   v-xmlvdoc-current-id        = v-xmlvdoc-current-id + 1
     1101                   buf_temp_xmlview.record-id  = v-xmlvdoc-current-id
     1102                   v-xmlvdoc-current-tag       = 1
     1103                   buf_temp_xmlview.filename   = v-xmlvdoc-current-filename
     1104               .
     1105           end.
     1106       end case.
     1107   end.
     1108   end procedure.
     1109   procedure cb-xmlparse-tag-end-doc :
