     1929               if v-xmlvdoc-tag-list[ 2 ] = "linedoc":U
     1930               and v-xmlvdoc-current-tag   = 2
     1931               then do:
     1932                   assign
     1933                       v-xmlvdoc-tag-list[ 2 ] = "":U
     1934                       v-xmlvdoc-current-tag   = 1
     1935                   .
     1936               end.
     1937           end.
     1938           when 'flat':U
     1939           then do:
     1940           end.
     1941       end case.
     1942   end.
     1943   end procedure.
     1944   procedure xmlvdoc-error :
     1945   define input parameter p-error-text     as character        no-undo.
     1946       define buffer buf_temp_xmlview      for temp_xmlview.
     1947   do
     1948   for buf_temp_xmlview
     1949   on error undo, return error
     1950   :
     1951       output to value( v-xmlvdoc-current-tag-path + "\xmlvdoc.log" ) append.
     1952           find first buf_temp_xmlview
     1953                where buf_temp_xmlview.record-id = v-xmlvdoc-current-id
     1954           no-error.
     1955           if available buf_temp_xmlview
     1956           then do:
     1957               put unformatted
     1958                   substitute( "Запись номер &1. Номер документа &2"
     1959                               , buf_temp_xmlview.record-id
     1960                               , buf_temp_xmlview.doc-code
     1961                             )
     1962               .
     1963               put skip.
     1964           end.
     1965           put unformatted p-error-text.
     1966           put skip.
     1967       output close.
     1968   end.
     1969   end procedure.
     1970   define variable vss-include-info4 as character format "X(65)" no-undo
     1971   initial "@(#)$Workfile$ $Revision$".
     1972   define variable v-filelist-total-file-num           as integer      no-undo .
     1973   define variable v-filelist-total-dir-num            as integer      no-undo .
     1974   define variable v-filelist-main-procedure-handle    as handle       no-undo .
     1975   define variable v-filelist-main-procedure-name      as character    no-undo .
     1976   define temp-table temp-dirlist no-undo
     1977       field dir-full-name     as character
     1978       field dir-short-name    as character
     1979       field need-process      as logical
     1980       index xpk is primary unique dir-full-name
     1981   .
     1982   define temp-table temp-filelist no-undo
     1983     field file-name        as character
     1984     field file-name-no-ext as character
     1985     field file-extension   as character
     1986     field directory-name   as character
     1987     field full-name        as character
     1988     field dir-short-name   as character
     1989     field need-process     as logical
     1990     index xpk is unique primary full-name
     1991     index xie1 directory-name file-name
     1992     index xie2 directory-name file-name-no-ext
     1993     index xie3 file-name
     1994     index xie4 file-name-no-ext
     1995     index xie5 need-process file-name
     1996     .
     1997   define stream dir-list .
     1998   procedure filelist-get-file-num :
     1999     define output parameter p-file-num as integer   no-undo .
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       assign
     2004         p-file-num = v-filelist-total-file-num
     2005       .
     2006     end.
     2007   end procedure.
     2008   procedure filelist-clear :
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       define buffer buf_filelist for temp-filelist .
     2013       assign
     2014         v-filelist-total-file-num = 0
     2015       .
     2016       for each buf_filelist
     2017       on error undo, return error
     2018       :
     2019         delete buf_filelist .
     2020       end.
     2021     end.
     2022   end procedure.
     2023   procedure filelist-init :
     2024     do
     2025     on error undo, return error
     2026     :
     2027       define input parameter p-dir-name       as character no-undo .
     2028       define input parameter p-filter-ext     as logical   no-undo .
     2029       define input parameter p-ext-list       as character no-undo .
     2030       define input parameter p-dir-short-name as character no-undo .
     2031       define buffer buf_temp-filelist for temp-filelist .
     2032       if p-filter-ext = true
     2033          and p-ext-list = ?
     2034       or (p-filter-ext = false
     2035          and p-ext-list <> ?
     2036          and p-ext-list <> "":U
     2037          )
     2038       then do:
     2039         message
     2040           vss-workfile vss-revision vss-description skip
     2041           "Ошибка задания входных параметров" skip
     2042           "p-filter-ext" p-filter-ext skip
     2043           "p-ext-list"   p-ext-list   skip
     2044           view-as alert-box error .
     2045         undo, return error .
     2046       end.
     2047       for each buf_temp-filelist
     2048         where buf_temp-filelist.directory-name = p-dir-name
     2049       on error undo, return error return-value
     2050       :
     2051         delete buf_temp-filelist .
     2052       end.
     2053       input stream dir-list from os-dir( p-dir-name ).
     2054       define variable v-file                  as character no-undo .
     2055       define variable v-path                  as character no-undo .
     2056       define variable v-mask                  as character no-undo .
     2057       define variable v-extension             as character no-undo .
     2058       define variable v-file-name-without-ext as character no-undo .
     2059       repeat
     2060       on error undo, return error
     2061       :
     2062         import stream dir-list v-file v-path v-mask .
     2063         if  v-mask <> ?
     2064         and v-mask begins 'F':u
     2065         then do:
     2066         end.
     2067         else do:
     2068           next .
     2069         end.
     2070         if num-entries(v-file, '.':u) > 1
     2071         then do:
     2072           assign
     2073             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
     2074             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
     2075           .
     2076         end.
     2077         else do:
     2078           assign
     2079             v-extension = ''
     2080             v-file-name-without-ext = v-file
     2081           .
     2082         end.
     2083         if p-filter-ext = true
     2084         then do:
     2085           if lookup(v-extension, p-ext-list) = 0
     2086           then do:
     2087             next .
     2088           end.
     2089         end.
     2090         create buf_temp-filelist .
     2091         assign
     2092           buf_temp-filelist.file-name        = v-file
     2093           buf_temp-filelist.directory-name   = p-dir-name
     2094           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
     2095           buf_temp-filelist.file-extension   = v-extension
     2096           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
     2097           buf_temp-filelist.dir-short-name   = p-dir-short-name
     2098         .
     2099         assign
     2100           v-filelist-total-file-num = v-filelist-total-file-num + 1
     2101         .
     2102         if v-filelist-main-procedure-handle <> ?
     2103         then do:
     2104           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
     2105             (input "file":U
     2106             , input v-filelist-total-file-num
     2107             , input buf_temp-filelist.full-name
     2108             , input buf_temp-filelist.file-name
     2109             ) no-error.
     2110           if error-status :error
     2111           then do:
     2112             message
     2113               vss-workfile vss-revision vss-description skip
     2114               "filelist-dirlist-subdir-init" skip(1)
     2115               skip "Ошибка при вызове процедуры вывода"
     2116               skip "результатов сканирования каталогов."
     2117               skip return-value
     2118               skip trim(error-status :get-message(1))
     2119                       trim(error-status :get-message(2))
     2120                       trim(error-status :get-message(3))
     2121               view-as alert-box error.
     2122             undo, return error .
     2123           end.
     2124         end.
     2125       end.
     2126       input stream dir-list close .
     2127       return.
     2128     end.
     2129   end procedure.
     2130   procedure filelist-dirlist-init-by-list :
     2131     do
     2132     on error undo, return error
     2133     :
     2134       define input parameter p-root-dir   as character no-undo .
     2135       define input parameter p-dir-list   as character no-undo .
     2136       define input parameter p-filter-ext as logical   no-undo .
     2137       define input parameter p-ext-list   as character no-undo .
     2138       define variable v-num-appdir as integer   no-undo .
     2139       do v-num-appdir = 1 to num-entries(p-dir-list)
     2140       :
     2141         define variable v-curr-dir  as character no-undo .
     2142         assign
     2143           v-curr-dir = entry(v-num-appdir, p-dir-list)
     2144         .
     2145         run filelist-init in this-procedure
     2146           (input p-root-dir + '/':u + v-curr-dir
     2147           ,input p-filter-ext
     2148           ,input p-ext-list
     2149           ,input v-curr-dir
     2150           ) .
     2151       end.
     2152     end.
     2153   end procedure.
     2154   procedure filelist-dirlist-clear :
     2155     do
     2156     on error undo, return error
     2157     :
     2158       define buffer buf_temp-dirlist for temp-dirlist .
     2159       assign
     2160           v-filelist-total-dir-num = 0
     2161       .
     2162       for each buf_temp-dirlist
     2163       on error undo, return error
     2164       :
     2165         delete buf_temp-dirlist .
     2166       end.
     2167     end.
     2168   end procedure.
     2169   procedure filelist-dirlist-subdir-init :
     2170   define input parameter p-dir-name   as character no-undo .
     2171       define buffer buf_temp-dirlist for temp-dirlist .
     2172   do
     2173   for buf_temp-dirlist
     2174   on error undo, return error
     2175   :
     2176       assign
     2177           file-info :file-name = p-dir-name
     2178       .
     2179       if file-info :full-pathname = ?
     2180       or index( file-info :file-type, "D" ) = 0
     2181       then do:
     2182           message
     2183               vss-workfile vss-revision vss-description skip
     2184               "filelist-dirlist-init: Заданного каталога не существует."
     2185               skip (1)
     2186               skip "Задан каталог:"
     2187               skip substitute( "'&1'", p-dir-name )
     2188           view-as alert-box error .
     2189           undo, return error .
     2190       end.
     2191       input stream dir-list from os-dir( p-dir-name ).
     2192       define variable v-file                  as character no-undo .
     2193       define variable v-path                  as character no-undo .
     2194       define variable v-mask                  as character no-undo .
     2195       file-in-directory:
     2196       repeat
     2197       on error undo, return error
     2198       :
     2199           import stream dir-list
     2200               v-file
     2201               v-path
     2202               v-mask
     2203           .
     2204           if  v-mask = ?
     2205           or index( v-mask, 'D':u ) = 0
     2206           or v-file = ".":U
     2207           or v-file = "..":U
     2208           then do:
     2209               next file-in-directory.
     2210           end.
     2211           else do:
     2212               find first buf_temp-dirlist
     2213                    where buf_temp-dirlist.dir-full-name    = v-path
     2214               no-error.
     2215               if not available buf_temp-dirlist
     2216               then do:
     2217                   create buf_temp-dirlist .
     2218                   assign
     2219                       buf_temp-dirlist.dir-full-name    = v-path
     2220                       buf_temp-dirlist.dir-short-name   = v-file
     2221                       buf_temp-dirlist.need-process     = yes
     2222                   .
     2223               end.
     2224               assign
     2225                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
     2226               .
     2227               if v-filelist-main-procedure-handle <> ?
     2228               then do:
     2229                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
     2230                         input "dir":U
     2231                       , input v-filelist-total-dir-num
     2232                       , input buf_temp-dirlist.dir-full-name
     2233                       , input buf_temp-dirlist.dir-short-name
     2234                   ) no-error.
     2235                   if error-status :error
     2236                   then do:
     2237                       message
     2238                           vss-workfile vss-revision vss-description skip
     2239                           "filelist-dirlist-subdir-init"
     2240                           skip(1)
     2241                           skip "Ошибка при вызове процедуры вывода"
     2242                           skip "результатов сканирования каталогов."
     2243                           skip return-value
     2244                           skip trim(error-status :get-message(1))
     2245                                trim(error-status :get-message(2))
     2246                                trim(error-status :get-message(3))
     2247                       view-as alert-box error.
     2248                       undo, return error .
     2249                   end.
     2250               end.
     2251           end.
     2252       end.
     2253       input stream dir-list close .
     2254   end.
     2255   end procedure.
     2256   procedure filelist-dirlist-init :
     2257   define input parameter p-dir-name   as character no-undo .
     2258       define variable v-file  as character no-undo.
     2259       define variable v-path  as character no-undo.
     2260       define variable v-mask  as character no-undo.
     2261       define buffer buf_temp-dirlist for temp-dirlist .
     2262   do
     2263   for buf_temp-dirlist
     2264   on error undo, return error
     2265   :
     2266       assign
     2267           file-info :file-name = p-dir-name
     2268       .
     2269       if file-info :full-pathname = ?
     2270       or index( file-info :file-type, "D" ) = 0
     2271       then do:
     2272           message
     2273               vss-workfile vss-revision vss-description skip
     2274               "filelist-dirlist-init: Заданного каталога не существует."
     2275               skip (1)
     2276               skip "Задан каталог:"
     2277               skip substitute( "'&1'", p-dir-name )
     2278           view-as alert-box error .
     2279           undo, return error .
     2280       end.
     2281       for each buf_temp-dirlist
     2282          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
     2283       on error undo, return error return-value
     2284       :
     2285           delete buf_temp-dirlist .
     2286       end.
     2287       create buf_temp-dirlist .
     2288       assign
     2289           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
     2290           buf_temp-dirlist.dir-short-name   = file-info :file-name
     2291           buf_temp-dirlist.need-process     = yes
     2292       .
     2293       do
     2294       while available buf_temp-dirlist
     2295       on error undo, return error
     2296       :
     2297           run filelist-dirlist-subdir-init in this-procedure (
     2298               input buf_temp-dirlist.dir-full-name
     2299           ).
     2300           assign
     2301               buf_temp-dirlist.need-process = no
     2302           .
     2303           find first buf_temp-dirlist
     2304                where buf_temp-dirlist.need-process = yes
     2305           no-error.
     2306       end.
     2307   end.
     2308   end procedure.
     2309   procedure filelist-set-procedure-handle :
     2310   define input parameter p-proc-handle    as handle           no-undo.
     2311   define input parameter p-proc-name      as character        no-undo.
     2312       define variable v-signature    as character    no-undo.
     2313   do
     2314   on error undo, return error
     2315   :
     2316       if p-proc-handle = ?
     2317       or not valid-handle( p-proc-handle )
     2318       or p-proc-handle :get-signature( p-proc-name ) = ""
     2319       then do:
     2320           assign
     2321               v-filelist-main-procedure-handle = ?
     2322               v-filelist-main-procedure-name   = ""
     2323           .
     2324           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
     2325       end.
     2326       else do:
     2327           assign
     2328               v-signature = p-proc-handle :get-signature( p-proc-name )
     2329           .
     2330           if entry(   1, v-signature )    = "PROCEDURE":U
     2331           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
     2332           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
     2333           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
     2334           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
     2335           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
     2336           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
     2337           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
     2338           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
     2339           then do:
     2340               assign
     2341                   v-filelist-main-procedure-handle = p-proc-handle
     2342                   v-filelist-main-procedure-name   = p-proc-name
     2343               .
     2344           end.
     2345           else do:
     2346               assign
     2347                   v-filelist-main-procedure-handle = ?
     2348                   v-filelist-main-procedure-name   = ""
     2349               .
     2350               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
     2351           end.
     2352       end.
     2353   end.
     2354   end procedure.
     2355   procedure filelist-clear-procedure-handle :
     2356   do
     2357   on error undo, return error
     2358   :
     2359       assign
     2360           v-filelist-main-procedure-handle = ?
     2361           v-filelist-main-procedure-name   = ?
     2362       .
     2363   end.
     2364   end procedure.
     2365   procedure filelist-build-by-dirlist :
     2366       define buffer buf_temp-dirlist      for temp-dirlist.
     2367   do
     2368   for buf_temp-dirlist
     2369   on error undo, return error
     2370   :
     2371       for each buf_temp-dirlist
     2372       on error undo, return error
     2373       :
     2374           run filelist-init in this-procedure (
     2375                 input buf_temp-dirlist.dir-full-name
     2376               , input no
     2377               , input "":U
     2378               , input buf_temp-dirlist.dir-short-name
     2379           ).
     2380       end.
     2381   end.
     2382   end procedure.
     2383   procedure filelist-check-dir-exists :
     2384   define input parameter p-dir-name   as character        no-undo.
     2385   define output parameter p-exists    as logical          no-undo.
     2386   do
     2387   on error undo, return error
     2388   :
     2389       assign
     2390           file-info :file-name = p-dir-name
     2391       .
     2392       if file-info :file-type <> ?
     2393       and substring( file-info :file-type, 1, 1 ) = "D":U
     2394       then do:
     2395           assign
     2396               p-exists = yes
     2397           .
     2398       end.
     2399       else do:
     2400           assign
     2401               p-exists = no
     2402           .
     2403       end.
     2404   end.
     2405   end procedure.
     2406   procedure proc-alt-shift-f2:
     2407     if not ibs.th.gbl.gbl-var:rcode
     2408   then
     2409     run gbl\inidebug.p .
     2410   end.
     2411   procedure proc-alt-shift-f3:
     2412     run gbl/prvssinf.p
     2413       ( input this-procedure
     2414       ) .
     2415   end.
     2416   define variable v-inform-launched as logical no-undo initial false .
     2417   procedure proc-alt-shift-f4:
     2418     define variable v-action as character no-undo .
     2419     if v-inform-launched = false then do:
     2420       assign
     2421         v-inform-launched = true
     2422       .
     2423       run gbl/d-inform.w
     2424         (  input self
     2425         ,  input this-procedure
     2426         , output v-action
     2427         ) no-error .
     2428       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     2429       assign
     2430         v-inform-launched = false
     2431       .
     2432     end.
     2433   end.
     2434   procedure proc-alt-f1:
     2435     run gbl/corrhelp.p
     2436       (input this-procedure
     2437       ) .
     2438   end .
     2439   on alt-shift-f2 anywhere do:
     2440     run proc-alt-shift-f2.
     2441   end.
     2442   on alt-shift-f3 anywhere do:
     2443     run proc-alt-shift-f3 in this-procedure .
     2444   end.
     2445   on alt-shift-f4 anywhere do:
     2446     run proc-alt-shift-f4 in this-procedure.
     2447   end.
     2448   on alt-f1 anywhere do:
     2449     run proc-alt-f1 in this-procedure .
     2450   end.
     2451   define variable v-bgerddoc-last-record-id    as integer      no-undo.
     2452   DEFINE BUTTON b-exit
     2453        LABEL "&Выход"
     2454        SIZE 10 BY 1
     2455        BGCOLOR 8 .
     2456   DEFINE BUTTON b-help
     2457        LABEL "Помощ&ь"
     2458        SIZE 10 BY 1
     2459        BGCOLOR 8 .
     2460   DEFINE BUTTON b-search
     2461        LABEL "Найти"
     2462        SIZE 10 BY 1.
     2463   DEFINE BUTTON bt-change-cat
     2464        LABEL "&Изменить"
     2465        SIZE 10 BY 1.
     2466   DEFINE BUTTON bt-read
     2467        LABEL "&Чтение"
     2468        SIZE 10 BY 1.
     2469   DEFINE VARIABLE fi-catalog AS CHARACTER FORMAT "X(256)":U
     2470        LABEL "Каталог с файлами XML"
     2471        VIEW-AS FILL-IN
     2472        SIZE 63.75 BY 1
     2473        FGCOLOR 4  NO-UNDO.
     2474   DEFINE VARIABLE fi-search-string AS CHARACTER FORMAT "X(256)":U
     2475        LABEL "Пои&ск по номеру"
     2476        VIEW-AS FILL-IN
     2477        SIZE 15.75 BY 1 NO-UNDO.
     2478   DEFINE QUERY br-table FOR
     2479         temp_xmlview SCROLLING.
     2480   DEFINE BROWSE br-table
     2481     QUERY br-table DISPLAY
     2482         temp_xmlview.record-id column-label "N п/п" format ">>>>9"
     2483       temp_xmlview.filename column-label "Файл"  format "X(8)"
     2484       temp_xmlview.doc-code  column-label "Номер док-та"  format "X(14)"
     2485       temp_xmlview.ext-doc-type  column-label "Тип" format "X(3)"
     2486       temp_xmlview.doc-date  column-label "Дата" format "99/99/9999"
     2487       temp_xmlview.fact-date  column-label "Дата факт" format "99/99/9999"
     2488       temp_xmlview.doc-sum  column-label "Сумма " format "->>>,>>>,>>>,>>9.99 "
     2489       temp_xmlview.ps  column-label "Примечание" format "X(60)"
     2490       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.75 BY 18.75.
     2491   DEFINE FRAME Dialog-Frame
     2492        b-exit AT ROW 1 COL 2
     2493        bt-read AT ROW 1 COL 12
     2494        b-help AT ROW 1 COL 89.38
     2495        fi-catalog AT ROW 2.17 COL 23 COLON-ALIGNED
     2496        bt-change-cat AT ROW 2.25 COL 89.38
     2497        fi-search-string AT ROW 3.42 COL 16.75 COLON-ALIGNED
     2498        b-search AT ROW 3.42 COL 34.75
     2499        br-table AT ROW 4.67 COL 1.63
     2500        SPACE(0.49) SKIP(0.20)
     2501       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2502            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2503            TITLE "Просмотр выгрузки XML".
     2504   ASSIGN
     2505          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2506          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2507   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2508   DO:
     2509     APPLY "END-ERROR":U TO SELF.
     2510   END.
     2511   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2512   DO:
     2513       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     2514   END.
     2515   ON CHOOSE OF b-search IN FRAME Dialog-Frame
     2516   DO:
     2517       define variable v-found             as logical      no-undo.
     2518       define variable v-founded-recid     as recid        no-undo.
     2519       define variable v-focused-row       as integer      no-undo.
     2520       assign
     2521           fi-search-string
     2522       .
     2523       assign
     2524           v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     2525       .
     2526       run search-doc-num in this-procedure (
     2527             input fi-search-string
     2528           , output v-founded-recid
     2529           , output v-found
     2530       ).
     2531       if v-found = yes
     2532       then do:
     2533           br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame no-error.
     2534           reposition br-table to recid v-founded-recid.
     2535       end.
     2536       else do:
     2537           message
     2538               "Запись не найдена."
     2539           view-as alert-box information.
     2540       end.
     2541   END.
     2542   ON CHOOSE OF bt-change-cat IN FRAME Dialog-Frame
     2543   DO:
     2544       define variable v-full-dir-name     as character    no-undo.
     2545       define variable v-dir-type          as character    no-undo.
     2546       define variable v-can-write         as logical      no-undo.
     2547       run gbl/dir-sel.p (
     2548             output fi-catalog
     2549           , output v-dir-type
     2550           , output v-can-write
     2551       ) no-error.
     2552       if error-status :error
     2553       then do:
     2554           message
     2555                    vss-workfile vss-revision vss-description
     2556               skip(1)
     2557               skip "Ошибка выбора каталога."
     2558               skip return-value
     2559               skip trim(error-status :get-message(1))
     2560                    trim(error-status :get-message(2))
     2561                    trim(error-status :get-message(3))
     2562           view-as alert-box error.
     2563           undo, return no-apply .
     2564       end.
     2565       display
     2566           fi-catalog
     2567       with frame Dialog-Frame.
     2568   END.
     2569   ON CHOOSE OF bt-read IN FRAME Dialog-Frame
     2570   DO:
     2571       define variable v-yesno    as logical      no-undo.
     2572       message
     2573           "Процедура чтения файлов из каталога"
     2574           skip "может занять много времени."
     2575           skip(1)
     2576           skip "Прочитать файлы?"
     2577       view-as alert-box question
     2578       buttons ok-cancel
     2579       update v-yesno.
     2580       if v-yesno = no
     2581       then do:
     2582           undo, return no-apply.
     2583       end.
     2584   if session :set-wait-state( "compiler" ) then.
     2585       if fi-catalog :screen-value <> "":U
     2586       then do:
     2587           run read-files in this-procedure (
     2588               input fi-catalog :screen-value
     2589           ).
     2590       end.
     2591       message
     2592           "Чтение файлов каталога завершено."
     2593       view-as alert-box information.
     2594       OPEN QUERY br-table FOR EACH temp_xmlview NO-LOCK.
     2595   if session :set-wait-state( "" ) then.
     2596   END.
     2597   ON LEAVE OF fi-search-string IN FRAME Dialog-Frame
     2598   DO:
     2599       assign
     2600           v-bgerddoc-last-record-id = 0
     2601       .
     2602   END.
     2603   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2604   on help of frame Dialog-Frame
     2605   do:
     2606     run gbl/app_help.p
     2607       (input this-procedure :file-name
     2608       ,input ''
     2609       ,input ?
     2610       ) no-error.
     2611     if error-status :error then do:
     2612       message
     2613         "Ошибка при вызове помощи"
     2614         error-status :get-message(1)
     2615         view-as alert-box .
     2616     end.
     2617   end.
     2618   run minbtn-set in this-procedure .
     2619   on choose of b-help in frame Dialog-Frame
     2620   do:
     2621     apply "help":u to frame Dialog-Frame .
     2622   end.
     2623   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2624   procedure minbtn-set :
     2625       do
     2626           on error undo, return error return-value
     2627           :
     2628           define variable ii              as integer       no-undo .
     2629           define variable fh              as widget-handle no-undo .
     2630           define variable hh              as widget-handle no-undo .
     2631           define variable v-h             as handle        extent 4 no-undo .
     2632           define variable v-name-button   as character     no-undo .
     2633           define variable v-help-old-x    as decimal       no-undo .
     2634           define variable v-help-old-y    as decimal       no-undo .
     2635           define variable v-help-old-size as decimal       no-undo .
     2636           define variable v-frame-width   as decimal       no-undo .
     2637           define variable jj              as integer       no-undo .
     2638           do
     2639               on error undo, return error
     2640               :
     2641               assign
     2642                   v-frame-width = frame Dialog-Frame:width - 0.3
     2643                   fh            = frame Dialog-Frame:first-child
     2644                   hh            = fh:first-child
     2645                   ii            = 1
     2646                   .
     2647               do while valid-handle(hh):
     2648                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2649                   do:
     2650                       case lc(hh:name) :
     2651                           when "b-help" then
     2652                               do:
     2653                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2654                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2655                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2656                                   hh:TOOLTIP = "Помощь" .
     2657                                   v-help-old-x = hh:column .
     2658                                   v-help-old-y = hh:row    .
     2659                                   v-help-old-size = hh:width .
     2660                                   hh:width-chars = 2.5 .
     2661                               end.
     2662                           when "b-print" then
     2663                               do:
     2664                                   hh:load-image("cmp/b-print.bmp":u) .
     2665                                   hh:TOOLTIP = "Печать" .
     2666                                   v-h[ii] = hh:handle .
     2667                                   ii = ii + 1 .
     2668                                   hh:width-chars = 3 .
     2669                               end.
     2670                           when "b-history" or
     2671                           when "b-hist" then
     2672                               do:
     2673                                   hh:load-image("cmp/b-hist.bmp":u) .
     2674                                   hh:TOOLTIP = "История" .
     2675                                   v-h[ii] = hh:handle .
     2676                                   ii = ii + 1 .
     2677                                   hh:width-chars = 3 .
     2678                               end.
     2679                           when "b-sch" then
     2680                               do:
     2681                                   hh:load-image("cmp/b-sch.bmp":u) .
     2682                                   hh:TOOLTIP = "Установка Фильтра" .
     2683                                   v-h[ii] = hh:handle .
     2684                                   ii = ii + 1 .
     2685                                   hh:width-chars = 3 .
     2686                               end.
     2687                           when "b-hist-user" then
     2688                               do:
     2689                                   hh:load-image("cmp/b-hist.bmp":u) .
     2690                                   hh:TOOLTIP = "История пользователя" .
     2691                                   ii = ii + 1 .
     2692                               end.
     2693                       end case.
     2694                   end.
     2695                   hh = hh:next-sibling.
     2696               end.
     2697               b-help:column = v-frame-width - b-help:width-chars.
     2698               jj = 0.
     2699               repeat ii = 4 to 1 by -1 :
     2700                   if valid-handle (v-h[ii] ) then
     2701                   do:
     2702                       jj  = jj + 1 .
     2703                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2704                       v-h[ii]:row    = v-help-old-y .
     2705                   end.
     2706               end.
     2707           end.
     2708       end.
     2709   end procedure.
     2710   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2711   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2712   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2713   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2714   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2715   define variable v-diasize-current-frame-height as decimal   no-undo .
     2716   define variable v-diasize-change-size          as logical   no-undo .
     2717   define variable v-diasize-resize-button        as handle    no-undo .
     2718   define variable v-diasize-wndmax               as logical   no-undo .
     2719   define variable v-diasize-wndstore             as logical   no-undo .
     2720   define variable v-diasize-proc-name            as character no-undo .
     2721   define variable v-diasize-browse-handle        as handle    no-undo .
     2722   define variable v-diasize-browse-number        as integer   no-undo .
     2723   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2724   define temp-table temp-diasize-handle no-undo
     2725     field handle-value  as handle
     2726     field save-position as decimal
     2727     index xpk is primary unique handle-value
     2728     .
     2729   define temp-table temp-browse-handle no-undo
     2730     field browse-type   as character
     2731     field browse-number as integer
     2732     field browse-handle as handle
     2733     field original-size as decimal
     2734     index xpk is primary unique browse-type browse-number
     2735     index xie browse-type browse-handle
     2736   .
     2737   procedure diasize_change-height :
     2738     define input  parameter p-change-value  as decimal   no-undo .
     2739     define input  parameter p-move-resize   as logical   no-undo .
     2740     define variable v-field-group-handle    as handle    no-undo .
     2741     define variable v-object-handle         as handle    no-undo .
     2742     define variable v-frame-height          as decimal   no-undo .
     2743     define variable v-frame-virtual-height  as decimal   no-undo .
     2744     define variable v-browse-height         as decimal   no-undo .
     2745     define variable v-window-height         as decimal   no-undo .
     2746     define variable v-window-virtual-height as decimal   no-undo .
     2747     define variable v-change-sign           as integer   no-undo .
     2748     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2749     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2750     if p-change-value > 0
     2751     then do:
     2752       if frame Dialog-Frame :height + p-change-value
     2753           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2754       then do:
     2755         assign
     2756           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2757                           - (frame Dialog-Frame :height-chars)
     2758         .
     2759         if p-change-value <= 0
     2760         then do:
     2761           run diasize_position-resize-button in this-procedure .
     2762           return .
     2763         end.
     2764       end.
     2765     end.
     2766     if p-change-value < 0
     2767     then do:
     2768       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2769       then do:
     2770         assign
     2771           p-change-value = v-diasize-orig-frame-height
     2772                          - (frame Dialog-Frame :height-chars)
     2773         .
     2774         if p-change-value >= 0
     2775         then do:
     2776           run diasize_position-resize-button in this-procedure .
     2777           return .
     2778         end.
     2779       end.
     2780     end.
     2781     if p-change-value >= 0
     2782     then do:
     2783       assign
     2784         v-change-sign = 1
     2785       .
     2786     end.
     2787     else do:
     2788       assign
     2789         v-change-sign = -1
     2790       .
     2791     end.
     2792     assign
     2793       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2794     .
     2795     if p-change-value = 0
     2796     then do:
     2797       run diasize_position-resize-button in this-procedure .
     2798       return .
     2799     end.
     2800     move_block:
     2801     do
     2802     on error undo move_block, retry move_block
     2803     :
     2804       if retry
     2805       then do:
     2806         do
     2807         on error undo move_block, leave move_block
     2808         :
     2809           if p-change-value > 0
     2810           then do:
     2811             for each buf_temp-diasize-handle
     2812             on error undo, next
     2813             :
     2814               assign
     2815                 v-object-handle = buf_temp-diasize-handle.handle-value
     2816               .
     2817               if v-object-handle <> v-diasize-resize-button
     2818               then do:
     2819                 assign
     2820                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2821                 .
     2822               end.
     2823             end.
     2824             assign
     2825               v-diasize-browse-handle :height = v-browse-height
     2826             .
     2827             for each buf_temp-browse-handle
     2828               where buf_temp-browse-handle.browse-type = 'height':u
     2829             on error undo, next
     2830             :
     2831               assign
     2832                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2833               .
     2834             end.
     2835             assign
     2836               frame Dialog-Frame :height = v-frame-height
     2837             .
     2838             if frame Dialog-Frame :scrollable = true
     2839             then do:
     2840               assign
     2841                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2842               .
     2843             end.
     2844             run diasize_position-resize-button in this-procedure .
     2845           end.
     2846           else do:
     2847             if frame Dialog-Frame :scrollable = true
     2848             then do:
     2849               assign
     2850                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2851               .
     2852             end.
     2853             assign
     2854               frame Dialog-Frame :height = v-frame-height
     2855             .
     2856             assign
     2857               v-diasize-browse-handle :height = v-browse-height
     2858             .
     2859             for each buf_temp-browse-handle
     2860               where buf_temp-browse-handle.browse-type = 'height':u
     2861             on error undo, next
     2862             :
     2863               assign
     2864                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2865               .
     2866             end.
     2867             for each buf_temp-diasize-handle
     2868             on error undo, next
     2869             :
     2870               assign
     2871                 v-object-handle = buf_temp-diasize-handle.handle-value
     2872               .
     2873               if v-object-handle <> v-diasize-resize-button
     2874               then do:
     2875                 assign
     2876                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2877                 .
     2878               end.
     2879             end.
     2880             run diasize_position-resize-button in this-procedure .
     2881           end.
     2882           assign
     2883             v-diasize-change-size = false
     2884           .
     2885           leave move_block .
     2886         end.
     2887       end.
     2888       assign
     2889         v-diasize-need-full-display = true
     2890       .
     2891       if v-diasize-change-size = false
     2892       then do:
     2893         assign
     2894           v-diasize-change-size = true
     2895         .
     2896       end.
     2897       else do:
     2898         return .
     2899       end.
     2900       assign
     2901         v-frame-height = frame Dialog-Frame :height
     2902         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2903         v-browse-height = v-diasize-browse-handle :height
     2904       .
     2905       for each buf_temp-browse-handle
     2906         where buf_temp-browse-handle.browse-type = 'height':u
     2907       :
     2908         assign
     2909           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2910         .
     2911       end.
     2912       for each buf_temp-diasize-handle
     2913       :
     2914         delete buf_temp-diasize-handle .
     2915       end.
     2916       assign
     2917         v-field-group-handle = frame Dialog-Frame :first-child
     2918       .
     2919       do while valid-handle(v-field-group-handle)
     2920       :
     2921         assign
     2922           v-object-handle = v-field-group-handle :first-child
     2923         .
     2924         do while valid-handle(v-object-handle)
     2925         :
     2926           if  v-object-handle <> v-diasize-browse-handle :handle
     2927           and can-query(v-object-handle, "row")
     2928           and can-query(v-object-handle, "height")
     2929           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2930           then do:
     2931             find first buf_temp-browse-handle
     2932               where buf_temp-browse-handle.browse-type   = 'height':u
     2933                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2934               no-error .
     2935             if available buf_temp-browse-handle
     2936             then do:
     2937             end.
     2938             else do:
     2939               create buf_temp-diasize-handle .
     2940               assign
     2941                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2942                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2943               .
     2944             end.
     2945           end.
     2946           assign
     2947             v-object-handle = v-object-handle :next-sibling
     2948           .
     2949         end.
     2950         assign
     2951           v-field-group-handle = v-field-group-handle :next-sibling
     2952         .
     2953       end.
     2954       do with frame Dialog-Frame
     2955       :
     2956         hide v-diasize-resize-button .
     2957         assign
     2958           v-diasize-resize-button :row    = 1
     2959           v-diasize-resize-button :column = 1
     2960         .
     2961       end.
     2962       if p-change-value > 0
     2963       then do:
     2964         if frame Dialog-Frame :scrollable = true
     2965         then do:
     2966           assign
     2967             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2968             no-error .
     2969           if error-status :error
     2970           or error-status :get-message(1) <> ""
     2971           then do:
     2972             undo move_block, retry move_block .
     2973           end.
     2974         end.
     2975         assign
     2976           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2977           no-error .
     2978         if error-status :error
     2979         or error-status :get-message(1) <> ""
     2980         then do:
     2981           undo move_block, retry move_block .
     2982         end.
     2983         assign
     2984           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2985           no-error .
     2986         if error-status :error
     2987         or error-status :get-message(1) <> ""
     2988         then do:
     2989           undo move_block, retry move_block .
     2990         end.
     2991         for each buf_temp-browse-handle
     2992           where buf_temp-browse-handle.browse-type = 'height':u
     2993         on error undo move_block, retry move_block
     2994         :
     2995           assign
     2996             buf_temp-browse-handle.browse-handle :height
     2997               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2998             no-error .
     2999           if error-status :error
     3000           or error-status :get-message(1) <> ""
     3001           then do:
     3002             undo move_block, retry move_block .
     3003           end.
     3004         end.
     3005         for each buf_temp-diasize-handle
     3006         on error undo move_block, retry move_block
     3007         :
     3008           assign
     3009             v-object-handle = buf_temp-diasize-handle.handle-value
     3010           .
     3011           if v-object-handle <> v-diasize-resize-button
     3012           then do:
     3013             assign
     3014               v-object-handle :row = v-object-handle :row + p-change-value
     3015               no-error .
     3016             if error-status :error
     3017             or error-status :get-message(1) <> ""
     3018             then do:
     3019               undo move_block, retry move_block .
     3020             end.
     3021           end.
     3022         end.
     3023       end.
     3024       else do:
     3025         for each buf_temp-diasize-handle
     3026         on error undo move_block, retry move_block
     3027         :
     3028           assign
     3029             v-object-handle = buf_temp-diasize-handle.handle-value
     3030           .
     3031           if v-object-handle <> v-diasize-resize-button
     3032           then do:
     3033             assign
     3034               v-object-handle :row = v-object-handle :row + p-change-value
     3035               no-error .
     3036             if error-status :error
     3037             or error-status :get-message(1) <> ""
     3038             then do:
     3039               undo move_block, retry move_block .
     3040             end.
     3041           end.
     3042         end.
     3043         assign
     3044           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3045           no-error .
     3046         if error-status :error
     3047         or error-status :get-message(1) <> ""
     3048         then do:
     3049           undo move_block, retry move_block .
     3050         end.
     3051         for each buf_temp-browse-handle
     3052           where buf_temp-browse-handle.browse-type = 'height':u
     3053         on error undo move_block, retry move_block
     3054         :
     3055           assign
     3056             buf_temp-browse-handle.browse-handle :height
     3057               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3058             no-error .
     3059           if error-status :error
     3060           or error-status :get-message(1) <> ""
     3061           then do:
     3062             undo move_block, retry move_block .
     3063           end.
     3064         end.
     3065         assign
     3066           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3067           no-error .
     3068         if error-status :error
     3069         or error-status :get-message(1) <> ""
     3070         then do:
     3071           undo move_block, retry move_block .
     3072         end.
     3073         if frame Dialog-Frame :scrollable = true
     3074         then do:
     3075           assign
     3076             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3077             no-error .
     3078           if error-status :error
     3079           or error-status :get-message(1) <> ""
     3080           then do:
     3081             undo move_block, retry move_block .
     3082           end.
     3083         end.
     3084       end.
     3085       if p-move-resize = true
     3086       then do:
     3087         run diasize_position-resize-button in this-procedure .
     3088       end.
     3089       if v-diasize-wndstore = true
     3090       then do:
     3091         if connected("ub") = true
     3092         then do:
     3093           define variable v-cntxt-db-num        as integer   no-undo .
     3094           define variable v-cntxt-userid        as character no-undo .
     3095           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3096                                             , OUTPUT v-cntxt-userid
     3097                                             ) .
     3098           run gbl/wndsizew.p
     3099             (input  v-cntxt-db-num
     3100             ,input  v-cntxt-userid
     3101             ,input  v-diasize-proc-name
     3102             ,input  'height':u
     3103             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3104             ) .
     3105         end.
     3106       end.
     3107     end.
     3108     assign
     3109       v-diasize-change-size = false
     3110     .
     3111   end procedure.
     3112   procedure diasize_set-height :
     3113     define input  parameter p-new-height  as decimal   no-undo .
     3114     define input  parameter p-move-resize as logical   no-undo .
     3115     do
     3116     on error undo, return error return-value
     3117     :
     3118       run diasize_change-height in this-procedure
     3119         (input  (p-new-height - frame Dialog-Frame :height)
     3120         ,input  p-move-resize
     3121         ) .
     3122     end.
     3123   end procedure.
     3124   procedure diasize_change-width :
     3125     define input  parameter p-change-value as decimal   no-undo .
     3126     define input  parameter p-move-resize  as logical   no-undo .
     3127     define variable v-field-group-handle   as handle    no-undo .
     3128     define variable v-object-handle        as handle    no-undo .
     3129     define variable v-frame-width          as decimal   no-undo .
     3130     define variable v-frame-virtual-width  as decimal   no-undo .
     3131     define variable v-browse-width         as decimal   no-undo .
     3132     define variable v-window-width         as decimal   no-undo .
     3133     define variable v-window-virtual-width as decimal   no-undo .
     3134     define variable v-change-sign          as integer   no-undo .
     3135     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3136     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3137     if p-change-value > 0
     3138     then do:
     3139       if frame Dialog-Frame :width + p-change-value >
     3140           session :width-chars
     3141       then do:
     3142         assign
     3143           p-change-value = session :width-chars - frame Dialog-Frame :width
     3144         .
     3145         if p-change-value <= 0
     3146         then do:
     3147           run diasize_position-resize-button in this-procedure .
     3148           return .
     3149         end.
     3150       end.
     3151     end.
     3152     if p-change-value < 0
     3153     then do:
     3154       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3155       then do:
     3156         assign
     3157           p-change-value = v-diasize-orig-frame-width
     3158                          - frame Dialog-Frame :width
     3159         .
     3160         if p-change-value >= 0
     3161         then do:
     3162           run diasize_position-resize-button in this-procedure .
     3163           return .
     3164         end.
     3165       end.
     3166     end.
     3167     if p-change-value >= 0
     3168     then do:
     3169       assign
     3170         v-change-sign = 1
     3171       .
     3172     end.
     3173     else do:
     3174       assign
     3175         v-change-sign = -1
     3176       .
     3177     end.
     3178     assign
     3179       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3180     .
     3181     if p-change-value = 0
     3182     then do:
     3183       run diasize_position-resize-button in this-procedure .
     3184       return .
     3185     end.
     3186     move_block:
     3187     do
     3188     on error undo move_block, leave move_block
     3189     :
     3190       if retry
     3191       then do:
     3192         do
     3193         on error undo move_block, leave move_block
     3194         :
     3195           if p-change-value > 0
     3196           then do:
     3197             for each buf_temp-diasize-handle
     3198             on error undo, next
     3199             :
     3200               assign
     3201                 v-object-handle = buf_temp-diasize-handle.handle-value
     3202               .
     3203               if v-object-handle <> v-diasize-resize-button
     3204               then do:
     3205                 assign
     3206                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3207                 .
     3208               end.
     3209             end.
     3210             assign
     3211               v-diasize-browse-handle :width = v-browse-width
     3212             .
     3213             for each buf_temp-browse-handle
     3214               where buf_temp-browse-handle.browse-type = 'width':u
     3215             on error undo, next
     3216             :
     3217               assign
     3218                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3219               .
     3220             end.
     3221             assign
     3222               frame Dialog-Frame :width = v-frame-width
     3223             .
     3224             if frame Dialog-Frame :scrollable = true
     3225             then do:
     3226               assign
     3227                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3228               .
     3229             end.
     3230             run diasize_position-resize-button in this-procedure .
     3231           end.
     3232           else do:
     3233             if frame Dialog-Frame :scrollable = true
     3234             then do:
     3235               assign
     3236                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3237               .
     3238             end.
     3239             assign
     3240               frame Dialog-Frame :width = v-frame-width
     3241             .
     3242             for each buf_temp-browse-handle
     3243               where buf_temp-browse-handle.browse-type = 'width':u
     3244             on error undo, next
     3245             :
     3246               assign
     3247                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3248               .
     3249             end.
     3250             assign
     3251               v-diasize-browse-handle :width = v-browse-width
     3252             .
     3253             for each buf_temp-diasize-handle
     3254             on error undo, next
     3255             :
     3256               assign
     3257                 v-object-handle = buf_temp-diasize-handle.handle-value
     3258               .
     3259               if v-object-handle <> v-diasize-resize-button
     3260               then do:
     3261                 assign
     3262                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3263                 .
     3264               end.
     3265             end.
     3266             run diasize_position-resize-button in this-procedure .
     3267           end.
     3268           assign
     3269             v-diasize-change-size = false
     3270           .
     3271           leave move_block .
     3272         end.
     3273       end.
     3274       assign
     3275         v-diasize-need-full-display = true
     3276       .
     3277       if v-diasize-change-size = false
     3278       then do:
     3279         assign
     3280           v-diasize-change-size = true
     3281         .
     3282       end.
     3283       else do:
     3284         return .
     3285       end.
     3286       assign
     3287         v-frame-width = frame Dialog-Frame :width
     3288         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3289         v-browse-width = v-diasize-browse-handle :width
     3290       .
     3291       for each buf_temp-browse-handle
     3292         where buf_temp-browse-handle.browse-type = 'width':u
     3293       :
     3294         assign
     3295           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3296         .
     3297       end.
     3298       for each buf_temp-diasize-handle
     3299       :
     3300         delete buf_temp-diasize-handle .
     3301       end.
     3302       assign
     3303         v-field-group-handle = frame Dialog-Frame :first-child
     3304       .
     3305       do while valid-handle(v-field-group-handle)
     3306       :
     3307         assign
     3308           v-object-handle = v-field-group-handle :first-child
     3309         .
     3310         do while valid-handle(v-object-handle)
     3311         :
     3312           if  v-object-handle <> v-diasize-browse-handle :handle
     3313           and v-object-handle <> v-diasize-resize-button
     3314           and can-query(v-object-handle, "row")
     3315           and can-query(v-object-handle, "height")
     3316           and ( v-object-handle :col + v-object-handle :width
     3317                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3318               )
     3319           then do:
     3320             find first buf_temp-browse-handle
     3321               where buf_temp-browse-handle.browse-type   = 'width':u
     3322                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3323               no-error .
     3324             if available buf_temp-browse-handle
     3325             then do:
     3326             end.
     3327             else do:
     3328               create buf_temp-diasize-handle .
     3329               assign
     3330                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3331                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3332               .
     3333             end.
     3334           end.
     3335           assign
     3336             v-object-handle = v-object-handle :next-sibling
     3337           .
     3338         end.
     3339         assign
     3340           v-field-group-handle = v-field-group-handle :next-sibling
     3341         .
     3342       end.
     3343       do with frame Dialog-Frame
     3344       :
     3345         hide v-diasize-resize-button .
     3346         v-diasize-resize-button :row = 1.
     3347         v-diasize-resize-button :column = 1.
     3348       end.
     3349       if p-change-value > 0
     3350       then do:
     3351         if frame Dialog-Frame :scrollable = true
     3352         then do:
     3353           assign
     3354             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3355             no-error .
     3356           if error-status :error
     3357           or error-status :get-message(1) <> ""
     3358           then do:
     3359             undo move_block, retry move_block.
     3360           end.
     3361         end.
     3362         assign
     3363           frame Dialog-Frame :width = v-frame-width + p-change-value
     3364           no-error .
     3365         if error-status :error
     3366         or error-status :get-message(1) <> ""
     3367         then do:
     3368           undo move_block, retry move_block.
     3369         end.
     3370         assign
     3371           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3372         no-error .
     3373         if error-status :error
     3374         or error-status :get-message(1) <> ""
     3375         then do:
     3376           undo move_block, retry move_block.
     3377         end.
     3378         for each buf_temp-browse-handle
     3379           where buf_temp-browse-handle.browse-type = 'width':u
     3380         on error undo move_block, retry move_block
     3381         :
     3382           assign
     3383             buf_temp-browse-handle.browse-handle :width
     3384               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3385             no-error .
     3386           if error-status :error
     3387           or error-status :get-message(1) <> ""
     3388           then do:
     3389             undo move_block, retry move_block .
     3390           end.
     3391         end.
     3392         for each buf_temp-diasize-handle
     3393         on error undo move_block, retry move_block
     3394         :
     3395           assign
     3396             v-object-handle = buf_temp-diasize-handle.handle-value
     3397           .
     3398           if v-object-handle <> v-diasize-resize-button
     3399           then do:
     3400             assign
     3401               v-object-handle :col = v-object-handle :col + p-change-value
     3402               no-error .
     3403             if error-status :error
     3404             or error-status :get-message(1) <> ""
     3405             then do:
     3406               undo move_block, retry move_block .
     3407             end.
     3408           end.
     3409         end.
     3410       end.
     3411       else do:
     3412         for each buf_temp-diasize-handle
     3413         on error undo move_block, retry move_block
     3414         :
     3415           assign
     3416             v-object-handle = buf_temp-diasize-handle.handle-value
     3417           .
     3418           if v-object-handle <> v-diasize-resize-button
     3419           then do:
     3420             assign
     3421               v-object-handle :col = v-object-handle :col + p-change-value
     3422               no-error .
     3423             if error-status :error
     3424             or error-status :get-message(1) <> ""
     3425             then do:
     3426               undo move_block, retry move_block .
     3427             end.
     3428           end.
     3429         end.
     3430         for each buf_temp-browse-handle
     3431           where buf_temp-browse-handle.browse-type = 'width':u
     3432         on error undo move_block, retry move_block
     3433         :
     3434           assign
     3435             buf_temp-browse-handle.browse-handle :width
     3436               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3437             no-error .
     3438           if error-status :error
     3439           or error-status :get-message(1) <> ""
     3440           then do:
     3441             undo move_block, retry move_block .
     3442           end.
     3443         end.
     3444         assign
     3445           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3446           no-error .
     3447         if error-status :error
     3448         or error-status :get-message(1) <> ""
     3449         then do:
     3450           undo move_block, retry move_block.
     3451         end.
     3452         assign
     3453           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3454         no-error .
     3455         if error-status :error
     3456         or error-status :get-message(1) <> ""
     3457         then do:
     3458           undo move_block, retry move_block.
     3459         end.
     3460         if frame Dialog-Frame :scrollable = true
     3461         then do:
     3462           assign
     3463             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3464           no-error .
     3465           if error-status :error
     3466           or error-status :get-message(1) <> ""
     3467           then do:
     3468             undo move_block, retry move_block.
     3469           end.
     3470         end.
     3471       end.
     3472       if p-move-resize
     3473       then do:
     3474         run diasize_position-resize-button in this-procedure .
     3475       end.
     3476       if v-diasize-wndstore = true
     3477       then do:
     3478         if connected("ub") = true
     3479         then do:
     3480           define variable v-cntxt-db-num        as integer   no-undo .
     3481           define variable v-cntxt-userid        as character no-undo .
     3482           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3483                                             , OUTPUT v-cntxt-userid
     3484                                             ) .
     3485           run gbl/wndsizew.p
     3486             (input  v-cntxt-db-num
     3487             ,input  v-cntxt-userid
     3488             ,input  v-diasize-proc-name
     3489             ,input  'width':u
     3490             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3491             ) .
     3492         end.
     3493       end.
     3494     end.
     3495     assign
     3496       v-diasize-change-size = false
     3497     .
     3498   end procedure.
     3499   procedure diasize_set-width :
     3500     define input  parameter p-new-width  as decimal   no-undo .
     3501     define input  parameter p-move-resize as logical   no-undo .
     3502     do
     3503     on error undo, return error return-value
     3504     :
     3505       run diasize_change-width in this-procedure
     3506         (input  (p-new-width - frame Dialog-Frame :width)
     3507         ,input  p-move-resize
     3508         ) .
     3509     end.
     3510   end procedure.
     3511   procedure diasize_position-resize-button :
     3512     do with frame Dialog-Frame
     3513     :
     3514       hide v-diasize-resize-button .
     3515       assign
     3516         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3517                     - 1
     3518                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3519         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3520                     - 1
     3521                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3522       .
     3523       view v-diasize-resize-button .
     3524     end.
     3525   end procedure.
     3526   on alt-right anywhere
     3527   do:
     3528     run diasize_change-width in this-procedure
     3529       (input 1
     3530       ,input true
     3531       ) .
     3532     return no-apply .
     3533   end.
     3534   on alt-left anywhere
     3535   do:
     3536     run diasize_change-width in this-procedure
     3537       (input -1
     3538       ,input true
     3539       ) .
     3540     return no-apply .
     3541   end.
     3542   on alt-down anywhere
     3543   do:
     3544     run diasize_change-height in this-procedure
     3545       (input 1
     3546       ,input true
     3547       ) .
     3548     return no-apply .
     3549   end.
     3550   on alt-up anywhere
     3551   do:
     3552     run diasize_change-height in this-procedure
     3553       (input -1
     3554       ,input true
     3555       ) .
     3556     return no-apply .
     3557   end.
     3558   on alt-enter of frame Dialog-Frame
     3559   do:
     3560     run diasize_maximize in this-procedure
     3561       (input  ?
     3562       ).
     3563     return no-apply .
     3564   end.
     3565   procedure diasize_end-move :
     3566     do
     3567     on error undo, return error return-value
     3568     :
     3569       define variable v-row-delta as decimal   no-undo .
     3570       define variable v-col-delta as decimal   no-undo .
     3571       define variable v-new-row as decimal   no-undo .
     3572       define variable v-new-col as decimal   no-undo .
     3573       assign
     3574         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3575         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3576       .
     3577       assign
     3578         v-row-delta = v-new-row - frame Dialog-Frame :height
     3579         v-col-delta = v-new-col - frame Dialog-Frame :width
     3580       .
     3581       run diasize_change-height in this-procedure
     3582         (input v-row-delta
     3583         ,input true
     3584         ) .
     3585       run diasize_change-width in this-procedure
     3586         (input v-col-delta
     3587         ,input true
     3588         ) .
     3589     end.
     3590   end procedure.
     3591   procedure diasize_maximize :
     3592     define input  parameter p-action as logical   no-undo .
     3593     do
     3594     on error undo, return error return-value
     3595     :
     3596       if p-action = ?
     3597       then do:
     3598         if v-diasize-need-maximize = true
     3599         then do:
     3600           assign
     3601             p-action = true
     3602           .
     3603         end.
     3604         else do:
     3605           assign
     3606             p-action = false
     3607           .
     3608         end.
     3609       end.
     3610       if p-action = true
     3611       then do:
     3612         run diasize_change-height in this-procedure
     3613           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3614               - frame Dialog-Frame :height-chars
     3615           ,input true
     3616           ) .
     3617         run diasize_change-width in this-procedure
     3618           (input session :width-chars
     3619               - frame Dialog-Frame :width-chars
     3620           ,input true
     3621           ) .
     3622         assign
     3623           v-diasize-need-maximize = false
     3624         .
     3625       end.
     3626       else do:
     3627         run diasize_change-width in this-procedure
     3628           (input v-diasize-orig-frame-width
     3629               - frame Dialog-Frame :width-chars
     3630           ,input true
     3631           ) .
     3632         run diasize_change-height in this-procedure
     3633           (input v-diasize-orig-frame-height
     3634               - frame Dialog-Frame :height-chars
     3635           ,input true
     3636           ) .
     3637         assign
     3638           v-diasize-need-maximize = true
     3639         .
     3640       end.
     3641     end.
     3642   end procedure.
     3643   procedure diasize_restore-orig-size :
     3644     do
     3645     on error undo, return error return-value
     3646     :
     3647       assign
     3648         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3649         v-diasize-current-frame-height = frame Dialog-Frame :height
     3650       .
     3651       run diasize_set-height in this-procedure
     3652         (input  v-diasize-orig-frame-height
     3653         ,input  true
     3654         ) .
     3655       run diasize_set-width in this-procedure
     3656         (input  v-diasize-orig-frame-width
     3657         ,input  true
     3658         ) .
     3659     end.
     3660   end procedure.
     3661   procedure diasize_restore-current-size :
     3662     do
     3663     on error undo, return error return-value
     3664     :
     3665       run diasize_set-height in this-procedure
     3666         (input  v-diasize-current-frame-height
     3667         ,input  true
     3668         ) .
     3669       run diasize_set-width in this-procedure
     3670         (input  v-diasize-current-frame-width
     3671         ,input  true
     3672         ) .
     3673     end.
     3674   end procedure.
     3675   procedure diasize_set-browse-handle :
     3676     define input  parameter p-browse-handle as handle   no-undo .
     3677     define buffer buf_temp-browse-handle for temp-browse-handle .
     3678     do
     3679     on error undo, return error return-value
     3680     :
     3681       assign
     3682         v-diasize-browse-handle = p-browse-handle
     3683       .
     3684       for each buf_temp-browse-handle
     3685       on error undo, return error return-value
     3686       :
     3687         delete buf_temp-browse-handle .
     3688       end.
     3689     end.
     3690   end procedure.
     3691   procedure diasize_add_browse :
     3692     define input  parameter p-browse-type   as character no-undo .
     3693     define input  parameter p-browse-handle as handle    no-undo .
     3694     define buffer buf_temp-browse-handle for temp-browse-handle .
     3695     do
     3696     on error undo, return error return-value
     3697     :
     3698       assign
     3699         v-diasize-browse-number = v-diasize-browse-number + 1
     3700       .
     3701       create buf_temp-browse-handle .
     3702       assign
     3703         buf_temp-browse-handle.browse-type   = p-browse-type
     3704         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3705         buf_temp-browse-handle.browse-handle = p-browse-handle
     3706       .
     3707     end.
     3708   end procedure.
     3709   procedure diasize_init :
     3710     define variable v-default-value    as logical   no-undo .
     3711     define variable v-restore-saved    as logical   no-undo .
     3712     define variable v-resize-value-str as character no-undo .
     3713     do
     3714     on error undo, return error return-value
     3715     :
     3716       do with frame Dialog-Frame
     3717       :
     3718         assign
     3719           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3720           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3721           v-diasize-browse-handle     = browse br-table :handle
     3722         .
     3723         create button v-diasize-resize-button
     3724         assign
     3725           parent        = frame Dialog-Frame :first-child
     3726           label         = "s"
     3727           height-pixels = 16
     3728           width-pixels  = 16
     3729           visible       = true
     3730           sensitive     = true
     3731           movable       = true
     3732           triggers:
     3733             on end-move persistent run diasize_end-move in this-procedure .
     3734           end triggers.
     3735         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3736         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3737         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3738         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3739         assign
     3740           v-diasize-wndmax = false
     3741         .
     3742         if connected("ub") = true
     3743         then do:
     3744           define variable v-cntxt-db-num        as integer   no-undo .
     3745           define variable v-cntxt-userid        as character no-undo .
     3746           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3747                                             , OUTPUT v-cntxt-userid
     3748                                             ) .
     3749           run gbl/wndpar_r.p
     3750             (input  v-cntxt-db-num
     3751             ,input  v-cntxt-userid
     3752             ,input  'wndmax':U
     3753             ,output v-diasize-wndmax
     3754             ,output v-default-value
     3755             ) .
     3756         end.
     3757         assign
     3758           v-diasize-wndstore = false
     3759         .
     3760         if connected("ub") = true
     3761         then do:
     3762           run gbl/wndpar_r.p
     3763             (input  v-cntxt-db-num
     3764             ,input  v-cntxt-userid
     3765             ,input  'wndstore':U
     3766             ,output v-diasize-wndstore
     3767             ,output v-default-value
     3768             ) .
     3769         end.
     3770         assign
     3771           v-diasize-proc-name = entry(1, program-name(2), '.')
     3772         .
     3773         if v-diasize-wndstore = true
     3774         then do:
     3775           assign
     3776             v-restore-saved = false
     3777           .
     3778           if connected("ub") = true
     3779           then do:
     3780             run gbl/wndsizer.p
     3781               (input  v-cntxt-db-num
     3782               ,input  v-cntxt-userid
     3783               ,input  v-diasize-proc-name
     3784               ,input  'height':u
     3785               ,output v-resize-value-str
     3786               ) .
     3787             if v-resize-value-str <> '':U
     3788             then do:
     3789               run diasize_change-height in this-procedure
     3790                 (input  integer(v-resize-value-str)
     3791                 ,input  true
     3792                 ) .
     3793               assign
     3794                 v-restore-saved = true
     3795               .
     3796             end.
     3797           end.
     3798           if connected("ub") = true
     3799           then do:
     3800             run gbl/wndsizer.p
     3801               (input  v-cntxt-db-num
     3802               ,input  v-cntxt-userid
     3803               ,input  v-diasize-proc-name
     3804               ,input  'width':u
     3805               ,output v-resize-value-str
     3806               ) .
     3807             if v-resize-value-str <> '':U
     3808             then do:
     3809               run diasize_change-width in this-procedure
     3810                 (input  integer(v-resize-value-str)
     3811                 ,input  true
     3812                 ) .
     3813               assign
     3814                 v-restore-saved = true
     3815               .
     3816             end.
     3817           end.
     3818           if v-restore-saved <> true
     3819           then do:
     3820             if v-diasize-wndmax = true
     3821             then do:
     3822               run diasize_maximize in this-procedure
     3823                 (input  true
     3824                 ) .
     3825             end.
     3826           end.
     3827         end.
     3828         else do:
     3829           if v-diasize-wndmax = true
     3830           then do:
     3831             run diasize_maximize in this-procedure
     3832               (input  true
     3833               ) .
     3834           end.
     3835         end.
     3836       end.
     3837     end.
     3838   end procedure.
     3839   procedure diasize_need-full-display :
     3840     define output parameter p-need-full-display as logical   no-undo .
     3841     do
     3842     on error undo, return error return-value
     3843     :
     3844       assign
     3845         p-need-full-display = v-diasize-need-full-display
     3846       .
     3847       assign
     3848         v-diasize-need-full-display = false
     3849       .
     3850     end.
     3851   end procedure.
     3852   procedure get-context :
     3853      define output parameter p-db-num as integer          no-undo.
     3854      define output parameter p-user-id as character        no-undo.
     3855      define variable v-login               as character    no-undo.
     3856      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3857      define buffer buf_user-login  for ub.user-login .
     3858      do
     3859      on error undo, return error
     3860      :
     3861            FIND FIRST buf_sys-ctrl no-lock.
     3862            ASSIGN
     3863               v-login = USERID("ub")
     3864               p-db-num = buf_sys-ctrl.db-num
     3865            .
     3866            FIND FIRST buf_user-login
     3867                 WHERE buf_user-login.db-num = p-db-num
     3868                   AND buf_user-login.user-login = v-login
     3869                 no-lock
     3870                 no-error
     3871                 .
     3872            IF AVAILABLE buf_user-login
     3873            THEN DO:
     3874               assign
     3875                  p-user-id = buf_user-login.user-id
     3876               .
     3877            END.
     3878      end.
     3879   end procedure.
     3880       run diasize_init in this-procedure .
     3881   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3882   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3883   MAIN-BLOCK:
     3884   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3885      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3886     run init-fields in this-procedure .
     3887     RUN enable_UI.
     3888     WAIT-FOR GO OF FRAME Dialog-Frame.
     3889   END.
     3890   RUN disable_UI.
     3891   PROCEDURE check-file-type :
     3892   define input parameter p-filename       as character        no-undo.
     3893   define input parameter p-full-filename  as character        no-undo.
     3894   define output parameter p-is-this-type  as logical          no-undo.
     3895   do
     3896   on error undo, return error
     3897   :
     3898       case p-export-type
     3899       :
     3900           when "DOC":U
     3901           then do:
     3902               if substring( p-filename, 1, 1 ) = "d":U
     3903               then do:
     3904                   assign
     3905                       p-is-this-type = yes
     3906                   .
     3907               end.
     3908               else do:
     3909                   assign
     3910                       p-is-this-type = no
     3911                   .
     3912               end.
     3913           end.
     3914           otherwise do:
     3915               assign
     3916                   p-is-this-type = no
     3917               .
     3918           end.
     3919       end case.
     3920   end.
     3921   END PROCEDURE.
     3922   PROCEDURE disable_UI :
     3923     HIDE FRAME Dialog-Frame.
     3924   END PROCEDURE.
     3925   PROCEDURE enable_UI :
     3926     DISPLAY fi-catalog fi-search-string
     3927         WITH FRAME Dialog-Frame.
     3928     ENABLE b-exit bt-read b-help bt-change-cat fi-search-string b-search br-table
     3929         WITH FRAME Dialog-Frame.
     3930     VIEW FRAME Dialog-Frame.
     3931     OPEN QUERY br-table FOR EACH temp_xmlview NO-LOCK.
     3932   END PROCEDURE.
     3933   PROCEDURE get-init-catalog :
     3934   define output parameter p-catalog   as character        no-undo.
     3935   do
     3936   on error undo, return error
     3937   :
     3938       case p-format-type
     3939       :
     3940           when 'tree':U
     3941           then do:
     3942               case p-export-type
     3943               :
     3944                   when 'DOC':U
     3945                   then do:
     3946                       get-key-value section "BGE" key "Dirfrg-acc" value p-catalog.
     3947                       if p-catalog = ?
     3948                       then do:
     3949                           message
     3950                           skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     3951                           skip(1)
     3952                           skip "Обратитесь к администратору."
     3953                           view-as alert-box error.
     3954                           undo, return error .
     3955                       end.
     3956                       else do:
     3957                           assign
     3958                               p-catalog = p-catalog + "\":U + "exp-acc":U
     3959                           .
     3960                       end.
     3961                   end.
     3962                   otherwise do:
     3963                       message
     3964                                vss-workfile vss-revision vss-description
     3965                           skip(1)
     3966                           skip "Не определено чтение файлов выгрузки"
     3967                           skip "с типом экспорта" p-export-type
     3968                           skip return-value
     3969                           skip trim(error-status :get-message(1))
     3970                                trim(error-status :get-message(2))
     3971                                trim(error-status :get-message(3))
     3972                       view-as alert-box error.
     3973                       undo, return error .
     3974                   end.
     3975               end case.
     3976           end.
     3977           when 'flat':U
     3978           then do:
     3979               case p-export-type
     3980               :
     3981                   when 'DOC':U
     3982                   then do:
     3983                       get-key-value section "BGE" key "outdir" value p-catalog.
     3984                       if p-catalog = ?
     3985                       then do:
     3986                           message
     3987                           skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     3988                           skip(1)
     3989                           skip "Обратитесь к администратору."
     3990                           view-as alert-box error.
     3991                           undo, return error .
     3992                       end.
     3993                   end.
     3994                   otherwise do:
     3995                       message
     3996                                vss-workfile vss-revision vss-description
     3997                           skip(1)
     3998                           skip "Не определено чтение файлов выгрузки"
     3999                           skip "с типом экспорта" p-export-type
     4000                           skip return-value
     4001                           skip trim(error-status :get-message(1))
     4002                                trim(error-status :get-message(2))
     4003                                trim(error-status :get-message(3))
     4004                       view-as alert-box error.
     4005                       undo, return error .
     4006                   end.
     4007               end case.
     4008           end.
     4009           otherwise do:
     4010               message
     4011                        vss-workfile vss-revision vss-description
     4012                   skip(1)
     4013                   skip "Неправильно указан формат экспорта."
     4014                   skip "Невозможно определить каталог выгрузки."
     4015                   skip return-value
     4016                   skip trim(error-status :get-message(1))
     4017                        trim(error-status :get-message(2))
     4018                        trim(error-status :get-message(3))
     4019               view-as alert-box error.
     4020               undo, return error .
     4021           end.
     4022       end case.
     4023   end.
     4024   END PROCEDURE.
     4025   PROCEDURE init-fields :
     4026   do
     4027   on error undo, return error
     4028   :
     4029       assign
     4030           frame Dialog-Frame :title = substitute( "&1. Формат выгрузки: &2. Тип документов: &3"
     4031                                                   , frame Dialog-Frame :title
     4032                                                   , ( if p-format-type = 'flat':U then "плоский" else "дерево" )
     4033                                                   , "складские документы"
     4034                                        )
     4035       .
     4036       assign
     4037           v-xmlview-format-type = p-format-type
     4038           v-xmlview-export-type = p-export-type
     4039       .
     4040       run get-init-catalog in this-procedure (
     4041           output fi-catalog
     4042       ) no-error.
     4043       if error-status :error
     4044       then do:
     4045           message
     4046                    "Не удалось определить каталог выгрузки."
     4047               skip "Выберите каталог для чтения файлов."
     4048           view-as alert-box warning.
     4049           assign
     4050               fi-catalog = "":U
     4051           .
     4052       end.
     4053   end.
     4054   END PROCEDURE.
     4055   PROCEDURE read-files :
     4056   define input parameter p-full-path  as character        no-undo.
     4057       define variable v-is-this-type  as logical      no-undo.
     4058       define variable v-short-name    as character    no-undo.
     4059       define buffer buf_temp-filelist     for temp-filelist.
     4060   do
     4061   for buf_temp-filelist
     4062   on error undo, return error
     4063   :
     4064       assign
     4065           v-short-name = entry( num-entries( p-full-path, "\":U ), p-full-path, "\":U )
     4066       .
     4067       run filelist-clear in this-procedure .
     4068       run filelist-init in this-procedure (
     4069             input p-full-path
     4070           , input yes
     4071           , input "xml":U
     4072           , input v-short-name
     4073       ).
     4074       filelist-parse:
     4075       for each buf_temp-filelist
     4076       :
     4077           run check-file-type in this-procedure (
     4078                 input buf_temp-filelist.file-name
     4079               , input buf_temp-filelist.full-name
     4080               , output v-is-this-type
     4081           ).
     4082           if v-is-this-type = yes
     4083           then do:
     4084               assign
     4085                   v-xmlvdoc-current-tag-path = p-full-path
     4086               .
     4087               run xmlvdoc-parse-file in this-procedure (
     4088                     input buf_temp-filelist.file-name-no-ext
     4089                   , input buf_temp-filelist.full-name
     4090               ) no-error.
     4091               if error-status :error
     4092               then do:
     4093                   message
     4094                           vss-workfile vss-revision vss-description
     4095                       skip(1)
     4096                       skip "Ошибка чтения файла" buf_temp-filelist.full-name
     4097                       skip return-value
     4098                       skip trim(error-status :get-message(1))
     4099                            trim(error-status :get-message(2))
     4100                            trim(error-status :get-message(3))
     4101                   view-as alert-box error.
     4102                   undo filelist-parse, next filelist-parse.
     4103               end.
     4104           end.
     4105       end.
     4106   end.
     4107   END PROCEDURE.
     4108   PROCEDURE search-doc-num :
     4109   define input parameter p-search-string      as character        no-undo.
     4110   define output parameter p-founded-recid     as recid            no-undo.
     4111   define output parameter p-found             as logical          no-undo.
     4112       define buffer buf_temp_xmlview      for temp_xmlview.
     4113   do
     4114   on error undo, return error
     4115   :
     4116       find first buf_temp_xmlview
     4117            where buf_temp_xmlview.record-id > v-bgerddoc-last-record-id
     4118              and buf_temp_xmlview.doc-code begins p-search-string
     4119       no-error.
     4120       if available buf_temp_xmlview
     4121       then do:
     4122           assign
     4123               p-found                     = yes
     4124               v-bgerddoc-last-record-id   = buf_temp_xmlview.record-id
     4125               p-founded-recid             = recid( buf_temp_xmlview )
     4126           .
     4127       end.
     4128       else do:
     4129           assign
     4130               p-found                     = no
     4131               p-founded-recid             = 0
     4132           .
     4133       end.
     4134   end.
     4135   END PROCEDURE.
     4136   PROCEDURE cb-xmlparse-error :
     4137   define input parameter p-error-string   as character        no-undo.
     4138   do
     4139   on error undo, return error
     4140   :
     4141       message
     4142           "Ошибка чтения xml-файла."
     4143           skip p-error-string
     4144       view-as alert-box error.
     4145   end.
     4146   END PROCEDURE.
