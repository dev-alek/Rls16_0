     1153   procedure cb-xmlparse-tag-end-operation :
     1154   define input parameter p-parameters-string  as character        no-undo.
     1155   do
     1156   on error undo, return error
     1157   :
     1158       case v-xmlview-format-type
     1159       :
     1160           when 'tree':U
     1161           then do:
     1162               assign
     1163                   v-xmlvdoc-current-tag = 0
     1164               .
     1165               if v-xmlvdoc-tag-list[ 2 ] <> "":U
     1166               or v-xmlvdoc-tag-list[ 3 ] <> "":U
     1167               then do:
     1168                   run xmlvdoc-error in this-procedure (
     1169                       input substitute( "&2&1&3&1    &4,&1    &5,&1    &6"
     1170                                           , chr(10)
     1171                                           , "При закрытии тэга операции"
     1172                                           , "не был закрыт тэг предыдущего уровня. Список открытых тэгов:"
     1173                                           , v-xmlvdoc-tag-list[ 1 ]
     1174                                           , v-xmlvdoc-tag-list[ 2 ]
     1175                                           , v-xmlvdoc-tag-list[ 3 ]
     1176                                       )
     1177                   ).
     1178               end.
     1179           end.
     1180           when 'flat':U
     1181           then do:
     1182           end.
     1183       end case.
     1184   end.
     1185   end procedure.
     1186   procedure cb-xmlparse-tag-start-docID :
     1187   define input parameter p-parameters-string  as character        no-undo.
     1188   do
