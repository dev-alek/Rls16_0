        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle as handle no-undo .
        4   define input parameter p-silent as logical no-undo .
        5   define input parameter p-esys-id as integer no-undo .
        6   define input parameter p-db-num as integer no-undo .
        7   define input parameter p-espr-pack-num as integer no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: f0ffd58b8bac, 1562, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       10   define variable vss-date        as character no-undo init "$Date: Tue Nov 06 04:41:34 2018 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: rorarcpt.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/rorarcpt.p $":U .
       13   define variable vss-description as character no-undo init "".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure cur-time :
       74      define output parameter p-today as date      no-undo .
       75      define output parameter p-time  as integer   no-undo .
       76     do
       77     on error undo, return error
       78     :
       79       define variable v-date1 as date      no-undo .
       80       define variable v-date2 as date      no-undo .
       81       define variable v-time  as integer   no-undo .
       82       assign
       83         v-date1 = today
       84         v-time  = time
       85         v-date2 = today
       86       .
       87       if v-date1 <> v-date2
       88       then do:
       89         assign
       90           v-date1 = today
       91           v-time  = v-time
       92         .
       93       end.
       94       assign
       95         p-today = v-date1
       96         p-time  = v-time
       97       .
       98     end.
       99   end.
      100   function cur-time-date returns character
      101   :
      102     return string(today, '99/99/9999':U) .
      103   end.
      104   function cur-time-mjd returns decimal
      105   :
      106     define variable v-date as date      no-undo .
      107     define variable v-time as integer   no-undo .
      108     run cur-time in this-procedure
      109       (output v-date
      110       ,output v-time
      111       ) .
      112     return integer(v-date) - 2400002 + (v-time / 86400) .
      113   end.
      114   function cur-time-get-ending-index returns integer
      115   (input p-number as integer
      116   )
      117   :
      118     if p-number < 0
      119     or p-number = ?
      120     then do:
      121       return 1 .
      122     end.
      123     define variable v-rest as integer   no-undo .
      124     assign
      125       p-number = p-number modulo 100
      126     .
      127     if p-number < 20
      128     then do:
      129       assign
      130         v-rest = p-number
      131       .
      132     end.
      133     else do:
      134       assign
      135         v-rest = p-number modulo 10
      136       .
      137     end.
      138     case v-rest :
      139       when 1
      140       then do:
      141         return 2 .
      142       end.
      143       when 2 or
      144       when 3 or
      145       when 4
      146       then do:
      147         return 3 .
      148       end.
      149       otherwise do:
      150         return 1 .
      151       end.
      152     end case .
      153   end.
      154   procedure cur-time-mjd-to-date :
      155      define input  parameter i-mjd-diff as decimal no-undo.
      156      define output parameter o-Date     as date    no-undo.
      157      define output parameter o-Time     as integer no-undo.
      158      define variable v-day-number as integer   no-undo .
      159      if    i-mjd-diff < 0
      160         or i-mjd-diff = ?
      161      then do:
      162         return "?" .
      163      end.
      164      assign
      165         v-day-number = truncate(i-mjd-diff,0).
      166         o-Date = date(v-day-number + 2400002).
      167         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      168     .
      169   end.
      170   function cur-time-mjd-to-string returns character
      171   (input p-mjd-diff as decimal
      172   )
      173   :
      174     define variable v-day-number as integer   no-undo .
      175     define variable v-seconds    as integer   no-undo .
      176     define variable v-hour       as integer   no-undo .
      177     define variable v-min        as integer   no-undo .
      178     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      179     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      180     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      181     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      182     if p-mjd-diff < 0
      183     or p-mjd-diff = ?
      184     then do:
      185       return "?" .
      186     end.
      187     assign
      188       v-day-number = integer(truncate(p-mjd-diff,0))
      189       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191     if v-seconds > 86400
      192     then do:
      193       assign
      194         v-seconds = 86400 - 1
      195       .
      196     end.
      197     if v-seconds < 0
      198     then do:
      199       assign
      200         v-seconds = 0
      201       .
      202     end.
      203     assign
      204       v-hour = truncate(v-seconds / 3600, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 3600
      208     .
      209     assign
      210       v-min = truncate(v-seconds / 60, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 60
      214     .
      215     return
      216         (if v-day-number <> 0
      217           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0
      221           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      225           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      226           else ""
      227         )
      228       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      229       .
      230   end.
      231   function cur-time-string returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-string-sec returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      250   end.
      251   function cur-time-custom  returns character
      252   (input p-prefix as character
      253   ,input p-date-format as character
      254   ,input p-delimiter as character
      255   ,input p-time-format as character
      256   ,input p-suffix as character
      257   )
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return
      266       p-prefix
      267       + string(v-date, p-date-format)
      268       + p-delimiter
      269       + string(v-time, p-time-format)
      270       + p-suffix
      271       .
      272   end.
      273   function cur-time-print  returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-datetime returns datetime
      284   :
      285     define variable v-char as character no-undo .
      286     define variable v-datetime as datetime no-undo .
      287     v-char = cur-time-string().
      288     v-datetime = datetime(v-char).
      289     return  v-datetime.
      290   end.
      291   function cur-time-string-msec returns character
      292   :
      293     define variable v-date as datetime  no-undo .
      294     v-date = now.
      295     return string(v-date) .
      296   end.
      297   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   define  shared variable g#auto-pid           as integer   no-undo .
      300   define  shared variable conn-par             as character no-undo .
      301   define  shared variable g#auto-user-id       as character no-undo .
      302   define  shared variable g#auto-user-login    as character no-undo .
      303   define  shared variable g#auto-user-password as character no-undo .
      304   define  shared variable v-socket             as logical   no-undo .
      305   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   define  shared variable auto-window-h     as handle    no-undo .
      307   define  shared variable auto-log-msg-h    as handle    no-undo .
      308   define  shared variable hand-log-msg-h    as handle    no-undo .
      309   define  shared variable log-file-name     as character no-undo initial ? .
      310   define  shared variable add-log-file-name as character no-undo initial ? .
      311   define  shared variable writelogvalue     as character no-undo initial ? .
      312   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define stream LogStream .
      314   define variable mNoTime as logical no-undo.
      315   procedure write-to-log-notime :
      316     define input param i-str as character no-undo .
      317     mNoTime = yes.
      318     run write-to-log (i-str).
      319     mNoTime = no.
      320   end.
      321   procedure write-to-log :
      322     define input param p-str as character no-undo .
      323     do
      324     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      325     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      326     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      327     :
      328       define variable log-res        as logical   no-undo .
      329       define variable v-jj           as integer   no-undo .
      330       if    mNoTime
      331          or writelogvalue eq "AsyncProc"
      332       then
      333          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      334       else
      335          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      336       if auto-log-msg-h <> ? then do:
      337         log-res = auto-log-msg-h:move-to-eof( ) .
      338         log-res = auto-log-msg-h:insert-string( p-str ).
      339       end.
      340       if hand-log-msg-h <> ? then do:
      341         log-res = hand-log-msg-h:move-to-eof( ) .
      342         log-res = hand-log-msg-h:insert-string( p-str ).
      343       end.
      344       assign
      345         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      346         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      347         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      348       .
      349       if add-log-file-name <> ? then do:
      350         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      351           run gbl/fileapnd.p
      352             ( input entry(v-jj, add-log-file-name, chr(1) )
      353             ,input p-str
      354             ,input 20
      355             ) no-error .
      356           if error-status:error then do:
      357             return error return-value .
      358           end.
      359         end.
      360       end.
      361       if writelogvalue eq "AsyncProc"
      362       then do:
      363          p-str = trim(p-str, (chr(13) + chr(10)) )
      364       .
      365          Publish "WriteLogAsunc" (p-str,yes).
      366       end.
      367       else if writelogvalue <> "yes" then do:
      368         run gbl/fileapnd.p
      369           ( input log-file-name
      370           ,input p-str
      371           ,input 20
      372           ) no-error .
      373         if error-status:error then do:
      374           return error return-value .
      375         end.
      376       end.
      377     end.
      378   end procedure.
      379   procedure write-to-screen :
      380     define input param p-str as character no-undo .
      381     do
      382     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      383     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      384     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      385     :
      386       define variable log-res as logical no-undo.
      387       assign
      388         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      389       .
      390       if auto-log-msg-h <> ?
      391       then do:
      392         log-res = auto-log-msg-h:move-to-eof( ) .
      393         log-res = auto-log-msg-h:insert-string( p-str ).
      394       end.
      395       if hand-log-msg-h <> ?
      396       then do:
      397         log-res = hand-log-msg-h:move-to-eof( ) .
      398         log-res = hand-log-msg-h:insert-string( p-str ).
      399       end.
      400     end.
      401   end procedure.
      402   procedure send-msg-to-email :
      403     define input  parameter p-subject      as character no-undo .
      404     define input  parameter p-text-err     as character no-undo .
      405     define input  parameter p-attach-files as character no-undo .
      406     do
      407     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      408     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      409     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      410     :
      411       define variable v-tth             as handle    no-undo .
      412       define variable v-value-character as character no-undo .
      413       define variable v-value-date      as date      no-undo .
      414       define variable v-value-decimal   as decimal   no-undo .
      415       define variable v-value-integer   as integer   no-undo .
      416       define variable v-value-logical   as logical   no-undo .
      417       define variable v-param-type      as character no-undo .
      418       define variable v-email       as character no-undo .
      419       define variable v-tmp-str     as character no-undo .
      420       define variable v-tmp1-str    as character no-undo .
      421       define variable v-ind         as integer   no-undo .
      422       define variable v-num-entries as integer   no-undo .
      423       delete object v-tth no-error.
      424       run adm/shattri.p
      425         ( input "get":U
      426          ,input  "":U
      427          ,input  0
      428          ,input  'auto-task':U
      429          ,input  'send-msg-to-email':U
      430          ,output v-value-character
      431          ,output v-value-date
      432          ,output v-value-decimal
      433          ,output v-value-integer
      434          ,output v-value-logical
      435          ,output v-param-type
      436          ,input-output table-handle v-tth
      437         ) no-error .
      438       if not error-status :error  then do:
      439         assign
      440           v-tmp-str = v-value-character
      441         .
      442       end.
      443       delete object v-tth no-error.
      444       assign
      445         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      446         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      447         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      448         v-num-entries = num-entries( v-tmp-str, chr(44) )
      449         v-email       = "":U
      450       .
      451       do v-ind = 1 to v-num-entries
      452       :
      453         assign
      454           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      455         .
      456         if trim( v-tmp1-str ) <> "":U then do:
      457           if v-email = "":U then do:
      458             assign
      459               v-email = v-tmp1-str
      460             .
      461           end.
      462           else do:
      463             assign
      464               v-email = v-email + chr(44) + v-tmp1-str
      465             .
      466           end.
      467         end.
      468       end.
      469       if v-email <> "":U then do:
      470         run gbl/sendmail.p
      471           ( input v-email
      472           , input p-subject
      473           , input p-text-err
      474           , input p-attach-files
      475           ) no-error .
      476         if error-status :error
      477           or return-value <> "":U
      478         then do:
      479           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      480         end.
      481       end.
      482     end.
      483   end procedure.
      484   define  shared variable oxml-exch-dir as character no-undo .
      485   define  shared variable oxml-heap-dir as character no-undo .
      486   define variable err-mess as character no-undo .
