      501   FUNCTION ora-rcpt_get-rcpt-name returns character ( input p-file-name as character):
      502   define variable v-file-name as character no-undo .
      503   assign
      504   v-file-name = substitute("&1-&2_&3"
      505                             ,entry(2, entry(1, p-file-name, "_"), "-")
      506                             ,entry(1, entry(1, p-file-name, "_"), "-")
      507                             ,entry(2, p-file-name, "_")) no-error.
      508   if error-status:error then v-file-name = p-file-name.
      509   return v-file-name.
      510   END FUNCTION.
      511   DEFINE VARIABLE v-today as date no-undo .
      512   DEFINE VARIABLE v-time as integer no-undo .
      513   define variable v-exch-file-date as character no-undo .
      514   define variable v-rcpt-log-file as character no-undo .
      515   define variable v-file-name as character no-undo .
      516   define variable v-custom-pack-name as character no-undo .
      517   define variable v-espr-pack-num as integer no-undo .
      518   define variable v-espr-pack-name as character no-undo .
      519   define variable v-source-dir as character no-undo .
      520   define variable v-target-dir as character no-undo .
      521   define variable v-temp-dir as character no-undo .
      522   define variable v-log-file-name as character no-undo .
      523   define variable v-list-file-name as character no-undo .
      524   define variable v-custom-pack-flag as logical no-undo .
      525   DEFINE VARIABLE v-full-path         as character    no-undo.
      526   DEFINE VARIABLE v-file-name-no-ext  as character    no-undo.
      527   DEFINE VARIABLE v-file-name-ext     as character    no-undo.
      528   define variable v-path              as character    no-undo.
      529   define variable v-cmd-proc-handle as handle no-undo .
      530   define variable v-cmd-code as integer no-undo .
      531   define variable v-labels as character no-undo .
      532   define variable v-codes as character no-undo .
      533   define variable v-err-type as character no-undo .
      534   assign
      535   v-labels = 'RANGE' + chr(4) +
      536             'SYNCHRONIZATION' + chr(4) +
      537             'NULL' + chr(4) +
      538             'PROCESSING' + chr(4) +
      539             'STRUCTURE' + chr(4) +
      540             "NO-ERROR"
      541   v-codes = 'RANGE' + chr(4) +
      542             'SYNCHRONIZATION' + chr(4) +
      543             'NULL' + chr(4) +
      544             'PROCESSING' + chr(4) +
      545             'STRUCTURE' + chr(4) +
      546             "NO-ERROR"
      547   .
      548   run gbl/d-list.w ( input "b-sel"
      549                     ,input "Выберите Тип ошибки или NO-ERROR (если ошибки нет) для отправки в квитанции"
      550                     ,input v-codes
      551                     ,input v-labels
      552                     ,input chr(4)
      553                     ,input ''
      554                     ,output v-err-type) no-error.
      555   if error-status:error
      556   or v-err-type = ''
      557   then do:
      558     return no-apply.
      559   end.
      560   if v-err-type = "NO-ERROR" then v-err-type = "".
      561   run cur-time in this-procedure ( output v-today, output v-time).
      562   v-exch-file-date = string(datetime(v-today, mtime), "99/99/9999 HH:MM:SS").
      563   v-custom-pack-name = ''.
      564   v-espr-pack-num = - abs(p-espr-pack-num).
      565   run bge/espcknum.p ( input "get":U
      566                 ,input p-esys-id
      567                 ,input 0
      568                 ,input integer('3':U)
      569                 ,input oxml-exch-dir
      570                 ,input oxml-heap-dir
      571                 ,input ""
      572                 ,input-output v-espr-pack-num
      573                 ,input-output v-custom-pack-name
      574                 ,output v-espr-pack-name
      575                 ,output v-source-dir
      576                 ,output v-target-dir
      577                 ,output v-temp-dir
      578                 ,output v-log-file-name
      579                 ,output v-list-file-name
      580                 ,output v-custom-pack-flag
      581               ) no-error.
      582     if error-status:error then do:
      583       run write-log in p-log-handle (
      584                                       input 2
      585                                     , substitute("&1 Ошибка при генерации номера пакета.&2&3&2&4"
      586                                                   ,vss-workfile
      587                                                   ,chr(10)
      588                                                 ,substitute( "&1", error-status:get-message(error-status:num-messages) )
      589                                                 ,substitute( "&1", return-value )
      590                                                 )
      591                       ) .
      592       undo , return.
      593     end.
      594     assign
      595     v-file-name = v-target-dir + chr(92) + v-espr-pack-name +
      596                   (if v-custom-pack-flag
      597                   then ''
      598                   else 'xml')
      599     .
      600   run gbl/filename.p (
      601                         input v-file-name
      602                         ,output v-full-path
      603                         ,output v-path
      604                         ,output v-file-name
      605                         ,output v-file-name-no-ext
      606                         ,output v-file-name-ext
      607                         ) no-error .
      608   if error-status :error then do:
      609     return.
      610   end.
      611   assign
      612   v-rcpt-log-file = v-log-file-name + chr(92) + ora-rcpt_get-rcpt-name(v-file-name-no-ext) + ".LOG"
      613   .
      614   run rul/ora-rcpt.p (
      615                        input parparentproc
      616                       ,input this-procedure:handle
      617                       ,input p-log-handle
      618                       ,input v-cmd-proc-handle
      619                       ,input v-cmd-code
      620                       ,input p-esys-id
      621                       ,input p-espr-pack-num
      622                       ,input v-file-name
      623                       ,input v-exch-file-date
      624                       ,input v-rcpt-log-file
      625                       ,input v-err-type) no-error.
      626   if error-status:error then do:
      627       if p-silent then do:           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1 Ошибка при генерации квитанции.&2&3&2&4"                                 ,vss-workfile                                 ,chr(10)                                ,substitute( "&1", error-status:get-message(error-status:num-messages) )                               ,substitute( "&1", return-value )                               )).                  end.                                               else do:                                             message substitute("&1 Ошибка при генерации квитанции.&2&3&2&4"                                 ,vss-workfile                                 ,chr(10)                                ,substitute( "&1", error-status:get-message(error-status:num-messages) )                               ,substitute( "&1", return-value )                               ) view-as alert-box.      end.
      628   end.
      629   else do:
      630       if p-silent then do:           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Квитанция для пакета &1 сформирована",  p-espr-pack-num)).                  end.                                               else do:                                             message substitute("Квитанция для пакета &1 сформирована",  p-espr-pack-num) view-as alert-box.      end.
      631   end.
