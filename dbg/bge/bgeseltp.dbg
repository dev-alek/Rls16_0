      161   define temp-table temp_doc-type no-undo
      162       field dtp-key           as integer
      163       field mark              as character
      164       field doc-type          as character
      165       field doc-type-label    as character
      166       index pi is primary unique
      167           dtp-key
      168   .
      169   define variable v-types-amount as integer no-undo .
      170   DEFINE MENU POPUP-MENU-b-mark
      171          MENU-ITEM m_mark_all     LABEL "Выбрать все"
      172          MENU-ITEM m_mark_no_one  LABEL "Снять выбор у всех"
      173          MENU-ITEM m_mark_invert  LABEL "Инвертировать выбор".
      174   DEFINE BUTTON b-exit
      175        LABEL "&Выход"
      176        SIZE 10 BY 1
      177        BGCOLOR 8 .
      178   DEFINE BUTTON b-help
      179        LABEL "Помощ&ь"
      180        SIZE 10 BY 1
      181        BGCOLOR 8 .
      182   DEFINE BUTTON b-mark
      183        LABEL "&*"
      184        SIZE 3 BY 1.
      185   DEFINE BUTTON b-sel
      186        LABEL "В&ыбор"
      187        SIZE 10 BY 1
      188        BGCOLOR 8 .
      189   DEFINE QUERY BROWSE-1 FOR
      190         temp_doc-type SCROLLING.
      191   DEFINE BROWSE BROWSE-1
      192     QUERY BROWSE-1 SHARE-LOCK NO-WAIT DISPLAY
      193         temp_doc-type.mark  format "X(1)" column-label "*"
      194       temp_doc-type.doc-type-label format "X(40)" column-label "Тип операции"
      195       WITH NO-ROW-MARKERS SEPARATORS SIZE 45.5 BY 20.5.
      196   DEFINE FRAME Dialog-Frame
      197        b-sel AT ROW 1.17 COL 2
      198        b-mark AT ROW 1.17 COL 12
      199        b-exit AT ROW 1.17 COL 15
      200        b-help AT ROW 1.17 COL 37.38
      201        BROWSE-1 AT ROW 2.5 COL 2
      202        SPACE(0.99) SKIP(0.24)
      203       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      204            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      205            TITLE "Список типов документов"
      206            DEFAULT-BUTTON b-exit.
      207   ASSIGN
      208          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      209          FRAME Dialog-Frame:HIDDEN           = TRUE.
      210   ASSIGN
      211          b-mark:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-mark:HANDLE.
      212   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      213   DO:
      214     APPLY "END-ERROR":U TO SELF.
      215   END.
      216   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      217   DO:
      218       assign
      219           p-cancel = yes
      220       .
      221       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      222   END.
      223   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      224   or insert-mode of browse-1 IN FRAME Dialog-Frame
      225   or mouse-select-click of browse-1 IN FRAME Dialog-Frame
      226   DO:
      227       run b-mark-press in this-procedure (
      228           input "b-mark-one":U
      229       ) no-error .
      230       if error-status :error
      231       then do:
      232           message
      233           vss-workfile vss-revision vss-description
      234           skip "Ошибка выбора типа документа."
      235           skip return-value
      236           skip trim(error-status :get-message(1))
      237           trim(error-status :get-message(2))
      238           trim(error-status :get-message(3))
      239           trim(error-status :get-message(4))
      240           trim(error-status :get-message(5))
      241           view-as alert-box error.
      242           undo, return no-apply .
      243       end.
      244       display
      245           temp_doc-type.mark
      246       with browse browse-1.
      247   END.
      248   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      249   DO:
      250       run assign-for-exit in this-procedure no-error.
      251       if error-status :error
      252       then do:
      253           message vss-workfile vss-revision vss-description
      254           skip "Не удается присвоить значение списку операций."
      255           skip return-value
      256           skip trim(error-status :get-message(1))
      257           trim(error-status :get-message(2))
      258           trim(error-status :get-message(3))
      259           trim(error-status :get-message(4))
      260           trim(error-status :get-message(5))
      261           view-as alert-box error.
      262           undo, return no-apply .
      263       end.
      264       assign
      265           p-cancel = no
      266       .
      267       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      268   END.
      269   ON CHOOSE OF MENU-ITEM m_mark_all
      270   or + of browse-1 IN FRAME Dialog-Frame
      271   DO:
      272       run b-mark-press in this-procedure (
      273           input "b-mark-all":U
      274       ) no-error .
      275       if error-status :error
      276       then do:
      277           message
      278               vss-workfile vss-revision vss-description
      279               skip "Ошибка выбора типа документа."
      280               skip return-value
      281               skip trim(error-status :get-message(1))
      282               trim(error-status :get-message(2))
      283               trim(error-status :get-message(3))
      284           view-as alert-box error.
      285           undo, return no-apply .
      286       end.
      287       display
      288           temp_doc-type.mark
      289       with browse browse-1.
      290   END.
      291   ON CHOOSE OF MENU-ITEM m_mark_invert
      292   or * of browse-1 IN FRAME Dialog-Frame
      293   DO:
      294       run b-mark-press in this-procedure (
      295           input "b-mark-inverse":U
      296       )no-error .
      297       if error-status :error
      298       then do:
      299           message
      300           vss-workfile vss-revision vss-description
      301           skip "Ошибка выбора типа документа."
      302           skip return-value
      303           skip trim(error-status :get-message(1))
      304           trim(error-status :get-message(2))
      305           trim(error-status :get-message(3))
      306           trim(error-status :get-message(4))
      307           trim(error-status :get-message(5))
      308           view-as alert-box error.
      309           undo, return no-apply .
      310       end.
      311       display
      312           temp_doc-type.mark
      313       with browse browse-1.
      314   END.
      315   ON CHOOSE OF MENU-ITEM m_mark_no_one
      316   or - of browse-1 IN FRAME Dialog-Frame
      317   DO:
      318       run b-mark-press in this-procedure (
      319           input "b-mark-no-one":U
      320       ) no-error .
      321       if error-status :error
      322       then do:
      323           message
      324           vss-workfile vss-revision vss-description
      325           skip "Ошибка выбора типа документа."
      326           skip return-value
      327           skip trim(error-status :get-message(1))
      328           trim(error-status :get-message(2))
      329           trim(error-status :get-message(3))
      330           trim(error-status :get-message(4))
      331           trim(error-status :get-message(5))
      332           view-as alert-box error.
      333           undo, return no-apply .
      334       end.
      335       display
      336           temp_doc-type.mark
      337       with browse browse-1.
      338   END.
      339   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   on help of frame Dialog-Frame
      341   do:
      342     run gbl/app_help.p
      343       (input this-procedure :file-name
      344       ,input ''
      345       ,input ?
      346       ) no-error.
      347     if error-status :error then do:
      348       message
      349         "Ошибка при вызове помощи"
      350         error-status :get-message(1)
      351         view-as alert-box .
      352     end.
      353   end.
      354   run minbtn-set in this-procedure .
      355   on choose of b-help in frame Dialog-Frame
      356   do:
      357     apply "help":u to frame Dialog-Frame .
      358   end.
      359   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   procedure minbtn-set :
      361       do
      362           on error undo, return error return-value
      363           :
      364           define variable ii              as integer       no-undo .
      365           define variable fh              as widget-handle no-undo .
      366           define variable hh              as widget-handle no-undo .
      367           define variable v-h             as handle        extent 4 no-undo .
      368           define variable v-name-button   as character     no-undo .
      369           define variable v-help-old-x    as decimal       no-undo .
      370           define variable v-help-old-y    as decimal       no-undo .
      371           define variable v-help-old-size as decimal       no-undo .
      372           define variable v-frame-width   as decimal       no-undo .
      373           define variable jj              as integer       no-undo .
      374           do
      375               on error undo, return error
      376               :
      377               assign
      378                   v-frame-width = frame Dialog-Frame:width - 0.3
      379                   fh            = frame Dialog-Frame:first-child
      380                   hh            = fh:first-child
      381                   ii            = 1
      382                   .
      383               do while valid-handle(hh):
      384                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      385                   do:
      386                       case lc(hh:name) :
      387                           when "b-help" then
      388                               do:
      389                                   hh:load-image-up("cmp/b-help.bmp":u) .
      390                                   hh:load-image-down("cmp/b-help.bmp":u) .
      391                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      392                                   hh:TOOLTIP = "Помощь" .
      393                                   v-help-old-x = hh:column .
      394                                   v-help-old-y = hh:row    .
      395                                   v-help-old-size = hh:width .
      396                                   hh:width-chars = 2.5 .
      397                               end.
      398                           when "b-print" then
      399                               do:
      400                                   hh:load-image("cmp/b-print.bmp":u) .
      401                                   hh:TOOLTIP = "Печать" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-history" or
      407                           when "b-hist" then
      408                               do:
      409                                   hh:load-image("cmp/b-hist.bmp":u) .
      410                                   hh:TOOLTIP = "История" .
      411                                   v-h[ii] = hh:handle .
      412                                   ii = ii + 1 .
      413                                   hh:width-chars = 3 .
      414                               end.
      415                           when "b-sch" then
      416                               do:
      417                                   hh:load-image("cmp/b-sch.bmp":u) .
      418                                   hh:TOOLTIP = "Установка Фильтра" .
      419                                   v-h[ii] = hh:handle .
      420                                   ii = ii + 1 .
      421                                   hh:width-chars = 3 .
      422                               end.
      423                           when "b-hist-user" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История пользователя" .
      427                                   ii = ii + 1 .
      428                               end.
      429                       end case.
      430                   end.
      431                   hh = hh:next-sibling.
      432               end.
      433               b-help:column = v-frame-width - b-help:width-chars.
      434               jj = 0.
      435               repeat ii = 4 to 1 by -1 :
      436                   if valid-handle (v-h[ii] ) then
      437                   do:
      438                       jj  = jj + 1 .
      439                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      440                       v-h[ii]:row    = v-help-old-y .
      441                   end.
      442               end.
      443           end.
      444       end.
      445   end procedure.
      446   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      447   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      448   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      449   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      450   define variable v-diasize-current-frame-width  as decimal   no-undo .
      451   define variable v-diasize-current-frame-height as decimal   no-undo .
      452   define variable v-diasize-change-size          as logical   no-undo .
      453   define variable v-diasize-resize-button        as handle    no-undo .
      454   define variable v-diasize-wndmax               as logical   no-undo .
      455   define variable v-diasize-wndstore             as logical   no-undo .
      456   define variable v-diasize-proc-name            as character no-undo .
      457   define variable v-diasize-browse-handle        as handle    no-undo .
      458   define variable v-diasize-browse-number        as integer   no-undo .
      459   define variable v-diasize-need-full-display    as logical   no-undo init false .
      460   define temp-table temp-diasize-handle no-undo
      461     field handle-value  as handle
      462     field save-position as decimal
      463     index xpk is primary unique handle-value
      464     .
      465   define temp-table temp-browse-handle no-undo
      466     field browse-type   as character
      467     field browse-number as integer
      468     field browse-handle as handle
      469     field original-size as decimal
      470     index xpk is primary unique browse-type browse-number
      471     index xie browse-type browse-handle
      472   .
      473   procedure diasize_change-height :
      474     define input  parameter p-change-value  as decimal   no-undo .
      475     define input  parameter p-move-resize   as logical   no-undo .
      476     define variable v-field-group-handle    as handle    no-undo .
      477     define variable v-object-handle         as handle    no-undo .
      478     define variable v-frame-height          as decimal   no-undo .
      479     define variable v-frame-virtual-height  as decimal   no-undo .
      480     define variable v-browse-height         as decimal   no-undo .
      481     define variable v-window-height         as decimal   no-undo .
      482     define variable v-window-virtual-height as decimal   no-undo .
      483     define variable v-change-sign           as integer   no-undo .
      484     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      485     define buffer buf_temp-browse-handle  for temp-browse-handle .
      486     if p-change-value > 0
      487     then do:
      488       if frame Dialog-Frame :height + p-change-value
      489           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      490       then do:
      491         assign
      492           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      493                           - (frame Dialog-Frame :height-chars)
      494         .
      495         if p-change-value <= 0
      496         then do:
      497           run diasize_position-resize-button in this-procedure .
      498           return .
      499         end.
      500       end.
      501     end.
      502     if p-change-value < 0
      503     then do:
      504       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      505       then do:
      506         assign
      507           p-change-value = v-diasize-orig-frame-height
      508                          - (frame Dialog-Frame :height-chars)
      509         .
      510         if p-change-value >= 0
      511         then do:
      512           run diasize_position-resize-button in this-procedure .
      513           return .
      514         end.
      515       end.
      516     end.
      517     if p-change-value >= 0
      518     then do:
      519       assign
      520         v-change-sign = 1
      521       .
      522     end.
      523     else do:
      524       assign
      525         v-change-sign = -1
      526       .
      527     end.
      528     assign
      529       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      530     .
      531     if p-change-value = 0
      532     then do:
