      116   procedure proc-alt-shift-f2:
      117     if not ibs.th.gbl.gbl-var:rcode
      118   then
      119     run gbl\inidebug.p .
      120   end.
      121   procedure proc-alt-shift-f3:
      122     run gbl/prvssinf.p
      123       ( input this-procedure
      124       ) .
      125   end.
      126   define variable v-inform-launched as logical no-undo initial false .
      127   procedure proc-alt-shift-f4:
      128     define variable v-action as character no-undo .
      129     if v-inform-launched = false then do:
      130       assign
      131         v-inform-launched = true
      132       .
      133       run gbl/d-inform.w
      134         (  input self
      135         ,  input this-procedure
      136         , output v-action
      137         ) no-error .
      138       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      139       assign
      140         v-inform-launched = false
      141       .
      142     end.
      143   end.
      144   procedure proc-alt-f1:
      145     run gbl/corrhelp.p
      146       (input this-procedure
      147       ) .
      148   end .
