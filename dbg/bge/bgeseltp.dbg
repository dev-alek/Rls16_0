     1171             buf_temp-browse-handle.browse-handle :width
     1172               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1173             no-error .
     1174           if error-status :error
     1175           or error-status :get-message(1) <> ""
     1176           then do:
     1177             undo move_block, retry move_block .
     1178           end.
     1179         end.
     1180         assign
     1181           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1182           no-error .
     1183         if error-status :error
     1184         or error-status :get-message(1) <> ""
     1185         then do:
     1186           undo move_block, retry move_block.
     1187         end.
     1188         assign
     1189           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1190         no-error .
     1191         if error-status :error
     1192         or error-status :get-message(1) <> ""
     1193         then do:
     1194           undo move_block, retry move_block.
     1195         end.
     1196         if frame Dialog-Frame :scrollable = true
     1197         then do:
     1198           assign
     1199             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1200           no-error .
     1201           if error-status :error
     1202           or error-status :get-message(1) <> ""
     1203           then do:
     1204             undo move_block, retry move_block.
     1205           end.
     1206         end.
     1207       end.
     1208       if p-move-resize
     1209       then do:
     1210         run diasize_position-resize-button in this-procedure .
     1211       end.
     1212       if v-diasize-wndstore = true
     1213       then do:
     1214         if connected("ub") = true
     1215         then do:
     1216           define variable v-cntxt-db-num        as integer   no-undo .
     1217           define variable v-cntxt-userid        as character no-undo .
     1218           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1219                                             , OUTPUT v-cntxt-userid
     1220                                             ) .
     1221           run gbl/wndsizew.p
     1222             (input  v-cntxt-db-num
     1223             ,input  v-cntxt-userid
     1224             ,input  v-diasize-proc-name
     1225             ,input  'width':u
     1226             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1227             ) .
     1228         end.
     1229       end.
     1230     end.
     1231     assign
     1232       v-diasize-change-size = false
     1233     .
     1234   end procedure.
     1235   procedure diasize_set-width :
     1236     define input  parameter p-new-width  as decimal   no-undo .
     1237     define input  parameter p-move-resize as logical   no-undo .
     1238     do
     1239     on error undo, return error return-value
     1240     :
     1241       run diasize_change-width in this-procedure
     1242         (input  (p-new-width - frame Dialog-Frame :width)
     1243         ,input  p-move-resize
     1244         ) .
     1245     end.
     1246   end procedure.
     1247   procedure diasize_position-resize-button :
     1248     do with frame Dialog-Frame
     1249     :
     1250       hide v-diasize-resize-button .
     1251       assign
     1252         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1253                     - 1
     1254                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1255         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1256                     - 1
     1257                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1258       .
     1259       view v-diasize-resize-button .
     1260     end.
     1261   end procedure.
     1262   on alt-right anywhere
     1263   do:
     1264     run diasize_change-width in this-procedure
     1265       (input 1
     1266       ,input true
     1267       ) .
     1268     return no-apply .
     1269   end.
     1270   on alt-left anywhere
     1271   do:
     1272     run diasize_change-width in this-procedure
     1273       (input -1
     1274       ,input true
     1275       ) .
     1276     return no-apply .
     1277   end.
     1278   on alt-down anywhere
     1279   do:
     1280     run diasize_change-height in this-procedure
     1281       (input 1
     1282       ,input true
     1283       ) .
     1284     return no-apply .
     1285   end.
     1286   on alt-up anywhere
     1287   do:
     1288     run diasize_change-height in this-procedure
     1289       (input -1
     1290       ,input true
     1291       ) .
     1292     return no-apply .
     1293   end.
     1294   on alt-enter of frame Dialog-Frame
     1295   do:
     1296     run diasize_maximize in this-procedure
     1297       (input  ?
     1298       ).
     1299     return no-apply .
     1300   end.
     1301   procedure diasize_end-move :
     1302     do
     1303     on error undo, return error return-value
     1304     :
     1305       define variable v-row-delta as decimal   no-undo .
     1306       define variable v-col-delta as decimal   no-undo .
     1307       define variable v-new-row as decimal   no-undo .
     1308       define variable v-new-col as decimal   no-undo .
     1309       assign
     1310         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1311         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1312       .
     1313       assign
     1314         v-row-delta = v-new-row - frame Dialog-Frame :height
     1315         v-col-delta = v-new-col - frame Dialog-Frame :width
     1316       .
     1317       run diasize_change-height in this-procedure
     1318         (input v-row-delta
     1319         ,input true
     1320         ) .
     1321       run diasize_change-width in this-procedure
     1322         (input v-col-delta
     1323         ,input true
     1324         ) .
     1325     end.
     1326   end procedure.
     1327   procedure diasize_maximize :
     1328     define input  parameter p-action as logical   no-undo .
     1329     do
     1330     on error undo, return error return-value
     1331     :
     1332       if p-action = ?
     1333       then do:
     1334         if v-diasize-need-maximize = true
     1335         then do:
     1336           assign
     1337             p-action = true
     1338           .
     1339         end.
     1340         else do:
     1341           assign
     1342             p-action = false
     1343           .
     1344         end.
     1345       end.
     1346       if p-action = true
     1347       then do:
     1348         run diasize_change-height in this-procedure
     1349           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1350               - frame Dialog-Frame :height-chars
     1351           ,input true
     1352           ) .
     1353         run diasize_change-width in this-procedure
     1354           (input session :width-chars
     1355               - frame Dialog-Frame :width-chars
     1356           ,input true
     1357           ) .
     1358         assign
     1359           v-diasize-need-maximize = false
     1360         .
     1361       end.
     1362       else do:
     1363         run diasize_change-width in this-procedure
     1364           (input v-diasize-orig-frame-width
     1365               - frame Dialog-Frame :width-chars
     1366           ,input true
     1367           ) .
     1368         run diasize_change-height in this-procedure
     1369           (input v-diasize-orig-frame-height
     1370               - frame Dialog-Frame :height-chars
     1371           ,input true
     1372           ) .
     1373         assign
     1374           v-diasize-need-maximize = true
     1375         .
     1376       end.
     1377     end.
     1378   end procedure.
     1379   procedure diasize_restore-orig-size :
     1380     do
     1381     on error undo, return error return-value
     1382     :
     1383       assign
     1384         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1385         v-diasize-current-frame-height = frame Dialog-Frame :height
     1386       .
     1387       run diasize_set-height in this-procedure
     1388         (input  v-diasize-orig-frame-height
     1389         ,input  true
     1390         ) .
     1391       run diasize_set-width in this-procedure
     1392         (input  v-diasize-orig-frame-width
     1393         ,input  true
     1394         ) .
     1395     end.
     1396   end procedure.
     1397   procedure diasize_restore-current-size :
     1398     do
     1399     on error undo, return error return-value
     1400     :
     1401       run diasize_set-height in this-procedure
     1402         (input  v-diasize-current-frame-height
     1403         ,input  true
     1404         ) .
     1405       run diasize_set-width in this-procedure
     1406         (input  v-diasize-current-frame-width
     1407         ,input  true
     1408         ) .
     1409     end.
     1410   end procedure.
     1411   procedure diasize_set-browse-handle :
     1412     define input  parameter p-browse-handle as handle   no-undo .
     1413     define buffer buf_temp-browse-handle for temp-browse-handle .
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417       assign
     1418         v-diasize-browse-handle = p-browse-handle
     1419       .
     1420       for each buf_temp-browse-handle
     1421       on error undo, return error return-value
     1422       :
     1423         delete buf_temp-browse-handle .
     1424       end.
     1425     end.
     1426   end procedure.
     1427   procedure diasize_add_browse :
     1428     define input  parameter p-browse-type   as character no-undo .
     1429     define input  parameter p-browse-handle as handle    no-undo .
     1430     define buffer buf_temp-browse-handle for temp-browse-handle .
     1431     do
     1432     on error undo, return error return-value
     1433     :
     1434       assign
     1435         v-diasize-browse-number = v-diasize-browse-number + 1
     1436       .
     1437       create buf_temp-browse-handle .
     1438       assign
     1439         buf_temp-browse-handle.browse-type   = p-browse-type
     1440         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1441         buf_temp-browse-handle.browse-handle = p-browse-handle
     1442       .
     1443     end.
     1444   end procedure.
     1445   procedure diasize_init :
     1446     define variable v-default-value    as logical   no-undo .
     1447     define variable v-restore-saved    as logical   no-undo .
     1448     define variable v-resize-value-str as character no-undo .
     1449     do
     1450     on error undo, return error return-value
     1451     :
     1452       do with frame Dialog-Frame
     1453       :
     1454         assign
     1455           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1456           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1457           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1458         .
     1459         create button v-diasize-resize-button
     1460         assign
     1461           parent        = frame Dialog-Frame :first-child
     1462           label         = "s"
     1463           height-pixels = 16
     1464           width-pixels  = 16
     1465           visible       = true
     1466           sensitive     = true
     1467           movable       = true
     1468           triggers:
     1469             on end-move persistent run diasize_end-move in this-procedure .
     1470           end triggers.
     1471         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1472         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1473         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1474         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1475         assign
     1476           v-diasize-wndmax = false
     1477         .
     1478         if connected("ub") = true
     1479         then do:
     1480           define variable v-cntxt-db-num        as integer   no-undo .
     1481           define variable v-cntxt-userid        as character no-undo .
     1482           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1483                                             , OUTPUT v-cntxt-userid
     1484                                             ) .
     1485           run gbl/wndpar_r.p
     1486             (input  v-cntxt-db-num
     1487             ,input  v-cntxt-userid
     1488             ,input  'wndmax':U
     1489             ,output v-diasize-wndmax
     1490             ,output v-default-value
     1491             ) .
     1492         end.
     1493         assign
     1494           v-diasize-wndstore = false
     1495         .
     1496         if connected("ub") = true
     1497         then do:
     1498           run gbl/wndpar_r.p
     1499             (input  v-cntxt-db-num
     1500             ,input  v-cntxt-userid
     1501             ,input  'wndstore':U
     1502             ,output v-diasize-wndstore
     1503             ,output v-default-value
     1504             ) .
     1505         end.
     1506         assign
     1507           v-diasize-proc-name = entry(1, program-name(2), '.')
     1508         .
     1509         if v-diasize-wndstore = true
     1510         then do:
     1511           assign
     1512             v-restore-saved = false
     1513           .
     1514           if connected("ub") = true
     1515           then do:
     1516             run gbl/wndsizer.p
     1517               (input  v-cntxt-db-num
     1518               ,input  v-cntxt-userid
     1519               ,input  v-diasize-proc-name
     1520               ,input  'height':u
     1521               ,output v-resize-value-str
     1522               ) .
     1523             if v-resize-value-str <> '':U
     1524             then do:
     1525               run diasize_change-height in this-procedure
     1526                 (input  integer(v-resize-value-str)
     1527                 ,input  true
     1528                 ) .
     1529               assign
     1530                 v-restore-saved = true
     1531               .
     1532             end.
     1533           end.
     1534           if connected("ub") = true
     1535           then do:
     1536             run gbl/wndsizer.p
     1537               (input  v-cntxt-db-num
     1538               ,input  v-cntxt-userid
     1539               ,input  v-diasize-proc-name
     1540               ,input  'width':u
     1541               ,output v-resize-value-str
     1542               ) .
     1543             if v-resize-value-str <> '':U
     1544             then do:
     1545               run diasize_change-width in this-procedure
     1546                 (input  integer(v-resize-value-str)
     1547                 ,input  true
     1548                 ) .
     1549               assign
     1550                 v-restore-saved = true
     1551               .
     1552             end.
     1553           end.
     1554           if v-restore-saved <> true
     1555           then do:
     1556             if v-diasize-wndmax = true
     1557             then do:
     1558               run diasize_maximize in this-procedure
     1559                 (input  true
     1560                 ) .
     1561             end.
     1562           end.
     1563         end.
     1564         else do:
     1565           if v-diasize-wndmax = true
     1566           then do:
     1567             run diasize_maximize in this-procedure
     1568               (input  true
     1569               ) .
     1570           end.
     1571         end.
     1572       end.
     1573     end.
     1574   end procedure.
     1575   procedure diasize_need-full-display :
     1576     define output parameter p-need-full-display as logical   no-undo .
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580       assign
     1581         p-need-full-display = v-diasize-need-full-display
     1582       .
     1583       assign
     1584         v-diasize-need-full-display = false
     1585       .
     1586     end.
     1587   end procedure.
     1588   procedure get-context :
     1589      define output parameter p-db-num as integer          no-undo.
     1590      define output parameter p-user-id as character        no-undo.
     1591      define variable v-login               as character    no-undo.
     1592      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1593      define buffer buf_user-login  for ub.user-login .
     1594      do
     1595      on error undo, return error
     1596      :
     1597            FIND FIRST buf_sys-ctrl no-lock.
     1598            ASSIGN
     1599               v-login = USERID("ub")
     1600               p-db-num = buf_sys-ctrl.db-num
     1601            .
     1602            FIND FIRST buf_user-login
     1603                 WHERE buf_user-login.db-num = p-db-num
     1604                   AND buf_user-login.user-login = v-login
     1605                 no-lock
     1606                 no-error
     1607                 .
     1608            IF AVAILABLE buf_user-login
     1609            THEN DO:
     1610               assign
     1611                  p-user-id = buf_user-login.user-id
     1612               .
     1613            END.
     1614      end.
     1615   end procedure.
     1616       run diasize_init in this-procedure .
     1617   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1618   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1619   MAIN-BLOCK:
     1620   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1621      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1622      run init-fields in this-procedure no-error.
     1623      if error-status :error
     1624      then do:
     1625          message
     1626            vss-workfile vss-revision vss-description
     1627            skip "Ошибка заполнения полей формы начальными значениями."
     1628            skip return-value
     1629            skip trim(error-status :get-message(1))
     1630                 trim(error-status :get-message(2))
     1631                 trim(error-status :get-message(3))
     1632                 trim(error-status :get-message(4))
     1633                 trim(error-status :get-message(5))
     1634          view-as alert-box error.
     1635          undo, return error .
     1636      end.
     1637     RUN enable_UI.
     1638     apply "entry" to browse-1.
     1639     WAIT-FOR GO OF FRAME Dialog-Frame.
     1640   END.
     1641   RUN disable_UI.
     1642   PROCEDURE assign-for-exit :
     1643   assign
     1644       p-doc-type-list = ''
     1645   .
     1646   find first temp_doc-type
     1647        where temp_doc-type.mark <> '*'
     1648   no-error.
     1649   if available temp_doc-type
     1650   then do:
     1651       for each temp_doc-type
     1652          where temp_doc-type.mark = '*'
     1653       :
     1654           assign
     1655               p-doc-type-list = p-doc-type-list + ( if p-doc-type-list <> '' then "," else '' ) + temp_doc-type.doc-type
     1656           .
     1657       end.
     1658   end.
     1659   END PROCEDURE.
     1660   PROCEDURE b-mark-press :
     1661   define input parameter p-mode as character  no-undo.
     1662   define buffer buf_temp_doc-type for temp_doc-type.
     1663   do
     1664   for buf_temp_doc-type
     1665   with frame Dialog-Frame
     1666   on error undo, return error
     1667   :
     1668       define variable v-focused-row       as integer              no-undo.
     1669       define variable v-repositioned-row  as integer              no-undo.
     1670       assign
     1671           v-focused-row      = browse-1 :focused-row in frame Dialog-Frame.
     1672           v-repositioned-row = current-result-row( "browse-1" )
     1673       .
     1674       case p-mode
     1675       :
     1676           when "b-mark-one":U
     1677           then do:
     1678               if temp_doc-type.mark = '*'
     1679               then do:
     1680                   assign
     1681                       temp_doc-type.mark = "":U
     1682                   .
     1683               end.
     1684               else do:
     1685                   assign
     1686                       temp_doc-type.mark = '*'
     1687                   .
     1688               end.
     1689           end.
     1690           when "b-mark-all":U
     1691           then do:
     1692               for each buf_temp_doc-type
     1693               :
     1694                   assign
     1695                       buf_temp_doc-type.mark = '*'
     1696                   .
     1697               end.
     1698           end.
     1699           when "b-mark-no-one":U
     1700           then do:
     1701               for each buf_temp_doc-type
     1702               :
     1703                   assign
     1704                       buf_temp_doc-type.mark = "":U
     1705                   .
     1706               end.
     1707           end.
     1708           when "b-mark-inverse":U
     1709           then do:
     1710               for each buf_temp_doc-type
     1711               :
     1712                   if buf_temp_doc-type.mark = '*'
     1713                   then do:
     1714                       assign
     1715                           buf_temp_doc-type.mark = "":U
     1716                       .
     1717                   end.
     1718                   else do:
     1719                       assign
     1720                           buf_temp_doc-type.mark = '*'
     1721                       .
     1722                   end.
     1723               end.
     1724           end.
     1725       end case.
     1726       OPEN QUERY BROWSE-1 FOR EACH temp_doc-type SHARE-LOCK     BY temp_doc-type.dtp-key .
     1727       if v-focused-row < v-types-amount
     1728       and last-event :event-type <> "MOUSE":U
     1729       and p-mode = "b-mark-one":U
     1730       then do:
     1731           if v-focused-row > browse-1 :height - 2
     1732           then do:
     1733               assign
     1734                   v-repositioned-row  = v-repositioned-row + 1
     1735               .
     1736           end.
     1737           else do:
     1738               assign
     1739                   v-focused-row       = v-focused-row + 1
     1740                   v-repositioned-row  = v-repositioned-row + 1
     1741               .
     1742           end.
     1743       end.
     1744       browse-1 :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dialog-Frame.
     1745       reposition browse-1 to row v-repositioned-row.
     1746   end.
     1747   END PROCEDURE.
     1748   PROCEDURE delete-objects :
     1749   do
     1750   on error undo, return error
     1751   :
     1752   define input parameter p-destination_rowid  as character    no-undo.
     1753       define buffer buf_rcs-destn       for ub.rcs-destn.
     1754       find first buf_rcs-destn exclusive-lock
     1755            where buf_rcs-destn.destination_rowid    = p-destination_rowid
     1756       no-error.
     1757       if not available buf_rcs-destn
     1758       then do:
     1759           undo, return error "delete-objects: Не удалось удалить запись." + chr(10) + return-value.
     1760       end.
     1761       else do:
     1762           delete buf_rcs-destn.
     1763       end.
     1764   end.
     1765   END PROCEDURE.
     1766   PROCEDURE disable_UI :
     1767     HIDE FRAME Dialog-Frame.
     1768   END PROCEDURE.
     1769   PROCEDURE enable_UI :
     1770     ENABLE b-sel b-mark b-exit b-help BROWSE-1
     1771         WITH FRAME Dialog-Frame.
     1772     VIEW FRAME Dialog-Frame.
     1773     OPEN QUERY BROWSE-1 FOR EACH temp_doc-type SHARE-LOCK     BY temp_doc-type.dtp-key .
     1774   END PROCEDURE.
     1775   PROCEDURE init-fields :
     1776       define variable v-counter           as integer           no-undo.
     1777       define variable v-oper-num          as integer           no-undo.
     1778       define variable v-what-doc-counter  as integer no-undo .
     1779       define variable v-what-doc-amount   as integer no-undo .
     1780       define buffer buf_temp_doc-type     for temp_doc-type.
     1781   do
     1782   for buf_temp_doc-type
     1783   on error undo, return error
     1784   :
     1785       assign
     1786           v-oper-num = 0
     1787           v-what-doc-amount = num-entries( p-what-doc )
     1788       .
     1789       do v-what-doc-counter = 1 to v-what-doc-amount
     1790       :
     1791           case entry( v-what-doc-counter, p-what-doc )
     1792           :
     1793               when "trn-doc":U
     1794               then do:
     1795                   do
     1796                   v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1797                   :
     1798                       create buf_temp_doc-type.
     1799                       assign
     1800                           buf_temp_doc-type.dtp-key           = ( v-what-doc-counter - 1) * v-what-doc-amount + v-counter
     1801                           buf_temp_doc-type.doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1802                           buf_temp_doc-type.doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1803                       .
     1804                       if p-init-doc-type-list = "":U
     1805                       or lookup( buf_temp_doc-type.doc-type, p-init-doc-type-list ) <> 0
     1806                       then do:
     1807                           assign
     1808                               buf_temp_doc-type.mark              = '*'
     1809                           .
     1810                       end.
     1811                       else do:
     1812                           assign
     1813                               buf_temp_doc-type.mark              = "":U
     1814                           .
     1815                       end.
     1816                   end.
     1817                   assign
     1818                       p-doc-type-list = p-init-doc-type-list
     1819                       v-oper-num      = v-oper-num + v-counter
     1820                   .
     1821               end.
     1822               when "fin-doc":U
     1823               then do:
     1824                   create-doc-type-list:
     1825                   do
     1826                   v-counter = 1 to num-entries( 'пко,рко,ппп,рпп,апп,апр,':U )
     1827                   :
     1828                       if entry( v-counter, 'пко,рко,ппп,рпп,апп,апр,':U ) = "":U
     1829                       then do:
     1830                           next create-doc-type-list.
     1831                       end.
     1832                       create buf_temp_doc-type.
     1833                       assign
     1834                           buf_temp_doc-type.dtp-key           = 100 *  ( v-what-doc-counter - 1) * v-what-doc-amount + v-counter
     1835                           buf_temp_doc-type.doc-type          = entry( v-counter, 'пко,рко,ппп,рпп,апп,апр,':U )
     1836                           buf_temp_doc-type.doc-type-label    = entry( v-counter, 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U )
     1837                       .
     1838                       if p-init-doc-type-list = "":U
     1839                       or lookup( buf_temp_doc-type.doc-type, p-init-doc-type-list ) <> 0
     1840                       then do:
     1841                           assign
     1842                               buf_temp_doc-type.mark              = '*'
     1843                           .
     1844                       end.
     1845                       else do:
     1846                           assign
     1847                               buf_temp_doc-type.mark              = "":U
     1848                           .
     1849                       end.
     1850                   end.
     1851                   assign
     1852                       p-doc-type-list = p-init-doc-type-list
     1853                       v-oper-num      = v-oper-num + v-counter - 1
     1854                   .
     1855               end.
     1856               when "fin-doc-bank":U
     1857               then do:
     1858                   do
     1859                   v-counter = 1 to 1
     1860                   :
     1861                       create buf_temp_doc-type.
     1862                       assign
     1863                           buf_temp_doc-type.dtp-key           = 200 * ( v-what-doc-counter - 1) * v-what-doc-amount + v-counter
     1864                           buf_temp_doc-type.doc-type-label    = v-fdoctype-bank-type-list[ v-counter * 3 - 2 ]
     1865                           buf_temp_doc-type.doc-type          = v-fdoctype-bank-type-list[ v-counter * 3 - 1 ]
     1866                       .
     1867                       if p-init-doc-type-list = "":U
     1868                       or lookup( v-fdoctype-bank-type-list[ v-counter * 3 - 1 ], p-init-doc-type-list ) <> 0
     1869                       then do:
     1870                           assign
     1871                               buf_temp_doc-type.mark              = '*'
     1872                           .
     1873                       end.
     1874                       else do:
     1875                           assign
     1876                               buf_temp_doc-type.mark              = "":U
     1877                           .
     1878                       end.
     1879                   end.
     1880                   assign
     1881                       p-doc-type-list = p-init-doc-type-list
     1882                       v-oper-num      = v-oper-num + v-counter
     1883                   .
     1884               end.
     1885               when "contract":U
     1886               then do:
     1887                   do
     1888                   v-counter = 1 to 2
     1889                   :
     1890                   create buf_temp_doc-type.
     1891                   assign
     1892                       buf_temp_doc-type.dtp-key           = 300 * ( v-what-doc-counter - 1) * v-what-doc-amount + v-counter
     1893                       buf_temp_doc-type.doc-type-label    = v-conttype-type-list[ v-counter * 2 - 1 ]
     1894                       buf_temp_doc-type.doc-type          = v-conttype-type-list[ v-counter * 2 ]
     1895                   .
     1896                   if p-init-doc-type-list = "":U
     1897                   or lookup( v-conttype-type-list[ v-counter * 2 ], p-init-doc-type-list ) <> 0
     1898                   then do:
     1899                       assign
     1900                           buf_temp_doc-type.mark = '*'
     1901                       .
     1902                   end.
     1903                   else do:
     1904                       assign
     1905                           buf_temp_doc-type.mark = "":U
     1906                       .
     1907                   end.
     1908                   end.
     1909                   assign
     1910                       p-doc-type-list = p-init-doc-type-list
     1911                       v-oper-num      = v-oper-num + v-counter
     1912                   .
     1913               end.
     1914           end case.
     1915       end.
     1916       assign
     1917           v-types-amount = v-oper-num
     1918       .
     1919   end.
     1920   END PROCEDURE.
