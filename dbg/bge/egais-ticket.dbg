        6   define variable qh-ticket-egais-last    as handle  no-undo.
        7   define variable browse-hdl-ticket-egais as handle  no-undo.
        8   define variable bh-ticket-egais         as handle  no-undo.
        9   define variable isRepealWB              as logical no-undo.
       10   define variable wbregIdRepeal           as character no-undo.
       11   define variable bcol                    as handle extent no-undo.
       12   define variable egaisWBAdv              as class WayBill no-undo.
       13     define temp-table tt-wb-header no-undo
       14       field wb-type-full as character label "Тип" format "X(10)"
