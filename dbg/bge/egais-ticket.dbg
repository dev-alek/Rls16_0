      154       .
      155   procedure proc-alt-shift-f2:
      156     if not ibs.th.gbl.gbl-var:rcode
      157   then
      158     run gbl\inidebug.p .
      159   end.
      160   procedure proc-alt-shift-f3:
      161     run gbl/prvssinf.p
      162       ( input this-procedure
      163       ) .
      164   end.
      165   define variable v-inform-launched as logical no-undo initial false .
      166   procedure proc-alt-shift-f4:
      167     define variable v-action as character no-undo .
      168     if v-inform-launched = false then do:
      169       assign
      170         v-inform-launched = true
      171       .
      172       run gbl/d-inform.w
      173         (  input self
      174         ,  input this-procedure
      175         , output v-action
      176         ) no-error .
      177       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      178       assign
      179         v-inform-launched = false
      180       .
      181     end.
      182   end.
      183   procedure proc-alt-f1:
      184     run gbl/corrhelp.p
      185       (input this-procedure
      186       ) .
      187   end .
      188   on alt-shift-f2 anywhere do:
      189     run proc-alt-shift-f2.
      190   end.
      191   on alt-shift-f3 anywhere do:
      192     run proc-alt-shift-f3 in this-procedure .
      193   end.
      194   on alt-shift-f4 anywhere do:
      195     run proc-alt-shift-f4 in this-procedure.
      196   end.
      197   on alt-f1 anywhere do:
      198     run proc-alt-f1 in this-procedure .
      199   end.
      200   define new global shared variable g#language as character no-undo .
      201   if g#language <> '' and g#language <> 'rus':U then do:
      202     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      203   end.
      204   define buffer buf_doc-attr for ub.doc-attr.
      205   DEFINE BUTTON btn_accRepeal
      206        LABEL "Подт. расп."
      207        SIZE 15 BY 1.13.
      208   DEFINE BUTTON Btn_OK AUTO-GO
      209        LABEL "Выход"
      210        SIZE 15 BY 1.13
      211        BGCOLOR 8 .
      212   DEFINE BUTTON btn_rejRepeal
      213        LABEL "Отказ расп."
      214        SIZE 15 BY 1.13.
      215   DEFINE VARIABLE cb_status AS CHARACTER FORMAT "X(256)":U
      216        LABEL "Статус"
      217        VIEW-AS COMBO-BOX INNER-LINES 5
      218        LIST-ITEMS "Accepted","Rejected","Распроведена","Отсутствует"
      219        DROP-DOWN-LIST
      220        SIZE 16 BY 1 NO-UNDO.
      221   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U
      222        VIEW-AS FILL-IN
      223        SIZE 119.25 BY 1
      224        FGCOLOR 4  NO-UNDO.
      225   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U
      226        VIEW-AS FILL-IN
      227        SIZE 119.25 BY 1
      228        FGCOLOR 4  NO-UNDO.
      229   DEFINE VARIABLE FILL-IN-3 AS CHARACTER FORMAT "X(256)":U
      230        VIEW-AS FILL-IN
      231        SIZE 119.25 BY 1
      232        FGCOLOR 4  NO-UNDO.
      233   DEFINE VARIABLE FILL-IN-4 AS CHARACTER FORMAT "X(256)":U
      234        VIEW-AS FILL-IN
      235        SIZE 119.25 BY 1
      236        FGCOLOR 4  NO-UNDO.
      237   DEFINE VARIABLE FILL-IN-5 AS CHARACTER FORMAT "X(256)":U
      238        VIEW-AS FILL-IN
      239        SIZE 119.25 BY 1
      240        FGCOLOR 4  NO-UNDO.
      241   DEFINE FRAME Dialog-Frame
      242        Btn_OK AT ROW 1.25 COL 1.5
      243        btn_accRepeal AT ROW 1.25 COL 17.13 WIDGET-ID 12
      244        btn_rejRepeal AT ROW 1.25 COL 32.88 WIDGET-ID 14
      245        cb_status AT ROW 1.25 COL 55.5 COLON-ALIGNED WIDGET-ID 16
      246        FILL-IN-1 AT ROW 14.71 COL 1.75 NO-LABEL WIDGET-ID 2
      247        FILL-IN-3 AT ROW 15.71 COL 1.75 NO-LABEL WIDGET-ID 6
      248        FILL-IN-2 AT ROW 16.71 COL 1.75 NO-LABEL WIDGET-ID 4
      249        FILL-IN-4 AT ROW 17.71 COL 1.75 NO-LABEL WIDGET-ID 8
      250        FILL-IN-5 AT ROW 18.71 COL 1.75 NO-LABEL WIDGET-ID 10
      251        SPACE(0.37) SKIP(0.11)
      252       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      253            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      254            TITLE "Квитанция по накладной"
      255            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      256   ASSIGN
      257          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      258          FRAME Dialog-Frame:HIDDEN           = TRUE.
      259   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      260   DO:
      261     APPLY "END-ERROR":U TO SELF.
      262   END.
      263   ON CHOOSE OF btn_accRepeal IN FRAME Dialog-Frame
      264   DO:
      265     egaisWBAdv:ConfirmRepealWB(wbregIdRepeal, "Accepted").
      266     if egaisWBAdv:StatusErr
      267     then do:
      268       message egaisWBAdv:Msg view-as alert-box error.
      269       return no-apply.
      270     end.
      271   END.
      272   ON CHOOSE OF btn_rejRepeal IN FRAME Dialog-Frame
      273   DO:
      274     egaisWBAdv:ConfirmRepealWB(wbregIdRepeal, "Rejected").
      275     if egaisWBAdv:StatusErr
      276     then do:
      277       message egaisWBAdv:Msg view-as alert-box error.
      278       return no-apply.
      279     end.
      280   END.
      281   ON VALUE-CHANGED OF cb_status IN FRAME Dialog-Frame
      282   DO:
      283     message  substitute ("Вы уверены, что хотите изменить статус накладной с &1 на &2?", bh-wb-egais:buffer-field ("EGAISSts"):buffer-value, cb_status:screen-value) view-as alert-box question buttons yes-no
      284       title "" update isChoise as logical.
      285     if isChoise
      286     then do:
      287       if egaisWBAdv:ActnEGAISAdm
      288       then do:
      289         if bh-wb-egais:buffer-field ("wb-type"):buffer-value begins "расход" or bh-wb-egais:buffer-field ("wb-type"):buffer-value begins "возврат"
      290         then do:
      291           find first ub.doc-attr exclusive-lock
      292             where ub.doc-attr.doc-code = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value and ub.doc-attr.attr-code = 'egais':U no-error.
      293           if available (ub.doc-attr)
      294             then
      295           do:
      296             ub.doc-attr.attr-value = if cb_status:screen-value = "Отсутствует" then "" else cb_status:screen-value.
      297           end.
      298           release ub.doc-attr.
      299         end.
      300         else do:
      301           for each ub.clob-bind where ub.clob-bind.resource-type = 'egais-wb':U and ub.clob-bind.uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value:
      302             if num-entries (ub.clob-bind.descr, chr(4)) = 9
      303             then do:
      304               ub.clob-bind.descr = ub.clob-bind.descr + chr(4).
      305             end.
      306             if num-entries (ub.clob-bind.descr, chr(4)) > 9
      307             then
      308               assign
      309                 entry (10, ub.clob-bind.descr, chr(4)) = if cb_status:screen-value = "Отсутствует" then "" else cb_status:screen-value
      310               .
      311           end.
      312           for each buf_doc-attr no-lock
      313             where buf_doc-attr.doc-code = bh-wb-egais:buffer-field ("wbregid"):buffer-value and buf_doc-attr.attr-code = 'negais':U:
      314             find first ub.doc-attr exclusive-lock where ub.doc-attr.doc-code = buf_doc-attr.doc-code and ub.doc-attr.attr-code = 'egais':U no-error.
      315             if available (ub.doc-attr)
      316               then ub.doc-attr.attr-value = if cb_status:screen-value = "Отсутствует" then "" else cb_status:screen-value.
      317             release ub.doc-attr.
      318           end.
      319         end.
      320         bh-wb-egais:buffer-field ("EGAISSts"):buffer-value = cb_status:screen-value .
      321         return.
      322       end.
      323       else do:
      324         message 'Для изменения статуса остутсвует необходимое право "Администрирование запросов в ЕГАИС"' view-as alert-box error title "".
      325       end.
      326     end.
      327     cb_status:screen-value = bh-wb-egais:buffer-field ("EGAISSts"):buffer-value.
      328     return no-apply.
      329   END.
      330   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      331   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      332   MAIN-BLOCK:
      333   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      334      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      335     def var ii as int no-undo.
      336     egaisWBAdv = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill).
      337     create query qh-ticket-egais.
      338     create browse browse-hdl-ticket-egais
      339       assign
      340         title     = 'Связанные документы ЕГАИС'
      341         frame     = frame Dialog-Frame:handle
      342         query     = qh-ticket-egais
      343         x         = 6
      344         y         = 38
      345         width     = 119
      346         height    = 12
      347         visible   = true
      348         read-only = true
      349         sensitive = true
      350         separators = true
      351         column-resizable = true
      352         column-scrolling = true
      353         triggers:
      354           on value-changed persistent run local-value-changed.
      355         end triggers
      356     .
      357     if bh-wb-egais = ? then return.
      358     if bh-wb-egais:buffer-field ("wb-type"):buffer-value begins "расход" or bh-wb-egais:buffer-field ("wb-type"):buffer-value begins "возврат"
      359     then do:
      360       bh-ticket-egais = egais:GetHndlTable(13, bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value).
      361     end.
      362     else do:
      363       bh-ticket-egais = egais:GetHndlTable(12, bh-wb-egais:buffer-field ("wbregid"):buffer-value).
      364     end.
      365     if egais:StatusErr
      366     then do:
      367       message egais:Msg view-as alert-box error.
      368       return.
      369     end.
      370     qh-ticket-egais:set-buffers (bh-ticket-egais).
      371     qh-ticket-egais:query-prepare ("for each tt-ticket").
      372     qh-ticket-egais:query-open.
      373     if not bh-ticket-egais = ?
      374     then do:
      375       extent (bcol) = bh-ticket-egais:num-fields.
      376       do ii = 1 to bh-ticket-egais:num-fields:
      377         bcol[ii] = browse-hdl-ticket-egais:add-like-column('tt-ticket' + '.' + bh-ticket-egais:buffer-field (ii):name, 0, 'FILL-IN').
      378         if ii = 6 then bcol[ii]:width = 80.
      379         if ii = 2 then bcol[ii]:width = 15.
      380         if ii = 3 then bcol[ii]:width = 15.
      381       end.
      382     end.
      383     isRepealWB = bh-ticket-egais:find-last ("where docType = 'RequestRepealWB'", no-lock) no-error.
      384     if isRepealWB
      385       then wbregIdRepeal = bh-ticket-egais:buffer-field ("regid"):buffer-value.
      386     if lookup (bh-wb-egais:buffer-field ("EGAISSts"):buffer-value, cb_status:list-items ) = 0 and (bh-wb-egais:buffer-field ("EGAISSts"):buffer-value <> ? and bh-wb-egais:buffer-field ("EGAISSts"):buffer-value <> "")
      387       then cb_status:list-items = cb_status:list-items + "," + bh-wb-egais:buffer-field ("EGAISSts"):buffer-value.
      388     cb_status = if bh-wb-egais:buffer-field ("EGAISSts"):buffer-value = "" or bh-wb-egais:buffer-field ("EGAISSts"):buffer-value = ? then "Отсутствует" else bh-wb-egais:buffer-field ("EGAISSts"):buffer-value.
      389     RUN enable_UI.
      390     run hide-disp.
      391     bh-ticket-egais:find-first ("") no-error.
      392     run local-value-changed.
      393     if not egaisWBAdv:ActnEGAISSts
      394       then cb_status:sensitive = false.
      395     WAIT-FOR GO OF FRAME Dialog-Frame.
      396   END.
      397   RUN disable_UI.
      398   PROCEDURE disable_UI :
      399     HIDE FRAME Dialog-Frame.
      400   END PROCEDURE.
      401   PROCEDURE enable_UI :
      402     DISPLAY cb_status FILL-IN-1 FILL-IN-3 FILL-IN-2 FILL-IN-4 FILL-IN-5
      403         WITH FRAME Dialog-Frame.
      404     ENABLE Btn_OK btn_accRepeal btn_rejRepeal cb_status
      405         WITH FRAME Dialog-Frame.
      406     VIEW FRAME Dialog-Frame.
      407   END PROCEDURE.
      408   PROCEDURE hide-disp :
      409   do with frame Dialog-Frame:
      410       if isRepealWB
      411       then do:
      412         btn_accRepeal:hidden = false.
      413         btn_rejRepeal:hidden = false.
      414       end.
      415       else do:
      416         btn_accRepeal:hidden = true.
      417         btn_rejRepeal:hidden = true.
      418       end.
      419     end.
      420   end.
      421   PROCEDURE local-value-changed :
      422   define variable v-str1 as character no-undo.
      423     define variable v-str2 as character no-undo.
      424     define variable v-str3 as character no-undo.
      425     define variable v-str4 as character no-undo.
      426     define variable v-str5 as character no-undo.
      427     if not bh-ticket-egais:available
      428       then return no-apply.
      429     v-str1 = substring (bh-ticket-egais:buffer-field ("comment"):buffer-value, 1, 115).
      430     v-str2 = substring (bh-ticket-egais:buffer-field ("comment"):buffer-value, 116, 115).
      431     v-str3 = substring (bh-ticket-egais:buffer-field ("comment"):buffer-value, 231, 115).
      432     v-str4 = substring (bh-ticket-egais:buffer-field ("comment"):buffer-value, 346, 115).
      433     v-str5 = substring (bh-ticket-egais:buffer-field ("comment"):buffer-value, 461, 115).
      434     display v-str1 @ fill-in-1 with frame Dialog-Frame.
      435     display v-str2 @ fill-in-3 with frame Dialog-Frame.
      436     display v-str3 @ fill-in-2 with frame Dialog-Frame.
      437     display v-str4 @ fill-in-4 with frame Dialog-Frame.
      438     display v-str5 @ fill-in-5 with frame Dialog-Frame.
      439   end.
