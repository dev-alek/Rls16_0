       67       index qntyIndex
       68       gds-code
       69       alc-code
       70       qnty
       71       .
       72     define temp-table tt-wb-act-header no-undo
       73       field num          as character label "№ пост."
       74       field wbregid      as character label "WBRegId" format "X(21)"
       75       field act-date     as date label "Дата"
       76       field status_      as character label "Статус"
       77       field note         as character label "Примечание" format "X(150)"
       78       index pi
