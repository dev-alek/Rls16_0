       41     define temp-table tt-wb-gds-EG no-undo
       42       field gds-code       like ub.goods.gds-code label "Код товара в TH"
       43       field gds-name       like ub.goods.gds-name label "Полное наименование" format "X(150)"
       44       field alc-code       as character label "Алкогольный код" format "X(21)"
       45       field ms-base        like ub.goods.ms-base label "Объем" format ">>9.9<<"
       46       field alc-type-code  like ub.alc-type.alc-type-code label "Код АП"
       47       field proof          like ub.goods.proof label "Крепость" format ">9.9"
       48       field regID-i-p      as character format "X(21)" label "Импортер/Производитель"
       49       field i-p-name       as character label "Импортер/Производитель назв." format "X(150)"
       50       field i-p-th         as character label "Импортер/Производитель TH"
       51       field qnty           like ub.doc-line.doc-qnty label "Кол-во"
       52       field price          like ub.doc-line.price-rubl label "Цена"
       53       field refA           as character label "Справка A" format "X(25)"
       54       field refB           as character label "Справка B" format "X(25)"
       55       field beforRefB      as character label "Пред. справка B" format "X(25)"
       56       field Identity       as character label "ID EGAIS"
       57       field regID-Importer as character format "X(21)" label "Импортер"
       58       field importer-th    as character label "Импортер TH"
       59       field regID-Producer as character format "X(21)" label "Производитель"
       60       field Producer-th    as character label "Производитель TH"
       61       field nn             as integer label "№"
       62       field prod-list      as character format "x(1)"
       63       field importer-list  as character format "x(1)"
       64       field color-sts      as integer   format "99" init ?
       65       field UnitType       as character format "x(1)"
