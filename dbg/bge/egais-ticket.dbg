      119       field doc          as character label "Документ" format "X(30)"
      120       field docType      as character label "Документ" format "X(30)"
      121       field ticket-date  as character label "Дата" format "X(29)"
      122       field status_      as character label "Статус"
      123       field comment      as character label "Коментарий" format "X(150)"
      124       field docId        as character label "DocId" format "X(40)"
