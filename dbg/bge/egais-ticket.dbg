       81     define temp-table tt-wb-act-gds-EG no-undo
       82       field gds-code      as integer label "Код товара в TH"
       83       field gds-name      as character label "Полное наименование" format "X(150)"
       84       field doc-qnty      as decimal label "Кол-во по док."
       85       field fact-qnty     as decimal label "Кол-во факт."
