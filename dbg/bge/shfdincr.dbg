     1075   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1076                                             INPUT iFlagEmpty AS INTEGER).
     1077       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1078       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1079           DO:
     1080               IF iFlagEmpty = 0                           THEN RETURN "".
     1081               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1082               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1083               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1084               ELSE RETURN "".
     1085           END.
     1086       ELSE DO:
     1087           run xmlchar-encode in this-procedure (
     1088                 input sToPlace
     1089               , output sToPlace
     1090           ).
     1091           ASSIGN
     1092               sToPlace = sParName + '="' + sToPlace + '"'
     1093           .
     1094           RETURN sToPlace.
     1095       END.
     1096   END FUNCTION.
     1097   function bge-xml-date returns character
     1098   ( input p-date as date )
     1099   :
     1100     define variable v-date-str as character no-undo .
     1101     run bge-xml-date-to-str in this-procedure ( input   p-date
     1102                                               , output  v-date-str
     1103                                               ) .
     1104     return v-date-str.
     1105   end function.
     1106   function bge-xml-str-date returns character
     1107   ( input p-date-str as character )
     1108   :
     1109     define variable v-date-str as character no-undo .
     1110     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1111                                                   , output  v-date-str
     1112                                                   ) .
     1113     return v-date-str.
     1114   end function.
     1115   function bge-xml-normalize-dec returns decimal
     1116   ( input p-val as decimal )
     1117   :
     1118     return (if p-val = ? then 0 else p-val) .
     1119   end function.
     1120   PROCEDURE wp-XMLTagOpen:
     1121   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1122   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1123   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1124       define variable v-out-string    as character    no-undo.
     1125   do
     1126   on error undo, return error
     1127   :
     1128       if v-bge-xml-bgefmt = "dbf":U
     1129       then do:
     1130       end.
     1131       else do:
     1132           assign
     1133               v-out-string = substitute( "&1&2<&3&4>"
     1134                                       , chr(10)
     1135                                       , fill( " ":U, 4 * iTagLevel)
     1136                                       , sTagName
     1137                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1138                               )
     1139           .
     1140           put stream stmXMLOut unformatted
     1141               v-out-string
     1142           .
     1143       end.
     1144   end.
     1145   END PROCEDURE.
     1146   PROCEDURE wp-XMLTagPut:
     1147     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1148     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1149     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1150     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1151       define variable v-out-string    as character    no-undo.
     1152   do
     1153   on error undo, return error
     1154   :
     1155       if v-bge-xml-bgefmt = "dbf":U
     1156       then do:
     1157           if v-bge-xml-dbf-file-name <> "":U
     1158           then do:
     1159               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1160               export stream stmXMLOut
     1161                   sTagName
     1162                   sParValue
     1163               .
     1164               output stream stmXMLOut close.
     1165           end.
     1166       end.
     1167       else do:
     1168           IF  iFlagEmpty = 1
     1169           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1170           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1171           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1172           THEN DO:
     1173               run xmlchar-encode in this-procedure (
     1174                   input sParValue
     1175                   , output sParValue
     1176               ).
     1177               assign
     1178                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1179                                               , chr(10)
     1180                                               , FILL(" ", 4 * iTagLevel)
     1181                                               , sTagName
     1182                                               , sParValue
     1183                               )
     1184               .
     1185               PUT STREAM stmXMLOut UNFORMATTED
     1186                   v-out-string
     1187               .
     1188           END.
     1189       end.
     1190   end.
     1191   END PROCEDURE.
     1192   PROCEDURE wp-XMLTagClose:
     1193   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1194   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1195       define variable v-out-string    as character    no-undo.
     1196   do
     1197   on error undo, return error
     1198   :
     1199       if v-bge-xml-bgefmt = "dbf":U
     1200       then do:
     1201       end.
     1202       else do:
     1203           assign
     1204               v-out-string = substitute( "&1&2</&3>"
     1205                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1206                                   , fill( " ", 4 * iTagLevel )
     1207                                   , sTagName
     1208                           )
     1209           .
     1210           PUT STREAM stmXMLOut UNFORMATTED
     1211               v-out-string
     1212           .
     1213       end.
     1214   end.
     1215   END PROCEDURE.
     1216   PROCEDURE wp-XMLWriteLog:
     1217     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1218     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1219     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1220   define variable v-str              as character no-undo .
     1221   define variable v-error-append     as logical   no-undo .
     1222   define variable v-error-append-msg as character no-undo .
     1223   assign
     1224     v-str = chr(10)
     1225             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1226             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1227     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1228     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1229     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1230   .
     1231   run bge/bge-log.p (input v-str) no-error .
     1232   if error-status:error then do:
     1233     assign
     1234       v-error-append     = yes
     1235       v-error-append-msg = return-value
     1236     .
     1237   end.
     1238   run gbl/fileapnd.p
     1239     ( input sFileName
     1240     , input v-str
     1241     , input 10
     1242     ) no-error .
     1243   if error-status:error then do:
     1244     assign
     1245       v-error-append     = yes
     1246       v-error-append-msg = substitute( "&1&2&3"
     1247                                       , v-error-append-msg
     1248                                       , chr(10)
     1249                                       , return-value
     1250                                       )
     1251     .
     1252   end.
     1253   if v-error-append
     1254   then do:
     1255     return error substitute( "&1" , v-error-append-msg ) .
     1256   end.
     1257   END PROCEDURE.
     1258   PROCEDURE wp-XMLWriteEDT:
     1259     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1260     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1261     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1262       if valid-handle ( hEDT )
     1263       then do:
     1264           hEDT :move-to-eof().
     1265           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1266                                           OR sToWrite = "&Line") THEN "" ELSE
     1267                                           cur-time-string-sec() + " ").
     1268           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1269                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1270                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1271           hEDT :insert-string(chr(10)).
     1272       end.
     1273       process events.
     1274       output to 'bgescn.txt' append.
     1275           put unformatted
     1276               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1277                                           OR sToWrite = "&Line") THEN "" ELSE
     1278                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1279               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1280                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1281                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1282           .
     1283       output close.
     1284   END PROCEDURE.
     1285   PROCEDURE wp-XMLShowCNT:
     1286     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1287       if valid-handle( hCNT )
     1288       then do:
     1289           ASSIGN hCNT :VISIBLE = TRUE.
     1290       end.
     1291   END PROCEDURE.
     1292   PROCEDURE wp-XMLHideCNT:
     1293     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1294       if valid-handle( hCNT )
     1295       then do:
     1296           ASSIGN hCNT :VISIBLE = FALSE.
     1297       end.
     1298   END PROCEDURE.
     1299   PROCEDURE wp-XMLWriteCNT:
     1300     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1301     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1302       if valid-handle( hCNT )
     1303       then do:
     1304           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1305       end.
     1306   END PROCEDURE.
     1307   procedure bge-xml-write-header:
     1308   do
     1309   on error undo, return error
     1310   :
     1311   define input parameter p-xml-file-name  as character        no-undo.
     1312   define input parameter p-doc-name       as character        no-undo.
     1313   define input parameter p-version        as character        no-undo.
     1314   define input parameter p-db-num         as integer          no-undo.
     1315   define input parameter p-date-from      as date             no-undo.
     1316   define input parameter p-shift-num-from as integer          no-undo.
     1317   define input parameter p-date-to        as date             no-undo.
     1318   define input parameter p-shift-num-to   as integer          no-undo.
     1319   define input parameter p-obj-list       as character        no-undo.
     1320   define input parameter p-doc-type-list  as character        no-undo.
     1321   define input parameter p-pay-code       as logical          no-undo.
     1322   define input parameter p-cst            as logical          no-undo.
     1323   define input parameter p-parts          as logical          no-undo.
     1324   define input parameter p-chk-pay-code   as logical          no-undo.
     1325   define input parameter p-pay-desk       as logical          no-undo.
     1326   define input parameter p-pay-desk-cards as logical          no-undo.
     1327   define input parameter p-deleted        as logical          no-undo.
     1328   define input parameter p-opened-docs    as logical          no-undo.
     1329   define variable v-out-string    as character    no-undo.
     1330   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1331   assign
     1332       v-out-string = substitute( "&1&2&3"
     1333                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1334                           , chr(10)
     1335                           , "<IBS_Trade_House>":U )
     1336   .
     1337   put stream stmXMLOut unformatted
     1338       v-out-string
     1339   .
     1340   run wp-XMLTagOpen(1, "header","").
     1341   if v-bge-xml-bgeflold = "oracle":u
     1342   then do:
     1343     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1344     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1345     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1346     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1347     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1348   end.
     1349   run wp-XMLTagOpen( 2, "manifest", "").
     1350   run wp-XMLTagOpen( 3, "document", "").
     1351   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1352   run wp-XMLTagput( 4, "description", "", 0).
     1353   run wp-XMLTagput( 4, "version", p-version, 0).
     1354   run wp-XMLTagclose( 3, "document" ).
     1355   run wp-XMLTagclose( 2, "manifest" ).
     1356   run wp-XMLTagclose( 1, "header" ).
     1357   run wp-XMLTagOpen(1, "options","").
     1358   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1359   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1360   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1361   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1362   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1363   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1364   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1365   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1366   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1367   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1368   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1369   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1370   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1371   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1372   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1373   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1374   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1375   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1376   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1377   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1378   run wp-XMLTagClose(1, "options").
     1379   run wp-XMLTagOpen( 1, "body", "" ).
     1380   output stream stmXMLOut close.
     1381   end.
     1382   end procedure.
     1383   procedure xml-bge-write-footer:
     1384   do
     1385   on error undo, return error return-value
     1386   :
     1387   define input parameter p-xml-file-name as character    no-undo.
     1388   define variable v-error-num     as integer           no-undo.
     1389   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1390   run wp-XMLTagClose( 1, "body" ).
     1391   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1392   output stream stmXMLOut close.
     1393   if v-bge-xml-bgeflold = "oracle":u
     1394   then do:
     1395     define variable v-tmp-file-name         as character no-undo .
     1396     define variable v-zip-file-name         as character no-undo .
     1397     define variable v-exch-file-name        as character no-undo .
     1398     define variable v-heap-file-name        as character no-undo .
     1399     define variable v-i                     as integer   no-undo .
     1400     define variable v-file-name             as character no-undo .
     1401     define variable v-arc                   as character no-undo .
     1402     define variable v-str                   as character no-undo .
     1403     define variable v-exch-tmp-file-name    as character no-undo .
     1404     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1405     define variable v-bge-xml-exch-dir      as character no-undo .
     1406     define variable v-bge-xml-heap-dir      as character no-undo .
     1407     define variable v-bge-xml-compress-heap as logical   no-undo .
     1408     define variable v-home-dir              as character no-undo .
     1409     define variable v-os-command            as character no-undo .
     1410     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1411     if v-home-dir = ?
     1412     then do:
     1413       undo, return error substitute( "&1&2&3"
     1414                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1415                                     , chr(10)
     1416                                     , "Обратитесь к администратору.":u
     1417                                     ).
     1418     end.
     1419     assign
     1420       v-home-dir = v-home-dir
     1421     .
     1422     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1423     if error-status :error
     1424     then do:
     1425       undo, return error substitute( "&1&2&3"
     1426                                     , "Неверно задан каталог экспорта.":u
     1427                                     , chr(10)
     1428                                     , "Обратитесь к администратору.":u
     1429                                     ).
     1430     end.
     1431     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1432     if v-bge-xml-exch-dir = ?
     1433     then do:
     1434       undo, return error substitute( "&1&2&3"
     1435                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1436                                     , chr(10)
     1437                                     , "Обратитесь к администратору.":u
     1438                                     ).
     1439     end.
     1440     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1441     if error-status :error
     1442     then do:
     1443       undo, return error substitute( "&1&2&3"
     1444                                     , "Неверно задан каталог экспорта (exch).":u
     1445                                     , chr(10)
     1446                                     , "Обратитесь к администратору.":u
     1447                                     ).
     1448     end.
     1449     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1450     if v-bge-xml-heap-dir = ?
     1451     then do:
     1452       undo, return error substitute( "&1&2&3"
     1453                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1454                                     , chr(10)
     1455                                     , "Обратитесь к администратору.":u
     1456                                     ).
     1457     end.
     1458     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1459     if error-status :error
     1460     then do:
     1461       undo, return error substitute( "&1&2&3"
     1462                                     , "Неверно задан каталог экспорта (heap).":u
     1463                                     , chr(10)
     1464                                     , "Обратитесь к администратору.":u
     1465                                     ).
     1466     end.
     1467     get-key-value section "BGE" key "heap-compress" value v-str.
     1468     assign
     1469       v-i = int(v-str)
     1470     no-error .
     1471     if v-i = ? or v-i = 0
     1472     then do:
     1473       assign
     1474         v-bge-xml-compress-heap = no
     1475       .
     1476     end.
     1477     else do:
     1478       assign
     1479         v-bge-xml-compress-heap = yes
     1480       .
     1481     end.
     1482     assign
     1483       v-arc = search( "exe/7za.exe":u )
     1484     .
     1485     if v-arc = ? or v-arc = ""
     1486     then do:
     1487       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1488     end.
     1489     assign
     1490       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1491       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1492       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1493       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1494       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1495       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1496       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1497     .
     1498     run gbl/del-file.p (input v-tmp-file-name) .
     1499     run gbl/del-file.p (input v-zip-file-name) .
     1500     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1501     if v-error-num > 0
     1502     then do:
     1503         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1504                                      , p-xml-file-name + "xm1":u
     1505                                      , v-tmp-file-name
     1506                                      , v-error-num
     1507                                      ).
     1508     end.
     1509     assign
     1510       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1511                                    , v-arc
     1512                                    , v-zip-file-name
     1513                                    , v-tmp-file-name
     1514                                    )
     1515     .
     1516     os-command silent value ( v-os-command ) .
     1517     run gbl/del-file.p (input v-heap-file-name) .
     1518     if v-bge-xml-compress-heap = no
     1519     then do:
     1520       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1521       if v-error-num > 0
     1522       then do:
     1523           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1524                                        , v-tmp-file-name
     1525                                        , v-heap-file-name
     1526                                        , v-error-num
     1527                                        ) .
     1528       end.
     1529     end.
     1530     else do:
     1531       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1532       if v-error-num > 0
     1533       then do:
     1534           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1535                                        , v-zip-file-name
     1536                                        , v-heap-file-name
     1537                                        , v-error-num
     1538                                        ) .
     1539       end.
     1540     end.
     1541     run gbl/del-file.p (input v-tmp-file-name) .
     1542     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1543     if error-status :error then do:
     1544       undo, return error substitute( "&1&2&3"
     1545                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1546                                     , chr(10)
     1547                                     , "Обратитесь к администратору."
     1548                                     ).
     1549     end.
     1550     run gbl/del-file.p (input v-exch-file-name) .
     1551     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1552     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1553     if v-error-num > 0
     1554     then do:
     1555       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1556                                     , v-zip-file-name
     1557                                     , v-exch-tmp-file-name
     1558                                     , v-error-num
     1559                                     ) .
     1560     end.
     1561     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1562     if v-error-num > 0
     1563     then do:
     1564       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1565                                     , v-exch-tmp-file-name
     1566                                     , v-exch-file-name
     1567                                     , v-error-num
     1568                                     ) .
     1569     end.
     1570     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1571   end.
     1572   else do:
     1573     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1574     if v-error-num > 0
     1575     then do:
     1576       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1577                                     , p-xml-file-name + "xm1"
     1578                                     , p-xml-file-name + "xml"
     1579                                     , v-error-num
     1580                                     ) .
     1581     end.
     1582   end.
     1583   if opsys = "unix"
     1584   then do:
     1585       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1586   end.
     1587   end.
     1588   end procedure.
     1589   procedure xml-bge-filename0:
     1590   define input parameter p-prefix   as character no-undo .
     1591   define input parameter p-name     as character no-undo .
     1592   define input parameter p-shared-process as logical no-undo .
     1593   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1594   define output parameter p-xml-file-name  as character no-undo .
     1595   // define output parameter p-fullfnamenoext as character no-undo .
     1596   define output parameter p-locked         as logical      no-undo.
     1597   define variable v-fullfnamenoext as character no-undo .
     1598   define variable v-fileext        as character no-undo .
     1599   define variable v-fullfname      as character no-undo .
     1600   define variable v-error-num      as integer   no-undo .
     1601   do
     1602   on error undo, return error
     1603   :
     1604     case v-bge-xml-bgeflold :
     1605       when "old" then do:
     1606         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1607         v-fileext       = ".xml":U .
     1608         v-fullfname     = v-fullfnamenoext + v-fileext .
     1609         p-xml-file-name = v-fullfname .
     1610         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1611         if v-error-num > 0 then do:
     1612           return error.
     1613         end.
     1614       end.
     1615       when "var" then do:
     1616         case p-prefix :
     1617           when "doc" then do:
     1618             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1619             v-fileext       = ".xml":U .
     1620             v-fullfname     = v-fullfnamenoext + v-fileext .
     1621             p-xml-file-name = v-fullfname .
     1622           end.
     1623           when "day" then do:
     1624             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1625             v-fileext       = ".xml":U .
     1626             v-fullfname     = v-fullfnamenoext + v-fileext .
     1627             p-xml-file-name = v-fullfname .
     1628           end.
     1629           otherwise do:
     1630             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1631             v-fileext       = ".xml":U .
     1632             v-fullfname     = v-fullfnamenoext + v-fileext .
     1633             p-xml-file-name = v-fullfname .
     1634           end.
     1635         end case.
     1636         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1637         if v-error-num > 0 then do:
     1638           return error.
     1639         end.
     1640       end.
     1641       when "new" then do:
     1642                   run bge/genfname.p (
     1643                       input p-home-dir
     1644                       , input p-prefix
     1645                       , input ""
     1646                       , input "xml"
     1647                       , input ""
     1648                       , output p-xml-file-name
     1649                   ).
     1650       end.
     1651       when "no-parameter" then do:
     1652         if p-shared-process then do:
     1653                       run bge/genfname.p (
     1654                           input p-home-dir
     1655                           , input "d"
     1656                           , input ""
     1657                           , input "xml"
     1658                           , input ""
     1659                           , output p-xml-file-name
     1660                       ).
     1661         end.
     1662         else do:
     1663           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1664           v-fileext       = ".xml":U .
     1665           v-fullfname     = v-fullfnamenoext + v-fileext .
     1666           p-xml-file-name = v-fullfname .
     1667           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1668           if v-error-num > 0 then do:
     1669             return error.
     1670           end.
     1671         end.
     1672       end.
     1673     end case.
     1674     assign
     1675       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1676       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1677     .
     1678   end .
     1679   end procedure .
     1680   procedure xml-bge-filename :
     1681   do
     1682   on error undo, return error
     1683   :
     1684   define input parameter p-prefix             as character    no-undo.
     1685   define input parameter p-name               as character    no-undo.
     1686   define input parameter p-shared-process     as logical      no-undo.
     1687   define output parameter p-xml-file-name     as character    no-undo.
     1688   define output parameter p-log-file-name     as character    no-undo.
     1689   define output parameter p-locked            as logical      no-undo.
     1690   define variable v-home-dir          as character no-undo .
     1691   define variable v-error-num         as integer   no-undo .
     1692   define variable v-bge-xml-heap-dir  as character no-undo .
     1693       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1694       if v-home-dir = ?
     1695       then do:
     1696           message
     1697             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1698             skip(1)
     1699             skip "Обратитесь к администратору."
     1700           view-as alert-box error.
     1701           undo, return error .
     1702       end.
     1703       if v-bge-xml-bgeflold <> "oracle"
     1704       then do:
     1705         assign
     1706             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1707         .
     1708       end.
     1709       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1710       if error-status :error
     1711       then do:
     1712           message
     1713             skip "Неверно задан каталог экспорта."
     1714             skip(1)
     1715             skip "Обратитесь к администратору."
     1716           view-as alert-box error.
     1717           undo, return error .
     1718       end.
     1719       if v-bge-xml-bgefmt = "dbf":U
     1720       then do:
     1721           assign
     1722               p-xml-file-name = v-home-dir
     1723               p-locked        = no
     1724           .
     1725       end.
     1726       else do:
     1727           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1728             output p-xml-file-name, output p-locked) .
     1729       end.
     1730       if v-bge-xml-bgeflold = "oracle"
     1731       then do:
     1732         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1733         if v-bge-xml-heap-dir = ?
     1734         then do:
     1735           undo, return error substitute( "&1&2&3"
     1736                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1737                                         , chr(10)
     1738                                         , "Обратитесь к администратору.":u
     1739                                         ).
     1740         end.
     1741         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1742         if error-status :error
     1743         then do:
     1744           undo, return error substitute( "&1&2&3"
     1745                                         , "Неверно задан каталог экспорта (heap).":u
     1746                                         , chr(10)
     1747                                         , "Обратитесь к администратору.":u
     1748                                         ).
     1749         end.
     1750         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1751           assign
     1752             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1753           .
     1754         end.
     1755         else do:
     1756           assign
     1757             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1758           .
     1759         end.
     1760       end.
     1761       else do:
     1762         assign
     1763             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1764         .
     1765       end.
     1766       assign
     1767          v-bge-xml-static-log-file-name = p-log-file-name
     1768       .
     1769   end.
     1770   end procedure.
     1771   procedure bge-xml-read-config :
     1772   do
     1773   on error undo, return error return-value
     1774   :
     1775   define input  parameter p-last-date as date      no-undo .
     1776   define input  parameter p-db-num    as integer   no-undo .
     1777       define variable v-bgeclall      as character     no-undo.
     1778       define variable v-bgedict       as character     no-undo.
     1779       define variable v-bgeshift      as character     no-undo.
     1780       define variable v-par-type      as character     no-undo.
     1781       define variable v-bgeflnm       as character     no-undo.
     1782       define variable v-bgecliiv      as character     no-undo .
     1783       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1784       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1785       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1786       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1787       define variable v-db-num-str    as character     no-undo .
     1788       define variable v-param-type      as character  no-undo .
     1789       define variable v-value-character as character  no-undo .
     1790       define variable v-value-date      as date       no-undo .
     1791       define variable v-value-decimal   as decimal    no-undo .
     1792       define variable v-value-integer   as integer    no-undo .
     1793       define variable v-value-logical   as logical    no-undo .
     1794       define variable v-tth             as handle      no-undo .
     1795       run adm/shattri.p ( input "get":U
     1796                         , input  '':u
     1797                         , input  0
     1798                         , input  'bge-export':U
     1799                         , input  'bgeclall':U
     1800                         , output v-bgecliiv
     1801                         , output v-value-date
     1802                         , output v-value-decimal
     1803                         , output v-value-integer
     1804                         , output v-value-logical
     1805                         , output v-param-type
     1806                         , input-output table-handle v-tth
     1807                         ) no-error .
     1808       if error-status :error
     1809       then do:
     1810         assign
     1811           v-bge-xml-bgecliiv = no
     1812         .
     1813       end.
     1814       else do:
     1815         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1816       end.
     1817       delete object v-tth.
     1818       assign
     1819           v-bge-xml-bgeclall = no
     1820           v-bge-xml-bgedict  = no
     1821       .
     1822       run adm/shattri.p ( input "get":U
     1823                         , input  '':u
     1824                         , input  0
     1825                         , input  'bge-export':U
     1826                         , input  'bgeclall':U
     1827                         , output v-value-character
     1828                         , output v-value-date
     1829                         , output v-value-decimal
     1830                         , output v-value-integer
     1831                         , output v-value-logical
     1832                         , output v-param-type
     1833                         , input-output table-handle v-tth
     1834                         ) no-error .
     1835       if error-status :error
     1836       then do:
     1837         assign
     1838           v-bge-xml-bgeclall = no
     1839         .
     1840       end.
     1841       else do:
     1842         assign
     1843           v-bge-xml-bgeclall = v-value-logical
     1844         .
     1845       end.
     1846       delete object v-tth.
     1847       run adm/shattri.p ( input "get":U
     1848                         , input  '':u
     1849                         , input  0
     1850                         , input  'bge-export':U
     1851                         , input  'bgedict':U
     1852                         , output v-value-character
     1853                         , output v-value-date
     1854                         , output v-value-decimal
     1855                         , output v-value-integer
     1856                         , output v-value-logical
     1857                         , output v-param-type
     1858                         , input-output table-handle v-tth
     1859                         ) no-error .
     1860       if error-status :error
     1861       then do:
     1862         assign
     1863           v-bge-xml-bgedict = no
     1864         .
     1865       end.
     1866       else do:
     1867         assign
     1868           v-bge-xml-bgedict = v-value-logical
     1869         .
     1870       end.
     1871       delete object v-tth.
     1872       run adm/shattri.p ( input "get":U
     1873                         , input  '':u
     1874                         , input  0
     1875                         , input  'bge-export':U
     1876                         , input  'bgefmt':U
     1877                         , output v-value-character
     1878                         , output v-value-date
     1879                         , output v-value-decimal
     1880                         , output v-value-integer
     1881                         , output v-value-logical
     1882                         , output v-param-type
     1883                         , input-output table-handle v-tth
     1884                         ) no-error .
     1885       if error-status :error
     1886       then do:
     1887         assign
     1888           v-bge-xml-bgefmt  = "xml":U
     1889         .
     1890       end.
     1891       else do:
     1892         assign
     1893           v-bge-xml-bgefmt  = v-value-character
     1894         .
     1895       end.
     1896       delete object v-tth.
     1897       run adm/shattri.p ( input "get":U
     1898                         , input  '':u
     1899                         , input  0
     1900                         , input  'bge-export':U
     1901                         , input  'bgeshift':U
     1902                         , output v-value-character
     1903                         , output v-value-date
     1904                         , output v-value-decimal
     1905                         , output v-value-integer
     1906                         , output v-value-logical
     1907                         , output v-param-type
     1908                         , input-output table-handle v-tth
     1909                         ) no-error .
     1910       if error-status :error
     1911       then do:
     1912         assign
     1913             v-bge-xml-shift-mode = no
     1914         .
     1915       end.
     1916       else do:
     1917         assign
     1918             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1919         .
     1920       end.
     1921       delete object v-tth.
     1922       run adm/shattri.p ( input "get":U
     1923                         , input  '':u
     1924                         , input  0
     1925                         , input  'bge-export':U
     1926                         , input  'bgeflold':U
     1927                         , output v-value-character
     1928                         , output v-value-date
     1929                         , output v-value-decimal
     1930                         , output v-value-integer
     1931                         , output v-value-logical
     1932                         , output v-param-type
     1933                         , input-output table-handle v-tth
     1934                         ) no-error .
     1935       if error-status :error
     1936       then do:
     1937         assign
     1938           v-bge-xml-bgeflold = "no-parameter":U
     1939         .
     1940       end.
     1941       else do:
     1942         assign
     1943           v-bge-xml-bgeflold  = v-value-character
     1944         .
     1945       end.
     1946       delete object v-tth.
     1947       assign
     1948         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1949         v-bge-xml-db-num-str  = v-db-num-str
     1950       .
     1951       if p-last-date <> ?
     1952       then do:
     1953           run adm/shattri.p ( input "get":U
     1954                             , input  '':u
     1955                             , input  0
     1956                             , input  'bge-export':U
     1957                             , input  'bgeflnm':U
     1958                             , output v-value-character
     1959                             , output v-value-date
     1960                             , output v-value-decimal
     1961                             , output v-value-integer
     1962                             , output v-value-logical
     1963                             , output v-param-type
     1964                             , input-output table-handle v-tth
     1965                             ) no-error .
     1966           if error-status :error
     1967           then do:
     1968             assign
     1969               v-bgeflnm = '':U
     1970             .
     1971           end.
     1972           else do:
     1973             assign
     1974               v-bgeflnm = v-value-character
     1975             .
     1976           end.
     1977           delete object v-tth.
     1978           if v-bge-xml-bgeflold = "var"
     1979           then do:
     1980               if v-bgeflnm = ?
     1981               or num-entries( v-bgeflnm ) < 2
     1982               then do:
     1983                   assign
     1984                       v-bge-xml-bgeflold = "new"
     1985                   .
     1986               end.
     1987               else do:
     1988                   assign
     1989                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1990                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1991                   .
     1992                   assign
     1993                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1994                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1995                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1996                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1997                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1998                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1999                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2000                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2001                   .
     2002               end.
     2003           end.
     2004       end.
     2005   end.
     2006   end procedure.
     2007   procedure bge-xml-get-ref-filename :
     2008   define input parameter p-in-file-name       as character        no-undo.
     2009   define output parameter p-home-dir          as character        no-undo.
     2010   define output parameter p-out-file-name     as character        no-undo.
     2011   define output parameter p-locked            as logical          no-undo.
     2012       define variable v-counter       as integer      no-undo.
     2013       define variable v-error-level   as integer      no-undo.
     2014   do
     2015   on error undo, return error
     2016   :
     2017       run bge/bge-ini.p (
     2018             input "bge"
     2019           , output p-home-dir
     2020       ).
     2021       if return-value <> "OK"
     2022       then do:
     2023           undo, return error.
     2024       end.
     2025       assign
     2026           p-home-dir = p-home-dir + "\dict":U
     2027       .
     2028       run bge/dir_cd.p (
     2029           input p-home-dir
     2030           , input "CA"
     2031       ).
     2032       if return-value = "ERROR"
     2033       then do:
     2034           undo, return error.
     2035       end.
     2036       assign
     2037           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2038       .
     2039       assign
     2040           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2041       .
     2042       wait-lock:
     2043       do v-counter = 1 TO 3
     2044       :
     2045           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2046           if p-locked = no
     2047           then do:
     2048               leave wait-lock.
     2049           end.
     2050           else do:
     2051               readkey pause 1.
     2052           end.
     2053       END.
     2054       if p-locked = yes
     2055       then do:
     2056           undo, return error.
     2057       end.
     2058       run bge/os_copy.p (
     2059             input "D":U
     2060           , input p-out-file-name + "xml":U
     2061           , input "":U
     2062           , output v-error-level
     2063       ).
     2064       if v-error-level > 0
     2065       then do:
     2066           undo, return error.
     2067       end.
     2068   end.
     2069   end procedure.
     2070   procedure bge-xml-write-ref-header :
     2071   define input parameter p-bge-name as character        no-undo.
     2072   define input parameter p-file-name as character        no-undo.
     2073       define variable v-out-string    as character    no-undo.
     2074   do
     2075   on error undo, return error
     2076   :
     2077       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2078       put stream stmXMLOut unformatted
     2079           "<?xml version='1.0' encoding='windows-1251'?>":U
     2080       .
     2081       assign
     2082           v-out-string = substitute( "&1&2"
     2083                               , chr(10)
     2084                               , "<IBS_Trade_House>":U )
     2085       .
     2086       put stream stmXMLOut unformatted
     2087           v-out-string
     2088       .
     2089       run wp-XMLTagOpen( 1, "header", "" ).
     2090       if v-bge-xml-bgeflold = "oracle":u
     2091       then do:
     2092         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2093         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2094         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2095         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2096         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2097       end.
     2098       else do:
     2099         run wp-XMLTagOpen( 2, "delivery", "" ).
     2100         run wp-XMLTagOpen( 3, "to", "" ).
     2101         run wp-XMLTagClose( 3, "to" ).
     2102         run wp-XMLTagOpen( 3, "from", "" ).
     2103         run wp-XMLTagClose( 3, "from" ).
     2104         run wp-XMLTagClose( 2, "delivery" ).
     2105       end.
     2106       run wp-XMLTagOpen( 2, "manifest", "" ).
     2107       run wp-XMLTagOpen( 3, "document", "" ).
     2108       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2109       run wp-XMLTagPut( 4, "description", "", 0 ).
     2110       run wp-XMLTagClose( 3, "document" ).
     2111       run wp-XMLTagClose( 2, "manifest" ).
     2112       run wp-XMLTagClose( 1, "header" ).
     2113       run wp-XMLTagOpen( 1, "body", "" ).
     2114   end.
     2115   end procedure.
     2116   procedure bge-xml-write-ref-footer :
     2117   define input parameter p-file-name as character        no-undo.
     2118       define variable v-error-level   as integer      no-undo.
     2119   do
     2120   on error undo, return error
     2121   :
     2122       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2123       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2124       output stream stmXMLOut close.
     2125       run bge/os_copy.p (
     2126             input "M":U
     2127           , input p-file-name + "xm1":U
     2128           , input p-file-name + "xml":U
     2129           , output v-error-level
     2130       ).
     2131       if v-error-level > 0
     2132       then do:
     2133           undo, return error.
     2134       end.
     2135   end.
     2136   end procedure.
     2137   procedure bge-xml-out-dir :
     2138   define output parameter p-out-dir       as character    no-undo.
     2139   define output parameter p-log-file-name as character    no-undo.
     2140   do
     2141   on error undo, return error
     2142   :
     2143       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2144       if p-out-dir = ?
     2145       then do:
     2146           message
     2147             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2148                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2149             skip(1)
     2150             skip "Обратитесь к администратору."
     2151           view-as alert-box error.
     2152           undo, return error .
     2153       end.
     2154       if v-bge-xml-bgeflold <> "oracle" then assign
     2155         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2156       .
     2157       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2158       if error-status :error  then do:
     2159           run wp-XMLWriteLog in this-procedure (
     2160                 input p-log-file-name
     2161               , input 0
     2162               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2163                                   , p-out-dir
     2164                                   , return-value
     2165                                   , trim( error-status :get-message( 1 ) )
     2166                                   )
     2167           ).
     2168           undo, return error.
     2169       end.
     2170       assign
     2171           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2172           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2173       .
     2174   end.
     2175   end procedure.
     2176   procedure bge-xml-out-dir2 :
     2177   define output parameter p-out-dir       as character    no-undo.
     2178   define output parameter p-out-dirR      as character    no-undo.
     2179   define output parameter p-log-file-name as character    no-undo.
     2180   do
     2181   on error undo, return error
     2182   :
     2183       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2184       if p-out-dir = ?
     2185       then do:
     2186           message
     2187             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2188                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2189             skip(1)
     2190             skip "Обратитесь к администратору."
     2191           view-as alert-box error.
     2192           undo, return error .
     2193       end.
     2194       if v-bge-xml-bgeflold <> "oracle" then assign
     2195             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2196             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2197         .
     2198       else p-out-dirR = p-out-dir .
     2199       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2200       if error-status :error  then do:
     2201           run wp-XMLWriteLog in this-procedure (
     2202                 input p-log-file-name
     2203               , input 0
     2204               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2205                                   , p-out-dir
     2206                                   , return-value
     2207                                   , error-status :get-message( 1 )
     2208                                   )
     2209           ).
     2210           undo, return error.
     2211       end.
     2212       if p-out-dirR <> p-out-dir then do:
     2213         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2214         if error-status :error then do:
     2215           run wp-XMLWriteLog in this-procedure (
     2216                 input p-log-file-name
     2217               , input 0
     2218               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2219                                   , p-out-dirR
     2220                                   , return-value
     2221                                   , error-status :get-message( 1 )
     2222                                   )
     2223           ).
     2224           p-out-dirR = p-out-dir .
     2225         end.
     2226       end .
     2227       assign
     2228         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2229         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2230       .
     2231   end.
     2232   end procedure.
     2233   procedure bge-xml-out-file :
     2234   do
     2235   on error undo, return error
     2236   :
     2237   define input parameter p-out-dir            as character        no-undo.
     2238   define input parameter p-prefix             as character        no-undo.
     2239   define input parameter p-sheduled           as logical          no-undo.
     2240   define output parameter p-xml-file-name     as character        no-undo.
     2241   define output parameter p-locked            as logical          no-undo.
     2242   define variable v-home-dir      as character     no-undo.
     2243   define variable v-error-num     as integer       no-undo.
     2244   define variable v-today             as date         no-undo.
     2245   define variable v-time              as integer      no-undo.
     2246       if v-bge-xml-bgefmt = "dbf":U
     2247       then do:
     2248           assign
     2249               p-xml-file-name = p-out-dir
     2250               p-locked        = no
     2251           .
     2252       end.
     2253       else do:
     2254           if v-bge-xml-bgeflold = "firm":U
     2255           then do:
     2256               run bge/genfname.p (
     2257                     input p-out-dir
     2258                   , input p-prefix
     2259                   , input "":U
     2260                   , input "arj":U
     2261                   , input "":U
     2262                   , output p-xml-file-name
     2263               ).
     2264           end.
     2265           else do:
     2266               run bge/genfname.p (
     2267                     input p-out-dir
     2268                   , input p-prefix
     2269                   , input "":U
     2270                   , input "xml":U
     2271                   , input "":U
     2272                   , output p-xml-file-name
     2273               ).
     2274           end.
     2275           assign
     2276               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2277               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2278           .
     2279       end.
     2280   end.
     2281   end procedure.
     2282   procedure bge-xml-init-ext-doc-type :
     2283       define variable v-counter    as integer      no-undo.
     2284       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2285   do
     2286   for buf_temp_ext-doc-type
     2287   on error undo, return error
     2288   :
     2289       empty temp-table buf_temp_ext-doc-type.
     2290       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2291       :
     2292           create buf_temp_ext-doc-type.
     2293           assign
     2294               buf_temp_ext-doc-type.edt-key               = v-counter
     2295               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2296               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2297           .
     2298       end.
     2299   end.
     2300   end procedure.
     2301   procedure bge-xml-get-decimal-shift-num :
     2302   define input parameter p-shift-date     as date             no-undo.
     2303   define input parameter p-shift-num      as integer          no-undo.
     2304   define output parameter p-shift-decimal as decimal          no-undo.
     2305   do
     2306   on error undo, return error
     2307   :
     2308       assign
     2309           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2310       .
     2311   end.
     2312   end procedure.
     2313   procedure bge-xml-ora-exp-filename :
     2314     define input  parameter p-table-name  as character no-undo .
     2315     define input  parameter p-doc-code    as character no-undo .
     2316     define input  parameter p-obj-code    as integer   no-undo .
     2317     define output parameter p-filename    as character no-undo .
     2318     define output parameter p-seq-num     as integer   no-undo .
     2319     define variable v-ora-exp-seq     as integer   no-undo .
     2320     define variable v-ora-exp-seq-str as character no-undo .
     2321     define variable v-home-dir        as character no-undo.
     2322   do
     2323   on error undo, return error return-value
     2324   :
     2325     if v-bge-xml-bgeflold = "oracle":u
     2326     then do:
     2327       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2328       if v-home-dir = ?
     2329       then do:
     2330         undo, return error substitute( "&1&2&3":U
     2331                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2332                                       , chr(10)
     2333                                       , "Обратитесь к администратору.":U
     2334                                       ).
     2335       end.
     2336       assign
     2337           v-home-dir = v-home-dir
     2338       .
     2339       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2340       if error-status :error
     2341       then do:
     2342         undo, return error substitute( "&1&2&3":U
     2343                                       , "Неверно задан каталог экспорта.":U
     2344                                       , chr(10)
     2345                                       , "Обратитесь к администратору.":U
     2346                                       ).
     2347       end.
     2348       assign
     2349         v-ora-exp-seq = ?
     2350       .
     2351       if  p-table-name <> ? and
     2352           p-doc-code <> ?
     2353       then do:
     2354         run bge/get-oesq.p ( input p-table-name
     2355                            , input p-doc-code
     2356                            , output v-ora-exp-seq
     2357                            ) no-error .
     2358         if error-status :error = yes
     2359         then do:
     2360           undo, return error return-value .
     2361         end.
     2362       end.
     2363       if v-ora-exp-seq = ?
     2364       then do:
     2365         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2366         if error-status :error
     2367         then do:
     2368           undo, return error return-value .
     2369         end.
     2370       end.
     2371       if p-table-name <> ? and
     2372          p-doc-code   <> ?
     2373       then do:
     2374         run bge/oesqdoc.p ( input p-table-name
     2375                           , input p-doc-code
     2376                           , input v-ora-exp-seq
     2377                           ) no-error .
     2378         if error-status :error = yes
     2379         then do:
     2380           undo, return error return-value .
     2381         end.
     2382       end.
     2383       assign
     2384         p-seq-num  = v-ora-exp-seq
     2385         p-filename = substitute("&1/&2-000_&3."
     2386                                , v-home-dir
     2387                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2388                                , string(v-ora-exp-seq , "999999999")
     2389                                )
     2390       .
     2391     end.
     2392   end.
     2393   end procedure.
     2394   procedure bge-xml-date-to-str :
     2395     define input  parameter p-date  as date      no-undo .
     2396     define output parameter p-str   as character no-undo .
     2397   do
     2398   on error undo, return error return-value
     2399   :
     2400     if p-date <> ?
     2401     then do:
     2402       assign
     2403         p-str = substitute( "&1-&2-&3"
     2404                           , string( year(p-date)  , "9999")
     2405                           , string( month(p-date) , "99"  )
     2406                           , string( day(p-date)   , "99"  )
     2407                           )
     2408       .
     2409     end.
     2410     else do:
     2411       assign
     2412         p-str = ?
     2413       .
     2414     end.
     2415   end.
     2416   end procedure.
     2417   procedure bge-xml-date-str-to-str :
     2418     define input  parameter p-date-str  as character no-undo .
     2419     define output parameter p-str       as character no-undo .
     2420     define variable v-date          as date      no-undo .
     2421     define variable v-date-valid    as logical   no-undo .
     2422     define variable v-error-message as character no-undo .
     2423   do
     2424   on error undo, return error return-value
     2425   :
     2426     assign
     2427       p-str = ?
     2428     .
     2429     if p-date-str = ? or p-date-str = ""
     2430     then do:
     2431       return .
     2432     end.
     2433     run strtdate in this-procedure ( input  p-date-str
     2434                                    , output v-date
     2435                                    , output v-date-valid
     2436                                    , output v-error-message
     2437                                    ).
     2438     if v-date-valid <> true
     2439     then do:
     2440       return .
     2441     end.
     2442     assign
     2443       p-str = substitute( "&1-&2-&3"
     2444                         , string( year(v-date)  , "9999")
     2445                         , string( month(v-date) , "99"  )
     2446                         , string( day(v-date)   , "99"  )
     2447                         )
     2448     .
     2449   end.
     2450   end procedure.
     2451   procedure bge-xml-fill-tt-bgecliiv :
     2452     define input  parameter p-str as character no-undo .
     2453     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2454     define buffer buf_clients             for ub.clients.
     2455     define variable v-i         as integer   no-undo .
     2456     define variable v-count     as integer   no-undo .
     2457     define variable v-cli-count as integer   no-undo .
     2458     define variable v-client    as character no-undo .
     2459     define variable v-obj-type  as character no-undo .
     2460     define variable v-obj-code  as integer   no-undo .
     2461   do
     2462   on error undo, return error return-value
     2463   :
     2464     empty temp-table buf_tt-bge-xml-bgecliiv.
     2465     assign
     2466       v-bge-xml-bgecliiv = no
     2467       v-cli-count        = num-entries(p-str,';')
     2468     .
     2469     if v-cli-count > 0
     2470     then do:
     2471       _cli-cycle:
     2472       do v-i = 1 to v-cli-count
     2473       :
     2474         assign
     2475           v-client = entry(v-i , p-str, ';')
     2476         .
     2477         if num-entries(v-client) <> 2
     2478         then do:
     2479           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2480         end.
     2481         assign
     2482           v-obj-type = entry(1, v-client)
     2483         .
     2484         assign
     2485           v-obj-code = integer(entry(2, v-client))
     2486         no-error .
     2487         if error-status :error
     2488         then do:
     2489           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2490         end.
     2491         find first buf_clients no-lock
     2492           where buf_clients.obj-type = v-obj-type
     2493             and buf_clients.obj-code = v-obj-code
     2494         no-error.
     2495         if not available buf_clients
     2496         then do:
     2497           next _cli-cycle.
     2498         end.
     2499         find first buf_tt-bge-xml-bgecliiv no-lock
     2500           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2501             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2502         no-error .
     2503         if available buf_tt-bge-xml-bgecliiv
     2504         then do:
     2505           next _cli-cycle.
     2506         end.
     2507         create buf_tt-bge-xml-bgecliiv.
     2508         assign
     2509           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2510           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2511         .
     2512       end.
     2513     end.
     2514     else do:
     2515       assign
     2516         v-bge-xml-bgecliiv = no
     2517       .
     2518       return .
     2519     end.
     2520     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2521     if available buf_tt-bge-xml-bgecliiv
     2522     then do:
     2523       assign
     2524         v-bge-xml-bgecliiv = yes
     2525       .
     2526     end.
     2527   end.
     2528   end procedure.
     2529   procedure bge-xml-resolve-ext-doc-type :
     2530     define input  parameter p-ext-doc-type      as character no-undo .
     2531     define input  parameter p-obj-type          as character no-undo .
     2532     define input  parameter p-obj-code          as integer   no-undo .
     2533     define output parameter p-out-ext-doc-type  as character no-undo .
     2534     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2535   do
     2536   on error undo, return error return-value
     2537   :
     2538     assign
     2539       p-out-ext-doc-type = p-ext-doc-type
     2540     .
     2541     if p-ext-doc-type <> 'ie':U
     2542     then do:
     2543       return .
     2544     end.
     2545     if v-bge-xml-bgecliiv = yes
     2546     then do:
     2547       find first buf_tt-bge-xml-bgecliiv no-lock
     2548         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2549           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2550       no-error .
     2551       if available buf_tt-bge-xml-bgecliiv
     2552       then do:
     2553         assign
     2554           p-out-ext-doc-type = 'iv':U
     2555         .
     2556       end.
     2557     end.
     2558   end.
     2559   end procedure.
     2560   procedure safe-wp-xmltagput :
     2561     define input  parameter pTagLevel   as integer   no-undo .
     2562     define input  parameter pTagName    as character no-undo .
     2563     define input  parameter pParValue   as character no-undo .
     2564     define input  parameter pFlagEmpty  as integer   no-undo .
     2565   do
     2566   on error undo, return error return-value
     2567   :
     2568     if v-bge-xml-bgeflold = "oracle":u
     2569     then do:
     2570       return .
     2571     end.
     2572     run wp-xmltagput in this-procedure ( input pTagLevel
     2573                                        , input pTagName
     2574                                        , input pParValue
     2575                                        , input pFlagEmpty
     2576                                        ).
     2577   end.
     2578   end procedure.
     2579   do
     2580   on error undo, return error
     2581   :
     2582       define variable v-xml-file-name     as character            no-undo.
     2583       define variable v-log-file-name     as character            no-undo.
     2584       define variable v-out-dir           as character            no-undo.
     2585       define variable v-locked            as logical              no-undo.
     2586       define variable v-log-string        as character            no-undo.
     2587       define variable v-oper-num          as integer              no-undo.
     2588       define variable v-fact-order-from   like ub.fin-doc.fact-order no-undo.
     2589       define variable v-fact-order-to     like ub.fin-doc.fact-order no-undo.
     2590       define variable v-docs-exists       as logical              no-undo.
     2591       define variable v-obj-counter       as integer              no-undo.
     2592       define variable v-today             as date                 no-undo.
     2593       define variable v-time              as integer              no-undo.
     2594       define variable v-obj-type          as character            no-undo.
     2595       define variable v-obj-code          as integer              no-undo.
     2596       define variable v-host-code         as integer              no-undo.
     2597       define variable v-host-str          as character            no-undo init "" .
     2598       define buffer buf_temp_fin-doc-code        for temp_fin-doc-code.
     2599       define buffer buf_temp_del-fin-doc-code    for temp_del-fin-doc-code.
     2600       run cur-time in this-procedure (
     2601             output v-today
     2602           , output v-time
     2603       ).
     2604       run bge-xml-out-dir in this-procedure ( output v-out-dir
     2605                                             , output v-log-file-name
     2606                                             ).
     2607       run bge-xml-read-config in this-procedure ( input v-today
     2608                                                 , input p-db-num
     2609                                                 ) no-error.
     2610       if error-status :error
     2611       then do:
     2612           run wp-XMLWriteLog in this-procedure (
     2613                 input v-log-file-name
     2614               , input 1
     2615               , input substitute( "Ошибка чтения параметров экспорта. &1. &2. Для экспорта данных будут приняты параметры по умолчанию."
     2616                                   , return-value, trim( error-status :get-message( 1 ) ) )
     2617           ).
     2618       end.
     2619       run xml-bge-filename in this-procedure (
     2620             input "findoc"
     2621           , input "finDocument"
     2622           , input yes
     2623           , output v-xml-file-name
     2624           , output v-log-file-name
     2625           , output v-locked
     2626       ).
     2627       if v-locked = yes
     2628       then do:
     2629           run wp-XMLWriteLog in this-procedure (
     2630               input v-log-file-name
     2631               , input 1
     2632               , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2633           ).
     2634           undo, return error .
     2635       end.
     2636       run wp-XMLWriteLog in this-procedure (
     2637               input v-log-file-name
     2638           , input 1
     2639           , input substitute( "Начало выгрузки в файл &1", replace( v-xml-file-name, "/", "\" ) + "xm1" )
     2640       ).
     2641       run wp-XMLWriteLog in this-procedure (
     2642               input v-log-file-name
     2643           , input 1
     2644           , input substitute( "................с параметрами: Номер базы: &1.", p-db-num )
     2645       ).
     2646       run wp-XMLWriteLog in this-procedure (
     2647           input v-log-file-name
     2648           , input 1
     2649           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     2650       ).
     2651       CASE p-range:
     2652         when 1 then do:
     2653           run init-temphost.
     2654           assign
     2655               v-log-string = " по всем фирмам"
     2656           .
     2657         end.
     2658         when 2 then do:
     2659           for each temp-host:
     2660             delete temp-host.
     2661           end.
     2662           create temp-host.
     2663           assign
     2664           temp-host.host-code = p-host-code
     2665           no-error .
     2666           if error-status:error
     2667           or not can-find(first ub.sysconf no-lock where ub.sysconf.host-code = temp-host.host-code)
     2668           then do:
     2669             run wp-XMLWriteLog in this-procedure (
     2670                 input v-log-file-name
     2671                 , input 1
     2672                 , input substitute("Не найдена фирма &1", p-host-code)
     2673             ).
     2674             undo, return error .
     2675           end.
     2676           assign
     2677               v-log-string = substitute(" по фирме: &1", p-host-code)
     2678           .
     2679         end.
     2680         when 3 then do:
     2681           for each temp-host:
     2682             delete temp-host.
     2683           end.
     2684           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2  :
     2685             assign
     2686             v-obj-type = entry( (v-obj-counter * 2 ) - 1 , p-obj-list )     .
     2687             v-obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )  .
     2688             create temp-obj.
     2689             assign
     2690             temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     2691             temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     2692             no-error .
     2693   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2694   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2695     (input  v-obj-type
     2696     ,input  v-obj-code
     2697     ,output v-host-code
     2698     ) no-error .
     2699             if error-status :error  then do:
     2700                 run wp-XMLWriteLog in this-procedure (
     2701                     input v-log-file-name
     2702                     , input 1
     2703                     , input "Не найдена фирма для объекта" + v-obj-type + string( v-obj-code )
     2704                 ).
     2705                 undo, return error .
     2706             end.
     2707             if not can-find ( first temp-host where temp-host.host-code = v-host-code) then do:
     2708               v-host-str = v-host-str + "," + string(v-host-code).
     2709               create temp-host.
     2710               assign
     2711                 temp-host.host-code = v-host-code
     2712               no-error .
     2713               if error-status :error  then do:
     2714                   run wp-XMLWriteLog in this-procedure ( input v-log-file-name
     2715                                                        , input 1
     2716                                                        , input substitute( "Ошибка чтения списка объектов. &1&2&1&3&1&4"
     2717                                                                          , chr(10)
     2718                                                                          , return-value
     2719                                                                          , trim(error-status :get-message(1))
     2720                                                                          , trim(error-status :get-message(2))
     2721                                                                          )
     2722                                                        ).
     2723                   undo, return error return-value .
     2724               end.
     2725             end.
     2726           end.
     2727           assign
     2728           v-log-string = ", по объектам: " + p-obj-list
     2729           .
     2730         end.
     2731       END CASE.
     2732       run bge-xml-write-header in this-procedure (
     2733             input v-xml-file-name
     2734           , input v-xml-file-name + "xml"
     2735           , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2736           , input p-db-num
     2737           , input ?
     2738           , input 0
     2739           , input ?
     2740           , input 0
     2741           , input p-obj-list
     2742           , input "":U
     2743           , input no
     2744           , input no
     2745           , input no
     2746           , input no
     2747           , input no
     2748           , input no
     2749           , input yes
     2750           , input no
     2751       ) no-error.
     2752       if error-status :error
     2753       then do:
     2754           run wp-XMLWriteLog in this-procedure (
     2755                 input v-log-file-name
     2756               , input 1
     2757               , input substitute( "*** Ошибка записи шапки файла. Процедура: &1 (v.&2 &3). &4. &5"
     2758                                   , vss-workfile
     2759                                   , vss-revision
     2760                                   , vss-description
     2761                                   , return-value
     2762                                   , trim( error-status :get-message( 1 ) )
     2763                                   )
     2764           ).
     2765           undo, return error.
     2766       end.
     2767       host-of-list:
     2768       for each temp-host
     2769       :
     2770           run export-docs-by-host in this-procedure (
     2771                 input temp-host.host-code
     2772           ) no-error.
     2773           if error-status :error
     2774           then do:
     2775               run wp-XMLWriteLog in this-procedure (
     2776                   input v-log-file-name
     2777                   , input 1
     2778                   , input "Ошибка экспорта платежей по фирме " + string( temp-host.host-code )
     2779               ).
     2780               next host-of-list.
     2781           end.
     2782       end.
     2783       run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     2784       for each buf_temp_fin-doc-code
     2785       on error undo, return error
     2786       :
     2787           run bge/setbgefd.p (
     2788                 input "fin-doc":U
     2789               , input buf_temp_fin-doc-code.host-code
     2790               , input buf_temp_fin-doc-code.fin-doc-code
     2791               , input 0
     2792               , input 0
     2793               , input v-today
     2794           ).
     2795       end.
     2796       for each buf_temp_del-fin-doc-code
     2797       on error undo, return error
     2798       :
     2799           run bge/setbgefd.p (
     2800                 input "c-fin-doc":U
     2801               , input buf_temp_del-fin-doc-code.host-code
     2802               , input buf_temp_del-fin-doc-code.fin-doc-code
     2803               , input buf_temp_del-fin-doc-code.corr-user-db-num
     2804               , input buf_temp_del-fin-doc-code.chip-num
     2805               , input v-today
     2806           ).
     2807       end.
     2808       run wp-XMLWriteLog in this-procedure (
     2809             input v-log-file-name
     2810           , input 1
     2811           , input substitute( "Данные выгружены в файл &1 " , replace( v-xml-file-name, "/", "\" ) + "xml" )
     2812       ).
     2813   end.
     2814   procedure export-docs-by-host :
     2815   do
     2816   on error undo, return error
     2817   :
     2818   define input parameter p-host-code  as integer      no-undo.
     2819       define variable v-start-date    as date         no-undo.
     2820       define variable v-not-exists    as logical      no-undo.
     2821       run wp-XMLWriteLog in this-procedure (
     2822             input v-log-file-name
     2823           , input 1
     2824           , input " > Экспорт платежей по фирме " +  string( p-host-code )
     2825       ).
     2826       run get-start-date in this-procedure (
     2827             input p-host-code
     2828           , output v-start-date
     2829           , output v-not-exists
     2830       ).
     2831       if v-not-exists = yes
     2832       then do:
     2833           run wp-XMLWriteLog in this-procedure (
     2834                 input v-log-file-name
     2835               , input 2
     2836               , input "Нет платежей выгрузки. Невозможно выгрузить данные по платежам."
     2837           ).
     2838           undo, return error .
     2839       end.
     2840       run bge/fdocincr.p (
     2841             input p-range
     2842           , input p-db-num
     2843           , input p-obj-list
     2844           , input p-host-code
     2845           , input v-today
     2846           , input v-start-date
     2847           , input v-xml-file-name
     2848           , input v-log-file-name
     2849           , input this-procedure :handle
     2850           , input ?
     2851           , input ?
     2852       ) no-error.
     2853       if error-status :error
     2854       then do:
     2855           run wp-XMLWriteLog in this-procedure (
     2856                 input v-log-file-name
     2857               , input 1
     2858               , input substitute( "*** Ошибка экспорта платежей. &1. &2", return-value, trim(error-status :get-message(1)) )
     2859           ).
     2860       end.
     2861       run wp-XMLWriteLog in this-procedure (
     2862             input v-log-file-name
     2863           , input 1
     2864           , input substitute( " < Экспорт платежей по фирме &1 завершен.", p-host-code )
     2865       ).
     2866   end.
     2867   end procedure.
     2868   procedure get-start-date :
     2869   do
     2870   on error undo, return error
     2871   :
     2872   define input parameter p-host-code       as integer      no-undo.
     2873   define output parameter p-start-date    as date         no-undo.
     2874   define output parameter p-not-exist     as logical      no-undo init yes.
     2875       define buffer buf_fin-doc       for ub.fin-doc.
     2876       find-first-fin-doc:
     2877       for each buf_fin-doc no-lock
     2878          where buf_fin-doc.host-code = p-host-code
     2879       :
     2880           if buf_fin-doc.fact-date <> ?
     2881           then do:
     2882               assign
     2883                   p-not-exist     = no
     2884                   p-start-date    = buf_fin-doc.fact-date
     2885               .
     2886               leave find-first-fin-doc.
     2887           end.
     2888       end.
     2889   end.
     2890   end procedure.
     2891   procedure fill-temp-fin-doc-code :
     2892   do
     2893   on error undo, return error
     2894   :
     2895   define input parameter p-host-code   as integer    no-undo.
     2896   define input parameter p-fin-doc-code   as integer    no-undo.
     2897   define input parameter p-corr-user-db-num as integer no-undo .
     2898   define input parameter p-chip-num         as integer no-undo .
     2899       define buffer buf_temp_fin-doc-code     for temp_fin-doc-code.
     2900       create buf_temp_fin-doc-code.
     2901       assign
     2902       buf_temp_fin-doc-code.host-code    = p-host-code
     2903       buf_temp_fin-doc-code.fin-doc-code = p-fin-doc-code
     2904       .
     2905   end.
     2906   end procedure.
     2907   procedure fill-temp-del-fin-doc-code :
     2908   do
     2909   on error undo, return error
     2910   :
     2911   define input parameter p-host-code   as integer    no-undo.
     2912   define input parameter p-fin-doc-code   as integer  no-undo.
     2913   define input parameter p-corr-user-db-num as integer no-undo .
     2914   define input parameter p-chip-num         as integer no-undo .
     2915   define buffer buf_temp_del-fin-doc-code     for temp_del-fin-doc-code.
     2916       create buf_temp_del-fin-doc-code.
     2917       assign
     2918       buf_temp_del-fin-doc-code.host-code        = p-host-code
     2919       buf_temp_del-fin-doc-code.fin-doc-code     = p-fin-doc-code
     2920       buf_temp_del-fin-doc-code.corr-user-db-num = p-corr-user-db-num
     2921       buf_temp_del-fin-doc-code.chip-num         = p-chip-num
     2922       .
     2923   end.
     2924   end procedure.
