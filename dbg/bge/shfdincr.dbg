      647                           .
      648                       end.
      649                       when chr(29)
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + " ":U
      653                           .
      654                       end.
      655                       when chr(10)
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + " ":U
      659                           .
      660                       end.
      661                       when chr(13)
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + " ":U
      665                           .
      666                       end.
      667                       otherwise do:
      668                           assign
      669                               p-out-string = p-out-string + v-current-char
      670                           .
      671                       end.
      672                   end case.
      673               end.
      674           end.
      675       end case.
      676   end.
      677   end .
      678   procedure xmlchar-decode :
      679   define input parameter p-in-string      as character        no-undo.
      680   define output parameter p-out-string    as character        no-undo.
      681       define variable v-position      as integer      no-undo.
      682       define variable v-last-position as integer      no-undo.
      683       define variable v-temp-integer  as integer      no-undo.
      684       define variable v-current-char  as character    no-undo.
      685       define variable v-next-char     as character    no-undo.
      686       define variable v-success       as logical      no-undo.
      687   do
      688   on error undo, return error
      689   :
      690       assign
      691           p-out-string = "":U
      692           v-position   = 0
      693       .
      694       replace-cycle:
      695       do while yes
      696       on error undo, return error
      697       :
      698           assign
      699               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      700           .
      701           if v-last-position <= v-position
      702           then do:
      703               if v-position = 0
      704               then do:
      705                   assign
      706                       p-out-string = p-in-string
      707                   .
      708               end.
      709               else do:
      710                   assign
      711                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      712                   .
      713               end.
      714               leave replace-cycle.
      715           end.
      716           else do:
      717               assign
      718                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      719                   v-position      = v-last-position
      720                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      721               .
      722               if v-current-char = "#":U
      723               then do:
      724                   assign
      725                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      726                   .
      727                   if v-last-position > 0
      728                   then do:
      729                       run xmlchar-read-integer in this-procedure
      730                        (
      731                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      732                           , output v-temp-integer
      733                           , output v-success
      734                       ).
      735                       if v-success = yes
      736                       and v-temp-integer >= 1
      737                       and v-temp-integer <= 255
      738                       then do:
      739                           assign
      740                               p-out-string = p-out-string + chr( v-temp-integer )
      741                               v-position   = v-last-position + 1
      742                           .
      743                       end.
      744                       else do:
      745                           assign
      746                               p-out-string = p-out-string + "&":U
      747                               v-position   = v-position   + 1
      748                           .
      749                       end.
      750                   end.
      751                   else do:
      752                       assign
      753                           p-out-string = p-out-string + "&":U
      754                           v-position   = v-position   + 1
      755                       .
      756                   end.
      757               end.
      758               else do:
      759                   case substring( p-in-string, v-position + 1, 3 )
      760                   :
      761                       when "lt;":U
      762                       then do:
      763                           assign
      764                               p-out-string = p-out-string + "<":U
      765                               v-position   = v-position   + 3
      766                           .
      767                       end.
      768                       when "gt;":U
      769                       then do:
      770                           assign
      771                               p-out-string = p-out-string + ">":U
      772                               v-position   = v-position   + 3
      773                           .
      774                       end.
      775                       otherwise do:
      776                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      777                           then do:
      778                               assign
      779                                   p-out-string = p-out-string + "&":U
      780                                   v-position   = v-position   + 4
      781                               .
      782                           end.
      783                           else do:
      784                               case substring( p-in-string, v-position + 1, 5 )
      785                               :
      786                                   when "quot;":U
      787                                   then do:
      788                                       assign
      789                                           p-out-string = p-out-string + '"':U
      790                                           v-position   = v-position   + 5
      791                                       .
      792                                   end.
      793                                   when "apos;":U
      794                                   then do:
      795                                       assign
      796                                           p-out-string = p-out-string + "'":U
      797                                           v-position   = v-position   + 5
      798                                       .
      799                                   end.
      800                                   otherwise do:
      801                                       assign
      802                                           p-out-string = p-out-string + "&":U
      803                                       .
      804                                   end.
      805                               end case.
      806                           end.
      807                       end.
      808                   end case.
      809               end.
      810           end.
      811       end.
      812   end.
      813   end .
      814   procedure xmlchar-read-integer :
      815   define input parameter p-input-string      as character        no-undo.
      816   define output parameter p-output-integer   as integer          no-undo.
      817   define output parameter p-success       as logical          no-undo.
      818   do
      819   on error undo, return error
      820   :
      821       assign
      822           p-output-integer = integer( p-input-string )
      823       no-error.
      824       if error-status :error
      825       then do:
      826           assign
      827               p-success           = no
      828               p-output-integer    = 0
      829           .
      830       end.
      831       else do:
      832           assign
      833               p-success           = yes
      834           .
      835       end.
      836   end.
      837   end.
      838   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      839   procedure strtdate :
      840     define input  parameter p-str         as character no-undo .
      841     define output parameter p-value       as date      no-undo .
      842     define output parameter p-data-valid  as logical   no-undo .
      843     define output parameter p-message     as character no-undo .
      844   do
      845   on error undo, return error return-value
      846   :
      847     define variable v-value       as date      no-undo .
      848     define variable v-i           as integer   no-undo .
      849     define variable v-num         as integer   no-undo .
      850     define variable v-delim       as character no-undo .
      851     define variable v-delim-list  as character no-undo .
      852     define variable v-day         as integer   no-undo .
      853     define variable v-month       as integer   no-undo .
      854     define variable v-year        as integer   no-undo .
      855     define variable v-day-str     as character no-undo .
      856     define variable v-month-str   as character no-undo .
      857     define variable v-year-str    as character no-undo .
      858     assign
      859       p-value       = ?
      860       p-data-valid  = false
      861     .
      862     if p-str = ?
      863     then do:
      864       assign
      865         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      866       .
      867       return .
      868     end.
      869     if p-str = ""
      870     then do:
      871       assign
      872         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      873       .
      874       return .
      875     end.
      876     if length(p-str)  > 10
      877     then do:
      878       assign
      879         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      880       .
      881       return .
      882     end.
      883     assign
      884       v-delim-list = '/,-,.':U
      885     .
      886     _delim:
      887     do v-i = 1 to num-entries( v-delim-list )
      888     :
      889       assign
      890         v-delim = entry( v-i , v-delim-list )
      891         v-num   = num-entries( p-str , v-delim )
      892       .
      893       if v-num <> 3
      894       then do:
      895         assign
      896           v-delim = ''
      897         .
      898       end.
      899       else do:
      900         leave _delim.
      901       end.
      902     end.
      903     if v-delim = ''
      904     then do:
      905       assign
      906         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      907       .
      908       return .
      909     end.
      910     assign
      911       v-day-str   = entry( 1, p-str , v-delim)
      912       v-month-str = entry( 2, p-str , v-delim)
      913       v-year-str  = entry( 3, p-str , v-delim)
      914     .
      915     if  length(v-day-str) > 2   or
      916         length(v-day-str) < 1   or
      917         length(v-month-str) > 2 or
      918         length(v-month-str) < 1 or
      919         (
      920           length(v-year-str) <> 2 and
      921           length(v-year-str) <> 4
      922         )
      923     then do:
      924       assign
      925         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      926       .
      927       return .
      928     end.
      929     if length( v-year-str ) = 2
      930     then do:
      931       assign
      932         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      933       .
      934     end.
      935     assign
      936       v-day   = integer( v-day-str )
      937       v-month = integer( v-month-str)
      938       v-year  = integer( v-year-str)
      939     no-error .
      940     if error-status :error
      941     then do:
      942       assign
      943         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      944       .
      945       return .
      946     end.
      947     if v-day < 1  or
      948        v-day > 31 or
      949        v-month < 1 or
      950        v-month > 12 or
      951        v-year < 0   or
      952        v-year > 5000
      953     then do:
      954       assign
      955         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      956       .
      957       return .
      958     end.
      959     assign
      960       v-value = date( v-month, v-day, v-year )
      961     no-error .
      962     if error-status :error
      963     then do:
      964       assign
      965         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      966       .
      967       return .
      968     end.
      969     assign
      970       p-value       = v-value
      971       p-data-valid  = true
      972     .
      973   end.
      974   end procedure.
      975   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      976   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      977   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
