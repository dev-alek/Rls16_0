        1   block-level on error undo, throw.
        2   define input parameter p-db-num         as integer    no-undo.
        3   define input parameter p-range          as integer    no-undo.
        4   define input parameter p-host-code      as integer    no-undo .
        5   define input parameter p-obj-list       as character  no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: shfdincr.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: bge/shfdincr.p $":U .
       11   define variable vss-description as character no-undo init "Инкрементальный экспорт во Внешнюю Бухгалтерию платежей".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define new shared temp-table temp-host no-undo
       83     field host-code like ub.store.host-code
       84     index xpk host-code
       85   .
       86   define new shared temp-table temp-obj no-undo
       87     field obj-type  like ub.clients.obj-type
       88     field obj-code  like ub.clients.obj-code
       89     field host-code like ub.store.host-code
       90     field db-num    like ub.clients.db-num
       91     index xpk  obj-type obj-code
       92     index xie1 host-code
       93     index xie2 db-num host-code
       94   .
       95   procedure init-temphost:
       96     define buffer buf_store   for ub.store .
       97     define buffer buf_shop    for ub.shop .
       98     define buffer buf_clients for ub.clients .
       99     define buffer buf_db for ub.db .
      100     define buffer buf_temp-host for temp-host .
      101     define buffer buf_temp-obj for temp-obj .
      102     do
      103     on error undo, return error return-value
      104     :
      105       for each buf_store
      106       on error undo, return error
      107       :
      108         find first buf_temp-host
      109           where buf_temp-host.host-code = buf_store.host-code
      110           no-error .
      111         if not available buf_temp-host
      112         then do:
      113           create buf_temp-host .
      114           assign
      115             buf_temp-host.host-code = buf_store.host-code
      116           .
      117         end.
      118         find first buf_clients no-lock
      119           where buf_clients.obj-type = 'скл':U
      120             and buf_clients.obj-code = buf_store.obj-code
      121           no-error .
      122         if not available buf_clients
      123         then do:
      124           message
      125             "Ошибка при поиске клиента" skip
      126             "Клиент" 'скл':U buf_store.obj-code skip
      127             view-as alert-box error .
      128           undo, return error .
      129         end.
      130         create buf_temp-obj .
      131         assign
      132           buf_temp-obj.obj-type  = 'скл':U
      133           buf_temp-obj.obj-code  = buf_store.obj-code
      134           buf_temp-obj.host-code = buf_store.host-code
      135           buf_temp-obj.db-num    = buf_clients.db-num
      136         .
      137       end.
      138       for each buf_shop
      139       on error undo, return error
      140       :
      141         find first buf_temp-host
      142           where buf_temp-host.host-code = buf_shop.host-code
      143           no-error .
      144         if not available buf_temp-host
      145         then do:
      146           create buf_temp-host .
      147           assign
      148             buf_temp-host.host-code = buf_shop.host-code
      149           .
      150         end.
      151         find first buf_clients no-lock
      152           where buf_clients.obj-type = 'маг':U
      153             and buf_clients.obj-code = buf_shop.obj-code
      154           no-error .
      155         if not available buf_clients then do:
      156           message
      157             "Ошибка при поиске клиента" skip
      158             "Клиент" 'маг':U buf_shop.obj-code skip
      159             view-as alert-box error .
      160           undo, return error .
      161         end.
      162         create buf_temp-obj .
      163         assign
      164           buf_temp-obj.obj-type  = 'маг':U
      165           buf_temp-obj.obj-code  = buf_shop.obj-code
      166           buf_temp-obj.host-code = buf_shop.host-code
      167           buf_temp-obj.db-num    = buf_clients.db-num
      168         .
      169       end.
      170     end.
      171   end.
      172   define variable vss-include-info1 as character format "X(65)" no-undo
      173   initial "@(#)$Workfile$ $Revision$".
      174   DEF STREAM stmXMLOut.
      175   DEF STREAM stmXMLLog.
      176   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   procedure cur-time :
      178      define output parameter p-today as date      no-undo .
      179      define output parameter p-time  as integer   no-undo .
      180     do
      181     on error undo, return error
      182     :
      183       define variable v-date1 as date      no-undo .
      184       define variable v-date2 as date      no-undo .
      185       define variable v-time  as integer   no-undo .
      186       assign
      187         v-date1 = today
      188         v-time  = time
      189         v-date2 = today
      190       .
      191       if v-date1 <> v-date2
      192       then do:
      193         assign
      194           v-date1 = today
      195           v-time  = v-time
      196         .
      197       end.
      198       assign
      199         p-today = v-date1
      200         p-time  = v-time
      201       .
      202     end.
      203   end.
      204   function cur-time-date returns character
      205   :
      206     return string(today, '99/99/9999':U) .
      207   end.
      208   function cur-time-mjd returns decimal
      209   :
      210     define variable v-date as date      no-undo .
      211     define variable v-time as integer   no-undo .
      212     run cur-time in this-procedure
      213       (output v-date
      214       ,output v-time
      215       ) .
      216     return integer(v-date) - 2400002 + (v-time / 86400) .
      217   end.
      218   function cur-time-get-ending-index returns integer
      219   (input p-number as integer
      220   )
      221   :
      222     if p-number < 0
      223     or p-number = ?
      224     then do:
      225       return 1 .
      226     end.
      227     define variable v-rest as integer   no-undo .
      228     assign
      229       p-number = p-number modulo 100
      230     .
      231     if p-number < 20
      232     then do:
      233       assign
      234         v-rest = p-number
      235       .
      236     end.
      237     else do:
      238       assign
      239         v-rest = p-number modulo 10
      240       .
      241     end.
      242     case v-rest :
      243       when 1
      244       then do:
      245         return 2 .
      246       end.
      247       when 2 or
      248       when 3 or
      249       when 4
      250       then do:
      251         return 3 .
      252       end.
      253       otherwise do:
      254         return 1 .
      255       end.
      256     end case .
      257   end.
      258   procedure cur-time-mjd-to-date :
      259      define input  parameter i-mjd-diff as decimal no-undo.
      260      define output parameter o-Date     as date    no-undo.
      261      define output parameter o-Time     as integer no-undo.
      262      define variable v-day-number as integer   no-undo .
      263      if    i-mjd-diff < 0
      264         or i-mjd-diff = ?
      265      then do:
      266         return "?" .
      267      end.
      268      assign
      269         v-day-number = truncate(i-mjd-diff,0).
      270         o-Date = date(v-day-number + 2400002).
      271         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      272     .
      273   end.
      274   function cur-time-mjd-to-string returns character
      275   (input p-mjd-diff as decimal
      276   )
      277   :
      278     define variable v-day-number as integer   no-undo .
      279     define variable v-seconds    as integer   no-undo .
      280     define variable v-hour       as integer   no-undo .
      281     define variable v-min        as integer   no-undo .
      282     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      283     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      284     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      285     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      286     if p-mjd-diff < 0
      287     or p-mjd-diff = ?
      288     then do:
      289       return "?" .
      290     end.
      291     assign
      292       v-day-number = integer(truncate(p-mjd-diff,0))
      293       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      294     .
      295     if v-seconds > 86400
      296     then do:
      297       assign
      298         v-seconds = 86400 - 1
      299       .
      300     end.
      301     if v-seconds < 0
      302     then do:
      303       assign
      304         v-seconds = 0
      305       .
      306     end.
      307     assign
      308       v-hour = truncate(v-seconds / 3600, 0)
      309     .
      310     assign
      311       v-seconds = v-seconds modulo 3600
      312     .
      313     assign
      314       v-min = truncate(v-seconds / 60, 0)
      315     .
      316     assign
      317       v-seconds = v-seconds modulo 60
      318     .
      319     return
      320         (if v-day-number <> 0
      321           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      322           else ""
      323         )
      324       + (if v-day-number <> 0 or v-hour <> 0
      325           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      326           else ""
      327         )
      328       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      329           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      330           else ""
      331         )
      332       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      333       .
      334   end.
      335   function cur-time-string returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-string-sec returns character
      346   :
      347     define variable v-date as date      no-undo .
      348     define variable v-time as integer   no-undo .
      349     run cur-time in this-procedure
      350       (output v-date
      351       ,output v-time
      352       ) .
      353     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      354   end.
      355   function cur-time-custom  returns character
      356   (input p-prefix as character
      357   ,input p-date-format as character
      358   ,input p-delimiter as character
      359   ,input p-time-format as character
      360   ,input p-suffix as character
      361   )
      362   :
      363     define variable v-date as date      no-undo .
      364     define variable v-time as integer   no-undo .
      365     run cur-time in this-procedure
      366       (output v-date
      367       ,output v-time
      368       ) .
      369     return
      370       p-prefix
      371       + string(v-date, p-date-format)
      372       + p-delimiter
      373       + string(v-time, p-time-format)
      374       + p-suffix
      375       .
      376   end.
      377   function cur-time-print  returns character
      378   :
      379     define variable v-date as date      no-undo .
      380     define variable v-time as integer   no-undo .
      381     run cur-time in this-procedure
      382       (output v-date
      383       ,output v-time
      384       ) .
      385     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      386   end.
      387   function cur-time-datetime returns datetime
      388   :
      389     define variable v-char as character no-undo .
      390     define variable v-datetime as datetime no-undo .
      391     v-char = cur-time-string().
      392     v-datetime = datetime(v-char).
      393     return  v-datetime.
      394   end.
      395   function cur-time-string-msec returns character
      396   :
      397     define variable v-date as datetime  no-undo .
      398     v-date = now.
      399     return string(v-date) .
      400   end.
      401   define variable vss-include-info3 as character format "X(65)" no-undo
      402   initial "@(#)$Workfile$ $Revision$".
      403   procedure xmlchar-test :
      404   define input parameter p-in-string          as character        no-undo.
      405   define output parameter p-out-string-enc    as character        no-undo.
      406   define output parameter p-out-string-dec    as character        no-undo.
      407   do
      408   on error undo, return error
      409   :
      410          run xmlchar-encode in this-procedure
      411       (
      412             input p-in-string
      413           , output p-out-string-enc
      414       ).
      415          run xmlchar-decode in this-procedure
      416       (
      417             input p-out-string-enc
      418           , output p-out-string-dec
      419       ).
      420   end.
      421   end .
      422   procedure xmlchar-encode :
      423   define input parameter p-in-string      as character        no-undo.
      424   define output parameter p-out-string    as character        no-undo.
      425       define variable v-position      as integer      no-undo.
      426       define variable v-current-char  as character    no-undo.
      427   do
      428   on error undo, return error
      429   :
      430       assign
      431           p-out-string = "":U
      432       .
      433       case p-in-string
      434       :
      435           when ?
      436           then do:
      437               assign
      438                   p-out-string = "?":U
      439               .
      440           end.
      441           when "?":U
      442           then do:
      443               assign
      444                   p-out-string = "&#63;":U
      445               .
      446           end.
      447           otherwise do:
      448               do v-position = 1 to length( p-in-string )
      449               :
      450                   assign
      451                       v-current-char = substring( p-in-string, v-position, 1 )
      452                   .
      453                   case v-current-char
      454                   :
      455                       when "&":U
      456                       then do:
      457                           assign
      458                               p-out-string = p-out-string + "&amp;":U
      459                           .
      460                       end.
      461                       when ">":U
      462                       then do:
      463                           assign
      464                               p-out-string = p-out-string + "&gt;":U
      465                           .
      466                       end.
      467                       when "<":U
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "&lt;":U
      471                           .
      472                       end.
      473                       when "'":U
      474                       then do:
      475                           assign
      476                               p-out-string = p-out-string + "&apos;":U
      477                           .
      478                       end.
      479                       when '"':U
      480                       then do:
      481                           assign
      482                               p-out-string = p-out-string + "&quot;":U
      483                           .
      484                       end.
      485                       when chr(1)
      486                       then do:
      487                           assign
      488                               p-out-string = p-out-string + "":U
      489                           .
      490                       end.
      491                       when chr(2)
      492                       then do:
      493                           assign
      494                               p-out-string = p-out-string + "":U
      495                           .
      496                       end.
      497                       when chr(3)
      498                       then do:
      499                           assign
      500                               p-out-string = p-out-string + "":U
      501                           .
      502                       end.
      503                       when chr(4)
      504                       then do:
      505                           assign
      506                               p-out-string = p-out-string + "":U
      507                           .
      508                       end.
      509                       when chr(5)
      510                       then do:
      511                           assign
      512                               p-out-string = p-out-string + "":U
      513                           .
      514                       end.
      515                       when chr(6)
      516                       then do:
      517                           assign
      518                               p-out-string = p-out-string + "":U
      519                           .
      520                       end.
      521                       when chr(7)
      522                       then do:
      523                           assign
      524                               p-out-string = p-out-string + "":U
      525                           .
      526                       end.
      527                       when chr(8)
      528                       then do:
      529                           assign
      530                               p-out-string = p-out-string + "":U
      531                           .
      532                       end.
      533                       when chr(9)
      534                       then do:
      535                           assign
      536                               p-out-string = p-out-string + "":U
      537                           .
      538                       end.
      539                       when chr(29)
      540                       then do:
      541                           assign
      542                               p-out-string = p-out-string + "":U
      543                           .
      544                       end.
      545                       when chr(10)
      546                       then do:
      547                           assign
      548                               p-out-string = p-out-string + "&#10;":U
      549                           .
      550                       end.
      551                       when chr(13)
      552                       then do:
      553                           assign
      554                               p-out-string = p-out-string + "&#13;":U
      555                           .
      556                       end.
      557                       otherwise do:
      558                           assign
      559                               p-out-string = p-out-string + v-current-char
      560                           .
      561                       end.
      562                   end case.
      563               end.
      564           end.
      565       end case.
      566   end.
      567   end .
      568   procedure xmlchar-encode-1c :
      569   define input parameter p-in-string      as character        no-undo.
