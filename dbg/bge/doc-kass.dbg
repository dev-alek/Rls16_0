      894   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      895   define variable v-bge-xml-log-file-name as character    no-undo.
      896   define variable v-bge-xml-dbf-file-name as character    no-undo.
      897   define variable v-bge-xml-db-num-str    as character    no-undo .
      898   define variable v-bge-xml-static-log-file-name as character    no-undo.
