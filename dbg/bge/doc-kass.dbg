      987   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      988                                             INPUT iFlagEmpty AS INTEGER).
      989       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      990       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      991           DO:
      992               IF iFlagEmpty = 0                           THEN RETURN "".
      993               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      994               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      995               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      996               ELSE RETURN "".
      997           END.
      998       ELSE DO:
      999           run xmlchar-encode in this-procedure (
     1000                 input sToPlace
     1001               , output sToPlace
     1002           ).
     1003           ASSIGN
     1004               sToPlace = sParName + '="' + sToPlace + '"'
     1005           .
     1006           RETURN sToPlace.
     1007       END.
     1008   END FUNCTION.
     1009   function bge-xml-date returns character
     1010   ( input p-date as date )
     1011   :
     1012     define variable v-date-str as character no-undo .
     1013     run bge-xml-date-to-str in this-procedure ( input   p-date
     1014                                               , output  v-date-str
     1015                                               ) .
     1016     return v-date-str.
     1017   end function.
     1018   function bge-xml-str-date returns character
     1019   ( input p-date-str as character )
     1020   :
     1021     define variable v-date-str as character no-undo .
     1022     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1023                                                   , output  v-date-str
     1024                                                   ) .
     1025     return v-date-str.
     1026   end function.
     1027   function bge-xml-normalize-dec returns decimal
     1028   ( input p-val as decimal )
     1029   :
     1030     return (if p-val = ? then 0 else p-val) .
     1031   end function.
     1032   PROCEDURE wp-XMLTagOpen:
     1033   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1034   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1035   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1036       define variable v-out-string    as character    no-undo.
     1037   do
     1038   on error undo, return error
     1039   :
     1040       if v-bge-xml-bgefmt = "dbf":U
     1041       then do:
     1042       end.
     1043       else do:
     1044           assign
     1045               v-out-string = substitute( "&1&2<&3&4>"
     1046                                       , chr(10)
     1047                                       , fill( " ":U, 4 * iTagLevel)
     1048                                       , sTagName
     1049                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1050                               )
     1051           .
     1052           put stream stmXMLOut unformatted
     1053               v-out-string
     1054           .
     1055       end.
     1056   end.
     1057   END PROCEDURE.
     1058   PROCEDURE wp-XMLTagPut:
     1059     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1060     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1061     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1062     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1063       define variable v-out-string    as character    no-undo.
     1064   do
     1065   on error undo, return error
     1066   :
     1067       if v-bge-xml-bgefmt = "dbf":U
     1068       then do:
     1069           if v-bge-xml-dbf-file-name <> "":U
     1070           then do:
     1071               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1072               export stream stmXMLOut
     1073                   sTagName
     1074                   sParValue
     1075               .
     1076               output stream stmXMLOut close.
     1077           end.
     1078       end.
     1079       else do:
     1080           IF  iFlagEmpty = 1
     1081           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1082           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1083           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1084           THEN DO:
     1085               run xmlchar-encode in this-procedure (
     1086                   input sParValue
     1087                   , output sParValue
     1088               ).
     1089               assign
     1090                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1091                                               , chr(10)
     1092                                               , FILL(" ", 4 * iTagLevel)
     1093                                               , sTagName
     1094                                               , sParValue
     1095                               )
     1096               .
     1097               PUT STREAM stmXMLOut UNFORMATTED
     1098                   v-out-string
     1099               .
     1100           END.
     1101       end.
     1102   end.
     1103   END PROCEDURE.
     1104   PROCEDURE wp-XMLTagClose:
     1105   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1106   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1107       define variable v-out-string    as character    no-undo.
     1108   do
     1109   on error undo, return error
     1110   :
     1111       if v-bge-xml-bgefmt = "dbf":U
     1112       then do:
     1113       end.
     1114       else do:
     1115           assign
     1116               v-out-string = substitute( "&1&2</&3>"
     1117                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1118                                   , fill( " ", 4 * iTagLevel )
     1119                                   , sTagName
     1120                           )
     1121           .
     1122           PUT STREAM stmXMLOut UNFORMATTED
     1123               v-out-string
     1124           .
     1125       end.
     1126   end.
     1127   END PROCEDURE.
     1128   PROCEDURE wp-XMLWriteLog:
     1129     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1130     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1131     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1132   define variable v-str              as character no-undo .
     1133   define variable v-error-append     as logical   no-undo .
     1134   define variable v-error-append-msg as character no-undo .
     1135   assign
     1136     v-str = chr(10)
     1137             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1138             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1139     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1140     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1141     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1142   .
     1143   run bge/bge-log.p (input v-str) no-error .
     1144   if error-status:error then do:
     1145     assign
     1146       v-error-append     = yes
     1147       v-error-append-msg = return-value
     1148     .
     1149   end.
     1150   run gbl/fileapnd.p
     1151     ( input sFileName
     1152     , input v-str
     1153     , input 10
     1154     ) no-error .
     1155   if error-status:error then do:
     1156     assign
     1157       v-error-append     = yes
     1158       v-error-append-msg = substitute( "&1&2&3"
     1159                                       , v-error-append-msg
     1160                                       , chr(10)
     1161                                       , return-value
     1162                                       )
     1163     .
     1164   end.
     1165   if v-error-append
     1166   then do:
     1167     return error substitute( "&1" , v-error-append-msg ) .
     1168   end.
     1169   END PROCEDURE.
     1170   PROCEDURE wp-XMLWriteEDT:
     1171     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1172     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1173     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1174       if valid-handle ( hEDT )
     1175       then do:
     1176           hEDT :move-to-eof().
     1177           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1178                                           OR sToWrite = "&Line") THEN "" ELSE
     1179                                           cur-time-string-sec() + " ").
     1180           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1181                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1182                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1183           hEDT :insert-string(chr(10)).
     1184       end.
     1185       process events.
     1186       output to 'bgescn.txt' append.
     1187           put unformatted
     1188               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1189                                           OR sToWrite = "&Line") THEN "" ELSE
     1190                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1191               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1192                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1193                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1194           .
     1195       output close.
     1196   END PROCEDURE.
     1197   PROCEDURE wp-XMLShowCNT:
     1198     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1199       if valid-handle( hCNT )
     1200       then do:
     1201           ASSIGN hCNT :VISIBLE = TRUE.
     1202       end.
     1203   END PROCEDURE.
     1204   PROCEDURE wp-XMLHideCNT:
     1205     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1206       if valid-handle( hCNT )
     1207       then do:
     1208           ASSIGN hCNT :VISIBLE = FALSE.
     1209       end.
     1210   END PROCEDURE.
     1211   PROCEDURE wp-XMLWriteCNT:
     1212     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1213     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1214       if valid-handle( hCNT )
     1215       then do:
     1216           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1217       end.
     1218   END PROCEDURE.
     1219   procedure bge-xml-write-header:
     1220   do
     1221   on error undo, return error
     1222   :
     1223   define input parameter p-xml-file-name  as character        no-undo.
     1224   define input parameter p-doc-name       as character        no-undo.
     1225   define input parameter p-version        as character        no-undo.
     1226   define input parameter p-db-num         as integer          no-undo.
     1227   define input parameter p-date-from      as date             no-undo.
     1228   define input parameter p-shift-num-from as integer          no-undo.
     1229   define input parameter p-date-to        as date             no-undo.
     1230   define input parameter p-shift-num-to   as integer          no-undo.
     1231   define input parameter p-obj-list       as character        no-undo.
     1232   define input parameter p-doc-type-list  as character        no-undo.
     1233   define input parameter p-pay-code       as logical          no-undo.
     1234   define input parameter p-cst            as logical          no-undo.
     1235   define input parameter p-parts          as logical          no-undo.
     1236   define input parameter p-chk-pay-code   as logical          no-undo.
     1237   define input parameter p-pay-desk       as logical          no-undo.
     1238   define input parameter p-pay-desk-cards as logical          no-undo.
     1239   define input parameter p-deleted        as logical          no-undo.
     1240   define input parameter p-opened-docs    as logical          no-undo.
     1241   define variable v-out-string    as character    no-undo.
     1242   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1243   assign
     1244       v-out-string = substitute( "&1&2&3"
     1245                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1246                           , chr(10)
     1247                           , "<IBS_Trade_House>":U )
     1248   .
     1249   put stream stmXMLOut unformatted
     1250       v-out-string
     1251   .
     1252   run wp-XMLTagOpen(1, "header","").
     1253   if v-bge-xml-bgeflold = "oracle":u
     1254   then do:
     1255     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1256     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1257     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1258     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1259     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1260   end.
     1261   run wp-XMLTagOpen( 2, "manifest", "").
     1262   run wp-XMLTagOpen( 3, "document", "").
     1263   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1264   run wp-XMLTagput( 4, "description", "", 0).
     1265   run wp-XMLTagput( 4, "version", p-version, 0).
     1266   run wp-XMLTagclose( 3, "document" ).
     1267   run wp-XMLTagclose( 2, "manifest" ).
     1268   run wp-XMLTagclose( 1, "header" ).
     1269   run wp-XMLTagOpen(1, "options","").
     1270   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1271   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1272   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1273   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1274   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1275   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1276   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1277   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1278   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1279   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1280   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1281   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1282   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1283   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1284   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1285   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1286   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1287   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1288   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1289   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1290   run wp-XMLTagClose(1, "options").
     1291   run wp-XMLTagOpen( 1, "body", "" ).
     1292   output stream stmXMLOut close.
     1293   end.
     1294   end procedure.
     1295   procedure xml-bge-write-footer:
     1296   do
     1297   on error undo, return error return-value
     1298   :
     1299   define input parameter p-xml-file-name as character    no-undo.
     1300   define variable v-error-num     as integer           no-undo.
     1301   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1302   run wp-XMLTagClose( 1, "body" ).
     1303   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1304   output stream stmXMLOut close.
     1305   if v-bge-xml-bgeflold = "oracle":u
     1306   then do:
     1307     define variable v-tmp-file-name         as character no-undo .
     1308     define variable v-zip-file-name         as character no-undo .
     1309     define variable v-exch-file-name        as character no-undo .
     1310     define variable v-heap-file-name        as character no-undo .
     1311     define variable v-i                     as integer   no-undo .
     1312     define variable v-file-name             as character no-undo .
     1313     define variable v-arc                   as character no-undo .
     1314     define variable v-str                   as character no-undo .
     1315     define variable v-exch-tmp-file-name    as character no-undo .
     1316     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1317     define variable v-bge-xml-exch-dir      as character no-undo .
     1318     define variable v-bge-xml-heap-dir      as character no-undo .
     1319     define variable v-bge-xml-compress-heap as logical   no-undo .
     1320     define variable v-home-dir              as character no-undo .
     1321     define variable v-os-command            as character no-undo .
     1322     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1323     if v-home-dir = ?
     1324     then do:
     1325       undo, return error substitute( "&1&2&3"
     1326                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1327                                     , chr(10)
     1328                                     , "Обратитесь к администратору.":u
     1329                                     ).
     1330     end.
     1331     assign
     1332       v-home-dir = v-home-dir
     1333     .
     1334     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1335     if error-status :error
     1336     then do:
     1337       undo, return error substitute( "&1&2&3"
     1338                                     , "Неверно задан каталог экспорта.":u
     1339                                     , chr(10)
     1340                                     , "Обратитесь к администратору.":u
     1341                                     ).
     1342     end.
     1343     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1344     if v-bge-xml-exch-dir = ?
     1345     then do:
     1346       undo, return error substitute( "&1&2&3"
     1347                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1348                                     , chr(10)
     1349                                     , "Обратитесь к администратору.":u
     1350                                     ).
     1351     end.
     1352     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1353     if error-status :error
     1354     then do:
     1355       undo, return error substitute( "&1&2&3"
     1356                                     , "Неверно задан каталог экспорта (exch).":u
     1357                                     , chr(10)
     1358                                     , "Обратитесь к администратору.":u
     1359                                     ).
     1360     end.
     1361     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1362     if v-bge-xml-heap-dir = ?
     1363     then do:
     1364       undo, return error substitute( "&1&2&3"
     1365                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1366                                     , chr(10)
     1367                                     , "Обратитесь к администратору.":u
     1368                                     ).
     1369     end.
     1370     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1371     if error-status :error
     1372     then do:
     1373       undo, return error substitute( "&1&2&3"
     1374                                     , "Неверно задан каталог экспорта (heap).":u
     1375                                     , chr(10)
     1376                                     , "Обратитесь к администратору.":u
     1377                                     ).
     1378     end.
     1379     get-key-value section "BGE" key "heap-compress" value v-str.
     1380     assign
     1381       v-i = int(v-str)
     1382     no-error .
     1383     if v-i = ? or v-i = 0
     1384     then do:
     1385       assign
     1386         v-bge-xml-compress-heap = no
     1387       .
     1388     end.
     1389     else do:
     1390       assign
     1391         v-bge-xml-compress-heap = yes
     1392       .
     1393     end.
     1394     assign
     1395       v-arc = search( "exe/7za.exe":u )
     1396     .
     1397     if v-arc = ? or v-arc = ""
     1398     then do:
     1399       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1400     end.
     1401     assign
     1402       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1403       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1404       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1405       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1406       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1407       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1408       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1409     .
     1410     run gbl/del-file.p (input v-tmp-file-name) .
     1411     run gbl/del-file.p (input v-zip-file-name) .
     1412     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1413     if v-error-num > 0
     1414     then do:
     1415         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1416                                      , p-xml-file-name + "xm1":u
     1417                                      , v-tmp-file-name
     1418                                      , v-error-num
     1419                                      ).
     1420     end.
     1421     assign
     1422       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1423                                    , v-arc
     1424                                    , v-zip-file-name
     1425                                    , v-tmp-file-name
     1426                                    )
     1427     .
     1428     os-command silent value ( v-os-command ) .
     1429     run gbl/del-file.p (input v-heap-file-name) .
     1430     if v-bge-xml-compress-heap = no
     1431     then do:
     1432       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1433       if v-error-num > 0
     1434       then do:
     1435           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1436                                        , v-tmp-file-name
     1437                                        , v-heap-file-name
     1438                                        , v-error-num
     1439                                        ) .
     1440       end.
     1441     end.
     1442     else do:
     1443       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1444       if v-error-num > 0
     1445       then do:
     1446           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1447                                        , v-zip-file-name
     1448                                        , v-heap-file-name
     1449                                        , v-error-num
     1450                                        ) .
     1451       end.
     1452     end.
     1453     run gbl/del-file.p (input v-tmp-file-name) .
     1454     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1455     if error-status :error then do:
     1456       undo, return error substitute( "&1&2&3"
     1457                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1458                                     , chr(10)
     1459                                     , "Обратитесь к администратору."
     1460                                     ).
     1461     end.
     1462     run gbl/del-file.p (input v-exch-file-name) .
     1463     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1464     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1465     if v-error-num > 0
     1466     then do:
     1467       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1468                                     , v-zip-file-name
     1469                                     , v-exch-tmp-file-name
     1470                                     , v-error-num
     1471                                     ) .
     1472     end.
     1473     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1474     if v-error-num > 0
     1475     then do:
     1476       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1477                                     , v-exch-tmp-file-name
     1478                                     , v-exch-file-name
     1479                                     , v-error-num
     1480                                     ) .
     1481     end.
     1482     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1483   end.
     1484   else do:
     1485     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1486     if v-error-num > 0
     1487     then do:
     1488       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1489                                     , p-xml-file-name + "xm1"
     1490                                     , p-xml-file-name + "xml"
     1491                                     , v-error-num
     1492                                     ) .
     1493     end.
     1494   end.
     1495   if opsys = "unix"
     1496   then do:
     1497       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1498   end.
     1499   end.
     1500   end procedure.
     1501   procedure xml-bge-filename0:
     1502   define input parameter p-prefix   as character no-undo .
     1503   define input parameter p-name     as character no-undo .
     1504   define input parameter p-shared-process as logical no-undo .
     1505   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1506   define output parameter p-xml-file-name  as character no-undo .
     1507   // define output parameter p-fullfnamenoext as character no-undo .
     1508   define output parameter p-locked         as logical      no-undo.
     1509   define variable v-fullfnamenoext as character no-undo .
     1510   define variable v-fileext        as character no-undo .
     1511   define variable v-fullfname      as character no-undo .
     1512   define variable v-error-num      as integer   no-undo .
     1513   do
     1514   on error undo, return error
     1515   :
     1516     case v-bge-xml-bgeflold :
     1517       when "old" then do:
     1518         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1519         v-fileext       = ".xml":U .
     1520         v-fullfname     = v-fullfnamenoext + v-fileext .
     1521         p-xml-file-name = v-fullfname .
     1522         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1523         if v-error-num > 0 then do:
     1524           return error.
     1525         end.
     1526       end.
     1527       when "var" then do:
     1528         case p-prefix :
     1529           when "doc" then do:
     1530             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1531             v-fileext       = ".xml":U .
     1532             v-fullfname     = v-fullfnamenoext + v-fileext .
     1533             p-xml-file-name = v-fullfname .
     1534           end.
     1535           when "day" then do:
     1536             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1537             v-fileext       = ".xml":U .
     1538             v-fullfname     = v-fullfnamenoext + v-fileext .
     1539             p-xml-file-name = v-fullfname .
     1540           end.
     1541           otherwise do:
     1542             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1543             v-fileext       = ".xml":U .
     1544             v-fullfname     = v-fullfnamenoext + v-fileext .
     1545             p-xml-file-name = v-fullfname .
     1546           end.
     1547         end case.
     1548         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1549         if v-error-num > 0 then do:
     1550           return error.
     1551         end.
     1552       end.
     1553       when "new" then do:
     1554                   run bge/genfname.p (
     1555                       input p-home-dir
     1556                       , input p-prefix
     1557                       , input ""
     1558                       , input "xml"
     1559                       , input ""
     1560                       , output p-xml-file-name
     1561                   ).
     1562       end.
     1563       when "no-parameter" then do:
     1564         if p-shared-process then do:
     1565                       run bge/genfname.p (
     1566                           input p-home-dir
     1567                           , input "d"
     1568                           , input ""
     1569                           , input "xml"
     1570                           , input ""
     1571                           , output p-xml-file-name
     1572                       ).
     1573         end.
     1574         else do:
     1575           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1576           v-fileext       = ".xml":U .
     1577           v-fullfname     = v-fullfnamenoext + v-fileext .
     1578           p-xml-file-name = v-fullfname .
     1579           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1580           if v-error-num > 0 then do:
     1581             return error.
     1582           end.
     1583         end.
     1584       end.
     1585     end case.
     1586     assign
     1587       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1588       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1589     .
     1590   end .
     1591   end procedure .
     1592   procedure xml-bge-filename :
     1593   do
     1594   on error undo, return error
     1595   :
     1596   define input parameter p-prefix             as character    no-undo.
     1597   define input parameter p-name               as character    no-undo.
     1598   define input parameter p-shared-process     as logical      no-undo.
     1599   define output parameter p-xml-file-name     as character    no-undo.
     1600   define output parameter p-log-file-name     as character    no-undo.
     1601   define output parameter p-locked            as logical      no-undo.
     1602   define variable v-home-dir          as character no-undo .
     1603   define variable v-error-num         as integer   no-undo .
     1604   define variable v-bge-xml-heap-dir  as character no-undo .
     1605       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1606       if v-home-dir = ?
     1607       then do:
     1608           message
     1609             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1610             skip(1)
     1611             skip "Обратитесь к администратору."
     1612           view-as alert-box error.
     1613           undo, return error .
     1614       end.
     1615       if v-bge-xml-bgeflold <> "oracle"
     1616       then do:
     1617         assign
     1618             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1619         .
     1620       end.
     1621       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1622       if error-status :error
     1623       then do:
     1624           message
     1625             skip "Неверно задан каталог экспорта."
     1626             skip(1)
     1627             skip "Обратитесь к администратору."
     1628           view-as alert-box error.
     1629           undo, return error .
     1630       end.
     1631       if v-bge-xml-bgefmt = "dbf":U
     1632       then do:
     1633           assign
     1634               p-xml-file-name = v-home-dir
     1635               p-locked        = no
     1636           .
     1637       end.
     1638       else do:
     1639           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1640             output p-xml-file-name, output p-locked) .
     1641       end.
     1642       if v-bge-xml-bgeflold = "oracle"
     1643       then do:
     1644         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1645         if v-bge-xml-heap-dir = ?
     1646         then do:
     1647           undo, return error substitute( "&1&2&3"
     1648                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1649                                         , chr(10)
     1650                                         , "Обратитесь к администратору.":u
     1651                                         ).
     1652         end.
     1653         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1654         if error-status :error
     1655         then do:
     1656           undo, return error substitute( "&1&2&3"
     1657                                         , "Неверно задан каталог экспорта (heap).":u
     1658                                         , chr(10)
     1659                                         , "Обратитесь к администратору.":u
     1660                                         ).
     1661         end.
     1662         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1663           assign
     1664             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1665           .
     1666         end.
     1667         else do:
     1668           assign
     1669             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1670           .
     1671         end.
     1672       end.
     1673       else do:
     1674         assign
     1675             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1676         .
     1677       end.
     1678       assign
     1679          v-bge-xml-static-log-file-name = p-log-file-name
     1680       .
     1681   end.
     1682   end procedure.
     1683   procedure bge-xml-read-config :
     1684   do
     1685   on error undo, return error return-value
     1686   :
     1687   define input  parameter p-last-date as date      no-undo .
     1688   define input  parameter p-db-num    as integer   no-undo .
     1689       define variable v-bgeclall      as character     no-undo.
     1690       define variable v-bgedict       as character     no-undo.
     1691       define variable v-bgeshift      as character     no-undo.
     1692       define variable v-par-type      as character     no-undo.
     1693       define variable v-bgeflnm       as character     no-undo.
     1694       define variable v-bgecliiv      as character     no-undo .
     1695       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1696       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1697       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1698       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1699       define variable v-db-num-str    as character     no-undo .
     1700       define variable v-param-type      as character  no-undo .
     1701       define variable v-value-character as character  no-undo .
     1702       define variable v-value-date      as date       no-undo .
     1703       define variable v-value-decimal   as decimal    no-undo .
     1704       define variable v-value-integer   as integer    no-undo .
     1705       define variable v-value-logical   as logical    no-undo .
     1706       define variable v-tth             as handle      no-undo .
     1707       run adm/shattri.p ( input "get":U
     1708                         , input  '':u
     1709                         , input  0
     1710                         , input  'bge-export':U
     1711                         , input  'bgeclall':U
     1712                         , output v-bgecliiv
     1713                         , output v-value-date
     1714                         , output v-value-decimal
     1715                         , output v-value-integer
     1716                         , output v-value-logical
     1717                         , output v-param-type
     1718                         , input-output table-handle v-tth
     1719                         ) no-error .
     1720       if error-status :error
     1721       then do:
     1722         assign
     1723           v-bge-xml-bgecliiv = no
     1724         .
     1725       end.
     1726       else do:
     1727         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1728       end.
     1729       delete object v-tth.
     1730       assign
     1731           v-bge-xml-bgeclall = no
     1732           v-bge-xml-bgedict  = no
     1733       .
     1734       run adm/shattri.p ( input "get":U
     1735                         , input  '':u
     1736                         , input  0
     1737                         , input  'bge-export':U
     1738                         , input  'bgeclall':U
     1739                         , output v-value-character
     1740                         , output v-value-date
     1741                         , output v-value-decimal
     1742                         , output v-value-integer
     1743                         , output v-value-logical
     1744                         , output v-param-type
     1745                         , input-output table-handle v-tth
     1746                         ) no-error .
     1747       if error-status :error
     1748       then do:
     1749         assign
     1750           v-bge-xml-bgeclall = no
     1751         .
     1752       end.
     1753       else do:
     1754         assign
     1755           v-bge-xml-bgeclall = v-value-logical
     1756         .
     1757       end.
     1758       delete object v-tth.
     1759       run adm/shattri.p ( input "get":U
     1760                         , input  '':u
     1761                         , input  0
     1762                         , input  'bge-export':U
     1763                         , input  'bgedict':U
     1764                         , output v-value-character
     1765                         , output v-value-date
     1766                         , output v-value-decimal
     1767                         , output v-value-integer
     1768                         , output v-value-logical
     1769                         , output v-param-type
     1770                         , input-output table-handle v-tth
     1771                         ) no-error .
     1772       if error-status :error
     1773       then do:
     1774         assign
     1775           v-bge-xml-bgedict = no
     1776         .
     1777       end.
     1778       else do:
     1779         assign
     1780           v-bge-xml-bgedict = v-value-logical
     1781         .
     1782       end.
     1783       delete object v-tth.
     1784       run adm/shattri.p ( input "get":U
     1785                         , input  '':u
     1786                         , input  0
     1787                         , input  'bge-export':U
     1788                         , input  'bgefmt':U
     1789                         , output v-value-character
     1790                         , output v-value-date
     1791                         , output v-value-decimal
     1792                         , output v-value-integer
     1793                         , output v-value-logical
     1794                         , output v-param-type
     1795                         , input-output table-handle v-tth
     1796                         ) no-error .
     1797       if error-status :error
     1798       then do:
     1799         assign
     1800           v-bge-xml-bgefmt  = "xml":U
     1801         .
     1802       end.
     1803       else do:
     1804         assign
     1805           v-bge-xml-bgefmt  = v-value-character
     1806         .
     1807       end.
     1808       delete object v-tth.
     1809       run adm/shattri.p ( input "get":U
     1810                         , input  '':u
     1811                         , input  0
     1812                         , input  'bge-export':U
     1813                         , input  'bgeshift':U
     1814                         , output v-value-character
     1815                         , output v-value-date
     1816                         , output v-value-decimal
     1817                         , output v-value-integer
     1818                         , output v-value-logical
     1819                         , output v-param-type
     1820                         , input-output table-handle v-tth
     1821                         ) no-error .
     1822       if error-status :error
     1823       then do:
     1824         assign
     1825             v-bge-xml-shift-mode = no
     1826         .
     1827       end.
     1828       else do:
     1829         assign
     1830             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1831         .
     1832       end.
     1833       delete object v-tth.
     1834       run adm/shattri.p ( input "get":U
     1835                         , input  '':u
     1836                         , input  0
     1837                         , input  'bge-export':U
     1838                         , input  'bgeflold':U
     1839                         , output v-value-character
     1840                         , output v-value-date
     1841                         , output v-value-decimal
     1842                         , output v-value-integer
     1843                         , output v-value-logical
     1844                         , output v-param-type
     1845                         , input-output table-handle v-tth
     1846                         ) no-error .
     1847       if error-status :error
     1848       then do:
     1849         assign
     1850           v-bge-xml-bgeflold = "no-parameter":U
     1851         .
     1852       end.
     1853       else do:
     1854         assign
     1855           v-bge-xml-bgeflold  = v-value-character
     1856         .
     1857       end.
     1858       delete object v-tth.
     1859       assign
     1860         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1861         v-bge-xml-db-num-str  = v-db-num-str
     1862       .
     1863       if p-last-date <> ?
     1864       then do:
     1865           run adm/shattri.p ( input "get":U
     1866                             , input  '':u
     1867                             , input  0
     1868                             , input  'bge-export':U
     1869                             , input  'bgeflnm':U
     1870                             , output v-value-character
     1871                             , output v-value-date
     1872                             , output v-value-decimal
     1873                             , output v-value-integer
     1874                             , output v-value-logical
     1875                             , output v-param-type
     1876                             , input-output table-handle v-tth
     1877                             ) no-error .
     1878           if error-status :error
     1879           then do:
     1880             assign
     1881               v-bgeflnm = '':U
     1882             .
     1883           end.
     1884           else do:
     1885             assign
     1886               v-bgeflnm = v-value-character
     1887             .
     1888           end.
     1889           delete object v-tth.
     1890           if v-bge-xml-bgeflold = "var"
     1891           then do:
     1892               if v-bgeflnm = ?
     1893               or num-entries( v-bgeflnm ) < 2
     1894               then do:
     1895                   assign
     1896                       v-bge-xml-bgeflold = "new"
     1897                   .
     1898               end.
     1899               else do:
     1900                   assign
     1901                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1902                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1903                   .
     1904                   assign
     1905                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1906                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1907                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1908                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1909                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1910                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1911                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1912                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1913                   .
     1914               end.
     1915           end.
     1916       end.
     1917   end.
     1918   end procedure.
     1919   procedure bge-xml-get-ref-filename :
     1920   define input parameter p-in-file-name       as character        no-undo.
     1921   define output parameter p-home-dir          as character        no-undo.
     1922   define output parameter p-out-file-name     as character        no-undo.
     1923   define output parameter p-locked            as logical          no-undo.
     1924       define variable v-counter       as integer      no-undo.
     1925       define variable v-error-level   as integer      no-undo.
     1926   do
     1927   on error undo, return error
     1928   :
     1929       run bge/bge-ini.p (
     1930             input "bge"
     1931           , output p-home-dir
     1932       ).
     1933       if return-value <> "OK"
     1934       then do:
     1935           undo, return error.
     1936       end.
     1937       assign
     1938           p-home-dir = p-home-dir + "\dict":U
     1939       .
     1940       run bge/dir_cd.p (
     1941           input p-home-dir
     1942           , input "CA"
     1943       ).
     1944       if return-value = "ERROR"
     1945       then do:
     1946           undo, return error.
     1947       end.
     1948       assign
     1949           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1950       .
     1951       assign
     1952           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1953       .
     1954       wait-lock:
     1955       do v-counter = 1 TO 3
     1956       :
     1957           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1958           if p-locked = no
     1959           then do:
     1960               leave wait-lock.
     1961           end.
     1962           else do:
     1963               readkey pause 1.
     1964           end.
     1965       END.
     1966       if p-locked = yes
     1967       then do:
     1968           undo, return error.
     1969       end.
     1970       run bge/os_copy.p (
     1971             input "D":U
     1972           , input p-out-file-name + "xml":U
     1973           , input "":U
     1974           , output v-error-level
     1975       ).
     1976       if v-error-level > 0
     1977       then do:
     1978           undo, return error.
     1979       end.
     1980   end.
     1981   end procedure.
     1982   procedure bge-xml-write-ref-header :
     1983   define input parameter p-bge-name as character        no-undo.
     1984   define input parameter p-file-name as character        no-undo.
     1985       define variable v-out-string    as character    no-undo.
     1986   do
     1987   on error undo, return error
     1988   :
     1989       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1990       put stream stmXMLOut unformatted
     1991           "<?xml version='1.0' encoding='windows-1251'?>":U
     1992       .
     1993       assign
     1994           v-out-string = substitute( "&1&2"
     1995                               , chr(10)
     1996                               , "<IBS_Trade_House>":U )
     1997       .
     1998       put stream stmXMLOut unformatted
     1999           v-out-string
     2000       .
     2001       run wp-XMLTagOpen( 1, "header", "" ).
     2002       if v-bge-xml-bgeflold = "oracle":u
     2003       then do:
     2004         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2005         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2006         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2007         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2008         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2009       end.
     2010       else do:
     2011         run wp-XMLTagOpen( 2, "delivery", "" ).
     2012         run wp-XMLTagOpen( 3, "to", "" ).
     2013         run wp-XMLTagClose( 3, "to" ).
     2014         run wp-XMLTagOpen( 3, "from", "" ).
     2015         run wp-XMLTagClose( 3, "from" ).
     2016         run wp-XMLTagClose( 2, "delivery" ).
     2017       end.
     2018       run wp-XMLTagOpen( 2, "manifest", "" ).
     2019       run wp-XMLTagOpen( 3, "document", "" ).
     2020       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2021       run wp-XMLTagPut( 4, "description", "", 0 ).
     2022       run wp-XMLTagClose( 3, "document" ).
     2023       run wp-XMLTagClose( 2, "manifest" ).
     2024       run wp-XMLTagClose( 1, "header" ).
     2025       run wp-XMLTagOpen( 1, "body", "" ).
     2026   end.
     2027   end procedure.
     2028   procedure bge-xml-write-ref-footer :
     2029   define input parameter p-file-name as character        no-undo.
     2030       define variable v-error-level   as integer      no-undo.
     2031   do
     2032   on error undo, return error
     2033   :
     2034       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2035       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2036       output stream stmXMLOut close.
     2037       run bge/os_copy.p (
     2038             input "M":U
     2039           , input p-file-name + "xm1":U
     2040           , input p-file-name + "xml":U
     2041           , output v-error-level
     2042       ).
     2043       if v-error-level > 0
     2044       then do:
     2045           undo, return error.
     2046       end.
     2047   end.
     2048   end procedure.
     2049   procedure bge-xml-out-dir :
     2050   define output parameter p-out-dir       as character    no-undo.
     2051   define output parameter p-log-file-name as character    no-undo.
     2052   do
     2053   on error undo, return error
     2054   :
     2055       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2056       if p-out-dir = ?
     2057       then do:
     2058           message
     2059             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2060                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2061             skip(1)
     2062             skip "Обратитесь к администратору."
     2063           view-as alert-box error.
     2064           undo, return error .
     2065       end.
     2066       if v-bge-xml-bgeflold <> "oracle" then assign
     2067         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2068       .
     2069       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2070       if error-status :error  then do:
     2071           run wp-XMLWriteLog in this-procedure (
     2072                 input p-log-file-name
     2073               , input 0
     2074               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2075                                   , p-out-dir
     2076                                   , return-value
     2077                                   , trim( error-status :get-message( 1 ) )
     2078                                   )
     2079           ).
     2080           undo, return error.
     2081       end.
     2082       assign
     2083           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2084           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2085       .
     2086   end.
     2087   end procedure.
     2088   procedure bge-xml-out-dir2 :
     2089   define output parameter p-out-dir       as character    no-undo.
     2090   define output parameter p-out-dirR      as character    no-undo.
     2091   define output parameter p-log-file-name as character    no-undo.
     2092   do
     2093   on error undo, return error
     2094   :
     2095       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2096       if p-out-dir = ?
     2097       then do:
     2098           message
     2099             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2100                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2101             skip(1)
     2102             skip "Обратитесь к администратору."
     2103           view-as alert-box error.
     2104           undo, return error .
     2105       end.
     2106       if v-bge-xml-bgeflold <> "oracle" then assign
     2107             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2108             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2109         .
     2110       else p-out-dirR = p-out-dir .
     2111       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2112       if error-status :error  then do:
     2113           run wp-XMLWriteLog in this-procedure (
     2114                 input p-log-file-name
     2115               , input 0
     2116               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2117                                   , p-out-dir
     2118                                   , return-value
     2119                                   , error-status :get-message( 1 )
     2120                                   )
     2121           ).
     2122           undo, return error.
     2123       end.
     2124       if p-out-dirR <> p-out-dir then do:
     2125         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2126         if error-status :error then do:
     2127           run wp-XMLWriteLog in this-procedure (
     2128                 input p-log-file-name
     2129               , input 0
     2130               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2131                                   , p-out-dirR
     2132                                   , return-value
     2133                                   , error-status :get-message( 1 )
     2134                                   )
     2135           ).
     2136           p-out-dirR = p-out-dir .
     2137         end.
     2138       end .
     2139       assign
     2140         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2141         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2142       .
     2143   end.
     2144   end procedure.
     2145   procedure bge-xml-out-file :
     2146   do
     2147   on error undo, return error
     2148   :
     2149   define input parameter p-out-dir            as character        no-undo.
     2150   define input parameter p-prefix             as character        no-undo.
     2151   define input parameter p-sheduled           as logical          no-undo.
     2152   define output parameter p-xml-file-name     as character        no-undo.
     2153   define output parameter p-locked            as logical          no-undo.
     2154   define variable v-home-dir      as character     no-undo.
     2155   define variable v-error-num     as integer       no-undo.
     2156   define variable v-today             as date         no-undo.
     2157   define variable v-time              as integer      no-undo.
     2158       if v-bge-xml-bgefmt = "dbf":U
     2159       then do:
     2160           assign
     2161               p-xml-file-name = p-out-dir
     2162               p-locked        = no
     2163           .
     2164       end.
     2165       else do:
     2166           if v-bge-xml-bgeflold = "firm":U
     2167           then do:
     2168               run bge/genfname.p (
     2169                     input p-out-dir
     2170                   , input p-prefix
     2171                   , input "":U
     2172                   , input "arj":U
     2173                   , input "":U
     2174                   , output p-xml-file-name
     2175               ).
     2176           end.
     2177           else do:
     2178               run bge/genfname.p (
     2179                     input p-out-dir
     2180                   , input p-prefix
     2181                   , input "":U
     2182                   , input "xml":U
     2183                   , input "":U
     2184                   , output p-xml-file-name
     2185               ).
     2186           end.
     2187           assign
     2188               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2189               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2190           .
     2191       end.
     2192   end.
     2193   end procedure.
     2194   procedure bge-xml-init-ext-doc-type :
     2195       define variable v-counter    as integer      no-undo.
     2196       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2197   do
     2198   for buf_temp_ext-doc-type
     2199   on error undo, return error
     2200   :
     2201       empty temp-table buf_temp_ext-doc-type.
     2202       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2203       :
     2204           create buf_temp_ext-doc-type.
     2205           assign
     2206               buf_temp_ext-doc-type.edt-key               = v-counter
     2207               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2208               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2209           .
     2210       end.
     2211   end.
     2212   end procedure.
     2213   procedure bge-xml-get-decimal-shift-num :
     2214   define input parameter p-shift-date     as date             no-undo.
     2215   define input parameter p-shift-num      as integer          no-undo.
     2216   define output parameter p-shift-decimal as decimal          no-undo.
     2217   do
     2218   on error undo, return error
     2219   :
     2220       assign
     2221           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2222       .
     2223   end.
     2224   end procedure.
     2225   procedure bge-xml-ora-exp-filename :
     2226     define input  parameter p-table-name  as character no-undo .
     2227     define input  parameter p-doc-code    as character no-undo .
     2228     define input  parameter p-obj-code    as integer   no-undo .
     2229     define output parameter p-filename    as character no-undo .
     2230     define output parameter p-seq-num     as integer   no-undo .
     2231     define variable v-ora-exp-seq     as integer   no-undo .
     2232     define variable v-ora-exp-seq-str as character no-undo .
     2233     define variable v-home-dir        as character no-undo.
     2234   do
     2235   on error undo, return error return-value
     2236   :
     2237     if v-bge-xml-bgeflold = "oracle":u
     2238     then do:
     2239       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2240       if v-home-dir = ?
     2241       then do:
     2242         undo, return error substitute( "&1&2&3":U
     2243                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2244                                       , chr(10)
     2245                                       , "Обратитесь к администратору.":U
     2246                                       ).
     2247       end.
     2248       assign
     2249           v-home-dir = v-home-dir
     2250       .
     2251       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2252       if error-status :error
     2253       then do:
     2254         undo, return error substitute( "&1&2&3":U
     2255                                       , "Неверно задан каталог экспорта.":U
     2256                                       , chr(10)
     2257                                       , "Обратитесь к администратору.":U
     2258                                       ).
     2259       end.
     2260       assign
     2261         v-ora-exp-seq = ?
     2262       .
     2263       if  p-table-name <> ? and
     2264           p-doc-code <> ?
     2265       then do:
     2266         run bge/get-oesq.p ( input p-table-name
     2267                            , input p-doc-code
     2268                            , output v-ora-exp-seq
     2269                            ) no-error .
     2270         if error-status :error = yes
     2271         then do:
     2272           undo, return error return-value .
     2273         end.
     2274       end.
     2275       if v-ora-exp-seq = ?
     2276       then do:
     2277         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2278         if error-status :error
     2279         then do:
     2280           undo, return error return-value .
     2281         end.
     2282       end.
     2283       if p-table-name <> ? and
     2284          p-doc-code   <> ?
     2285       then do:
     2286         run bge/oesqdoc.p ( input p-table-name
     2287                           , input p-doc-code
     2288                           , input v-ora-exp-seq
     2289                           ) no-error .
     2290         if error-status :error = yes
     2291         then do:
     2292           undo, return error return-value .
     2293         end.
     2294       end.
     2295       assign
     2296         p-seq-num  = v-ora-exp-seq
     2297         p-filename = substitute("&1/&2-000_&3."
     2298                                , v-home-dir
     2299                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2300                                , string(v-ora-exp-seq , "999999999")
     2301                                )
     2302       .
     2303     end.
     2304   end.
     2305   end procedure.
     2306   procedure bge-xml-date-to-str :
     2307     define input  parameter p-date  as date      no-undo .
     2308     define output parameter p-str   as character no-undo .
     2309   do
     2310   on error undo, return error return-value
     2311   :
     2312     if p-date <> ?
     2313     then do:
     2314       assign
     2315         p-str = substitute( "&1-&2-&3"
     2316                           , string( year(p-date)  , "9999")
     2317                           , string( month(p-date) , "99"  )
     2318                           , string( day(p-date)   , "99"  )
     2319                           )
     2320       .
     2321     end.
     2322     else do:
     2323       assign
     2324         p-str = ?
     2325       .
     2326     end.
     2327   end.
     2328   end procedure.
     2329   procedure bge-xml-date-str-to-str :
     2330     define input  parameter p-date-str  as character no-undo .
     2331     define output parameter p-str       as character no-undo .
     2332     define variable v-date          as date      no-undo .
     2333     define variable v-date-valid    as logical   no-undo .
     2334     define variable v-error-message as character no-undo .
     2335   do
     2336   on error undo, return error return-value
     2337   :
     2338     assign
     2339       p-str = ?
     2340     .
     2341     if p-date-str = ? or p-date-str = ""
     2342     then do:
     2343       return .
     2344     end.
     2345     run strtdate in this-procedure ( input  p-date-str
     2346                                    , output v-date
     2347                                    , output v-date-valid
     2348                                    , output v-error-message
     2349                                    ).
     2350     if v-date-valid <> true
     2351     then do:
     2352       return .
     2353     end.
     2354     assign
     2355       p-str = substitute( "&1-&2-&3"
     2356                         , string( year(v-date)  , "9999")
     2357                         , string( month(v-date) , "99"  )
     2358                         , string( day(v-date)   , "99"  )
     2359                         )
     2360     .
     2361   end.
     2362   end procedure.
     2363   procedure bge-xml-fill-tt-bgecliiv :
     2364     define input  parameter p-str as character no-undo .
     2365     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2366     define buffer buf_clients             for ub.clients.
     2367     define variable v-i         as integer   no-undo .
     2368     define variable v-count     as integer   no-undo .
     2369     define variable v-cli-count as integer   no-undo .
     2370     define variable v-client    as character no-undo .
     2371     define variable v-obj-type  as character no-undo .
     2372     define variable v-obj-code  as integer   no-undo .
     2373   do
     2374   on error undo, return error return-value
     2375   :
     2376     empty temp-table buf_tt-bge-xml-bgecliiv.
     2377     assign
     2378       v-bge-xml-bgecliiv = no
     2379       v-cli-count        = num-entries(p-str,';')
     2380     .
     2381     if v-cli-count > 0
     2382     then do:
     2383       _cli-cycle:
     2384       do v-i = 1 to v-cli-count
     2385       :
     2386         assign
     2387           v-client = entry(v-i , p-str, ';')
     2388         .
     2389         if num-entries(v-client) <> 2
     2390         then do:
     2391           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2392         end.
     2393         assign
     2394           v-obj-type = entry(1, v-client)
     2395         .
     2396         assign
     2397           v-obj-code = integer(entry(2, v-client))
     2398         no-error .
     2399         if error-status :error
     2400         then do:
     2401           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2402         end.
     2403         find first buf_clients no-lock
     2404           where buf_clients.obj-type = v-obj-type
     2405             and buf_clients.obj-code = v-obj-code
     2406         no-error.
     2407         if not available buf_clients
     2408         then do:
     2409           next _cli-cycle.
     2410         end.
     2411         find first buf_tt-bge-xml-bgecliiv no-lock
     2412           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2413             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2414         no-error .
     2415         if available buf_tt-bge-xml-bgecliiv
     2416         then do:
     2417           next _cli-cycle.
     2418         end.
     2419         create buf_tt-bge-xml-bgecliiv.
     2420         assign
     2421           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2422           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2423         .
     2424       end.
     2425     end.
     2426     else do:
     2427       assign
     2428         v-bge-xml-bgecliiv = no
     2429       .
     2430       return .
     2431     end.
     2432     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2433     if available buf_tt-bge-xml-bgecliiv
     2434     then do:
     2435       assign
     2436         v-bge-xml-bgecliiv = yes
     2437       .
     2438     end.
     2439   end.
     2440   end procedure.
     2441   procedure bge-xml-resolve-ext-doc-type :
     2442     define input  parameter p-ext-doc-type      as character no-undo .
     2443     define input  parameter p-obj-type          as character no-undo .
     2444     define input  parameter p-obj-code          as integer   no-undo .
     2445     define output parameter p-out-ext-doc-type  as character no-undo .
     2446     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2447   do
     2448   on error undo, return error return-value
     2449   :
     2450     assign
     2451       p-out-ext-doc-type = p-ext-doc-type
     2452     .
     2453     if p-ext-doc-type <> 'ie':U
     2454     then do:
     2455       return .
     2456     end.
     2457     if v-bge-xml-bgecliiv = yes
     2458     then do:
     2459       find first buf_tt-bge-xml-bgecliiv no-lock
     2460         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2461           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2462       no-error .
     2463       if available buf_tt-bge-xml-bgecliiv
     2464       then do:
     2465         assign
     2466           p-out-ext-doc-type = 'iv':U
     2467         .
     2468       end.
     2469     end.
     2470   end.
     2471   end procedure.
     2472   procedure safe-wp-xmltagput :
     2473     define input  parameter pTagLevel   as integer   no-undo .
     2474     define input  parameter pTagName    as character no-undo .
     2475     define input  parameter pParValue   as character no-undo .
     2476     define input  parameter pFlagEmpty  as integer   no-undo .
     2477   do
     2478   on error undo, return error return-value
     2479   :
     2480     if v-bge-xml-bgeflold = "oracle":u
     2481     then do:
     2482       return .
     2483     end.
     2484     run wp-xmltagput in this-procedure ( input pTagLevel
     2485                                        , input pTagName
     2486                                        , input pParValue
     2487                                        , input pFlagEmpty
     2488                                        ).
     2489   end.
     2490   end procedure.
     2491   define variable v-counter       as integer no-undo.
     2492   define variable v-inkas-exists  as logical no-undo.
     2493   define buffer buf_inkas     for ub.inkas.
     2494   define buffer buf_chk-doc   for ub.chk-doc.
     2495   define buffer buf_chk-gds   for ub.chk-gds.
     2496   define buffer buf_bar-code  for ub.bar-code.
     2497   define buffer buf_goods     for ub.goods.
     2498   define buffer buf_chk-pay   for ub.chk-pay.
     2499   do
     2500   on error undo, return error
     2501   :
     2502   ASSIGN
     2503     v-counter       = 0
     2504     v-inkas-exists = NO
     2505   .
     2506   DEF TEMP-TABLE temp-kass NO-UNDO
     2507     FIELD cass-num   LIKE ub.chk-doc.pay-desk
     2508     FIELD oper-num   AS CHAR
     2509     FIELD obj-type   LIKE ub.inkas.obj-type
     2510     FIELD obj-code   LIKE ub.inkas.obj-code
     2511     index pk is primary unique cass-num oper-num
     2512   .
     2513   DEF TEMP-TABLE temp-kass-pay NO-UNDO
     2514     FIELD cass-num   LIKE ub.chk-doc.pay-desk
     2515     FIELD oper-num   AS CHAR
     2516     FIELD pay-code   LIKE ub.inkas-pay.pay-code
     2517     FIELD curr-code  LIKE ub.inkas-pay.curr-code
     2518     FIELD tot-base   LIKE ub.inkas-pay.tot-base
     2519     FIELD tot-rubl   LIKE ub.inkas-pay.tot-rubl
     2520     FIELD tot-sum    LIKE ub.inkas-pay.tot-sum
     2521     index pk is primary unique cass-num oper-num pay-code curr-code
     2522   .
     2523   DEF TEMP-TABLE temp-kass-goods NO-UNDO
     2524     FIELD cass-num     LIKE ub.chk-doc.pay-desk
     2525     FIELD oper-num     AS CHAR
     2526     FIELD gds-code     LIKE ub.goods.gds-code
     2527     FIELD tot-qnty     LIKE ub.chk-gds.doc-qnty
     2528     FIELD tot-sum      LIKE ub.chk-doc.tot-doc
     2529     index pk is primary unique cass-num oper-num gds-code
     2530   .
     2531   RUN wp-XMLWriteLog(p-log-file, 0, "&Line").
     2532   RUN wp-XMLWriteLog(p-log-file, 1, "XML - Вывод операций по кассам").
     2533   FOR EACH buf_inkas NO-LOCK
     2534      WHERE buf_inkas.doc-date = p-date
     2535        AND buf_inkas.obj-type = p-obj-type
     2536        AND buf_inkas.obj-code = p-obj-code
     2537        AND buf_inkas.status_ = 'факт':U
     2538   :
     2539     IF NOT AVAILABLE buf_inkas
     2540     THEN RUN wp-XMLWriteLog(p-log-file, 1, "Нет записей INKAS за дату " + STRING(p-date)).
     2541     ELSE DO:
     2542       IF NOT v-inkas-exists
     2543       THEN DO:
     2544         ASSIGN v-inkas-exists = YES.
     2545         RUN wp-XMLWriteEDT( p-EDT, 4, "Дата " + STRING(p-date) + ". Заполнение таблиц для кассовых операций...").
     2546       END.
     2547       _chk-doc:
     2548       FOR EACH buf_chk-doc NO-LOCK
     2549         WHERE  buf_chk-doc.out-code = buf_inkas.inkas-code
     2550       :
     2551         if buf_chk-doc.correct = no then next.
     2552         if LOOKUP(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2553         find first temp-kass no-lock
     2554              where temp-kass.cass-num = buf_chk-doc.pay-desk
     2555              and   temp-kass.oper-num = (if buf_chk-doc.netto >= 0 then "es" else "rs")
     2556         no-error.
     2557         IF NOT AVAILABLE temp-kass THEN
     2558         DO:
     2559           CREATE temp-kass.
     2560           ASSIGN
     2561             temp-kass.cass-num = buf_chk-doc.pay-desk
     2562             temp-kass.oper-num = (IF buf_chk-doc.netto >= 0 THEN "es" ELSE "rs")
     2563             temp-kass.obj-type = buf_inkas.obj-type
     2564             temp-kass.obj-code = buf_inkas.obj-code
     2565           .
     2566         END.
     2567         FOR EACH buf_chk-gds NO-LOCK
     2568            WHERE buf_chk-gds.doc-code = buf_chk-doc.doc-code
     2569         :
     2570             ASSIGN v-counter = v-counter + 1.
     2571             RUN wp-XMLWriteCNT(p-CNT, "Товаров: " + STRING(v-counter, "zzzzz9")).
     2572             IF v-counter MOD 10 = 0 THEN PROCESS EVENTS.
     2573             FIND FIRST buf_bar-code NO-LOCK
     2574                  WHERE buf_bar-code.b-code = buf_chk-gds.b-code
     2575             .
     2576             FIND FIRST buf_goods    NO-LOCK
     2577                  WHERE buf_goods.gds-code = buf_bar-code.gds-code
     2578             .
     2579             IF buf_chk-doc.netto >= 0
     2580             THEN DO:
     2581                   run update-temp-kass-goods in this-procedure ( input "es", input 1 ).
     2582             END.
     2583             ELSE DO:
     2584                   run update-temp-kass-goods in this-procedure ( input "rs", input -1 ).
     2585             END.
     2586         END.
     2587         FOR EACH buf_chk-pay NO-LOCK
     2588            WHERE buf_chk-pay.doc-code = buf_chk-doc.doc-code
     2589         :
     2590             ASSIGN v-counter = v-counter + 1.
     2591             RUN wp-XMLWriteCNT(p-CNT, "Оплат: " + STRING(v-counter, "zzzzz9")).
     2592             IF v-counter MOD 10 = 0 THEN PROCESS EVENTS.
     2593             IF buf_chk-doc.netto >= 0
     2594             THEN DO:
     2595                   run update-temp-kass-pay in this-procedure ( input "es", input 1 ).
     2596             END.
     2597             ELSE DO:
     2598                   run update-temp-kass-pay in this-procedure ( input "rs", input -1 ).
     2599             END.
     2600         END.
     2601       END.
     2602     END.
     2603   END.
     2604   OUTPUT STREAM stmXMLOut TO VALUE( p-out-file + "xm1" ) CONVERT TARGET "1251" APPEND.
     2605   FOR EACH temp-kass
     2606   :
     2607     RUN wp-XMLTagOpen( 2, "operation", "").
     2608     RUN wp-XMLTagPut( 3, "referenceNo", "", 1 ).
     2609     RUN wp-XMLTagPut( 3, "dateDoc", STRING(p-date,"99.99.9999"), 0 ).
     2610     RUN wp-XMLTagPut( 3, "organization", temp-kass.cass-num, 0 ).
     2611     RUN wp-XMLTagPut( 3, "objType", temp-kass.obj-type, 0 ).
     2612     RUN wp-XMLTagPut( 3, "objCode", temp-kass.obj-code, 0 ).
     2613     RUN wp-XMLTagPut( 3, "codeOperation", temp-kass.oper-num, 0 ).
     2614     RUN wp-XMLWriteEDT( p-EDT, 4,
     2615         "Касса " + STRING( temp-kass.cass-num ) + " объекта " + p-obj-type + STRING( p-obj-code )
     2616         + ". Операция " + temp-kass.oper-num ).
     2617     run wp-xmltagopen( 3, "docPay", "" ).
     2618     for each temp-kass-pay
     2619        where temp-kass-pay.cass-num = temp-kass.cass-num
     2620          and temp-kass-pay.oper-num = temp-kass.oper-num
     2621     break by temp-kass-pay.pay-code
     2622           by temp-kass-pay.curr-code
     2623     :
     2624         if first-of( temp-kass-pay.pay-code )
     2625         then do:
     2626             run wp-xmltagopen( 4, "pay", "" ).
     2627             run wp-XMLTagPut( 5, "payCode", string( temp-kass-pay.pay-code ), 0 ).
     2628         end.
     2629         run wp-xmltagopen( 5, "curr", "" ).
     2630         run wp-XMLTagPut( 6, "currCode", string( temp-kass-pay.curr-code ), 0 ).
     2631         run wp-XMLTagPut( 6, "totBase", string( temp-kass-pay.tot-base ), 0 ).
     2632         run wp-XMLTagPut( 6, "totRubl", string( temp-kass-pay.tot-rubl ), 0 ).
     2633         run wp-XMLTagPut( 6, "totSum",  string( temp-kass-pay.tot-sum ),  0 ).
     2634         run wp-xmltagclose( 5, "curr" ).
     2635         if last-of( temp-kass-pay.pay-code )
     2636         then do:
     2637             run wp-xmltagclose( 4, "pay" ).
     2638         end.
     2639     end.
     2640     run wp-xmltagclose( 3, "docPay" ).
     2641     FOR EACH temp-kass-goods
     2642        WHERE temp-kass-goods.cass-num = temp-kass.cass-num
     2643          AND temp-kass-goods.oper-num = temp-kass.oper-num
     2644     :
     2645           run wp-XMLTagOpen( 3, "lineDoc", "").
     2646           run wp-XMLTagPut( 4, "good", string(temp-kass-goods.gds-code), 0 ).
     2647           run wp-XMLTagPut( 4, "quantity", string(temp-kass-goods.tot-qnty), 0 ).
     2648           run wp-xmltagopen( 4, "docSum","" ).
     2649           run wp-XMLTagPut( 5, "sum", string(ABSOLUTE(temp-kass-goods.tot-sum)), 0 ).
     2650           run wp-xmltagclose( 4, "docSum" ).
     2651           run wp-XMLTagClose( 3, "lineDoc" ).
     2652     END.
     2653     RUN wp-XMLTagClose( 2, "operation" ).
     2654   END.
     2655   OUTPUT STREAM stmXMLOut CLOSE.
     2656   end.
     2657   procedure update-temp-kass-goods :
     2658   do
     2659   on error undo, return error
     2660   :
     2661   def input parameter p-oper-num as char no-undo.
     2662   def input parameter p-sign     as integer no-undo.
     2663       FIND FIRST temp-kass-goods
     2664            WHERE temp-kass-goods.cass-num = buf_chk-doc.pay-desk
     2665              AND temp-kass-goods.gds-code = buf_goods.gds-code
     2666              AND temp-kass-goods.oper-num = p-oper-num
     2667       no-error.
     2668       IF NOT AVAILABLE temp-kass-goods
     2669       THEN DO:
     2670       CREATE temp-kass-goods.
     2671       ASSIGN
     2672           temp-kass-goods.cass-num = buf_chk-doc.pay-desk
     2673           temp-kass-goods.gds-code = buf_goods.gds-code
     2674           temp-kass-goods.oper-num = p-oper-num
     2675           temp-kass-goods.tot-qnty = 0
     2676           temp-kass-goods.tot-sum  = 0
     2677       .
     2678       END.
     2679       ASSIGN
     2680           temp-kass-goods.tot-qnty = temp-kass-goods.tot-qnty + ( p-sign * buf_chk-gds.doc-qnty )
     2681           temp-kass-goods.tot-sum  = temp-kass-goods.tot-sum + ( buf_chk-gds.doc-qnty * ( buf_chk-gds.price-base
     2682                                                                                       + buf_chk-gds.price-service
     2683                                                                                       - buf_chk-gds.discnt
     2684                                                                                     )
     2685                                                                )
     2686       .
     2687   end.
     2688   end procedure.
     2689   procedure update-temp-kass-pay :
     2690   do
     2691   on error undo, return error
     2692   :
     2693   def input parameter p-oper-num as char no-undo.
     2694   def input parameter p-sign     as integer no-undo.
     2695       FIND FIRST temp-kass-pay
     2696            WHERE temp-kass-pay.cass-num   = buf_chk-doc.pay-desk
     2697              AND temp-kass-pay.oper-num   = p-oper-num
     2698              AND temp-kass-pay.pay-code   = buf_chk-pay.pay-code
     2699              AND temp-kass-pay.curr-code  = buf_chk-pay.curr-code
     2700       no-error.
     2701       IF NOT AVAILABLE temp-kass-pay
     2702       THEN DO:
     2703       CREATE temp-kass-pay.
     2704       ASSIGN
     2705           temp-kass-pay.cass-num  = buf_chk-doc.pay-desk
     2706           temp-kass-pay.oper-num  = p-oper-num
     2707           temp-kass-pay.pay-code  = buf_chk-pay.pay-code
     2708           temp-kass-pay.curr-code = buf_chk-pay.curr-code
     2709           temp-kass-pay.tot-base = 0
     2710           temp-kass-pay.tot-rubl = 0
     2711           temp-kass-pay.tot-sum  = 0
     2712       .
     2713       END.
     2714       ASSIGN
     2715           temp-kass-pay.tot-base  = temp-kass-pay.tot-base + ( p-sign * buf_chk-pay.tot-base )
     2716           temp-kass-pay.tot-rubl  = temp-kass-pay.tot-rubl + ( p-sign * buf_chk-pay.tot-rubl )
     2717           temp-kass-pay.tot-sum   = temp-kass-pay.tot-sum  + ( p-sign * buf_chk-pay.tot-sum  )
     2718       .
     2719   end.
     2720   end procedure.
