      590   procedure xmlchar-decode :
      591   define input parameter p-in-string      as character        no-undo.
      592   define output parameter p-out-string    as character        no-undo.
      593       define variable v-position      as integer      no-undo.
      594       define variable v-last-position as integer      no-undo.
      595       define variable v-temp-integer  as integer      no-undo.
      596       define variable v-current-char  as character    no-undo.
      597       define variable v-next-char     as character    no-undo.
      598       define variable v-success       as logical      no-undo.
      599   do
      600   on error undo, return error
      601   :
      602       assign
      603           p-out-string = "":U
      604           v-position   = 0
      605       .
      606       replace-cycle:
      607       do while yes
      608       on error undo, return error
      609       :
      610           assign
      611               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      612           .
      613           if v-last-position <= v-position
      614           then do:
      615               if v-position = 0
      616               then do:
      617                   assign
      618                       p-out-string = p-in-string
      619                   .
      620               end.
      621               else do:
      622                   assign
      623                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      624                   .
      625               end.
      626               leave replace-cycle.
      627           end.
      628           else do:
      629               assign
      630                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      631                   v-position      = v-last-position
      632                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      633               .
      634               if v-current-char = "#":U
      635               then do:
      636                   assign
      637                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      638                   .
      639                   if v-last-position > 0
      640                   then do:
      641                       run xmlchar-read-integer in this-procedure
      642                        (
      643                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      644                           , output v-temp-integer
      645                           , output v-success
      646                       ).
      647                       if v-success = yes
      648                       and v-temp-integer >= 1
      649                       and v-temp-integer <= 255
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + chr( v-temp-integer )
      653                               v-position   = v-last-position + 1
      654                           .
      655                       end.
      656                       else do:
      657                           assign
      658                               p-out-string = p-out-string + "&":U
      659                               v-position   = v-position   + 1
      660                           .
      661                       end.
      662                   end.
      663                   else do:
      664                       assign
      665                           p-out-string = p-out-string + "&":U
      666                           v-position   = v-position   + 1
      667                       .
      668                   end.
      669               end.
      670               else do:
      671                   case substring( p-in-string, v-position + 1, 3 )
      672                   :
      673                       when "lt;":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + "<":U
      677                               v-position   = v-position   + 3
      678                           .
      679                       end.
      680                       when "gt;":U
      681                       then do:
      682                           assign
      683                               p-out-string = p-out-string + ">":U
      684                               v-position   = v-position   + 3
      685                           .
      686                       end.
      687                       otherwise do:
      688                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      689                           then do:
      690                               assign
      691                                   p-out-string = p-out-string + "&":U
      692                                   v-position   = v-position   + 4
      693                               .
      694                           end.
      695                           else do:
      696                               case substring( p-in-string, v-position + 1, 5 )
      697                               :
      698                                   when "quot;":U
      699                                   then do:
      700                                       assign
      701                                           p-out-string = p-out-string + '"':U
      702                                           v-position   = v-position   + 5
      703                                       .
      704                                   end.
      705                                   when "apos;":U
      706                                   then do:
      707                                       assign
      708                                           p-out-string = p-out-string + "'":U
      709                                           v-position   = v-position   + 5
      710                                       .
      711                                   end.
      712                                   otherwise do:
      713                                       assign
      714                                           p-out-string = p-out-string + "&":U
      715                                       .
      716                                   end.
      717                               end case.
      718                           end.
      719                       end.
      720                   end case.
      721               end.
      722           end.
      723       end.
      724   end.
      725   end .
      726   procedure xmlchar-read-integer :
      727   define input parameter p-input-string      as character        no-undo.
      728   define output parameter p-output-integer   as integer          no-undo.
      729   define output parameter p-success       as logical          no-undo.
      730   do
      731   on error undo, return error
      732   :
      733       assign
      734           p-output-integer = integer( p-input-string )
      735       no-error.
      736       if error-status :error
      737       then do:
      738           assign
      739               p-success           = no
      740               p-output-integer    = 0
      741           .
      742       end.
      743       else do:
      744           assign
      745               p-success           = yes
      746           .
      747       end.
      748   end.
      749   end.
      750   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      751   procedure strtdate :
      752     define input  parameter p-str         as character no-undo .
      753     define output parameter p-value       as date      no-undo .
      754     define output parameter p-data-valid  as logical   no-undo .
      755     define output parameter p-message     as character no-undo .
      756   do
      757   on error undo, return error return-value
      758   :
      759     define variable v-value       as date      no-undo .
      760     define variable v-i           as integer   no-undo .
      761     define variable v-num         as integer   no-undo .
      762     define variable v-delim       as character no-undo .
      763     define variable v-delim-list  as character no-undo .
      764     define variable v-day         as integer   no-undo .
      765     define variable v-month       as integer   no-undo .
      766     define variable v-year        as integer   no-undo .
      767     define variable v-day-str     as character no-undo .
      768     define variable v-month-str   as character no-undo .
      769     define variable v-year-str    as character no-undo .
      770     assign
      771       p-value       = ?
      772       p-data-valid  = false
      773     .
      774     if p-str = ?
      775     then do:
      776       assign
      777         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      778       .
      779       return .
      780     end.
      781     if p-str = ""
      782     then do:
      783       assign
      784         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      785       .
      786       return .
      787     end.
      788     if length(p-str)  > 10
      789     then do:
      790       assign
      791         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      792       .
      793       return .
      794     end.
      795     assign
      796       v-delim-list = '/,-,.':U
      797     .
      798     _delim:
      799     do v-i = 1 to num-entries( v-delim-list )
      800     :
      801       assign
      802         v-delim = entry( v-i , v-delim-list )
      803         v-num   = num-entries( p-str , v-delim )
      804       .
      805       if v-num <> 3
      806       then do:
      807         assign
      808           v-delim = ''
      809         .
      810       end.
      811       else do:
      812         leave _delim.
      813       end.
      814     end.
      815     if v-delim = ''
      816     then do:
      817       assign
      818         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      819       .
      820       return .
      821     end.
      822     assign
      823       v-day-str   = entry( 1, p-str , v-delim)
      824       v-month-str = entry( 2, p-str , v-delim)
      825       v-year-str  = entry( 3, p-str , v-delim)
      826     .
      827     if  length(v-day-str) > 2   or
      828         length(v-day-str) < 1   or
      829         length(v-month-str) > 2 or
      830         length(v-month-str) < 1 or
      831         (
      832           length(v-year-str) <> 2 and
      833           length(v-year-str) <> 4
      834         )
      835     then do:
      836       assign
      837         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      838       .
      839       return .
      840     end.
      841     if length( v-year-str ) = 2
      842     then do:
      843       assign
      844         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      845       .
      846     end.
      847     assign
      848       v-day   = integer( v-day-str )
      849       v-month = integer( v-month-str)
      850       v-year  = integer( v-year-str)
      851     no-error .
      852     if error-status :error
      853     then do:
      854       assign
      855         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      856       .
      857       return .
      858     end.
      859     if v-day < 1  or
      860        v-day > 31 or
      861        v-month < 1 or
      862        v-month > 12 or
      863        v-year < 0   or
      864        v-year > 5000
      865     then do:
      866       assign
      867         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      868       .
      869       return .
      870     end.
      871     assign
      872       v-value = date( v-month, v-day, v-year )
      873     no-error .
      874     if error-status :error
      875     then do:
      876       assign
      877         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      878       .
      879       return .
      880     end.
      881     assign
      882       p-value       = v-value
      883       p-data-valid  = true
      884     .
      885   end.
      886   end procedure.
      887   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
