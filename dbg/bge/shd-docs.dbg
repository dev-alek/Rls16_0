      188   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189   procedure cur-time :
      190      define output parameter p-today as date      no-undo .
      191      define output parameter p-time  as integer   no-undo .
      192     do
      193     on error undo, return error
      194     :
      195       define variable v-date1 as date      no-undo .
      196       define variable v-date2 as date      no-undo .
      197       define variable v-time  as integer   no-undo .
      198       assign
      199         v-date1 = today
      200         v-time  = time
      201         v-date2 = today
      202       .
      203       if v-date1 <> v-date2
      204       then do:
      205         assign
      206           v-date1 = today
      207           v-time  = v-time
      208         .
      209       end.
      210       assign
      211         p-today = v-date1
      212         p-time  = v-time
      213       .
      214     end.
      215   end.
      216   function cur-time-date returns character
      217   :
      218     return string(today, '99/99/9999':U) .
      219   end.
      220   function cur-time-mjd returns decimal
      221   :
      222     define variable v-date as date      no-undo .
      223     define variable v-time as integer   no-undo .
      224     run cur-time in this-procedure
      225       (output v-date
      226       ,output v-time
      227       ) .
      228     return integer(v-date) - 2400002 + (v-time / 86400) .
      229   end.
      230   function cur-time-get-ending-index returns integer
      231   (input p-number as integer
      232   )
      233   :
      234     if p-number < 0
      235     or p-number = ?
      236     then do:
      237       return 1 .
      238     end.
      239     define variable v-rest as integer   no-undo .
      240     assign
      241       p-number = p-number modulo 100
      242     .
      243     if p-number < 20
      244     then do:
      245       assign
      246         v-rest = p-number
      247       .
      248     end.
      249     else do:
      250       assign
      251         v-rest = p-number modulo 10
      252       .
      253     end.
      254     case v-rest :
      255       when 1
      256       then do:
      257         return 2 .
      258       end.
      259       when 2 or
      260       when 3 or
      261       when 4
      262       then do:
      263         return 3 .
      264       end.
      265       otherwise do:
      266         return 1 .
      267       end.
      268     end case .
      269   end.
      270   procedure cur-time-mjd-to-date :
      271      define input  parameter i-mjd-diff as decimal no-undo.
      272      define output parameter o-Date     as date    no-undo.
      273      define output parameter o-Time     as integer no-undo.
      274      define variable v-day-number as integer   no-undo .
      275      if    i-mjd-diff < 0
      276         or i-mjd-diff = ?
      277      then do:
      278         return "?" .
      279      end.
      280      assign
      281         v-day-number = truncate(i-mjd-diff,0).
      282         o-Date = date(v-day-number + 2400002).
      283         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      284     .
      285   end.
      286   function cur-time-mjd-to-string returns character
      287   (input p-mjd-diff as decimal
      288   )
      289   :
      290     define variable v-day-number as integer   no-undo .
      291     define variable v-seconds    as integer   no-undo .
      292     define variable v-hour       as integer   no-undo .
      293     define variable v-min        as integer   no-undo .
      294     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      295     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      296     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      297     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      298     if p-mjd-diff < 0
      299     or p-mjd-diff = ?
      300     then do:
      301       return "?" .
      302     end.
      303     assign
      304       v-day-number = integer(truncate(p-mjd-diff,0))
      305       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      306     .
      307     if v-seconds > 86400
      308     then do:
      309       assign
      310         v-seconds = 86400 - 1
      311       .
      312     end.
      313     if v-seconds < 0
      314     then do:
      315       assign
      316         v-seconds = 0
      317       .
      318     end.
      319     assign
      320       v-hour = truncate(v-seconds / 3600, 0)
      321     .
      322     assign
      323       v-seconds = v-seconds modulo 3600
      324     .
      325     assign
      326       v-min = truncate(v-seconds / 60, 0)
      327     .
      328     assign
      329       v-seconds = v-seconds modulo 60
      330     .
      331     return
      332         (if v-day-number <> 0
      333           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      334           else ""
      335         )
      336       + (if v-day-number <> 0 or v-hour <> 0
      337           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      338           else ""
      339         )
      340       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      341           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      342           else ""
      343         )
      344       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      345       .
      346   end.
      347   function cur-time-string returns character
      348   :
      349     define variable v-date as date      no-undo .
      350     define variable v-time as integer   no-undo .
      351     run cur-time in this-procedure
      352       (output v-date
      353       ,output v-time
      354       ) .
      355     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      356   end.
      357   function cur-time-string-sec returns character
      358   :
      359     define variable v-date as date      no-undo .
      360     define variable v-time as integer   no-undo .
      361     run cur-time in this-procedure
      362       (output v-date
      363       ,output v-time
      364       ) .
      365     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      366   end.
      367   function cur-time-custom  returns character
      368   (input p-prefix as character
      369   ,input p-date-format as character
      370   ,input p-delimiter as character
      371   ,input p-time-format as character
      372   ,input p-suffix as character
      373   )
      374   :
      375     define variable v-date as date      no-undo .
      376     define variable v-time as integer   no-undo .
      377     run cur-time in this-procedure
      378       (output v-date
      379       ,output v-time
      380       ) .
      381     return
      382       p-prefix
      383       + string(v-date, p-date-format)
      384       + p-delimiter
      385       + string(v-time, p-time-format)
      386       + p-suffix
      387       .
      388   end.
      389   function cur-time-print  returns character
      390   :
      391     define variable v-date as date      no-undo .
      392     define variable v-time as integer   no-undo .
      393     run cur-time in this-procedure
      394       (output v-date
      395       ,output v-time
      396       ) .
      397     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      398   end.
      399   function cur-time-datetime returns datetime
      400   :
      401     define variable v-char as character no-undo .
      402     define variable v-datetime as datetime no-undo .
      403     v-char = cur-time-string().
      404     v-datetime = datetime(v-char).
      405     return  v-datetime.
      406   end.
      407   function cur-time-string-msec returns character
      408   :
      409     define variable v-date as datetime  no-undo .
      410     v-date = now.
      411     return string(v-date) .
      412   end.
      413   define variable vss-include-info3 as character format "X(65)" no-undo
      414   initial "@(#)$Workfile$ $Revision$".
      415   procedure xmlchar-test :
      416   define input parameter p-in-string          as character        no-undo.
      417   define output parameter p-out-string-enc    as character        no-undo.
      418   define output parameter p-out-string-dec    as character        no-undo.
      419   do
      420   on error undo, return error
      421   :
      422          run xmlchar-encode in this-procedure
      423       (
      424             input p-in-string
      425           , output p-out-string-enc
      426       ).
      427          run xmlchar-decode in this-procedure
      428       (
      429             input p-out-string-enc
      430           , output p-out-string-dec
      431       ).
      432   end.
      433   end .
      434   procedure xmlchar-encode :
      435   define input parameter p-in-string      as character        no-undo.
      436   define output parameter p-out-string    as character        no-undo.
      437       define variable v-position      as integer      no-undo.
      438       define variable v-current-char  as character    no-undo.
      439   do
      440   on error undo, return error
      441   :
      442       assign
      443           p-out-string = "":U
      444       .
      445       case p-in-string
      446       :
      447           when ?
      448           then do:
      449               assign
      450                   p-out-string = "?":U
      451               .
      452           end.
      453           when "?":U
      454           then do:
      455               assign
      456                   p-out-string = "&#63;":U
      457               .
      458           end.
      459           otherwise do:
      460               do v-position = 1 to length( p-in-string )
      461               :
      462                   assign
      463                       v-current-char = substring( p-in-string, v-position, 1 )
      464                   .
      465                   case v-current-char
      466                   :
      467                       when "&":U
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "&amp;":U
      471                           .
      472                       end.
      473                       when ">":U
      474                       then do:
      475                           assign
      476                               p-out-string = p-out-string + "&gt;":U
      477                           .
      478                       end.
      479                       when "<":U
      480                       then do:
      481                           assign
      482                               p-out-string = p-out-string + "&lt;":U
      483                           .
      484                       end.
      485                       when "'":U
      486                       then do:
      487                           assign
      488                               p-out-string = p-out-string + "&apos;":U
      489                           .
      490                       end.
      491                       when '"':U
      492                       then do:
      493                           assign
      494                               p-out-string = p-out-string + "&quot;":U
      495                           .
      496                       end.
      497                       when chr(1)
      498                       then do:
      499                           assign
      500                               p-out-string = p-out-string + "":U
      501                           .
      502                       end.
      503                       when chr(2)
      504                       then do:
      505                           assign
      506                               p-out-string = p-out-string + "":U
      507                           .
      508                       end.
      509                       when chr(3)
      510                       then do:
      511                           assign
      512                               p-out-string = p-out-string + "":U
      513                           .
      514                       end.
      515                       when chr(4)
      516                       then do:
      517                           assign
      518                               p-out-string = p-out-string + "":U
      519                           .
      520                       end.
      521                       when chr(5)
      522                       then do:
      523                           assign
      524                               p-out-string = p-out-string + "":U
      525                           .
      526                       end.
      527                       when chr(6)
      528                       then do:
      529                           assign
      530                               p-out-string = p-out-string + "":U
      531                           .
      532                       end.
      533                       when chr(7)
      534                       then do:
      535                           assign
      536                               p-out-string = p-out-string + "":U
      537                           .
      538                       end.
      539                       when chr(8)
      540                       then do:
      541                           assign
      542                               p-out-string = p-out-string + "":U
      543                           .
      544                       end.
      545                       when chr(9)
      546                       then do:
      547                           assign
      548                               p-out-string = p-out-string + "":U
      549                           .
      550                       end.
      551                       when chr(29)
      552                       then do:
      553                           assign
      554                               p-out-string = p-out-string + "":U
      555                           .
      556                       end.
      557                       when chr(10)
      558                       then do:
      559                           assign
      560                               p-out-string = p-out-string + "&#10;":U
      561                           .
      562                       end.
      563                       when chr(13)
      564                       then do:
      565                           assign
      566                               p-out-string = p-out-string + "&#13;":U
      567                           .
      568                       end.
      569                       otherwise do:
      570                           assign
      571                               p-out-string = p-out-string + v-current-char
      572                           .
      573                       end.
      574                   end case.
      575               end.
      576           end.
      577       end case.
      578   end.
      579   end .
      580   procedure xmlchar-encode-1c :
      581   define input parameter p-in-string      as character        no-undo.
      582   define output parameter p-out-string    as character        no-undo.
      583       define variable v-position      as integer      no-undo.
      584       define variable v-current-char  as character    no-undo.
      585   do
      586   on error undo, return error
      587   :
      588       assign
      589           p-out-string = "":U
      590       .
      591       case p-in-string
      592       :
      593           when ?
      594           then do:
      595               assign
      596                   p-out-string = "?":U
      597               .
      598           end.
      599           otherwise do:
      600               do v-position = 1 to length( p-in-string )
      601               :
      602                   assign
      603                       v-current-char = substring( p-in-string, v-position, 1 )
      604                   .
      605                   case v-current-char
      606                   :
      607                       when chr(1)
      608                       then do:
      609                           assign
      610                               p-out-string = p-out-string + " ":U
      611                           .
      612                       end.
      613                       when chr(2)
      614                       then do:
      615                           assign
      616                               p-out-string = p-out-string + " ":U
      617                           .
      618                       end.
      619                       when chr(3)
      620                       then do:
      621                           assign
      622                               p-out-string = p-out-string + " ":U
      623                           .
      624                       end.
      625                       when chr(4)
      626                       then do:
      627                           assign
      628                               p-out-string = p-out-string + " ":U
      629                           .
      630                       end.
      631                       when chr(5)
      632                       then do:
      633                           assign
      634                               p-out-string = p-out-string + " ":U
      635                           .
      636                       end.
      637                       when chr(6)
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + " ":U
      641                           .
      642                       end.
      643                       when chr(7)
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + " ":U
      647                           .
      648                       end.
      649                       when chr(8)
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + " ":U
      653                           .
      654                       end.
      655                       when chr(9)
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + " ":U
      659                           .
      660                       end.
      661                       when chr(29)
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + " ":U
      665                           .
      666                       end.
      667                       when chr(10)
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + " ":U
      671                           .
      672                       end.
      673                       when chr(13)
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + " ":U
      677                           .
      678                       end.
      679                       otherwise do:
      680                           assign
      681                               p-out-string = p-out-string + v-current-char
      682                           .
      683                       end.
      684                   end case.
      685               end.
      686           end.
      687       end case.
      688   end.
      689   end .
      690   procedure xmlchar-decode :
      691   define input parameter p-in-string      as character        no-undo.
      692   define output parameter p-out-string    as character        no-undo.
      693       define variable v-position      as integer      no-undo.
      694       define variable v-last-position as integer      no-undo.
      695       define variable v-temp-integer  as integer      no-undo.
      696       define variable v-current-char  as character    no-undo.
      697       define variable v-next-char     as character    no-undo.
      698       define variable v-success       as logical      no-undo.
      699   do
      700   on error undo, return error
      701   :
      702       assign
      703           p-out-string = "":U
      704           v-position   = 0
      705       .
      706       replace-cycle:
      707       do while yes
      708       on error undo, return error
      709       :
      710           assign
      711               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      712           .
      713           if v-last-position <= v-position
      714           then do:
      715               if v-position = 0
      716               then do:
      717                   assign
      718                       p-out-string = p-in-string
      719                   .
      720               end.
      721               else do:
      722                   assign
      723                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      724                   .
      725               end.
      726               leave replace-cycle.
      727           end.
      728           else do:
      729               assign
      730                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      731                   v-position      = v-last-position
      732                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      733               .
      734               if v-current-char = "#":U
      735               then do:
      736                   assign
      737                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      738                   .
      739                   if v-last-position > 0
      740                   then do:
      741                       run xmlchar-read-integer in this-procedure
      742                        (
      743                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      744                           , output v-temp-integer
      745                           , output v-success
      746                       ).
      747                       if v-success = yes
      748                       and v-temp-integer >= 1
      749                       and v-temp-integer <= 255
      750                       then do:
      751                           assign
      752                               p-out-string = p-out-string + chr( v-temp-integer )
      753                               v-position   = v-last-position + 1
      754                           .
      755                       end.
      756                       else do:
      757                           assign
      758                               p-out-string = p-out-string + "&":U
      759                               v-position   = v-position   + 1
      760                           .
      761                       end.
      762                   end.
      763                   else do:
      764                       assign
      765                           p-out-string = p-out-string + "&":U
      766                           v-position   = v-position   + 1
      767                       .
      768                   end.
      769               end.
      770               else do:
      771                   case substring( p-in-string, v-position + 1, 3 )
      772                   :
      773                       when "lt;":U
      774                       then do:
      775                           assign
      776                               p-out-string = p-out-string + "<":U
      777                               v-position   = v-position   + 3
      778                           .
      779                       end.
      780                       when "gt;":U
      781                       then do:
      782                           assign
      783                               p-out-string = p-out-string + ">":U
      784                               v-position   = v-position   + 3
      785                           .
      786                       end.
      787                       otherwise do:
      788                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      789                           then do:
      790                               assign
      791                                   p-out-string = p-out-string + "&":U
      792                                   v-position   = v-position   + 4
      793                               .
      794                           end.
      795                           else do:
      796                               case substring( p-in-string, v-position + 1, 5 )
      797                               :
      798                                   when "quot;":U
      799                                   then do:
      800                                       assign
      801                                           p-out-string = p-out-string + '"':U
      802                                           v-position   = v-position   + 5
      803                                       .
      804                                   end.
      805                                   when "apos;":U
      806                                   then do:
      807                                       assign
      808                                           p-out-string = p-out-string + "'":U
      809                                           v-position   = v-position   + 5
      810                                       .
      811                                   end.
      812                                   otherwise do:
      813                                       assign
      814                                           p-out-string = p-out-string + "&":U
      815                                       .
      816                                   end.
      817                               end case.
      818                           end.
      819                       end.
      820                   end case.
      821               end.
      822           end.
      823       end.
      824   end.
      825   end .
      826   procedure xmlchar-read-integer :
      827   define input parameter p-input-string      as character        no-undo.
      828   define output parameter p-output-integer   as integer          no-undo.
      829   define output parameter p-success       as logical          no-undo.
      830   do
      831   on error undo, return error
      832   :
      833       assign
      834           p-output-integer = integer( p-input-string )
      835       no-error.
      836       if error-status :error
      837       then do:
      838           assign
      839               p-success           = no
      840               p-output-integer    = 0
      841           .
      842       end.
      843       else do:
      844           assign
      845               p-success           = yes
      846           .
      847       end.
      848   end.
      849   end.
      850   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      851   procedure strtdate :
      852     define input  parameter p-str         as character no-undo .
      853     define output parameter p-value       as date      no-undo .
      854     define output parameter p-data-valid  as logical   no-undo .
      855     define output parameter p-message     as character no-undo .
      856   do
      857   on error undo, return error return-value
      858   :
      859     define variable v-value       as date      no-undo .
      860     define variable v-i           as integer   no-undo .
      861     define variable v-num         as integer   no-undo .
      862     define variable v-delim       as character no-undo .
      863     define variable v-delim-list  as character no-undo .
      864     define variable v-day         as integer   no-undo .
      865     define variable v-month       as integer   no-undo .
      866     define variable v-year        as integer   no-undo .
      867     define variable v-day-str     as character no-undo .
      868     define variable v-month-str   as character no-undo .
      869     define variable v-year-str    as character no-undo .
      870     assign
      871       p-value       = ?
      872       p-data-valid  = false
      873     .
      874     if p-str = ?
      875     then do:
      876       assign
      877         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      878       .
      879       return .
      880     end.
      881     if p-str = ""
      882     then do:
      883       assign
      884         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      885       .
      886       return .
      887     end.
      888     if length(p-str)  > 10
      889     then do:
      890       assign
      891         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      892       .
      893       return .
      894     end.
      895     assign
      896       v-delim-list = '/,-,.':U
      897     .
      898     _delim:
      899     do v-i = 1 to num-entries( v-delim-list )
      900     :
      901       assign
      902         v-delim = entry( v-i , v-delim-list )
      903         v-num   = num-entries( p-str , v-delim )
      904       .
      905       if v-num <> 3
      906       then do:
      907         assign
      908           v-delim = ''
      909         .
      910       end.
      911       else do:
      912         leave _delim.
      913       end.
      914     end.
      915     if v-delim = ''
      916     then do:
      917       assign
      918         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      919       .
      920       return .
      921     end.
      922     assign
      923       v-day-str   = entry( 1, p-str , v-delim)
      924       v-month-str = entry( 2, p-str , v-delim)
      925       v-year-str  = entry( 3, p-str , v-delim)
      926     .
      927     if  length(v-day-str) > 2   or
      928         length(v-day-str) < 1   or
      929         length(v-month-str) > 2 or
      930         length(v-month-str) < 1 or
      931         (
      932           length(v-year-str) <> 2 and
      933           length(v-year-str) <> 4
      934         )
      935     then do:
      936       assign
      937         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      938       .
      939       return .
      940     end.
      941     if length( v-year-str ) = 2
      942     then do:
      943       assign
      944         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      945       .
      946     end.
      947     assign
      948       v-day   = integer( v-day-str )
      949       v-month = integer( v-month-str)
      950       v-year  = integer( v-year-str)
      951     no-error .
      952     if error-status :error
      953     then do:
      954       assign
      955         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      956       .
      957       return .
      958     end.
      959     if v-day < 1  or
      960        v-day > 31 or
      961        v-month < 1 or
      962        v-month > 12 or
      963        v-year < 0   or
      964        v-year > 5000
      965     then do:
      966       assign
      967         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      968       .
      969       return .
      970     end.
      971     assign
      972       v-value = date( v-month, v-day, v-year )
      973     no-error .
      974     if error-status :error
      975     then do:
      976       assign
      977         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      978       .
      979       return .
      980     end.
      981     assign
      982       p-value       = v-value
      983       p-data-valid  = true
      984     .
      985   end.
      986   end procedure.
      987   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
