     1467   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1468   define variable v-waitfram-action01         as character   no-undo .
     1469   define variable v-waitfram-action02         as character   no-undo .
     1470   define variable v-waitfram-action03         as character   no-undo .
     1471   define variable mWaitFramTextBeg            as character   no-undo.
     1472   define variable mWaitFramTextEnd            as character   no-undo.
     1473   define variable mWaitFramView               as logical     no-undo.
     1474   define variable mWaitProcEvent              as logical     no-undo init yes.
     1475   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1476   define variable mWaitFramStop               as logical     no-undo.
     1477   define variable mWaitFramStopUser           as logical     no-undo.
     1478   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1479   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1480   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1481   define button B-WaitFramStop auto-end-key
     1482        label "Стоп"
     1483        size 10 by 1 tooltip "Остоновить процесс".
     1484   define button B-viewProcInfo
     1485        label "Информация"
     1486        size 15 by 1 tooltip "Информация о процесс".
     1487   define frame waitfram
     1488     v-waitfram-action01 format "x(72)" no-label skip
     1489     v-waitfram-action02 format "x(72)" no-label skip
     1490     v-waitfram-action03 format "x(72)" no-label skip
     1491     B-viewProcInfo
     1492     B-WaitFramStop at row 4 col 30
     1493     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1494     .
     1495   define new global shared variable mBatchMode as logical no-undo init ?.
     1496   define variable mFramBachModHandle as handle no-undo.
     1497   mFramBachModHandle = frame waitfram:handle.
     1498   define variable mFameOldVis as logical no-undo.
     1499   define variable mVisCUrentVin as logical no-undo.
     1500   if session:batch-mode
     1501   then
     1502      mBatchMode = yes.
     1503   if mBatchMode = ? then do:
     1504     mVisCUrentVin = current-window:visible.
     1505     mFameOldVis = mFramBachModHandle:visible.
     1506     mFramBachModHandle:visible  = yes.
     1507     mBatchMode = mFramBachModHandle:visible ne yes.
     1508     mFramBachModHandle:visible = mFameOldVis.
     1509     current-window:visible = mVisCUrentVin.
     1510   end.
     1511    if  log-manager:logfile-name ne ?
     1512     then DO:
     1513         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1514         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1515         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1516     end.
     1517   on choose of B-WaitFramStop in frame waitfram
     1518   do:
     1519     mWaitFramStop = yes.
     1520     mWaitFramStopUser = yes.
     1521   end.
     1522   function waitfram-check-timeout returns logical():
     1523      define variable vtime as int64 no-undo.
     1524      if mWaitFramStopTimeOut
     1525      then
     1526         return yes.
     1527      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1528      if     mWaitFramTimeOut ne ?
     1529         and mWaitFramTimeOut ne 0
     1530         and mWaitFramTimeOut lt vtime
     1531      then do:
     1532         mWaitFramStopTimeOut = yes.
     1533      end.
     1534      return mWaitFramStopTimeOut.
     1535   end.
     1536   procedure waitfram-hide :
     1537     if not session:batch-mode
     1538     then do
     1539     on error undo, return error return-value
     1540     :
     1541       pause 0 before-hide .
     1542       if not mBatchMode then
     1543         hide frame waitfram .
     1544     if     not mWaitFramView
     1545        and mWaitProcEvent
     1546     then
     1547       process events .
     1548     end.
     1549   end procedure.
     1550   procedure waitfram-show :
     1551     define input  parameter p-message as character no-undo .
     1552     define variable v-left-margin as integer   no-undo .
     1553     if not session:batch-mode
     1554     then do
     1555     on error undo, return error return-value
     1556     :
     1557       if length(p-message) <= 70 then do:
     1558         assign
     1559           v-left-margin = integer((70 - length(p-message)) / 2)
     1560         .
     1561         assign
     1562           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1563         .
     1564         assign
     1565           v-waitfram-action01 = " "
     1566           v-waitfram-action02 = " "
     1567                                    + fill(" ", v-left-margin)
     1568                                    + p-message
     1569           v-waitfram-action03 = " "
     1570         .
     1571       end.
     1572       else do:
     1573         define variable vRindex1 as integer no-undo.
     1574         define variable vRindex2 as integer no-undo.
     1575         vRindex1 = r-index(p-message," ",70).
     1576         if vRindex1 = 0
     1577         then
     1578            vRindex1 = 70.
     1579         if length(p-message)  <= vRindex1 + 70 then do:
     1580           assign
     1581             v-waitfram-action01 = " "
     1582             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1583             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1584           .
     1585         end.
     1586         else do:
     1587           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1588           if vRindex2 <= vRindex1
     1589           then
     1590              vRindex2 = vRindex1 + 70.
     1591           assign
     1592             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1593             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1594             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1595           .
     1596         end.
     1597       end.
     1598       B-viewProcInfo:visible   in frame waitfram = no.
     1599       B-viewProcInfo:sensitive in frame waitfram = no.
     1600       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1601       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1602       if  (   mWaitFramView
     1603          or  mWaitProcEvent)
     1604          and not mBatchMode
     1605       then
     1606          display
     1607             v-waitfram-action01 skip
     1608             v-waitfram-action02 skip
     1609             v-waitfram-action03 skip
     1610          with frame waitfram .
     1611       if     mWaitFramView
     1612          then do:
     1613             if     mWaitFramInterval ne ?
     1614                and not mBatchMode
     1615             then
     1616                wait-for go of frame waitfram pause mWaitFramInterval.
     1617          end.
     1618          else
     1619             if     mWaitProcEvent
     1620                and not mBatchMode
     1621             then
     1622                process events .
     1623     end.
     1624   end procedure.
     1625      procedure waitfram-show-this:
     1626         define input  parameter iInterval as int64 no-undo.
     1627         define variable vtime as int64 no-undo.
     1628         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1629         mWaitFramInterval = iInterval.
     1630         run waitfram-show (substitute("&1&2 &3&4" ,
     1631                                       mWaitFramTextBeg ,
     1632                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1633                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1634                                       mWaitFramTextEnd
     1635                                      )
     1636                           ).
     1637      end.
     1638      procedure WaitFramRunPause:
     1639         define input  parameter iInterval as dec no-undo.
     1640         define variable vStart  as datetime-tz no-undo.
     1641         define variable vend    as datetime-tz no-undo.
     1642         define variable vint as int64 no-undo.
     1643         define variable vOk as logical no-undo.
     1644         vStart = now.
     1645         vend   = vStart.
     1646         publish "WaitFramPause" (iInterval,output vOk).
     1647         vend   =  now.
     1648         vint = vend - vStart.
     1649         vint = iInterval - vint / 1000.
     1650         if     not mWaitFramStop
     1651            and (   vint > 0
     1652                 or (    not vOk
     1653                     and iInterval eq ?
     1654                     )
     1655                 )
     1656         then
     1657            run waitfram-show-this (iInterval).
     1658         vend   =  now.
     1659         vint = vend - vStart.
     1660         vint = iInterval - vint / 1000.
     1661         if     not mWaitFramStop
     1662            and vint > 0
     1663         then do:
     1664            run gbl/pause.p (vint * 1000).
     1665         end.
     1666         if iInterval ne ?
     1667         then
     1668            publish "WaitFramStop".
     1669         waitfram-check-timeout().
     1670      end.
     1671      procedure WaitFramWaitFor:
     1672         define input  parameter iInterval as dec no-undo.
     1673         assign
     1674            mWaitFramStartProc   = now
     1675            mWaitFramStopUser    = no
     1676            mWaitFramStopTimeOut = no
     1677         .
     1678         block-wait:
     1679         do while not mWaitFramStop:
     1680            run WaitFramRunPause (iInterval).
     1681            if  waitfram-check-timeout()
     1682            then do:
     1683               leave block-wait.
     1684            end.
     1685         end.
     1686         run waitfram-hide.
     1687      end.
     1688   procedure waitfram-join :
     1689     define input  parameter p-line-1  as character no-undo .
     1690     define input  parameter p-line-2  as character no-undo .
     1691     define input  parameter p-line-3  as character no-undo .
     1692     define output parameter p-message as character no-undo .
     1693     do
     1694     on error undo, return error return-value
     1695     :
     1696       assign
     1697         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1698                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1699                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1700       .
     1701     end.
     1702   end procedure.
     1703   function waitfram-join-function returns character
     1704     (input p-line-1 as character
     1705     ,input p-line-2 as character
     1706     ,input p-line-3 as character
     1707     ).
     1708     define variable v-message as character no-undo .
     1709     run waitfram-join in this-procedure
     1710       (input  p-line-1
     1711       ,input  p-line-2
     1712       ,input  p-line-3
     1713       ,output v-message
     1714       ) .
     1715     return v-message .
     1716   end function .
     1717   DEFINE BUTTON btn_asw
     1718        LABEL "Получить ответ и сохр."
     1719        SIZE 22.5 BY 1.13.
     1720   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1721        LABEL "Выход"
     1722        SIZE 8.5 BY 1.13
     1723        BGCOLOR 8 .
     1724   DEFINE BUTTON btn_del
     1725        LABEL "Удалить"
     1726        SIZE 9 BY 1.13.
     1727   DEFINE BUTTON Btn_desmark
     1728        LABEL "-"
     1729        SIZE 3.5 BY 1.13.
     1730   DEFINE BUTTON btn_look
     1731        LABEL "Просмотр"
     1732        SIZE 9 BY 1.13.
     1733   DEFINE BUTTON Btn_mark
     1734        LABEL "*"
     1735        SIZE 3.5 BY 1.13.
     1736   DEFINE BUTTON Btn_markall
     1737        LABEL "+"
     1738        SIZE 3.5 BY 1.13.
     1739   DEFINE BUTTON btn_refresh
     1740        LABEL "Обновить"
     1741        SIZE 9 BY 1.13.
     1742   DEFINE BUTTON btn_req
     1743        LABEL "Запрос"
     1744        SIZE 9 BY 1.13.
     1745   DEFINE VARIABLE f-alcgds AS CHARACTER FORMAT "X(256)":U
     1746        LABEL "Алк. код товара"
     1747        VIEW-AS FILL-IN
     1748        SIZE 15 BY 1 NO-UNDO.
     1749   DEFINE VARIABLE f-gds AS CHARACTER FORMAT "X(256)":U
     1750        LABEL "Справка 1"
     1751        VIEW-AS FILL-IN
     1752        SIZE 15.13 BY 1 NO-UNDO.
     1753   DEFINE VARIABLE f-gdsname AS CHARACTER FORMAT "X(256)":U
     1754        LABEL "Назв. товара"
     1755        VIEW-AS FILL-IN
     1756        SIZE 17.63 BY 1 NO-UNDO.
     1757   DEFINE VARIABLE t-incorr AS LOGICAL INITIAL no
     1758        LABEL "Некорр."
     1759        VIEW-AS TOGGLE-BOX
     1760        SIZE 11.13 BY .83 NO-UNDO.
     1761   DEFINE FRAME Dialog-Frame
     1762        Btn_Cancel AT ROW 1.25 COL 2
     1763        Btn_mark AT ROW 1.25 COL 12.5 WIDGET-ID 4
     1764        Btn_markall AT ROW 1.25 COL 16.75 WIDGET-ID 6
     1765        Btn_desmark AT ROW 1.25 COL 21 WIDGET-ID 8
     1766        btn_look AT ROW 1.25 COL 25.25 WIDGET-ID 14
     1767        btn_refresh AT ROW 1.25 COL 34.88 WIDGET-ID 18
     1768        btn_req AT ROW 1.25 COL 44.38 WIDGET-ID 36
     1769        btn_asw AT ROW 1.25 COL 54 WIDGET-ID 38
     1770        btn_del AT ROW 1.25 COL 77
     1771        f-gds AT ROW 2.75 COL 12.38 COLON-ALIGNED WIDGET-ID 20
     1772        f-alcgds AT ROW 2.75 COL 45.13 COLON-ALIGNED WIDGET-ID 22
     1773        f-gdsname AT ROW 2.75 COL 75.25 COLON-ALIGNED WIDGET-ID 24
     1774        t-incorr AT ROW 2.75 COL 95.75 WIDGET-ID 28
     1775        SPACE(2.36) SKIP(22.16)
     1776       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1777            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1778            TITLE "Справочник справок 1 ЕГАИС"
     1779            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1780   ASSIGN
     1781          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1782          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1783   ASSIGN
     1784          btn_del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1785   do:
     1786       apply "END-ERROR":U to self.
     1787     end.
     1788   ON CHOOSE OF btn_asw IN FRAME Dialog-Frame
     1789   DO:
     1790     def var egaisJournal        as class  Journal        no-undo.
     1791     def var ExtFormF1ValueObj      as class  ExtFormF1Value no-undo.
     1792     def var ExtFormF1ValueObjDB    as class  ExtFormF1Value no-undo.
     1793     def var egaisFormF1        as class  FormF1         no-undo.
     1794     def var bh-journal-egais    as handle no-undo.
     1795     def var qh-journal-egais    as handle no-undo.
     1796     def var bh-gds-egais-gotten as handle no-undo.
     1797     def var msg                 as character no-undo.
     1798     def var ii                  as integer   no-undo.
     1799     def var jj                  as integer   no-undo.
     1800     def var isQHEmpty           as logical no-undo init true.
     1801     os-delete value (search ("logFormF1.txt")).
     1802     output stream str1 to "logFormF1.txt".
     1803     egaisJournal = new Journal ().
     1804     bh-journal-egais = egaisJournal:GetHndlTable().
     1805     create query qh-journal-egais.
     1806     qh-journal-egais:set-buffers (bh-journal-egais) .
     1807     qh-journal-egais:query-prepare ( substitute ("for each tt_journal-egais where jou-subject = '&1' and jou-status = 'Запрос отправлен' ", 'Справочник справок 1')).
     1808     qh-journal-egais:query-open.
     1809     run waitfram-show in this-procedure ("Ждите... Идет обработка ответов.") .
     1810     journal_:
     1811     do while qh-journal-egais:get-next ():
     1812       isQHEmpty = false.
     1813       egaisFormF1 = new FormF1 (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, entry (2, bh-journal-egais:buffer-field ("jou-param"):buffer-value, '|')).
     1814       egaisFormF1:DbNum = v-db-num.
     1815       egaisFormF1:User_Id = v-user-id.
     1816       glog = egaisFormF1:StatusErr .
     1817       if glog then do :
     1818           msg = msg + chr(10) + egaisFormF1:Msg.
     1819       end.
     1820       else do:
     1821         bh-gds-egais-gotten = egaisFormF1:GetHndlTable() .
     1822         if egaisFormF1:Msg = 'Не удалось получить данные от UTM'
     1823         then do:
     1824           message egaisFormF1:Msg + ". Проверьте соединение с УТМ." view-as alert-box error.
     1825           run waitfram-hide in this-procedure.
     1826           return.
     1827         end.
     1828         if bh-gds-egais-gotten = ? or not bh-gds-egais-gotten:find-first ()
     1829         then do:
     1830           put stream str1 unformatted chr(10) + egaisFormF1:Msg.
     1831           delete object egaisFormF1.
     1832           next journal_.
     1833         end.
     1834         ExtFormF1ValueObj = cast (bh-gds-egais-gotten:buffer-field("extFormF1ValueObj"):buffer-value, ibs.th.bge.egais.ExtFormF1Value).
     1835         ExtFormF1Obj:OpenQueryExtFormF1 (bh-gds-egais-gotten:buffer-field("formF1code"):buffer-value).
     1836         do ii = 1 to ExtFormF1Obj:NumBundles:
     1837           ExtFormF1ValueObjDB = ExtFormF1Obj:GetExtFormF1Value(ii).
     1838           assign
     1839             ExtFormF1ValueObjDB:BottlingDate = ExtFormF1ValueObj:BottlingDate
     1840             ExtFormF1ValueObjDB:CliRegIdOrigCli = ExtFormF1ValueObj:CliRegIdOrigCli
     1841             ExtFormF1ValueObjDB:CliEgaisTypeOrigCli = ExtFormF1ValueObj:CliEgaisTypeOrigCli
     1842             ExtFormF1ValueObjDB:INNOrigCli = ExtFormF1ValueObj:INNOrigCli
     1843             ExtFormF1ValueObjDB:KPPOrigCli = ExtFormF1ValueObj:KPPOrigCli
     1844             ExtFormF1ValueObjDB:FullNameOrigCli = ExtFormF1ValueObj:FullNameOrigCli
     1845             ExtFormF1ValueObjDB:CountryOrigCli = ExtFormF1ValueObj:CountryOrigCli
     1846             ExtFormF1ValueObjDB:RegionOrigCli = ExtFormF1ValueObj:RegionOrigCli
     1847             ExtFormF1ValueObjDB:DescrOrigCli = ExtFormF1ValueObj:DescrOrigCli
     1848           .
     1849           ExtFormF1Obj:SaveEGAISInfo(ExtFormF1ValueObjDB).
     1850           bh-egais-goods:find-first (substitute ("where alcCode = '&1' and formF1Code = '&2'", ExtFormF1ValueObjDB:AlcCode, ExtFormF1ValueObjDB:FormF1Code )).
     1851           bh-egais-goods:buffer-field ('ColorNum'):buffer-value () = YELLOW_COLOR .
     1852           put stream str1 unformatted chr(10) substitute ('Запись &1/&2 обновлена', bh-egais-goods:buffer-field ('alcCode'):buffer-value (), bh-egais-goods:buffer-field ('formF1Code'):buffer-value () ).
     1853           jj = jj + 1.
     1854         end.
     1855       end.
     1856       delete object egaisFormF1.
     1857     end.
     1858     run waitfram-hide in this-procedure.
     1859     output stream str1 close.
     1860     file-info:file-name = search ("logFormF1.txt").
     1861     if search ("logFormF1.txt") <> ? and file-info:file-size > 0
     1862     then do:
     1863       run gbl/prnfilen.w
     1864       (input  "Отчёт о запросах"
     1865       ,input  0
     1866       ,input  search ("logFormF1.txt")
     1867       ,input  7
     1868       ,output v-user-action
     1869       ,output v-printed
     1870       ) .
     1871     end.
     1872     if isQHEmpty
     1873     then do:
     1874       delete object qh-journal-egais.
     1875       delete object egaisJournal.
     1876       message "Нет открытых запросов." view-as alert-box information title "Сообщение".
     1877       return.
     1878     end.
     1879     else message substitute ("Завершено. Получено &1 записей. Сохраненные записи подсвечены желтым.", jj) view-as alert-box information title "Сообщение".
     1880     delete object qh-journal-egais.
     1881     delete object egaisJournal.
     1882     run refresh-view.
     1883   END.
     1884   ON choose OF btn_del IN FRAME Dialog-Frame
     1885   do:
     1886     def var cmd as char no-undo.
     1887     def var qh-del as handle no-undo.
     1888     run refresh-view.
     1889   end.
     1890   ON choose OF Btn_desmark IN FRAME Dialog-Frame
     1891   do:
     1892     if not qh-egais-goods:is-open
     1893       then return no-apply.
     1894     if qh-egais-goods:get-first ()
     1895       then bh-egais-goods:buffer-field (1):buffer-value () = "".
     1896     do while qh-egais-goods:get-next ():
     1897       bh-egais-goods:buffer-field (1):buffer-value () = "".
     1898     end.
     1899     if qh-egais-goods:get-first ()
     1900       then browse-hdl-egais-goods:refresh ().
     1901   end.
     1902   ON choose OF btn_look IN FRAME Dialog-Frame
     1903   do:
     1904     run msdblcl.
     1905   end.
     1906   ON choose OF Btn_mark IN FRAME Dialog-Frame
     1907   do:
     1908     if bh-egais-goods:available
     1909     then do:
     1910       if bcol[1]:screen-value = "*"
     1911         then do:
     1912           assign
     1913             bh-egais-goods:buffer-field (1):buffer-value () = ""
     1914             bcol[1]:screen-value = ""
     1915             .
     1916         end.
     1917         else do:
     1918           assign
     1919             bh-egais-goods:buffer-field (1):buffer-value () = "*"
     1920             bcol[1]:screen-value = "*"
     1921             .
     1922        end.
     1923        browse-hdl-egais-goods:select-next-row( ).
     1924     end.
     1925   end.
     1926   ON choose OF Btn_markall IN FRAME Dialog-Frame
     1927   do:
     1928     if qh-egais-goods:get-first ()
     1929       then bh-egais-goods:buffer-field (1):buffer-value () = "*".
     1930     do while qh-egais-goods:get-next ():
     1931       bh-egais-goods:buffer-field (1):buffer-value () = "*".
     1932     end.
     1933     if qh-egais-goods:get-first ()
     1934       then browse-hdl-egais-goods:refresh ().
     1935   end.
     1936   ON CHOOSE OF btn_refresh IN FRAME Dialog-Frame
     1937   DO:
     1938     ExtFormF1Obj:GetHndlTable("", "", input-output bh-egais-goods).
     1939     run refresh-view.
     1940   END.
     1941   ON CHOOSE OF btn_req IN FRAME Dialog-Frame
     1942   DO:
     1943     def var egaisFormF1 as class FormF1 no-undo.
     1944     def var qh-egais-goods-mark as handle no-undo.
     1945     def var isQHEmpty as logical no-undo init true.
     1946     create query qh-egais-goods-mark.
     1947     qh-egais-goods-mark:set-buffers (bh-egais-goods).
     1948     qh-egais-goods-mark:query-prepare ("for each tt-egaisformf1-hndls where mark = '*' ").
     1949     qh-egais-goods-mark:query-open.
     1950     run waitfram-show in this-procedure ("Ждите... Идет отправка запросов.") .
     1951     do while qh-egais-goods-mark:get-next ():
     1952       isQHEmpty = false.
     1953       egaisFormF1 = new FormF1 (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, bh-egais-goods:buffer-field ("formF1Code"):buffer-value).
     1954       egaisFormF1:DbNum = v-db-num.
     1955       egaisFormF1:User_Id = v-user-id.
     1956       egaisFormF1:SendRequestUTM() .
     1957       glog = egaisFormF1:StatusErr .
     1958       if glog then do :
     1959           message egaisFormF1:Msg view-as alert-box.
     1960           run waitfram-hide in this-procedure.
     1961           return no-apply.
     1962       end.
     1963       delete object egaisFormF1.
     1964     end.
     1965     delete object qh-egais-goods-mark.
     1966     run waitfram-hide in this-procedure .
     1967     if isQHEmpty
     1968     then do:
     1969       message "Для отправки запросов отметьте справки 1." view-as alert-box information title "Информация".
     1970       return.
     1971     end.
     1972     apply "choose" to Btn_desmark in frame Dialog-Frame.
     1973   END.
     1974   ON leave OF f-alcgds IN FRAME Dialog-Frame
     1975   do:
     1976     if f-alcgds:screen-value = f-alcgds
     1977       then return.
     1978     run refresh-view.
     1979   end.
     1980   ON return OF f-alcgds IN FRAME Dialog-Frame
     1981   do:
     1982     run refresh-view.
     1983   end.
     1984   ON leave OF f-gds IN FRAME Dialog-Frame
     1985   do:
     1986     if f-gds:screen-value = f-gds
     1987       then return.
     1988     run refresh-view.
     1989   end.
     1990   ON return OF f-gds IN FRAME Dialog-Frame
     1991   do:
     1992     run refresh-view.
     1993   end.
     1994   ON leave OF f-gdsname IN FRAME Dialog-Frame
     1995   do:
     1996     if f-gdsname:screen-value = f-gdsname
     1997       then return.
     1998     run refresh-view.
     1999   end.
     2000   ON return OF f-gdsname IN FRAME Dialog-Frame
     2001   do:
     2002     run refresh-view.
     2003   end.
     2004   ON VALUE-CHANGED OF t-incorr IN FRAME Dialog-Frame
     2005   DO:
     2006     run refresh-view.
     2007   END.
     2008   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     2009     then frame Dialog-Frame:PARENT = active-window.
     2010   MAIN-BLOCK:
     2011   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2012     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2013     def var ii as int no-undo.
     2014     def var v-windth as integer no-undo.
     2015     def var v-isDisp as character no-undo.
     2016   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2017   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     2018     (output v-db-num
     2019     ,output v-user-id
     2020     ) no-error .
     2021   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2022     run mainmenu_getcntxt in parparentproc
     2023       (output v-cntxt-db-num
     2024       ,output v-cntxt-userid
     2025       ,output v-cntxt-level
     2026       ,output v-cntxt-host-code-obj
     2027       ,output v-cntxt-obj-type
     2028       ,output v-cntxt-obj-code
     2029       ,output v-cntxt-db-num-obj
     2030       ,output v-cntxt-is-admin
     2031       ) .
     2032     empty temp-table thbjattr_thbj-attr .
     2033     run adm/shattri.p (
     2034          input "get":U
     2035         ,input v-cntxt-obj-type
     2036         ,input v-cntxt-obj-code
     2037         ,input 'egais':U
     2038         ,input 'egais-fsrar':U
     2039         ,output v-value-character
     2040         ,output v-value-date
     2041         ,output v-value-decimal
     2042         ,output v-value-integer
     2043         ,output v-value-logical
     2044         ,output v-value-type
     2045         ,input-output TABLE thbjattr_thbj-attr
     2046         ) no-error .
     2047     assign
     2048       v-fs-rar = v-value-character
     2049     .
     2050     run adm/shattri.p (
     2051          input "get":U
     2052         ,input '':U
     2053         ,input 0
     2054         ,input 'egais':U
     2055         ,input 'egais-exsys':U
     2056         ,output v-value-character
     2057         ,output v-value-date
     2058         ,output v-value-decimal
     2059         ,output v-value-integer
     2060         ,output v-value-logical
     2061         ,output v-value-type
     2062         ,input-output TABLE thbjattr_thbj-attr
     2063         ) no-error .
     2064     assign v-ext-sys = v-value-integer.
     2065     create browse browse-hdl-egais-goods
     2066       assign
     2067       title     = 'Товары'
     2068       frame     = frame Dialog-Frame:handle
     2069       query     = qh-egais-goods
     2070       x         = 10
     2071       y         = 70
     2072       width     = 107
     2073       height    = 21.5
     2074       visible   = true
     2075       read-only = true
     2076       sensitive = true
     2077       separators = true
     2078       column-resizable = true
     2079       triggers:
     2080         on mouse-move-dblclick persistent run msdblcl.
     2081         on row-display persistent run proc-row-disp.
     2082       end triggers
     2083       .
     2084     ExtFormF1Obj = new ExtFormF1 (yes).
     2085     ExtFormF1Obj:DbNum = v-db-num.
     2086     ExtFormF1Obj:GetHndlTable("", "", input-output bh-egais-goods).
     2087     create query qh-egais-goods.
     2088     qh-egais-goods:set-buffers (bh-egais-goods).
     2089     browse-hdl-egais-goods:query = qh-egais-goods.
     2090     extent (bcol) = bh-egais-goods:num-fields.
     2091     do ii = 1 to bh-egais-goods:num-fields:
     2092       bcol[ii] = browse-hdl-egais-goods:add-like-column('tt-egaisformf1-hndls' + '.' + bh-egais-goods:buffer-field (ii):name, 0, 'FILL-IN').
     2093       if entry (ii, ExtFormF1Obj:SettingsTTList, ';') <> ""
     2094       then do:
     2095         v-windth = integer (entry (1, entry (ii, ExtFormF1Obj:SettingsTTList, ';'))).
     2096         v-isDisp = entry (2, entry (ii, ExtFormF1Obj:SettingsTTList, ';')).
     2097         assign
     2098           bcol[ii]:width = v-windth when v-windth > 0
     2099           bcol[ii]:visible = false when v-isDisp = "no"
     2100         .
     2101       end.
     2102     end.
     2103   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2104   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2105   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2106   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2107   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2108   define variable v-diasize-current-frame-height as decimal   no-undo .
     2109   define variable v-diasize-change-size          as logical   no-undo .
     2110   define variable v-diasize-resize-button        as handle    no-undo .
     2111   define variable v-diasize-wndmax               as logical   no-undo .
     2112   define variable v-diasize-wndstore             as logical   no-undo .
     2113   define variable v-diasize-proc-name            as character no-undo .
     2114   define variable v-diasize-browse-handle        as handle    no-undo .
     2115   define variable v-diasize-browse-number        as integer   no-undo .
     2116   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2117   define temp-table temp-diasize-handle no-undo
     2118     field handle-value  as handle
     2119     field save-position as decimal
     2120     index xpk is primary unique handle-value
     2121     .
     2122   define temp-table temp-browse-handle no-undo
     2123     field browse-type   as character
     2124     field browse-number as integer
     2125     field browse-handle as handle
     2126     field original-size as decimal
     2127     index xpk is primary unique browse-type browse-number
     2128     index xie browse-type browse-handle
     2129   .
     2130   procedure diasize_change-height :
     2131     define input  parameter p-change-value  as decimal   no-undo .
     2132     define input  parameter p-move-resize   as logical   no-undo .
     2133     define variable v-field-group-handle    as handle    no-undo .
     2134     define variable v-object-handle         as handle    no-undo .
     2135     define variable v-frame-height          as decimal   no-undo .
     2136     define variable v-frame-virtual-height  as decimal   no-undo .
     2137     define variable v-browse-height         as decimal   no-undo .
     2138     define variable v-window-height         as decimal   no-undo .
     2139     define variable v-window-virtual-height as decimal   no-undo .
     2140     define variable v-change-sign           as integer   no-undo .
     2141     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2142     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2143     if p-change-value > 0
     2144     then do:
     2145       if frame Dialog-Frame :height + p-change-value
     2146           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2147       then do:
     2148         assign
     2149           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2150                           - (frame Dialog-Frame :height-chars)
     2151         .
     2152         if p-change-value <= 0
     2153         then do:
     2154           run diasize_position-resize-button in this-procedure .
     2155           return .
     2156         end.
     2157       end.
     2158     end.
     2159     if p-change-value < 0
     2160     then do:
     2161       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2162       then do:
     2163         assign
     2164           p-change-value = v-diasize-orig-frame-height
     2165                          - (frame Dialog-Frame :height-chars)
     2166         .
     2167         if p-change-value >= 0
     2168         then do:
     2169           run diasize_position-resize-button in this-procedure .
     2170           return .
     2171         end.
     2172       end.
     2173     end.
     2174     if p-change-value >= 0
     2175     then do:
     2176       assign
