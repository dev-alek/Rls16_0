     2795               no-error .
     2796             if error-status :error
     2797             or error-status :get-message(1) <> ""
     2798             then do:
     2799               undo move_block, retry move_block .
     2800             end.
     2801           end.
     2802         end.
     2803       end.
     2804       else do:
     2805         for each buf_temp-diasize-handle
     2806         on error undo move_block, retry move_block
     2807         :
     2808           assign
     2809             v-object-handle = buf_temp-diasize-handle.handle-value
     2810           .
     2811           if v-object-handle <> v-diasize-resize-button
     2812           then do:
     2813             assign
     2814               v-object-handle :col = v-object-handle :col + p-change-value
     2815               no-error .
     2816             if error-status :error
     2817             or error-status :get-message(1) <> ""
     2818             then do:
     2819               undo move_block, retry move_block .
     2820             end.
     2821           end.
     2822         end.
     2823         for each buf_temp-browse-handle
     2824           where buf_temp-browse-handle.browse-type = 'width':u
     2825         on error undo move_block, retry move_block
     2826         :
     2827           assign
     2828             buf_temp-browse-handle.browse-handle :width
     2829               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2830             no-error .
     2831           if error-status :error
     2832           or error-status :get-message(1) <> ""
     2833           then do:
     2834             undo move_block, retry move_block .
     2835           end.
     2836         end.
     2837         assign
     2838           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2839           no-error .
     2840         if error-status :error
     2841         or error-status :get-message(1) <> ""
     2842         then do:
     2843           undo move_block, retry move_block.
     2844         end.
     2845         assign
     2846           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2847         no-error .
     2848         if error-status :error
     2849         or error-status :get-message(1) <> ""
     2850         then do:
     2851           undo move_block, retry move_block.
     2852         end.
     2853         if frame Dialog-Frame :scrollable = true
     2854         then do:
     2855           assign
     2856             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2857           no-error .
     2858           if error-status :error
     2859           or error-status :get-message(1) <> ""
     2860           then do:
     2861             undo move_block, retry move_block.
     2862           end.
     2863         end.
     2864       end.
     2865       if p-move-resize
     2866       then do:
     2867         run diasize_position-resize-button in this-procedure .
     2868       end.
     2869       if v-diasize-wndstore = true
     2870       then do:
     2871         if connected("ub") = true
     2872         then do:
     2873           define variable v-cntxt-db-num        as integer   no-undo .
     2874           define variable v-cntxt-userid        as character no-undo .
     2875           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2876                                             , OUTPUT v-cntxt-userid
     2877                                             ) .
     2878           run gbl/wndsizew.p
     2879             (input  v-cntxt-db-num
     2880             ,input  v-cntxt-userid
     2881             ,input  v-diasize-proc-name
     2882             ,input  'width':u
     2883             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2884             ) .
     2885         end.
     2886       end.
     2887     end.
     2888     assign
     2889       v-diasize-change-size = false
     2890     .
     2891   end procedure.
     2892   procedure diasize_set-width :
     2893     define input  parameter p-new-width  as decimal   no-undo .
     2894     define input  parameter p-move-resize as logical   no-undo .
     2895     do
     2896     on error undo, return error return-value
     2897     :
     2898       run diasize_change-width in this-procedure
     2899         (input  (p-new-width - frame Dialog-Frame :width)
     2900         ,input  p-move-resize
     2901         ) .
     2902     end.
     2903   end procedure.
     2904   procedure diasize_position-resize-button :
     2905     do with frame Dialog-Frame
     2906     :
     2907       hide v-diasize-resize-button .
     2908       assign
     2909         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2910                     - 1
     2911                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2912         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2913                     - 1
     2914                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2915       .
     2916       view v-diasize-resize-button .
     2917     end.
     2918   end procedure.
     2919   on alt-right anywhere
     2920   do:
     2921     run diasize_change-width in this-procedure
     2922       (input 1
     2923       ,input true
     2924       ) .
     2925     return no-apply .
     2926   end.
     2927   on alt-left anywhere
     2928   do:
     2929     run diasize_change-width in this-procedure
     2930       (input -1
     2931       ,input true
     2932       ) .
     2933     return no-apply .
     2934   end.
     2935   on alt-down anywhere
     2936   do:
     2937     run diasize_change-height in this-procedure
     2938       (input 1
     2939       ,input true
     2940       ) .
     2941     return no-apply .
     2942   end.
     2943   on alt-up anywhere
     2944   do:
     2945     run diasize_change-height in this-procedure
     2946       (input -1
     2947       ,input true
     2948       ) .
     2949     return no-apply .
     2950   end.
     2951   on alt-enter of frame Dialog-Frame
     2952   do:
     2953     run diasize_maximize in this-procedure
     2954       (input  ?
     2955       ).
     2956     return no-apply .
     2957   end.
     2958   procedure diasize_end-move :
     2959     do
     2960     on error undo, return error return-value
     2961     :
     2962       define variable v-row-delta as decimal   no-undo .
     2963       define variable v-col-delta as decimal   no-undo .
     2964       define variable v-new-row as decimal   no-undo .
     2965       define variable v-new-col as decimal   no-undo .
     2966       assign
     2967         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2968         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2969       .
     2970       assign
     2971         v-row-delta = v-new-row - frame Dialog-Frame :height
     2972         v-col-delta = v-new-col - frame Dialog-Frame :width
     2973       .
     2974       run diasize_change-height in this-procedure
     2975         (input v-row-delta
     2976         ,input true
     2977         ) .
     2978       run diasize_change-width in this-procedure
     2979         (input v-col-delta
     2980         ,input true
     2981         ) .
     2982     end.
     2983   end procedure.
     2984   procedure diasize_maximize :
     2985     define input  parameter p-action as logical   no-undo .
     2986     do
     2987     on error undo, return error return-value
     2988     :
     2989       if p-action = ?
     2990       then do:
     2991         if v-diasize-need-maximize = true
     2992         then do:
     2993           assign
     2994             p-action = true
     2995           .
     2996         end.
     2997         else do:
     2998           assign
     2999             p-action = false
     3000           .
     3001         end.
     3002       end.
     3003       if p-action = true
     3004       then do:
     3005         run diasize_change-height in this-procedure
     3006           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3007               - frame Dialog-Frame :height-chars
     3008           ,input true
     3009           ) .
     3010         run diasize_change-width in this-procedure
     3011           (input session :width-chars
     3012               - frame Dialog-Frame :width-chars
     3013           ,input true
     3014           ) .
     3015         assign
     3016           v-diasize-need-maximize = false
     3017         .
     3018       end.
     3019       else do:
     3020         run diasize_change-width in this-procedure
     3021           (input v-diasize-orig-frame-width
     3022               - frame Dialog-Frame :width-chars
     3023           ,input true
     3024           ) .
     3025         run diasize_change-height in this-procedure
     3026           (input v-diasize-orig-frame-height
     3027               - frame Dialog-Frame :height-chars
     3028           ,input true
     3029           ) .
     3030         assign
     3031           v-diasize-need-maximize = true
     3032         .
     3033       end.
     3034     end.
     3035   end procedure.
     3036   procedure diasize_restore-orig-size :
     3037     do
     3038     on error undo, return error return-value
     3039     :
     3040       assign
     3041         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3042         v-diasize-current-frame-height = frame Dialog-Frame :height
     3043       .
     3044       run diasize_set-height in this-procedure
     3045         (input  v-diasize-orig-frame-height
     3046         ,input  true
     3047         ) .
     3048       run diasize_set-width in this-procedure
     3049         (input  v-diasize-orig-frame-width
     3050         ,input  true
     3051         ) .
     3052     end.
     3053   end procedure.
     3054   procedure diasize_restore-current-size :
     3055     do
     3056     on error undo, return error return-value
     3057     :
     3058       run diasize_set-height in this-procedure
     3059         (input  v-diasize-current-frame-height
     3060         ,input  true
     3061         ) .
     3062       run diasize_set-width in this-procedure
     3063         (input  v-diasize-current-frame-width
     3064         ,input  true
     3065         ) .
     3066     end.
     3067   end procedure.
     3068   procedure diasize_set-browse-handle :
     3069     define input  parameter p-browse-handle as handle   no-undo .
     3070     define buffer buf_temp-browse-handle for temp-browse-handle .
     3071     do
     3072     on error undo, return error return-value
     3073     :
     3074       assign
     3075         v-diasize-browse-handle = p-browse-handle
     3076       .
     3077       for each buf_temp-browse-handle
     3078       on error undo, return error return-value
     3079       :
     3080         delete buf_temp-browse-handle .
     3081       end.
     3082     end.
     3083   end procedure.
     3084   procedure diasize_add_browse :
     3085     define input  parameter p-browse-type   as character no-undo .
     3086     define input  parameter p-browse-handle as handle    no-undo .
     3087     define buffer buf_temp-browse-handle for temp-browse-handle .
     3088     do
     3089     on error undo, return error return-value
     3090     :
     3091       assign
     3092         v-diasize-browse-number = v-diasize-browse-number + 1
     3093       .
     3094       create buf_temp-browse-handle .
     3095       assign
     3096         buf_temp-browse-handle.browse-type   = p-browse-type
     3097         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3098         buf_temp-browse-handle.browse-handle = p-browse-handle
     3099       .
     3100     end.
     3101   end procedure.
     3102   procedure diasize_init :
     3103     define variable v-default-value    as logical   no-undo .
     3104     define variable v-restore-saved    as logical   no-undo .
     3105     define variable v-resize-value-str as character no-undo .
     3106     do
     3107     on error undo, return error return-value
     3108     :
     3109       do with frame Dialog-Frame
     3110       :
     3111         assign
     3112           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3113           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3114           v-diasize-browse-handle     = browse-hdl-egais-goods
     3115         .
     3116         create button v-diasize-resize-button
     3117         assign
     3118           parent        = frame Dialog-Frame :first-child
     3119           label         = "s"
     3120           height-pixels = 16
     3121           width-pixels  = 16
     3122           visible       = true
     3123           sensitive     = true
     3124           movable       = true
     3125           triggers:
     3126             on end-move persistent run diasize_end-move in this-procedure .
     3127           end triggers.
     3128         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3129         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3130         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3131         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3132         assign
     3133           v-diasize-wndmax = false
     3134         .
     3135         if connected("ub") = true
     3136         then do:
     3137           define variable v-cntxt-db-num        as integer   no-undo .
     3138           define variable v-cntxt-userid        as character no-undo .
     3139           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3140                                             , OUTPUT v-cntxt-userid
     3141                                             ) .
     3142           run gbl/wndpar_r.p
     3143             (input  v-cntxt-db-num
     3144             ,input  v-cntxt-userid
     3145             ,input  'wndmax':U
     3146             ,output v-diasize-wndmax
     3147             ,output v-default-value
     3148             ) .
     3149         end.
     3150         assign
     3151           v-diasize-wndstore = false
     3152         .
     3153         if connected("ub") = true
     3154         then do:
     3155           run gbl/wndpar_r.p
     3156             (input  v-cntxt-db-num
     3157             ,input  v-cntxt-userid
     3158             ,input  'wndstore':U
     3159             ,output v-diasize-wndstore
     3160             ,output v-default-value
     3161             ) .
     3162         end.
     3163         assign
     3164           v-diasize-proc-name = entry(1, program-name(2), '.')
     3165         .
     3166         if v-diasize-wndstore = true
     3167         then do:
     3168           assign
     3169             v-restore-saved = false
     3170           .
     3171           if connected("ub") = true
     3172           then do:
     3173             run gbl/wndsizer.p
     3174               (input  v-cntxt-db-num
     3175               ,input  v-cntxt-userid
     3176               ,input  v-diasize-proc-name
     3177               ,input  'height':u
     3178               ,output v-resize-value-str
     3179               ) .
     3180             if v-resize-value-str <> '':U
     3181             then do:
     3182               run diasize_change-height in this-procedure
     3183                 (input  integer(v-resize-value-str)
     3184                 ,input  true
     3185                 ) .
     3186               assign
     3187                 v-restore-saved = true
     3188               .
     3189             end.
     3190           end.
     3191           if connected("ub") = true
     3192           then do:
     3193             run gbl/wndsizer.p
     3194               (input  v-cntxt-db-num
     3195               ,input  v-cntxt-userid
     3196               ,input  v-diasize-proc-name
     3197               ,input  'width':u
     3198               ,output v-resize-value-str
     3199               ) .
     3200             if v-resize-value-str <> '':U
     3201             then do:
     3202               run diasize_change-width in this-procedure
     3203                 (input  integer(v-resize-value-str)
     3204                 ,input  true
     3205                 ) .
     3206               assign
     3207                 v-restore-saved = true
     3208               .
     3209             end.
     3210           end.
     3211           if v-restore-saved <> true
     3212           then do:
     3213             if v-diasize-wndmax = true
     3214             then do:
     3215               run diasize_maximize in this-procedure
     3216                 (input  true
     3217                 ) .
     3218             end.
     3219           end.
     3220         end.
     3221         else do:
     3222           if v-diasize-wndmax = true
     3223           then do:
     3224             run diasize_maximize in this-procedure
     3225               (input  true
     3226               ) .
     3227           end.
     3228         end.
     3229       end.
     3230     end.
     3231   end procedure.
     3232   procedure diasize_need-full-display :
     3233     define output parameter p-need-full-display as logical   no-undo .
     3234     do
     3235     on error undo, return error return-value
     3236     :
     3237       assign
     3238         p-need-full-display = v-diasize-need-full-display
     3239       .
     3240       assign
     3241         v-diasize-need-full-display = false
     3242       .
     3243     end.
     3244   end procedure.
     3245   procedure get-context :
     3246      define output parameter p-db-num as integer          no-undo.
     3247      define output parameter p-user-id as character        no-undo.
     3248      define variable v-login               as character    no-undo.
     3249      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3250      define buffer buf_user-login  for ub.user-login .
     3251      do
     3252      on error undo, return error
     3253      :
     3254            FIND FIRST buf_sys-ctrl no-lock.
     3255            ASSIGN
     3256               v-login = USERID("ub")
     3257               p-db-num = buf_sys-ctrl.db-num
     3258            .
     3259            FIND FIRST buf_user-login
     3260                 WHERE buf_user-login.db-num = p-db-num
     3261                   AND buf_user-login.user-login = v-login
     3262                 no-lock
     3263                 no-error
     3264                 .
     3265            IF AVAILABLE buf_user-login
     3266            THEN DO:
     3267               assign
     3268                  p-user-id = buf_user-login.user-id
     3269               .
     3270            END.
     3271      end.
     3272   end procedure.
     3273     run diasize_init in this-procedure .
     3274     run enable_UI.
     3275     run refresh-view.
     3276     bh-egais-goods:find-first ("", no-lock) no-error.
     3277     assign
     3278          btn_del:hidden in frame dialog-frame = true
     3279          f-gdsname:hidden in frame dialog-frame = true
     3280          btn_look:hidden in frame dialog-frame = true.
     3281     wait-for go of frame Dialog-Frame.
     3282   end.
     3283   if valid-object (ExtFormF1Obj)
     3284     then delete object ExtFormF1Obj.
     3285   run disable_UI.
     3286   PROCEDURE disable_UI :
     3287     HIDE FRAME Dialog-Frame.
     3288   END PROCEDURE.
     3289   PROCEDURE enable_UI :
     3290     DISPLAY f-gds f-alcgds f-gdsname t-incorr
     3291         WITH FRAME Dialog-Frame.
     3292     ENABLE Btn_Cancel Btn_mark Btn_markall Btn_desmark btn_look btn_refresh
     3293            btn_req btn_asw btn_del f-gds f-alcgds f-gdsname t-incorr
     3294         WITH FRAME Dialog-Frame.
     3295     VIEW FRAME Dialog-Frame.
     3296   END PROCEDURE.
     3297   PROCEDURE msdblcl :
     3298   end.
     3299   PROCEDURE proc-row-disp :
     3300   def var ii as int no-undo.
     3301     do ii = 1 to extent (bcol).
     3302       if valid-handle (bcol[ii])
     3303         then
     3304           assign
     3305             bcol[ii]:bgcolor = bh-egais-goods:buffer-field ("ColorNum"):buffer-value
     3306           .
     3307     end.
     3308   end.
     3309   PROCEDURE refresh-view :
     3310   def var v-proposition  as char no-undo.
     3311     assign input frame Dialog-Frame
     3312       f-gds
     3313       f-gdsname
     3314       f-alcgds
     3315       t-incorr
     3316     .
     3317     if f-gds <> ""
     3318     then do:
     3319       v-proposition = substitute ("string(formF1Code) matches '*&1*' and ", f-gds).
     3320     end.
     3321     if f-alcgds <> ""
     3322     then do:
     3323       v-proposition = v-proposition + substitute ("alcCode matches '*&1*' and ", f-alcgds).
     3324     end.
     3325     if f-gdsname <> ""
     3326     then do:
     3327       v-proposition = v-proposition + substitute ("gdsName matches '*&1*' and ", f-gdsname).
     3328     end.
     3329     if t-incorr = true
     3330     then do:
     3331       v-proposition = v-proposition + substitute ("ColorNum = &1", RED_COLOR).
     3332     end.
     3333     v-proposition = right-trim (v-proposition, " and ").
     3334     if v-proposition <> "" then v-proposition = "where " + v-proposition.
     3335     display Btn_Cancel with frame Dialog-Frame.
     3336     enable Btn_Cancel
     3337       with frame Dialog-Frame.
     3338     view frame Dialog-Frame.
     3339     qh-egais-goods:query-close.
     3340     qh-egais-goods:query-prepare ("for each tt-egaisformf1-hndls " + v-proposition).
     3341     qh-egais-goods:query-open.
     3342     if qh-egais-goods:get-first ()
     3343       then browse-hdl-egais-goods:refresh ().
     3344     apply "choose" to Btn_desmark in frame Dialog-Frame.
     3345   end.
