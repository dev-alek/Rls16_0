        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision               as character no-undo init "$Revision$":U .
        4   define variable vss-author                 as character no-undo init "$Author$":U .
        5   define variable vss-date                   as character no-undo init "$Date$":U .
        6   define variable vss-workfile               as character no-undo init "$Workfile$":U .
        7   define variable vss-archive                as character no-undo init "$Archive$":U .
        8   define variable vss-description            as character no-undo init "Справочник справок 1 ЕГАИС.".
        9   define variable bh-egais-goods         as handle    no-undo.
       10   define variable browse-hdl-egais-goods as handle    no-undo.
       11   define variable qh-egais-goods         as handle    no-undo.
       12   define variable bcol                   as handle    no-undo extent.
       13   define variable v-db-num               as integer   no-undo .
       14   define variable v-user-id              as character no-undo .
       15   define variable v-user-select          as character no-undo .
       16   define variable v-select-obj-type      as character no-undo .
       17   define variable v-select-obj-code      as integer   no-undo .
       18   define variable v-obj-uniq-key-rec     as character no-undo .
       19   define variable v-gds-uniq-key-rec     as character no-undo .
       20   define variable v-ext-sys              as integer   no-undo .
       21   define variable v-fs-rar               as character no-undo.
       22   define variable ExtFormF1Obj           as class     ExtFormF1 no-undo .
       23   define variable v-value-character      as character no-undo .
       24   define variable v-value-decimal        as decimal   no-undo .
       25   define variable v-value-integer        as integer   no-undo .
       26   define variable v-value-logical        as logical   no-undo .
       27   define variable v-value-type           as character no-undo .
       28   define variable v-value-date           as date      no-undo .
       29   define variable select-list            as character no-undo .
       30   define variable v-rec-list             as character no-undo .
       31   define variable isMarkALL              as logical   no-undo init ?.
       32   define variable isSave                 as logical   no-undo.
       33   define variable glog                   as logical   no-undo.
       34   define variable v-user-action          as character no-undo .
       35   define variable v-printed              as logical   no-undo .
       36   define buffer buf_clients   for ub.clients .
       37   define buffer x_ext-classif for ub.ext-classif.
       38   define buffer buf_goods     for ub.goods .
       39   define stream str1.
       40   define new global shared variable g#language as character no-undo .
       41   if g#language <> '' and g#language <> 'rus':U then do:
       42     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       43   end.
       44   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       45   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       46   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       47   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       48   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       49   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       50   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       51   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       52   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       53   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       54   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       55   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       56   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       57   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       58   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       59   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       60   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       61   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       62   define new global shared variable g#library  as handle no-undo .
       63   define new global shared variable g#library2 as handle no-undo .
       64   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65     define variable v-cntxt-db-num        as integer   no-undo .
       66     define variable v-cntxt-userid        as character no-undo .
       67     define variable v-cntxt-level         as character no-undo .
       68     define variable v-cntxt-host-code-obj as integer   no-undo .
       69     define variable v-cntxt-obj-type      as character no-undo .
       70     define variable v-cntxt-obj-code      as integer   no-undo .
       71     define variable v-cntxt-db-num-obj    as integer   no-undo .
       72     define variable v-cntxt-is-admin      as logical   no-undo .
       73   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74     run mainmenu_getcntxt in parparentproc
       75       (output v-cntxt-db-num
       76       ,output v-cntxt-userid
       77       ,output v-cntxt-level
       78       ,output v-cntxt-host-code-obj
       79       ,output v-cntxt-obj-type
       80       ,output v-cntxt-obj-code
       81       ,output v-cntxt-db-num-obj
       82       ,output v-cntxt-is-admin
       83       ) .
       84   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure gen-key-rec :
       87     define input  parameter p-tbl-name    as character no-undo.
       88     define input  parameter p-bh_tbl-name as handle    no-undo.
       89     define output parameter p-key-rec     as character no-undo.
       90     do
       91     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       92     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       93     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       94     :
       95       define variable fh               as handle    no-undo .
       96       define variable v-ok             as logical   no-undo .
       97       define variable v-inform         as character no-undo .
       98       define variable v-ind            as integer   no-undo .
       99       define variable v-idx-field-qnty as integer   no-undo .
      100       if p-tbl-name = ?
      101         or p-tbl-name = "":U
      102       then do:
      103         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      104       end.
      105       if not p-bh_tbl-name:available then do:
      106         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      107       end.
      108       assign
      109         p-key-rec = p-tbl-name
      110         v-inform  = p-bh_tbl-name:index-information(1)
      111         v-ind     = 2
      112       .
      113       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      114       on error undo, return error
      115       :
      116         assign
      117           v-inform = p-bh_tbl-name:index-information( v-ind )
      118           v-ind    = v-ind + 1
      119         .
      120       end.
      121       if v-inform = ?
      122         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      123         or entry( 3, v-inform, ",":U ) <> "1":U
      124       then do:
      125         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      126       end.
      127       else do:
      128         assign
      129           v-idx-field-qnty = num-entries( v-inform ) - 4
      130         .
      131         if v-idx-field-qnty < 2 then do:
      132           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      133         end.
      134         do v-ind = 1 to v-idx-field-qnty by 2
      135         on error undo, return error
      136         :
      137           assign
      138             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      139             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      140           .
      141         end.
      142       end.
      143       if p-key-rec = ? then do:
      144         assign
      145           p-key-rec = "":U
      146         .
      147         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      148       end.
      149     end.
      150     return.
      151   end procedure.
      152   procedure gen-where-keyr-tab :
      153     define input  parameter i-tableSerach as character no-undo.
      154     define input  parameter i-tablekey   as character  no-undo.
      155     define input  parameter p-key-rec    as character  no-undo.
      156     define input  parameter p-key-handle as handle     no-undo .
      157     define input  parameter p-db-name    as character  no-undo .
      158     define input  parameter p-tt-handle  as handle     no-undo .
      159     define output parameter o-Where      as character  no-undo.
      160     do
      161     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      162     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      163     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      164     :
      165       define variable v-full-tbl-name  as character no-undo .
      166       define variable bh_tbl-name      as handle    no-undo .
      167       define variable fh_key           as handle    no-undo .
      168       define variable fh_search        as handle    no-undo .
      169       define variable v-field-num      as integer   no-undo .
      170       define variable v-count-fld      as integer   no-undo .
      171       define variable v-inform         as character no-undo .
      172       define variable v-ind            as integer   no-undo .
      173       define variable v-idx-field-qnty as integer   no-undo .
      174       define variable v-field-name     as character no-undo .
      175       define variable v-field-val      as character no-undo .
      176       define variable v-word-link      as character no-undo .
      177       define variable vTable           as character no-undo.
      178       define variable bh_tbl-key       as handle    no-undo .
      179       assign
      180         p-key-rec = trim( p-key-rec )
      181       .
      182       if p-key-handle <> ? then do:
      183         if not valid-handle(p-key-handle)
      184            or p-key-handle:type <> "buffer"
      185         then do:
      186           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      187         end.
      188         if num-entries( p-key-rec, chr(3) ) > 1
      189           or p-key-rec = ?
      190           or p-key-rec = "":U
      191         then do:
      192           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      193         end.
      194       end.
      195       else do:
      196         if p-key-rec = ?
      197           or p-key-rec = "":U
      198         then do:
      199           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      200         end.
      201       end.
      202       assign
      203         vTable = entry( 1 , p-key-rec, chr(3) )
      204       .
      205       if p-tt-handle <> ?
      206         and ( not valid-handle(p-tt-handle)
      207               or p-tt-handle:type <> "buffer"
      208             )
      209       then do:
      210         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      211       end.
      212       if p-tt-handle = ? then do:
      213         assign
      214           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      215         .
      216         create buffer bh_tbl-name for table v-full-tbl-name .
      217       end.
      218       else do:
      219         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      220       end.
      221       assign
      222         v-inform = bh_tbl-name:index-information(1)
      223         v-ind    = 2
      224       .
      225       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      226       on error undo, return error
      227       :
      228         assign
      229           v-inform = bh_tbl-name:index-information( v-ind )
      230           v-ind    = v-ind + 1
      231         .
      232       end.
      233       if v-inform = ?
      234         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      235         or entry( 3, v-inform, ",":U ) <> "1":U
      236       then do:
      237         delete object bh_tbl-name no-error.
      238         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      239       end.
      240       assign
      241         v-idx-field-qnty = num-entries( v-inform ) - 4
      242       .
      243       if v-idx-field-qnty < 2 then do:
      244         delete object bh_tbl-name no-error.
      245         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      246       end.
      247       assign
      248         o-where     = "where":U
      249         v-word-link = "":U
      250         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      251         v-count-fld = 0
      252       .
      253       if i-tablekey ne "" and i-tablekey ne ?
      254       then do:
      255         assign
      256           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      257         .
      258         create buffer bh_tbl-key for table v-full-tbl-name .
      259       end.
      260       if i-tableSerach ne "" and i-tableSerach ne ?
      261       then do:
      262         delete object bh_tbl-name no-error.
      263         assign
      264           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      265         .
      266         create buffer bh_tbl-name for table v-full-tbl-name .
      267       end.
      268       block_where:
      269       do v-ind = 1 to v-idx-field-qnty by 2
      270       on error undo, return error
      271       :
      272         assign
      273           v-count-fld = v-count-fld + 1
      274         .
      275         if p-key-handle = ?
      276           and v-count-fld > v-field-num
      277         then do:
      278           leave block_where.
      279         end.
      280         define variable VfieldKeyTable as handle no-undo.
      281         assign
      282           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      283           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      284         .
      285         if     bh_tbl-key ne ?
      286         then do:
      287            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      288            if VfieldKeyTable eq ?
      289            then next block_where.
      290         end.
      291         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      292         then
      293            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      294         else
      295            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      296         if p-key-handle = ? then do:
      297           assign
      298             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      299           .
      300         end.
      301         else do:
      302           assign
      303             fh_key = p-key-handle:buffer-field( v-field-name )
      304           .
      305           if fh_key = ?
      306             or not valid-handle( fh_key )
      307           then do:
      308             delete object bh_tbl-name.
      309             if     bh_tbl-key ne ?
      310             then
      311                delete object bh_tbl-key.
      312             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      313           end.
      314           assign
      315             v-field-val = fh_key:buffer-value
      316           .
      317         end.
      318         if fh_search:data-type ="character":U then do:
      319           assign
      320             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      321             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      322             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      323             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      324             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      325             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      326             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      327             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      328             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      329             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      330             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      331             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      332             v-field-val = substitute( '"&1"', v-field-val )
      333           .
      334         end.
      335         assign
      336           o-where = substitute( "&1 &2", o-where, v-field-val )
      337         .
      338         if v-word-link = "":U then do:
      339           assign
      340             v-word-link = "and":U
      341           .
      342         end.
      343       end.
      344       delete object bh_tbl-name.
      345       if     bh_tbl-key ne ?
      346       then
      347          delete object bh_tbl-key.
      348       if p-key-handle = ?
      349         and v-count-fld <> v-field-num
      350       then do:
      351         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      352       end.
      353     end.
      354   end procedure.
      355   procedure gen-hn-keyr-tab :
      356     define input  parameter i-tableSerach as character no-undo.
      357     define input  parameter i-tablekey   as character no-undo.
      358     define input  parameter p-key-rec    as character no-undo.
      359     define input  parameter p-key-handle as handle    no-undo .
      360     define input  parameter p-db-name    as character no-undo .
      361     define input  parameter p-tt-handle  as handle    no-undo .
      362     define input  parameter p-stts-lock  as integer   no-undo .
      363     define output parameter o-hn         as handle    no-undo.
      364     define variable v-full-tbl-name as character no-undo.
      365     define variable v-where         as character no-undo.
      366     define variable bh_tbl-name     as handle    no-undo.
      367     define variable vTable          as character no-undo.
      368     do
      369     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      370     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      371     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      372         run gen-where-keyr-tab(i-tableSerach,
      373                                i-tablekey,
      374                                p-key-rec,
      375                                p-key-handle,
      376                                p-db-name,
      377                                p-tt-handle,
      378                                output v-where).
      379         if i-tableSerach ne "" and i-tableSerach ne ?
      380         then do:
      381            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      382            create buffer bh_tbl-name for table v-full-tbl-name .
      383         end.
      384         else do:
      385            if p-tt-handle = ? then do:
      386               assign
      387                  vTable = entry( 1 , p-key-rec, chr(3) )
      388               .
      389               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      390               create buffer bh_tbl-name for table v-full-tbl-name .
      391            end.
      392            else do:
      393               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      394            end.
      395         end.
      396         if p-tt-handle = ? then do:
      397            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      398         end.
      399         else do:
      400            bh_tbl-name:find-first( v-where ) no-error .
      401         end.
      402         o-hn = bh_tbl-name.
      403      end.
      404   end procedure.
      405   procedure gen-hn-keyr :
      406     define input  parameter p-key-rec    as character no-undo.
      407     define input  parameter p-key-handle as handle    no-undo .
      408     define input  parameter p-db-name    as character no-undo .
      409     define input  parameter p-tt-handle  as handle    no-undo .
      410     define input  parameter p-stts-lock  as integer   no-undo .
      411     define output parameter o-hn         as handle    no-undo.
      412     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      413   end.
      414   procedure gen-row-keyr :
      415     define input  parameter p-key-rec    as character no-undo.
      416     define input  parameter p-key-handle as handle    no-undo .
      417     define input  parameter p-db-name    as character no-undo .
      418     define input  parameter p-tt-handle  as handle    no-undo .
      419     define input  parameter p-stts-lock  as integer   no-undo .
      420     define output parameter p-tbl-row    as rowid     no-undo.
      421     define output parameter p-tbl-name   as character no-undo.
      422     define variable vHn as handle no-undo.
      423       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      424       p-tbl-row = if vHn:available then vHn:rowid else ?.
      425       p-tbl-name =  vHn:table.
      426       delete object vHn no-error.
      427     if p-tbl-row = ? then do:
      428       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      429     end.
      430     else do:
      431       return.
      432     end.
      433   end procedure.
      434   procedure gen-key-fv :
      435     define input  parameter p-key-rec    as character no-undo .
      436     define output parameter p-field-list as character no-undo .
      437     define output parameter p-value-list as character no-undo.
      438     do
      439     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      440     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      441     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      442     :
      443       define variable v-full-tbl-name  as character no-undo .
      444       define variable bh_tbl-name      as handle    no-undo .
      445       define variable v-tbl-name       as character no-undo .
      446       define variable v-field-num      as integer   no-undo .
      447       define variable v-count-fld      as integer   no-undo .
      448       define variable v-inform         as character no-undo .
      449       define variable v-ind            as integer   no-undo .
      450       define variable v-idx-field-qnty as integer   no-undo .
      451       define variable v-delim-key      as character no-undo .
      452       if p-key-rec = ?
      453         or p-key-rec = "":U
      454       then do:
      455         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      456       end.
      457       assign
      458         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      459         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      460       .
      461       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      462       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      463       assign
      464         v-inform = bh_tbl-name:index-information(1)
      465         v-ind    = 2
      466       .
      467       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      468       on error undo, return error
      469       :
      470         assign
      471           v-inform = bh_tbl-name:index-information( v-ind )
      472           v-ind    = v-ind + 1
      473         .
      474       end.
      475       if v-inform = ?
      476         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      477         or entry( 3, v-inform, ",":U ) <> "1":U
      478       then do:
      479         delete object bh_tbl-name no-error.
      480         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      481       end.
      482       assign
      483         v-idx-field-qnty = num-entries( v-inform ) - 4
      484       .
      485       if v-idx-field-qnty < 2 then do:
      486         delete object bh_tbl-name no-error.
      487         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      488       end.
      489       assign
      490         p-field-list = "":U
      491         p-value-list = "":U
      492         v-delim-key  = "":U
      493         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      494         v-count-fld  = 0
      495       .
      496       block_where:
      497       do v-ind = 1 to v-idx-field-qnty by 2
      498       on error undo, return error
      499       :
      500         assign
      501           v-count-fld = v-count-fld + 1
      502         .
      503         if v-count-fld > v-field-num then do:
      504           leave block_where.
      505         end.
      506         assign
      507           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      508           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      509         .
      510         if v-ind = 1 then do:
      511           assign
      512             v-delim-key = chr(3)
      513           .
      514         end.
      515       end.
      516       delete object bh_tbl-name.
      517       if v-count-fld <> v-field-num then do:
      518         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      519       end.
      520     end.
      521   end procedure.
      522   procedure gen-key-field :
      523     define input  parameter p-table      as character no-undo .
      524     define output parameter p-field-list as character no-undo .
      525     do
      526     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      527     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      528     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      529     :
      530       define variable v-full-tbl-name  as character no-undo .
      531       define variable bh_tbl-name      as handle    no-undo .
      532       define variable v-tbl-name       as character no-undo .
      533       define variable v-field-num      as integer   no-undo .
      534       define variable v-count-fld      as integer   no-undo .
      535       define variable v-inform         as character no-undo .
      536       define variable v-ind            as integer   no-undo .
      537       define variable v-idx-field-qnty as integer   no-undo .
      538       define variable v-delim-key      as character no-undo .
      539       if p-table = ?
      540         or p-table = "":U
      541       then do:
      542         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      543       end.
      544       assign
      545         v-tbl-name      = p-table
      546         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      547       .
      548       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      549       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      550       assign
      551         v-inform = bh_tbl-name:index-information(1)
      552         v-ind    = 2
      553       .
      554       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      555       on error undo, return error
      556       :
      557         assign
      558           v-inform = bh_tbl-name:index-information( v-ind )
      559           v-ind    = v-ind + 1
      560         .
      561       end.
      562       if v-inform = ?
      563         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      564         or entry( 3, v-inform, ",":U ) <> "1":U
      565       then do:
      566         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      567       end.
      568       assign
      569         v-idx-field-qnty = num-entries( v-inform ) - 4
      570       .
      571       if v-idx-field-qnty < 2 then do:
      572         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      573       end.
      574       assign
      575         p-field-list = "":U
      576         v-delim-key  = "":U
      577         v-count-fld  = 0
      578       .
      579       block_where:
      580       do v-ind = 1 to v-idx-field-qnty by 2
      581       on error undo, return error
      582       :
      583         assign
      584           v-count-fld = v-count-fld + 1
      585         .
      586         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      587         if v-ind = 1 then do:
      588           assign
      589             v-delim-key = chr(3)
      590           .
      591         end.
      592       end.
      593       delete object bh_tbl-name.
      594     end.
      595   end procedure.
      596   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   define new global shared variable g#attr-lib  as handle no-undo .
