        1   block-level on error undo, throw.
        2   on write of ub.fin-ob-attr override do: end.
        3   define input parameter p-table-name        as character    no-undo.
        4   define input parameter p-host-code         as integer   no-undo.
        5   define input parameter p-doc-code          as character no-undo .
        6   define input parameter p-corr-user-db-num  as integer no-undo .
        7   define input parameter p-chip-num          as integer no-undo .
        8   define input parameter p-cur-date          as date       no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: setbgefo.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: bge/setbgefo.p $":U .
       14   define variable vss-description as character no-undo init "Устанавливает дату выгрузки в атрибут ФО".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6':u, p-table-name, p-host-code, p-doc-code, p-corr-user-db-num, p-chip-num, p-cur-date)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   procedure create-fin-ob-attr :
       88    do
       89    on error undo, return error return-value
       90    :
       91   define input parameter p-host-code     like ub.fin-ob-attr.host-code  no-undo .
       92   define input parameter p-doc-code      like ub.fin-ob-attr.doc-code   no-undo .
       93   define input parameter p-attr-code     like ub.fin-ob-attr.attr-code  no-undo .
       94   define input parameter p-attr-value    like ub.fin-ob-attr.attr-value no-undo .
       95   define buffer buf_fin-ob-attr for ub.fin-ob-attr.
       96   find first buf_fin-ob-attr  exclusive-lock  where
       97     buf_fin-ob-attr.attr-code    = p-attr-code    and
       98     buf_fin-ob-attr.host-code    = p-host-code    and
       99     buf_fin-ob-attr.doc-code     = p-doc-code  no-error .
      100     if not available  buf_fin-ob-attr then do:
      101         create buf_fin-ob-attr.
      102         assign
      103           buf_fin-ob-attr.attr-code    = p-attr-code
      104           buf_fin-ob-attr.attr-value   = p-attr-value
      105           buf_fin-ob-attr.host-code    = p-host-code
      106           buf_fin-ob-attr.doc-code     = p-doc-code
      107         .
      108     end.
      109     else do:
      110           buf_fin-ob-attr.attr-value   = p-attr-value .
      111     end.
      112    end.
      113   end procedure.
      114   procedure view-fin-ob-attr :
      115    do
      116    on error undo, return error return-value
      117    :
      118   define input  parameter p-host-code    like ub.fin-ob-attr.host-code    no-undo .
      119   define input  parameter p-doc-code     like ub.fin-ob-attr.doc-code     no-undo .
      120   define input  parameter p-attr-code    like ub.fin-ob-attr.attr-code    no-undo .
      121   define output parameter p-attr-value   like ub.fin-ob-attr.attr-value   no-undo .
      122   define buffer buf_fin-ob-attr for ub.fin-ob-attr.
      123   find first buf_fin-ob-attr no-lock where
      124     buf_fin-ob-attr.attr-code    = p-attr-code    and
      125     buf_fin-ob-attr.doc-code      = p-doc-code      no-error .
      126     if available  buf_fin-ob-attr then do:
      127         assign
      128           p-attr-value = buf_fin-ob-attr.attr-value
      129         .
      130     end.
      131     else do:
      132           p-attr-value = ? .
      133     end.
      134    end.
      135   end procedure.
      136   do
      137   on error undo, return error
      138   :
      139   define buffer buf_fin-ob-attr  for ub.fin-ob-attr.
      140   case p-table-name:
      141     when "fin-ob":U  then do:
      142       run create-fin-ob-attr  in this-procedure (
      143                                                    input p-host-code
      144                                                   ,input p-doc-code
      145                                                   ,input 'bge-date':U
      146                                                   ,input string(p-cur-date, "99/99/9999")
      147                                                 ) no-error .
      148      end.
      149     end case.
      150     if error-status:error then do:
      151       return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description + chr(32)  +  return-value ).
      152     end.
      153   end.
