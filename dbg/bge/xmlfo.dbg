      440                     ,output paroutput-file
      441                     ,output v-path
      442                     ,output v-file-name
      443                     ,output v-file-name-no-ext
      444                     ,output v-file-name-ext
      445                     ) no-error .
      446   end.
      447   procedure write-string :
      448    define input parameter parstring as character no-undo.
      449    put stream fin-ob-out unformatted parstring.
      450   end.
