      434        os-delete value ("./" + "fo":U + string(p-doc-code) + ".xml").
      435     end.
      436     os-copy value ("./" + "fo":U + string(p-doc-code) + ".tmp") value ("./" + "fo":U + string(p-doc-code) + ".xml").
      437     os-delete value ("./" + "fo":U +  string(p-doc-code) + ".tmp").
      438     run gbl/filename.p
