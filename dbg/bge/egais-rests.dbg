     1850   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1851   define variable v-waitfram-action01         as character   no-undo .
     1852   define variable v-waitfram-action02         as character   no-undo .
     1853   define variable v-waitfram-action03         as character   no-undo .
     1854   define variable mWaitFramTextBeg            as character   no-undo.
     1855   define variable mWaitFramTextEnd            as character   no-undo.
     1856   define variable mWaitFramView               as logical     no-undo.
     1857   define variable mWaitProcEvent              as logical     no-undo init yes.
     1858   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1859   define variable mWaitFramStop               as logical     no-undo.
     1860   define variable mWaitFramStopUser           as logical     no-undo.
     1861   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1862   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1863   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1864   define button B-WaitFramStop auto-end-key
     1865        label "Стоп"
     1866        size 10 by 1 tooltip "Остоновить процесс".
     1867   define button B-viewProcInfo
     1868        label "Информация"
     1869        size 15 by 1 tooltip "Информация о процесс".
     1870   define frame waitfram
     1871     v-waitfram-action01 format "x(72)" no-label skip
     1872     v-waitfram-action02 format "x(72)" no-label skip
     1873     v-waitfram-action03 format "x(72)" no-label skip
     1874     B-viewProcInfo
     1875     B-WaitFramStop at row 4 col 30
     1876     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1877     .
     1878   define new global shared variable mBatchMode as logical no-undo init ?.
     1879   define variable mFramBachModHandle as handle no-undo.
     1880   mFramBachModHandle = frame waitfram:handle.
     1881   define variable mFameOldVis as logical no-undo.
     1882   define variable mVisCUrentVin as logical no-undo.
     1883   if session:batch-mode
     1884   then
     1885      mBatchMode = yes.
     1886   if mBatchMode = ? then do:
     1887     mVisCUrentVin = current-window:visible.
     1888     mFameOldVis = mFramBachModHandle:visible.
     1889     mFramBachModHandle:visible  = yes.
     1890     mBatchMode = mFramBachModHandle:visible ne yes.
     1891     mFramBachModHandle:visible = mFameOldVis.
     1892     current-window:visible = mVisCUrentVin.
     1893   end.
     1894    if  log-manager:logfile-name ne ?
     1895     then DO:
     1896         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1897         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1898         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1899     end.
     1900   on choose of B-WaitFramStop in frame waitfram
     1901   do:
     1902     mWaitFramStop = yes.
     1903     mWaitFramStopUser = yes.
     1904   end.
     1905   function waitfram-check-timeout returns logical():
     1906      define variable vtime as int64 no-undo.
     1907      if mWaitFramStopTimeOut
     1908      then
     1909         return yes.
     1910      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1911      if     mWaitFramTimeOut ne ?
     1912         and mWaitFramTimeOut ne 0
     1913         and mWaitFramTimeOut lt vtime
     1914      then do:
     1915         mWaitFramStopTimeOut = yes.
     1916      end.
     1917      return mWaitFramStopTimeOut.
     1918   end.
     1919   procedure waitfram-hide :
     1920     if not session:batch-mode
     1921     then do
     1922     on error undo, return error return-value
     1923     :
     1924       pause 0 before-hide .
     1925       if not mBatchMode then
     1926         hide frame waitfram .
     1927     if     not mWaitFramView
     1928        and mWaitProcEvent
     1929     then
     1930       process events .
     1931     end.
     1932   end procedure.
     1933   procedure waitfram-show :
     1934     define input  parameter p-message as character no-undo .
     1935     define variable v-left-margin as integer   no-undo .
     1936     if not session:batch-mode
     1937     then do
     1938     on error undo, return error return-value
     1939     :
     1940       if length(p-message) <= 70 then do:
     1941         assign
     1942           v-left-margin = integer((70 - length(p-message)) / 2)
     1943         .
     1944         assign
     1945           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1946         .
     1947         assign
     1948           v-waitfram-action01 = " "
     1949           v-waitfram-action02 = " "
     1950                                    + fill(" ", v-left-margin)
     1951                                    + p-message
     1952           v-waitfram-action03 = " "
     1953         .
     1954       end.
     1955       else do:
     1956         define variable vRindex1 as integer no-undo.
     1957         define variable vRindex2 as integer no-undo.
     1958         vRindex1 = r-index(p-message," ",70).
     1959         if vRindex1 = 0
     1960         then
     1961            vRindex1 = 70.
     1962         if length(p-message)  <= vRindex1 + 70 then do:
     1963           assign
     1964             v-waitfram-action01 = " "
     1965             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1966             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1967           .
     1968         end.
     1969         else do:
     1970           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1971           if vRindex2 <= vRindex1
     1972           then
     1973              vRindex2 = vRindex1 + 70.
     1974           assign
     1975             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1976             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1977             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1978           .
     1979         end.
     1980       end.
     1981       B-viewProcInfo:visible   in frame waitfram = no.
     1982       B-viewProcInfo:sensitive in frame waitfram = no.
     1983       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1984       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1985       if  (   mWaitFramView
     1986          or  mWaitProcEvent)
     1987          and not mBatchMode
     1988       then
     1989          display
     1990             v-waitfram-action01 skip
     1991             v-waitfram-action02 skip
     1992             v-waitfram-action03 skip
     1993          with frame waitfram .
     1994       if     mWaitFramView
     1995          then do:
     1996             if     mWaitFramInterval ne ?
     1997                and not mBatchMode
     1998             then
     1999                wait-for go of frame waitfram pause mWaitFramInterval.
     2000          end.
     2001          else
     2002             if     mWaitProcEvent
     2003                and not mBatchMode
     2004             then
     2005                process events .
     2006     end.
     2007   end procedure.
     2008      procedure waitfram-show-this:
     2009         define input  parameter iInterval as int64 no-undo.
     2010         define variable vtime as int64 no-undo.
     2011         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2012         mWaitFramInterval = iInterval.
     2013         run waitfram-show (substitute("&1&2 &3&4" ,
     2014                                       mWaitFramTextBeg ,
     2015                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2016                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2017                                       mWaitFramTextEnd
     2018                                      )
     2019                           ).
     2020      end.
     2021      procedure WaitFramRunPause:
     2022         define input  parameter iInterval as dec no-undo.
     2023         define variable vStart  as datetime-tz no-undo.
     2024         define variable vend    as datetime-tz no-undo.
     2025         define variable vint as int64 no-undo.
     2026         define variable vOk as logical no-undo.
     2027         vStart = now.
     2028         vend   = vStart.
     2029         publish "WaitFramPause" (iInterval,output vOk).
     2030         vend   =  now.
     2031         vint = vend - vStart.
     2032         vint = iInterval - vint / 1000.
     2033         if     not mWaitFramStop
     2034            and (   vint > 0
     2035                 or (    not vOk
     2036                     and iInterval eq ?
     2037                     )
     2038                 )
     2039         then
     2040            run waitfram-show-this (iInterval).
     2041         vend   =  now.
     2042         vint = vend - vStart.
     2043         vint = iInterval - vint / 1000.
     2044         if     not mWaitFramStop
     2045            and vint > 0
     2046         then do:
     2047            run gbl/pause.p (vint * 1000).
     2048         end.
     2049         if iInterval ne ?
     2050         then
     2051            publish "WaitFramStop".
     2052         waitfram-check-timeout().
     2053      end.
     2054      procedure WaitFramWaitFor:
     2055         define input  parameter iInterval as dec no-undo.
     2056         assign
     2057            mWaitFramStartProc   = now
     2058            mWaitFramStopUser    = no
     2059            mWaitFramStopTimeOut = no
     2060         .
     2061         block-wait:
     2062         do while not mWaitFramStop:
     2063            run WaitFramRunPause (iInterval).
     2064            if  waitfram-check-timeout()
     2065            then do:
     2066               leave block-wait.
     2067            end.
     2068         end.
     2069         run waitfram-hide.
     2070      end.
     2071   procedure waitfram-join :
     2072     define input  parameter p-line-1  as character no-undo .
     2073     define input  parameter p-line-2  as character no-undo .
     2074     define input  parameter p-line-3  as character no-undo .
     2075     define output parameter p-message as character no-undo .
     2076     do
     2077     on error undo, return error return-value
     2078     :
     2079       assign
     2080         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2081                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2082                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2083       .
     2084     end.
     2085   end procedure.
     2086   function waitfram-join-function returns character
     2087     (input p-line-1 as character
     2088     ,input p-line-2 as character
     2089     ,input p-line-3 as character
     2090     ).
     2091     define variable v-message as character no-undo .
     2092     run waitfram-join in this-procedure
     2093       (input  p-line-1
     2094       ,input  p-line-2
     2095       ,input  p-line-3
     2096       ,output v-message
     2097       ) .
     2098     return v-message .
     2099   end function .
