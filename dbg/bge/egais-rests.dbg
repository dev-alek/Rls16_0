     2521   define variable sw as handle no-undo .
     2522   define variable v-file              as character no-undo initial "ActWriteOff1.xml".
     2523   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     2524   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     2525   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     2526   procedure makeXML :
     2527       create sax-writer sw .
     2528       sw:formatted = true.
     2529       sw:set-output-destination ("file", v-file).
     2530       sw:encoding = "UTF-8".
     2531       sw:start-document () .
     2532       sw:start-element ("ns:Documents") .
     2533       sw:insert-attribute ("Version", "1.0") .
     2534       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     2535       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     2536       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     2537       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
     2538           sw:start-element ("ns:Owner") .
     2539               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     2540           sw:end-element ("ns:Owner") .
     2541           sw:start-element ("ns:Document") .
     2542               sw:start-element ("ns:ActWriteOff") .
     2543                   sw:write-data-element ("awr:Identity", tt-act-header.num) no-error .
     2544                   sw:start-element ("awr:Header") .
     2545                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) no-error .
     2546                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     2547                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) no-error .
     2548                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     2549                   sw:end-element ("awr:Header") .
     2550                   sw:start-element ("awr:Content") .
     2551       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     2552                       sw:start-element ("awr:Position") .
     2553                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) no-error .
     2554                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) no-error .
     2555                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
     2556                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
     2557                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
     2558                           sw:start-element ("awr:InformB") .
     2559                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
     2560                           sw:end-element ("awr:InformB") .
     2561                           sw:start-element ("awr:MarkCodeInfo") .
     2562               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2563                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
     2564               end.
     2565                           sw:end-element ("awr:MarkCodeInfo") .
     2566                       sw:end-element ("awr:Position") .
     2567       end.
     2568                   sw:end-element ("awr:Content") .
     2569               sw:end-element ("ns:ActWriteOff") .
     2570           sw:end-element ("ns:Document") .
     2571       sw:end-element ("ns:Documents") .
     2572       sw:end-document () .
     2573       delete object sw.
     2574   end procedure .
     2575   procedure makeXMLegais :
     2576       create sax-writer sw .
     2577       sw:formatted = true.
     2578       sw:set-output-destination ("file", v-file).
     2579       sw:encoding = "UTF-8".
     2580       sw:start-document () .
     2581       sw:start-element ("ns:Documents") .
     2582       sw:insert-attribute ("Version", "1.0") .
     2583       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     2584       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     2585       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     2586       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
     2587           sw:start-element ("ns:Owner") .
     2588               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     2589           sw:end-element ("ns:Owner") .
     2590           sw:start-element ("ns:Document") .
     2591               sw:start-element ("ns:ActWriteOff") .
     2592                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
     2593                   sw:start-element ("awr:Header") .
     2594                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
     2595                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     2596                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
     2597                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     2598                   sw:end-element ("awr:Header") .
     2599                   sw:start-element ("awr:Content") .
     2600       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     2601           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
     2602                       sw:start-element ("awr:Position") .
     2603                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
     2604                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
     2605                           sw:start-element ("awr:InformB") .
     2606                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) .
     2607                           sw:end-element ("awr:InformB") .
     2608                       sw:end-element ("awr:Position") .
     2609       end.
     2610                   sw:end-element ("awr:Content") .
     2611               sw:end-element ("ns:ActWriteOff") .
     2612           sw:end-element ("ns:Document") .
     2613       sw:end-element ("ns:Documents") .
     2614       sw:end-document () .
     2615       delete object sw.
     2616   end procedure .
     2617   procedure makeXMLegais_v2 :
     2618       create sax-writer sw .
     2619       sw:formatted = true.
     2620       sw:set-output-destination ("file", v-file).
     2621       sw:encoding = "UTF-8".
     2622       sw:start-document () .
     2623       sw:start-element ("ns:Documents") .
     2624       sw:insert-attribute ("Version", "1.0") .
     2625       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     2626       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     2627       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     2628       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff_v2") .
     2629       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
     2630           sw:start-element ("ns:Owner") .
     2631               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     2632           sw:end-element ("ns:Owner") .
     2633           sw:start-element ("ns:Document") .
     2634               sw:start-element ("ns:ActWriteOff_v2") .
     2635                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
     2636                   sw:start-element ("awr:Header") .
     2637                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
     2638                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     2639                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
     2640                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     2641                   sw:end-element ("awr:Header") .
     2642                   sw:start-element ("awr:Content") .
     2643       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     2644           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
     2645                       sw:start-element ("awr:Position") .
     2646                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
     2647                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
     2648                           sw:start-element ("awr:InformF1F2") .
     2649                             sw:start-element ("awr:InformF2") .
     2650                               sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
     2651                             sw:end-element ("awr:InformF2") .
     2652                           sw:end-element ("awr:InformF1F2") .
     2653           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
     2654           if available tt-marks and (tt-act-header.type_ = "Проверки" or tt-act-header.type_ = "Арест") then do :
     2655                           sw:start-element ("awr:MarkCodeInfo") .
     2656               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2657                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
     2658               end.
     2659                           sw:end-element ("awr:MarkCodeInfo") .
     2660           end.
     2661                       sw:end-element ("awr:Position") .
     2662       end.
     2663                   sw:end-element ("awr:Content") .
     2664               sw:end-element ("ns:ActWriteOff_v2") .
     2665           sw:end-element ("ns:Document") .
     2666       sw:end-element ("ns:Documents") .
     2667       sw:end-document () .
     2668       delete object sw.
     2669   end procedure .
     2670   procedure parseXML :
     2671       define input parameter inFile as character no-undo .
     2672       empty temp-table tt-act-header .
     2673       empty temp-table tt-gds-act .
     2674       CREATE X-DOCUMENT hDoc.
     2675       CREATE X-NODEREF hRoot.
     2676       hDoc:encoding = 'utf-8'.
     2677       hDoc:LOAD("file", search(inFile),FALSE).
     2678       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     2679       RUN GetChildren(hRoot, 1).
     2680       DELETE OBJECT hDoc.
     2681       DELETE OBJECT hRoot.
     2682   end procedure .
     2683   procedure GetChildren :
     2684       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     2685       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     2686       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     2687       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     2688       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     2689       CREATE X-NODEREF hNoderef.
     2690       CREATE X-NODEREF hText .
     2691       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     2692           good = hParent:GET-CHILD(hNoderef,i).
     2693           IF NOT good THEN
     2694               LEAVE.
     2695           IF hNoderef:SUBTYPE <> "element" THEN
     2696               NEXT.
     2697           hNoderef:GET-CHILD(hText, 1) no-error .
     2698           IF hNoderef:NAME = "awr:Header" THEN do :
     2699               create tt-act-header .
     2700               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
     2701           end .
     2702           .
     2703           IF hNoderef:NAME = "awr:ActNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
     2704           IF hNoderef:NAME = "awr:ActDate" THEN
     2705               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2706           IF hNoderef:NAME = "awr:TypeWriteOff" THEN assign tt-act-header.type_    = hText:node-value no-error .
     2707           IF hNoderef:NAME = "awr:Position" THEN do :
     2708               assign ii = 0 .
     2709               create tt-gds-act .
     2710               assign tt-gds-act.num = tt-act-header.num .
     2711           end.
     2712           IF hNoderef:NAME = "awr:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     2713           IF hNoderef:NAME = "awr:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     2714           IF hNoderef:NAME = "pref:BRegId"
     2715           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
     2716           IF hNoderef:NAME = "gds-code"     THEN do :
     2717               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
     2718               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2719               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
     2720           end.
     2721           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
     2722           IF hNoderef:NAME = "alc-code"     THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
     2723           IF hNoderef:NAME = "awr:MarkCode" THEN do :
     2724               create tt-marks.
     2725               assign
     2726                   tt-marks.num                    = tt-gds-act.num
     2727                   tt-marks.gds-part-position_     = tt-gds-act.position_
     2728                   tt-marks.mark                   = hText:node-value
     2729                   tt-marks.gds-code               = tt-gds-act.gds-code
     2730                   tt-marks.gds-name               = tt-gds-act.gds-name
     2731                   tt-marks.alc-code               = tt-gds-act.alc-code
     2732                   ii = ii + 1.
     2733               .
     2734               assign tt-gds-act.marks-qnty = ii .
     2735           end.
     2736           run GetChildren (hNoderef, (level + 1)).
     2737       END.
     2738       DELETE OBJECT hNoderef.
     2739       DELETE OBJECT hText.
     2740   END procedure.
     2741   define variable bh-act-header-tts  as handle no-undo .
     2742   define temp-table tt-act-header-tts
     2743       field num           as character        label "№ акта"      format "X(30)"
     2744       field date_         as date             label "Дата акта"
     2745       field is-sent       as logical
     2746       field answer_       as character        label "Ответ"       format "X(1500)"
     2747       field RegID         as character        label "Рег. номер"  format "X(50)"
     2748       index pi as primary unique
     2749           num
     2750   .
     2751   define temp-table tt-gds-act-tts
     2752       field num           as character                label "№ акта"
     2753       field position_     as integer                  label "№ пп"                    format ">>>9"
     2754       field gds-code      like ub.goods.gds-code      label "Код товара   "
     2755       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     2756       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     2757       field qnty          as decimal                  label "Количество"
     2758       field inform-B      as character                label "Справка Б"               format "X(20)"
     2759       index pi as primary unique
     2760           position_
     2761       index code
     2762           gds-code
     2763   .
     2764   define variable sw-tts as handle no-undo .
     2765   define variable v-file-tts              as character no-undo initial "TransferToShop1.xml".
     2766   DEFINE VARIABLE hDoc-tts AS HANDLE NO-UNDO.
     2767   DEFINE VARIABLE hRoot-tts AS HANDLE NO-UNDO.
     2768   DEFINE VARIABLE good-tts AS LOGICAL NO-UNDO.
     2769   procedure makeXML-tts :
     2770       create sax-writer sw-tts .
     2771       sw-tts:formatted = true.
     2772       sw-tts:set-output-destination ("file", v-file-tts).
     2773       sw-tts:encoding = "UTF-8".
     2774       sw-tts:start-document () .
     2775       sw-tts:start-element ("ns:Documents") .
     2776       sw-tts:insert-attribute ("Version", "1.0") .
     2777       sw-tts:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     2778       sw-tts:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     2779       sw-tts:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
     2780       sw-tts:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     2781       sw-tts:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
     2782           sw-tts:start-element ("ns:Owner") .
     2783               sw-tts:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     2784           sw-tts:end-element ("ns:Owner") .
     2785           sw-tts:start-element ("ns:Document") .
     2786               sw-tts:start-element ("ns:TransferToShop") .
     2787                   sw-tts:write-data-element ("tts:Identity", tt-act-header-tts.num) no-error .
     2788                   sw-tts:start-element ("tts:Header") .
     2789                       sw-tts:write-data-element ("tts:TransferNumber", tt-act-header-tts.num) no-error .
     2790                       sw-tts:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header-tts.date_))) no-error .
     2791                   sw-tts:end-element ("tts:Header") .
     2792                   sw-tts:start-element ("tts:Content") .
     2793       for each tt-gds-act-tts no-lock where tt-gds-act-tts.num = tt-act-header-tts.num :
     2794                       sw-tts:start-element ("tts:Position") .
     2795                           sw-tts:write-data-element ("tts:Identity", string(tt-gds-act-tts.position_)) no-error .
     2796                           sw-tts:write-data-element ("tts:Quantity", string(tt-gds-act-tts.qnty)) no-error .
     2797                           sw-tts:write-data-element ("gds-code", string(tt-gds-act-tts.gds-code)) no-error .
     2798                           sw-tts:write-data-element ("gds-name", tt-gds-act-tts.gds-name) no-error .
     2799                           sw-tts:write-data-element ("alc-code", tt-gds-act-tts.alc-code) no-error .
     2800                           sw-tts:start-element ("tts:InformB") .
     2801                               sw-tts:write-data-element ("pref:BRegId", tt-gds-act-tts.inform-B) no-error .
     2802                           sw-tts:end-element ("tts:InformB") .
     2803                       sw-tts:end-element ("tts:Position") .
     2804       end.
     2805                   sw-tts:end-element ("tts:Content") .
     2806               sw-tts:end-element ("ns:TransferToShop") .
     2807           sw-tts:end-element ("ns:Document") .
     2808       sw-tts:end-element ("ns:Documents") .
     2809       sw-tts:end-document () .
     2810       delete object sw-tts.
     2811   end procedure .
     2812   procedure makeXMLegais_v2-tts :
     2813       create sax-writer sw-tts .
     2814       sw-tts:formatted = true.
     2815       sw-tts:set-output-destination ("file", v-file-tts).
     2816       sw-tts:encoding = "UTF-8".
     2817       sw-tts:start-document () .
     2818       sw-tts:start-element ("ns:Documents") .
     2819       sw-tts:insert-attribute ("Version", "1.0") .
     2820       sw-tts:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     2821       sw-tts:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     2822       sw-tts:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
     2823       sw-tts:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     2824       sw-tts:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
