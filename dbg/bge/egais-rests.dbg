     2830                   sw-tts:write-data-element ("tts:Identity", tt-act-header-tts.num) .
     2831                   sw-tts:start-element ("tts:Header") .
     2832                       sw-tts:write-data-element ("tts:TransferNumber", tt-act-header-tts.num) .
     2833                       sw-tts:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header-tts.date_))) no-error .
     2834                   sw-tts:end-element ("tts:Header") .
     2835                   sw-tts:start-element ("tts:Content") .
     2836       for each tt-gds-act-tts no-lock where tt-gds-act-tts.num = tt-act-header-tts.num :
     2837           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act-tts.inform-B = ? then next.
     2838                       sw-tts:start-element ("tts:Position") .
     2839                           sw-tts:write-data-element ("tts:Identity", string(tt-gds-act-tts.position_)) .
