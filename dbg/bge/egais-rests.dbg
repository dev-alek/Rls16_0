     2154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     2155     (input  v-report-name
     2156     ,input  2
     2157     ,output v-exist
     2158     )  .
     2159       if NOT v-exist then
     2160       DO:
     2161         Message
     2162           "Нет заданий на печать ! "
     2163           view-as alert-box .
     2164         Return  .
     2165       End.
     2166       run gbl/prnfilen.w
     2167         (input  ""
     2168         ,input  p-DisabledOptions
     2169         ,input  string(v-report-name )
     2170         ,input  7
     2171         ,output v-user-action
     2172         ,output v-printed
     2173         ) .
     2174       if v-printed then
     2175       do:
     2176         return "YES" .
     2177       end.
     2178       else
     2179       do:
     2180         return "NO" .
     2181       end.
     2182     end.
     2183   end procedure.
     2184   procedure prn-lib-open-stream :
     2185     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2186     define input parameter p-page-size    as integer no-undo .
     2187     define input parameter p-is-stream    as logical no-undo .
     2188     define input parameter p-append       as logical no-undo .
     2189     define variable v-report-name as character no-undo .
     2190     do
     2191       on error undo, return error
     2192       :
     2193       run prn-lib-get-report-name  in this-procedure (
     2194         input parParentProc
     2195         ,output v-report-name
     2196         ).
     2197       if p-is-stream then
     2198       do:
     2199         if p-append then
     2200         do:
     2201           output stream PrnLibStream to value( v-report-name )
     2202             page-size value(p-page-size) append .
     2203         end.
     2204         if not p-append then
     2205         do:
     2206           output stream PrnLibStream to value( v-report-name )
     2207             page-size value(p-page-size) .
     2208         end.
     2209       end.
     2210       if not p-is-stream then
     2211       do:
     2212         if p-append then
     2213         do:
     2214           output to value( v-report-name )
     2215             page-size value(p-page-size) append .
     2216         end.
     2217         if not p-append then
     2218         do:
     2219           output to value( v-report-name )
     2220             page-size value(p-page-size) .
     2221         end.
     2222       end.
     2223     end.
     2224   end procedure.
     2225   procedure prn-lib-open-exp :
     2226     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2227     define input parameter p-is-stream    as logical no-undo .
     2228     define input parameter p-is-append    as logical no-undo .
     2229     define output parameter p-ReportFileName as char init "report" no-undo.
     2230     define output parameter p-process as logical no-undo .
     2231     define variable glog as logical no-undo .
     2232     do
     2233       on error undo, return error
     2234       :
     2235       SYSTEM-DIALOG GET-FILE p-ReportFileName
     2236         TITLE      "Укажите путь"
     2237         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     2238         ASK-OVERWRITE
     2239         CREATE-TEST-FILE
     2240         SAVE-AS
     2241         USE-FILENAME
     2242         DEFAULT-EXTENSION "txt"
     2243         UPDATE glog
     2244         .
     2245       if not glog then  return.
     2246       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     2247       if p-is-stream then
     2248       do:
     2249         if p-is-append then
     2250         do:
     2251           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2252         end.
     2253         else
     2254         do:
     2255           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2256         end.
     2257       end.
     2258       else
     2259       do:
     2260         if p-is-append then
     2261         do:
     2262           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2263         end.
     2264         else
     2265         do:
     2266           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2267         end.
     2268       end.
     2269       p-process = yes.
     2270     end.
     2271   end procedure.
     2272   procedure prn-lib-get-report-name :
     2273     define input parameter parParentProc  as widget-handle no-undo.
     2274     define output parameter p-report-name as character no-undo .
     2275     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     2276   end procedure.
     2277   procedure prn-lib-reportviewer-report-name :
     2278     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2279     define input parameter p-report-name-html as character no-undo .
     2280     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     2281   end procedure.
     2282   procedure prn-lib-reportviewer :
     2283     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2284     define input parameter p-report-name-html as character no-undo .
     2285     define input parameter p-param        as character no-undo .
     2286     define variable v-excel           as character no-undo init 'TRUE' .
     2287     define variable v-value-character as character no-undo .
     2288     define variable v-value-integer   as character no-undo .
     2289     define variable v-value-date      as date      no-undo .
     2290     define variable v-value-decimal   as decimal   no-undo .
     2291     define variable rep-excel         as logical   no-undo .
     2292     define variable excel-string      as character no-undo .
     2293     define variable v-param-type      as character no-undo .
     2294     define variable v-tth             as handle    no-undo .
     2295     run adm/shattri.p (
     2296       input "get":U
     2297       ,input  ""
     2298       ,input  0
     2299       ,input  'report-glob':U
     2300       ,input  'rep-excel':U
     2301       ,output v-value-character
     2302       ,output v-value-date
     2303       ,output v-value-decimal
     2304       ,output v-value-integer
     2305       ,output rep-excel
     2306       ,output v-param-type
     2307       ,INPUT-OUTPUT table-handle v-tth
     2308       )  .
     2309     if rep-excel then v-excel = "TRUE" .
     2310     else v-excel = "FALSE" .
     2311     if p-param eq ""
     2312     then
     2313        p-param = "EXCEL:" + v-excel.
     2314     else
     2315        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     2316     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     2317   end procedure.
