      740   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      742   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      743   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      744   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      745   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      746   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      747   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      748   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      749   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      750   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      751   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      752   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      753   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      754   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      755   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      756   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      757   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      758   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   procedure gen-key-rec :
      761     define input  parameter p-tbl-name    as character no-undo.
      762     define input  parameter p-bh_tbl-name as handle    no-undo.
      763     define output parameter p-key-rec     as character no-undo.
      764     do
      765     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      766     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      767     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      768     :
      769       define variable fh               as handle    no-undo .
      770       define variable v-ok             as logical   no-undo .
      771       define variable v-inform         as character no-undo .
      772       define variable v-ind            as integer   no-undo .
      773       define variable v-idx-field-qnty as integer   no-undo .
      774       if p-tbl-name = ?
      775         or p-tbl-name = "":U
      776       then do:
      777         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      778       end.
      779       if not p-bh_tbl-name:available then do:
      780         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      781       end.
      782       assign
      783         p-key-rec = p-tbl-name
      784         v-inform  = p-bh_tbl-name:index-information(1)
      785         v-ind     = 2
      786       .
      787       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      788       on error undo, return error
      789       :
      790         assign
      791           v-inform = p-bh_tbl-name:index-information( v-ind )
      792           v-ind    = v-ind + 1
      793         .
      794       end.
      795       if v-inform = ?
      796         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      797         or entry( 3, v-inform, ",":U ) <> "1":U
      798       then do:
      799         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      800       end.
      801       else do:
      802         assign
      803           v-idx-field-qnty = num-entries( v-inform ) - 4
      804         .
      805         if v-idx-field-qnty < 2 then do:
      806           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      807         end.
      808         do v-ind = 1 to v-idx-field-qnty by 2
      809         on error undo, return error
      810         :
      811           assign
      812             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      813             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      814           .
      815         end.
      816       end.
      817       if p-key-rec = ? then do:
      818         assign
      819           p-key-rec = "":U
      820         .
      821         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      822       end.
      823     end.
      824     return.
      825   end procedure.
      826   procedure gen-where-keyr-tab :
      827     define input  parameter i-tableSerach as character no-undo.
      828     define input  parameter i-tablekey   as character  no-undo.
      829     define input  parameter p-key-rec    as character  no-undo.
      830     define input  parameter p-key-handle as handle     no-undo .
      831     define input  parameter p-db-name    as character  no-undo .
      832     define input  parameter p-tt-handle  as handle     no-undo .
      833     define output parameter o-Where      as character  no-undo.
      834     do
      835     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      836     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      837     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      838     :
      839       define variable v-full-tbl-name  as character no-undo .
      840       define variable bh_tbl-name      as handle    no-undo .
      841       define variable fh_key           as handle    no-undo .
      842       define variable fh_search        as handle    no-undo .
      843       define variable v-field-num      as integer   no-undo .
      844       define variable v-count-fld      as integer   no-undo .
      845       define variable v-inform         as character no-undo .
      846       define variable v-ind            as integer   no-undo .
      847       define variable v-idx-field-qnty as integer   no-undo .
      848       define variable v-field-name     as character no-undo .
      849       define variable v-field-val      as character no-undo .
      850       define variable v-word-link      as character no-undo .
      851       define variable vTable           as character no-undo.
      852       define variable bh_tbl-key       as handle    no-undo .
      853       assign
      854         p-key-rec = trim( p-key-rec )
      855       .
      856       if p-key-handle <> ? then do:
      857         if not valid-handle(p-key-handle)
      858            or p-key-handle:type <> "buffer"
      859         then do:
      860           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
      861         end.
      862         if num-entries( p-key-rec, chr(3) ) > 1
      863           or p-key-rec = ?
      864           or p-key-rec = "":U
      865         then do:
      866           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
      867         end.
      868       end.
      869       else do:
      870         if p-key-rec = ?
      871           or p-key-rec = "":U
      872         then do:
      873           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      874         end.
      875       end.
      876       assign
      877         vTable = entry( 1 , p-key-rec, chr(3) )
      878       .
      879       if p-tt-handle <> ?
      880         and ( not valid-handle(p-tt-handle)
      881               or p-tt-handle:type <> "buffer"
      882             )
      883       then do:
      884         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
      885       end.
      886       if p-tt-handle = ? then do:
      887         assign
      888           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      889         .
      890         create buffer bh_tbl-name for table v-full-tbl-name .
      891       end.
      892       else do:
      893         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      894       end.
      895       assign
      896         v-inform = bh_tbl-name:index-information(1)
      897         v-ind    = 2
      898       .
      899       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      900       on error undo, return error
      901       :
      902         assign
      903           v-inform = bh_tbl-name:index-information( v-ind )
      904           v-ind    = v-ind + 1
      905         .
      906       end.
      907       if v-inform = ?
      908         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      909         or entry( 3, v-inform, ",":U ) <> "1":U
      910       then do:
      911         delete object bh_tbl-name no-error.
      912         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
      913       end.
      914       assign
      915         v-idx-field-qnty = num-entries( v-inform ) - 4
      916       .
      917       if v-idx-field-qnty < 2 then do:
      918         delete object bh_tbl-name no-error.
      919         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
      920       end.
      921       assign
      922         o-where     = "where":U
      923         v-word-link = "":U
      924         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      925         v-count-fld = 0
      926       .
      927       if i-tablekey ne "" and i-tablekey ne ?
      928       then do:
      929         assign
      930           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      931         .
      932         create buffer bh_tbl-key for table v-full-tbl-name .
      933       end.
      934       if i-tableSerach ne "" and i-tableSerach ne ?
      935       then do:
      936         delete object bh_tbl-name no-error.
      937         assign
      938           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      939         .
      940         create buffer bh_tbl-name for table v-full-tbl-name .
      941       end.
      942       block_where:
      943       do v-ind = 1 to v-idx-field-qnty by 2
      944       on error undo, return error
      945       :
      946         assign
      947           v-count-fld = v-count-fld + 1
      948         .
      949         if p-key-handle = ?
      950           and v-count-fld > v-field-num
      951         then do:
      952           leave block_where.
      953         end.
      954         define variable VfieldKeyTable as handle no-undo.
      955         assign
      956           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      957           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      958         .
      959         if     bh_tbl-key ne ?
      960         then do:
      961            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      962            if VfieldKeyTable eq ?
      963            then next block_where.
      964         end.
      965         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      966         then
      967            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      968         else
      969            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      970         if p-key-handle = ? then do:
      971           assign
      972             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      973           .
      974         end.
      975         else do:
      976           assign
      977             fh_key = p-key-handle:buffer-field( v-field-name )
      978           .
      979           if fh_key = ?
      980             or not valid-handle( fh_key )
      981           then do:
      982             delete object bh_tbl-name.
      983             if     bh_tbl-key ne ?
      984             then
      985                delete object bh_tbl-key.
      986             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
      987           end.
      988           assign
      989             v-field-val = fh_key:buffer-value
      990           .
      991         end.
      992         if fh_search:data-type ="character":U then do:
      993           assign
      994             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      995             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      996             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      997             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      998             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      999             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1000             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1001             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1002             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1003             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1004             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1005             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1006             v-field-val = substitute( '"&1"', v-field-val )
     1007           .
     1008         end.
     1009         assign
     1010           o-where = substitute( "&1 &2", o-where, v-field-val )
     1011         .
     1012         if v-word-link = "":U then do:
     1013           assign
     1014             v-word-link = "and":U
     1015           .
     1016         end.
     1017       end.
     1018       delete object bh_tbl-name.
     1019       if     bh_tbl-key ne ?
     1020       then
     1021          delete object bh_tbl-key.
     1022       if p-key-handle = ?
     1023         and v-count-fld <> v-field-num
     1024       then do:
     1025         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1026       end.
     1027     end.
     1028   end procedure.
     1029   procedure gen-hn-keyr-tab :
     1030     define input  parameter i-tableSerach as character no-undo.
     1031     define input  parameter i-tablekey   as character no-undo.
     1032     define input  parameter p-key-rec    as character no-undo.
     1033     define input  parameter p-key-handle as handle    no-undo .
     1034     define input  parameter p-db-name    as character no-undo .
     1035     define input  parameter p-tt-handle  as handle    no-undo .
     1036     define input  parameter p-stts-lock  as integer   no-undo .
     1037     define output parameter o-hn         as handle    no-undo.
     1038     define variable v-full-tbl-name as character no-undo.
     1039     define variable v-where         as character no-undo.
     1040     define variable bh_tbl-name     as handle    no-undo.
     1041     define variable vTable          as character no-undo.
     1042     do
     1043     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1044     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1045     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1046         run gen-where-keyr-tab(i-tableSerach,
     1047                                i-tablekey,
     1048                                p-key-rec,
     1049                                p-key-handle,
     1050                                p-db-name,
     1051                                p-tt-handle,
     1052                                output v-where).
     1053         if i-tableSerach ne "" and i-tableSerach ne ?
     1054         then do:
     1055            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1056            create buffer bh_tbl-name for table v-full-tbl-name .
     1057         end.
     1058         else do:
     1059            if p-tt-handle = ? then do:
     1060               assign
     1061                  vTable = entry( 1 , p-key-rec, chr(3) )
     1062               .
     1063               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1064               create buffer bh_tbl-name for table v-full-tbl-name .
     1065            end.
     1066            else do:
     1067               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1068            end.
     1069         end.
     1070         if p-tt-handle = ? then do:
     1071            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1072         end.
     1073         else do:
     1074            bh_tbl-name:find-first( v-where ) no-error .
     1075         end.
     1076         o-hn = bh_tbl-name.
     1077      end.
     1078   end procedure.
     1079   procedure gen-hn-keyr :
     1080     define input  parameter p-key-rec    as character no-undo.
     1081     define input  parameter p-key-handle as handle    no-undo .
     1082     define input  parameter p-db-name    as character no-undo .
     1083     define input  parameter p-tt-handle  as handle    no-undo .
     1084     define input  parameter p-stts-lock  as integer   no-undo .
     1085     define output parameter o-hn         as handle    no-undo.
     1086     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1087   end.
     1088   procedure gen-row-keyr :
     1089     define input  parameter p-key-rec    as character no-undo.
     1090     define input  parameter p-key-handle as handle    no-undo .
     1091     define input  parameter p-db-name    as character no-undo .
     1092     define input  parameter p-tt-handle  as handle    no-undo .
     1093     define input  parameter p-stts-lock  as integer   no-undo .
     1094     define output parameter p-tbl-row    as rowid     no-undo.
     1095     define output parameter p-tbl-name   as character no-undo.
     1096     define variable vHn as handle no-undo.
     1097       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1098       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1099       p-tbl-name =  vHn:table.
     1100       delete object vHn no-error.
     1101     if p-tbl-row = ? then do:
     1102       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1103     end.
     1104     else do:
     1105       return.
     1106     end.
     1107   end procedure.
     1108   procedure gen-key-fv :
     1109     define input  parameter p-key-rec    as character no-undo .
     1110     define output parameter p-field-list as character no-undo .
     1111     define output parameter p-value-list as character no-undo.
     1112     do
     1113     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1114     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1115     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1116     :
     1117       define variable v-full-tbl-name  as character no-undo .
     1118       define variable bh_tbl-name      as handle    no-undo .
     1119       define variable v-tbl-name       as character no-undo .
     1120       define variable v-field-num      as integer   no-undo .
     1121       define variable v-count-fld      as integer   no-undo .
     1122       define variable v-inform         as character no-undo .
     1123       define variable v-ind            as integer   no-undo .
     1124       define variable v-idx-field-qnty as integer   no-undo .
     1125       define variable v-delim-key      as character no-undo .
     1126       if p-key-rec = ?
     1127         or p-key-rec = "":U
     1128       then do:
     1129         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1130       end.
     1131       assign
     1132         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1133         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1134       .
     1135       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1136       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1137       assign
     1138         v-inform = bh_tbl-name:index-information(1)
     1139         v-ind    = 2
     1140       .
     1141       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1142       on error undo, return error
     1143       :
     1144         assign
     1145           v-inform = bh_tbl-name:index-information( v-ind )
     1146           v-ind    = v-ind + 1
     1147         .
     1148       end.
     1149       if v-inform = ?
     1150         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1151         or entry( 3, v-inform, ",":U ) <> "1":U
     1152       then do:
     1153         delete object bh_tbl-name no-error.
     1154         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1155       end.
     1156       assign
     1157         v-idx-field-qnty = num-entries( v-inform ) - 4
     1158       .
     1159       if v-idx-field-qnty < 2 then do:
     1160         delete object bh_tbl-name no-error.
     1161         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1162       end.
     1163       assign
     1164         p-field-list = "":U
     1165         p-value-list = "":U
     1166         v-delim-key  = "":U
     1167         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1168         v-count-fld  = 0
     1169       .
     1170       block_where:
     1171       do v-ind = 1 to v-idx-field-qnty by 2
     1172       on error undo, return error
     1173       :
     1174         assign
     1175           v-count-fld = v-count-fld + 1
     1176         .
     1177         if v-count-fld > v-field-num then do:
     1178           leave block_where.
     1179         end.
     1180         assign
     1181           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1182           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1183         .
     1184         if v-ind = 1 then do:
     1185           assign
     1186             v-delim-key = chr(3)
     1187           .
     1188         end.
     1189       end.
     1190       delete object bh_tbl-name.
     1191       if v-count-fld <> v-field-num then do:
     1192         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1193       end.
     1194     end.
     1195   end procedure.
     1196   procedure gen-key-field :
     1197     define input  parameter p-table      as character no-undo .
     1198     define output parameter p-field-list as character no-undo .
     1199     do
     1200     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1201     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1202     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1203     :
     1204       define variable v-full-tbl-name  as character no-undo .
     1205       define variable bh_tbl-name      as handle    no-undo .
     1206       define variable v-tbl-name       as character no-undo .
     1207       define variable v-field-num      as integer   no-undo .
     1208       define variable v-count-fld      as integer   no-undo .
     1209       define variable v-inform         as character no-undo .
     1210       define variable v-ind            as integer   no-undo .
     1211       define variable v-idx-field-qnty as integer   no-undo .
     1212       define variable v-delim-key      as character no-undo .
     1213       if p-table = ?
     1214         or p-table = "":U
     1215       then do:
     1216         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1217       end.
     1218       assign
     1219         v-tbl-name      = p-table
     1220         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1221       .
     1222       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1223       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1224       assign
     1225         v-inform = bh_tbl-name:index-information(1)
     1226         v-ind    = 2
     1227       .
     1228       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1229       on error undo, return error
     1230       :
     1231         assign
     1232           v-inform = bh_tbl-name:index-information( v-ind )
     1233           v-ind    = v-ind + 1
     1234         .
     1235       end.
     1236       if v-inform = ?
     1237         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1238         or entry( 3, v-inform, ",":U ) <> "1":U
     1239       then do:
     1240         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1241       end.
     1242       assign
     1243         v-idx-field-qnty = num-entries( v-inform ) - 4
     1244       .
     1245       if v-idx-field-qnty < 2 then do:
     1246         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1247       end.
     1248       assign
     1249         p-field-list = "":U
     1250         v-delim-key  = "":U
     1251         v-count-fld  = 0
     1252       .
     1253       block_where:
     1254       do v-ind = 1 to v-idx-field-qnty by 2
     1255       on error undo, return error
     1256       :
     1257         assign
     1258           v-count-fld = v-count-fld + 1
     1259         .
     1260         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1261         if v-ind = 1 then do:
     1262           assign
     1263             v-delim-key = chr(3)
     1264           .
     1265         end.
     1266       end.
     1267       delete object bh_tbl-name.
     1268     end.
     1269   end procedure.
     1270   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   procedure gds-attr-name :
     1272     define input  parameter p-code           as character no-undo .
     1273     define output parameter p-type           as character no-undo .
     1274     define output parameter p-format         as character no-undo .
     1275     define output parameter p-label          as character no-undo .
     1276     define output parameter p-user-can-edit  as logical   no-undo .
     1277     define output parameter p-output-display as logical   no-undo .
     1278     define output parameter p-other          as character no-undo .
     1279     do
     1280     on error undo, return error
     1281     :
     1282           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     1283         (input  p-code
     1284         ,output p-type
