      208   procedure thbjattr_code_reg :
      209   define input  parameter p-upper-code     as character no-undo .
      210   define input  parameter p-code           as character no-undo .
      211   define output parameter p-label          as character no-undo .
      212   define output parameter p-user-can-edit  as logical   no-undo .
      213   define output parameter p-output-display as logical   no-undo .
      214   define output parameter p-other          as character no-undo .
      215   define output parameter p-prop-list      as character no-undo .
      216   define output parameter p-prop-type-list as character no-undo .
      217   define output parameter p-prop-label-list as character no-undo .
      218   define output parameter p-global          as logical no-undo .
      219   define output parameter p-host           as logical no-undo .
      220   define output parameter p-shop           as logical no-undo .
      221   define output parameter p-store          as logical no-undo .
      222   define output parameter p-db             as logical no-undo .
      223   define output parameter p-region         as logical no-undo .
      224   do
      225   on error undo, return error return-value
      226   :
      227       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      228       (input  p-upper-code
      229       ,input  p-code
      230       ,output p-label
      231       ,output p-user-can-edit
      232       ,output p-output-display
      233       ,output p-other
      234       ,output p-prop-list
      235       ,output p-prop-type-list
      236       ,output p-prop-label-list
      237       ,output p-global
      238       ,output p-host
      239       ,output p-shop
      240       ,output p-store
      241       ,output p-db
      242       ,output p-region
      243       ) no-error .
      244     if error-status :error
      245     then do:
      246       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      247     end.
      248   end.
      249   end procedure.
