      174   procedure thbjattr_code :
      175      define input  parameter p-upper-code     as character no-undo .
      176      define input  parameter p-code           as character no-undo .
      177      define output parameter p-label          as character no-undo .
      178      define output parameter p-user-can-edit  as logical   no-undo .
      179      define output parameter p-output-display as logical   no-undo .
      180      define output parameter p-other          as character no-undo .
