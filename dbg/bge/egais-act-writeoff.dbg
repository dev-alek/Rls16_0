      884   procedure thbjattr_write :
      885   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      886   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      887   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      888   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
      889   define input  parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
      890   define input  parameter p-value-date like ub.thbj-attr.property-value-date no-undo .
      891   define input  parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
      892   define input  parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
      893   define input  parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
      894   do
      895   on error undo, return error return-value
      896   :
