     1574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   define new global shared variable g#trdcalib as handle no-undo.
     1576   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   define variable v-waitfram-action01         as character   no-undo .
     1579   define variable v-waitfram-action02         as character   no-undo .
     1580   define variable v-waitfram-action03         as character   no-undo .
     1581   define variable mWaitFramTextBeg            as character   no-undo.
     1582   define variable mWaitFramTextEnd            as character   no-undo.
     1583   define variable mWaitFramView               as logical     no-undo.
     1584   define variable mWaitProcEvent              as logical     no-undo init yes.
     1585   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1586   define variable mWaitFramStop               as logical     no-undo.
     1587   define variable mWaitFramStopUser           as logical     no-undo.
     1588   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1589   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1590   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1591   define button B-WaitFramStop auto-end-key
     1592        label "Стоп"
     1593        size 10 by 1 tooltip "Остоновить процесс".
     1594   define button B-viewProcInfo
     1595        label "Информация"
     1596        size 15 by 1 tooltip "Информация о процесс".
     1597   define frame waitfram
     1598     v-waitfram-action01 format "x(72)" no-label skip
     1599     v-waitfram-action02 format "x(72)" no-label skip
     1600     v-waitfram-action03 format "x(72)" no-label skip
     1601     B-viewProcInfo
     1602     B-WaitFramStop at row 4 col 30
     1603     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1604     .
     1605   define new global shared variable mBatchMode as logical no-undo init ?.
     1606   define variable mFramBachModHandle as handle no-undo.
     1607   mFramBachModHandle = frame waitfram:handle.
     1608   define variable mFameOldVis as logical no-undo.
     1609   define variable mVisCUrentVin as logical no-undo.
     1610   if session:batch-mode
     1611   then
     1612      mBatchMode = yes.
     1613   if mBatchMode = ? then do:
     1614     mVisCUrentVin = current-window:visible.
     1615     mFameOldVis = mFramBachModHandle:visible.
     1616     mFramBachModHandle:visible  = yes.
     1617     mBatchMode = mFramBachModHandle:visible ne yes.
     1618     mFramBachModHandle:visible = mFameOldVis.
     1619     current-window:visible = mVisCUrentVin.
     1620   end.
     1621    if  log-manager:logfile-name ne ?
     1622     then DO:
     1623         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1624         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1625         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1626     end.
     1627   on choose of B-WaitFramStop in frame waitfram
     1628   do:
     1629     mWaitFramStop = yes.
     1630     mWaitFramStopUser = yes.
     1631   end.
     1632   function waitfram-check-timeout returns logical():
     1633      define variable vtime as int64 no-undo.
     1634      if mWaitFramStopTimeOut
     1635      then
     1636         return yes.
     1637      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1638      if     mWaitFramTimeOut ne ?
     1639         and mWaitFramTimeOut ne 0
     1640         and mWaitFramTimeOut lt vtime
     1641      then do:
     1642         mWaitFramStopTimeOut = yes.
     1643      end.
     1644      return mWaitFramStopTimeOut.
     1645   end.
     1646   procedure waitfram-hide :
     1647     if not session:batch-mode
     1648     then do
     1649     on error undo, return error return-value
     1650     :
     1651       pause 0 before-hide .
     1652       if not mBatchMode then
     1653         hide frame waitfram .
     1654     if     not mWaitFramView
     1655        and mWaitProcEvent
     1656     then
     1657       process events .
     1658     end.
     1659   end procedure.
     1660   procedure waitfram-show :
     1661     define input  parameter p-message as character no-undo .
     1662     define variable v-left-margin as integer   no-undo .
     1663     if not session:batch-mode
     1664     then do
     1665     on error undo, return error return-value
     1666     :
     1667       if length(p-message) <= 70 then do:
     1668         assign
     1669           v-left-margin = integer((70 - length(p-message)) / 2)
     1670         .
     1671         assign
     1672           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1673         .
     1674         assign
     1675           v-waitfram-action01 = " "
     1676           v-waitfram-action02 = " "
     1677                                    + fill(" ", v-left-margin)
     1678                                    + p-message
     1679           v-waitfram-action03 = " "
     1680         .
     1681       end.
     1682       else do:
     1683         define variable vRindex1 as integer no-undo.
     1684         define variable vRindex2 as integer no-undo.
     1685         vRindex1 = r-index(p-message," ",70).
     1686         if vRindex1 = 0
     1687         then
     1688            vRindex1 = 70.
     1689         if length(p-message)  <= vRindex1 + 70 then do:
     1690           assign
     1691             v-waitfram-action01 = " "
     1692             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1693             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1694           .
     1695         end.
     1696         else do:
     1697           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1698           if vRindex2 <= vRindex1
     1699           then
     1700              vRindex2 = vRindex1 + 70.
     1701           assign
     1702             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1703             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1704             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1705           .
     1706         end.
     1707       end.
     1708       B-viewProcInfo:visible   in frame waitfram = no.
     1709       B-viewProcInfo:sensitive in frame waitfram = no.
     1710       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1711       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1712       if  (   mWaitFramView
     1713          or  mWaitProcEvent)
     1714          and not mBatchMode
     1715       then
     1716          display
     1717             v-waitfram-action01 skip
     1718             v-waitfram-action02 skip
     1719             v-waitfram-action03 skip
     1720          with frame waitfram .
     1721       if     mWaitFramView
     1722          then do:
     1723             if     mWaitFramInterval ne ?
     1724                and not mBatchMode
     1725             then
     1726                wait-for go of frame waitfram pause mWaitFramInterval.
     1727          end.
     1728          else
     1729             if     mWaitProcEvent
     1730                and not mBatchMode
     1731             then
     1732                process events .
     1733     end.
     1734   end procedure.
     1735      procedure waitfram-show-this:
     1736         define input  parameter iInterval as int64 no-undo.
     1737         define variable vtime as int64 no-undo.
     1738         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1739         mWaitFramInterval = iInterval.
     1740         run waitfram-show (substitute("&1&2 &3&4" ,
     1741                                       mWaitFramTextBeg ,
     1742                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1743                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1744                                       mWaitFramTextEnd
     1745                                      )
     1746                           ).
     1747      end.
     1748      procedure WaitFramRunPause:
     1749         define input  parameter iInterval as dec no-undo.
     1750         define variable vStart  as datetime-tz no-undo.
     1751         define variable vend    as datetime-tz no-undo.
     1752         define variable vint as int64 no-undo.
     1753         define variable vOk as logical no-undo.
     1754         vStart = now.
     1755         vend   = vStart.
     1756         publish "WaitFramPause" (iInterval,output vOk).
     1757         vend   =  now.
     1758         vint = vend - vStart.
     1759         vint = iInterval - vint / 1000.
     1760         if     not mWaitFramStop
     1761            and (   vint > 0
     1762                 or (    not vOk
     1763                     and iInterval eq ?
     1764                     )
     1765                 )
     1766         then
     1767            run waitfram-show-this (iInterval).
     1768         vend   =  now.
     1769         vint = vend - vStart.
     1770         vint = iInterval - vint / 1000.
     1771         if     not mWaitFramStop
     1772            and vint > 0
     1773         then do:
     1774            run gbl/pause.p (vint * 1000).
     1775         end.
     1776         if iInterval ne ?
     1777         then
     1778            publish "WaitFramStop".
     1779         waitfram-check-timeout().
     1780      end.
     1781      procedure WaitFramWaitFor:
     1782         define input  parameter iInterval as dec no-undo.
     1783         assign
     1784            mWaitFramStartProc   = now
     1785            mWaitFramStopUser    = no
     1786            mWaitFramStopTimeOut = no
     1787         .
     1788         block-wait:
     1789         do while not mWaitFramStop:
     1790            run WaitFramRunPause (iInterval).
     1791            if  waitfram-check-timeout()
     1792            then do:
     1793               leave block-wait.
     1794            end.
     1795         end.
     1796         run waitfram-hide.
     1797      end.
     1798   procedure waitfram-join :
     1799     define input  parameter p-line-1  as character no-undo .
     1800     define input  parameter p-line-2  as character no-undo .
     1801     define input  parameter p-line-3  as character no-undo .
     1802     define output parameter p-message as character no-undo .
     1803     do
     1804     on error undo, return error return-value
     1805     :
     1806       assign
     1807         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1808                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1809                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1810       .
     1811     end.
     1812   end procedure.
     1813   function waitfram-join-function returns character
     1814     (input p-line-1 as character
     1815     ,input p-line-2 as character
     1816     ,input p-line-3 as character
     1817     ).
     1818     define variable v-message as character no-undo .
     1819     run waitfram-join in this-procedure
     1820       (input  p-line-1
     1821       ,input  p-line-2
     1822       ,input  p-line-3
     1823       ,output v-message
     1824       ) .
     1825     return v-message .
     1826   end function .
     1827   define temp-table tt-act-header
     1828       field num           as character        label "№ акта"      format "X(30)"
     1829       field date_         as date             label "Дата акта"
     1830       field type_         as character        label "Основание списания" format "X(18)"
     1831       field is-sent       as logical
     1832       field answer_       as character        label "Ответ"       format "X(1500)"
     1833       field RegID         as character        label "Рег. номер"  format "X(50)"
     1834       index pi as primary unique
     1835           num
     1836   .
     1837   define temp-table tt-gds-act
     1838       field num           as character                label "№ акта"
     1839       field position_     as integer                  label "№ пп"                    format ">>>9"
     1840       field gds-code      like ub.goods.gds-code      label "Код товара   "
     1841       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     1842       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     1843       field qnty          as decimal                  label "Количество"
     1844       field inform-B      as character                label "Справка Б"               format "X(20)"
     1845       field marks-qnty    as integer                  label "Кол-во марок"
     1846       field egais-name    as character
     1847       index pi as primary unique
     1848           num position_
     1849       index code
     1850           gds-code
     1851   .
     1852   define shared  temp-table tt-marks
     1853       field num                 as character            label "№ акта"
     1854       field gds-part-position_  as integer
     1855       field mark                as character            label "Марка"          format "X(100)"
     1856       field new_                as logical
     1857       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
     1858       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
     1859       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
     1860       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
     1861       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
     1862       field flag                as logical              label "T"
     1863       index pi as primary unique
     1864           mark
     1865   .
     1866   define variable sw as handle no-undo .
     1867   define variable v-file              as character no-undo initial "ActWriteOff1.xml".
     1868   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     1869   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     1870   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     1871   procedure makeXML :
     1872       create sax-writer sw .
     1873       sw:formatted = true.
     1874       sw:set-output-destination ("file", v-file).
     1875       sw:encoding = "UTF-8".
     1876       sw:start-document () .
     1877       sw:start-element ("ns:Documents") .
     1878       sw:insert-attribute ("Version", "1.0") .
     1879       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1880       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1881       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     1882       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
     1883           sw:start-element ("ns:Owner") .
     1884               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1885           sw:end-element ("ns:Owner") .
     1886           sw:start-element ("ns:Document") .
     1887               sw:start-element ("ns:ActWriteOff") .
     1888                   sw:write-data-element ("awr:Identity", tt-act-header.num) no-error .
     1889                   sw:start-element ("awr:Header") .
     1890                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) no-error .
     1891                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1892                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) no-error .
     1893                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     1894                   sw:end-element ("awr:Header") .
     1895                   sw:start-element ("awr:Content") .
     1896       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1897                       sw:start-element ("awr:Position") .
     1898                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) no-error .
     1899                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) no-error .
     1900                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
     1901                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
     1902                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
     1903                           sw:start-element ("awr:InformB") .
     1904                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
     1905                           sw:end-element ("awr:InformB") .
     1906                           sw:start-element ("awr:MarkCodeInfo") .
     1907               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     1908                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
     1909               end.
     1910                           sw:end-element ("awr:MarkCodeInfo") .
     1911                       sw:end-element ("awr:Position") .
     1912       end.
     1913                   sw:end-element ("awr:Content") .
     1914               sw:end-element ("ns:ActWriteOff") .
     1915           sw:end-element ("ns:Document") .
     1916       sw:end-element ("ns:Documents") .
     1917       sw:end-document () .
     1918       delete object sw.
     1919   end procedure .
     1920   procedure makeXMLegais :
     1921       create sax-writer sw .
     1922       sw:formatted = true.
     1923       sw:set-output-destination ("file", v-file).
     1924       sw:encoding = "UTF-8".
     1925       sw:start-document () .
     1926       sw:start-element ("ns:Documents") .
     1927       sw:insert-attribute ("Version", "1.0") .
     1928       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1929       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1930       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     1931       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
     1932           sw:start-element ("ns:Owner") .
     1933               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1934           sw:end-element ("ns:Owner") .
     1935           sw:start-element ("ns:Document") .
     1936               sw:start-element ("ns:ActWriteOff") .
     1937                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
     1938                   sw:start-element ("awr:Header") .
     1939                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
     1940                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1941                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
     1942                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     1943                   sw:end-element ("awr:Header") .
     1944                   sw:start-element ("awr:Content") .
     1945       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1946           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
     1947                       sw:start-element ("awr:Position") .
     1948                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
     1949                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
     1950                           sw:start-element ("awr:InformB") .
     1951                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) .
     1952                           sw:end-element ("awr:InformB") .
     1953                       sw:end-element ("awr:Position") .
     1954       end.
     1955                   sw:end-element ("awr:Content") .
     1956               sw:end-element ("ns:ActWriteOff") .
     1957           sw:end-element ("ns:Document") .
     1958       sw:end-element ("ns:Documents") .
     1959       sw:end-document () .
     1960       delete object sw.
     1961   end procedure .
     1962   procedure makeXMLegais_v2 :
     1963       create sax-writer sw .
     1964       sw:formatted = true.
     1965       sw:set-output-destination ("file", v-file).
     1966       sw:encoding = "UTF-8".
     1967       sw:start-document () .
     1968       sw:start-element ("ns:Documents") .
     1969       sw:insert-attribute ("Version", "1.0") .
     1970       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1971       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1972       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1973       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff_v2") .
     1974       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
     1975           sw:start-element ("ns:Owner") .
     1976               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1977           sw:end-element ("ns:Owner") .
     1978           sw:start-element ("ns:Document") .
     1979               sw:start-element ("ns:ActWriteOff_v2") .
     1980                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
     1981                   sw:start-element ("awr:Header") .
     1982                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
     1983                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1984                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
     1985                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     1986                   sw:end-element ("awr:Header") .
     1987                   sw:start-element ("awr:Content") .
     1988       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1989           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
     1990                       sw:start-element ("awr:Position") .
     1991                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
     1992                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
     1993                           sw:start-element ("awr:InformF1F2") .
     1994                             sw:start-element ("awr:InformF2") .
     1995                               sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
     1996                             sw:end-element ("awr:InformF2") .
     1997                           sw:end-element ("awr:InformF1F2") .
     1998           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
     1999           if available tt-marks and (tt-act-header.type_ = "Проверки" or tt-act-header.type_ = "Арест") then do :
     2000                           sw:start-element ("awr:MarkCodeInfo") .
     2001               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2002                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
     2003               end.
     2004                           sw:end-element ("awr:MarkCodeInfo") .
     2005           end.
     2006                       sw:end-element ("awr:Position") .
     2007       end.
     2008                   sw:end-element ("awr:Content") .
     2009               sw:end-element ("ns:ActWriteOff_v2") .
     2010           sw:end-element ("ns:Document") .
     2011       sw:end-element ("ns:Documents") .
     2012       sw:end-document () .
     2013       delete object sw.
     2014   end procedure .
     2015   procedure parseXML :
     2016       define input parameter inFile as character no-undo .
     2017       empty temp-table tt-act-header .
     2018       empty temp-table tt-gds-act .
     2019       CREATE X-DOCUMENT hDoc.
     2020       CREATE X-NODEREF hRoot.
     2021       hDoc:encoding = 'utf-8'.
     2022       hDoc:LOAD("file", search(inFile),FALSE).
     2023       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     2024       RUN GetChildren(hRoot, 1).
     2025       DELETE OBJECT hDoc.
     2026       DELETE OBJECT hRoot.
     2027   end procedure .
     2028   procedure GetChildren :
     2029       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     2030       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     2031       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     2032       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     2033       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     2034       CREATE X-NODEREF hNoderef.
     2035       CREATE X-NODEREF hText .
     2036       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     2037           good = hParent:GET-CHILD(hNoderef,i).
     2038           IF NOT good THEN
     2039               LEAVE.
     2040           IF hNoderef:SUBTYPE <> "element" THEN
     2041               NEXT.
     2042           hNoderef:GET-CHILD(hText, 1) no-error .
     2043           IF hNoderef:NAME = "awr:Header" THEN do :
     2044               create tt-act-header .
     2045               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
     2046           end .
     2047           .
     2048           IF hNoderef:NAME = "awr:ActNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
     2049           IF hNoderef:NAME = "awr:ActDate" THEN
     2050               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2051           IF hNoderef:NAME = "awr:TypeWriteOff" THEN assign tt-act-header.type_    = hText:node-value no-error .
     2052           IF hNoderef:NAME = "awr:Position" THEN do :
     2053               assign ii = 0 .
     2054               create tt-gds-act .
     2055               assign tt-gds-act.num = tt-act-header.num .
     2056           end.
     2057           IF hNoderef:NAME = "awr:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     2058           IF hNoderef:NAME = "awr:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     2059           IF hNoderef:NAME = "pref:BRegId"
     2060           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
     2061           IF hNoderef:NAME = "gds-code"     THEN do :
     2062               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
     2063               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2064               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
     2065           end.
     2066           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
     2067           IF hNoderef:NAME = "alc-code"     THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
     2068           IF hNoderef:NAME = "awr:MarkCode" THEN do :
     2069               create tt-marks.
     2070               assign
     2071                   tt-marks.num                    = tt-gds-act.num
     2072                   tt-marks.gds-part-position_     = tt-gds-act.position_
     2073                   tt-marks.mark                   = hText:node-value
     2074                   tt-marks.gds-code               = tt-gds-act.gds-code
     2075                   tt-marks.gds-name               = tt-gds-act.gds-name
     2076                   tt-marks.alc-code               = tt-gds-act.alc-code
     2077                   ii = ii + 1.
     2078               .
     2079               assign tt-gds-act.marks-qnty = ii .
     2080           end.
     2081           run GetChildren (hNoderef, (level + 1)).
     2082       END.
     2083       DELETE OBJECT hNoderef.
     2084       DELETE OBJECT hText.
     2085   END procedure.
     2086   define new shared temp-table tt-exts
     2087       field ext-rec as recid
     2088       field gds-code as integer
     2089       index pi as primary unique
     2090           ext-rec gds-code
     2091   .
     2092   define variable select-list as longchar no-undo .
     2093   FUNCTION get-mark RETURNS CHARACTER
     2094   (buffer local-gds for tt-gds-act ):
     2095   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     2096                                                              else return "".
     2097   end function.
     2098   define menu m-add
     2099       menu-item m-goods   label "по документу списания"
     2100       menu-item m-one-good label "один товар"
     2101   .
     2102   DEFINE BUTTON b-cancel AUTO-END-KEY
     2103        LABEL "Выход"
     2104        SIZE 15 BY 1.14
     2105        BGCOLOR 8 .
     2106   DEFINE BUTTON b-good
     2107        LABEL "Добавить"
     2108        SIZE 15 BY 1.14
     2109        BGCOLOR 8 .
     2110   DEFINE BUTTON b-marks
     2111        LABEL "Ввести марки"
     2112        SIZE 15 BY 1.14 TOOLTIP "Ввести марки"
     2113        BGCOLOR 8 .
     2114   DEFINE BUTTON b-alc-code
     2115        LABEL "Выбор алк. кода"
     2116        SIZE 20 BY 1.14 TOOLTIP "Выбрать алкогольный код"
     2117        BGCOLOR 8 .
     2118   DEFINE BUTTON b-del
     2119        LABEL "Удалить строку"
     2120        SIZE 15 BY 1.14 TOOLTIP "Удалить строку акта"
     2121        BGCOLOR 8 .
     2122   DEFINE BUTTON b-save
     2123        LABEL "Сохранить"
     2124        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     2125        BGCOLOR 8 .
     2126   DEFINE BUTTON b-mark
     2127        LABEL "&*"
     2128        SIZE 3 BY 1.14 .
     2129   DEFINE BUTTON b-sel-all
     2130        LABEL "&+":L
     2131        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     2132   DEFINE BUTTON b-unmark
     2133        LABEL "&-":L
     2134        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     2135   DEFINE QUERY br-gds-act FOR
     2136         tt-gds-act SCROLLING.
     2137   DEFINE BROWSE br-gds-act
     2138     QUERY br-gds-act  DISPLAY
     2139       get-mark(BUFFER tt-gds-act) COLUMN-LABEL "*"  FORMAT "X(1)":U
     2140       tt-gds-act.position_
     2141       tt-gds-act.gds-code
     2142       tt-gds-act.alc-code
     2143       tt-gds-act.gds-name
     2144       tt-gds-act.qnty
     2145       tt-gds-act.inform-B
     2146       tt-gds-act.marks-qnty
     2147     ENABLE
     2148       tt-gds-act.qnty
     2149       tt-gds-act.inform-B
     2150       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     2151   DEFINE FRAME Dialog-Frame
     2152       b-cancel at row 1.2 col 2
     2153       b-good at row 1.2 col 32
     2154       b-marks at row 1.2 col 47
     2155       b-alc-code at row 1.2 col 62
     2156       b-del at row 1.2 col 82
     2157       b-save at row 1.2 col 17
     2158       tt-act-header.num at row 2.5 col 2 format "X(22)"
     2159       tt-act-header.date_ at row 2.5 col 34
     2160       tt-act-header.type_ at row 2.5 col 62
     2161           view-as combo-box inner-lines 10
     2162           list-items "Пересортица,Недостача,Уценка,Порча,Потери,Проверки,Арест"
     2163           DROP-DOWN-LIST
     2164       b-mark AT ROW 4 COL 2
     2165       b-sel-all AT ROW 4 COL 5
     2166       b-unmark AT ROW 4 COL 8
     2167       br-gds-act at row 5.2 col 2
     2168        SPACE(0.5) SKIP(0.5)
     2169       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2170            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2171            TITLE "Акт о списании товаров" WIDGET-ID 100.
     2172   ASSIGN
     2173          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2174          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2175   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2176   DO:
     2177     APPLY "END-ERROR":U TO SELF.
     2178   END.
     2179   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2180   DO:
     2181     run proc-b-mark in this-procedure no-error.
     2182   END.
     2183   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     2184   DO:
     2185     assign select-list = "".
     2186     if not available tt-gds-act then return.
     2187     for each tt-gds-act no-lock :
     2188   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2189   define variable v-str-recid12 as character no-undo .
     2190   define variable v-num-entry12 as integer   no-undo .
     2191   assign
     2192     v-str-recid12 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     2193     v-num-entry12 = lookup( v-str-recid12 , select-list )
     2194   .
     2195   if v-num-entry12 > 0 then do:
     2196     assign
     2197       entry( v-num-entry12, select-list ) = "":U
     2198       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2199     .
     2200   end.
     2201   else do:
     2202     assign
     2203       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid12
     2204     .
     2205   end.
     2206     end.
     2207     br-gds-act:refresh() in frame Dialog-Frame .
     2208   END.
     2209   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     2210   DO:
     2211     if not available tt-gds-act then return.
     2212     select-list  = "".
     2213     br-gds-act:refresh() in frame Dialog-Frame .
     2214   END.
     2215   ON VALUE-CHANGED OF tt-act-header.type_ IN FRAME Dialog-Frame
     2216   DO:
     2217     assign tt-act-header.type_.
     2218     if tt-act-header.type_ = "Проверки"
     2219     or tt-act-header.type_ = "Арест"
     2220     or tt-act-header.type_ = "Реализация"
     2221     then do :
     2222         enable b-marks with frame Dialog-Frame .
     2223     end.
     2224     else do :
     2225         disable b-marks with frame Dialog-Frame .
     2226     end.
     2227   END.
     2228   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2229   DO:
     2230       if p-mode <> 'ПРОСМОТР':U then do :
     2231           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2232           view-as alert-box question buttons yes-no update glog.
     2233           if not glog then return no-apply .
     2234       end.
     2235   END.
     2236   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2237   DO:
     2238       define variable v-tt-rec as recid.
     2239       if available tt-gds-act  AND select-list = ""
     2240       then
     2241       select-list = string( recid( tt-gds-act ) ) .
     2242       if not available tt-gds-act and select-list = "" then do :
     2243           message "Выберите строку" view-as alert-box .
     2244           return no-apply.
     2245       end.
     2246       else
     2247       do ii = 1 to num-entries (select-list) :
     2248         v-tt-rec = integer(entry(ii, select-list)) .
     2249         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     2250           for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2251               delete tt-marks .
     2252           end.
     2253           delete tt-gds-act .
     2254         end.
     2255       end.
     2256       nn = 0 .
     2257       for each tt-gds-act exclusive-lock :
     2258           nn = nn + 1 .
     2259           for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2260               tt-marks.gds-part-position_ = nn .
     2261           end.
     2262           tt-gds-act.position_ = nn .
     2263       end.
     2264       select-list = "" .
     2265       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2266   END.
     2267   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     2268   DO:
     2269       define variable prev-num as character no-undo .
     2270       prev-num = tt-act-header.num .
     2271       assign tt-act-header.num .
     2272       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     2273           assign tt-gds-act.num = tt-act-header.num .
     2274       end.
     2275       for each tt-marks exclusive-lock where tt-marks.num = prev-num :
     2276           assign tt-marks.num = tt-act-header.num .
     2277       end.
     2278   END.
     2279   ON CHOOSE OF b-marks IN FRAME Dialog-Frame
     2280   DO:
     2281       if not available tt-gds-act then do :
     2282           message "Выберите строку" view-as alert-box .
     2283           return no-apply.
     2284       end.
     2285       run bge/egais-ab-marks.w (parparentproc, tt-gds-act.num, tt-gds-act.position_, tt-gds-act.alc-code, tt-gds-act.qnty, 'ИЗМЕНЕНИЕ':U, input-output table tt-marks) .
     2286       assign ii = 0 .
     2287       for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2288           ii = ii + 1 .
     2289       end.
     2290       assign tt-gds-act.marks-qnty = ii .
     2291       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2292   END.
     2293   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2294   DO:
     2295       assign
     2296           tt-act-header.num
     2297           tt-act-header.date_
     2298           tt-act-header.type_
     2299       .
     2300       find first tt-gds-act no-error .
     2301       if not available tt-gds-act then do :
     2302           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     2303           return no-apply.
     2304       end.
     2305       if can-find(tt-gds-act where tt-gds-act.qnty < 1)
     2306       or can-find(tt-gds-act where trim(tt-gds-act.inform-B) = "")
     2307       then do :
     2308           message "Строки, в которых не указана справка Б, и строки, в которых количество меньше 1, не будут учтены при отправке в ЕГАИС!" skip "Продолжить?"
     2309           view-as alert-box question buttons yes-no update glog .
     2310           if not glog then return no-apply.
     2311       end.
     2312       run makeXML in this-procedure no-error.
     2313       if error-status:error then return return-value .
     2314       assign
     2315           v-clob-db-num = ?
     2316           v-int64-id = 0
     2317           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + tt-act-header.type_ + chr(4) + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_
     2318       .
     2319       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     2320                                                 and buf_clob-bind.field-name_  = 'egais-awo':U no-error .
     2321       if available buf_clob-bind then do :
     2322           if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2323               message "Акт с таким номером уже существует!" view-as alert-box .
     2324               return no-apply .
     2325           end.
     2326           assign
     2327               v-clob-db-num = buf_clob-bind.db-num
     2328               v-int64-id = buf_clob-bind.int64-id
     2329               v-part-num = buf_clob-bind.part-num
     2330           .
     2331           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     2332                     ,input "add-new,yes"
     2333                     ,input ?
     2334                     ,input tt-act-header.num
     2335                     ,input 'egais-awo':U
     2336                     ,input v-info
     2337                     ,input-output v-part-num
     2338                     ,input 'egais-awo':U
     2339                     ,input-output v-clob-db-num
     2340                     ,input-output v-int64-id
     2341                     ,input search (v-file)
     2342                     ,input ''
     2343                     ) no-error .
     2344            if error-status:error then message return-value view-as alert-box.
     2345       end.
     2346       else do :
     2347           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2348                     ,input ",yes"
     2349                     ,input ?
     2350                     ,input tt-act-header.num
     2351                     ,input 'egais-awo':U
     2352                     ,input v-info
     2353                     ,input-output v-part-num
     2354                     ,input 'egais-awo':U
     2355                     ,input-output v-clob-db-num
     2356                     ,input-output v-int64-id
     2357                     ,input search (v-file)
     2358                     ,input ''
     2359                     ) no-error .
     2360       end.
     2361       message "Сохранение завершено" view-as alert-box.
     2362   END.
     2363   on choose of menu-item m-goods in menu m-add
     2364   DO:
     2365       run str/all-docs.w
     2366       ( input  parparentproc
     2367        ,input  v-cntxt-host-code-obj
     2368        ,input  v-cntxt-obj-type
     2369        ,input  v-cntxt-obj-code
     2370        ,input  "status-all":U
     2371        ,input  'факт':U
     2372        ,input  'спи':U
     2373        ,input  ?
     2374        ,input  no
     2375        ,input  "b-sel":U
     2376        ,input  'we':U
     2377        ,input  false
     2378        ,input  ?
     2379        ,output v-rid-list
     2380       ).
     2381       if v-rid-list = "" or v-rid-list = ?
     2382       then return no-apply.
     2383       find first   buf_trn-doc no-lock where recid(buf_trn-doc) = int(v-rid-list) no-error .
     2384       if error-status :error then return .
     2385       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     2386           find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     2387                                          and buf_goods.prod-type  = buf_doc-line.prod-type
     2388                                          and buf_goods.prod-code  = buf_doc-line.prod-code .
     2389           run gds-attr-value(
     2390             buf_goods.gds-code,
     2391             'alcohol-prod':U,
     2392             output par-alcohol,
     2393             output par-type
     2394           ).
     2395           if par-alcohol = "" or par-alcohol = "no" then next .
     2396           for each buf_parts no-lock where buf_parts.artic        = buf_doc-line.artic
     2397                                        and buf_parts.prod-type    = buf_doc-line.prod-type
     2398                                        and buf_parts.prod-code    = buf_doc-line.prod-code
     2399                                        and buf_parts.obj-type     = buf_doc-line.obj-type
     2400                                        and buf_parts.obj-code     = buf_doc-line.obj-code
     2401                                        and buf_parts.out-code     = buf_doc-line.doc-code :
     2402                assign nn = nn + 1 .
     2403                create tt-gds-act .
     2404                assign
     2405                   tt-gds-act.num          = tt-act-header.num
     2406                   tt-gds-act.gds-code     = buf_goods.gds-code
     2407                   tt-gds-act.gds-name     = buf_goods.gds-name
     2408                   tt-gds-act.position_    = nn
     2409                   tt-gds-act.qnty         = buf_parts.fact-qnty / buf_parts.cli-base-rate
     2410                .
     2411                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(3, buf_parts.alc-ref-ab-path) <> "" then do :
     2412                    tt-gds-act.alc-code = entry(3, buf_parts.alc-ref-ab-path) .
     2413                end.
     2414                else do :
     2415                    run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2416                                                       ,input (buffer buf_goods:handle)
     2417                                                       ,output v-gds-uniq-key-rec).
     2418                    find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2419                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2420                                                      AND X_ext-classif.db-num = 0
     2421                                                      and X_ext-classif.key#_one = buf_goods.gds-code
     2422                                                      and X_ext-classif.key#_two = v-ext-sys
     2423                                                      and X_ext-classif.key#_three = 0
     2424                                                      and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2425                                                      and X_eXt-classif.charkey_two = ""
     2426                                                      and X_eXt-classif.charkey_three = ""
     2427                                                      and X_eXt-classif.nonunique = 0
     2428                                                      no-error .
     2429                    if available X_ext-classif then tt-gds-act.alc-code = X_eXt-classif.charkey_one .
     2430                end.
     2431                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(2, buf_parts.alc-ref-ab-path) <> "" then do :
     2432                    tt-gds-act.inform-B = trim(entry(2, buf_parts.alc-ref-ab-path)) .
     2433                end.
     2434           end .
     2435       end .
     2436       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2437   END.
     2438   on choose of menu-item m-one-good in menu m-add
     2439   DO:
     2440       run ref/gds-ref.p
     2441       ( parparentproc
     2442       ,'b-sel,b-add'
     2443       ,?
     2444       ,?
     2445       ,'все':U
     2446       ,?
     2447       ,?
     2448       ,?
     2449       ,?
     2450       ,v-cntxt-obj-type
     2451       ,v-cntxt-obj-code
     2452       ,?
     2453       , output v-rid-list) no-error.
     2454       if v-rid-list = "" or v-rid-list = ?
     2455       then return no-apply.
     2456       find buf_goods where recid (buf_goods) = integer(v-rid-list) no-lock.
     2457       run gds-attr-value(
     2458         buf_goods.gds-code,
     2459         'alcohol-prod':U,
     2460         output par-alcohol,
     2461         output par-type
     2462       ).
     2463       if par-alcohol = "" or par-alcohol = "no" then
     2464       do :
     2465           message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     2466           return no-apply .
     2467       end.
     2468       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2469                                           ,input (buffer buf_goods:handle)
     2470                                           ,output v-gds-uniq-key-rec).
     2471       exts = 0 .
     2472       for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2473                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2474                                          AND X_ext-classif.db-num = 0
     2475                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2476                                          and X_ext-classif.key#_two = v-ext-sys
     2477                                          and X_ext-classif.key#_three = 0
     2478                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2479                                          and X_eXt-classif.charkey_two = ""
     2480                                          and X_eXt-classif.charkey_three = ""
     2481                                          and X_eXt-classif.nonunique = 0 :
     2482           find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2483                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2484           if not available tt-exts then do :
     2485               create tt-exts .
     2486               assign
     2487                   tt-exts.ext-rec = recid(X_ext-classif)
     2488                   tt-exts.gds-code = buf_goods.gds-code
     2489               .
     2490           end.
     2491           exts = exts + 1 .
     2492       end.
     2493       if exts = 0 then do :
     2494           message "Выбранный товар не синхронизирован с ЕГАИС. (Нет алкогольного кода)" view-as alert-box.
     2495           return no-apply.
     2496       end.
     2497       else if exts = 1 then do :
     2498           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2499                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2500                                              AND X_ext-classif.db-num = 0
     2501                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2502                                              and X_ext-classif.key#_two = v-ext-sys
     2503                                              and X_ext-classif.key#_three = 0
     2504                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2505                                              and X_eXt-classif.charkey_two = ""
     2506                                              and X_eXt-classif.charkey_three = ""
     2507                                              and X_eXt-classif.nonunique = 0
     2508                                              .
     2509       end.
     2510       else do :
     2511           run bge/egais-select-alc-code.w (input buf_goods.gds-code, output p-ext-rec) .
     2512           find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2513           if not available X_ext-classif then return no-apply.
     2514       end.
     2515       nn = nn + 1 .
     2516       create tt-gds-act .
     2517       assign
     2518           tt-gds-act.gds-code         = buf_goods.gds-code
     2519           tt-gds-act.alc-code         = if available X_ext-classif then X_ext-classif.charkey_one else ""
     2520           tt-gds-act.gds-name         = buf_goods.gds-name
     2521           tt-gds-act.num              = tt-act-header.num
     2522           tt-gds-act.position_        = nn
     2523           tt-gds-act.qnty       = 0
     2524       .
     2525       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2526       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     2527   END.
     2528   on choose of b-alc-code IN FRAME Dialog-Frame
     2529   do :
     2530       if not available tt-gds-act then return no-apply .
     2531       run bge/egais-select-alc-code.w (input tt-gds-act.gds-code, output p-ext-rec) .
     2532       find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2533       if not available X_ext-classif then return no-apply.
     2534       assign tt-gds-act.alc-code = X_ext-classif.charkey_one .
     2535       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2536                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2537                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2538                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2539                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2540                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2541                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2542                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2543                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2544                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2545                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2546                                              no-error .
     2547       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2548       br-gds-act:refresh() .
     2549   end.
     2550   on row-display of br-gds-act in FRAME Dialog-Frame
     2551   DO :
     2552       exts = 0 .
     2553       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2554           exts = exts + 1 .
     2555       end.
     2556       if exts > 1 then tt-gds-act.alc-code:bgcolor in browse br-gds-act = yellow_color .
     2557   end.
     2558   on value-changed of br-gds-act IN FRAME Dialog-Frame
     2559   DO :
     2560   if available tt-gds-act then do :
     2561       exts = 0 .
     2562       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2563           exts = exts + 1 .
     2564       end.
     2565       if exts > 1 then enable b-alc-code WITH FRAME Dialog-Frame.
     2566       else disable b-alc-code WITH FRAME Dialog-Frame.
     2567   end.
     2568   end.
     2569   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2570   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2571   MAIN-BLOCK:
     2572   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2573      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2574       assign
     2575           b-good:popup-menu in frame Dialog-Frame = menu m-add:handle
     2576           b-good:menu-mouse = 1
     2577           nn = 0
     2578           tt-act-header.type_:list-items = "Пересортица,Недостача,Уценка,Порча,Потери,Проверки,Арест"
     2579       .
     2580       if egais:VerXSD <> "1" then
     2581           tt-act-header.type_:list-items = tt-act-header.type_:list-items + ",Иные цели,Реализация,Производственные потери" .
     2582       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2583           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2584           create tt-act-header .
     2585           assign
     2586               tt-act-header.num = "AWO-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2587               tt-act-header.date_ = TODAY
     2588               tt-act-header.type_ = "Недостача"
     2589               tt-act-header.is-sent = no
     2590           .
     2591           display tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     2592           enable  tt-act-header.date_ tt-act-header.type_ b-good with frame Dialog-Frame.
     2593       end.
     2594       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2595           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2596                                     and buf_clob-bind.field-name_ = 'egais-awo':U
     2597                                     and buf_clob-bind.part-num = 1  .
     2598           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2599           copy-lob
     2600           from  object buf_clob-data.cdata
     2601           to  file 'temp.xml'
     2602           no-convert
     2603           no-error .
     2604           run waitfram-show in this-procedure ("Ждите...") .
     2605           empty temp-table tt-marks no-error .
     2606           run parseXML in this-procedure (input "temp.xml") .
     2607           run waitfram-hide in this-procedure .
     2608           display tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     2609           if p-mode = 'ИЗМЕНЕНИЕ':U then do :
     2610               enable  tt-act-header.type_ with frame Dialog-Frame.
     2611               apply "value-changed" to tt-act-header.type_ IN FRAME Dialog-Frame .
     2612           end .
     2613           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2614           for each tt-gds-act no-lock :
     2615               nn = nn + 1 .
     2616               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2617               if not available buf_goods then do :
     2618                   message "По алкогольному коду " tt-gds-act.alc-code " не найден товар из TH. Вероятно, кто-то удалил связку." view-as alert-box.
     2619                   next.
     2620               end.
     2621               run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2622                                               ,input (buffer buf_goods:handle)
     2623                                               ,output v-gds-uniq-key-rec).
     2624               for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2625                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2626                                              AND X_ext-classif.db-num = 0
     2627                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2628                                              and X_ext-classif.key#_two = v-ext-sys
     2629                                              and X_ext-classif.key#_three = 0
     2630                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2631                                              and X_eXt-classif.charkey_two = ""
     2632                                              and X_eXt-classif.charkey_three = ""
     2633                                              and X_eXt-classif.nonunique = 0 :
     2634                   find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2635                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2636                   if not available tt-exts then do :
     2637                       create tt-exts .
     2638                       assign
     2639                           tt-exts.ext-rec = recid(X_ext-classif)
     2640                           tt-exts.gds-code = tt-gds-act.gds-code
     2641                       .
     2642                   end.
     2643               end.
     2644           end .
     2645           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2646           if p-mode = 'ПРОСМОТР':U then disable b-good with frame Dialog-Frame.
     2647           else enable b-good with frame Dialog-Frame.
     2648       end.
     2649   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2650   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2651   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2652   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2653   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2654   define variable v-diasize-current-frame-height as decimal   no-undo .
     2655   define variable v-diasize-change-size          as logical   no-undo .
     2656   define variable v-diasize-resize-button        as handle    no-undo .
     2657   define variable v-diasize-wndmax               as logical   no-undo .
     2658   define variable v-diasize-wndstore             as logical   no-undo .
     2659   define variable v-diasize-proc-name            as character no-undo .
     2660   define variable v-diasize-browse-handle        as handle    no-undo .
     2661   define variable v-diasize-browse-number        as integer   no-undo .
     2662   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2663   define temp-table temp-diasize-handle no-undo
     2664     field handle-value  as handle
     2665     field save-position as decimal
     2666     index xpk is primary unique handle-value
     2667     .
     2668   define temp-table temp-browse-handle no-undo
     2669     field browse-type   as character
     2670     field browse-number as integer
     2671     field browse-handle as handle
     2672     field original-size as decimal
     2673     index xpk is primary unique browse-type browse-number
     2674     index xie browse-type browse-handle
     2675   .
     2676   procedure diasize_change-height :
     2677     define input  parameter p-change-value  as decimal   no-undo .
     2678     define input  parameter p-move-resize   as logical   no-undo .
     2679     define variable v-field-group-handle    as handle    no-undo .
     2680     define variable v-object-handle         as handle    no-undo .
     2681     define variable v-frame-height          as decimal   no-undo .
     2682     define variable v-frame-virtual-height  as decimal   no-undo .
     2683     define variable v-browse-height         as decimal   no-undo .
     2684     define variable v-window-height         as decimal   no-undo .
     2685     define variable v-window-virtual-height as decimal   no-undo .
     2686     define variable v-change-sign           as integer   no-undo .
     2687     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2688     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2689     if p-change-value > 0
     2690     then do:
     2691       if frame Dialog-Frame :height + p-change-value
     2692           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2693       then do:
     2694         assign
     2695           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2696                           - (frame Dialog-Frame :height-chars)
     2697         .
     2698         if p-change-value <= 0
     2699         then do:
     2700           run diasize_position-resize-button in this-procedure .
     2701           return .
     2702         end.
     2703       end.
     2704     end.
     2705     if p-change-value < 0
     2706     then do:
     2707       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2708       then do:
     2709         assign
     2710           p-change-value = v-diasize-orig-frame-height
     2711                          - (frame Dialog-Frame :height-chars)
     2712         .
     2713         if p-change-value >= 0
     2714         then do:
     2715           run diasize_position-resize-button in this-procedure .
     2716           return .
     2717         end.
     2718       end.
     2719     end.
     2720     if p-change-value >= 0
     2721     then do:
     2722       assign
     2723         v-change-sign = 1
     2724       .
     2725     end.
     2726     else do:
     2727       assign
     2728         v-change-sign = -1
     2729       .
     2730     end.
     2731     assign
     2732       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2733     .
     2734     if p-change-value = 0
     2735     then do:
     2736       run diasize_position-resize-button in this-procedure .
     2737       return .
     2738     end.
     2739     move_block:
     2740     do
     2741     on error undo move_block, retry move_block
     2742     :
     2743       if retry
     2744       then do:
     2745         do
     2746         on error undo move_block, leave move_block
     2747         :
     2748           if p-change-value > 0
     2749           then do:
     2750             for each buf_temp-diasize-handle
     2751             on error undo, next
     2752             :
     2753               assign
     2754                 v-object-handle = buf_temp-diasize-handle.handle-value
     2755               .
     2756               if v-object-handle <> v-diasize-resize-button
     2757               then do:
     2758                 assign
     2759                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2760                 .
     2761               end.
     2762             end.
     2763             assign
     2764               v-diasize-browse-handle :height = v-browse-height
     2765             .
     2766             for each buf_temp-browse-handle
     2767               where buf_temp-browse-handle.browse-type = 'height':u
     2768             on error undo, next
     2769             :
     2770               assign
     2771                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2772               .
     2773             end.
     2774             assign
     2775               frame Dialog-Frame :height = v-frame-height
     2776             .
     2777             if frame Dialog-Frame :scrollable = true
     2778             then do:
     2779               assign
     2780                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2781               .
     2782             end.
     2783             run diasize_position-resize-button in this-procedure .
     2784           end.
     2785           else do:
     2786             if frame Dialog-Frame :scrollable = true
     2787             then do:
     2788               assign
     2789                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2790               .
     2791             end.
     2792             assign
     2793               frame Dialog-Frame :height = v-frame-height
     2794             .
     2795             assign
     2796               v-diasize-browse-handle :height = v-browse-height
     2797             .
     2798             for each buf_temp-browse-handle
     2799               where buf_temp-browse-handle.browse-type = 'height':u
     2800             on error undo, next
     2801             :
     2802               assign
     2803                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2804               .
     2805             end.
     2806             for each buf_temp-diasize-handle
     2807             on error undo, next
     2808             :
     2809               assign
     2810                 v-object-handle = buf_temp-diasize-handle.handle-value
     2811               .
     2812               if v-object-handle <> v-diasize-resize-button
     2813               then do:
     2814                 assign
     2815                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2816                 .
     2817               end.
     2818             end.
     2819             run diasize_position-resize-button in this-procedure .
     2820           end.
     2821           assign
     2822             v-diasize-change-size = false
     2823           .
     2824           leave move_block .
     2825         end.
     2826       end.
     2827       assign
     2828         v-diasize-need-full-display = true
     2829       .
     2830       if v-diasize-change-size = false
     2831       then do:
     2832         assign
     2833           v-diasize-change-size = true
     2834         .
     2835       end.
     2836       else do:
     2837         return .
     2838       end.
     2839       assign
     2840         v-frame-height = frame Dialog-Frame :height
     2841         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2842         v-browse-height = v-diasize-browse-handle :height
     2843       .
     2844       for each buf_temp-browse-handle
     2845         where buf_temp-browse-handle.browse-type = 'height':u
     2846       :
     2847         assign
     2848           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2849         .
     2850       end.
     2851       for each buf_temp-diasize-handle
     2852       :
     2853         delete buf_temp-diasize-handle .
     2854       end.
     2855       assign
     2856         v-field-group-handle = frame Dialog-Frame :first-child
     2857       .
     2858       do while valid-handle(v-field-group-handle)
     2859       :
     2860         assign
     2861           v-object-handle = v-field-group-handle :first-child
     2862         .
     2863         do while valid-handle(v-object-handle)
     2864         :
     2865           if  v-object-handle <> v-diasize-browse-handle :handle
     2866           and can-query(v-object-handle, "row")
     2867           and can-query(v-object-handle, "height")
     2868           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2869           then do:
     2870             find first buf_temp-browse-handle
     2871               where buf_temp-browse-handle.browse-type   = 'height':u
     2872                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2873               no-error .
     2874             if available buf_temp-browse-handle
     2875             then do:
     2876             end.
     2877             else do:
     2878               create buf_temp-diasize-handle .
     2879               assign
     2880                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2881                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2882               .
     2883             end.
     2884           end.
     2885           assign
     2886             v-object-handle = v-object-handle :next-sibling
     2887           .
     2888         end.
     2889         assign
     2890           v-field-group-handle = v-field-group-handle :next-sibling
     2891         .
     2892       end.
     2893       do with frame Dialog-Frame
     2894       :
     2895         hide v-diasize-resize-button .
     2896         assign
     2897           v-diasize-resize-button :row    = 1
     2898           v-diasize-resize-button :column = 1
     2899         .
     2900       end.
     2901       if p-change-value > 0
     2902       then do:
     2903         if frame Dialog-Frame :scrollable = true
     2904         then do:
     2905           assign
     2906             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2907             no-error .
     2908           if error-status :error
     2909           or error-status :get-message(1) <> ""
     2910           then do:
     2911             undo move_block, retry move_block .
     2912           end.
     2913         end.
     2914         assign
     2915           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2916           no-error .
     2917         if error-status :error
     2918         or error-status :get-message(1) <> ""
     2919         then do:
     2920           undo move_block, retry move_block .
     2921         end.
     2922         assign
     2923           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2924           no-error .
     2925         if error-status :error
     2926         or error-status :get-message(1) <> ""
     2927         then do:
     2928           undo move_block, retry move_block .
     2929         end.
     2930         for each buf_temp-browse-handle
     2931           where buf_temp-browse-handle.browse-type = 'height':u
     2932         on error undo move_block, retry move_block
     2933         :
     2934           assign
     2935             buf_temp-browse-handle.browse-handle :height
     2936               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2937             no-error .
     2938           if error-status :error
     2939           or error-status :get-message(1) <> ""
     2940           then do:
     2941             undo move_block, retry move_block .
     2942           end.
     2943         end.
     2944         for each buf_temp-diasize-handle
     2945         on error undo move_block, retry move_block
     2946         :
     2947           assign
     2948             v-object-handle = buf_temp-diasize-handle.handle-value
     2949           .
     2950           if v-object-handle <> v-diasize-resize-button
     2951           then do:
     2952             assign
     2953               v-object-handle :row = v-object-handle :row + p-change-value
     2954               no-error .
     2955             if error-status :error
     2956             or error-status :get-message(1) <> ""
     2957             then do:
     2958               undo move_block, retry move_block .
     2959             end.
     2960           end.
     2961         end.
     2962       end.
     2963       else do:
     2964         for each buf_temp-diasize-handle
     2965         on error undo move_block, retry move_block
     2966         :
     2967           assign
     2968             v-object-handle = buf_temp-diasize-handle.handle-value
     2969           .
     2970           if v-object-handle <> v-diasize-resize-button
     2971           then do:
     2972             assign
     2973               v-object-handle :row = v-object-handle :row + p-change-value
     2974               no-error .
     2975             if error-status :error
     2976             or error-status :get-message(1) <> ""
     2977             then do:
     2978               undo move_block, retry move_block .
     2979             end.
     2980           end.
     2981         end.
     2982         assign
     2983           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2984           no-error .
     2985         if error-status :error
     2986         or error-status :get-message(1) <> ""
     2987         then do:
     2988           undo move_block, retry move_block .
     2989         end.
     2990         for each buf_temp-browse-handle
     2991           where buf_temp-browse-handle.browse-type = 'height':u
     2992         on error undo move_block, retry move_block
     2993         :
     2994           assign
     2995             buf_temp-browse-handle.browse-handle :height
     2996               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2997             no-error .
     2998           if error-status :error
     2999           or error-status :get-message(1) <> ""
     3000           then do:
     3001             undo move_block, retry move_block .
     3002           end.
     3003         end.
     3004         assign
     3005           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3006           no-error .
     3007         if error-status :error
     3008         or error-status :get-message(1) <> ""
     3009         then do:
     3010           undo move_block, retry move_block .
     3011         end.
     3012         if frame Dialog-Frame :scrollable = true
     3013         then do:
     3014           assign
     3015             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3016             no-error .
     3017           if error-status :error
     3018           or error-status :get-message(1) <> ""
     3019           then do:
     3020             undo move_block, retry move_block .
     3021           end.
     3022         end.
     3023       end.
     3024       if p-move-resize = true
     3025       then do:
     3026         run diasize_position-resize-button in this-procedure .
     3027       end.
     3028       if v-diasize-wndstore = true
     3029       then do:
     3030         if connected("ub") = true
     3031         then do:
     3032           define variable v-cntxt-db-num        as integer   no-undo .
     3033           define variable v-cntxt-userid        as character no-undo .
     3034           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3035                                             , OUTPUT v-cntxt-userid
     3036                                             ) .
     3037           run gbl/wndsizew.p
     3038             (input  v-cntxt-db-num
     3039             ,input  v-cntxt-userid
     3040             ,input  v-diasize-proc-name
     3041             ,input  'height':u
     3042             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3043             ) .
     3044         end.
     3045       end.
     3046     end.
     3047     assign
     3048       v-diasize-change-size = false
     3049     .
     3050   end procedure.
     3051   procedure diasize_set-height :
     3052     define input  parameter p-new-height  as decimal   no-undo .
     3053     define input  parameter p-move-resize as logical   no-undo .
     3054     do
     3055     on error undo, return error return-value
     3056     :
     3057       run diasize_change-height in this-procedure
     3058         (input  (p-new-height - frame Dialog-Frame :height)
     3059         ,input  p-move-resize
     3060         ) .
     3061     end.
     3062   end procedure.
     3063   procedure diasize_change-width :
     3064     define input  parameter p-change-value as decimal   no-undo .
     3065     define input  parameter p-move-resize  as logical   no-undo .
     3066     define variable v-field-group-handle   as handle    no-undo .
     3067     define variable v-object-handle        as handle    no-undo .
     3068     define variable v-frame-width          as decimal   no-undo .
     3069     define variable v-frame-virtual-width  as decimal   no-undo .
     3070     define variable v-browse-width         as decimal   no-undo .
     3071     define variable v-window-width         as decimal   no-undo .
     3072     define variable v-window-virtual-width as decimal   no-undo .
     3073     define variable v-change-sign          as integer   no-undo .
     3074     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3075     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3076     if p-change-value > 0
     3077     then do:
     3078       if frame Dialog-Frame :width + p-change-value >
     3079           session :width-chars
     3080       then do:
     3081         assign
     3082           p-change-value = session :width-chars - frame Dialog-Frame :width
     3083         .
     3084         if p-change-value <= 0
     3085         then do:
     3086           run diasize_position-resize-button in this-procedure .
     3087           return .
     3088         end.
     3089       end.
     3090     end.
     3091     if p-change-value < 0
     3092     then do:
     3093       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3094       then do:
     3095         assign
     3096           p-change-value = v-diasize-orig-frame-width
     3097                          - frame Dialog-Frame :width
     3098         .
     3099         if p-change-value >= 0
     3100         then do:
     3101           run diasize_position-resize-button in this-procedure .
     3102           return .
     3103         end.
     3104       end.
     3105     end.
     3106     if p-change-value >= 0
     3107     then do:
     3108       assign
     3109         v-change-sign = 1
     3110       .
     3111     end.
     3112     else do:
     3113       assign
     3114         v-change-sign = -1
     3115       .
     3116     end.
     3117     assign
     3118       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3119     .
     3120     if p-change-value = 0
     3121     then do:
     3122       run diasize_position-resize-button in this-procedure .
     3123       return .
     3124     end.
     3125     move_block:
     3126     do
     3127     on error undo move_block, leave move_block
     3128     :
     3129       if retry
     3130       then do:
     3131         do
     3132         on error undo move_block, leave move_block
     3133         :
     3134           if p-change-value > 0
     3135           then do:
     3136             for each buf_temp-diasize-handle
     3137             on error undo, next
     3138             :
     3139               assign
     3140                 v-object-handle = buf_temp-diasize-handle.handle-value
     3141               .
     3142               if v-object-handle <> v-diasize-resize-button
     3143               then do:
     3144                 assign
     3145                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3146                 .
     3147               end.
     3148             end.
     3149             assign
     3150               v-diasize-browse-handle :width = v-browse-width
     3151             .
     3152             for each buf_temp-browse-handle
     3153               where buf_temp-browse-handle.browse-type = 'width':u
     3154             on error undo, next
     3155             :
     3156               assign
     3157                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3158               .
     3159             end.
     3160             assign
     3161               frame Dialog-Frame :width = v-frame-width
     3162             .
     3163             if frame Dialog-Frame :scrollable = true
     3164             then do:
     3165               assign
     3166                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3167               .
     3168             end.
     3169             run diasize_position-resize-button in this-procedure .
     3170           end.
     3171           else do:
     3172             if frame Dialog-Frame :scrollable = true
     3173             then do:
     3174               assign
     3175                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3176               .
     3177             end.
     3178             assign
     3179               frame Dialog-Frame :width = v-frame-width
     3180             .
     3181             for each buf_temp-browse-handle
     3182               where buf_temp-browse-handle.browse-type = 'width':u
     3183             on error undo, next
     3184             :
     3185               assign
     3186                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3187               .
     3188             end.
     3189             assign
     3190               v-diasize-browse-handle :width = v-browse-width
     3191             .
     3192             for each buf_temp-diasize-handle
     3193             on error undo, next
     3194             :
     3195               assign
     3196                 v-object-handle = buf_temp-diasize-handle.handle-value
     3197               .
     3198               if v-object-handle <> v-diasize-resize-button
     3199               then do:
     3200                 assign
     3201                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3202                 .
     3203               end.
     3204             end.
     3205             run diasize_position-resize-button in this-procedure .
     3206           end.
     3207           assign
     3208             v-diasize-change-size = false
     3209           .
     3210           leave move_block .
     3211         end.
     3212       end.
     3213       assign
     3214         v-diasize-need-full-display = true
     3215       .
     3216       if v-diasize-change-size = false
     3217       then do:
     3218         assign
     3219           v-diasize-change-size = true
     3220         .
     3221       end.
     3222       else do:
     3223         return .
     3224       end.
     3225       assign
     3226         v-frame-width = frame Dialog-Frame :width
     3227         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3228         v-browse-width = v-diasize-browse-handle :width
     3229       .
     3230       for each buf_temp-browse-handle
     3231         where buf_temp-browse-handle.browse-type = 'width':u
     3232       :
     3233         assign
     3234           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3235         .
     3236       end.
     3237       for each buf_temp-diasize-handle
     3238       :
     3239         delete buf_temp-diasize-handle .
     3240       end.
     3241       assign
     3242         v-field-group-handle = frame Dialog-Frame :first-child
     3243       .
     3244       do while valid-handle(v-field-group-handle)
     3245       :
     3246         assign
     3247           v-object-handle = v-field-group-handle :first-child
     3248         .
     3249         do while valid-handle(v-object-handle)
     3250         :
     3251           if  v-object-handle <> v-diasize-browse-handle :handle
     3252           and v-object-handle <> v-diasize-resize-button
     3253           and can-query(v-object-handle, "row")
     3254           and can-query(v-object-handle, "height")
     3255           and ( v-object-handle :col + v-object-handle :width
     3256                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3257               )
     3258           then do:
     3259             find first buf_temp-browse-handle
     3260               where buf_temp-browse-handle.browse-type   = 'width':u
     3261                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3262               no-error .
     3263             if available buf_temp-browse-handle
     3264             then do:
     3265             end.
     3266             else do:
     3267               create buf_temp-diasize-handle .
     3268               assign
     3269                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3270                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3271               .
     3272             end.
     3273           end.
     3274           assign
     3275             v-object-handle = v-object-handle :next-sibling
     3276           .
     3277         end.
     3278         assign
     3279           v-field-group-handle = v-field-group-handle :next-sibling
     3280         .
     3281       end.
     3282       do with frame Dialog-Frame
     3283       :
     3284         hide v-diasize-resize-button .
     3285         v-diasize-resize-button :row = 1.
     3286         v-diasize-resize-button :column = 1.
     3287       end.
     3288       if p-change-value > 0
     3289       then do:
     3290         if frame Dialog-Frame :scrollable = true
     3291         then do:
     3292           assign
     3293             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3294             no-error .
     3295           if error-status :error
     3296           or error-status :get-message(1) <> ""
     3297           then do:
     3298             undo move_block, retry move_block.
     3299           end.
     3300         end.
     3301         assign
     3302           frame Dialog-Frame :width = v-frame-width + p-change-value
     3303           no-error .
     3304         if error-status :error
     3305         or error-status :get-message(1) <> ""
     3306         then do:
     3307           undo move_block, retry move_block.
     3308         end.
     3309         assign
     3310           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3311         no-error .
     3312         if error-status :error
     3313         or error-status :get-message(1) <> ""
     3314         then do:
     3315           undo move_block, retry move_block.
     3316         end.
     3317         for each buf_temp-browse-handle
     3318           where buf_temp-browse-handle.browse-type = 'width':u
     3319         on error undo move_block, retry move_block
     3320         :
     3321           assign
     3322             buf_temp-browse-handle.browse-handle :width
     3323               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3324             no-error .
     3325           if error-status :error
     3326           or error-status :get-message(1) <> ""
     3327           then do:
     3328             undo move_block, retry move_block .
     3329           end.
     3330         end.
     3331         for each buf_temp-diasize-handle
     3332         on error undo move_block, retry move_block
     3333         :
     3334           assign
     3335             v-object-handle = buf_temp-diasize-handle.handle-value
     3336           .
     3337           if v-object-handle <> v-diasize-resize-button
     3338           then do:
     3339             assign
     3340               v-object-handle :col = v-object-handle :col + p-change-value
     3341               no-error .
     3342             if error-status :error
     3343             or error-status :get-message(1) <> ""
     3344             then do:
     3345               undo move_block, retry move_block .
     3346             end.
     3347           end.
     3348         end.
     3349       end.
     3350       else do:
     3351         for each buf_temp-diasize-handle
     3352         on error undo move_block, retry move_block
     3353         :
     3354           assign
     3355             v-object-handle = buf_temp-diasize-handle.handle-value
     3356           .
     3357           if v-object-handle <> v-diasize-resize-button
     3358           then do:
     3359             assign
     3360               v-object-handle :col = v-object-handle :col + p-change-value
     3361               no-error .
     3362             if error-status :error
     3363             or error-status :get-message(1) <> ""
     3364             then do:
     3365               undo move_block, retry move_block .
     3366             end.
     3367           end.
     3368         end.
     3369         for each buf_temp-browse-handle
     3370           where buf_temp-browse-handle.browse-type = 'width':u
     3371         on error undo move_block, retry move_block
     3372         :
     3373           assign
     3374             buf_temp-browse-handle.browse-handle :width
     3375               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3376             no-error .
     3377           if error-status :error
     3378           or error-status :get-message(1) <> ""
     3379           then do:
     3380             undo move_block, retry move_block .
     3381           end.
     3382         end.
     3383         assign
     3384           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3385           no-error .
     3386         if error-status :error
     3387         or error-status :get-message(1) <> ""
     3388         then do:
     3389           undo move_block, retry move_block.
     3390         end.
     3391         assign
     3392           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3393         no-error .
     3394         if error-status :error
     3395         or error-status :get-message(1) <> ""
     3396         then do:
     3397           undo move_block, retry move_block.
     3398         end.
     3399         if frame Dialog-Frame :scrollable = true
     3400         then do:
     3401           assign
     3402             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3403           no-error .
     3404           if error-status :error
     3405           or error-status :get-message(1) <> ""
     3406           then do:
     3407             undo move_block, retry move_block.
     3408           end.
     3409         end.
     3410       end.
     3411       if p-move-resize
     3412       then do:
     3413         run diasize_position-resize-button in this-procedure .
     3414       end.
     3415       if v-diasize-wndstore = true
     3416       then do:
     3417         if connected("ub") = true
     3418         then do:
     3419           define variable v-cntxt-db-num        as integer   no-undo .
     3420           define variable v-cntxt-userid        as character no-undo .
     3421           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3422                                             , OUTPUT v-cntxt-userid
     3423                                             ) .
     3424           run gbl/wndsizew.p
     3425             (input  v-cntxt-db-num
     3426             ,input  v-cntxt-userid
     3427             ,input  v-diasize-proc-name
     3428             ,input  'width':u
     3429             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3430             ) .
     3431         end.
     3432       end.
     3433     end.
     3434     assign
     3435       v-diasize-change-size = false
     3436     .
     3437   end procedure.
     3438   procedure diasize_set-width :
     3439     define input  parameter p-new-width  as decimal   no-undo .
     3440     define input  parameter p-move-resize as logical   no-undo .
     3441     do
     3442     on error undo, return error return-value
     3443     :
     3444       run diasize_change-width in this-procedure
     3445         (input  (p-new-width - frame Dialog-Frame :width)
     3446         ,input  p-move-resize
     3447         ) .
     3448     end.
     3449   end procedure.
     3450   procedure diasize_position-resize-button :
     3451     do with frame Dialog-Frame
     3452     :
     3453       hide v-diasize-resize-button .
     3454       assign
     3455         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3456                     - 1
     3457                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3458         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3459                     - 1
     3460                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3461       .
     3462       view v-diasize-resize-button .
     3463     end.
     3464   end procedure.
     3465   on alt-right anywhere
     3466   do:
     3467     run diasize_change-width in this-procedure
     3468       (input 1
     3469       ,input true
     3470       ) .
     3471     return no-apply .
     3472   end.
     3473   on alt-left anywhere
     3474   do:
     3475     run diasize_change-width in this-procedure
     3476       (input -1
     3477       ,input true
     3478       ) .
     3479     return no-apply .
     3480   end.
     3481   on alt-down anywhere
     3482   do:
     3483     run diasize_change-height in this-procedure
     3484       (input 1
     3485       ,input true
     3486       ) .
     3487     return no-apply .
     3488   end.
     3489   on alt-up anywhere
     3490   do:
     3491     run diasize_change-height in this-procedure
     3492       (input -1
     3493       ,input true
     3494       ) .
     3495     return no-apply .
     3496   end.
     3497   on alt-enter of frame Dialog-Frame
     3498   do:
     3499     run diasize_maximize in this-procedure
     3500       (input  ?
     3501       ).
     3502     return no-apply .
     3503   end.
     3504   procedure diasize_end-move :
     3505     do
     3506     on error undo, return error return-value
     3507     :
     3508       define variable v-row-delta as decimal   no-undo .
     3509       define variable v-col-delta as decimal   no-undo .
     3510       define variable v-new-row as decimal   no-undo .
     3511       define variable v-new-col as decimal   no-undo .
     3512       assign
     3513         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3514         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3515       .
     3516       assign
     3517         v-row-delta = v-new-row - frame Dialog-Frame :height
     3518         v-col-delta = v-new-col - frame Dialog-Frame :width
     3519       .
     3520       run diasize_change-height in this-procedure
     3521         (input v-row-delta
     3522         ,input true
     3523         ) .
     3524       run diasize_change-width in this-procedure
     3525         (input v-col-delta
     3526         ,input true
     3527         ) .
     3528     end.
     3529   end procedure.
     3530   procedure diasize_maximize :
     3531     define input  parameter p-action as logical   no-undo .
     3532     do
     3533     on error undo, return error return-value
     3534     :
     3535       if p-action = ?
     3536       then do:
     3537         if v-diasize-need-maximize = true
     3538         then do:
     3539           assign
     3540             p-action = true
     3541           .
     3542         end.
     3543         else do:
     3544           assign
     3545             p-action = false
     3546           .
     3547         end.
     3548       end.
     3549       if p-action = true
     3550       then do:
     3551         run diasize_change-height in this-procedure
     3552           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3553               - frame Dialog-Frame :height-chars
     3554           ,input true
     3555           ) .
     3556         run diasize_change-width in this-procedure
     3557           (input session :width-chars
     3558               - frame Dialog-Frame :width-chars
     3559           ,input true
     3560           ) .
     3561         assign
     3562           v-diasize-need-maximize = false
     3563         .
     3564       end.
     3565       else do:
     3566         run diasize_change-width in this-procedure
     3567           (input v-diasize-orig-frame-width
     3568               - frame Dialog-Frame :width-chars
     3569           ,input true
     3570           ) .
     3571         run diasize_change-height in this-procedure
     3572           (input v-diasize-orig-frame-height
     3573               - frame Dialog-Frame :height-chars
     3574           ,input true
     3575           ) .
     3576         assign
     3577           v-diasize-need-maximize = true
     3578         .
     3579       end.
     3580     end.
     3581   end procedure.
     3582   procedure diasize_restore-orig-size :
     3583     do
     3584     on error undo, return error return-value
     3585     :
     3586       assign
     3587         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3588         v-diasize-current-frame-height = frame Dialog-Frame :height
     3589       .
     3590       run diasize_set-height in this-procedure
     3591         (input  v-diasize-orig-frame-height
     3592         ,input  true
     3593         ) .
     3594       run diasize_set-width in this-procedure
     3595         (input  v-diasize-orig-frame-width
     3596         ,input  true
     3597         ) .
     3598     end.
     3599   end procedure.
     3600   procedure diasize_restore-current-size :
     3601     do
     3602     on error undo, return error return-value
     3603     :
     3604       run diasize_set-height in this-procedure
     3605         (input  v-diasize-current-frame-height
     3606         ,input  true
     3607         ) .
     3608       run diasize_set-width in this-procedure
     3609         (input  v-diasize-current-frame-width
     3610         ,input  true
     3611         ) .
     3612     end.
     3613   end procedure.
     3614   procedure diasize_set-browse-handle :
     3615     define input  parameter p-browse-handle as handle   no-undo .
     3616     define buffer buf_temp-browse-handle for temp-browse-handle .
     3617     do
     3618     on error undo, return error return-value
     3619     :
     3620       assign
     3621         v-diasize-browse-handle = p-browse-handle
     3622       .
     3623       for each buf_temp-browse-handle
     3624       on error undo, return error return-value
     3625       :
     3626         delete buf_temp-browse-handle .
     3627       end.
     3628     end.
     3629   end procedure.
     3630   procedure diasize_add_browse :
     3631     define input  parameter p-browse-type   as character no-undo .
     3632     define input  parameter p-browse-handle as handle    no-undo .
     3633     define buffer buf_temp-browse-handle for temp-browse-handle .
     3634     do
     3635     on error undo, return error return-value
     3636     :
     3637       assign
     3638         v-diasize-browse-number = v-diasize-browse-number + 1
     3639       .
     3640       create buf_temp-browse-handle .
     3641       assign
     3642         buf_temp-browse-handle.browse-type   = p-browse-type
     3643         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3644         buf_temp-browse-handle.browse-handle = p-browse-handle
     3645       .
     3646     end.
     3647   end procedure.
     3648   procedure diasize_init :
     3649     define variable v-default-value    as logical   no-undo .
     3650     define variable v-restore-saved    as logical   no-undo .
     3651     define variable v-resize-value-str as character no-undo .
     3652     do
     3653     on error undo, return error return-value
     3654     :
     3655       do with frame Dialog-Frame
     3656       :
     3657         assign
     3658           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3659           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3660           v-diasize-browse-handle     = browse br-gds-act :handle
     3661         .
     3662         create button v-diasize-resize-button
     3663         assign
     3664           parent        = frame Dialog-Frame :first-child
     3665           label         = "s"
     3666           height-pixels = 16
     3667           width-pixels  = 16
     3668           visible       = true
     3669           sensitive     = true
     3670           movable       = true
     3671           triggers:
     3672             on end-move persistent run diasize_end-move in this-procedure .
     3673           end triggers.
     3674         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3675         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3676         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3677         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3678         assign
     3679           v-diasize-wndmax = false
     3680         .
     3681         if connected("ub") = true
     3682         then do:
     3683           define variable v-cntxt-db-num        as integer   no-undo .
     3684           define variable v-cntxt-userid        as character no-undo .
     3685           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3686                                             , OUTPUT v-cntxt-userid
     3687                                             ) .
     3688           run gbl/wndpar_r.p
     3689             (input  v-cntxt-db-num
     3690             ,input  v-cntxt-userid
     3691             ,input  'wndmax':U
     3692             ,output v-diasize-wndmax
     3693             ,output v-default-value
     3694             ) .
     3695         end.
     3696         assign
     3697           v-diasize-wndstore = false
     3698         .
     3699         if connected("ub") = true
     3700         then do:
     3701           run gbl/wndpar_r.p
     3702             (input  v-cntxt-db-num
     3703             ,input  v-cntxt-userid
     3704             ,input  'wndstore':U
     3705             ,output v-diasize-wndstore
     3706             ,output v-default-value
     3707             ) .
     3708         end.
     3709         assign
     3710           v-diasize-proc-name = entry(1, program-name(2), '.')
     3711         .
     3712         if v-diasize-wndstore = true
     3713         then do:
     3714           assign
     3715             v-restore-saved = false
     3716           .
     3717           if connected("ub") = true
     3718           then do:
     3719             run gbl/wndsizer.p
     3720               (input  v-cntxt-db-num
     3721               ,input  v-cntxt-userid
     3722               ,input  v-diasize-proc-name
     3723               ,input  'height':u
     3724               ,output v-resize-value-str
     3725               ) .
     3726             if v-resize-value-str <> '':U
     3727             then do:
     3728               run diasize_change-height in this-procedure
     3729                 (input  integer(v-resize-value-str)
     3730                 ,input  true
     3731                 ) .
     3732               assign
     3733                 v-restore-saved = true
     3734               .
     3735             end.
     3736           end.
     3737           if connected("ub") = true
     3738           then do:
     3739             run gbl/wndsizer.p
     3740               (input  v-cntxt-db-num
     3741               ,input  v-cntxt-userid
     3742               ,input  v-diasize-proc-name
     3743               ,input  'width':u
     3744               ,output v-resize-value-str
     3745               ) .
     3746             if v-resize-value-str <> '':U
     3747             then do:
     3748               run diasize_change-width in this-procedure
     3749                 (input  integer(v-resize-value-str)
     3750                 ,input  true
     3751                 ) .
     3752               assign
     3753                 v-restore-saved = true
     3754               .
     3755             end.
     3756           end.
     3757           if v-restore-saved <> true
     3758           then do:
     3759             if v-diasize-wndmax = true
     3760             then do:
     3761               run diasize_maximize in this-procedure
     3762                 (input  true
     3763                 ) .
     3764             end.
     3765           end.
     3766         end.
     3767         else do:
     3768           if v-diasize-wndmax = true
     3769           then do:
     3770             run diasize_maximize in this-procedure
     3771               (input  true
     3772               ) .
     3773           end.
     3774         end.
     3775       end.
     3776     end.
     3777   end procedure.
     3778   procedure diasize_need-full-display :
     3779     define output parameter p-need-full-display as logical   no-undo .
     3780     do
     3781     on error undo, return error return-value
     3782     :
     3783       assign
     3784         p-need-full-display = v-diasize-need-full-display
     3785       .
     3786       assign
     3787         v-diasize-need-full-display = false
     3788       .
     3789     end.
     3790   end procedure.
     3791   procedure get-context :
     3792      define output parameter p-db-num as integer          no-undo.
     3793      define output parameter p-user-id as character        no-undo.
     3794      define variable v-login               as character    no-undo.
     3795      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3796      define buffer buf_user-login  for ub.user-login .
     3797      do
     3798      on error undo, return error
     3799      :
     3800            FIND FIRST buf_sys-ctrl no-lock.
     3801            ASSIGN
     3802               v-login = USERID("ub")
     3803               p-db-num = buf_sys-ctrl.db-num
     3804            .
     3805            FIND FIRST buf_user-login
     3806                 WHERE buf_user-login.db-num = p-db-num
     3807                   AND buf_user-login.user-login = v-login
     3808                 no-lock
     3809                 no-error
     3810                 .
     3811            IF AVAILABLE buf_user-login
     3812            THEN DO:
     3813               assign
     3814                  p-user-id = buf_user-login.user-id
     3815               .
     3816            END.
     3817      end.
     3818   end procedure.
     3819       run diasize_init in this-procedure .
     3820       RUN enable_UI.
     3821       WAIT-FOR GO OF FRAME Dialog-Frame.
     3822   END.
     3823   RUN disable_UI.
     3824   PROCEDURE proc-b-mark :
     3825     define variable varlog as logical   no-undo .
     3826     if not available tt-gds-act then return.
     3827     run local-mark in this-procedure.
     3828     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     3829     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     3830     br-gds-act:refresh() in frame Dialog-Frame .
     3831   END PROCEDURE.
     3832   PROCEDURE local-mark :
     3833     if not available tt-gds-act then do:
     3834       message "Неправильный выбор строки.".
     3835       return no-apply.
     3836     end.
     3837   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3838   define variable v-str-recid15 as character no-undo .
     3839   define variable v-num-entry15 as integer   no-undo .
     3840   assign
     3841     v-str-recid15 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     3842     v-num-entry15 = lookup( v-str-recid15 , select-list )
     3843   .
     3844   if v-num-entry15 > 0 then do:
     3845     assign
     3846       entry( v-num-entry15, select-list ) = "":U
     3847       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3848     .
     3849   end.
     3850   else do:
     3851     assign
     3852       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     3853     .
     3854   end.
     3855     br-gds-act:refresh() in frame Dialog-Frame .
     3856   END PROCEDURE.
     3857   PROCEDURE disable_UI :
     3858     HIDE FRAME Dialog-Frame.
     3859   END PROCEDURE.
     3860   PROCEDURE enable_UI :
     3861     ENABLE b-cancel  b-save br-gds-act b-del b-mark b-sel-all b-unmark
     3862         WITH FRAME Dialog-Frame.
     3863     VIEW FRAME Dialog-Frame.
     3864       if p-mode = 'ПРОСМОТР':U then do :
     3865           disable  tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     3866           define variable hCol as handle no-undo .
     3867           define variable hBr  as handle no-undo .
     3868           define variable i    as integer no-undo .
     3869           hBr = browse br-gds-act:handle .
     3870           do i = 6 to 7 :
     3871               hCol = hBr:GET-BROWSE-COLUMN(i).
     3872               hCol:read-only = true .
     3873           end.
     3874           hide b-good b-save b-del in FRAME Dialog-Frame.
     3875       end.
     3876   END PROCEDURE.
