      600   procedure xmlchar-decode :
      601   define input parameter p-in-string      as character        no-undo.
      602   define output parameter p-out-string    as character        no-undo.
      603       define variable v-position      as integer      no-undo.
      604       define variable v-last-position as integer      no-undo.
      605       define variable v-temp-integer  as integer      no-undo.
      606       define variable v-current-char  as character    no-undo.
      607       define variable v-next-char     as character    no-undo.
      608       define variable v-success       as logical      no-undo.
      609   do
      610   on error undo, return error
      611   :
      612       assign
      613           p-out-string = "":U
      614           v-position   = 0
      615       .
      616       replace-cycle:
      617       do while yes
      618       on error undo, return error
      619       :
      620           assign
      621               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      622           .
      623           if v-last-position <= v-position
      624           then do:
      625               if v-position = 0
      626               then do:
      627                   assign
      628                       p-out-string = p-in-string
      629                   .
      630               end.
      631               else do:
      632                   assign
      633                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      634                   .
      635               end.
      636               leave replace-cycle.
      637           end.
      638           else do:
      639               assign
      640                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      641                   v-position      = v-last-position
      642                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      643               .
      644               if v-current-char = "#":U
      645               then do:
      646                   assign
      647                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      648                   .
      649                   if v-last-position > 0
      650                   then do:
      651                       run xmlchar-read-integer in this-procedure
      652                        (
      653                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      654                           , output v-temp-integer
      655                           , output v-success
      656                       ).
      657                       if v-success = yes
      658                       and v-temp-integer >= 1
      659                       and v-temp-integer <= 255
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + chr( v-temp-integer )
      663                               v-position   = v-last-position + 1
      664                           .
      665                       end.
      666                       else do:
      667                           assign
      668                               p-out-string = p-out-string + "&":U
      669                               v-position   = v-position   + 1
      670                           .
      671                       end.
      672                   end.
      673                   else do:
      674                       assign
      675                           p-out-string = p-out-string + "&":U
      676                           v-position   = v-position   + 1
      677                       .
      678                   end.
      679               end.
      680               else do:
      681                   case substring( p-in-string, v-position + 1, 3 )
      682                   :
      683                       when "lt;":U
      684                       then do:
      685                           assign
      686                               p-out-string = p-out-string + "<":U
      687                               v-position   = v-position   + 3
      688                           .
      689                       end.
      690                       when "gt;":U
      691                       then do:
      692                           assign
      693                               p-out-string = p-out-string + ">":U
      694                               v-position   = v-position   + 3
      695                           .
      696                       end.
      697                       otherwise do:
      698                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      699                           then do:
      700                               assign
      701                                   p-out-string = p-out-string + "&":U
      702                                   v-position   = v-position   + 4
      703                               .
      704                           end.
      705                           else do:
      706                               case substring( p-in-string, v-position + 1, 5 )
      707                               :
      708                                   when "quot;":U
      709                                   then do:
      710                                       assign
      711                                           p-out-string = p-out-string + '"':U
      712                                           v-position   = v-position   + 5
      713                                       .
      714                                   end.
      715                                   when "apos;":U
      716                                   then do:
      717                                       assign
      718                                           p-out-string = p-out-string + "'":U
      719                                           v-position   = v-position   + 5
      720                                       .
      721                                   end.
      722                                   otherwise do:
      723                                       assign
      724                                           p-out-string = p-out-string + "&":U
      725                                       .
      726                                   end.
      727                               end case.
      728                           end.
      729                       end.
      730                   end case.
      731               end.
      732           end.
      733       end.
      734   end.
      735   end .
      736   procedure xmlchar-read-integer :
      737   define input parameter p-input-string      as character        no-undo.
      738   define output parameter p-output-integer   as integer          no-undo.
      739   define output parameter p-success       as logical          no-undo.
      740   do
      741   on error undo, return error
      742   :
      743       assign
      744           p-output-integer = integer( p-input-string )
      745       no-error.
      746       if error-status :error
      747       then do:
      748           assign
      749               p-success           = no
      750               p-output-integer    = 0
      751           .
      752       end.
      753       else do:
      754           assign
      755               p-success           = yes
      756           .
      757       end.
      758   end.
      759   end.
      760   define variable v-bgelib-bgeclall           as logical      no-undo.
      761   define variable v-bgelib-bgedict            as logical      no-undo.
      762   define temp-table temp_ext-doc-type no-undo
      763       field edt-key               as integer
      764       field ext-doc-type          as character
      765       field ext-doc-type-label    as character
      766       index pi is primary unique
      767           edt-key
      768   .
      769   define temp-table temp_bgelib_goods no-undo
      770       field gds-code as integer
      771       index pi is primary unique
      772           gds-code
      773   .
      774   define temp-table temp_bgelib_clients no-undo
      775       field obj-type as character
      776       field obj-code as integer
      777       index pi is primary unique
      778           obj-type
      779           obj-code
      780   .
      781   define temp-table temp_bgelib_dis-card no-undo
      782       field d-card as character
      783       index pi is primary unique
      784           d-card
      785   .
      786   define temp-table temp_bgelib_trn-doc no-undo
      787       field doc-code as integer
      788   .
      789   procedure bgelib-tag-open:
      790   do
      791   on error undo, return error
      792   :
      793   define input parameter v-tag-level  as integer      no-undo.
      794   define input parameter v-tag-name   as character    no-undo.
      795   define input parameter v-tag-value  as character    no-undo.
      796       put stream stmXMLOut unformatted
      797           chr(10)
      798           + fill(" ", 4 * v-tag-level)
      799           + "<" + v-tag-name
      800           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      801           + v-tag-value + ">"
      802       .
      803   end.
      804   end procedure.
      805   procedure bgelib-tag-put:
      806   do
      807   on error undo, return error
      808   :
      809   define input parameter v-tag-level      as integer      no-undo.
      810   define input parameter v-tag-name       as character    no-undo.
      811   define input parameter v-tag-value      as character    no-undo.
      812   define input parameter v-empty-mode     as integer      no-undo.
      813       v-tag-name = trim(v-tag-name).
      814       if  v-empty-mode = 1
      815       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      816       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      817       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      818       then do:
      819           run xmlchar-encode in this-procedure (
      820                 input v-tag-value
      821               , output v-tag-value
      822           ).
      823           put stream stmXMLOut unformatted
      824               chr(10) + fill(" ", 4 * v-tag-level)
      825                           + '<' + v-tag-name + '>'
      826                           + v-tag-value
      827                           + '</' + v-tag-name + '>'
      828           .
      829       end.
      830   end.
      831   end procedure.
      832   procedure bgelib-tag-close:
      833   do
      834   on error undo, return error
      835   :
      836   define input parameter v-tag-level as integer      no-undo.
      837   define input parameter v-tag-name  as character    no-undo.
      838       put stream stmXMLOut unformatted
      839           chr(10)
      840           + fill( " ", 4 * v-tag-level)
      841           + '</' + v-tag-name + '>'
      842       .
      843   end.
      844   end procedure.
      845   procedure bgelib-write-log:
      846   do
      847   on error undo, return error
      848   :
      849   define input parameter v-filename   as character    no-undo.
      850   define input parameter v-log-level  as integer      no-undo.
      851   define input parameter v-out-string as character    no-undo.
      852       output stream stmXMLLog to value( v-filename ) append.
      853       put stream stmXMLLog unformatted
      854           chr(10)
      855       .
      856       put stream stmXMLLog unformatted
      857           ( if v-log-level = 0
      858             or v-out-string = "&DLine"
      859             or v-out-string = "&Line"
      860             then ""
      861             else cur-time-string-sec() + " " )
      862       .
      863       put stream stmXMLLog unformatted
      864           ( if v-out-string = "&Line"
      865             then fill( "-", 80 )
      866             else if v-out-string = "&DLine"
      867                  then fill( "=", 80 )
      868                  else v-out-string )
      869       .
      870       output stream stmXMLLog close.
      871   end.
      872   end procedure.
      873   procedure bgelib-write-edt:
      874   do
      875   on error undo, return error
      876   :
      877   define input parameter v-editor-handle    as handle       no-undo.
      878   define input parameter v-log-level        as integer      no-undo.
      879   define input parameter v-out-string       as character    no-undo.
      880       if valid-handle ( v-editor-handle )
      881       then do:
      882           v-editor-handle :move-to-eof().
      883           v-editor-handle :insert-string( ( if v-log-level = 0
      884                                             or v-out-string = "&DLine"
      885                                             or v-out-string = "&Line"
      886                                             then ""
      887                                             else cur-time-string-sec() + " "
      888                                         ) ).
      889           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      890                                             then fill( "-", 80 )
      891                                             else if v-out-string = "&DLine" then fill("=", 80)
      892                                             else fill( " ", v-log-level) + v-out-string
      893                                         ) ).
      894           v-editor-handle :insert-string( chr(10) ).
      895       end.
      896       process events.
      897       output to 'bgescn.txt' append.
      898           put unformatted
      899               chr(10)
      900               string( ( if v-log-level = 0
      901                         or v-out-string = "&DLine"
      902                         or v-out-string = "&Line"
      903                         then ""
      904                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      905                     ) )
      906               string( ( if v-out-string = "&Line"
      907                         then fill( "-", 80 )
      908                         else if v-out-string = "&DLine"
      909                              then fill( "=", 80 )
      910                              else fill( " ", v-log-level ) + v-out-string
      911                     ) )
      912           .
      913       output close.
      914   end.
      915   end procedure.
      916   procedure bgelib-show-cnt:
      917   do
      918   on error undo, return error
      919   :
      920   define input parameter v-fillin-handle     as handle   no-undo.
      921       if valid-handle( v-fillin-handle )
      922       then do:
      923           assign
      924               v-fillin-handle :visible = true
      925           .
      926       end.
      927   end.
      928   end procedure.
      929   procedure bgelib-hide-cnt:
      930   do
      931   on error undo, return error
      932   :
      933   define input parameter v-fillin-handle     as handle   no-undo.
      934       if valid-handle( v-fillin-handle )
      935       then do:
      936           assign v-fillin-handle :visible = false.
      937       end.
      938   end.
      939   end procedure.
      940   procedure bgelib-write-cnt:
      941   do
      942   on error undo, return error
      943   :
      944   define input parameter v-fillin-handle    as handle       no-undo.
      945   define input parameter v-fillin-string    as character    no-undo.
      946       if valid-handle( v-fillin-handle )
      947       then do:
      948           assign
      949               v-fillin-handle :SCREEN-value = v-fillin-string
      950           .
      951       end.
      952   end.
      953   end procedure.
      954   procedure bgelib-write-header:
      955   do
      956   on error undo, return error
      957   :
      958   define input parameter p-first-file     as logical      no-undo.
      959   define input parameter p-xml-file-name  as character    no-undo.
      960   define input parameter p-list-file-name as character    no-undo.
      961   define input parameter p-file-number    as integer      no-undo.
      962   define input parameter p-have-prev      as logical      no-undo.
      963   define input parameter p-prev-filename  as character    no-undo.
      964   define input parameter p-obj-list       as character    no-undo.
      965   define input parameter p-doc-type-list  as character    no-undo.
      966   define input parameter p-parameter-list as character    no-undo.
      967       define variable v-counter    as integer        no-undo.
      968       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      969       put stream stmXMLOut unformatted
      970           "<?xml version='1.0' encoding='windows-1251'?>"
      971       .
      972       run bgelib-tag-open( input 0, input "root"  , input "" ).
      973       run bgelib-tag-open( input 0, input "header", input "" ).
      974       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      975       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      976       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      977       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      978       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      979       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      980       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      981       :
      982           run bgelib-tag-put(
      983                 input 1
      984               , input entry( 2 * v-counter, p-parameter-list )
      985               , input entry( 2 * v-counter + 1, p-parameter-list )
      986               , input 0
      987           ).
      988       end.
      989       run bgelib-tag-close( input 0, input "header" ).
      990       output stream stmXMLOut close.
      991       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      992       if p-first-file = yes
      993       then do:
      994           put stream stmXMLOut unformatted
      995               "<?xml version='1.0' encoding='windows-1251'?>"
      996           .
      997           run bgelib-tag-open( input 0, input "export", input "" ).
      998       end.
      999       run bgelib-tag-open( input 1, input "file", input "" ).
     1000       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1001       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1002       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1003       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1004       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1005       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1006       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1007       :
     1008           run bgelib-tag-put(
     1009                 input 2
     1010               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1011               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1012               , input 0
     1013           ).
     1014       end.
     1015       run bgelib-tag-close( input 1, input "file" ).
     1016       output stream stmXMLOut close.
     1017   end.
     1018   end procedure.
     1019   procedure bgelib-write-footer:
     1020   do
     1021   on error undo, return error
     1022   :
     1023   define input parameter p-last-file      as logical      no-undo.
     1024   define input parameter p-xml-file-name  as character    no-undo.
     1025   define input parameter p-list-file-name as character    no-undo.
     1026   define input parameter p-have-next      as logical      no-undo.
     1027   define input parameter p-next-file-name as character    no-undo.
     1028       define variable v-error-num     as integer           no-undo.
     1029       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1030       if p-have-next = yes
     1031       then do:
     1032           run bgelib-tag-open( input 0, input "footer", "" ).
     1033           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1034           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1035           run bgelib-tag-close( input 0, input "footer" ).
     1036       end.
     1037       run bgelib-tag-close( input 0, input "root" ).
     1038       output stream stmXMLOut close.
     1039       run bge/os_copy.p (
     1040             input "M"
     1041           , input p-xml-file-name + "tmp"
     1042           , input p-xml-file-name + "xml"
     1043           , output v-error-num
     1044       ).
     1045       if p-last-file = yes
     1046       then do:
     1047           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1048               run bgelib-tag-close( input 0, input "export" ).
     1049           output stream stmXMLOut close.
     1050           run bge/os_copy.p (
     1051                 input "M"
     1052               , input p-list-file-name + "tmp"
     1053               , input p-list-file-name + "xml"
     1054               , output v-error-num
     1055           ).
     1056       end.
     1057   end.
     1058   end procedure.
     1059   procedure bgelib-filename :
     1060   do
     1061   on error undo, return error
     1062   :
     1063   define input parameter p-prefix             as character    no-undo.
     1064   define output parameter p-xml-file-name     as character    no-undo.
     1065   define output parameter p-log-file-name     as character    no-undo.
     1066   define output parameter p-list-file-name    as character    no-undo.
     1067       define variable v-home-dir  as character    no-undo.
     1068       define variable v-error-num as integer      no-undo.
     1069       get-key-value section "BGE" key "outdir" value v-home-dir.
     1070       if v-home-dir = ?
     1071       then do:
     1072           message
     1073             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1074             skip(1)
     1075             skip "Обратитесь к администратору."
     1076           view-as alert-box error.
     1077           undo, return error .
     1078       end.
     1079       run gbl/dir-cre.p (
     1080           input v-home-dir
     1081       ) no-error.
     1082       if error-status :error
     1083       then do:
     1084           message
     1085             skip "Неверно задан каталог экспорта."
     1086             skip(1)
     1087             skip "Обратитесь к администратору."
     1088           view-as alert-box error.
     1089           undo, return error .
     1090       end.
     1091       run bge/genfname.p (
     1092             input v-home-dir
     1093           , input p-prefix
     1094           , input ""
     1095           , input "xml"
     1096           , input "tmp"
     1097           , output p-xml-file-name
     1098       ).
     1099       assign
     1100           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1101           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1102           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1103       .
     1104   end.
     1105   end procedure.
     1106   procedure bgelib-read-config :
     1107   do
     1108   on error undo, return error
     1109   :
     1110   define variable v-par-type as character     no-undo.
     1111     define variable v-param-type      as character  no-undo .
     1112     define variable v-value-character as character  no-undo .
     1113     define variable v-value-date      as date       no-undo .
     1114     define variable v-value-decimal   as decimal    no-undo .
     1115     define variable v-value-integer   as integer    no-undo .
     1116     define variable v-value-logical   as logical    no-undo .
     1117     define variable v-tth             as handle     no-undo .
     1118       assign
     1119           v-bgelib-bgeclall = no
     1120           v-bgelib-bgedict  = no
     1121       .
     1122       run adm/shattri.p ( input "get":U
     1123                         , input  '':u
     1124                         , input  0
     1125                         , input  'bge-export':U
     1126                         , input  'bgeclall':U
     1127                         , output v-value-character
     1128                         , output v-value-date
     1129                         , output v-value-decimal
     1130                         , output v-value-integer
     1131                         , output v-value-logical
     1132                         , output v-param-type
     1133                         , input-output table-handle v-tth
     1134                         ) no-error .
     1135       if error-status :error
     1136       then do:
     1137         assign
     1138           v-bgelib-bgeclall = no
     1139         .
     1140       end.
     1141       else do:
     1142         assign
     1143           v-bgelib-bgeclall = v-value-logical
     1144         .
     1145       end.
     1146       delete object v-tth.
     1147       run adm/shattri.p ( input "get":U
     1148                         , input  '':u
     1149                         , input  0
     1150                         , input  'bge-export':U
     1151                         , input  'bgedict':U
     1152                         , output v-value-character
     1153                         , output v-value-date
     1154                         , output v-value-decimal
     1155                         , output v-value-integer
     1156                         , output v-value-logical
     1157                         , output v-param-type
     1158                         , input-output table-handle v-tth
     1159                         ) no-error .
     1160       if error-status :error
     1161       then do:
     1162         assign
     1163           v-bgelib-bgedict = no
     1164         .
     1165       end.
     1166       else do:
     1167         assign
     1168           v-bgelib-bgedict = v-value-logical
     1169         .
     1170       end.
     1171       delete object v-tth.
     1172       run adm/shattri.p ( input "get":U
     1173                         , input  '':u
     1174                         , input  0
     1175                         , input  'bge-export':U
     1176                         , input  'bgefmt':U
     1177                         , output v-value-character
     1178                         , output v-value-date
     1179                         , output v-value-decimal
     1180                         , output v-value-integer
     1181                         , output v-value-logical
     1182                         , output v-param-type
     1183                         , input-output table-handle v-tth
     1184                         ) no-error .
     1185       if error-status :error
     1186       then do:
     1187         assign
     1188           v-bgelib-bgefmt  = "xml":U
     1189         .
     1190       end.
     1191       else do:
     1192         assign
     1193           v-bgelib-bgefmt  = v-value-character
     1194         .
     1195       end.
     1196       delete object v-tth.
     1197       run adm/shattri.p ( input "get":U
     1198                         , input  '':u
     1199                         , input  0
     1200                         , input  'bge-export':U
     1201                         , input  'bgeflold':U
     1202                         , output v-value-character
     1203                         , output v-value-date
     1204                         , output v-value-decimal
     1205                         , output v-value-integer
     1206                         , output v-value-logical
     1207                         , output v-param-type
     1208                         , input-output table-handle v-tth
     1209                         ) no-error .
     1210       if error-status :error
     1211       then do:
     1212         assign
     1213           v-bgelib-bgeflold  = "old":U
     1214         .
     1215       end.
     1216       else do:
     1217         assign
     1218           v-bgelib-bgeflold  = v-value-character
     1219         .
     1220       end.
     1221       delete object v-tth.
     1222   end.
     1223   end procedure.
     1224   procedure bgelib-check-file-size :
     1225   do
     1226   on error undo, return error
     1227   :
     1228   define input parameter p-out-filename   as character    no-undo.
     1229   define output parameter p-is-big        as logical      no-undo.
     1230       define variable v-current-position    as integer        no-undo.
     1231       assign
     1232           v-current-position = seek( stmXMLOut )
     1233       .
     1234       if v-current-position / 1024 / 1024  >= 100
     1235       then do:
     1236           assign
     1237               p-is-big = yes
     1238           .
     1239       end.
     1240   end.
     1241   end procedure.
     1242   procedure bgelib-init-ext-doc-type :
     1243       define variable v-counter    as integer      no-undo.
     1244       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1245   do
     1246   for buf_temp_ext-doc-type
     1247   on error undo, return error
     1248   :
     1249       empty temp-table buf_temp_ext-doc-type.
     1250       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1251       :
     1252           create buf_temp_ext-doc-type.
     1253           assign
     1254               buf_temp_ext-doc-type.edt-key               = v-counter
     1255               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1256               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1257           .
     1258       end.
     1259   end.
     1260   end procedure.
     1261   define new global shared variable g#lib-trn  as handle no-undo .
     1262   define new global shared variable g#lib-trn2 as handle no-undo .
     1263   define new global shared variable g#lib-trn3 as handle no-undo .
     1264   define new global shared variable g#lib-trn4 as handle no-undo .
     1265   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   define new global shared variable g#trdcalib as handle no-undo.
     1267       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1268       define buffer   in-vatp-parts    for ub.parts   .
     1269       define buffer   in-vatp-doc      for ub.trn-doc .
     1270       define buffer   in-vatp-goods    for ub.goods   .
     1271       define buffer   in-vatp-sysconf  for ub.sysconf .
     1272       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1273       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1274       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1275       define variable varinvprb                  as   character              no-undo.
     1276       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1277       define variable cli-base-rate              as   decimal                no-undo.
     1278       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1279       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1280       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1281       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1282       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1283       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1284       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1285       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1286       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1287       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1288       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1289       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1290       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1291       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1292       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1293       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1294       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1295       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1296       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1297       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1298       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1299       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1300       define variable varinvatp-envd             as   character              no-undo.
     1301       define variable varinvatp-type             as   character              no-undo.
     1302   do
     1303   on error undo, return error
     1304   :
     1305     define variable v-exists-operation          as logical       no-undo.
     1306     define variable v-doc-date        like ub.trn-doc.doc-date   no-undo.
     1307     define variable v-fact-date       like ub.trn-doc.fact-date  no-undo.
     1308     define variable v-doc-PS          like ub.trn-doc.PS         no-undo.
     1309     define variable v-host-code                 as integer       no-undo.
     1310     define variable v-base-code                 as integer       no-undo.
     1311     define variable v-base-abbr       like ub.currency.curr-abbr no-undo.
     1312     define variable v-base-name       like ub.currency.curr-name no-undo.
     1313     define variable v-last-file-position        as integer       no-undo.
     1314     define buffer buf_currency for ub.currency.
     1315     define variable v-firm-only as logical   no-undo .
     1316     define buffer buf_sysconf for ub.sysconf.
     1317     find first buf_sysconf no-lock where buf_sysconf.host-code = p-host-code no-error .
     1318     if buf_sysconf.fin-calc = 0 then v-firm-only = true.
     1319     else v-firm-only = false .
     1320     define variable v-i as integer   no-undo .
     1321     define variable v-obj-list as character no-undo .
     1322     if v-firm-only = false  then do:
     1323     repeat v-i = 1 to num-entries ( p-obj-list )  by 2 :
     1324      v-obj-list = v-obj-list +  entry (v-i,p-obj-list ) + entry (v-i + 1 , p-obj-list ) + "," .
     1325     end.
     1326     end.
     1327       ASSIGN
     1328       v-exists-operation = NO.
     1329       .
     1330   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1332     (input  p-host-code
     1333     ,output v-base-code
     1334     )  .
     1335       find first buf_currency no-lock where
     1336                 buf_currency.curr-code = v-base-code no-error .
     1337       if available buf_currency then
     1338       assign
     1339       v-base-abbr = buf_currency.curr-abbr
     1340       v-base-name = buf_currency.curr-name
     1341       .
     1342       RUN bgelib-write-cnt( hCNT, "" ).
     1343       assign
     1344           p-last-xml-file-name = p-xml-file-name
     1345       .
     1346       run export-documents in this-procedure (
     1347             input p-obj-list
     1348           , input p-doc-type-list
     1349           , input p-parameter-list
     1350           , input p-xml-file-name
     1351           , input p-log-file-name
     1352           , input p-list-file-name
     1353           , input p-xml-file-number
     1354           , output p-last-xml-file-name
     1355           , output p-last-xml-file-number
     1356       ).
     1357   end.
     1358   procedure export-documents :
     1359   do
     1360   on error undo, return error
     1361   :
     1362     define input parameter p-obj-list               as character    no-undo.
     1363     define input parameter p-doc-type-list          as character    no-undo.
     1364     define input parameter p-parameter-list         as character    no-undo.
     1365     define input parameter p-xml-file-name          as character    no-undo.
     1366     define input parameter p-log-file-name          as character    no-undo.
     1367     define input parameter p-list-file-name         as character    no-undo.
     1368     define input parameter p-xml-file-number        as integer      no-undo.
     1369     define output parameter p-last-xml-file-name    as character    no-undo.
     1370     define output parameter p-last-xml-file-number  as integer      no-undo.
     1371     define variable v-exists-before as logical      no-undo.
     1372     define variable v-exists-after  as logical      no-undo.
     1373     define variable v-need-new-file  as logical     no-undo.
     1374     define variable v-need-disk-spc  as logical     no-undo.
     1375     define variable v-cancel         as logical     no-undo.
     1376     define variable v-prev-filename  as character   no-undo.
     1377     define variable v-void-string    as character   no-undo.
     1378   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1379     define variable v-doc-code      as character    no-undo.
     1380     define variable v-exch-abbr       like ub.currency.curr-abbr no-undo .
     1381     define variable v-exch-name       like ub.currency.curr-name no-undo .
     1382     define variable v-contr-abbr       like ub.currency.curr-abbr no-undo .
     1383     define variable v-contr-name       like ub.currency.curr-name no-undo .
     1384     define variable v-contract-prn-code like ub.contract.contract-prn-code no-undo .
     1385     define variable v-contract-date     like ub.contract.contract-date no-undo .
     1386     define buffer buf_fin-ob-tax-before          for ub.fin-ob-tax-before.
     1387     define buffer buf_fin-ob-tax          for ub.fin-ob-tax.
     1388     define buffer buf_fin-ob              for ub.fin-ob.
     1389     define buffer buf_fin-ob-before       for ub.fin-ob-before.
     1390     define buffer buf_fin-ob-trn          for ub.fin-ob-trn.
     1391     define buffer buf_fin-gds-part        for ub.fin-gds-part.
     1392     define buffer buf_fin-connect         for ub.fin-connect.
     1393     define buffer buf_contract for ub.contract.
     1394     assign
     1395         p-last-xml-file-name    = p-xml-file-name
     1396         p-last-xml-file-number  = p-xml-file-number
     1397     .
     1398     output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1399     export-documents:
     1400     for each buf_fin-ob no-lock where
     1401             buf_fin-ob.host-code = p-host-code
     1402         AND buf_fin-ob.fact-order >= p-fact-order-from
     1403         AND buf_fin-ob.fact-order <= p-fact-order-to
     1404         AND buf_fin-ob.status_ = 'факт':U
     1405     on error undo, return error
     1406     :
     1407       if not v-firm-only then do:
     1408           if lookup (buf_fin-ob.obj-type + string(buf_fin-ob.obj-code) , v-obj-list) = 0 then next.
     1409       end.
     1410       if v-need-new-file = yes
     1411       then do:
     1412           output stream stmxmlout close.
     1413           assign
     1414               v-prev-filename = p-xml-file-name
     1415           .
     1416           run bgelib-filename in this-procedure (
     1417                 input "fin-ob"
     1418               , output p-xml-file-name
     1419               , output v-void-string
     1420               , output v-void-string
     1421           ).
     1422           run bgelib-write-footer in this-procedure (
     1423                 input no
     1424               , input v-prev-filename
     1425               , input p-list-file-name
     1426               , input yes
     1427               , input p-xml-file-name + "xml":U
     1428           ).
     1429           run bgelib-write-log in this-procedure (
     1430               input p-log-file-name
     1431               , input 1
     1432               , input substitute( "Данные выгружены в файл &1"
     1433                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1434                               )
     1435           ).
     1436           assign
     1437               p-last-xml-file-number   = p-xml-file-number + 1
     1438               p-last-xml-file-name     = p-xml-file-name
     1439           .
     1440           run bgelib-write-header in this-procedure (
     1441                 input no
     1442               , input p-last-xml-file-name
     1443               , input p-list-file-name
     1444               , input p-last-xml-file-number
     1445               , input yes
     1446               , input v-prev-filename + "xml":U
     1447               , input p-obj-list
     1448               , input p-doc-type-list
     1449               , input p-parameter-list
     1450           ).
     1451           output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1452           assign
     1453               v-need-new-file = no
     1454           .
     1455       end.
     1456       assign
     1457           v-doc-code = buf_fin-ob.doc-code
     1458       .
     1459       if not v-exists-operation
     1460       then do:
     1461           run bgelib-write-edt in this-procedure ( hEDT, 4, "Операция " + string( p-oper-name ) ).
     1462           run bgelib-write-log in this-procedure ( p-log-file-name, 0, "&Line" ).
     1463           run bgelib-write-log in this-procedure ( p-log-file-name, 1, "XML - Вывод операции " + string( p-oper-name )  ).
     1464           assign
     1465               v-exists-operation = yes
     1466           .
     1467       end.
     1468       assign
     1469       v-doc-code  = buf_fin-ob.doc-code
     1470       v-doc-date  = buf_fin-ob.doc-date
     1471       v-fact-date = buf_fin-ob.fact-date
     1472       v-doc-PS    = buf_fin-ob.ps
     1473       .
     1474       run bgelib-write-cnt ( hcnt, "   " + string( v-doc-code ) + " от " + string( v-fact-date ) ) .
     1475       process events.
     1476   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1477   run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'fin-ob'),  "" ).
     1478   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-ob.doc-code), input 1 ).
     1479   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Status_'),  input string(buf_fin-ob.status_), input 1 ).
     1480   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'host'),  input string(buf_fin-ob.host-code), input 1 ).
     1481   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocCode'),  input string(buf_fin-ob.prn-doc-code), input 1 ).
     1482   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'object'),  input string(buf_fin-ob.obj-type + string(buf_fin-ob.obj-code)), input 1 ).
     1483   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DateDoc'),  input string(buf_fin-ob.doc-date, '99.99.9999'), input 1 ).
     1484   if buf_fin-ob.fact-date <> ? then do:
     1485         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DateFact'),  input string(buf_fin-ob.fact-date, '99.99.9999'), input 1 ).
     1486   end.
     1487   if buf_fin-ob.pay-date <> ? then do:
     1488         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DatePay'),  input string(buf_fin-ob.pay-date, '99.99.9999'), input 1 ).
     1489   end.
     1490   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocDBNum'),  input string(buf_fin-ob.user-db-num-doc), input 1 ).
     1491   if buf_fin-ob.fact-date <> ? then do:
     1492         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'FactDBNum'),  input string(buf_fin-ob.user-db-num-fact), input 1 ).
     1493   end.
     1494   if buf_fin-ob.pay-date <> ? then do:
     1495         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'PayDBNum'),  input string(buf_fin-ob.user-db-num-pay), input 1 ).
     1496   end.
     1497   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocUserName'),  input string(buf_fin-ob.user-name-doc), input 1 ).
     1498   if buf_fin-ob.fact-date <> ? then do:
     1499         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'FactUserName'),  input string(buf_fin-ob.user-name-fact), input 1 ).
     1500   end.
     1501   if buf_fin-ob.pay-date <> ? then do:
     1502         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'PayUserName'),  input string(buf_fin-ob.user-name-pay), input 1 ).
     1503   end.
     1504   find first buf_currency no-lock where
     1505             buf_currency.curr-code = buf_fin-ob.curr-code no-error .
     1506   if available buf_currency then
     1507   assign
     1508   v-exch-abbr = buf_currency.curr-abbr
     1509   v-exch-name = buf_currency.curr-name
     1510   .
     1511   else
     1512   assign
     1513   v-exch-abbr = "":U
     1514   v-exch-name = "":U
     1515   .
     1516   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumDoc'),  input string(buf_fin-ob.sum-doc), input 1 ).
     1517   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcCode'),  input string(buf_fin-ob.curr-code), input 1 ).
     1518   if v-exch-abbr <> "":U then do:
     1519   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcAbbr'),  input string(v-exch-abbr), input 1 ).
     1520   end.
     1521   if v-exch-name <> "":U then do:
     1522   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Crcname'),  input string(v-exch-name), input 1 ).
     1523   end.
     1524   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcRate'),  input string(buf_fin-ob.exch-rate), input 1 ).
     1525   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcScale'),  input string(buf_fin-ob.exch-scale), input 1 ).
     1526   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualCrcRate'),  input string(buf_fin-ob.actual-exch-rate), input 1 ).
     1527   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualCrcScale'),  input string(buf_fin-ob.actual-exch-scale), input 1 ).
     1528   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumRubl'),  input string(buf_fin-ob.sum-rubl), input 1 ).
     1529   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumBase'),  input string(buf_fin-ob.sum-base), input 1 ).
     1530   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcCode'),  input string(v-base-code), input 1 ).
     1531   if v-base-abbr <> "":U then do:
     1532   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcAbbr'),  input string(v-base-abbr), input 1 ).
     1533   end.
     1534   if v-base-name <> "":U then do:
     1535   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcname'),  input string(v-base-name), input 1 ).
     1536   end.
     1537   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcRate'),  input string(buf_fin-ob.base-rate), input 1 ).
     1538   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcScale'),  input string(buf_fin-ob.base-scale), input 1 ).
     1539   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualBaseCrcRate'),  input string(buf_fin-ob.actual-base-rate), input 1 ).
     1540   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualBaseCrcScale'),  input string(buf_fin-ob.actual-base-scale), input 1 ).
     1541   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'conStat'),  input string(buf_fin-ob.con-stat), input 1 ).
     1542   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'conSumBase'),  input string(buf_fin-ob.con-sum-base), input 1 ).
     1543   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'conSumRubl'),  input string(buf_fin-ob.con-sum-rubl), input 1 ).
     1544   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-tax-doc'),  input string(buf_fin-ob.sum-tax-doc), input 1 ).
     1545   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-tax-rubl'),  input string(buf_fin-ob.sum-tax-rubl), input 1 ).
     1546   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-tax-base'),  input string(buf_fin-ob.sum-tax-base), input 1 ).
     1547                  run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'conSumDoc'),  input string(buf_fin-ob.con-sum-doc), input 1 ).
     1548   if buf_fin-ob.contract-code <> 0 then do:
     1549     find first buf_contract no-lock where
     1550               buf_contract.host-code     = buf_fin-ob.host-code and
     1551               buf_contract.contract-code = buf_fin-ob.contract-code no-error .
     1552     if available buf_contract then
     1553     assign
     1554     v-contract-prn-code = buf_contract.contract-prn-code
     1555     v-contract-date     = buf_contract.contract-date
     1556     .
     1557   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCode'),  input string(buf_fin-ob.contract-code), input 1 ).
     1558     if v-contract-prn-code <> "":U then do:
     1559               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractNo'),  input string(v-contract-prn-code), input 1 ).
     1560     end.
     1561     if v-contract-date <> ? then do:
     1562               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractDate'),  input string(v-contract-date, '99.99.9999'), input 1 ).
     1563     end.
     1564     find first buf_currency no-lock where
     1565               buf_currency.curr-code = buf_fin-ob.contract-curr no-error .
     1566     if available buf_currency then
     1567     assign
     1568     v-contr-abbr = buf_currency.curr-abbr
     1569     v-contr-name = buf_currency.curr-name
     1570     .
     1571     else
     1572     assign
     1573     v-contr-abbr = "":U
     1574     v-contr-name = "":U
     1575     .
     1576         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumcontract'),  input string(buf_fin-ob.sum-contr), input 1 ).
     1577         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcCode'),  input string(buf_fin-ob.contract-curr), input 1 ).
     1578     if v-exch-abbr <> "":U then do:
     1579         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcAbbr'),  input string(v-contr-abbr), input 1 ).
     1580     end.
     1581     if v-exch-name <> "":U then do:
     1582         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcname'),  input string(v-contr-name), input 1 ).
     1583     end.
     1584         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcRate'),  input string(buf_fin-ob.contract-rate), input 1 ).
     1585         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcScale'),  input string(buf_fin-ob.contract-scale), input 1 ).
     1586         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualContractCrcRate'),  input string(buf_fin-ob.actual-contract-rate), input 1 ).
     1587         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualContractCrcScale'),  input string(buf_fin-ob.actual-contract-scale), input 1 ).
     1588         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'conSumcontract'),  input string(buf_fin-ob.con-sum-contr), input 1 ).
     1589         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumTaxContract'),  input string(buf_fin-ob.sum-tax-contract), input 1 ).
     1590   end.
     1591   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'payer'),  input string(buf_fin-ob.payer-type + string(buf_fin-ob.payer-code)), input 1 ).
     1592   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'payerName'),  input string(buf_fin-ob.payer-name), input 1 ).
     1593   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'receiver'),  input string(buf_fin-ob.receiver-type + string(buf_fin-ob.receiver-code)), input 1 ).
     1594   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'receiverName'),  input string(buf_fin-ob.receiver-name), input 1 ).
     1595   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'comment'),  input string(buf_fin-ob.PS), input 1 ).
     1596   run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'fin-ob')).
     1597   for each buf_fin-ob-tax no-lock
     1598       where buf_fin-ob-tax.doc-code  = buf_fin-ob.doc-code
     1599       AND   buf_fin-ob-tax.host-code = buf_fin-ob.host-code
     1600   on error undo, return error
     1601   :
     1602         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'taxLine'),  "" ).
     1603         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-ob.doc-code), input 1 ).
     1604         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'taxLineNum'),  input string(buf_fin-ob-tax.line-num), input 1 ).
     1605         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumDoc'),  input string(buf_fin-ob-tax.sum-line-doc), input 1 ).
     1606         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumRubl'),  input string(buf_fin-ob-tax.sum-line-rubl), input 1 ).
     1607         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumBase'),  input string(buf_fin-ob-tax.sum-line-base), input 1 ).
     1608     if buf_fin-ob.contract-code <> 0 then do:
     1609               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumContr'),  input string(buf_fin-ob-tax.sum-line-contr), input 1 ).
     1610     end.
     1611         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumDoc'),  input string(buf_fin-ob-tax.sum-vat-line-doc), input 1 ).
     1612         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumRubl'),  input string(buf_fin-ob-tax.sum-vat-line-rubl), input 1 ).
     1613         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumBase'),  input string(buf_fin-ob-tax.sum-vat-line-base), input 1 ).
     1614     if buf_fin-ob.contract-code <> 0 then do:
     1615               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumContr'),  input string(buf_fin-ob-tax.sum-vat-line-contr), input 1 ).
     1616     end.
     1617         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVat'),  input string(buf_fin-ob-tax.vat-pc), input 1 ).
     1618         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineWithVat'),  input string((if buf_fin-ob-tax.with-vat then "yes" else "no")), input 1 ).
     1619     if buf_fin-ob-tax.SLT-pc <> 0 then do:
     1620               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumDoc'),  input string(buf_fin-ob-tax.sum-SLT-line-doc), input 1 ).
     1621               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumRubl'),  input string(buf_fin-ob-tax.sum-SLT-line-rubl), input 1 ).
     1622               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumBase'),  input string(buf_fin-ob-tax.sum-SLT-line-base), input 1 ).
     1623       if buf_fin-ob.contract-code <> 0 then do:
     1624                     run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumContr'),  input string(buf_fin-ob-tax.sum-SLT-line-contr), input 1 ).
     1625       end.
     1626               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLT'),  input string(buf_fin-ob-tax.SLT-pc), input 1 ).
     1627               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineWithSLT'),  input string((if buf_fin-ob-tax.with-SLT then "yes" else "no")), input 1 ).
     1628     end.
     1629         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'taxLine')).
     1630   end.
     1631   for each buf_fin-ob-trn no-lock
     1632       where buf_fin-ob-trn.doc-code  = buf_fin-ob.doc-code
     1633       AND   buf_fin-ob-trn.host-code = buf_fin-ob.host-code
     1634   on error undo, return error
     1635   :
     1636         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'finObTrn'),  "" ).
     1637         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-ob.doc-code), input 1 ).
     1638         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'TrnDocId'),  input string(buf_fin-ob-trn.trn-doc-code), input 1 ).
     1639     if buf_fin-ob-trn.ps <> "" then do:
     1640               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Comment'),  input string(buf_fin-ob-trn.ps), input 1 ).
     1641     end.
     1642         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'finObTrn')).
     1643   end.
     1644   for each buf_fin-gds-part no-lock
     1645       where buf_fin-gds-part.fin-ob-code  = buf_fin-ob.doc-code
     1646       AND   buf_fin-gds-part.host-code = buf_fin-ob.host-code
     1647   on error undo, return error
     1648   :
     1649         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'finParts'),  "" ).
     1650         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-gds-part.fin-ob-code), input 1 ).
     1651         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'gds-code'),  input string(buf_fin-gds-part.gds-code), input 1 ).
     1652         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'doc-qnty'),  input string(buf_fin-gds-part.doc-qnty), input 1 ).
     1653         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'exch-rate'),  input string(buf_fin-gds-part.exch-rate), input 1 ).
     1654         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'exch-scale'),  input string(buf_fin-gds-part.exch-scale), input 1 ).
     1655         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-rate'),  input string(buf_fin-gds-part.base-rate), input 1 ).
     1656         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-scale'),  input string(buf_fin-gds-part.base-scale), input 1 ).
     1657         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-date'),  input string(buf_fin-gds-part.fact-date, '99.99.9999'), input 1 ).
     1658         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-qnty'),  input string(buf_fin-gds-part.fact-qnty), input 1 ).
     1659         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-time'),  input string(buf_fin-gds-part.fact-time), input 1 ).
     1660         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'part-code'),  input string(buf_fin-gds-part.part-code), input 1 ).
     1661         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'in-code'),  input string(buf_fin-gds-part.in-code), input 1 ).
     1662         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'out-code'),  input string(buf_fin-gds-part.out-code), input 1 ).
     1663         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'object'),  input string(buf_fin-gds-part.obj-type + string(buf_fin-gds-part.obj-code)), input 1 ).
     1664         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'other-base'),  input string(buf_fin-gds-part.other-base), input 1 ).
     1665         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'other-contract'),  input string(buf_fin-gds-part.other-contract), input 1 ).
     1666         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'other-rubl'),  input string(buf_fin-gds-part.other-rubl), input 1 ).
     1667         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'road-tax-base'),  input string(buf_fin-gds-part.road-tax-base), input 1 ).
     1668         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'road-tax-contract'),  input string(buf_fin-gds-part.road-tax-contract), input 1 ).
     1669         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'road-tax-rubl'),  input string(buf_fin-gds-part.road-tax-rubl), input 1 ).
     1670         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'status_dop'),  input string(buf_fin-gds-part.status_dop), input 1 ).
     1671         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base'),  input string(buf_fin-gds-part.sum-base), input 1 ).
     1672         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-contract'),  input string(buf_fin-gds-part.sum-contract), input 1 ).
     1673         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-rubl'),  input string(buf_fin-gds-part.sum-rubl), input 1 ).
     1674         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'transport-base'),  input string(buf_fin-gds-part.transport-base), input 1 ).
     1675         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'transport-contract'),  input string(buf_fin-gds-part.transport-contract), input 1 ).
     1676         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'transport-rubl'),  input string(buf_fin-gds-part.transport-rubl), input 1 ).
     1677         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-db-num'),  input string(buf_fin-gds-part.user-db-num), input 1 ).
     1678         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-name'),  input string(buf_fin-gds-part.user-name), input 1 ).
     1679         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-pc'),  input string(buf_fin-gds-part.vat-pc), input 1 ).
     1680         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-type'),  input string(buf_fin-gds-part.vat-type), input 1 ).
     1681         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-rubl'),  input string(buf_fin-gds-part.vat-rubl), input 1 ).
     1682         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-base'),  input string(buf_fin-gds-part.vat-base), input 1 ).
     1683         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-contract'),  input string(buf_fin-gds-part.vat-contract), input 1 ).
     1684     if buf_fin-gds-part.SLT-pc <> 0 then do:
     1685               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'SLT-pc'),  input string(buf_fin-gds-part.SLT-pc), input 1 ).
     1686               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'SLT-type'),  input string(buf_fin-gds-part.SLT-type), input 1 ).
     1687               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'slt-rubl'),  input string(buf_fin-gds-part.slt-rubl), input 1 ).
     1688               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'slt-base'),  input string(buf_fin-gds-part.slt-base), input 1 ).
     1689               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'slt-contract'),  input string(buf_fin-gds-part.slt-contract), input 1 ).
     1690     end.
     1691         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'finParts')).
     1692   end.
     1693   for each buf_fin-connect no-lock
     1694       where buf_fin-connect.fin-ob-code  = buf_fin-ob.doc-code
     1695       AND   buf_fin-connect.host-code = buf_fin-ob.host-code
     1696   on error undo, return error
     1697   :
     1698         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'finConnect'),  "" ).
     1699         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-connect.fin-ob-code), input 1 ).
     1700         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'PS'),  input string(buf_fin-connect.PS), input 1 ).
     1701         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-rate'),  input string(buf_fin-connect.base-rate), input 1 ).
     1702         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-scale'),  input string(buf_fin-connect.base-scale), input 1 ).
     1703         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'connect-code'),  input string(buf_fin-connect.connect-code), input 1 ).
     1704         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contract-code'),  input string(buf_fin-connect.contract-code), input 1 ).
     1705         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contract-curr'),  input string(buf_fin-connect.contract-curr), input 1 ).
     1706         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contract-rate'),  input string(buf_fin-connect.contract-rate), input 1 ).
     1707         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contract-scale'),  input string(buf_fin-connect.contract-scale), input 1 ).
     1708         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'curr-code'),  input string(buf_fin-connect.curr-code), input 1 ).
     1709         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'exch-rate'),  input string(buf_fin-connect.exch-rate), input 1 ).
     1710         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'exch-scale'),  input string(buf_fin-connect.exch-scale), input 1 ).
     1711         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-date'),  input string(buf_fin-connect.fact-date, '99.99.9999'), input 1 ).
     1712         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-time'),  input string(buf_fin-connect.fact-time), input 1 ).
     1713         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fin-doc-code'),  input string(buf_fin-connect.fin-doc-code), input 1 ).
     1714         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'host'),  input string(buf_fin-connect.host-code), input 1 ).
     1715         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'status_'),  input string(buf_fin-connect.status_), input 1 ).
     1716         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base-ob'),  input string(buf_fin-connect.sum-base-ob), input 1 ).
     1717         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base'),  input string(buf_fin-connect.sum-base), input 1 ).
     1718         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-contr-ob'),  input string(buf_fin-connect.sum-contr-ob), input 1 ).
     1719         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-contr'),  input string(buf_fin-connect.sum-contr), input 1 ).
     1720         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-doc'),  input string(buf_fin-connect.sum-doc), input 1 ).
     1721         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-rubl-ob'),  input string(buf_fin-connect.sum-rubl-ob), input 1 ).
     1722         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-rubl'),  input string(buf_fin-connect.sum-rubl), input 1 ).
     1723         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-db-num'),  input string(buf_fin-connect.user-db-num), input 1 ).
     1724         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-name'),  input string(buf_fin-connect.user-name), input 1 ).
     1725         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'finConnect')).
     1726   end.
     1727       if v-last-file-position = 0
     1728       or seek( stmxmlout ) - v-last-file-position > 1048576
     1729       then do:
     1730         run gbl/chkfree.p (
     1731             input substring( p-xml-file-name, 1, 1 )
     1732             , input 200
     1733             , output v-need-disk-spc
     1734         ) .
     1735         if v-need-disk-spc = yes
     1736         then do:
     1737             run gbl/waitfrsp.w (
     1738                 input substring( p-xml-file-name, 1, 1 )
     1739                 , input 200
     1740                 , output v-cancel
     1741             ) .
     1742             if v-cancel = yes
     1743             then do:
     1744                 undo, return error.
     1745             end.
     1746         end.
     1747         assign
     1748             v-last-file-position = seek( stmxmlout )
     1749         .
     1750       end.
     1751       run bgelib-check-file-size in this-procedure (
     1752             input p-xml-file-name + "tmp"
     1753           , output v-need-new-file
     1754       ).
     1755     end.
     1756     output stream stmxmlout close.
     1757   end.
     1758   end procedure.
