       98   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   procedure cur-time :
      100      define output parameter p-today as date      no-undo .
      101      define output parameter p-time  as integer   no-undo .
      102     do
      103     on error undo, return error
      104     :
      105       define variable v-date1 as date      no-undo .
      106       define variable v-date2 as date      no-undo .
      107       define variable v-time  as integer   no-undo .
      108       assign
      109         v-date1 = today
      110         v-time  = time
      111         v-date2 = today
      112       .
      113       if v-date1 <> v-date2
      114       then do:
      115         assign
      116           v-date1 = today
      117           v-time  = v-time
      118         .
      119       end.
      120       assign
      121         p-today = v-date1
      122         p-time  = v-time
      123       .
      124     end.
      125   end.
      126   function cur-time-date returns character
      127   :
      128     return string(today, '99/99/9999':U) .
      129   end.
      130   function cur-time-mjd returns decimal
      131   :
      132     define variable v-date as date      no-undo .
      133     define variable v-time as integer   no-undo .
      134     run cur-time in this-procedure
      135       (output v-date
      136       ,output v-time
      137       ) .
      138     return integer(v-date) - 2400002 + (v-time / 86400) .
      139   end.
      140   function cur-time-get-ending-index returns integer
      141   (input p-number as integer
      142   )
      143   :
      144     if p-number < 0
      145     or p-number = ?
      146     then do:
      147       return 1 .
      148     end.
      149     define variable v-rest as integer   no-undo .
      150     assign
      151       p-number = p-number modulo 100
      152     .
      153     if p-number < 20
      154     then do:
      155       assign
      156         v-rest = p-number
      157       .
      158     end.
      159     else do:
      160       assign
      161         v-rest = p-number modulo 10
      162       .
      163     end.
      164     case v-rest :
      165       when 1
      166       then do:
      167         return 2 .
      168       end.
      169       when 2 or
      170       when 3 or
      171       when 4
      172       then do:
      173         return 3 .
      174       end.
      175       otherwise do:
      176         return 1 .
      177       end.
      178     end case .
      179   end.
      180   procedure cur-time-mjd-to-date :
      181      define input  parameter i-mjd-diff as decimal no-undo.
      182      define output parameter o-Date     as date    no-undo.
      183      define output parameter o-Time     as integer no-undo.
      184      define variable v-day-number as integer   no-undo .
      185      if    i-mjd-diff < 0
      186         or i-mjd-diff = ?
      187      then do:
      188         return "?" .
      189      end.
      190      assign
      191         v-day-number = truncate(i-mjd-diff,0).
      192         o-Date = date(v-day-number + 2400002).
      193         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      194     .
      195   end.
      196   function cur-time-mjd-to-string returns character
      197   (input p-mjd-diff as decimal
      198   )
      199   :
      200     define variable v-day-number as integer   no-undo .
      201     define variable v-seconds    as integer   no-undo .
      202     define variable v-hour       as integer   no-undo .
      203     define variable v-min        as integer   no-undo .
      204     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      205     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      206     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      207     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      208     if p-mjd-diff < 0
      209     or p-mjd-diff = ?
      210     then do:
      211       return "?" .
      212     end.
      213     assign
      214       v-day-number = integer(truncate(p-mjd-diff,0))
      215       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      216     .
      217     if v-seconds > 86400
      218     then do:
      219       assign
      220         v-seconds = 86400 - 1
      221       .
      222     end.
      223     if v-seconds < 0
      224     then do:
      225       assign
      226         v-seconds = 0
      227       .
      228     end.
      229     assign
      230       v-hour = truncate(v-seconds / 3600, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 3600
      234     .
      235     assign
      236       v-min = truncate(v-seconds / 60, 0)
      237     .
      238     assign
      239       v-seconds = v-seconds modulo 60
      240     .
      241     return
      242         (if v-day-number <> 0
      243           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      244           else ""
      245         )
      246       + (if v-day-number <> 0 or v-hour <> 0
      247           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      248           else ""
      249         )
      250       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      251           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      252           else ""
      253         )
      254       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      255       .
      256   end.
      257   function cur-time-string returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      266   end.
      267   function cur-time-string-sec returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      276   end.
      277   function cur-time-custom  returns character
      278   (input p-prefix as character
      279   ,input p-date-format as character
      280   ,input p-delimiter as character
      281   ,input p-time-format as character
      282   ,input p-suffix as character
      283   )
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return
      292       p-prefix
      293       + string(v-date, p-date-format)
      294       + p-delimiter
      295       + string(v-time, p-time-format)
      296       + p-suffix
      297       .
      298   end.
      299   function cur-time-print  returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      308   end.
      309   function cur-time-datetime returns datetime
      310   :
      311     define variable v-char as character no-undo .
      312     define variable v-datetime as datetime no-undo .
      313     v-char = cur-time-string().
      314     v-datetime = datetime(v-char).
      315     return  v-datetime.
      316   end.
      317   function cur-time-string-msec returns character
      318   :
      319     define variable v-date as datetime  no-undo .
      320     v-date = now.
      321     return string(v-date) .
      322   end.
      323   define variable vss-include-info2 as character format "X(65)" no-undo
      324   initial "@(#)$Workfile$ $Revision$".
      325   procedure xmlchar-test :
      326   define input parameter p-in-string          as character        no-undo.
      327   define output parameter p-out-string-enc    as character        no-undo.
      328   define output parameter p-out-string-dec    as character        no-undo.
      329   do
      330   on error undo, return error
      331   :
      332          run xmlchar-encode in this-procedure
      333       (
      334             input p-in-string
      335           , output p-out-string-enc
      336       ).
      337          run xmlchar-decode in this-procedure
      338       (
      339             input p-out-string-enc
      340           , output p-out-string-dec
      341       ).
      342   end.
      343   end .
      344   procedure xmlchar-encode :
      345   define input parameter p-in-string      as character        no-undo.
      346   define output parameter p-out-string    as character        no-undo.
      347       define variable v-position      as integer      no-undo.
      348       define variable v-current-char  as character    no-undo.
      349   do
      350   on error undo, return error
      351   :
      352       assign
      353           p-out-string = "":U
      354       .
      355       case p-in-string
      356       :
      357           when ?
      358           then do:
      359               assign
      360                   p-out-string = "?":U
      361               .
      362           end.
      363           when "?":U
      364           then do:
      365               assign
      366                   p-out-string = "&#63;":U
      367               .
      368           end.
      369           otherwise do:
      370               do v-position = 1 to length( p-in-string )
      371               :
      372                   assign
      373                       v-current-char = substring( p-in-string, v-position, 1 )
      374                   .
      375                   case v-current-char
      376                   :
      377                       when "&":U
      378                       then do:
      379                           assign
      380                               p-out-string = p-out-string + "&amp;":U
      381                           .
      382                       end.
      383                       when ">":U
      384                       then do:
      385                           assign
      386                               p-out-string = p-out-string + "&gt;":U
      387                           .
      388                       end.
      389                       when "<":U
      390                       then do:
      391                           assign
      392                               p-out-string = p-out-string + "&lt;":U
      393                           .
      394                       end.
      395                       when "'":U
      396                       then do:
      397                           assign
      398                               p-out-string = p-out-string + "&apos;":U
      399                           .
      400                       end.
      401                       when '"':U
      402                       then do:
      403                           assign
      404                               p-out-string = p-out-string + "&quot;":U
      405                           .
      406                       end.
      407                       when chr(1)
      408                       then do:
      409                           assign
      410                               p-out-string = p-out-string + "":U
      411                           .
      412                       end.
      413                       when chr(2)
      414                       then do:
      415                           assign
      416                               p-out-string = p-out-string + "":U
      417                           .
      418                       end.
      419                       when chr(3)
      420                       then do:
      421                           assign
      422                               p-out-string = p-out-string + "":U
      423                           .
      424                       end.
      425                       when chr(4)
      426                       then do:
      427                           assign
      428                               p-out-string = p-out-string + "":U
      429                           .
      430                       end.
      431                       when chr(5)
      432                       then do:
      433                           assign
      434                               p-out-string = p-out-string + "":U
      435                           .
      436                       end.
      437                       when chr(6)
      438                       then do:
      439                           assign
      440                               p-out-string = p-out-string + "":U
      441                           .
      442                       end.
      443                       when chr(7)
      444                       then do:
      445                           assign
      446                               p-out-string = p-out-string + "":U
      447                           .
      448                       end.
      449                       when chr(8)
      450                       then do:
      451                           assign
      452                               p-out-string = p-out-string + "":U
      453                           .
      454                       end.
      455                       when chr(9)
      456                       then do:
      457                           assign
      458                               p-out-string = p-out-string + "":U
      459                           .
      460                       end.
      461                       when chr(29)
      462                       then do:
      463                           assign
      464                               p-out-string = p-out-string + "":U
      465                           .
      466                       end.
      467                       when chr(10)
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "&#10;":U
      471                           .
      472                       end.
      473                       when chr(13)
      474                       then do:
      475                           assign
      476                               p-out-string = p-out-string + "&#13;":U
      477                           .
      478                       end.
      479                       otherwise do:
      480                           assign
      481                               p-out-string = p-out-string + v-current-char
      482                           .
      483                       end.
      484                   end case.
      485               end.
      486           end.
      487       end case.
      488   end.
      489   end .
      490   procedure xmlchar-encode-1c :
