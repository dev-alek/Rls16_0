      294               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineVatSumContr', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.sum-vat-line-contr))) + v-suffix ) .
      295     end.
      296         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineVat', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.vat-pc))) + v-suffix ) .
      297         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineWithVat', xml-doc_ReplaceSpecSymbols(string((if buf_fin-ob-tax-before.with-vat then "yes" else "no")))) + v-suffix ) .
      298     if buf_fin-ob-tax-before.SLT-pc <> 0 then do:
      299               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSLTSumDoc', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.sum-SLT-line-doc))) + v-suffix ) .
      300               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSLTSumRubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.sum-SLT-line-rubl))) + v-suffix ) .
      301               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSLTSumBase', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.sum-SLT-line-base))) + v-suffix ) .
      302       if buf_fin-ob-before.contract-code <> 0 then do:
      303                     run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSLTSumContr', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.sum-SLT-line-contr))) + v-suffix ) .
      304       end.
      305               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineSLT', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-tax-before.SLT-pc))) + v-suffix ) .
      306               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'lineWithSLT', xml-doc_ReplaceSpecSymbols(string((if buf_fin-ob-tax-before.with-SLT then "yes" else "no")))) + v-suffix ) .
      307     end.
      308         run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'taxLineBefore') + chr(10))).
      309   end.
      310   for each buf_fin-ob-trn no-lock
      311       where buf_fin-ob-trn.doc-code  = buf_fin-ob-before.before-code
      312       AND   buf_fin-ob-trn.host-code = buf_fin-ob-before.host-code
      313   on error undo, return error
      314   :
      315         run write-string in this-procedure  (input (substitute("&1<&2>", fill( chr(32), 2 * (0 + 1) ), 'finObTrn') + chr(10)) ) .
      316         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'DocID', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-before.before-code))) + v-suffix ) .
      317         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'TrnDocId', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-trn.trn-doc-code))) + v-suffix ) .
      318     if buf_fin-ob-trn.ps <> "" then do:
      319               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'Comment', xml-doc_ReplaceSpecSymbols(string(buf_fin-ob-trn.ps))) + v-suffix ) .
      320     end.
      321         run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'finObTrn') + chr(10))).
      322   end.
      323   for each buf_fin-gds-part no-lock
      324       where buf_fin-gds-part.fin-ob-code  = buf_fin-ob-before.before-code
      325       AND   buf_fin-gds-part.host-code = buf_fin-ob-before.host-code
      326   on error undo, return error
      327   :
      328         run write-string in this-procedure  (input (substitute("&1<&2>", fill( chr(32), 2 * (0 + 1) ), 'finParts') + chr(10)) ) .
      329         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'DocID', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.fin-ob-code))) + v-suffix ) .
      330         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'gds-code', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.gds-code))) + v-suffix ) .
      331         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'doc-qnty', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.doc-qnty))) + v-suffix ) .
      332         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'exch-rate', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.exch-rate))) + v-suffix ) .
      333         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'exch-scale', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.exch-scale))) + v-suffix ) .
      334         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'base-rate', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.base-rate))) + v-suffix ) .
      335         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'base-scale', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.base-scale))) + v-suffix ) .
      336         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fact-date', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.fact-date, '99.99.9999':U))) + v-suffix ) .
      337     run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fact-date', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.fact-date))) + v-suffix ) .
      338         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fact-qnty', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.fact-qnty))) + v-suffix ) .
      339         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'fact-time', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.fact-time))) + v-suffix ) .
      340         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'part-code', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.part-code))) + v-suffix ) .
      341         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'in-code', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.in-code))) + v-suffix ) .
      342         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'out-code', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.out-code))) + v-suffix ) .
      343         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'object', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.obj-type + string(buf_fin-gds-part.obj-code)))) + v-suffix ) .
      344         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'other-base', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.other-base))) + v-suffix ) .
      345         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'other-contract', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.other-contract))) + v-suffix ) .
      346         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'other-rubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.other-rubl))) + v-suffix ) .
      347         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'road-tax-base', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.road-tax-base))) + v-suffix ) .
      348         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'road-tax-contract', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.road-tax-contract))) + v-suffix ) .
      349         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'road-tax-rubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.road-tax-rubl))) + v-suffix ) .
      350         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'status_dop', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.status_dop))) + v-suffix ) .
      351         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'sum-base', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.sum-base))) + v-suffix ) .
      352         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'sum-contract', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.sum-contract))) + v-suffix ) .
      353         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'sum-rubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.sum-rubl))) + v-suffix ) .
      354         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'transport-base', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.transport-base))) + v-suffix ) .
