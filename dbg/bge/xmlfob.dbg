      356         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'transport-rubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.transport-rubl))) + v-suffix ) .
      357         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'user-db-num', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.user-db-num))) + v-suffix ) .
      358         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'user-name', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.user-name))) + v-suffix ) .
      359         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'vat-pc', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.vat-pc))) + v-suffix ) .
      360         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'vat-type', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.vat-type))) + v-suffix ) .
      361         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'vat-rubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.vat-rubl))) + v-suffix ) .
      362         run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'vat-base', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.vat-base))) + v-suffix ) .
