       90   function xml-doc_replacespecsymbols returns char (input sinput as char).
       91     assign
       92       sinput = replace(sinput, '&', "&#038;")
       93       sinput = replace(sinput, '"', "&#034;")
       94       sinput = replace(sinput, '<', "&#060;")
       95       sinput = replace(sinput, '>', "&#062;")
       96       sinput = replace(sinput, chr(10), "&#010;")
       97     .
       98     return sinput.
       99   end function.
