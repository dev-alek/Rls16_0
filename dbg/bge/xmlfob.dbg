      364     if buf_fin-gds-part.SLT-pc <> 0 then do:
      365               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'SLT-pc', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.SLT-pc))) + v-suffix ) .
      366               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'SLT-type', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.SLT-type))) + v-suffix ) .
      367               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'slt-rubl', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.slt-rubl))) + v-suffix ) .
      368               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'slt-base', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.slt-base))) + v-suffix ) .
      369               run write-string in this-procedure  (input v-prefix + substitute('<&1>&2</&1>', 'slt-contract', xml-doc_ReplaceSpecSymbols(string(buf_fin-gds-part.slt-contract))) + v-suffix ) .
      370     end.
      371         run write-string in this-procedure (input (substitute("&1</&2>", fill( chr(32), 2 * (0 + 1) ), 'finParts') + chr(10))).
      372   end.
      373   if paroutput-file = ?  or
      374      paroutput-file = "" then do:
      375      run write-string in this-procedure
      376        (input '</root>':u + chr(10)).
      377   end.
      378   else do:
      379     if p-last-document then do:
      380       run write-string in this-procedure
      381         (input '</root>':u + chr(10)).
      382     end.
      383   end.
      384   output stream fin-out close.
      385   if paroutput-file = ?  or
      386      paroutput-file = "" then do:
      387     if search ("./" + "fb":U + string(p-doc-code) + ".xml") <> ? then do:
      388        os-delete value ("./" + "fb":U + string(p-doc-code) + ".xml").
      389     end.
      390     os-copy value ("./" + "fb":U + string(p-doc-code) + ".tmp") value ("./" + "fb":U + string(p-doc-code) + ".xml").
      391     os-delete value ("./" + "fb":U +  string(p-doc-code) + ".tmp").
      392     run gbl/filename.p
      393     (
      394                     input "./" + "fb":U + string(p-doc-code) + ".xml"
      395                     ,output paroutput-file
      396                     ,output v-path
      397                     ,output v-file-name
      398                     ,output v-file-name-no-ext
      399                     ,output v-file-name-ext
      400                     ) no-error .
      401   end.
      402   procedure write-string :
      403    define input parameter parstring as character no-undo.
      404    put stream fin-out unformatted parstring.
      405   end.
