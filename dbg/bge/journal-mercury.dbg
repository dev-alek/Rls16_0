     1470             ,input  v-diasize-proc-name
     1471             ,input  'width':u
     1472             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1473             ) .
     1474         end.
     1475       end.
     1476     end.
     1477     assign
     1478       v-diasize-change-size = false
     1479     .
     1480   end procedure.
     1481   procedure diasize_set-width :
     1482     define input  parameter p-new-width  as decimal   no-undo .
     1483     define input  parameter p-move-resize as logical   no-undo .
     1484     do
     1485     on error undo, return error return-value
     1486     :
     1487       run diasize_change-width in this-procedure
     1488         (input  (p-new-width - frame Dialog-Frame :width)
     1489         ,input  p-move-resize
     1490         ) .
     1491     end.
     1492   end procedure.
     1493   procedure diasize_position-resize-button :
     1494     do with frame Dialog-Frame
     1495     :
     1496       hide v-diasize-resize-button .
     1497       assign
     1498         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1499                     - 1
     1500                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1501         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1502                     - 1
     1503                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1504       .
     1505       view v-diasize-resize-button .
     1506     end.
     1507   end procedure.
     1508   on alt-right anywhere
     1509   do:
     1510     run diasize_change-width in this-procedure
     1511       (input 1
     1512       ,input true
     1513       ) .
     1514     return no-apply .
     1515   end.
     1516   on alt-left anywhere
     1517   do:
     1518     run diasize_change-width in this-procedure
     1519       (input -1
     1520       ,input true
     1521       ) .
     1522     return no-apply .
     1523   end.
     1524   on alt-down anywhere
     1525   do:
     1526     run diasize_change-height in this-procedure
     1527       (input 1
     1528       ,input true
     1529       ) .
     1530     return no-apply .
     1531   end.
     1532   on alt-up anywhere
     1533   do:
     1534     run diasize_change-height in this-procedure
     1535       (input -1
     1536       ,input true
     1537       ) .
     1538     return no-apply .
     1539   end.
     1540   on alt-enter of frame Dialog-Frame
     1541   do:
     1542     run diasize_maximize in this-procedure
     1543       (input  ?
     1544       ).
     1545     return no-apply .
     1546   end.
     1547   procedure diasize_end-move :
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551       define variable v-row-delta as decimal   no-undo .
     1552       define variable v-col-delta as decimal   no-undo .
     1553       define variable v-new-row as decimal   no-undo .
     1554       define variable v-new-col as decimal   no-undo .
     1555       assign
     1556         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1557         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1558       .
     1559       assign
     1560         v-row-delta = v-new-row - frame Dialog-Frame :height
     1561         v-col-delta = v-new-col - frame Dialog-Frame :width
     1562       .
     1563       run diasize_change-height in this-procedure
     1564         (input v-row-delta
     1565         ,input true
     1566         ) .
     1567       run diasize_change-width in this-procedure
     1568         (input v-col-delta
     1569         ,input true
     1570         ) .
     1571     end.
     1572   end procedure.
     1573   procedure diasize_maximize :
     1574     define input  parameter p-action as logical   no-undo .
     1575     do
     1576     on error undo, return error return-value
     1577     :
     1578       if p-action = ?
     1579       then do:
     1580         if v-diasize-need-maximize = true
     1581         then do:
     1582           assign
     1583             p-action = true
     1584           .
     1585         end.
     1586         else do:
     1587           assign
     1588             p-action = false
     1589           .
     1590         end.
     1591       end.
     1592       if p-action = true
     1593       then do:
     1594         run diasize_change-height in this-procedure
     1595           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1596               - frame Dialog-Frame :height-chars
     1597           ,input true
     1598           ) .
     1599         run diasize_change-width in this-procedure
     1600           (input session :width-chars
     1601               - frame Dialog-Frame :width-chars
     1602           ,input true
     1603           ) .
     1604         assign
     1605           v-diasize-need-maximize = false
     1606         .
     1607       end.
     1608       else do:
     1609         run diasize_change-width in this-procedure
     1610           (input v-diasize-orig-frame-width
     1611               - frame Dialog-Frame :width-chars
     1612           ,input true
     1613           ) .
     1614         run diasize_change-height in this-procedure
     1615           (input v-diasize-orig-frame-height
     1616               - frame Dialog-Frame :height-chars
     1617           ,input true
     1618           ) .
     1619         assign
     1620           v-diasize-need-maximize = true
     1621         .
     1622       end.
     1623     end.
     1624   end procedure.
     1625   procedure diasize_restore-orig-size :
     1626     do
     1627     on error undo, return error return-value
     1628     :
     1629       assign
     1630         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1631         v-diasize-current-frame-height = frame Dialog-Frame :height
     1632       .
     1633       run diasize_set-height in this-procedure
     1634         (input  v-diasize-orig-frame-height
     1635         ,input  true
     1636         ) .
     1637       run diasize_set-width in this-procedure
     1638         (input  v-diasize-orig-frame-width
     1639         ,input  true
     1640         ) .
     1641     end.
     1642   end procedure.
     1643   procedure diasize_restore-current-size :
     1644     do
     1645     on error undo, return error return-value
     1646     :
     1647       run diasize_set-height in this-procedure
     1648         (input  v-diasize-current-frame-height
     1649         ,input  true
     1650         ) .
     1651       run diasize_set-width in this-procedure
     1652         (input  v-diasize-current-frame-width
     1653         ,input  true
     1654         ) .
     1655     end.
     1656   end procedure.
     1657   procedure diasize_set-browse-handle :
     1658     define input  parameter p-browse-handle as handle   no-undo .
     1659     define buffer buf_temp-browse-handle for temp-browse-handle .
     1660     do
     1661     on error undo, return error return-value
     1662     :
     1663       assign
     1664         v-diasize-browse-handle = p-browse-handle
     1665       .
     1666       for each buf_temp-browse-handle
     1667       on error undo, return error return-value
     1668       :
     1669         delete buf_temp-browse-handle .
     1670       end.
     1671     end.
     1672   end procedure.
     1673   procedure diasize_add_browse :
     1674     define input  parameter p-browse-type   as character no-undo .
     1675     define input  parameter p-browse-handle as handle    no-undo .
     1676     define buffer buf_temp-browse-handle for temp-browse-handle .
     1677     do
     1678     on error undo, return error return-value
     1679     :
     1680       assign
     1681         v-diasize-browse-number = v-diasize-browse-number + 1
     1682       .
     1683       create buf_temp-browse-handle .
     1684       assign
     1685         buf_temp-browse-handle.browse-type   = p-browse-type
     1686         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1687         buf_temp-browse-handle.browse-handle = p-browse-handle
     1688       .
     1689     end.
     1690   end procedure.
     1691   procedure diasize_init :
     1692     define variable v-default-value    as logical   no-undo .
     1693     define variable v-restore-saved    as logical   no-undo .
     1694     define variable v-resize-value-str as character no-undo .
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698       do with frame Dialog-Frame
     1699       :
     1700         assign
     1701           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1702           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1703           v-diasize-browse-handle     = browse BROWSE-Journal-mercury :handle
     1704         .
     1705         create button v-diasize-resize-button
     1706         assign
     1707           parent        = frame Dialog-Frame :first-child
     1708           label         = "s"
     1709           height-pixels = 16
     1710           width-pixels  = 16
     1711           visible       = true
     1712           sensitive     = true
     1713           movable       = true
     1714           triggers:
     1715             on end-move persistent run diasize_end-move in this-procedure .
     1716           end triggers.
     1717         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1718         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1719         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1720         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1721         assign
     1722           v-diasize-wndmax = false
     1723         .
     1724         if connected("ub") = true
     1725         then do:
     1726           define variable v-cntxt-db-num        as integer   no-undo .
     1727           define variable v-cntxt-userid        as character no-undo .
     1728           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1729                                             , OUTPUT v-cntxt-userid
     1730                                             ) .
     1731           run gbl/wndpar_r.p
     1732             (input  v-cntxt-db-num
     1733             ,input  v-cntxt-userid
     1734             ,input  'wndmax':U
     1735             ,output v-diasize-wndmax
     1736             ,output v-default-value
     1737             ) .
     1738         end.
     1739         assign
     1740           v-diasize-wndstore = false
     1741         .
     1742         if connected("ub") = true
     1743         then do:
     1744           run gbl/wndpar_r.p
     1745             (input  v-cntxt-db-num
     1746             ,input  v-cntxt-userid
     1747             ,input  'wndstore':U
     1748             ,output v-diasize-wndstore
     1749             ,output v-default-value
     1750             ) .
     1751         end.
     1752         assign
     1753           v-diasize-proc-name = entry(1, program-name(2), '.')
     1754         .
     1755         if v-diasize-wndstore = true
     1756         then do:
     1757           assign
     1758             v-restore-saved = false
     1759           .
     1760           if connected("ub") = true
     1761           then do:
     1762             run gbl/wndsizer.p
     1763               (input  v-cntxt-db-num
     1764               ,input  v-cntxt-userid
     1765               ,input  v-diasize-proc-name
     1766               ,input  'height':u
     1767               ,output v-resize-value-str
     1768               ) .
     1769             if v-resize-value-str <> '':U
     1770             then do:
     1771               run diasize_change-height in this-procedure
     1772                 (input  integer(v-resize-value-str)
     1773                 ,input  true
     1774                 ) .
     1775               assign
     1776                 v-restore-saved = true
     1777               .
     1778             end.
     1779           end.
     1780           if connected("ub") = true
     1781           then do:
     1782             run gbl/wndsizer.p
     1783               (input  v-cntxt-db-num
     1784               ,input  v-cntxt-userid
     1785               ,input  v-diasize-proc-name
     1786               ,input  'width':u
     1787               ,output v-resize-value-str
     1788               ) .
     1789             if v-resize-value-str <> '':U
     1790             then do:
     1791               run diasize_change-width in this-procedure
     1792                 (input  integer(v-resize-value-str)
     1793                 ,input  true
     1794                 ) .
     1795               assign
     1796                 v-restore-saved = true
     1797               .
     1798             end.
     1799           end.
     1800           if v-restore-saved <> true
     1801           then do:
     1802             if v-diasize-wndmax = true
     1803             then do:
     1804               run diasize_maximize in this-procedure
     1805                 (input  true
     1806                 ) .
     1807             end.
     1808           end.
     1809         end.
     1810         else do:
     1811           if v-diasize-wndmax = true
     1812           then do:
     1813             run diasize_maximize in this-procedure
     1814               (input  true
     1815               ) .
     1816           end.
     1817         end.
     1818       end.
     1819     end.
     1820   end procedure.
     1821   procedure diasize_need-full-display :
     1822     define output parameter p-need-full-display as logical   no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       assign
     1827         p-need-full-display = v-diasize-need-full-display
     1828       .
     1829       assign
     1830         v-diasize-need-full-display = false
     1831       .
     1832     end.
     1833   end procedure.
     1834   procedure get-context :
     1835      define output parameter p-db-num as integer          no-undo.
     1836      define output parameter p-user-id as character        no-undo.
     1837      define variable v-login               as character    no-undo.
     1838      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1839      define buffer buf_user-login  for ub.user-login .
     1840      do
     1841      on error undo, return error
     1842      :
     1843            FIND FIRST buf_sys-ctrl no-lock.
     1844            ASSIGN
     1845               v-login = USERID("ub")
     1846               p-db-num = buf_sys-ctrl.db-num
     1847            .
     1848            FIND FIRST buf_user-login
     1849                 WHERE buf_user-login.db-num = p-db-num
     1850                   AND buf_user-login.user-login = v-login
     1851                 no-lock
     1852                 no-error
     1853                 .
     1854            IF AVAILABLE buf_user-login
     1855            THEN DO:
     1856               assign
     1857                  p-user-id = buf_user-login.user-id
     1858               .
     1859            END.
     1860      end.
     1861   end procedure.
     1862     run diasize_init in this-procedure .
     1863     find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('10':U) no-error.
     1864     if not available buf_ext-system
     1865     then do :
     1866       message "Нет внешней системы с типом Меркурий." view-as alert-box .
     1867       return .
     1868     end.
     1869     assign
     1870       v-date-end = today
     1871       v-date-start = today
     1872     .
     1873     date1 = datetime(v-date-start, 0) .
     1874     date2 = datetime(v-date-end, 86399999) .
     1875     SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
     1876     journal = new Journal().
     1877     bh-journal-mercury = journal:GetHndlTable(input date1, input date2).
     1878     create query gh-journal-mercury.
     1879     gh-journal-mercury:SET-BUFFERS (bh-journal-mercury ).
     1880     BROWSE-Journal-mercury:QUERY = gh-journal-mercury.
     1881     do ii = 1 to bh-journal-mercury:num-fields - 1:
     1882        bcol = browse-journal-mercury:add-like-column('tt_journal-merc' + '.' + bh-journal-mercury:buffer-field (ii):name, 0, 'FILL-IN').
     1883     end.
     1884             bcol1 = browse-journal-mercury:get-browse-column(1).
     1885             bcol2 = browse-journal-mercury:get-browse-column(2).
     1886             bcol3 = browse-journal-mercury:get-browse-column(3).
     1887             bcol4 = browse-journal-mercury:get-browse-column(4).
     1888             bcol5 = browse-journal-mercury:get-browse-column(5).
     1889     on row-display of browse-journal-mercury IN FRAME Dialog-Frame
     1890     DO:
     1891       if bh-journal-mercury:buffer-field ("jou-status"):buffer-value  = "Запрос отправлен" then do:
     1892           bcol1:bgcolor = YELLOW_COLOR.
     1893           bcol2:bgcolor = YELLOW_COLOR.
     1894           bcol3:bgcolor = YELLOW_COLOR.
     1895           bcol4:bgcolor = YELLOW_COLOR.
     1896           bcol:bgcolor  = YELLOW_COLOR .
     1897           bcol5:bgcolor = YELLOW_COLOR .
     1898       end.
     1899       if bh-journal-mercury:buffer-field ("jou-status"):buffer-value  = "Запрос отклонён" then do:
     1900           bcol1:bgcolor = RED_COLOR.
     1901           bcol2:bgcolor = RED_COLOR.
     1902           bcol3:bgcolor = RED_COLOR.
     1903           bcol4:bgcolor = RED_COLOR.
     1904           bcol:bgcolor  = RED_COLOR .
     1905           bcol5:bgcolor = RED_COLOR .
     1906       end.
     1907     end.
     1908     RUN enable_UI.
     1909     run openBr .
     1910     WAIT-FOR GO OF FRAME Dialog-Frame.
     1911   END.
     1912   RUN disable_UI.
     1913   PROCEDURE disable_UI :
     1914     HIDE FRAME Dialog-Frame.
     1915   END PROCEDURE.
     1916   PROCEDURE enable_UI :
     1917     DISPLAY RADIO-SET-1 v-date-end v-date-start
     1918         WITH FRAME Dialog-Frame.
     1919     ENABLE Btn_Cancel Btn_del RADIO-SET-1 b-request b-response btRef v-date-end v-date-start
     1920         WITH FRAME Dialog-Frame.
     1921     VIEW FRAME Dialog-Frame.
     1922     ENABLE BROWSE-journal-mercury
     1923         WITH FRAME Dialog-Frame.
     1924     VIEW FRAME Dialog-Frame.
     1925   END PROCEDURE.
     1926   procedure openBr :
     1927     case RADIO-SET-1 :
     1928       when 1  then do:
     1929             gh-journal-mercury:SET-BUFFERS (bh-journal-mercury).
     1930             gh-journal-mercury:query-prepare ("for each tt_journal-merc by tt_journal-merc.jou-time desc").
     1931             gh-journal-mercury:QUERY-OPEN.
     1932       end.
     1933       when 2  then do:
     1934             gh-journal-mercury:SET-BUFFERS (bh-journal-mercury).
     1935             gh-journal-mercury:query-prepare ("for each tt_journal-merc where tt_journal-merc.jou-status = 'Запрос отправлен'  by tt_journal-merc.jou-time desc").
     1936             gh-journal-mercury:QUERY-OPEN.
     1937       end.
     1938       when 3 then do:
     1939             gh-journal-mercury:SET-BUFFERS (bh-journal-mercury).
     1940             gh-journal-mercury:query-prepare ("for each tt_journal-merc where tt_journal-merc.jou-status = 'Ответ получен'  by tt_journal-merc.jou-time desc").
     1941             gh-journal-mercury:QUERY-OPEN.
     1942       end.
     1943     end.
     1944   end procedure .
