     1094   procedure diasize_set-height :
     1095     define input  parameter p-new-height  as decimal   no-undo .
     1096     define input  parameter p-move-resize as logical   no-undo .
     1097     do
     1098     on error undo, return error return-value
     1099     :
     1100       run diasize_change-height in this-procedure
     1101         (input  (p-new-height - frame Dialog-Frame :height)
     1102         ,input  p-move-resize
     1103         ) .
     1104     end.
     1105   end procedure.
     1106   procedure diasize_change-width :
     1107     define input  parameter p-change-value as decimal   no-undo .
     1108     define input  parameter p-move-resize  as logical   no-undo .
