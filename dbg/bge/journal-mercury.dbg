     1118     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1119     if p-change-value > 0
     1120     then do:
     1121       if frame Dialog-Frame :width + p-change-value >
     1122           session :width-chars
     1123       then do:
     1124         assign
     1125           p-change-value = session :width-chars - frame Dialog-Frame :width
     1126         .
     1127         if p-change-value <= 0
     1128         then do:
     1129           run diasize_position-resize-button in this-procedure .
     1130           return .
     1131         end.
     1132       end.
     1133     end.
     1134     if p-change-value < 0
     1135     then do:
     1136       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1137       then do:
     1138         assign
     1139           p-change-value = v-diasize-orig-frame-width
     1140                          - frame Dialog-Frame :width
     1141         .
     1142         if p-change-value >= 0
     1143         then do:
     1144           run diasize_position-resize-button in this-procedure .
     1145           return .
     1146         end.
     1147       end.
     1148     end.
