       44   define buffer buf_ext-classif       for ub.ext-classif .
       45   define buffer buf2_ext-classif      for ub.ext-classif .
       46   define buffer buf_ext-system        for ub.ext-system .
       47   define buffer buf_parts             for ub.parts .
