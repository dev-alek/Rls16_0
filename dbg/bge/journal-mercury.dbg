       63   procedure vss-get-info :
       64     define output parameter p-vss-revision    like vss-revision    no-undo .
       65     define output parameter p-vss-author      like vss-author      no-undo .
       66     define output parameter p-vss-date        like vss-date        no-undo .
       67     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       68     define output parameter p-vss-archive     like vss-archive     no-undo .
       69     define output parameter p-vss-description like vss-description no-undo .
       70     assign
       71       p-vss-revision    = vss-revision
       72       p-vss-author      = vss-author
       73       p-vss-date        = vss-date
       74       p-vss-workfile    = vss-workfile
       75       p-vss-archive     = vss-archive
       76       p-vss-description = vss-description
       77     .
       78   end procedure.
       79   procedure vss-get-parameters :
       80     define output parameter p-vss-parameters as character no-undo .
       81   end procedure.
       82   define new global shared variable g#vssrevis-logger as handle    no-undo .
       83   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       84   define variable v-vssrevis-logger                   as handle    no-undo .
       85   procedure vss-logevent :
       86     define input  parameter p-extra-paramters as character no-undo .
       87     define variable v-vssrevis-parameters as character no-undo .
       88     do
       89     on error undo, return error return-value
       90     :
       91       if  valid-handle(v-vssrevis-logger)
       92       and v-vssrevis-logger :get-signature("logevent") <> ""
       93       then do:
       94         run vss-get-parameters in this-procedure
       95           (output v-vssrevis-parameters
       96           ).
       97         run logevent in v-vssrevis-logger
       98           (input vss-workfile
       99           ,input vss-revision
      100           ,input v-vssrevis-parameters
      101           ,input p-extra-paramters
      102           ).
      103       end.
      104     end.
      105   end procedure.
      106   assign
      107     v-vssrevis-logger = g#vssrevis-logger
      108   .
      109   if  valid-handle(v-vssrevis-logger)
      110   and v-vssrevis-logger :get-signature("logevent") <> ""
      111   then do:
      112     assign
      113       v-vssrevis-logevent = true
      114     .
      115     run vss-logevent in this-procedure (input vss-description) .
      116   end.
      117   define new global shared variable g#language as character no-undo .
      118   if g#language <> '' and g#language <> 'rus':U then do:
      119     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      120   end.
      121   define new global shared variable g#library  as handle no-undo .
      122   define new global shared variable g#library2 as handle no-undo .
      123   define new global shared variable g#lib-trn  as handle no-undo .
      124   define new global shared variable g#lib-trn2 as handle no-undo .
      125   define new global shared variable g#lib-trn3 as handle no-undo .
      126   define new global shared variable g#lib-trn4 as handle no-undo .
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     define variable v-cntxt-db-num        as integer   no-undo .
      129     define variable v-cntxt-userid        as character no-undo .
      130     define variable v-cntxt-level         as character no-undo .
      131     define variable v-cntxt-host-code-obj as integer   no-undo .
      132     define variable v-cntxt-obj-type      as character no-undo .
      133     define variable v-cntxt-obj-code      as integer   no-undo .
      134     define variable v-cntxt-db-num-obj    as integer   no-undo .
      135     define variable v-cntxt-is-admin      as logical   no-undo .
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137     run mainmenu_getcntxt in parparentproc
      138       (output v-cntxt-db-num
      139       ,output v-cntxt-userid
      140       ,output v-cntxt-level
      141       ,output v-cntxt-host-code-obj
      142       ,output v-cntxt-obj-type
      143       ,output v-cntxt-obj-code
      144       ,output v-cntxt-db-num-obj
      145       ,output v-cntxt-is-admin
      146       ) .
      147   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      150   define variable par-type          as character no-undo.
      151   define variable v-value-character as character no-undo .
      152   define variable v-value-date      as date      no-undo .
      153   define variable v-value-decimal   as decimal   no-undo .
      154   define variable v-value-integer   as integer   no-undo .
      155   define variable v-value-logical   as logical   no-undo .
      156   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      158        LABEL "Выход"
      159        SIZE 15 BY 1.13
      160        BGCOLOR 8 .
      161   DEFINE BUTTON Btn_del
      162        LABEL "Удалить"
      163        tooltip "Удалить из журнала."
      164        SIZE 15 BY 1.13.
      165   DEFINE BUTTON b-request
      166        LABEL "Отпр. запросы"
      167        tooltip "Отправить запросы во ФГИС Меркурий"
      168        SIZE 15 BY 1.13.
      169   DEFINE BUTTON b-response
      170        LABEL "Получить ответы"
      171        tooltip "Получить ответы на отправленные запросы из ФГИС Меркурий"
      172        SIZE 16 BY 1.13.
      173   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      174        VIEW-AS RADIO-SET HORIZONTAL
      175        RADIO-BUTTONS
      176             "Все", 1,
      177   "Новые", 2,
      178   "Закрытые", 3
      179        SIZE 50 BY 1.25 NO-UNDO.
      180   DEFINE BUTTON btRef
      181        LABEL "Обновить"
      182        SIZE 15 BY 1.13.
      183   DEFINE VARIABLE v-date-end AS DATE FORMAT "99/99/9999":U
      184        LABEL "По"
      185        VIEW-AS FILL-IN
      186        SIZE 12 BY 1 NO-UNDO.
      187   DEFINE VARIABLE v-date-start AS DATE FORMAT "99/99/9999":U
      188        LABEL "Дата C"
      189        VIEW-AS FILL-IN
      190        SIZE 12 BY 1 NO-UNDO.
      191   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      193   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      194   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      195   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      196   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      197   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      198   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      199   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      200   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      201   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      202   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      203   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      204   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      205   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      206   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      207   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      208   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      209   DEFINE BROWSE BROWSE-Journal-mercury
      210       WITH NO-ROW-MARKERS SEPARATORS SIZE 135 BY 25.
      211   DEFINE FRAME Dialog-Frame
      212        Btn_Cancel AT ROW 1 COL 1
      213        Btn_del AT ROW 1 COL 16.5 WIDGET-ID 6
      214        b-request at row 1 col 32
      215        b-response at row 1 col 47.5
      216        RADIO-SET-1 AT ROW 2.3 COL 1 NO-LABEL WIDGET-ID 2
      217        v-date-start at row 2.3 col 55
      218        v-date-end at row 2.3 col 76
      219        btRef at row 2.15 col 94
      220        BROWSE-Journal-mercury AT ROW 4 COL 1 WIDGET-ID 200
      221        SPACE(0.50) SKIP(0.24)
      222       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      223            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      224            TITLE "Журнал запросов Меркурий"
      225            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      226   ASSIGN
      227          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      228          FRAME Dialog-Frame:HIDDEN           = TRUE.
      229   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      230   DO:
      231       delete object journal no-error .
      232       delete object mercury no-error .
      233       delete object vsdStorage no-error .
      234       delete object vsdsTHObj no-error .
      235       delete object vsdTHObj no-error .
      236       delete object vsdStsType no-error .
      237       delete object objThObj no-error .
      238       delete object objKeyRec no-error .
      239       APPLY "END-ERROR":U TO SELF.
      240   END.
      241   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
      242   DO:
      243     assign RADIO-SET-1 .
      244     run openBR.
      245   END.
      246   ON choose OF btRef IN FRAME Dialog-Frame
      247   do:
      248     assign
      249       v-date-end
      250       v-date-start
      251     .
      252     date1 = datetime(v-date-start, 0) .
      253     date2 = datetime(v-date-end, 86399999) .
      254     bh-journal-mercury = journal:GetHndlTable(input date1, input date2).
      255     apply "value-changed" to radio-set-1 .
      256   end.
      257   ON choose OF Btn_del IN FRAME Dialog-Frame
      258   DO:
      259     find first ub.esys-all-attr where (table-name + string (key1) + string (key2) + string (key3) + string (key4) + string (key5) + string (key6) +
      260           string (key7) + string (key8) + attr-code) = bh-journal-mercury:buffer-field ('piIndex'):buffer-value () no-error.
      261     if available (ub.esys-all-attr)
      262       then delete ub.esys-all-attr.
      263     else return no-apply .
      264     if bh-journal-mercury:available
      265       then bh-journal-mercury:buffer-delete ().
      266     BROWSE-Journal-mercury:refresh ().
      267   END.
      268   ON choose OF B-request IN FRAME Dialog-Frame
      269   DO:
      270     objThObj = new clisub ().
      271     vsdStsType = new vsdstatustype().
      272     clients_ :
      273     for each clients no-lock where clients.obj-type = 'маг':U
      274                                and clients.stts = 0 :
      275   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      276   empty temp-table thbjattr_thbj-attr.
      277   run adm/shattri.p (
      278      input "get":U
      279     ,input clients.obj-type
      280     ,input clients.obj-code
      281     ,input 'mercur':U
      282     ,input  ""
      283     ,output v-value-character
      284     ,output v-value-date
      285     ,output v-value-decimal
      286     ,output v-value-integer
      287     ,output v-value-logical
      288     ,output par-type
      289     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      290     ) no-error .
      291       for each thbjattr_thbj-attr :
      292         case thbjattr_thbj-attr.prop-code :
      293           when "apikey" then v-apiKey = thbjattr_thbj-attr.property-value-character .
      294           when "login" then v-login = thbjattr_thbj-attr.property-value-character .
      295           when "login_is" then v-login_is = thbjattr_thbj-attr.property-value-character .
      296           when "password" then v-password = thbjattr_thbj-attr.property-value-character .
      297           when "type-connect" then v-type-connect = thbjattr_thbj-attr.property-value-integer .
      298           when "server" then v-server = thbjattr_thbj-attr.property-value-integer .
      299           when "proxy-addres" then v-proxy-addres = thbjattr_thbj-attr.property-value-character .
      300           when "proxy-login" then do:
      301             if thbjattr_thbj-attr.property-value-character <> ""
      302             then do :
      303   define variable vss-include-info7 as character format "X(65)" no-undo
      304   initial "@(#)$Workfile$ $Revision$".
      305   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      306     (input  thbjattr_thbj-attr.property-value-character
      307     ,output v-proxy-login
      308     ) no-error .
      309             end.
      310           end.
      311           when "proxy-pswd" then do:
      312             if thbjattr_thbj-attr.property-value-character <> ""
      313             then do :
      314   define variable vss-include-info8 as character format "X(65)" no-undo
      315   initial "@(#)$Workfile$ $Revision$".
      316   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      317     (input  thbjattr_thbj-attr.property-value-character
      318     ,output v-proxy-pswd
      319     ) no-error .
      320             end.
      321           end.
      322           when "proxy-ssl" then v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
      323         end case.
      324       end.
      325       if v-type-connect = 1 and v-cntxt-db-num <> 0 and v-cntxt-db-num <> clients.db-num
      326       then do :
      327         next clients_.
      328       end.
      329       if v-cntxt-db-num <> 0 and v-type-connect = 2
      330       then do :
      331         next clients_.
      332       end.
      333       if v-cntxt-db-num = 0 and v-type-connect = 1 and clients.db-num <> 0
      334       then do :
      335         next clients_.
      336       end.
      337       find first buf_ext-classif no-lock
      338             where buf_ext-classif.classif-subject = 'clients':U
      339               and buf_ext-classif.classif-name = 'clients-esys':U
      340               and buf_ext-classif.db-num = 0
      341               and buf_ext-classif.key#_one = buf_ext-system.esys-id
      342               and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + "орг" + chr(3) + string (clients.host-code)
      343               no-error.
      344       if not available buf_ext-classif
      345       then do :
      346         message "Фирма орг" string (clients.host-code) " не синхронизирована с ФГИС Меркурий (Нет GUID'а ХЗ)" view-as alert-box .
      347         next clients_.
      348       end.
      349       v-issuerId = entry(1, buf_ext-classif.charKey_Two, chr(6)) .
      350       mercury = new mercury(v-apiKey, v-issuerId, v-login, v-password, v-login_is, buf_ext-system.esys-id, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd, v-proxy-ssl, clients.db-num).
      351       objThObj:ObjType = clients.obj-type.
      352       objThObj:ObjCode = clients.obj-code.
      353       vsdsTHObj = new vsdsubs ().
      354       vsdStorage = new vsdtostorage ().
      355       vsdsTHObj = vsdStorage:getVSDsubs(input objThObj).
      356       find first buf_ext-classif no-lock
      357           where buf_ext-classif.classif-subject = 'clients':U
      358             and buf_ext-classif.classif-name = 'clients-esys':U
      359             and buf_ext-classif.db-num = 0
      360             and buf_ext-classif.key#_one = buf_ext-system.esys-id
      361             and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + clients.obj-type + chr(3) + string (clients.obj-code)
      362             no-error.
      363       vsd_ :
      364       do ii = 1 to vsdsTHObj:GetItem (ii):
      365         if ii = 1 and not available buf_ext-classif
      366         then do :
      367           message "Объект маг" string (clients.obj-code) " не синхронизирован с ФГИС Меркурий (Нет GUID'а предприятия)" view-as alert-box .
      368           next clients_.
      369         end.
      370         if vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsNeedCheck
      371         or vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck
      372         or vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrUtilized
      373         then do :
      374           if vsdsTHObj:VsdObjCurr:UUID = "" or vsdsTHObj:VsdObjCurr:UUID = ? or vsdsTHObj:VsdObjCurr:FactDatetime = ? then next .
      375           find first buf2_ext-classif no-lock
      376               where buf2_ext-classif.classif-subject = 'clients':U
      377                 and buf2_ext-classif.classif-name = 'clients-esys':U
      378                 and buf2_ext-classif.db-num = 0
      379                 and buf2_ext-classif.key#_one = buf_ext-system.esys-id
      380                 and buf2_ext-classif.uniq-key-rec = 'clients':U + chr(3) + vsdsTHObj:VsdObjCurr:CliType + chr(3) + string (vsdsTHObj:VsdObjCurr:CliCode)
      381                 no-error.
      382           if not available buf2_ext-classif
      383           then do :
      384             vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      385             vsdsTHObj:VsdObjCurr:MsgErr = "Контрагент-поставщик не синхронизирован с ФГИС Меркурий." .
      386             vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      387             message "UUID ВСД: " vsdsTHObj:VsdObjCurr:UUID skip "Контрагент-поставщик не синхронизирован с ФГИС Меркурий." skip "Запрос не отправлен." view-as alert-box .
      388             next vsd_.
      389           end.
      390           else do :
      391             if num-entries(buf2_ext-classif.charKey_Two, chr(6)) = 2
      392             then do :
      393               if entry(1, buf2_ext-classif.charKey_Two, chr(6)) = ""
      394               or entry(2, buf2_ext-classif.charKey_Two, chr(6)) = ""
      395               then do :
      396                 if vsdsTHObj:VsdObjCurr:CliType = 'маг'
      397                 then do :
      398                   if entry(2, buf2_ext-classif.charKey_Two, chr(6)) = ""
      399                   then do :
      400                     vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      401                     vsdsTHObj:VsdObjCurr:MsgErr = "Не заполнен GUID предприятия поставщика." .
      402                     vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      403                     message "UUID ВСД: " vsdsTHObj:VsdObjCurr:UUID skip "Не заполнены GUID предприятия поставщика." skip "Запрос не отправлен." view-as alert-box .
      404                     next vsd_.
      405                   end.
      406                 end.
      407                 else do :
      408                   vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      409                   vsdsTHObj:VsdObjCurr:MsgErr = "Не заполнены GUID'ы хоз. субъекта поставщика и/или предприятия поставщика." .
      410                   vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      411                   message "UUID ВСД: " vsdsTHObj:VsdObjCurr:UUID skip "Не заполнены GUID'ы хоз. субъекта поставщика и/или предприятия поставщика." skip "Запрос не отправлен." view-as alert-box .
      412                   next vsd_.
      413                 end.
      414               end .
      415             end.
      416             else do :
      417               vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      418               vsdsTHObj:VsdObjCurr:MsgErr = "Не верный формат связки поставщика с ФГИС Меркурий" .
      419               vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      420               message "UUID ВСД: " vsdsTHObj:VsdObjCurr:UUID skip "Не верный формат связки поставщика с ФГИС Меркурий" skip "Запрос не отправлен." view-as alert-box .
      421               next vsd_.
      422             end.
      423           end.
      424           find first ub.esys-all-attr no-lock where ub.esys-all-attr.table-name = "esys-pck-sent"
      425                                                 and ub.esys-all-attr.attr-code = "mercury"
      426                                                 and ub.esys-all-attr.attr-value = vsdsTHObj:VsdObjCurr:UUID
      427                                                 and ub.esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID
      428                                                 and ub.esys-all-attr.key2 = 1
      429                                                 and ub.esys-all-attr.key3 = "Запрос отправлен"
      430                                                 no-error .
      431           if available ub.esys-all-attr then next vsd_ .
      432           mercury:GetVetDocumentByUuid(LC(vsdsTHObj:VsdObjCurr:UUID), entry(2, buf_ext-classif.charKey_Two, chr(6)), v-appId, v-status_, v-Msg) .
      433           if v-status_ <> "ACCEPTED"
      434           then do :
      435             v-Msg = trim(trim(v-Msg, chr(10))) .
      436             if v-Msg = "" then v-Msg = "Нет связи со шлюзом Ветис.Api. Попробуйте повторить позже..." .
      437             message v-Msg view-as alert-box .
      438             next vsd_ .
      439           end .
      440           create ub.esys-all-attr .
      441           assign
      442             ub.esys-all-attr.table-name = "esys-pck-sent"
      443             ub.esys-all-attr.attr-code = "mercury"
      444             ub.esys-all-attr.key3 = "Запрос отправлен"
      445             ub.esys-all-attr.key4 = string(now)
      446             ub.esys-all-attr.key7 = v-appId
      447             ub.esys-all-attr.key2 = 1
      448             ub.esys-all-attr.key8 = v-cntxt-userid
      449           .
      450           ub.esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID .
      451           ub.esys-all-attr.attr-value = LC(vsdsTHObj:VsdObjCurr:UUID) .
      452         end.
      453         if vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsNeedUtilized
      454         then do :
      455           if vsdsTHObj:VsdObjCurr:UUID = "" or vsdsTHObj:VsdObjCurr:UUID = ? or vsdsTHObj:VsdObjCurr:FactDatetime = ? then next .
      456           find first ub.esys-all-attr no-lock where ub.esys-all-attr.table-name = "esys-pck-sent"
      457                                                 and ub.esys-all-attr.attr-code = "mercury"
      458                                                 and ub.esys-all-attr.attr-value = vsdsTHObj:VsdObjCurr:UUID
      459                                                 and ub.esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID
      460                                                 and ub.esys-all-attr.key2 = 2
      461                                                 and ub.esys-all-attr.key3 = "Запрос отправлен"
      462                                                 no-error .
      463           if available ub.esys-all-attr then next vsd_ .
      464           objKeyRec = new keyrec () .
      465           objKeyRec:GenRowKeyr(vsdsTHObj:VsdObjCurr:PartKey, ?, "ub", ?, ?, v-part-rowid, v-tbl-name) .
      466           delete object objKeyRec no-error .
      467           find first buf_parts no-lock where rowid (buf_parts) = v-part-rowid no-error.
      468           if not available buf_parts
      469           then do :
      470             message "ВСД с UUID "  vsdsTHObj:VsdObjCurr:UUID  " не привязана к партии!!!" view-as alert-box.
      471             next vsd_.
      472           end.
      473           mercury:processIncomingConsignment(vsdsTHObj, buf_parts.qnty, buf_parts.fact-qnty, v-appId, v-status_, v-Msg) .
      474           if v-status_ <> "ACCEPTED"
      475           then do :
      476             v-Msg = trim(trim(v-Msg, chr(10))) .
      477             if v-Msg = "" then v-Msg = "Нет связи со шлюзом Ветис.Api. Попробуйте повторить позже..." .
      478             message v-Msg view-as alert-box .
      479             next vsd_ .
      480           end .
      481           create ub.esys-all-attr .
      482           assign
      483             ub.esys-all-attr.table-name = "esys-pck-sent"
      484             ub.esys-all-attr.attr-code = "mercury"
      485             ub.esys-all-attr.key3 = "Запрос отправлен"
      486             ub.esys-all-attr.key4 = string(now)
      487             ub.esys-all-attr.key7 = v-appId
      488             ub.esys-all-attr.key2 = 2
      489             ub.esys-all-attr.key8 = v-cntxt-userid
      490           .
      491           ub.esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID .
      492           ub.esys-all-attr.attr-value = LC(vsdsTHObj:VsdObjCurr:UUID) .
      493         end.
      494       end.
      495       delete object vsdsTHObj .
      496       delete object vsdStorage .
      497       delete object mercury no-error .
      498     end.
      499     delete object objThObj no-error .
      500     delete object vsdStsType no-error .
      501     assign
      502       v-date-end
      503       v-date-start
      504     .
      505     date1 = datetime(v-date-start, 0) .
      506     date2 = datetime(v-date-end, 86399999) .
      507     bh-journal-mercury = journal:GetHndlTable(input date1, input date2).
      508     RUN openBR.
      509   END.
      510   ON choose OF b-response IN FRAME Dialog-Frame
      511   DO:
      512     for each ub.esys-all-attr exclusive-lock where ub.esys-all-attr.table-name = "esys-pck-sent"
      513                                                 and ub.esys-all-attr.attr-code = "mercury"
      514                                                 and ub.esys-all-attr.key3 = "Запрос отправлен" :
      515       find first buf_vsd no-lock where buf_vsd.UUID = ub.esys-all-attr.attr-value no-error.
      516       if not available buf_vsd then next .
      517   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      518   empty temp-table thbjattr_thbj-attr.
      519   run adm/shattri.p (
      520      input "get":U
      521     ,input buf_vsd.obj-type
      522     ,input buf_vsd.obj-code
      523     ,input 'mercur':U
      524     ,input  ""
      525     ,output v-value-character
      526     ,output v-value-date
      527     ,output v-value-decimal
      528     ,output v-value-integer
      529     ,output v-value-logical
      530     ,output par-type
      531     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      532     ) no-error .
      533       for each thbjattr_thbj-attr :
      534         case thbjattr_thbj-attr.prop-code :
      535           when "apikey" then v-apiKey = thbjattr_thbj-attr.property-value-character .
      536           when "login" then v-login = thbjattr_thbj-attr.property-value-character .
      537           when "login_is" then v-login_is = thbjattr_thbj-attr.property-value-character .
      538           when "password" then v-password = thbjattr_thbj-attr.property-value-character .
      539           when "type-connect" then v-type-connect = thbjattr_thbj-attr.property-value-integer .
      540           when "server" then v-server = thbjattr_thbj-attr.property-value-integer .
      541           when "proxy-addres" then v-proxy-addres = thbjattr_thbj-attr.property-value-character .
      542           when "proxy-login" then do:
      543             if thbjattr_thbj-attr.property-value-character <> ""
      544             then do :
      545   define variable vss-include-info10 as character format "X(65)" no-undo
      546   initial "@(#)$Workfile$ $Revision$".
      547   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      548     (input  thbjattr_thbj-attr.property-value-character
      549     ,output v-proxy-login
      550     ) no-error .
      551             end.
      552           end.
      553           when "proxy-pswd" then do:
      554             if thbjattr_thbj-attr.property-value-character <> ""
      555             then do :
      556   define variable vss-include-info11 as character format "X(65)" no-undo
      557   initial "@(#)$Workfile$ $Revision$".
      558   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      559     (input  thbjattr_thbj-attr.property-value-character
      560     ,output v-proxy-pswd
      561     ) no-error .
      562             end.
      563           end.
      564           when "proxy-ssl" then v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
      565         end case.
      566       end.
      567       if v-cntxt-db-num <> 0 and v-type-connect = 2
      568       then do :
      569         next.
      570       end.
      571       find first buf_clients no-lock where buf_clients.obj-type = buf_vsd.obj-type and buf_clients.obj-code = buf_vsd.obj-code .
      572       if v-type-connect = 1 and v-cntxt-db-num <> 0 and v-cntxt-db-num <> buf_clients.db-num
      573       then do :
      574         next.
      575       end.
      576       if v-cntxt-db-num = 0 and v-type-connect = 1 and buf_clients.db-num <> 0
      577       then do :
      578         next.
      579       end.
      580       find first buf_ext-classif no-lock
      581             where buf_ext-classif.classif-subject = 'clients':U
      582               and buf_ext-classif.classif-name = 'clients-esys':U
      583               and buf_ext-classif.db-num = 0
      584               and buf_ext-classif.key#_one = buf_ext-system.esys-id
      585               and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + "орг" + chr(3) + string (buf_clients.host-code)
      586               no-error.
      587       if not available buf_ext-classif
      588       then do :
      589         message "Фирма орг" string (buf_clients.host-code) " не синхронизирована с ФГИС Меркурий (Нет GUID'а ХЗ)" view-as alert-box .
      590         next.
      591       end.
      592       v-issuerId = entry(1, buf_ext-classif.charKey_Two, chr(6)) .
      593       mercury = new mercury(v-apiKey, v-issuerId, v-login, v-password, v-login_is, buf_ext-system.esys-id, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd, v-proxy-ssl, buf_clients.db-num).
      594       mercury:vsdId = ub.esys-all-attr.key1.
      595       case ub.esys-all-attr.key2 :
      596         when 1
      597         then do :
      598           objKeyRec = new keyrec () .
      599           find first buf_vsd no-lock where buf_vsd.UUID = ub.esys-all-attr.attr-value and buf_vsd.ID =  ub.esys-all-attr.key1 no-error.
      600           if not available buf_vsd then next .
      601           objKeyRec:GenRowKeyr(buf_vsd.part-key, ?, "ub", ?, ?, v-part-rowid, v-tbl-name) .
      602           delete object objKeyRec no-error .
      603           find first buf_parts no-lock where rowid (buf_parts) = v-part-rowid no-error.
      604           if not available buf_parts
      605           then do :
      606             objKeyRec = new keyrec () .
      607             true_vsd_:
      608             for each buf_vsd no-lock where buf_vsd.UUID = ub.esys-all-attr.attr-value and buf_vsd.ID =  ub.esys-all-attr.key1 :
      609               objKeyRec:GenRowKeyr(buf_vsd.part-key, ?, "ub", ?, ?, v-part-rowid, v-tbl-name) .
      610               find first buf_parts no-lock where rowid (buf_parts) = v-part-rowid no-error.
      611               if available buf_parts
      612               then do :
      613                 leave true_vsd_ .
      614               end.
      615             end.
      616             delete object objKeyRec no-error .
      617           end.
      618           if not available buf_parts
      619           then do :
      620             message "ВСД с UUID "  ub.esys-all-attr.attr-value  " не привязана к партии!!!" view-as alert-box.
      621             next.
      622           end.
      623           if not valid-object(vsdStsType) then vsdStsType = new vsdstatustype () .
      624           mercury:receiveVetDoc(input ub.esys-all-attr.key7, input LC(ub.esys-all-attr.attr-value), input buf_parts.qnty, input buf_parts.fact-qnty, input (buf_vsd.status_ = vsdStsType:IsUtilized), output v-Status_, output v-Msg) .
      625           if v-Status_ = "COMPLETED"
      626           then ub.esys-all-attr.key3 = "Ответ получен" .
      627           else do :
      628             v-Msg = trim(trim(v-Msg, chr(10))) .
      629             if v-Msg = ""
      630             then do :
      631               v-Msg = "Нет связи со шлюзом Ветис.Api. Попробуйте повторить позже..." .
      632               message v-Msg view-as alert-box .
      633             end.
      634             else do :
      635               ub.esys-all-attr.key3 = "Запрос отклонён" .
      636               message "UUID ВСД:  " ub.esys-all-attr.attr-value skip v-Msg view-as alert-box.
      637             end.
      638           end.
      639         end.
      640         when 2
      641         then do :
      642           mercury:receiveIncomingConsignmentResponse(input ub.esys-all-attr.key7, input ub.esys-all-attr.attr-value, output v-Status_, output v-Msg) .
      643           if v-Status_ = "COMPLETED"
      644           then ub.esys-all-attr.key3 = "Ответ получен" .
      645           else do :
      646             v-Msg = trim(trim(v-Msg, chr(10))) .
      647             if v-Msg = ""
      648             then do :
      649               v-Msg = "Нет связи со шлюзом Ветис.Api. Попробуйте повторить позже..." .
      650               message v-Msg view-as alert-box .
      651             end.
      652             else do :
      653               ub.esys-all-attr.key3 = "Запрос отклонён" .
      654               if v-Msg = "MERC14561"
      655               or v-Msg = "MERC14562"
      656               or v-Msg = "MERC14563"
      657               then
      658                 message "UUID ВСД:  " ub.esys-all-attr.attr-value skip "Ошибка наименования продукции " v-Msg ". ВСД будет погашено с актом несоответсвия." view-as alert-box.
      659               else
      660               if v-Msg = "MERC14258"
      661               or v-Msg = "MERC14537"
      662               then
      663                 message "UUID ВСД:  " ub.esys-all-attr.attr-value skip "Ошибка номера партии/ТТН " v-Msg ". ВСД будет погашено с актом несоответсвия." view-as alert-box.
      664               else
      665                 message "UUID ВСД:  " ub.esys-all-attr.attr-value skip v-Msg view-as alert-box.
      666             end.
      667           end.
      668         end.
      669       end case.
      670       delete object mercury no-error .
      671     end.
      672     delete object vsdStsType no-error .
      673     assign
      674       v-date-end
      675       v-date-start
      676     .
      677     date1 = datetime(v-date-start, 0) .
      678     date2 = datetime(v-date-end, 86399999) .
      679     bh-journal-mercury = journal:GetHndlTable(input date1, input date2).
      680     RUN openBR.
      681   END.
      682   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      683   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      684   MAIN-BLOCK:
      685   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      686      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      687   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      688   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      689     (output v-db-num
      690     ,output v-user-id
      691     ) no-error .
      692   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      693   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      694   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      695   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      696   define variable v-diasize-current-frame-width  as decimal   no-undo .
      697   define variable v-diasize-current-frame-height as decimal   no-undo .
      698   define variable v-diasize-change-size          as logical   no-undo .
      699   define variable v-diasize-resize-button        as handle    no-undo .
      700   define variable v-diasize-wndmax               as logical   no-undo .
      701   define variable v-diasize-wndstore             as logical   no-undo .
      702   define variable v-diasize-proc-name            as character no-undo .
      703   define variable v-diasize-browse-handle        as handle    no-undo .
      704   define variable v-diasize-browse-number        as integer   no-undo .
      705   define variable v-diasize-need-full-display    as logical   no-undo init false .
      706   define temp-table temp-diasize-handle no-undo
      707     field handle-value  as handle
      708     field save-position as decimal
      709     index xpk is primary unique handle-value
      710     .
      711   define temp-table temp-browse-handle no-undo
      712     field browse-type   as character
      713     field browse-number as integer
      714     field browse-handle as handle
      715     field original-size as decimal
      716     index xpk is primary unique browse-type browse-number
      717     index xie browse-type browse-handle
      718   .
      719   procedure diasize_change-height :
      720     define input  parameter p-change-value  as decimal   no-undo .
      721     define input  parameter p-move-resize   as logical   no-undo .
      722     define variable v-field-group-handle    as handle    no-undo .
      723     define variable v-object-handle         as handle    no-undo .
      724     define variable v-frame-height          as decimal   no-undo .
      725     define variable v-frame-virtual-height  as decimal   no-undo .
      726     define variable v-browse-height         as decimal   no-undo .
      727     define variable v-window-height         as decimal   no-undo .
      728     define variable v-window-virtual-height as decimal   no-undo .
      729     define variable v-change-sign           as integer   no-undo .
      730     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      731     define buffer buf_temp-browse-handle  for temp-browse-handle .
      732     if p-change-value > 0
      733     then do:
      734       if frame Dialog-Frame :height + p-change-value
      735           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      736       then do:
      737         assign
      738           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      739                           - (frame Dialog-Frame :height-chars)
      740         .
      741         if p-change-value <= 0
      742         then do:
      743           run diasize_position-resize-button in this-procedure .
      744           return .
      745         end.
      746       end.
      747     end.
      748     if p-change-value < 0
      749     then do:
      750       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      751       then do:
      752         assign
      753           p-change-value = v-diasize-orig-frame-height
      754                          - (frame Dialog-Frame :height-chars)
      755         .
      756         if p-change-value >= 0
      757         then do:
      758           run diasize_position-resize-button in this-procedure .
      759           return .
      760         end.
      761       end.
      762     end.
      763     if p-change-value >= 0
      764     then do:
      765       assign
      766         v-change-sign = 1
      767       .
      768     end.
      769     else do:
      770       assign
      771         v-change-sign = -1
      772       .
      773     end.
      774     assign
      775       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      776     .
      777     if p-change-value = 0
      778     then do:
      779       run diasize_position-resize-button in this-procedure .
      780       return .
      781     end.
      782     move_block:
      783     do
      784     on error undo move_block, retry move_block
      785     :
      786       if retry
      787       then do:
      788         do
      789         on error undo move_block, leave move_block
      790         :
      791           if p-change-value > 0
      792           then do:
      793             for each buf_temp-diasize-handle
      794             on error undo, next
      795             :
      796               assign
      797                 v-object-handle = buf_temp-diasize-handle.handle-value
      798               .
      799               if v-object-handle <> v-diasize-resize-button
      800               then do:
      801                 assign
      802                   v-object-handle :row = buf_temp-diasize-handle.save-position
      803                 .
      804               end.
      805             end.
      806             assign
      807               v-diasize-browse-handle :height = v-browse-height
      808             .
      809             for each buf_temp-browse-handle
      810               where buf_temp-browse-handle.browse-type = 'height':u
      811             on error undo, next
      812             :
      813               assign
      814                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      815               .
      816             end.
      817             assign
      818               frame Dialog-Frame :height = v-frame-height
      819             .
      820             if frame Dialog-Frame :scrollable = true
      821             then do:
      822               assign
      823                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      824               .
      825             end.
      826             run diasize_position-resize-button in this-procedure .
      827           end.
      828           else do:
      829             if frame Dialog-Frame :scrollable = true
      830             then do:
      831               assign
      832                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      833               .
      834             end.
      835             assign
      836               frame Dialog-Frame :height = v-frame-height
      837             .
      838             assign
      839               v-diasize-browse-handle :height = v-browse-height
      840             .
      841             for each buf_temp-browse-handle
      842               where buf_temp-browse-handle.browse-type = 'height':u
      843             on error undo, next
      844             :
      845               assign
      846                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      847               .
      848             end.
      849             for each buf_temp-diasize-handle
      850             on error undo, next
      851             :
      852               assign
      853                 v-object-handle = buf_temp-diasize-handle.handle-value
      854               .
      855               if v-object-handle <> v-diasize-resize-button
