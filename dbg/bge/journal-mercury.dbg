     1150     then do:
     1151       assign
     1152         v-change-sign = 1
     1153       .
     1154     end.
     1155     else do:
     1156       assign
     1157         v-change-sign = -1
     1158       .
     1159     end.
     1160     assign
     1161       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1162     .
     1163     if p-change-value = 0
     1164     then do:
     1165       run diasize_position-resize-button in this-procedure .
     1166       return .
     1167     end.
