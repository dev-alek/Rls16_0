      943   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   procedure findtank:
      945     define input  parameter p-obj-type     as character no-undo.
      946     define input  parameter p-obj-code     as integer   no-undo.
      947     define input  parameter p-pump-code    as integer   no-undo.
      948     define input  parameter p-nozzle-code  as integer   no-undo .
      949     define input  parameter p-from-pl-code as integer   no-undo .
      950     define input  parameter p-gds-code     as integer   no-undo.
      951     define output parameter p-pl-code      as integer   no-undo .
      952     define variable v-pl-code            like ub.place.pl-code no-undo .
      953     define variable v-dopstr             as character no-undo .
      954     define buffer buf_place for ub.place.
      955     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      956     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      957     define buffer buf_pl-gds for ub.pl-gds.
      958     do
      959     on error undo, return error return-value
      960     :
      961       assign
      962         v-pl-code = 0
      963         p-pl-code = ?
      964       .
      965       if p-from-pl-code <> ?
      966         and p-from-pl-code <> 0
      967       then do:
      968         find first buf_pl-gds no-lock
      969           where buf_pl-gds.obj-type  = p-obj-type
      970             and buf_pl-gds.obj-code  = p-obj-code
      971             and buf_pl-gds.pl-code   = p-from-pl-code
      972             and buf_pl-gds.gds-code  = p-gds-code
      973           no-error.
      974         if available buf_pl-gds then do:
      975           assign
      976             v-pl-code = buf_pl-gds.pl-code
      977           .
      978         end.
      979       end.
      980       if v-pl-code <> 0
      981         and p-nozzle-code <> ?
      982         and p-nozzle-code <> 0
      983       then do:
      984         find first buf_pl-pump-nozzle no-lock
      985           where buf_pl-pump-nozzle.obj-type    = p-obj-type
      986             and buf_pl-pump-nozzle.obj-code    = p-obj-code
      987             and buf_pl-pump-nozzle.pl-code     = v-pl-code
      988             and buf_pl-pump-nozzle.pump-code   = p-pump-code
      989             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
      990           no-error .
      991         if not available buf_pl-pump-nozzle then do:
      992           return.
      993         end.
      994       end.
      995       if v-pl-code = 0 then do:
      996         if p-nozzle-code = 0 then do:
      997           find first buf_pl-gds-pump no-lock
      998             where buf_pl-gds-pump.obj-type  = p-obj-type
      999               and buf_pl-gds-pump.obj-code  = p-obj-code
     1000               and buf_pl-gds-pump.pump-code = p-pump-code
     1001               and buf_pl-gds-pump.gds-code  = p-gds-code
     1002               and buf_pl-gds-pump.status_   = 'тек':U
     1003             no-error.
     1004           if available buf_pl-gds-pump then do:
     1005             assign
     1006               v-pl-code = buf_pl-gds-pump.pl-code
     1007             .
     1008           end.
     1009         end.
     1010         else do:
     1011           _ppnz:
     1012           for each buf_pl-pump-nozzle no-lock
     1013             where buf_pl-pump-nozzle.obj-type = p-obj-type
     1014               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1015               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1016               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1017             ,first buf_pl-gds-pump no-lock
     1018             where buf_pl-gds-pump.obj-type  = p-obj-type
     1019               and buf_pl-gds-pump.obj-code  = p-obj-code
     1020               and buf_pl-gds-pump.pump-code = p-pump-code
     1021               and buf_pl-gds-pump.gds-code  = p-gds-code
     1022               and buf_pl-gds-pump.status_   = 'тек':U
     1023               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
     1024           on error undo, return error return-value
     1025           :
     1026             assign
     1027               v-pl-code = buf_pl-pump-nozzle.pl-code
     1028             .
     1029             leave _ppnz.
     1030           end.
     1031         end.
     1032       end.
     1033       if v-pl-code <> 0 then do:
     1034         assign
     1035           p-pl-code = v-pl-code
     1036         .
     1037       end.
     1038     end.
     1039   end procedure.
     1040   procedure find-nzl:
     1041   define input  parameter p-obj-type   as character no-undo.
     1042   define input  parameter p-obj-code   as integer   no-undo.
     1043   define input  parameter p-pump-code  as integer   no-undo.
     1044   define input  parameter p-gds-code   as integer   no-undo.
     1045   define input  parameter p-pl-code    as integer no-undo .
     1046   define output parameter p-nozzle-code    as integer   no-undo.
     1047   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
     1048   define variable v-pl-code            like ub.place.pl-code no-undo .
     1049   define variable v-pump-code          like ub.pump.pump-code no-undo .
     1050   define variable v-loc1-code          like ub.place.loc1 no-undo .
     1051   define variable v-dopstr             as character no-undo .
     1052   define buffer buf_place for ub.place.
     1053   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1054   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1055   define buffer buf_pl-gds for ub.pl-gds.
     1056   do on error undo, return error return-value :
     1057     v-pump-code = p-pump-code.
     1058     find first buf_pl-pump-nozzle no-lock where
     1059                   buf_pl-pump-nozzle.obj-type = p-obj-type
     1060               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1061               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1062               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
     1063     if not available buf_pl-pump-nozzle then do:
     1064       assign
     1065       p-nozzle-code = ?.
     1066       return .
     1067     end.
     1068     assign
     1069     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1070     return.
     1071     .
     1072   end.
     1073   end procedure.
     1074   procedure find-nzl-without-pl:
     1075   define input  parameter p-obj-type   as character no-undo.
     1076   define input  parameter p-obj-code   as integer   no-undo.
     1077   define input  parameter p-pump-code  as integer   no-undo.
     1078   define input  parameter p-gds-code   as integer   no-undo.
     1079   define output parameter p-nozzle-code    as integer   no-undo.
     1080   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1081   define buffer buf_pl-gds for ub.pl-gds.
     1082   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1083   do on error undo, return error return-value :
     1084     for each buf_pl-gds-pump no-lock where
     1085               buf_pl-gds-pump.obj-type  = p-obj-type
     1086           and buf_pl-gds-pump.obj-code  = p-obj-code
     1087           and buf_pl-gds-pump.pump-code = p-pump-code
     1088           and buf_pl-gds-pump.gds-code  = p-gds-code
     1089           and buf_pl-gds-pump.status_   = 'тек':U,
     1090         first buf_pl-gds no-lock where
     1091                   buf_pl-gds.obj-type = p-obj-type
     1092               AND buf_pl-gds.obj-code = p-obj-code
     1093               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
     1094               AND buf_pl-gds.gds-code = p-gds-code
     1095               AND buf_pl-gds.status_ = 'тек':U,
     1096        first buf_pl-pump-nozzle no-lock where
     1097                 buf_pl-pump-nozzle.obj-type = p-obj-type
     1098             and buf_pl-pump-nozzle.obj-code = p-obj-code
     1099             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
     1100             and buf_pl-pump-nozzle.pump-code = p-pump-code:
     1101       assign
     1102       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1103       return .
     1104     end.
     1105     assign
     1106     p-nozzle-code = ?.
     1107     return.
     1108     .
     1109   end.
     1110   end procedure.
     1111   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   define new global shared variable g#trdcalib as handle no-undo.
     1113   define temp-table tt_obj no-undo
     1114       field obj-type as character
     1115       field obj-code as integer
     1116   .
