     1133   define buffer buf_goods       for ub.goods.
     1134   define buffer buf_bar-code    for ub.bar-code.
     1135   define buffer buf_prod-bc     for ub.prod-bc.
     1136   define variable is-petrolium           as logical   no-undo.
     1137   define variable is-pieces              as logical   no-undo.
     1138   define variable v-prod-bc              as character no-undo.
     1139   define variable v-date-file-name as character no-undo.
     1140   DEFINE VARIABLE file_name        AS CHARACTER NO-UNDO.
     1141   define variable v-time           as integer   no-undo.
     1142   define variable v-time-file      as char      no-undo.
     1143   DEFINE VARIABLE log-file-name    AS CHARACTER NO-UNDO.
     1144   define variable v-date           as date      no-undo.
     1145   define variable v-date-end       as character no-undo.
     1146   define variable v-sdate-end      as character no-undo.
     1147   define variable v-arc   as character no-undo .
     1148   define variable v-cmd   as character no-undo .
     1149   assign
     1150     v-arc = search( "exe/7z.exe":U )
     1151   .
     1152   if v-arc = ? then do:
     1153     return error "Не найдена программа 7z.exe, невозможно упаковать выгрузку в zip" .
     1154   end.
     1155   assign
     1156     log-file-name    = substitute("&1exp-ATD.log", ibs.th.gbl.gbl-inipar:logDir)
     1157     v-time = time
     1158     v-date = today
     1159     v-time-file      = replace(  string(v-time, "HH:MM:SS"), ":", ""  )
     1160     v-date-file-name = STRING(YEAR(v-date), "9999") + STRING(DAY(v-date), "99") + STRING(MONTH(v-date), "99")
     1161     file_name        = substitute("&1HDB_&2_&3_&4.csv", p_path, trim(p-region), v-date-file-name, v-time-file)
     1162   .
     1163   function format_datetime returns character(
     1164       input v-date as date,
     1165       input v-time as integer
     1166       ):
     1167       return substitute("&1.&2.&3 &4",
     1168           string(day(v-date),"99"),
     1169           string(month(v-date),"99"),
     1170           string(year(v-date),"9999"),
     1171           string(v-time, "HH:MM:SS:000")
     1172           ).
     1173   end function.
     1174   define variable c-value as char no-undo.
     1175   define variable  c-type as char no-undo.
     1176   define variable v-st-shift-date as date no-undo .
     1177   define variable v-st-shift-num  as integer no-undo .
     1178   define variable v-prev-shift-date as date no-undo .
     1179   define variable v-prev-shift-num  as integer no-undo .
     1180   output to value(file_name) .
     1181   for each tt_obj no-lock:
     1182       find first buf_clients no-lock where buf_clients.obj-type = tt_obj.obj-type
     1183                                        and buf_clients.obj-code = tt_obj.obj-code no-error .
     1184     if available buf_clients then
     1185       put unformatted "Store," string(buf_clients.obj-code) "," p-region ",1," buf_clients.obj-name skip .
     1186   end.
     1187   goods_:
     1188   for each buf_goods no-lock where buf_goods.stts = 0 :
     1189   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1190     (
     1191        input buf_goods.artic
     1192     ,  input buf_goods.prod-type
     1193     ,  input buf_goods.prod-code
     1194     , output is-petrolium
     1195     , output is-pieces
     1196     ) .
     1197       if not is-petrolium
     1198       then next .
     1199       v-prod-bc = ? .
     1200       bar-code_ :
     1201       for each buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code :
     1202           find first buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code no-error .
     1203           if available buf_prod-bc
     1204           then do :
     1205               v-prod-bc = buf_prod-bc.b-str .
     1206               leave bar-code_ .
     1207           end.
     1208           else do :
     1209               v-prod-bc = ? .
     1210           end.
     1211       end.
     1212       if v-prod-bc = ?
     1213       then next goods_ .
     1214       put unformatted "ItemInfo," p-region "," string(buf_goods.gds-code) "," v-prod-bc ",1,Активный," buf_goods.artic "," buf_goods.gds-name "," string(buf_goods.grp-code) skip .
     1215   end.
     1216   for each tt_obj no-lock:
     1217          run write-log-and-file in p_log-handle     (input 1, input log-file-name, input 1, input substitute("Объект: &1   &2", tt_obj.obj-type, tt_obj.obj-code )) .
     1218   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1220     (input  tt_obj.obj-type
     1221     ,input  tt_obj.obj-code
     1222     ,input  'shift-on=request'
     1223     ,output v-shift-on
     1224     ) no-error .
     1225       if v-shift-on then . else next .
     1226       if p-mode = "shd"
     1227       then do:
     1228           run clntattr-value in this-procedure (input tt_obj.obj-type,
     1229               input tt_obj.obj-code,
     1230               input 'bge-exp-last-atd':U,
     1231               output c-value,
     1232               output c-type) NO-ERROR.
     1233           if error-status:error then
     1234           do:
     1235                           run write-log-and-file in p_log-handle     (input 1, input log-file-name, input 1, input substitute("Ошибка в атрибуте объекта. Объект &1&2",tt_obj.obj-type,tt_obj.obj-code)).
     1236               next.
     1237           end.
     1238                           run write-log-and-file in p_log-handle     (input 1, input log-file-name, input 1, input substitute("Последняя выгруженная смена объекта &1&2 (дата, номер): &3 (атрибут объекта &4)", tt_obj.obj-type, tt_obj.obj-code, c-value, 'bge-exp-last-atd':U)).
     1239           if c-value = "" then c-value = "1/1/1900,1".
     1240           assign
     1241             v-prev-shift-date = date(entry(1,c-value,","))
     1242             v-prev-shift-num  = integer(entry(2,c-value,","))
     1243             p-d_sht-start = ?
     1244           .
     1245         for each buf_shift-obj no-lock
     1246            where buf_shift-obj.obj-type = tt_obj.obj-type
     1247              and buf_shift-obj.obj-code = tt_obj.obj-code
     1248              and buf_shift-obj.shift-date >= v-prev-shift-date
     1249              and buf_shift-obj.status_  = 'зкр':U
     1250                by buf_shift-obj.shift-date
     1251                by buf_shift-obj.shift-num:
     1252           if (buf_shift-obj.shift-date = v-prev-shift-date) and
     1253              (buf_shift-obj.shift-num <= v-prev-shift-num) then next.
     1254           assign
     1255             p-d_sht-start = buf_shift-obj.shift-date
     1256             p-i_sht-start = buf_shift-obj.shift-num
     1257           .
     1258           leave.
     1259         end.
     1260         if (p-d_sht-start = ?) then do:
     1261                           run write-log-and-file in p_log-handle     (input 1, input log-file-name, input 1, input substitute("Отсутствуют смены для выгрузки после &1 смена &2. Объект &3&4", v-prev-shift-date, v-prev-shift-num, tt_obj.obj-type, tt_obj.obj-code )).
     1262               next.
     1263         end.
     1264       end.
     1265       else do:
     1266         v-prev-shift-date = ?.
     1267         for each buf_shift-obj no-lock
     1268            where buf_shift-obj.obj-type = tt_obj.obj-type
     1269              and buf_shift-obj.obj-code = tt_obj.obj-code
     1270              and buf_shift-obj.shift-date <= p-d_sht-start
     1271              and buf_shift-obj.status_  = 'зкр':U
     1272                by buf_shift-obj.shift-date descending
     1273                by buf_shift-obj.shift-num descending:
     1274           if (buf_shift-obj.shift-date = p-d_sht-start) and
     1275              (buf_shift-obj.shift-num >= p-i_sht-start) then next.
     1276           assign
     1277             v-prev-shift-date = buf_shift-obj.shift-date
     1278             v-prev-shift-num  = buf_shift-obj.shift-num
     1279           .
     1280           leave.
     1281         end.
     1282         if (v-prev-shift-date = ?) then do:
     1283           c-value = "1/1/1900,1".
     1284           assign
     1285             v-prev-shift-date = date(entry(1,c-value,","))
     1286             v-prev-shift-num  = integer(entry(2,c-value,","))
     1287           .
     1288         end.
     1289       end.
     1290       run write-log-and-file in p_log-handle     (input 1, input log-file-name, input 1, input substitute("Дата начала выгрузки: &1   &2", p-d_sht-start, p-i_sht-start )) .
     1291         assign
     1292           v-sdate-end = ""
     1293         .
     1294         for each buf_shift-obj no-lock
     1295            where buf_shift-obj.obj-type = tt_obj.obj-type
     1296              and buf_shift-obj.obj-code = tt_obj.obj-code
     1297              and buf_shift-obj.shift-date = p-d_sht-start
     1298              and buf_shift-obj.status_  = 'зкр':U
     1299                by buf_shift-obj.shift-num:
     1300           if buf_shift-obj.shift-num < p-i_sht-start then next .
     1301           do
     1302           on error undo, return error return-value
     1303           :
     1304             run shift-output in this-procedure (
     1305               input v-prev-shift-date, input v-prev-shift-num,
     1306               buffer buf_shift-obj) .
     1307           end.
     1308           assign
     1309             v-prev-shift-date = buf_shift-obj.shift-date
     1310             v-prev-shift-num  = buf_shift-obj.shift-num
     1311             v-sdate-end = substitute("&1,&2", buf_shift-obj.shift-date , buf_shift-obj.shift-num)
     1312             v-date-end = substitute("&1   &2", buf_shift-obj.shift-date , buf_shift-obj.shift-num)
     1313           .
     1314         end.
     1315         for each buf_shift-obj no-lock
     1316            where buf_shift-obj.obj-type = tt_obj.obj-type
     1317              and buf_shift-obj.obj-code = tt_obj.obj-code
     1318              and buf_shift-obj.shift-date > p-d_sht-start
     1319              and buf_shift-obj.shift-date <= p-d_sht-end
     1320              and buf_shift-obj.status_  = 'зкр':U
     1321                by buf_shift-obj.shift-date
     1322                by buf_shift-obj.shift-num:
     1323           if buf_shift-obj.shift-date = p-d_sht-end then do:
     1324             if buf_shift-obj.shift-num > p-i_sht-end then leave.
     1325           end.
     1326           do
     1327           on error undo, return error return-value
     1328           :
     1329             run shift-output in this-procedure (
     1330               input v-prev-shift-date, input v-prev-shift-num,
     1331               buffer buf_shift-obj) .
     1332           end.
     1333           assign
     1334             v-prev-shift-date = buf_shift-obj.shift-date
     1335             v-prev-shift-num  = buf_shift-obj.shift-num
     1336             v-sdate-end = substitute("&1,&2", buf_shift-obj.shift-date , buf_shift-obj.shift-num)
     1337             v-date-end = substitute("&1   &2", buf_shift-obj.shift-date , buf_shift-obj.shift-num)
     1338           .
     1339         end.
     1340         if v-sdate-end > "" then
     1341               run clntattr-write in this-procedure (input tt_obj.obj-type,
     1342                   input tt_obj.obj-code,
     1343                   input 'bge-exp-last-atd':U,
     1344                   input v-sdate-end)
     1345               no-error.
     1346                       run write-log-and-file in p_log-handle     (input 1, input log-file-name, input 1, input substitute("Дата конца выгрузки: &1 ", v-date-end)) .
     1347   end.
     1348   output close .
     1349   v-cmd = v-arc + " a -tzip -ssw -mx7 " + '"' + substring(file_name, 1, length(file_name) - 3) + 'zip" '  + '"' +  file_name  + '"'  .
     1350   os-command silent value ( v-cmd ) .
     1351   os-delete value ( file_name ) .
     1352   procedure shift-output private:
     1353   define input parameter p-prev-shift-date as date no-undo .
     1354   define input parameter p-prev-shift-num  as integer no-undo .
     1355   define parameter buffer p-buf_shift-obj for ub.shift-obj .
     1356   define variable is-petrolium           as logical   no-undo.
     1357   define variable is-pieces              as logical   no-undo.
     1358   define variable v-shift-head           as character no-undo .
     1359   define variable v-trn-stype            as character no-undo .
     1360   define variable v-doc-qnty   as decimal decimals 10 no-undo .
     1361   define variable v-pl-code              as integer   no-undo .
     1362   define variable v-loc1                 as character no-undo .
     1363   define buffer buf_rvs-doc     for ub.rvs-doc.
     1364   define buffer buf_rvs-line    for ub.rvs-line.
     1365   define buffer buf_rvs-line-pump for ub.rvs-line-pump.
     1366   define buffer buf_place       for ub.place.
     1367   define buffer buf_chk-doc     for ub.chk-doc.
     1368   define buffer buf_chk-gds     for ub.chk-gds.
     1369   define buffer buf_bar-code    for ub.bar-code.
     1370   define buffer buf_goods       for ub.goods.
     1371   define buffer buf_clients     for ub.clients.
     1372   define buffer buf_trn-doc     for ub.trn-doc.
     1373   define buffer buf_doc-line    for ub.doc-line.
     1374   define buffer buf_doc-pl      for ub.doc-pl .
     1375   define buffer buf_sale-doc    for ub.sale-doc .
     1376     v-shift-head = substitute (  "&1,&2,&3,&4",
     1377                                  p-region,  p-buf_shift-obj.obj-code,
     1378                                  string(p-buf_shift-obj.shift-date, "99.99.9999"),  p-buf_shift-obj.shift-num  ) .
     1379     put unformatted "FuelShifts,"
     1380       v-shift-head ","
     1381       format_datetime(p-buf_shift-obj.open-date, p-buf_shift-obj.open-time) ","
     1382       format_datetime(p-buf_shift-obj.close-date, p-buf_shift-obj.close-time) skip
     1383     .
     1384     find first buf_rvs-doc no-lock where buf_rvs-doc.obj-type       = p-buf_shift-obj.obj-type
     1385                                      and buf_rvs-doc.obj-code       = p-buf_shift-obj.obj-code
     1386                                      and buf_rvs-doc.shift-date     = p-prev-shift-date
     1387                                      and buf_rvs-doc.shift-num      = p-prev-shift-num
     1388                                      and buf_rvs-doc.status_        = 'факт':U
     1389                                      and buf_rvs-doc.rvs-type       = 'смена':U
     1390                                          no-error .
     1391     if available buf_rvs-doc
     1392     then
     1393       for each buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1394                                       and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     1395                                       and buf_rvs-line.obj-code = buf_rvs-doc.obj-code :
     1396         find first buf_place no-lock where buf_place.pl-code = buf_rvs-line.pl-code no-error .
     1397         put unformatted "FuelTankReading,"
     1398           v-shift-head ","
     1399           (if available buf_place then buf_place.loc1 else "0") ","
     1400           string(buf_rvs-line.gds-code) ","
     1401           trim(string(buf_rvs-line.state-measure-qnty, ">>>>>>>>9.99")) skip
     1402         .
     1403         for each buf_rvs-line-pump no-lock where buf_rvs-line-pump.rvs-code     = buf_rvs-line.rvs-code
     1404                                              and buf_rvs-line-pump.obj-type     = buf_rvs-line.obj-type
     1405                                              and buf_rvs-line-pump.obj-code     = buf_rvs-line.obj-code
     1406                                              and buf_rvs-line-pump.pl-code      = buf_rvs-line.pl-code
     1407                                              and buf_rvs-line-pump.gds-code     = buf_rvs-line.gds-code :
     1408           put unformatted "FuelPumpReading,"
     1409             v-shift-head ","
     1410             string(buf_rvs-line-pump.pump-code) ","
     1411             string(buf_rvs-line.gds-code) ","
     1412             trim(string(buf_rvs-line.state-measure-qnty, ">>>>>>>>9.99")) ","
     1413             string(buf_rvs-line-pump.nozzle-code) ","
     1414             trim(string(buf_rvs-line-pump.state-el-cnt, ">>>>>>>>9.99")) ","
     1415             string(buf_rvs-doc.shift-date, "99.99.9999") skip
     1416           .
     1417         end.
     1418       end.
     1419     chk-doc_ :
     1420     for each buf_chk-doc no-lock where buf_chk-doc.obj-type = p-buf_shift-obj.obj-type
     1421                                    and buf_chk-doc.obj-code = p-buf_shift-obj.obj-code
     1422                                    and buf_chk-doc.shift-date = p-buf_shift-obj.shift-date
     1423                                    and buf_chk-doc.shift-num  = p-buf_shift-obj.shift-num
     1424                                    and (
     1425                                      (buf_chk-doc.chk-type = 1) or
     1426                                      (buf_chk-doc.chk-type = 6) or
     1427                                      (buf_chk-doc.chk-type = 17)
     1428                                        ) :
     1429       v-trn-stype = if buf_chk-doc.chk-type = 6 then "2" else "1" .
     1430       chk-gds_ :
     1431       for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code :
     1432         find first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code no-error.
     1433         if available buf_bar-code then do:
     1434           find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
     1435           if available buf_goods then do:
     1436   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1437     (
     1438        input buf_goods.artic
     1439     ,  input buf_goods.prod-type
     1440     ,  input buf_goods.prod-code
     1441     , output is-petrolium
     1442     , output is-pieces
     1443     ) .
     1444             if not is-petrolium
     1445             then next chk-gds_.
     1446           end.
     1447           else next chk-gds_.
     1448         end.
     1449         else next chk-gds_.
     1450         v-doc-qnty = if buf_chk-doc.chk-type = 6 then ( (-1) * buf_chk-gds.doc-qnty ) else buf_chk-gds.doc-qnty .
     1451         if buf_chk-gds.loc1 > ""  then v-loc1 = buf_chk-gds.loc1.
     1452         else do:
     1453                if buf_chk-gds.src-pl-code > 0 then v-pl-code = buf_chk-gds.src-pl-code.
     1454           else if buf_chk-gds.pl-code     > 0 then v-pl-code = buf_chk-gds.pl-code.
     1455           else do:
     1456             run findtank in this-procedure
     1457               (input buf_chk-doc.obj-type,
     1458                input buf_chk-doc.obj-code,
     1459                input buf_chk-gds.pump,
     1460                input buf_chk-gds.nozzle-code,
     1461                input buf_chk-gds.pl-code,
     1462                input buf_bar-code.gds-code,
     1463                output v-pl-code) no-error.
     1464           end.
     1465           if v-pl-code > 0 then do:
     1466             find first buf_place no-lock where buf_place.pl-code = v-pl-code no-error .
     1467             v-loc1 = if available buf_place then buf_place.loc1 else "0" .
     1468           end.
     1469           else v-loc1 = "0" .
     1470         end.
     1471         put unformatted "FuelTransaction,"
     1472           v-shift-head ","
     1473           format_datetime(buf_chk-doc.chk-date, buf_chk-doc.chk-time) ","
     1474           v-trn-stype ","
     1475           string(buf_goods.gds-code) ","
     1476           trim(string(v-doc-qnty, "->>>>>>9.99")) ","
     1477           string(buf_chk-gds.pump) ","
     1478           v-loc1 skip
     1479         .
     1480       end.
     1481     end.
     1482     trn-doc_ :
     1483     for each buf_trn-doc no-lock
     1484        where buf_trn-doc.obj-type     = p-buf_shift-obj.obj-type
     1485          and buf_trn-doc.obj-code     = p-buf_shift-obj.obj-code
     1486          and buf_trn-doc.shift-date   = p-buf_shift-obj.shift-date
     1487          and buf_trn-doc.shift-num    = p-buf_shift-obj.shift-num
     1488          and buf_trn-doc.status_      = 'факт':U
     1489          and can-do ("es,rs,vt":U,
     1490                      buf_trn-doc.ext-doc-type) = false :
     1491       def var v-value as character no-undo.
     1492       def var v-type  as character no-undo.
     1493       def var v-tech-pass as logical no-undo.
     1494   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1495                           input 'techpass':U ,
     1496                          output v-value ,
     1497                          output v-type ) no-error .
     1498       assign
     1499         v-tech-pass = yes when v-value = "yes".
     1500       if buf_trn-doc.ext-doc-type = 'we':U
     1501          and
     1502          (v-tech-pass or
     1503          (can-find (first buf_clients where buf_clients.obj-type = buf_trn-doc.cli-type
     1504                                        and buf_clients.obj-code = buf_trn-doc.cli-code) and
     1505          can-find (first buf_sale-doc where buf_sale-doc.doc-code = buf_trn-doc.doc-code
     1506                                         and buf_sale-doc.doc-kind = 'trf':U)))
     1507       then next trn-doc_ .
     1508       v-trn-stype = if can-do("при,возврат":U, buf_trn-doc.doc-type) then "2" else "1" .
     1509       doc-line_ :
     1510       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     1511   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1512     (
     1513        input buf_doc-line.artic
     1514     ,  input buf_doc-line.prod-type
     1515     ,  input buf_doc-line.prod-code
     1516     , output is-petrolium
     1517     , output is-pieces
     1518     ) .
     1519         if not is-petrolium then next doc-line_.
     1520         find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     1521                                        and buf_goods.prod-type  = buf_doc-line.prod-type
     1522                                        and buf_goods.prod-code  = buf_doc-line.prod-code
     1523                                            no-error .
     1524         if not available buf_goods then next doc-line_.
     1525         find first buf_doc-pl no-lock where buf_doc-pl.out-code = buf_trn-doc.doc-code
     1526                                         and buf_doc-pl.gds-code = buf_goods.gds-code
     1527                                         and buf_doc-pl.obj-type = buf_trn-doc.obj-type
     1528                                         and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     1529                                             no-error.
     1530         if available buf_doc-pl then do:
     1531           find first buf_place no-lock where buf_place.pl-code = buf_doc-pl.pl-code no-error .
     1532           v-loc1 = if available buf_place then buf_place.loc1 else "0" .
     1533         end.
     1534         else v-loc1 = "0".
     1535           put unformatted "FuelTransaction,"
     1536             v-shift-head ","
     1537             format_datetime(buf_trn-doc.sys-date, buf_trn-doc.sys-time-int) ","
     1538             v-trn-stype ","
     1539             string(buf_goods.gds-code) ","
     1540             trim(string(buf_doc-line.fact-qnty, "->>>>>>9.99")) ","
     1541             "0,"
     1542             v-loc1 skip
     1543           .
     1544       end.
     1545     end.
     1546   end procedure .
