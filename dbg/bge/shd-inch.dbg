      441         (input  p-code
      442         ,output p-section-num
      443         ) no-error .
      444       if error-status :error
      445       then do:
      446         undo, return error return-value .
      447       end.
      448     end.
      449   end procedure.
      450   define variable vss-include-info2 as character format "X(65)" no-undo
      451   initial "@(#)$Workfile$ $Revision$".
      452   DEF STREAM stmXMLOut.
      453   DEF STREAM stmXMLLog.
      454   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   procedure cur-time :
      456      define output parameter p-today as date      no-undo .
      457      define output parameter p-time  as integer   no-undo .
      458     do
      459     on error undo, return error
      460     :
      461       define variable v-date1 as date      no-undo .
      462       define variable v-date2 as date      no-undo .
      463       define variable v-time  as integer   no-undo .
      464       assign
      465         v-date1 = today
      466         v-time  = time
      467         v-date2 = today
      468       .
      469       if v-date1 <> v-date2
      470       then do:
      471         assign
      472           v-date1 = today
      473           v-time  = v-time
      474         .
      475       end.
      476       assign
      477         p-today = v-date1
      478         p-time  = v-time
      479       .
      480     end.
      481   end.
      482   function cur-time-date returns character
      483   :
      484     return string(today, '99/99/9999':U) .
      485   end.
      486   function cur-time-mjd returns decimal
      487   :
      488     define variable v-date as date      no-undo .
      489     define variable v-time as integer   no-undo .
      490     run cur-time in this-procedure
      491       (output v-date
      492       ,output v-time
      493       ) .
      494     return integer(v-date) - 2400002 + (v-time / 86400) .
      495   end.
      496   function cur-time-get-ending-index returns integer
      497   (input p-number as integer
      498   )
      499   :
      500     if p-number < 0
      501     or p-number = ?
      502     then do:
      503       return 1 .
      504     end.
      505     define variable v-rest as integer   no-undo .
      506     assign
      507       p-number = p-number modulo 100
      508     .
      509     if p-number < 20
      510     then do:
      511       assign
      512         v-rest = p-number
      513       .
      514     end.
      515     else do:
      516       assign
      517         v-rest = p-number modulo 10
      518       .
      519     end.
      520     case v-rest :
      521       when 1
      522       then do:
      523         return 2 .
      524       end.
      525       when 2 or
      526       when 3 or
      527       when 4
      528       then do:
      529         return 3 .
      530       end.
      531       otherwise do:
      532         return 1 .
      533       end.
      534     end case .
      535   end.
      536   procedure cur-time-mjd-to-date :
      537      define input  parameter i-mjd-diff as decimal no-undo.
      538      define output parameter o-Date     as date    no-undo.
      539      define output parameter o-Time     as integer no-undo.
      540      define variable v-day-number as integer   no-undo .
      541      if    i-mjd-diff < 0
      542         or i-mjd-diff = ?
      543      then do:
      544         return "?" .
      545      end.
      546      assign
      547         v-day-number = truncate(i-mjd-diff,0).
      548         o-Date = date(v-day-number + 2400002).
      549         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      550     .
      551   end.
      552   function cur-time-mjd-to-string returns character
      553   (input p-mjd-diff as decimal
      554   )
      555   :
      556     define variable v-day-number as integer   no-undo .
      557     define variable v-seconds    as integer   no-undo .
      558     define variable v-hour       as integer   no-undo .
      559     define variable v-min        as integer   no-undo .
      560     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      561     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      562     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      563     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      564     if p-mjd-diff < 0
      565     or p-mjd-diff = ?
      566     then do:
      567       return "?" .
      568     end.
      569     assign
      570       v-day-number = integer(truncate(p-mjd-diff,0))
      571       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      572     .
      573     if v-seconds > 86400
      574     then do:
      575       assign
      576         v-seconds = 86400 - 1
      577       .
      578     end.
      579     if v-seconds < 0
      580     then do:
      581       assign
      582         v-seconds = 0
      583       .
      584     end.
      585     assign
      586       v-hour = truncate(v-seconds / 3600, 0)
      587     .
      588     assign
      589       v-seconds = v-seconds modulo 3600
      590     .
      591     assign
      592       v-min = truncate(v-seconds / 60, 0)
      593     .
      594     assign
      595       v-seconds = v-seconds modulo 60
      596     .
      597     return
      598         (if v-day-number <> 0
      599           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      600           else ""
      601         )
      602       + (if v-day-number <> 0 or v-hour <> 0
      603           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      604           else ""
      605         )
      606       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      607           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      608           else ""
      609         )
      610       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      611       .
      612   end.
      613   function cur-time-string returns character
      614   :
      615     define variable v-date as date      no-undo .
      616     define variable v-time as integer   no-undo .
      617     run cur-time in this-procedure
      618       (output v-date
      619       ,output v-time
      620       ) .
      621     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      622   end.
      623   function cur-time-string-sec returns character
      624   :
      625     define variable v-date as date      no-undo .
      626     define variable v-time as integer   no-undo .
      627     run cur-time in this-procedure
      628       (output v-date
      629       ,output v-time
      630       ) .
      631     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      632   end.
      633   function cur-time-custom  returns character
      634   (input p-prefix as character
      635   ,input p-date-format as character
      636   ,input p-delimiter as character
      637   ,input p-time-format as character
      638   ,input p-suffix as character
      639   )
      640   :
      641     define variable v-date as date      no-undo .
      642     define variable v-time as integer   no-undo .
      643     run cur-time in this-procedure
      644       (output v-date
      645       ,output v-time
      646       ) .
      647     return
      648       p-prefix
      649       + string(v-date, p-date-format)
      650       + p-delimiter
      651       + string(v-time, p-time-format)
      652       + p-suffix
      653       .
      654   end.
      655   function cur-time-print  returns character
      656   :
      657     define variable v-date as date      no-undo .
      658     define variable v-time as integer   no-undo .
      659     run cur-time in this-procedure
      660       (output v-date
      661       ,output v-time
      662       ) .
      663     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      664   end.
      665   function cur-time-datetime returns datetime
      666   :
      667     define variable v-char as character no-undo .
      668     define variable v-datetime as datetime no-undo .
      669     v-char = cur-time-string().
      670     v-datetime = datetime(v-char).
      671     return  v-datetime.
      672   end.
      673   function cur-time-string-msec returns character
      674   :
      675     define variable v-date as datetime  no-undo .
      676     v-date = now.
      677     return string(v-date) .
      678   end.
