     3967   procedure get-start-date :
     3968   do
     3969   on error undo, return error
     3970   :
     3971   define input parameter p-obj-type       as character    no-undo.
     3972   define input parameter p-obj-code       as integer      no-undo.
     3973   define output parameter p-start-date    as date         no-undo.
     3974   define output parameter p-not-exist     as logical      no-undo.
     3975       define buffer buf_trn-doc       for ub.trn-doc.
     3976       define buffer buf_price-doc     for ub.price-doc.
     3977       define buffer buf_ot-tot        for ub.ot-tot.
     3978       find-first-ot-tot:
     3979       for each buf_ot-tot no-lock
     3980          where buf_ot-tot.obj-type = p-obj-type
     3981            and buf_ot-tot.obj-code = p-obj-code
     3982       :
     3983           find first buf_trn-doc no-lock
     3984                where buf_trn-doc.doc-code = buf_ot-tot.doc-code
     3985           no-error.
     3986           if available buf_trn-doc
     3987           and buf_trn-doc.fact-date <> ?
     3988           then do:
     3989               assign
     3990                   p-not-exist     = no
     3991                   p-start-date    = buf_trn-doc.fact-date
     3992               .
     3993               leave find-first-ot-tot.
     3994           end.
     3995           else do:
     3996               find first buf_price-doc no-lock
     3997                    where buf_price-doc.doc-num = buf_ot-tot.doc-code
     3998               no-error.
     3999               if available buf_price-doc
     4000               and buf_price-doc.fact-date <> ?
     4001               then do:
     4002                   assign
     4003                       p-not-exist     = no
     4004                       p-start-date    = buf_price-doc.fact-date
     4005                   .
     4006                   leave find-first-ot-tot.
     4007               end.
     4008           end.
     4009       end.
     4010   end.
     4011   end procedure.
     4012   procedure cb-fill_bge-xml_goods :
     4013   define input parameter p-gds-code   as integer          no-undo.
     4014   do
     4015   on error undo, return error
     4016   :
     4017       find first temp_bge-xml_goods
     4018            where temp_bge-xml_goods.gds-code = p-gds-code
     4019       no-error.
     4020       if not available temp_bge-xml_goods
     4021       then do:
     4022           create temp_bge-xml_goods.
     4023           assign
     4024               temp_bge-xml_goods.gds-code = p-gds-code
     4025           .
     4026       end.
     4027   end.
     4028   end procedure.
     4029   procedure cb-fill_bge-xml_clients :
     4030   define input parameter p-obj-type   as character        no-undo.
     4031   define input parameter p-obj-code   as integer          no-undo.
     4032       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     4033   do
     4034   for buf_temp_bge-xml_clients
     4035   on error undo, return error
     4036   :
     4037       find first buf_temp_bge-xml_clients
     4038            where buf_temp_bge-xml_clients.obj-type = p-obj-type
     4039              and buf_temp_bge-xml_clients.obj-code = p-obj-code
     4040       no-error.
     4041       if not available buf_temp_bge-xml_clients
     4042       then do:
     4043           create buf_temp_bge-xml_clients.
     4044           assign
     4045               buf_temp_bge-xml_clients.obj-type = p-obj-type
     4046               buf_temp_bge-xml_clients.obj-code = p-obj-code
     4047           .
     4048       end.
     4049   end.
     4050   end procedure.
     4051   procedure fill-clntattr :
     4052   define input parameter p-cur-date   as date             no-undo.
     4053       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     4054   do
     4055   for buf_temp_bge-xml_clients
     4056   on error undo, return error
     4057   :
     4058       for each buf_temp_bge-xml_clients no-lock
     4059       on error undo, return error
     4060       :
     4061         if not (buf_temp_bge-xml_clients.obj-type = 'маг':U
     4062                 or
     4063                 buf_temp_bge-xml_clients.obj-type <> 'скл':U) then do:
     4064           run clntattr-write in this-procedure (
     4065                 input buf_temp_bge-xml_clients.obj-type
     4066               , input buf_temp_bge-xml_clients.obj-code
     4067               , input 'bge-incr-last-shift-date':U
     4068               , input v-last-shift-date
     4069           ).
     4070           run clntattr-write in this-procedure (
     4071                 input buf_temp_bge-xml_clients.obj-type
     4072               , input buf_temp_bge-xml_clients.obj-code
     4073               , input 'bge-incr-last-shift-num':U
     4074               , input v-last-shift-num
     4075           ).
     4076         end.
     4077       end.
     4078   end.
     4079   end procedure.
