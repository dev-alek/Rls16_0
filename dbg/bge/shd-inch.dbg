     3148           where buf_shift-obj.obj-type   = p-obj-type
     3149             and buf_shift-obj.obj-code   = p-obj-code
     3150             and buf_shift-obj.shift-date > p-fact-date
     3151           use-index pi
     3152           no-error .
     3153         if not available buf_shift-obj
     3154         or buf_shift-obj.status_ <> 'зкр':U
