     3138     ,output v-shift-on
     3139     ) no-error .
     3140       if error-status :error
     3141       then do:
     3142         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     3143         undo, return error v-error .
