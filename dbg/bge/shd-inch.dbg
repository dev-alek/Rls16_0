     3165               v-extra-message =
     3166                     substitute("Дата начала последеней закрытой смены на объекте &1"
     3167                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     3168                               )
     3169             .
     3170           end.
     3171           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     3172           undo, return error v-error .
