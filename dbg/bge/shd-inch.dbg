      681   procedure xmlchar-test :
      682   define input parameter p-in-string          as character        no-undo.
      683   define output parameter p-out-string-enc    as character        no-undo.
      684   define output parameter p-out-string-dec    as character        no-undo.
      685   do
      686   on error undo, return error
      687   :
      688          run xmlchar-encode in this-procedure
      689       (
      690             input p-in-string
      691           , output p-out-string-enc
      692       ).
      693          run xmlchar-decode in this-procedure
      694       (
      695             input p-out-string-enc
      696           , output p-out-string-dec
      697       ).
      698   end.
      699   end .
      700   procedure xmlchar-encode :
      701   define input parameter p-in-string      as character        no-undo.
      702   define output parameter p-out-string    as character        no-undo.
      703       define variable v-position      as integer      no-undo.
      704       define variable v-current-char  as character    no-undo.
      705   do
      706   on error undo, return error
      707   :
      708       assign
      709           p-out-string = "":U
      710       .
      711       case p-in-string
      712       :
      713           when ?
      714           then do:
      715               assign
      716                   p-out-string = "?":U
      717               .
      718           end.
      719           when "?":U
      720           then do:
      721               assign
      722                   p-out-string = "&#63;":U
      723               .
      724           end.
      725           otherwise do:
      726               do v-position = 1 to length( p-in-string )
      727               :
      728                   assign
      729                       v-current-char = substring( p-in-string, v-position, 1 )
      730                   .
      731                   case v-current-char
      732                   :
      733                       when "&":U
      734                       then do:
      735                           assign
      736                               p-out-string = p-out-string + "&amp;":U
      737                           .
      738                       end.
      739                       when ">":U
      740                       then do:
      741                           assign
      742                               p-out-string = p-out-string + "&gt;":U
      743                           .
      744                       end.
      745                       when "<":U
      746                       then do:
      747                           assign
      748                               p-out-string = p-out-string + "&lt;":U
      749                           .
      750                       end.
      751                       when "'":U
      752                       then do:
      753                           assign
      754                               p-out-string = p-out-string + "&apos;":U
      755                           .
      756                       end.
      757                       when '"':U
      758                       then do:
      759                           assign
      760                               p-out-string = p-out-string + "&quot;":U
      761                           .
      762                       end.
      763                       when chr(1)
      764                       then do:
      765                           assign
      766                               p-out-string = p-out-string + "":U
      767                           .
      768                       end.
      769                       when chr(2)
      770                       then do:
      771                           assign
      772                               p-out-string = p-out-string + "":U
      773                           .
      774                       end.
      775                       when chr(3)
      776                       then do:
      777                           assign
      778                               p-out-string = p-out-string + "":U
      779                           .
      780                       end.
      781                       when chr(4)
      782                       then do:
      783                           assign
      784                               p-out-string = p-out-string + "":U
      785                           .
      786                       end.
      787                       when chr(5)
      788                       then do:
      789                           assign
      790                               p-out-string = p-out-string + "":U
      791                           .
      792                       end.
      793                       when chr(6)
      794                       then do:
      795                           assign
      796                               p-out-string = p-out-string + "":U
      797                           .
      798                       end.
      799                       when chr(7)
      800                       then do:
      801                           assign
      802                               p-out-string = p-out-string + "":U
      803                           .
      804                       end.
      805                       when chr(8)
      806                       then do:
      807                           assign
      808                               p-out-string = p-out-string + "":U
      809                           .
      810                       end.
      811                       when chr(9)
      812                       then do:
      813                           assign
      814                               p-out-string = p-out-string + "":U
      815                           .
      816                       end.
      817                       when chr(29)
      818                       then do:
      819                           assign
      820                               p-out-string = p-out-string + "":U
      821                           .
      822                       end.
      823                       when chr(10)
      824                       then do:
      825                           assign
      826                               p-out-string = p-out-string + "&#10;":U
      827                           .
      828                       end.
      829                       when chr(13)
      830                       then do:
      831                           assign
      832                               p-out-string = p-out-string + "&#13;":U
      833                           .
      834                       end.
      835                       otherwise do:
      836                           assign
      837                               p-out-string = p-out-string + v-current-char
      838                           .
      839                       end.
      840                   end case.
      841               end.
      842           end.
      843       end case.
      844   end.
      845   end .
