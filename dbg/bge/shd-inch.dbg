     1352   .
     1353   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1354                                             INPUT iFlagEmpty AS INTEGER).
     1355       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1356       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1357           DO:
     1358               IF iFlagEmpty = 0                           THEN RETURN "".
     1359               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1360               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1361               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1362               ELSE RETURN "".
     1363           END.
     1364       ELSE DO:
     1365           run xmlchar-encode in this-procedure (
     1366                 input sToPlace
     1367               , output sToPlace
     1368           ).
     1369           ASSIGN
     1370               sToPlace = sParName + '="' + sToPlace + '"'
     1371           .
     1372           RETURN sToPlace.
     1373       END.
     1374   END FUNCTION.
     1375   function bge-xml-date returns character
     1376   ( input p-date as date )
     1377   :
     1378     define variable v-date-str as character no-undo .
     1379     run bge-xml-date-to-str in this-procedure ( input   p-date
     1380                                               , output  v-date-str
     1381                                               ) .
     1382     return v-date-str.
     1383   end function.
     1384   function bge-xml-str-date returns character
     1385   ( input p-date-str as character )
     1386   :
     1387     define variable v-date-str as character no-undo .
     1388     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1389                                                   , output  v-date-str
     1390                                                   ) .
     1391     return v-date-str.
     1392   end function.
     1393   function bge-xml-normalize-dec returns decimal
     1394   ( input p-val as decimal )
     1395   :
     1396     return (if p-val = ? then 0 else p-val) .
     1397   end function.
     1398   PROCEDURE wp-XMLTagOpen:
     1399   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1400   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1401   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1402       define variable v-out-string    as character    no-undo.
     1403   do
     1404   on error undo, return error
     1405   :
     1406       if v-bge-xml-bgefmt = "dbf":U
     1407       then do:
     1408       end.
     1409       else do:
     1410           assign
     1411               v-out-string = substitute( "&1&2<&3&4>"
     1412                                       , chr(10)
     1413                                       , fill( " ":U, 4 * iTagLevel)
     1414                                       , sTagName
     1415                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1416                               )
     1417           .
     1418           put stream stmXMLOut unformatted
     1419               v-out-string
     1420           .
     1421       end.
     1422   end.
     1423   END PROCEDURE.
     1424   PROCEDURE wp-XMLTagPut:
     1425     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1426     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1427     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1428     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1429       define variable v-out-string    as character    no-undo.
     1430   do
     1431   on error undo, return error
     1432   :
     1433       if v-bge-xml-bgefmt = "dbf":U
     1434       then do:
     1435           if v-bge-xml-dbf-file-name <> "":U
     1436           then do:
     1437               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1438               export stream stmXMLOut
     1439                   sTagName
     1440                   sParValue
     1441               .
     1442               output stream stmXMLOut close.
     1443           end.
     1444       end.
     1445       else do:
     1446           IF  iFlagEmpty = 1
     1447           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1448           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1449           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1450           THEN DO:
     1451               run xmlchar-encode in this-procedure (
     1452                   input sParValue
     1453                   , output sParValue
     1454               ).
     1455               assign
     1456                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1457                                               , chr(10)
     1458                                               , FILL(" ", 4 * iTagLevel)
     1459                                               , sTagName
     1460                                               , sParValue
     1461                               )
     1462               .
     1463               PUT STREAM stmXMLOut UNFORMATTED
     1464                   v-out-string
     1465               .
     1466           END.
     1467       end.
     1468   end.
     1469   END PROCEDURE.
     1470   PROCEDURE wp-XMLTagClose:
     1471   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1472   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1473       define variable v-out-string    as character    no-undo.
     1474   do
     1475   on error undo, return error
     1476   :
     1477       if v-bge-xml-bgefmt = "dbf":U
     1478       then do:
     1479       end.
     1480       else do:
     1481           assign
     1482               v-out-string = substitute( "&1&2</&3>"
     1483                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1484                                   , fill( " ", 4 * iTagLevel )
     1485                                   , sTagName
     1486                           )
     1487           .
     1488           PUT STREAM stmXMLOut UNFORMATTED
     1489               v-out-string
     1490           .
     1491       end.
     1492   end.
     1493   END PROCEDURE.
     1494   PROCEDURE wp-XMLWriteLog:
     1495     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1496     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1497     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1498   define variable v-str              as character no-undo .
     1499   define variable v-error-append     as logical   no-undo .
     1500   define variable v-error-append-msg as character no-undo .
     1501   assign
     1502     v-str = chr(10)
     1503             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1504             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1505     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1506     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1507     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1508   .
     1509   run bge/bge-log.p (input v-str) no-error .
     1510   if error-status:error then do:
     1511     assign
     1512       v-error-append     = yes
     1513       v-error-append-msg = return-value
     1514     .
     1515   end.
     1516   run gbl/fileapnd.p
     1517     ( input sFileName
     1518     , input v-str
     1519     , input 10
     1520     ) no-error .
     1521   if error-status:error then do:
     1522     assign
     1523       v-error-append     = yes
     1524       v-error-append-msg = substitute( "&1&2&3"
     1525                                       , v-error-append-msg
     1526                                       , chr(10)
     1527                                       , return-value
     1528                                       )
     1529     .
     1530   end.
     1531   if v-error-append
     1532   then do:
     1533     return error substitute( "&1" , v-error-append-msg ) .
     1534   end.
     1535   END PROCEDURE.
     1536   PROCEDURE wp-XMLWriteEDT:
     1537     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1538     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1539     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1540       if valid-handle ( hEDT )
     1541       then do:
     1542           hEDT :move-to-eof().
     1543           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1544                                           OR sToWrite = "&Line") THEN "" ELSE
     1545                                           cur-time-string-sec() + " ").
     1546           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1547                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1548                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1549           hEDT :insert-string(chr(10)).
     1550       end.
     1551       process events.
     1552       output to 'bgescn.txt' append.
     1553           put unformatted
     1554               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1555                                           OR sToWrite = "&Line") THEN "" ELSE
     1556                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1557               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1558                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1559                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1560           .
     1561       output close.
     1562   END PROCEDURE.
     1563   PROCEDURE wp-XMLShowCNT:
     1564     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1565       if valid-handle( hCNT )
     1566       then do:
     1567           ASSIGN hCNT :VISIBLE = TRUE.
     1568       end.
     1569   END PROCEDURE.
     1570   PROCEDURE wp-XMLHideCNT:
     1571     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1572       if valid-handle( hCNT )
     1573       then do:
     1574           ASSIGN hCNT :VISIBLE = FALSE.
     1575       end.
     1576   END PROCEDURE.
     1577   PROCEDURE wp-XMLWriteCNT:
     1578     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1579     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1580       if valid-handle( hCNT )
     1581       then do:
     1582           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1583       end.
     1584   END PROCEDURE.
     1585   procedure bge-xml-write-header:
     1586   do
     1587   on error undo, return error
     1588   :
     1589   define input parameter p-xml-file-name  as character        no-undo.
     1590   define input parameter p-doc-name       as character        no-undo.
     1591   define input parameter p-version        as character        no-undo.
     1592   define input parameter p-db-num         as integer          no-undo.
     1593   define input parameter p-date-from      as date             no-undo.
     1594   define input parameter p-shift-num-from as integer          no-undo.
     1595   define input parameter p-date-to        as date             no-undo.
     1596   define input parameter p-shift-num-to   as integer          no-undo.
     1597   define input parameter p-obj-list       as character        no-undo.
     1598   define input parameter p-doc-type-list  as character        no-undo.
     1599   define input parameter p-pay-code       as logical          no-undo.
     1600   define input parameter p-cst            as logical          no-undo.
     1601   define input parameter p-parts          as logical          no-undo.
     1602   define input parameter p-chk-pay-code   as logical          no-undo.
     1603   define input parameter p-pay-desk       as logical          no-undo.
     1604   define input parameter p-pay-desk-cards as logical          no-undo.
     1605   define input parameter p-deleted        as logical          no-undo.
     1606   define input parameter p-opened-docs    as logical          no-undo.
     1607   define variable v-out-string    as character    no-undo.
     1608   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1609   assign
     1610       v-out-string = substitute( "&1&2&3"
     1611                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1612                           , chr(10)
     1613                           , "<IBS_Trade_House>":U )
     1614   .
     1615   put stream stmXMLOut unformatted
     1616       v-out-string
     1617   .
     1618   run wp-XMLTagOpen(1, "header","").
     1619   if v-bge-xml-bgeflold = "oracle":u
     1620   then do:
     1621     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1622     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1623     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1624     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1625     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1626   end.
     1627   run wp-XMLTagOpen( 2, "manifest", "").
     1628   run wp-XMLTagOpen( 3, "document", "").
     1629   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1630   run wp-XMLTagput( 4, "description", "", 0).
     1631   run wp-XMLTagput( 4, "version", p-version, 0).
     1632   run wp-XMLTagclose( 3, "document" ).
     1633   run wp-XMLTagclose( 2, "manifest" ).
     1634   run wp-XMLTagclose( 1, "header" ).
     1635   run wp-XMLTagOpen(1, "options","").
     1636   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1637   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1638   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1639   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1640   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1641   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1642   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1643   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1644   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1645   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1646   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1647   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1648   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1649   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1650   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1651   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1652   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1653   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1654   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1655   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1656   run wp-XMLTagClose(1, "options").
     1657   run wp-XMLTagOpen( 1, "body", "" ).
     1658   output stream stmXMLOut close.
     1659   end.
     1660   end procedure.
     1661   procedure xml-bge-write-footer:
     1662   do
     1663   on error undo, return error return-value
     1664   :
     1665   define input parameter p-xml-file-name as character    no-undo.
     1666   define variable v-error-num     as integer           no-undo.
     1667   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1668   run wp-XMLTagClose( 1, "body" ).
     1669   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1670   output stream stmXMLOut close.
     1671   if v-bge-xml-bgeflold = "oracle":u
     1672   then do:
     1673     define variable v-tmp-file-name         as character no-undo .
     1674     define variable v-zip-file-name         as character no-undo .
     1675     define variable v-exch-file-name        as character no-undo .
     1676     define variable v-heap-file-name        as character no-undo .
     1677     define variable v-i                     as integer   no-undo .
     1678     define variable v-file-name             as character no-undo .
     1679     define variable v-arc                   as character no-undo .
     1680     define variable v-str                   as character no-undo .
     1681     define variable v-exch-tmp-file-name    as character no-undo .
     1682     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1683     define variable v-bge-xml-exch-dir      as character no-undo .
     1684     define variable v-bge-xml-heap-dir      as character no-undo .
     1685     define variable v-bge-xml-compress-heap as logical   no-undo .
     1686     define variable v-home-dir              as character no-undo .
     1687     define variable v-os-command            as character no-undo .
     1688     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1689     if v-home-dir = ?
     1690     then do:
     1691       undo, return error substitute( "&1&2&3"
     1692                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1693                                     , chr(10)
     1694                                     , "Обратитесь к администратору.":u
     1695                                     ).
     1696     end.
     1697     assign
     1698       v-home-dir = v-home-dir
     1699     .
     1700     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1701     if error-status :error
     1702     then do:
     1703       undo, return error substitute( "&1&2&3"
     1704                                     , "Неверно задан каталог экспорта.":u
     1705                                     , chr(10)
     1706                                     , "Обратитесь к администратору.":u
     1707                                     ).
     1708     end.
     1709     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1710     if v-bge-xml-exch-dir = ?
     1711     then do:
     1712       undo, return error substitute( "&1&2&3"
     1713                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1714                                     , chr(10)
     1715                                     , "Обратитесь к администратору.":u
     1716                                     ).
     1717     end.
     1718     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1719     if error-status :error
     1720     then do:
     1721       undo, return error substitute( "&1&2&3"
     1722                                     , "Неверно задан каталог экспорта (exch).":u
     1723                                     , chr(10)
     1724                                     , "Обратитесь к администратору.":u
     1725                                     ).
     1726     end.
     1727     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1728     if v-bge-xml-heap-dir = ?
     1729     then do:
     1730       undo, return error substitute( "&1&2&3"
     1731                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1732                                     , chr(10)
     1733                                     , "Обратитесь к администратору.":u
     1734                                     ).
     1735     end.
     1736     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1737     if error-status :error
     1738     then do:
     1739       undo, return error substitute( "&1&2&3"
     1740                                     , "Неверно задан каталог экспорта (heap).":u
     1741                                     , chr(10)
     1742                                     , "Обратитесь к администратору.":u
     1743                                     ).
     1744     end.
     1745     get-key-value section "BGE" key "heap-compress" value v-str.
     1746     assign
     1747       v-i = int(v-str)
     1748     no-error .
     1749     if v-i = ? or v-i = 0
     1750     then do:
     1751       assign
     1752         v-bge-xml-compress-heap = no
     1753       .
     1754     end.
     1755     else do:
     1756       assign
     1757         v-bge-xml-compress-heap = yes
     1758       .
     1759     end.
     1760     assign
     1761       v-arc = search( "exe/7za.exe":u )
     1762     .
     1763     if v-arc = ? or v-arc = ""
     1764     then do:
     1765       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1766     end.
     1767     assign
     1768       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1769       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1770       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1771       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1772       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1773       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1774       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1775     .
     1776     run gbl/del-file.p (input v-tmp-file-name) .
     1777     run gbl/del-file.p (input v-zip-file-name) .
     1778     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1779     if v-error-num > 0
     1780     then do:
     1781         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1782                                      , p-xml-file-name + "xm1":u
     1783                                      , v-tmp-file-name
     1784                                      , v-error-num
     1785                                      ).
     1786     end.
     1787     assign
     1788       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1789                                    , v-arc
     1790                                    , v-zip-file-name
     1791                                    , v-tmp-file-name
     1792                                    )
     1793     .
     1794     os-command silent value ( v-os-command ) .
     1795     run gbl/del-file.p (input v-heap-file-name) .
     1796     if v-bge-xml-compress-heap = no
     1797     then do:
     1798       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1799       if v-error-num > 0
     1800       then do:
     1801           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1802                                        , v-tmp-file-name
     1803                                        , v-heap-file-name
     1804                                        , v-error-num
     1805                                        ) .
     1806       end.
     1807     end.
     1808     else do:
     1809       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1810       if v-error-num > 0
     1811       then do:
     1812           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1813                                        , v-zip-file-name
     1814                                        , v-heap-file-name
     1815                                        , v-error-num
     1816                                        ) .
     1817       end.
     1818     end.
     1819     run gbl/del-file.p (input v-tmp-file-name) .
     1820     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1821     if error-status :error then do:
     1822       undo, return error substitute( "&1&2&3"
     1823                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1824                                     , chr(10)
     1825                                     , "Обратитесь к администратору."
     1826                                     ).
     1827     end.
     1828     run gbl/del-file.p (input v-exch-file-name) .
     1829     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1830     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1831     if v-error-num > 0
     1832     then do:
     1833       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1834                                     , v-zip-file-name
     1835                                     , v-exch-tmp-file-name
     1836                                     , v-error-num
     1837                                     ) .
     1838     end.
     1839     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1840     if v-error-num > 0
     1841     then do:
     1842       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1843                                     , v-exch-tmp-file-name
     1844                                     , v-exch-file-name
     1845                                     , v-error-num
     1846                                     ) .
     1847     end.
     1848     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1849   end.
     1850   else do:
     1851     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1852     if v-error-num > 0
     1853     then do:
     1854       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1855                                     , p-xml-file-name + "xm1"
     1856                                     , p-xml-file-name + "xml"
     1857                                     , v-error-num
     1858                                     ) .
     1859     end.
     1860   end.
     1861   if opsys = "unix"
     1862   then do:
     1863       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1864   end.
     1865   end.
     1866   end procedure.
     1867   procedure xml-bge-filename0:
     1868   define input parameter p-prefix   as character no-undo .
     1869   define input parameter p-name     as character no-undo .
     1870   define input parameter p-shared-process as logical no-undo .
     1871   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1872   define output parameter p-xml-file-name  as character no-undo .
     1873   // define output parameter p-fullfnamenoext as character no-undo .
     1874   define output parameter p-locked         as logical      no-undo.
     1875   define variable v-fullfnamenoext as character no-undo .
     1876   define variable v-fileext        as character no-undo .
     1877   define variable v-fullfname      as character no-undo .
     1878   define variable v-error-num      as integer   no-undo .
     1879   do
     1880   on error undo, return error
     1881   :
     1882     case v-bge-xml-bgeflold :
     1883       when "old" then do:
     1884         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1885         v-fileext       = ".xml":U .
     1886         v-fullfname     = v-fullfnamenoext + v-fileext .
     1887         p-xml-file-name = v-fullfname .
     1888         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1889         if v-error-num > 0 then do:
     1890           return error.
     1891         end.
     1892       end.
     1893       when "var" then do:
     1894         case p-prefix :
     1895           when "doc" then do:
     1896             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1897             v-fileext       = ".xml":U .
     1898             v-fullfname     = v-fullfnamenoext + v-fileext .
     1899             p-xml-file-name = v-fullfname .
     1900           end.
     1901           when "day" then do:
     1902             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1903             v-fileext       = ".xml":U .
     1904             v-fullfname     = v-fullfnamenoext + v-fileext .
     1905             p-xml-file-name = v-fullfname .
     1906           end.
     1907           otherwise do:
     1908             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1909             v-fileext       = ".xml":U .
     1910             v-fullfname     = v-fullfnamenoext + v-fileext .
     1911             p-xml-file-name = v-fullfname .
     1912           end.
     1913         end case.
     1914         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1915         if v-error-num > 0 then do:
     1916           return error.
     1917         end.
     1918       end.
     1919       when "new" then do:
     1920                   run bge/genfname.p (
     1921                       input p-home-dir
     1922                       , input p-prefix
     1923                       , input ""
     1924                       , input "xml"
     1925                       , input ""
     1926                       , output p-xml-file-name
     1927                   ).
     1928       end.
     1929       when "no-parameter" then do:
     1930         if p-shared-process then do:
     1931                       run bge/genfname.p (
     1932                           input p-home-dir
     1933                           , input "d"
     1934                           , input ""
     1935                           , input "xml"
     1936                           , input ""
     1937                           , output p-xml-file-name
     1938                       ).
     1939         end.
     1940         else do:
     1941           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1942           v-fileext       = ".xml":U .
     1943           v-fullfname     = v-fullfnamenoext + v-fileext .
     1944           p-xml-file-name = v-fullfname .
     1945           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1946           if v-error-num > 0 then do:
     1947             return error.
     1948           end.
     1949         end.
     1950       end.
     1951     end case.
     1952     assign
     1953       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1954       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1955     .
     1956   end .
     1957   end procedure .
     1958   procedure xml-bge-filename :
     1959   do
     1960   on error undo, return error
     1961   :
     1962   define input parameter p-prefix             as character    no-undo.
     1963   define input parameter p-name               as character    no-undo.
     1964   define input parameter p-shared-process     as logical      no-undo.
     1965   define output parameter p-xml-file-name     as character    no-undo.
     1966   define output parameter p-log-file-name     as character    no-undo.
     1967   define output parameter p-locked            as logical      no-undo.
     1968   define variable v-home-dir          as character no-undo .
     1969   define variable v-error-num         as integer   no-undo .
     1970   define variable v-bge-xml-heap-dir  as character no-undo .
     1971       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1972       if v-home-dir = ?
     1973       then do:
     1974           message
     1975             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1976             skip(1)
     1977             skip "Обратитесь к администратору."
     1978           view-as alert-box error.
     1979           undo, return error .
     1980       end.
     1981       if v-bge-xml-bgeflold <> "oracle"
     1982       then do:
     1983         assign
     1984             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1985         .
     1986       end.
     1987       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1988       if error-status :error
     1989       then do:
     1990           message
     1991             skip "Неверно задан каталог экспорта."
     1992             skip(1)
     1993             skip "Обратитесь к администратору."
     1994           view-as alert-box error.
     1995           undo, return error .
     1996       end.
     1997       if v-bge-xml-bgefmt = "dbf":U
     1998       then do:
     1999           assign
     2000               p-xml-file-name = v-home-dir
     2001               p-locked        = no
     2002           .
     2003       end.
     2004       else do:
     2005           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     2006             output p-xml-file-name, output p-locked) .
     2007       end.
     2008       if v-bge-xml-bgeflold = "oracle"
     2009       then do:
     2010         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2011         if v-bge-xml-heap-dir = ?
     2012         then do:
     2013           undo, return error substitute( "&1&2&3"
     2014                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2015                                         , chr(10)
     2016                                         , "Обратитесь к администратору.":u
     2017                                         ).
     2018         end.
     2019         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2020         if error-status :error
     2021         then do:
     2022           undo, return error substitute( "&1&2&3"
     2023                                         , "Неверно задан каталог экспорта (heap).":u
     2024                                         , chr(10)
     2025                                         , "Обратитесь к администратору.":u
     2026                                         ).
     2027         end.
     2028         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     2029           assign
     2030             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     2031           .
     2032         end.
     2033         else do:
     2034           assign
     2035             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     2036           .
     2037         end.
     2038       end.
     2039       else do:
     2040         assign
     2041             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     2042         .
     2043       end.
     2044       assign
     2045          v-bge-xml-static-log-file-name = p-log-file-name
     2046       .
     2047   end.
     2048   end procedure.
     2049   procedure bge-xml-read-config :
     2050   do
     2051   on error undo, return error return-value
     2052   :
     2053   define input  parameter p-last-date as date      no-undo .
     2054   define input  parameter p-db-num    as integer   no-undo .
     2055       define variable v-bgeclall      as character     no-undo.
     2056       define variable v-bgedict       as character     no-undo.
     2057       define variable v-bgeshift      as character     no-undo.
     2058       define variable v-par-type      as character     no-undo.
     2059       define variable v-bgeflnm       as character     no-undo.
     2060       define variable v-bgecliiv      as character     no-undo .
     2061       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     2062       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     2063       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     2064       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     2065       define variable v-db-num-str    as character     no-undo .
     2066       define variable v-param-type      as character  no-undo .
     2067       define variable v-value-character as character  no-undo .
     2068       define variable v-value-date      as date       no-undo .
     2069       define variable v-value-decimal   as decimal    no-undo .
     2070       define variable v-value-integer   as integer    no-undo .
     2071       define variable v-value-logical   as logical    no-undo .
     2072       define variable v-tth             as handle      no-undo .
     2073       run adm/shattri.p ( input "get":U
     2074                         , input  '':u
     2075                         , input  0
     2076                         , input  'bge-export':U
     2077                         , input  'bgeclall':U
     2078                         , output v-bgecliiv
     2079                         , output v-value-date
     2080                         , output v-value-decimal
     2081                         , output v-value-integer
     2082                         , output v-value-logical
     2083                         , output v-param-type
     2084                         , input-output table-handle v-tth
     2085                         ) no-error .
     2086       if error-status :error
     2087       then do:
     2088         assign
     2089           v-bge-xml-bgecliiv = no
     2090         .
     2091       end.
     2092       else do:
     2093         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     2094       end.
     2095       delete object v-tth.
     2096       assign
     2097           v-bge-xml-bgeclall = no
     2098           v-bge-xml-bgedict  = no
     2099       .
     2100       run adm/shattri.p ( input "get":U
     2101                         , input  '':u
     2102                         , input  0
     2103                         , input  'bge-export':U
     2104                         , input  'bgeclall':U
     2105                         , output v-value-character
     2106                         , output v-value-date
     2107                         , output v-value-decimal
     2108                         , output v-value-integer
     2109                         , output v-value-logical
     2110                         , output v-param-type
     2111                         , input-output table-handle v-tth
     2112                         ) no-error .
     2113       if error-status :error
     2114       then do:
     2115         assign
     2116           v-bge-xml-bgeclall = no
     2117         .
     2118       end.
     2119       else do:
     2120         assign
     2121           v-bge-xml-bgeclall = v-value-logical
     2122         .
     2123       end.
     2124       delete object v-tth.
     2125       run adm/shattri.p ( input "get":U
     2126                         , input  '':u
     2127                         , input  0
     2128                         , input  'bge-export':U
     2129                         , input  'bgedict':U
     2130                         , output v-value-character
     2131                         , output v-value-date
     2132                         , output v-value-decimal
     2133                         , output v-value-integer
     2134                         , output v-value-logical
     2135                         , output v-param-type
     2136                         , input-output table-handle v-tth
     2137                         ) no-error .
     2138       if error-status :error
     2139       then do:
     2140         assign
     2141           v-bge-xml-bgedict = no
     2142         .
     2143       end.
     2144       else do:
     2145         assign
     2146           v-bge-xml-bgedict = v-value-logical
     2147         .
     2148       end.
     2149       delete object v-tth.
     2150       run adm/shattri.p ( input "get":U
     2151                         , input  '':u
     2152                         , input  0
     2153                         , input  'bge-export':U
     2154                         , input  'bgefmt':U
     2155                         , output v-value-character
     2156                         , output v-value-date
     2157                         , output v-value-decimal
     2158                         , output v-value-integer
     2159                         , output v-value-logical
     2160                         , output v-param-type
     2161                         , input-output table-handle v-tth
     2162                         ) no-error .
     2163       if error-status :error
     2164       then do:
     2165         assign
     2166           v-bge-xml-bgefmt  = "xml":U
     2167         .
     2168       end.
     2169       else do:
     2170         assign
     2171           v-bge-xml-bgefmt  = v-value-character
     2172         .
     2173       end.
     2174       delete object v-tth.
     2175       run adm/shattri.p ( input "get":U
     2176                         , input  '':u
     2177                         , input  0
     2178                         , input  'bge-export':U
     2179                         , input  'bgeshift':U
     2180                         , output v-value-character
     2181                         , output v-value-date
     2182                         , output v-value-decimal
     2183                         , output v-value-integer
     2184                         , output v-value-logical
     2185                         , output v-param-type
     2186                         , input-output table-handle v-tth
     2187                         ) no-error .
     2188       if error-status :error
     2189       then do:
     2190         assign
     2191             v-bge-xml-shift-mode = no
     2192         .
     2193       end.
     2194       else do:
     2195         assign
     2196             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2197         .
     2198       end.
     2199       delete object v-tth.
     2200       run adm/shattri.p ( input "get":U
     2201                         , input  '':u
     2202                         , input  0
     2203                         , input  'bge-export':U
     2204                         , input  'bgeflold':U
     2205                         , output v-value-character
     2206                         , output v-value-date
     2207                         , output v-value-decimal
     2208                         , output v-value-integer
     2209                         , output v-value-logical
     2210                         , output v-param-type
     2211                         , input-output table-handle v-tth
     2212                         ) no-error .
     2213       if error-status :error
     2214       then do:
     2215         assign
     2216           v-bge-xml-bgeflold = "no-parameter":U
     2217         .
     2218       end.
     2219       else do:
     2220         assign
     2221           v-bge-xml-bgeflold  = v-value-character
     2222         .
     2223       end.
     2224       delete object v-tth.
     2225       assign
     2226         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2227         v-bge-xml-db-num-str  = v-db-num-str
     2228       .
     2229       if p-last-date <> ?
     2230       then do:
     2231           run adm/shattri.p ( input "get":U
     2232                             , input  '':u
     2233                             , input  0
     2234                             , input  'bge-export':U
     2235                             , input  'bgeflnm':U
     2236                             , output v-value-character
     2237                             , output v-value-date
     2238                             , output v-value-decimal
     2239                             , output v-value-integer
     2240                             , output v-value-logical
     2241                             , output v-param-type
     2242                             , input-output table-handle v-tth
     2243                             ) no-error .
     2244           if error-status :error
     2245           then do:
     2246             assign
     2247               v-bgeflnm = '':U
     2248             .
     2249           end.
     2250           else do:
     2251             assign
     2252               v-bgeflnm = v-value-character
     2253             .
     2254           end.
     2255           delete object v-tth.
     2256           if v-bge-xml-bgeflold = "var"
     2257           then do:
     2258               if v-bgeflnm = ?
     2259               or num-entries( v-bgeflnm ) < 2
     2260               then do:
     2261                   assign
     2262                       v-bge-xml-bgeflold = "new"
     2263                   .
     2264               end.
     2265               else do:
     2266                   assign
     2267                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2268                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2269                   .
     2270                   assign
     2271                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2272                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2273                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2274                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2275                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2276                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2277                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2278                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2279                   .
     2280               end.
     2281           end.
     2282       end.
     2283   end.
     2284   end procedure.
     2285   procedure bge-xml-get-ref-filename :
     2286   define input parameter p-in-file-name       as character        no-undo.
     2287   define output parameter p-home-dir          as character        no-undo.
     2288   define output parameter p-out-file-name     as character        no-undo.
     2289   define output parameter p-locked            as logical          no-undo.
     2290       define variable v-counter       as integer      no-undo.
     2291       define variable v-error-level   as integer      no-undo.
     2292   do
     2293   on error undo, return error
     2294   :
     2295       run bge/bge-ini.p (
     2296             input "bge"
     2297           , output p-home-dir
     2298       ).
     2299       if return-value <> "OK"
     2300       then do:
     2301           undo, return error.
     2302       end.
     2303       assign
     2304           p-home-dir = p-home-dir + "\dict":U
     2305       .
     2306       run bge/dir_cd.p (
     2307           input p-home-dir
     2308           , input "CA"
     2309       ).
     2310       if return-value = "ERROR"
     2311       then do:
     2312           undo, return error.
     2313       end.
     2314       assign
     2315           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2316       .
     2317       assign
     2318           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2319       .
     2320       wait-lock:
     2321       do v-counter = 1 TO 3
     2322       :
     2323           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2324           if p-locked = no
     2325           then do:
     2326               leave wait-lock.
     2327           end.
     2328           else do:
     2329               readkey pause 1.
     2330           end.
     2331       END.
     2332       if p-locked = yes
     2333       then do:
     2334           undo, return error.
     2335       end.
     2336       run bge/os_copy.p (
     2337             input "D":U
     2338           , input p-out-file-name + "xml":U
     2339           , input "":U
     2340           , output v-error-level
     2341       ).
     2342       if v-error-level > 0
     2343       then do:
     2344           undo, return error.
     2345       end.
     2346   end.
     2347   end procedure.
     2348   procedure bge-xml-write-ref-header :
     2349   define input parameter p-bge-name as character        no-undo.
     2350   define input parameter p-file-name as character        no-undo.
     2351       define variable v-out-string    as character    no-undo.
     2352   do
     2353   on error undo, return error
     2354   :
     2355       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2356       put stream stmXMLOut unformatted
     2357           "<?xml version='1.0' encoding='windows-1251'?>":U
     2358       .
     2359       assign
     2360           v-out-string = substitute( "&1&2"
     2361                               , chr(10)
     2362                               , "<IBS_Trade_House>":U )
     2363       .
     2364       put stream stmXMLOut unformatted
     2365           v-out-string
     2366       .
     2367       run wp-XMLTagOpen( 1, "header", "" ).
     2368       if v-bge-xml-bgeflold = "oracle":u
     2369       then do:
     2370         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2371         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2372         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2373         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2374         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2375       end.
     2376       else do:
     2377         run wp-XMLTagOpen( 2, "delivery", "" ).
     2378         run wp-XMLTagOpen( 3, "to", "" ).
     2379         run wp-XMLTagClose( 3, "to" ).
     2380         run wp-XMLTagOpen( 3, "from", "" ).
     2381         run wp-XMLTagClose( 3, "from" ).
     2382         run wp-XMLTagClose( 2, "delivery" ).
     2383       end.
     2384       run wp-XMLTagOpen( 2, "manifest", "" ).
     2385       run wp-XMLTagOpen( 3, "document", "" ).
     2386       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2387       run wp-XMLTagPut( 4, "description", "", 0 ).
     2388       run wp-XMLTagClose( 3, "document" ).
     2389       run wp-XMLTagClose( 2, "manifest" ).
     2390       run wp-XMLTagClose( 1, "header" ).
     2391       run wp-XMLTagOpen( 1, "body", "" ).
     2392   end.
     2393   end procedure.
     2394   procedure bge-xml-write-ref-footer :
     2395   define input parameter p-file-name as character        no-undo.
     2396       define variable v-error-level   as integer      no-undo.
     2397   do
     2398   on error undo, return error
     2399   :
     2400       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2401       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2402       output stream stmXMLOut close.
     2403       run bge/os_copy.p (
     2404             input "M":U
     2405           , input p-file-name + "xm1":U
     2406           , input p-file-name + "xml":U
     2407           , output v-error-level
     2408       ).
     2409       if v-error-level > 0
     2410       then do:
     2411           undo, return error.
     2412       end.
     2413   end.
     2414   end procedure.
     2415   procedure bge-xml-out-dir :
     2416   define output parameter p-out-dir       as character    no-undo.
     2417   define output parameter p-log-file-name as character    no-undo.
     2418   do
     2419   on error undo, return error
     2420   :
     2421       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2422       if p-out-dir = ?
     2423       then do:
     2424           message
     2425             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2426                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2427             skip(1)
     2428             skip "Обратитесь к администратору."
     2429           view-as alert-box error.
     2430           undo, return error .
     2431       end.
     2432       if v-bge-xml-bgeflold <> "oracle" then assign
     2433         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2434       .
     2435       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2436       if error-status :error  then do:
     2437           run wp-XMLWriteLog in this-procedure (
     2438                 input p-log-file-name
     2439               , input 0
     2440               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2441                                   , p-out-dir
     2442                                   , return-value
     2443                                   , trim( error-status :get-message( 1 ) )
     2444                                   )
     2445           ).
     2446           undo, return error.
     2447       end.
     2448       assign
     2449           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2450           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2451       .
     2452   end.
     2453   end procedure.
     2454   procedure bge-xml-out-dir2 :
     2455   define output parameter p-out-dir       as character    no-undo.
     2456   define output parameter p-out-dirR      as character    no-undo.
     2457   define output parameter p-log-file-name as character    no-undo.
     2458   do
     2459   on error undo, return error
     2460   :
     2461       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2462       if p-out-dir = ?
     2463       then do:
     2464           message
     2465             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2466                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2467             skip(1)
     2468             skip "Обратитесь к администратору."
     2469           view-as alert-box error.
     2470           undo, return error .
     2471       end.
     2472       if v-bge-xml-bgeflold <> "oracle" then assign
     2473             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2474             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2475         .
     2476       else p-out-dirR = p-out-dir .
     2477       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2478       if error-status :error  then do:
     2479           run wp-XMLWriteLog in this-procedure (
     2480                 input p-log-file-name
     2481               , input 0
     2482               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2483                                   , p-out-dir
     2484                                   , return-value
     2485                                   , error-status :get-message( 1 )
     2486                                   )
     2487           ).
     2488           undo, return error.
     2489       end.
     2490       if p-out-dirR <> p-out-dir then do:
     2491         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2492         if error-status :error then do:
     2493           run wp-XMLWriteLog in this-procedure (
     2494                 input p-log-file-name
     2495               , input 0
     2496               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2497                                   , p-out-dirR
     2498                                   , return-value
     2499                                   , error-status :get-message( 1 )
     2500                                   )
     2501           ).
     2502           p-out-dirR = p-out-dir .
     2503         end.
     2504       end .
     2505       assign
     2506         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2507         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2508       .
     2509   end.
     2510   end procedure.
     2511   procedure bge-xml-out-file :
     2512   do
     2513   on error undo, return error
     2514   :
     2515   define input parameter p-out-dir            as character        no-undo.
     2516   define input parameter p-prefix             as character        no-undo.
     2517   define input parameter p-sheduled           as logical          no-undo.
     2518   define output parameter p-xml-file-name     as character        no-undo.
     2519   define output parameter p-locked            as logical          no-undo.
     2520   define variable v-home-dir      as character     no-undo.
     2521   define variable v-error-num     as integer       no-undo.
     2522   define variable v-today             as date         no-undo.
     2523   define variable v-time              as integer      no-undo.
     2524       if v-bge-xml-bgefmt = "dbf":U
     2525       then do:
     2526           assign
     2527               p-xml-file-name = p-out-dir
     2528               p-locked        = no
     2529           .
     2530       end.
     2531       else do:
     2532           if v-bge-xml-bgeflold = "firm":U
     2533           then do:
     2534               run bge/genfname.p (
     2535                     input p-out-dir
     2536                   , input p-prefix
     2537                   , input "":U
     2538                   , input "arj":U
     2539                   , input "":U
     2540                   , output p-xml-file-name
     2541               ).
     2542           end.
     2543           else do:
     2544               run bge/genfname.p (
     2545                     input p-out-dir
     2546                   , input p-prefix
     2547                   , input "":U
     2548                   , input "xml":U
     2549                   , input "":U
     2550                   , output p-xml-file-name
     2551               ).
     2552           end.
     2553           assign
     2554               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2555               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2556           .
     2557       end.
     2558   end.
     2559   end procedure.
     2560   procedure bge-xml-init-ext-doc-type :
     2561       define variable v-counter    as integer      no-undo.
     2562       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2563   do
     2564   for buf_temp_ext-doc-type
     2565   on error undo, return error
     2566   :
     2567       empty temp-table buf_temp_ext-doc-type.
     2568       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2569       :
     2570           create buf_temp_ext-doc-type.
     2571           assign
     2572               buf_temp_ext-doc-type.edt-key               = v-counter
     2573               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2574               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2575           .
     2576       end.
     2577   end.
     2578   end procedure.
     2579   procedure bge-xml-get-decimal-shift-num :
     2580   define input parameter p-shift-date     as date             no-undo.
     2581   define input parameter p-shift-num      as integer          no-undo.
     2582   define output parameter p-shift-decimal as decimal          no-undo.
     2583   do
     2584   on error undo, return error
     2585   :
     2586       assign
     2587           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2588       .
     2589   end.
     2590   end procedure.
     2591   procedure bge-xml-ora-exp-filename :
     2592     define input  parameter p-table-name  as character no-undo .
     2593     define input  parameter p-doc-code    as character no-undo .
     2594     define input  parameter p-obj-code    as integer   no-undo .
     2595     define output parameter p-filename    as character no-undo .
     2596     define output parameter p-seq-num     as integer   no-undo .
     2597     define variable v-ora-exp-seq     as integer   no-undo .
     2598     define variable v-ora-exp-seq-str as character no-undo .
     2599     define variable v-home-dir        as character no-undo.
     2600   do
     2601   on error undo, return error return-value
     2602   :
     2603     if v-bge-xml-bgeflold = "oracle":u
     2604     then do:
     2605       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2606       if v-home-dir = ?
     2607       then do:
     2608         undo, return error substitute( "&1&2&3":U
     2609                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2610                                       , chr(10)
     2611                                       , "Обратитесь к администратору.":U
     2612                                       ).
     2613       end.
     2614       assign
     2615           v-home-dir = v-home-dir
     2616       .
     2617       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2618       if error-status :error
     2619       then do:
     2620         undo, return error substitute( "&1&2&3":U
     2621                                       , "Неверно задан каталог экспорта.":U
     2622                                       , chr(10)
     2623                                       , "Обратитесь к администратору.":U
     2624                                       ).
     2625       end.
     2626       assign
     2627         v-ora-exp-seq = ?
     2628       .
     2629       if  p-table-name <> ? and
     2630           p-doc-code <> ?
     2631       then do:
     2632         run bge/get-oesq.p ( input p-table-name
     2633                            , input p-doc-code
     2634                            , output v-ora-exp-seq
     2635                            ) no-error .
     2636         if error-status :error = yes
     2637         then do:
     2638           undo, return error return-value .
     2639         end.
     2640       end.
     2641       if v-ora-exp-seq = ?
     2642       then do:
     2643         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2644         if error-status :error
     2645         then do:
     2646           undo, return error return-value .
     2647         end.
     2648       end.
     2649       if p-table-name <> ? and
     2650          p-doc-code   <> ?
     2651       then do:
     2652         run bge/oesqdoc.p ( input p-table-name
     2653                           , input p-doc-code
     2654                           , input v-ora-exp-seq
     2655                           ) no-error .
     2656         if error-status :error = yes
     2657         then do:
     2658           undo, return error return-value .
     2659         end.
     2660       end.
     2661       assign
     2662         p-seq-num  = v-ora-exp-seq
     2663         p-filename = substitute("&1/&2-000_&3."
     2664                                , v-home-dir
     2665                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2666                                , string(v-ora-exp-seq , "999999999")
     2667                                )
     2668       .
     2669     end.
     2670   end.
     2671   end procedure.
     2672   procedure bge-xml-date-to-str :
     2673     define input  parameter p-date  as date      no-undo .
     2674     define output parameter p-str   as character no-undo .
     2675   do
     2676   on error undo, return error return-value
     2677   :
     2678     if p-date <> ?
     2679     then do:
     2680       assign
     2681         p-str = substitute( "&1-&2-&3"
     2682                           , string( year(p-date)  , "9999")
     2683                           , string( month(p-date) , "99"  )
     2684                           , string( day(p-date)   , "99"  )
     2685                           )
     2686       .
     2687     end.
     2688     else do:
     2689       assign
     2690         p-str = ?
     2691       .
     2692     end.
     2693   end.
     2694   end procedure.
     2695   procedure bge-xml-date-str-to-str :
     2696     define input  parameter p-date-str  as character no-undo .
     2697     define output parameter p-str       as character no-undo .
     2698     define variable v-date          as date      no-undo .
     2699     define variable v-date-valid    as logical   no-undo .
     2700     define variable v-error-message as character no-undo .
     2701   do
     2702   on error undo, return error return-value
     2703   :
     2704     assign
     2705       p-str = ?
     2706     .
     2707     if p-date-str = ? or p-date-str = ""
     2708     then do:
     2709       return .
     2710     end.
     2711     run strtdate in this-procedure ( input  p-date-str
     2712                                    , output v-date
     2713                                    , output v-date-valid
     2714                                    , output v-error-message
     2715                                    ).
     2716     if v-date-valid <> true
     2717     then do:
     2718       return .
     2719     end.
     2720     assign
     2721       p-str = substitute( "&1-&2-&3"
     2722                         , string( year(v-date)  , "9999")
     2723                         , string( month(v-date) , "99"  )
     2724                         , string( day(v-date)   , "99"  )
     2725                         )
     2726     .
     2727   end.
     2728   end procedure.
     2729   procedure bge-xml-fill-tt-bgecliiv :
     2730     define input  parameter p-str as character no-undo .
     2731     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2732     define buffer buf_clients             for ub.clients.
     2733     define variable v-i         as integer   no-undo .
     2734     define variable v-count     as integer   no-undo .
     2735     define variable v-cli-count as integer   no-undo .
     2736     define variable v-client    as character no-undo .
     2737     define variable v-obj-type  as character no-undo .
     2738     define variable v-obj-code  as integer   no-undo .
     2739   do
     2740   on error undo, return error return-value
     2741   :
     2742     empty temp-table buf_tt-bge-xml-bgecliiv.
     2743     assign
     2744       v-bge-xml-bgecliiv = no
     2745       v-cli-count        = num-entries(p-str,';')
     2746     .
     2747     if v-cli-count > 0
     2748     then do:
     2749       _cli-cycle:
     2750       do v-i = 1 to v-cli-count
     2751       :
     2752         assign
     2753           v-client = entry(v-i , p-str, ';')
     2754         .
     2755         if num-entries(v-client) <> 2
     2756         then do:
     2757           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2758         end.
     2759         assign
     2760           v-obj-type = entry(1, v-client)
     2761         .
     2762         assign
     2763           v-obj-code = integer(entry(2, v-client))
     2764         no-error .
     2765         if error-status :error
     2766         then do:
     2767           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2768         end.
     2769         find first buf_clients no-lock
     2770           where buf_clients.obj-type = v-obj-type
     2771             and buf_clients.obj-code = v-obj-code
     2772         no-error.
     2773         if not available buf_clients
     2774         then do:
     2775           next _cli-cycle.
     2776         end.
     2777         find first buf_tt-bge-xml-bgecliiv no-lock
     2778           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2779             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2780         no-error .
     2781         if available buf_tt-bge-xml-bgecliiv
     2782         then do:
     2783           next _cli-cycle.
     2784         end.
     2785         create buf_tt-bge-xml-bgecliiv.
     2786         assign
     2787           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2788           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2789         .
     2790       end.
     2791     end.
     2792     else do:
     2793       assign
     2794         v-bge-xml-bgecliiv = no
     2795       .
     2796       return .
     2797     end.
     2798     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2799     if available buf_tt-bge-xml-bgecliiv
     2800     then do:
     2801       assign
     2802         v-bge-xml-bgecliiv = yes
     2803       .
     2804     end.
     2805   end.
     2806   end procedure.
     2807   procedure bge-xml-resolve-ext-doc-type :
     2808     define input  parameter p-ext-doc-type      as character no-undo .
     2809     define input  parameter p-obj-type          as character no-undo .
     2810     define input  parameter p-obj-code          as integer   no-undo .
     2811     define output parameter p-out-ext-doc-type  as character no-undo .
     2812     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2813   do
     2814   on error undo, return error return-value
     2815   :
     2816     assign
     2817       p-out-ext-doc-type = p-ext-doc-type
     2818     .
     2819     if p-ext-doc-type <> 'ie':U
     2820     then do:
     2821       return .
     2822     end.
     2823     if v-bge-xml-bgecliiv = yes
     2824     then do:
     2825       find first buf_tt-bge-xml-bgecliiv no-lock
     2826         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2827           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2828       no-error .
     2829       if available buf_tt-bge-xml-bgecliiv
     2830       then do:
     2831         assign
     2832           p-out-ext-doc-type = 'iv':U
     2833         .
     2834       end.
     2835     end.
     2836   end.
     2837   end procedure.
     2838   procedure safe-wp-xmltagput :
     2839     define input  parameter pTagLevel   as integer   no-undo .
     2840     define input  parameter pTagName    as character no-undo .
     2841     define input  parameter pParValue   as character no-undo .
     2842     define input  parameter pFlagEmpty  as integer   no-undo .
     2843   do
     2844   on error undo, return error return-value
     2845   :
     2846     if v-bge-xml-bgeflold = "oracle":u
     2847     then do:
     2848       return .
     2849     end.
     2850     run wp-xmltagput in this-procedure ( input pTagLevel
     2851                                        , input pTagName
     2852                                        , input pParValue
     2853                                        , input pFlagEmpty
     2854                                        ).
     2855   end.
     2856   end procedure.
     2857   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2858   procedure factord :
     2859     define input  parameter p-fact-date            as date    no-undo .
     2860     define input  parameter p-fact-time            as integer no-undo .
     2861     define input  parameter p-fact-num             as integer no-undo .
     2862     define input  parameter p-shift-date           as date    no-undo .
     2863     define input  parameter p-shift-num            as integer no-undo .
     2864     define input  parameter p-shift-on             as logical no-undo .
     2865     define output parameter p-fact-order           as decimal no-undo .
     2866     define output parameter p-shift-end-fact-order as decimal no-undo .
     2867     define output parameter p-day-end-fact-order   as decimal no-undo .
     2868     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2869     if p-fact-date = ?
     2870     then do:
     2871       return error "Не указана фактическая дата" .
     2872     end.
     2873     define variable v-fact-date-num as integer no-undo .
     2874     assign
     2875       v-fact-date-num = integer(p-fact-date)
     2876     .
     2877     if p-fact-num = ?
     2878     or p-fact-num = 0
     2879     then do:
     2880       return error "Не задан p-fact-num " + string(p-fact-num) .
     2881     end.
     2882     if p-fact-num < 0
     2883     then do:
     2884       return error "Отрицательный fact-num " + string(p-fact-num) .
     2885     end.
     2886     if p-fact-num >= 100000000
     2887     then do:
     2888       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2889     end.
     2890     if p-shift-on = true
     2891     then do:
     2892       if p-shift-date = ?
     2893       then do:
     2894         return error "Не задана дата смены" .
     2895       end.
     2896       if p-shift-num = ?
     2897       or p-shift-num = 0
     2898       then do:
     2899         return error "Не задан номер смены" .
     2900       end.
     2901     end.
     2902     else do:
     2903       assign
     2904         p-shift-date = p-fact-date
     2905         p-shift-num  = 24
     2906       .
     2907     end.
     2908     define variable v-shift-offset as integer no-undo .
     2909     if p-shift-date = p-fact-date
     2910     then do:
     2911       assign
     2912         v-shift-offset = 1
     2913       .
     2914     end.
     2915     if p-shift-date < p-fact-date
     2916     then do:
     2917       assign
     2918         v-shift-offset = 0
     2919       .
     2920     end.
     2921     if p-shift-date > p-fact-date
     2922     then do:
     2923       message
     2924         vss-workfile vss-revision vss-description skip
     2925         "Неправильная дата закрытия смены" skip
     2926         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2927         view-as alert-box error .
     2928       undo, return error
     2929         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2930           ,string(p-fact-date, '99/99/9999':U)
     2931           ,string(p-shift-date, '99/99/9999':U)
     2932           )
     2933       .
     2934     end.
     2935     if p-shift-num < 1
     2936     or p-shift-num > 24
     2937     then do:
     2938       message
     2939         vss-workfile vss-revision vss-description skip
     2940         "Неправильный номер смены" skip
     2941         "p-shift-num" p-shift-num skip
     2942         view-as alert-box error .
     2943       undo, return error return-value .
     2944     end.
     2945     assign
     2946       p-fact-order           = v-fact-date-num
     2947                              + v-shift-offset * 0.5
     2948                              + p-shift-num    * 0.02 - 0.01
     2949                              + p-fact-num     * 0.0000000001
     2950       p-shift-end-fact-order = v-fact-date-num
     2951                              + v-shift-offset * 0.5
     2952                              + p-shift-num    * 0.02
     2953       p-day-end-fact-order   = v-fact-date-num
     2954                              + 0.99
     2955     .
     2956     if p-fact-order           <= v-fact-date-num
     2957     or p-shift-end-fact-order <= v-fact-date-num
     2958     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2959     or p-shift-end-fact-order >= p-day-end-fact-order
     2960     then do:
     2961       message
     2962         vss-workfile vss-revision vss-description skip
     2963         "Внутренняя ошибка при генерации фактического номера" skip
     2964         "p-fact-date"            p-fact-date            skip
     2965         "p-fact-time"            p-fact-time            skip
     2966         "p-fact-num"             p-fact-num             skip
     2967         "p-shift-date"           p-shift-date           skip
     2968         "p-shift-num"            p-shift-num            skip
     2969         "p-shift-on"             p-shift-on             skip
     2970         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2971         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2972         "v-fact-date-num"        v-fact-date-num        skip
     2973         view-as alert-box error .
     2974       undo, return error return-value .
     2975     end.
     2976   end procedure.
     2977   procedure day-begin-fact-order :
     2978     define input  parameter p-fact-date            as date    no-undo .
     2979     define output parameter p-day-begin-fact-order as decimal no-undo .
     2980     do
     2981     on error undo, return error return-value
     2982     :
     2983       if p-fact-date = ?
     2984       then do:
     2985         assign
     2986           p-day-begin-fact-order = 0
     2987         .
     2988       end.
     2989       else do:
     2990         assign
     2991           p-day-begin-fact-order = integer(p-fact-date)
     2992         .
     2993       end.
     2994     end.
     2995   end procedure.
     2996   procedure factord-max-fact-order :
     2997     define output parameter p-max-fact-order as decimal   no-undo .
     2998     do
     2999     on error undo, return error return-value
     3000     :
     3001       run day-begin-fact-order in this-procedure
     3002         (input  date(1, 1, 5000)
     3003         ,output p-max-fact-order
     3004         ) .
     3005     end.
     3006   end procedure.
     3007   procedure factord-cut-archive :
     3008     define input  parameter p-obj-type             as character no-undo .
     3009     define input  parameter p-obj-code             as integer   no-undo .
     3010     define input  parameter p-fact-date            as date      no-undo .
     3011     define output parameter p-shift-on             as logical   no-undo .
     3012     define output parameter p-shift-date           as date      no-undo .
     3013     define output parameter p-shift-num            as integer   no-undo .
     3014     define output parameter p-day-end-fact-order   as decimal   no-undo .
     3015     define output parameter p-shift-end-fact-order as decimal   no-undo .
     3016     define variable v-fact-order as decimal   no-undo .
     3017     define buffer buf_shift-obj for ub.shift-obj .
     3018     do
     3019     on error undo, return error return-value
     3020     :
     3021   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3023     (input  p-obj-type
     3024     ,input  p-obj-code
     3025     ,input  'shift-on=request'
     3026     ,output p-shift-on
     3027     ) no-error .
     3028       if error-status :error
     3029       then do:
     3030         message
     3031           vss-workfile vss-revision vss-description skip
     3032           "Ошибка при определении атрибута объекта" skip
     3033           "Объект" p-obj-type p-obj-code skip
     3034           error-status :get-message(1) skip
     3035           return-value skip
     3036           view-as alert-box error .
     3037         undo, return error return-value .
     3038       end.
     3039       if p-shift-on = false
     3040       then do:
     3041         assign
     3042           p-shift-date               = ?
     3043           p-shift-num                = 0
     3044         .
     3045       end.
     3046       else do:
     3047         find first buf_shift-obj share-lock
     3048           where buf_shift-obj.obj-type   = p-obj-type
     3049             and buf_shift-obj.obj-code   = p-obj-code
     3050             and buf_shift-obj.shift-date > p-fact-date
     3051           use-index pi
     3052           no-error .
     3053         if not available buf_shift-obj
     3054         or buf_shift-obj.status_ <> 'зкр':U
     3055         then do:
     3056           message
     3057             vss-workfile vss-revision vss-description skip
     3058             "Невозможно вычислить последнюю смену" skip
     3059             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     3060             "Объект" p-obj-type p-obj-code skip
     3061             "Дата" p-fact-date skip
     3062             view-as alert-box error .
     3063           undo, return error return-value .
     3064         end.
     3065         find last buf_shift-obj share-lock
     3066           where buf_shift-obj.obj-type = p-obj-type
     3067             and buf_shift-obj.obj-code = p-obj-code
     3068             and buf_shift-obj.shift-date <= p-fact-date
     3069           use-index pi
     3070           no-error .
     3071         if available buf_shift-obj
     3072         then do:
     3073           if  buf_shift-obj.status_ = 'зкр':U
     3074           then do:
     3075             assign
     3076               p-shift-date = buf_shift-obj.shift-date
     3077               p-shift-num  = buf_shift-obj.shift-num
     3078             .
     3079           end.
     3080           else do:
     3081             message
     3082               vss-workfile vss-revision vss-description skip
     3083               "Невозможно вычислить последнюю смену" skip
     3084               "Статус смены отличен от статуса" 'зкр':U skip
     3085               "Объект" p-obj-type p-obj-code skip
     3086               "Дата" p-fact-date skip
     3087               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     3088               view-as alert-box error .
     3089             undo, return error return-value .
     3090           end.
     3091         end.
     3092         else do:
     3093           assign
     3094             p-shift-date = p-fact-date - 1
     3095             p-shift-num  = 1
     3096           .
     3097         end.
     3098       end.
     3099       run factord in this-procedure
     3100         (input  p-fact-date
     3101         ,input  1
     3102         ,input  1
     3103         ,input  p-shift-date
     3104         ,input  p-shift-num
     3105         ,input  p-shift-on
     3106         ,output v-fact-order
     3107         ,output p-shift-end-fact-order
     3108         ,output p-day-end-fact-order
     3109         ) no-error .
     3110       if error-status :error
     3111       then do:
     3112         message
     3113           vss-workfile vss-revision vss-description skip
     3114           "Ошибка при вызове процедуры factord"
     3115           error-status :get-message(1) skip
     3116           return-value skip
     3117           view-as alert-box error .
     3118         undo, return error return-value .
     3119       end.
     3120     end.
     3121   end procedure.
     3122   procedure factord-lock-shift :
     3123     define input  parameter p-obj-type  as character no-undo .
     3124     define input  parameter p-obj-code  as integer   no-undo .
     3125     define input  parameter p-fact-date as date      no-undo .
     3126     define parameter buffer buf_shift-obj for ub.shift-obj .
     3127     define variable v-shift-on      as logical   no-undo .
     3128     define variable v-extra-message as character no-undo .
     3129     define variable v-error as character no-undo .
     3130     do
     3131     on error undo, return error return-value
     3132     :
     3133   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3135     (input  p-obj-type
