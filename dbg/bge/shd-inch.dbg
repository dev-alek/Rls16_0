     1274       index pi is primary unique gds-code
     1275   .
     1276   define temp-table temp_bge-xml_clients no-undo
     1277       field obj-type as character
     1278       field obj-code as integer
     1279       field shift-date    as date
     1280       field shift-num     as integer
     1281       index pi is primary unique
     1282           obj-type
     1283           obj-code
     1284   .
     1285   define temp-table temp_bge-xml_dis-card no-undo
