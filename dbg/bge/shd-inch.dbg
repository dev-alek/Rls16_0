     1287       index pi is primary unique
     1288           d-card
     1289   .
     1290   define temp-table temp_doc-code no-undo
     1291       field doc-code as character
     1292       index pi is primary unique
     1293           doc-code
     1294   .
     1295   define temp-table temp_del-doc-code no-undo
     1296       field doc-code as character
     1297       index pi is primary unique
     1298           doc-code
     1299   .
     1300   define temp-table temp_pr-doc-num no-undo
     1301       field doc-num as character
     1302       index pi is primary unique
     1303           doc-num
     1304   .
     1305   define temp-table temp_fin-doc-code no-undo
     1306       field host-code as integer
     1307       field fin-doc-code as integer
     1308       index pi is primary unique
     1309           host-code
     1310           fin-doc-code
     1311   .
     1312   define temp-table temp_del-fin-doc-code no-undo
     1313       field host-code as integer
     1314       field fin-doc-code as integer
     1315       field corr-user-db-num as integer
     1316       field chip-num as integer
     1317       index pi is primary unique
     1318           host-code
     1319           fin-doc-code
     1320           corr-user-db-num
     1321           chip-num
     1322   .
     1323   define temp-table temp_fin-ob no-undo
     1324       field host-code as integer
     1325       field fin-doc-code as character
     1326       index pi is primary unique
     1327           host-code
     1328           fin-doc-code
     1329   .
     1330   define temp-table temp_del-fin-ob no-undo
     1331       field host-code as integer
     1332       field fin-doc-code as character
     1333       field corr-user-db-num as integer
     1334       field chip-num as integer
     1335       index pi is primary unique
     1336           host-code
     1337           fin-doc-code
     1338           corr-user-db-num
     1339           chip-num
     1340   .
     1341   define temp-table temp_ord-doc-code no-undo
     1342     field doc-code as character
     1343   index pi is primary unique
     1344     doc-code
     1345   .
     1346   define temp-table tt-bge-xml-bgecliiv no-undo
     1347     field obj-type  like ub.clients.obj-type
     1348     field obj-code  like ub.clients.obj-code
