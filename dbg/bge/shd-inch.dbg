        1   block-level on error undo, throw.
        2   define input parameter p-db-num         as integer    no-undo.
        3   define input parameter p-range          as integer    no-undo.
        4   define input parameter p-obj-list       as character  no-undo.
        5   define input parameter p-need-checks    as logical    no-undo.
        6   define input parameter p-doc-rvs        as logical    no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: a61e6bb0c7e0, 2871, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        9   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:10 2021 +0300 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: shd-inch.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: bge/shd-inch.p $":U .
       12   define variable vss-description as character no-undo init "Инкрементальный экспорт во Внешнюю Бухгалтерию документов, чеков и справочников".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define new global shared variable g#lib-trn  as handle no-undo .
       74   define new global shared variable g#lib-trn2 as handle no-undo .
       75   define new global shared variable g#lib-trn3 as handle no-undo .
       76   define new global shared variable g#lib-trn4 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define  temp-table temp-host no-undo
       79     field host-code like ub.store.host-code
       80     index xpk host-code
       81   .
       82   define  temp-table temp-obj no-undo
       83     field obj-type  like ub.clients.obj-type
       84     field obj-code  like ub.clients.obj-code
       85     field host-code like ub.store.host-code
       86     field db-num    like ub.clients.db-num
       87     index xpk  obj-type obj-code
       88     index xie1 host-code
       89     index xie2 db-num host-code
       90   .
       91   procedure init-temphost:
       92     define buffer buf_store   for ub.store .
       93     define buffer buf_shop    for ub.shop .
       94     define buffer buf_clients for ub.clients .
       95     define buffer buf_db for ub.db .
       96     define buffer buf_temp-host for temp-host .
       97     define buffer buf_temp-obj for temp-obj .
       98     do
       99     on error undo, return error return-value
      100     :
      101       for each buf_store
      102       on error undo, return error
      103       :
      104         find first buf_temp-host
      105           where buf_temp-host.host-code = buf_store.host-code
      106           no-error .
      107         if not available buf_temp-host
      108         then do:
      109           create buf_temp-host .
      110           assign
      111             buf_temp-host.host-code = buf_store.host-code
      112           .
      113         end.
      114         find first buf_clients no-lock
      115           where buf_clients.obj-type = 'скл':U
      116             and buf_clients.obj-code = buf_store.obj-code
      117           no-error .
      118         if not available buf_clients
      119         then do:
      120           message
      121             "Ошибка при поиске клиента" skip
      122             "Клиент" 'скл':U buf_store.obj-code skip
      123             view-as alert-box error .
      124           undo, return error .
      125         end.
      126         create buf_temp-obj .
      127         assign
      128           buf_temp-obj.obj-type  = 'скл':U
      129           buf_temp-obj.obj-code  = buf_store.obj-code
      130           buf_temp-obj.host-code = buf_store.host-code
      131           buf_temp-obj.db-num    = buf_clients.db-num
      132         .
      133       end.
      134       for each buf_shop
      135       on error undo, return error
      136       :
      137         find first buf_temp-host
      138           where buf_temp-host.host-code = buf_shop.host-code
      139           no-error .
      140         if not available buf_temp-host
      141         then do:
      142           create buf_temp-host .
      143           assign
      144             buf_temp-host.host-code = buf_shop.host-code
      145           .
      146         end.
      147         find first buf_clients no-lock
      148           where buf_clients.obj-type = 'маг':U
      149             and buf_clients.obj-code = buf_shop.obj-code
      150           no-error .
      151         if not available buf_clients then do:
      152           message
      153             "Ошибка при поиске клиента" skip
      154             "Клиент" 'маг':U buf_shop.obj-code skip
      155             view-as alert-box error .
      156           undo, return error .
      157         end.
      158         create buf_temp-obj .
      159         assign
      160           buf_temp-obj.obj-type  = 'маг':U
      161           buf_temp-obj.obj-code  = buf_shop.obj-code
      162           buf_temp-obj.host-code = buf_shop.host-code
      163           buf_temp-obj.db-num    = buf_clients.db-num
      164         .
      165       end.
      166     end.
      167   end.
      168   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
