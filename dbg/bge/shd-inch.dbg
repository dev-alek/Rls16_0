      954   end.
      955   end .
      956   procedure xmlchar-decode :
      957   define input parameter p-in-string      as character        no-undo.
      958   define output parameter p-out-string    as character        no-undo.
      959       define variable v-position      as integer      no-undo.
      960       define variable v-last-position as integer      no-undo.
      961       define variable v-temp-integer  as integer      no-undo.
      962       define variable v-current-char  as character    no-undo.
      963       define variable v-next-char     as character    no-undo.
      964       define variable v-success       as logical      no-undo.
      965   do
      966   on error undo, return error
      967   :
      968       assign
      969           p-out-string = "":U
      970           v-position   = 0
      971       .
      972       replace-cycle:
      973       do while yes
      974       on error undo, return error
      975       :
      976           assign
      977               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      978           .
      979           if v-last-position <= v-position
      980           then do:
      981               if v-position = 0
      982               then do:
      983                   assign
      984                       p-out-string = p-in-string
      985                   .
      986               end.
      987               else do:
      988                   assign
      989                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      990                   .
      991               end.
      992               leave replace-cycle.
      993           end.
      994           else do:
      995               assign
      996                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      997                   v-position      = v-last-position
      998                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      999               .
     1000               if v-current-char = "#":U
     1001               then do:
     1002                   assign
     1003                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1004                   .
     1005                   if v-last-position > 0
     1006                   then do:
     1007                       run xmlchar-read-integer in this-procedure
     1008                        (
     1009                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1010                           , output v-temp-integer
     1011                           , output v-success
     1012                       ).
     1013                       if v-success = yes
     1014                       and v-temp-integer >= 1
     1015                       and v-temp-integer <= 255
     1016                       then do:
     1017                           assign
     1018                               p-out-string = p-out-string + chr( v-temp-integer )
     1019                               v-position   = v-last-position + 1
     1020                           .
     1021                       end.
     1022                       else do:
     1023                           assign
     1024                               p-out-string = p-out-string + "&":U
     1025                               v-position   = v-position   + 1
     1026                           .
     1027                       end.
     1028                   end.
     1029                   else do:
     1030                       assign
     1031                           p-out-string = p-out-string + "&":U
     1032                           v-position   = v-position   + 1
     1033                       .
     1034                   end.
     1035               end.
     1036               else do:
     1037                   case substring( p-in-string, v-position + 1, 3 )
     1038                   :
     1039                       when "lt;":U
     1040                       then do:
     1041                           assign
     1042                               p-out-string = p-out-string + "<":U
     1043                               v-position   = v-position   + 3
     1044                           .
     1045                       end.
     1046                       when "gt;":U
     1047                       then do:
     1048                           assign
     1049                               p-out-string = p-out-string + ">":U
     1050                               v-position   = v-position   + 3
     1051                           .
     1052                       end.
     1053                       otherwise do:
     1054                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1055                           then do:
     1056                               assign
     1057                                   p-out-string = p-out-string + "&":U
     1058                                   v-position   = v-position   + 4
     1059                               .
     1060                           end.
     1061                           else do:
     1062                               case substring( p-in-string, v-position + 1, 5 )
     1063                               :
     1064                                   when "quot;":U
     1065                                   then do:
     1066                                       assign
     1067                                           p-out-string = p-out-string + '"':U
     1068                                           v-position   = v-position   + 5
     1069                                       .
     1070                                   end.
     1071                                   when "apos;":U
     1072                                   then do:
     1073                                       assign
     1074                                           p-out-string = p-out-string + "'":U
     1075                                           v-position   = v-position   + 5
     1076                                       .
     1077                                   end.
     1078                                   otherwise do:
     1079                                       assign
     1080                                           p-out-string = p-out-string + "&":U
     1081                                       .
     1082                                   end.
     1083                               end case.
     1084                           end.
     1085                       end.
     1086                   end case.
     1087               end.
     1088           end.
     1089       end.
     1090   end.
     1091   end .
     1092   procedure xmlchar-read-integer :
     1093   define input parameter p-input-string      as character        no-undo.
     1094   define output parameter p-output-integer   as integer          no-undo.
     1095   define output parameter p-success       as logical          no-undo.
     1096   do
     1097   on error undo, return error
     1098   :
     1099       assign
     1100           p-output-integer = integer( p-input-string )
     1101       no-error.
     1102       if error-status :error
     1103       then do:
     1104           assign
     1105               p-success           = no
     1106               p-output-integer    = 0
     1107           .
     1108       end.
     1109       else do:
     1110           assign
     1111               p-success           = yes
     1112           .
     1113       end.
     1114   end.
     1115   end.
     1116   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1117   procedure strtdate :
     1118     define input  parameter p-str         as character no-undo .
     1119     define output parameter p-value       as date      no-undo .
     1120     define output parameter p-data-valid  as logical   no-undo .
     1121     define output parameter p-message     as character no-undo .
     1122   do
     1123   on error undo, return error return-value
     1124   :
     1125     define variable v-value       as date      no-undo .
     1126     define variable v-i           as integer   no-undo .
     1127     define variable v-num         as integer   no-undo .
     1128     define variable v-delim       as character no-undo .
     1129     define variable v-delim-list  as character no-undo .
     1130     define variable v-day         as integer   no-undo .
     1131     define variable v-month       as integer   no-undo .
     1132     define variable v-year        as integer   no-undo .
     1133     define variable v-day-str     as character no-undo .
     1134     define variable v-month-str   as character no-undo .
     1135     define variable v-year-str    as character no-undo .
     1136     assign
     1137       p-value       = ?
     1138       p-data-valid  = false
     1139     .
     1140     if p-str = ?
     1141     then do:
     1142       assign
     1143         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1144       .
     1145       return .
     1146     end.
     1147     if p-str = ""
     1148     then do:
     1149       assign
     1150         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1151       .
     1152       return .
     1153     end.
     1154     if length(p-str)  > 10
     1155     then do:
     1156       assign
     1157         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1158       .
     1159       return .
     1160     end.
     1161     assign
     1162       v-delim-list = '/,-,.':U
     1163     .
     1164     _delim:
     1165     do v-i = 1 to num-entries( v-delim-list )
     1166     :
     1167       assign
     1168         v-delim = entry( v-i , v-delim-list )
     1169         v-num   = num-entries( p-str , v-delim )
     1170       .
     1171       if v-num <> 3
     1172       then do:
     1173         assign
     1174           v-delim = ''
     1175         .
     1176       end.
     1177       else do:
     1178         leave _delim.
     1179       end.
     1180     end.
     1181     if v-delim = ''
     1182     then do:
     1183       assign
     1184         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1185       .
     1186       return .
     1187     end.
     1188     assign
     1189       v-day-str   = entry( 1, p-str , v-delim)
     1190       v-month-str = entry( 2, p-str , v-delim)
     1191       v-year-str  = entry( 3, p-str , v-delim)
     1192     .
     1193     if  length(v-day-str) > 2   or
     1194         length(v-day-str) < 1   or
     1195         length(v-month-str) > 2 or
     1196         length(v-month-str) < 1 or
     1197         (
     1198           length(v-year-str) <> 2 and
     1199           length(v-year-str) <> 4
     1200         )
     1201     then do:
     1202       assign
     1203         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1204       .
     1205       return .
     1206     end.
     1207     if length( v-year-str ) = 2
     1208     then do:
     1209       assign
     1210         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1211       .
     1212     end.
     1213     assign
     1214       v-day   = integer( v-day-str )
     1215       v-month = integer( v-month-str)
     1216       v-year  = integer( v-year-str)
     1217     no-error .
     1218     if error-status :error
     1219     then do:
     1220       assign
     1221         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1222       .
     1223       return .
     1224     end.
     1225     if v-day < 1  or
     1226        v-day > 31 or
     1227        v-month < 1 or
     1228        v-month > 12 or
     1229        v-year < 0   or
     1230        v-year > 5000
     1231     then do:
     1232       assign
     1233         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1234       .
     1235       return .
     1236     end.
     1237     assign
     1238       v-value = date( v-month, v-day, v-year )
     1239     no-error .
     1240     if error-status :error
     1241     then do:
     1242       assign
     1243         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1244       .
     1245       return .
     1246     end.
     1247     assign
     1248       p-value       = v-value
     1249       p-data-valid  = true
     1250     .
     1251   end.
     1252   end procedure.
     1253   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
     1254   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
     1255   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
     1256   define variable v-bge-xml-bgeflold      as character         no-undo.
     1257   define variable v-bge-xml-bgefmt        as character         no-undo.
     1258   define variable v-bge-xml-shift-mode    as logical           no-undo.
     1259   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
     1260   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
     1261   define variable v-bge-xml-log-file-name as character    no-undo.
     1262   define variable v-bge-xml-dbf-file-name as character    no-undo.
     1263   define variable v-bge-xml-db-num-str    as character    no-undo .
     1264   define variable v-bge-xml-static-log-file-name as character    no-undo.
     1265   define temp-table temp_ext-doc-type no-undo
     1266       field edt-key               as integer
     1267       field ext-doc-type          as character
     1268       field ext-doc-type-label    as character
