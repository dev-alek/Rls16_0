     3157             where buf_shift-obj.obj-type = p-obj-type
     3158               and buf_shift-obj.obj-code = p-obj-code
     3159               and buf_shift-obj.status_  = 'зкр':U
     3160             use-index stts
     3161             no-error .
     3162           if available buf_shift-obj
     3163           then do:
