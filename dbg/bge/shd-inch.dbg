     3177   procedure factord-end-day :
     3178     define input  parameter p-fact-date            as date    no-undo .
     3179     define output parameter p-day-end-fact-order   as decimal no-undo .
     3180     do
     3181     on error undo, return error return-value
     3182     :
     3183       if p-fact-date = ?
     3184       then do:
     3185         return error "Не указана фактическая дата" .
     3186       end.
     3187       assign
     3188         p-day-end-fact-order = integer(p-fact-date) + 0.99
     3189       .
     3190     end.
     3191   end procedure.
     3192   procedure factord-to-date :
     3193     define input  parameter p-fact-order as decimal no-undo .
     3194     define output parameter p-fact-date  as date    no-undo .
     3195     define variable v-ref-date  as date      no-undo .
     3196     define variable v-ref-delta as integer   no-undo .
     3197     do
     3198     on error undo, return error return-value
     3199     :
     3200       if p-fact-order = ?
     3201       or p-fact-order = 0
     3202       then do:
     3203         return error "Не указан fact-order" .
     3204       end.
     3205       assign
     3206         v-ref-date  = date(1, 1, 2000)
     3207       .
     3208       assign
     3209         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     3210       .
     3211       assign
     3212         p-fact-date = v-ref-date + v-ref-delta
     3213       .
     3214     end.
     3215   end procedure.
     3216   procedure factord-to-fact-num :
     3217     define input  parameter p-fact-order as decimal no-undo .
     3218     define output parameter p-fact-num   as integer no-undo .
     3219     define variable v-fact-order-trunc as decimal no-undo .
     3220     do
     3221     on error undo, return error return-value
     3222     :
     3223       if p-fact-order = ?
     3224       or p-fact-order = 0
     3225       then do:
     3226         return error "Не указан fact-order" .
     3227       end.
     3228       assign
     3229        v-fact-order-trunc = truncate(p-fact-order, 2)
     3230       .
     3231       assign
     3232         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     3233       .
     3234     end.
     3235   end procedure.
     3236   procedure factord-to-shift-num :
     3237     define input  parameter p-fact-order as decimal no-undo .
     3238     define output parameter p-shift-num   as integer no-undo .
     3239     define variable  p-shift-numd  as decimal   no-undo .
     3240     define variable v-fact-order-trunc as decimal no-undo .
     3241     do
     3242     on error undo, return error return-value
     3243     :
     3244       if p-fact-order = ?
     3245       or p-fact-order = 0
     3246       then do:
     3247         return error "Не указан fact-order" .
     3248       end.
     3249       assign
     3250        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     3251       .
     3252       if v-fact-order-trunc < 0.5 then do:
     3253         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3254       end.
     3255       assign
     3256         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3257         .
     3258        assign
     3259         p-shift-num = truncate (p-shift-numd , 0)
     3260       .
     3261     end.
     3262   end procedure.
