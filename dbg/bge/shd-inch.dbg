     3442   procedure export-docs-by-object :
     3443   define input parameter p-host-code      as integer          no-undo.
     3444   define input parameter p-obj-type       as character        no-undo.
     3445   define input parameter p-obj-code       as integer          no-undo.
     3446   define input parameter p-out-dir        as character        no-undo.
     3447   define input parameter p-out-dirR       as character        no-undo.
     3448   define input parameter p-log-file-name  as character        no-undo.
     3449       define variable v-xml-file-name         as character    no-undo.
     3450       define variable v-prefix                as character    no-undo.
     3451       define variable v-locked                as logical      no-undo.
     3452       define variable v-start-shift-date      as date         no-undo.
     3453       define variable v-start-shift-num       as integer      no-undo.
     3454       define variable v-not-exists            as logical      no-undo.
     3455       define variable v-fact-order-from       as decimal      no-undo.
     3456       define variable v-fact-order-to         as decimal      no-undo.
     3457       define variable v-docs-exists           as logical      no-undo.
     3458       define variable v-attr-value            as character    no-undo.
     3459       define variable v-attr-type             as character    no-undo.
     3460       define variable v-start-date-decimal    as decimal      no-undo.
     3461       define variable v-date-decimal          as decimal      no-undo.
     3462       define variable v-archive-ok            as logical      no-undo.
     3463       define variable v-comment               as character    no-undo.
     3464       define buffer buf_shift-obj     for ub.shift-obj.
     3465   do
     3466   for buf_shift-obj
     3467   on error undo, return error
     3468   :
     3469       run wp-XMLWriteLog in this-procedure (
     3470             input p-log-file-name
     3471           , input 2
     3472           , input "Расчет архивов"
     3473       ).
     3474       run bge/bge-ahzs.p (
     3475             input p-obj-type
     3476           , input p-obj-code
     3477           , input yes
     3478           , input yes
     3479           , input no
     3480           , input v-today
     3481           , input v-today
     3482           , output v-archive-ok
     3483           , output v-comment
     3484       ) no-error.
     3485       if error-status :error
     3486       then do:
     3487           message
     3488           vss-workfile vss-revision vss-description
     3489           skip "Ошибка проверки архивов на объекте."
     3490           skip "Тип объекта:" p-obj-type
     3491           skip "Код объекта:" p-obj-code
     3492           skip return-value
     3493           skip trim(error-status :get-message(1))
     3494               trim(error-status :get-message(2))
     3495               trim(error-status :get-message(3))
     3496           view-as alert-box error.
     3497           undo, return error .
     3498       end.
     3499       if v-archive-ok = no
     3500       then do:
     3501           run wp-XMLWriteLog in this-procedure (
     3502                 input v-log-file-name
     3503               , input 1
     3504               , input substitute( "*** Документы по объекту &1 &2 на дату &3 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &4."
     3505                                       , p-obj-type
     3506                                       , p-obj-code
     3507                                       , v-today
     3508                                       , v-comment       )
     3509           ).
     3510           undo, return error .
     3511       end.
     3512       run clntattr-value in this-procedure (
     3513             input p-obj-type
     3514           , input p-obj-code
     3515           , input 'bge-incr-last-shift-date':U
     3516           , output v-attr-value
     3517           , output v-attr-type
     3518       ).
     3519       assign
     3520           v-start-shift-date = date( v-attr-value )
     3521       no-error.
     3522       if error-status :error
     3523       or v-start-shift-date = ?
     3524       then do:
     3525           assign
     3526               v-start-shift-date = 01/01/1990
     3527           .
     3528       end.
     3529       run clntattr-value in this-procedure (
     3530             input p-obj-type
     3531           , input p-obj-code
     3532           , input 'bge-incr-last-shift-num':U
     3533           , output v-attr-value
     3534           , output v-attr-type
     3535       ).
     3536       assign
     3537           v-start-shift-num = integer( v-attr-value )
     3538       no-error.
     3539       if error-status :error
     3540       then do:
     3541           assign
     3542               v-start-shift-num = 0
     3543           .
     3544       end.
     3545       assign
     3546           v-last-shift-date = v-start-shift-date
     3547           v-last-shift-num  = v-start-shift-num
     3548       .
     3549       run wp-XMLWriteLog in this-procedure ( input v-log-file-name
     3550                                            , input 2
     3551                                            , input substitute( "Последняя выгруженная смена: N &1 за &2 ...", v-start-shift-num, v-start-shift-date  )
     3552                                            ).
     3553       run bge-xml-get-decimal-shift-num in this-procedure (
     3554                 input v-start-shift-date
     3555               , input v-start-shift-num
     3556               , output v-start-date-decimal
     3557       ).
     3558   define variable v-is-found as logical no-undo .
     3559       v-is-found = false .
     3560       export-shifts:
     3561       for each buf_shift-obj no-lock
     3562          where buf_shift-obj.obj-type     = p-obj-type
     3563            and buf_shift-obj.obj-code     = p-obj-code
     3564            and buf_shift-obj.shift-date   >= v-start-shift-date
     3565            and buf_shift-obj.status_      = 'зкр':U
     3566       use-index pi
     3567       on error  undo export-shifts, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3568       on stop   undo export-shifts, return error substitute( "&1. stop", vss-workfile )
     3569       on endkey undo export-shifts, return error substitute( "&1. endkey", vss-workfile )
     3570       :
     3571           run bge-xml-get-decimal-shift-num in this-procedure (
     3572                 input buf_shift-obj.shift-date
     3573               , input buf_shift-obj.shift-num
     3574               , output v-date-decimal
     3575           ).
     3576           if v-date-decimal > v-start-date-decimal
     3577           then do:
     3578   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     3579     (
     3580        input buf_shift-obj.obj-type
     3581     ,  input buf_shift-obj.obj-code
     3582     ,  input buf_shift-obj.shift-date
     3583     ,  input buf_shift-obj.shift-num
     3584     , output v-shift-name
     3585     , output v-shift-name-num
     3586     )        no-error .
     3587               run wp-XMLWriteLog in this-procedure (
     3588                     input v-log-file-name
     3589                   , input 2
     3590                   , input substitute( "Смена: N &1 за &2 ...", v-shift-name-num, buf_shift-obj.shift-date  )
     3591               ).
     3592               assign
     3593                   v-prefix = substitute( "d_&1&2&3&4&5&6_"
     3594                                           , substring( string( year( buf_shift-obj.shift-date ), "9999":U ), 3, 2 )
     3595                                           , string( month( buf_shift-obj.shift-date ), "99":U )
     3596                                           , string( day( buf_shift-obj.shift-date ), "99":U )
     3597                                           , string( buf_shift-obj.shift-num, "99":U )
     3598                                           , string( trim( buf_shift-obj.obj-type ), "X(3)":U )
     3599                                           , string( buf_shift-obj.obj-code, "99999":U )
     3600                                           )
     3601               .
     3602               run bge-xml-out-file in this-procedure (
     3603                     input p-out-dir
     3604                   , input v-prefix
     3605                   , input no
     3606                   , output v-xml-file-name
     3607                   , output v-locked
     3608               ).
     3609               if v-locked = yes
     3610               then do:
