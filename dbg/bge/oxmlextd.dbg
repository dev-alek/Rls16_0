        1   define input parameter p-mainmenu-handle    as handle           no-undo.
        2   define input parameter p-parent-handle      as handle           no-undo.
        3   define input parameter p-mode               as character        no-undo.
        4   define input parameter p-esys-id            as integer          no-undo.
        5   define input parameter p-db-num             as integer          no-undo.
        6   define input parameter p-current-db-num     as integer          no-undo.
        7   define output parameter p-success           as logical          no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Open XML. Редактирование записи внешней подсистемы".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "X(65)" no-undo
       73   initial "@(#)$Workfile$ $Revision$".
       74   procedure oxmlext-create :
       75   define input parameter p-mainmenu-handle    as handle           no-undo.
       76   define input parameter p-current-db-num     as integer          no-undo.
       77   define output parameter p-esys-id           as integer          no-undo.
       78       define variable v-today     as date         no-undo.
       79       define variable v-time      as integer      no-undo.
       80       define variable v-userid    as character    no-undo.
       81       define buffer buf_ext-system        for ub.ext-system.
       82   do
       83   for buf_ext-system
       84   on error undo, return error
       85   :
       86       run cur-time in this-procedure (
       87             output v-today
       88           , output v-time
       89       ).
       90       run oxmlext-esys-id in this-procedure (
       91           output p-esys-id
       92       ).
       93       run get-userid in p-mainmenu-handle (
       94           output v-userid
       95       ).
       96       create buf_ext-system.
       97       assign
       98           buf_ext-system.esys-id                          = p-esys-id
       99           buf_ext-system.db-num                           = p-current-db-num
      100           buf_ext-system.esys-date-change                 = v-today
      101           buf_ext-system.esys-chk-ingr-imp                = no
      102           buf_ext-system.esys-chk-seq-imp                 = no
      103           buf_ext-system.esys-date-change-attr            = v-today
      104           buf_ext-system.esys-date-change-exp             = v-today
      105           buf_ext-system.esys-date-change-imp             = v-today
      106           buf_ext-system.esys-db-num-exp                  = p-current-db-num
      107           buf_ext-system.esys-db-num-imp                  = p-current-db-num
      108           buf_ext-system.esys-des                         = ""
      109           buf_ext-system.esys-file-chk-ing-imp            = "":U
      110           buf_ext-system.esys-have-export                 = no
      111           buf_ext-system.esys-have-import                 = no
      112           buf_ext-system.esys-have-proc-chk-ing-imp       = no
      113           buf_ext-system.esys-last-pack                   = 0
      114           buf_ext-system.esys-name                        = "<Новая внешняя система>"
      115           buf_ext-system.esys-num-days-keep-exp           = 0
      116           buf_ext-system.esys-num-days-keep-imp           = 0
      117           buf_ext-system.esys-proc-chk-ing-imp            = "":U
      118           buf_ext-system.esys-send-news-exp               = no
      119           buf_ext-system.esys-send-news-imp               = no
      120           buf_ext-system.esys-status                      = integer( '-1':U )
      121           buf_ext-system.esys-work-update                 = no
      122           buf_ext-system.esys-creid                       = v-userid
      123           buf_ext-system.esys-sys-date                    = v-today
      124           buf_ext-system.esys-sys-time-int                = v-time
      125           buf_ext-system.esys-sys-time                    = string( v-time, "HH:MM:SS" )
      126           buf_ext-system.esys-user-name                   = v-userid
      127           buf_ext-system.esys-user-db-num                 = p-current-db-num
      128       .
      129   end.
      130   end procedure.
      131   procedure oxmlext-start-subsystem :
      132   define input parameter p-esys-id    as integer          no-undo.
      133   define input parameter p-db-num     as integer          no-undo.
      134       define buffer buf_ext-system        for ub.ext-system.
      135   do
      136   for buf_ext-system
      137   on error undo, return error
      138   :
      139       find first buf_ext-system exclusive-lock
      140            where buf_ext-system.esys-id = p-esys-id
      141              and buf_ext-system.db-num  = p-db-num
      142       .
      143       if buf_ext-system.esys-status = 20
      144       then do:
      145           assign
      146               buf_ext-system.esys-status = 21
      147           .
      148       end.
      149       else do:
      150           assign
      151               buf_ext-system.esys-status = 1
      152           .
      153       end.
      154   end.
      155   end procedure.
      156   procedure oxmlext-stop-subsystem :
      157   define input parameter p-esys-id    as integer          no-undo.
      158   define input parameter p-db-num     as integer          no-undo.
      159       define buffer buf_ext-system        for ub.ext-system.
      160   do
      161   for buf_ext-system
      162   on error undo, return error
      163   :
      164       find first buf_ext-system exclusive-lock
      165            where buf_ext-system.esys-id = p-esys-id
      166              and buf_ext-system.db-num  = p-db-num
      167       .
      168       if buf_ext-system.esys-status = 21
      169       then do:
      170           assign
      171               buf_ext-system.esys-status = 20
      172           .
      173       end.
      174       else do:
      175           assign
      176               buf_ext-system.esys-status = 0
      177           .
      178       end.
      179   end.
      180   end procedure.
      181   procedure oxmlext-stop-import :
      182   define input parameter p-esys-id    as integer          no-undo.
      183   define input parameter p-db-num     as integer          no-undo.
      184   do
      185   on error undo, return error
      186   :
      187   end.
      188   end procedure.
      189   procedure oxmlext-stop-export :
      190   define input parameter p-esys-id    as integer          no-undo.
      191   define input parameter p-db-num     as integer          no-undo.
      192   do
      193   on error undo, return error
      194   :
      195   end.
      196   end procedure.
      197   procedure proc-alt-shift-f2:
      198     if not ibs.th.gbl.gbl-var:rcode
      199   then
      200     run gbl\inidebug.p .
      201   end.
      202   procedure proc-alt-shift-f3:
      203     run gbl/prvssinf.p
      204       ( input this-procedure
      205       ) .
      206   end.
      207   define variable v-inform-launched as logical no-undo initial false .
      208   procedure proc-alt-shift-f4:
      209     define variable v-action as character no-undo .
      210     if v-inform-launched = false then do:
      211       assign
      212         v-inform-launched = true
      213       .
      214       run gbl/d-inform.w
      215         (  input self
      216         ,  input this-procedure
      217         , output v-action
      218         ) no-error .
      219       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      220       assign
      221         v-inform-launched = false
      222       .
      223     end.
      224   end.
      225   procedure proc-alt-f1:
      226     run gbl/corrhelp.p
      227       (input this-procedure
      228       ) .
      229   end .
      230   on alt-shift-f2 anywhere do:
      231     run proc-alt-shift-f2.
      232   end.
      233   on alt-shift-f3 anywhere do:
      234     run proc-alt-shift-f3 in this-procedure .
      235   end.
      236   on alt-shift-f4 anywhere do:
      237     run proc-alt-shift-f4 in this-procedure.
      238   end.
      239   on alt-f1 anywhere do:
      240     run proc-alt-f1 in this-procedure .
      241   end.
      242   define variable v-oxmlextd-can-change-db-imp    as logical      no-undo.
      243   define variable v-oxmlextd-can-change-db-exp    as logical      no-undo.
      244   define variable v-oxmlextd-can-change-imp       as logical      no-undo.
      245   define variable v-oxmlextd-can-change-exp       as logical      no-undo.
      246   define variable v-oxmlextd-have-import          as logical      no-undo.
      247   define variable v-oxmlextd-have-export          as logical      no-undo.
      248   define variable v-oxmlextd-has-import               as logical      no-undo.
      249   DEFINE BUTTON b-cancel AUTO-END-KEY
      250        LABEL "&Отмена"
      251        SIZE 10 BY 1
      252        BGCOLOR 8 .
      253   DEFINE BUTTON b-exit AUTO-GO
      254        LABEL "&Ввод"
      255        SIZE 10 BY 1
      256        BGCOLOR 8 .
      257   DEFINE BUTTON b-help
      258        LABEL "Помо&щь"
      259        SIZE 10 BY 1
      260        BGCOLOR 8 .
      261   DEFINE BUTTON bt-types-exp
      262        LABEL "Типы данных"
      263        SIZE 14.5 BY 1.
      264   DEFINE VARIABLE ed-des AS CHARACTER
      265        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      266        SIZE 29 BY 3.75 NO-UNDO.
      267   DEFINE VARIABLE fi-db-num-exp AS INTEGER FORMAT "->>>>9" INITIAL 0
      268        LABEL "БД"
      269        VIEW-AS FILL-IN
      270        SIZE 5.5 BY 1.
      271   DEFINE VARIABLE fi-des-label AS CHARACTER FORMAT "X(256)":U INITIAL "Описание:"
      272        VIEW-AS FILL-IN
      273        SIZE 10 BY 1 NO-UNDO.
      274   DEFINE VARIABLE fi-esys-id AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      275        LABEL "Номер"
      276         VIEW-AS TEXT
      277        SIZE 9.5 BY .67
      278        FGCOLOR 4  NO-UNDO.
      279   DEFINE VARIABLE fi-name AS CHARACTER FORMAT "X(256)":U
      280        LABEL "Название"
      281        VIEW-AS FILL-IN
      282        SIZE 29 BY 1 NO-UNDO.
      283   DEFINE VARIABLE fi-num-days-keep-exp AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      284        LABEL "Дней хранения пакетов"
      285        VIEW-AS FILL-IN
      286        SIZE 7.5 BY 1.
      287   DEFINE RECTANGLE RECT-1
      288        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      289        SIZE 40 BY 5.5.
      290   DEFINE RECTANGLE RECT-2
      291        EDGE-PIXELS 2 GRAPHIC-EDGE
      292        SIZE 12.5 BY 1.25
      293        BGCOLOR 8 FGCOLOR 8 .
      294   DEFINE VARIABLE tg-have-export AS LOGICAL INITIAL no
      295        LABEL "Экспорт"
      296        VIEW-AS TOGGLE-BOX
      297        SIZE 10.5 BY .83 NO-UNDO.
      298   DEFINE VARIABLE tg-have-import AS LOGICAL INITIAL no
      299        LABEL "Импорт"
      300        VIEW-AS TOGGLE-BOX
      301        SIZE 10.5 BY .83 NO-UNDO.
      302   DEFINE VARIABLE tg-send-news-exp AS LOGICAL INITIAL no
      303        LABEL "Отправлять в новости"
      304        VIEW-AS TOGGLE-BOX
      305        SIZE 24 BY .83 NO-UNDO.
      306   DEFINE VARIABLE tg-spec AS LOGICAL INITIAL no
      307        LABEL "Спецсистема"
      308        VIEW-AS TOGGLE-BOX
      309        SIZE 17 BY .83 NO-UNDO.
      310   DEFINE FRAME Dialog-Frame
      311        b-exit AT ROW 1 COL 1
      312        b-cancel AT ROW 1 COL 11
      313        b-help AT ROW 1 COL 32
      314        fi-name AT ROW 3.5 COL 11 COLON-ALIGNED
      315        fi-des-label AT ROW 5 COL 2.5 NO-LABEL
      316        ed-des AT ROW 5 COL 13 NO-LABEL
      317        tg-spec AT ROW 9.25 COL 4.5 WIDGET-ID 2
      318        tg-have-export AT ROW 10.5 COL 4.5
      319        fi-db-num-exp AT ROW 11.75 COL 6.5 COLON-ALIGNED
      320        tg-send-news-exp AT ROW 11.75 COL 16.5
      321        fi-num-days-keep-exp AT ROW 13 COL 25.5 COLON-ALIGNED
      322        bt-types-exp AT ROW 14.75 COL 4
      323        tg-have-import AT ROW 16.75 COL 4.5 WIDGET-ID 6
      324        fi-esys-id AT ROW 2.25 COL 11 COLON-ALIGNED WIDGET-ID 4
      325        RECT-1 AT ROW 10.75 COL 2
      326        RECT-2 AT ROW 10.25 COL 3.5
      327        SPACE(27.24) SKIP(6.45)
      328       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      329            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      330            TITLE "Внешняя подсистема Open XML"
      331            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      332   ASSIGN
      333          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      334          FRAME Dialog-Frame:HIDDEN           = TRUE.
      335   ON GO OF FRAME Dialog-Frame
      336   DO:
      337   END.
      338   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      339   DO:
      340     APPLY "END-ERROR":U TO SELF.
      341   END.
      342   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      343   DO:
      344   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   if lookup(self :type
      346            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      347            ) = 0
      348   then do:
      349     message
      350       "$Workfile$"
      351       "Указанному интерфейсному элементу фокус не может быть передан" skip
      352       "Интерфейсный элемент" self :name  skip
      353       "Тип" self :type  skip
      354       "Процедура" this-procedure :file-name skip
      355       view-as alert-box .
      356   end.
      357   else do:
      358     apply "entry":u to self  .
      359     if focus :handle <> self :handle  then do:
      360       return no-apply .
      361     end.
      362   end.
      363   END.
      364   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      365   DO:
      366   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   if lookup(self :type
      368            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      369            ) = 0
      370   then do:
      371     message
      372       "$Workfile$"
      373       "Указанному интерфейсному элементу фокус не может быть передан" skip
      374       "Интерфейсный элемент" self :name  skip
      375       "Тип" self :type  skip
      376       "Процедура" this-procedure :file-name skip
      377       view-as alert-box .
      378   end.
      379   else do:
      380     apply "entry":u to self  .
      381     if focus :handle <> self :handle  then do:
      382       return no-apply .
      383     end.
      384   end.
      385       define variable v-err-desc      as character    no-undo.
      386       define variable v-err           as logical      no-undo.
      387       define variable v-yesno         as logical      no-undo.
      388       if p-mode <> 'ПРОСМОТР':U
      389       then do:
      390           assign
      391               tg-have-import
      392           .
      393           run check-data in this-procedure (
      394                 output v-err-desc
      395               , output v-err
      396           ).
      397           if v-err = yes
      398           then do:
      399               message
      400                   "Ошибка ввода данных."
      401                   skip (1)
      402                   skip v-err-desc
      403                   skip (1)
      404                   skip "Исправьте данные или отмените ввод."
      405               view-as alert-box warning.
      406               undo, return no-apply.
      407           end.
      408           if v-oxmlextd-have-import = yes
      409           and v-oxmlextd-has-import = yes
      410           and tg-have-import        = no
      411           then do:
      412               message
      413                        "Для сохранения выбранных параметров"
      414                   skip "необходимо остановить импорт из внешней подсистемы."
      415                   skip "Будут удалены все данные по импорту из этой подсистемы."
      416                   skip (1)
      417                   skip "Внешняя подсистема:"
      418                   skip "  номер   " p-esys-id
      419                   skip "  БД номер" p-db-num
      420                   skip "  имя     " fi-name :screen-value
      421                   skip (1)
      422                   skip "Остановить импорт?"
      423               view-as alert-box information
      424               buttons yes-no
      425               title "Остановка импорта"
      426               update v-yesno.
      427               if v-yesno = yes
      428               then do:
      429                   run oxmlext-stop-import in this-procedure (
      430                         input p-esys-id
      431                       , input p-db-num
      432                   ).
      433               end.
      434               else do:
      435                   undo, return no-apply.
      436               end.
      437           end.
      438           if v-oxmlextd-have-export = yes
      439           and tg-have-export :screen-value = "no"
      440           then do:
      441               message
      442                        "Для сохранения выбранных параметров"
      443                   skip "необходимо остановить экспорт во внешнюю подсистему."
      444                   skip "Будут удалены все данные по экспорту в эту подсистему."
      445                   skip (1)
      446                   skip "Внешняя подсистема:"
      447                   skip "  номер   " p-esys-id
      448                   skip "  БД номер" p-db-num
      449                   skip "  имя     " fi-name :screen-value
      450                   skip (1)
      451                   skip "Остановить экспорт?"
      452               view-as alert-box information
      453               buttons yes-no
      454               title "Остановка экспорта"
      455               update v-yesno.
      456               if v-yesno = yes
      457               then do:
      458                   run oxmlext-stop-export in this-procedure (
      459                         input p-esys-id
      460                       , input p-db-num
      461                   ).
      462               end.
      463               else do:
      464                   undo, return no-apply.
      465               end.
      466           end.
      467           assign
      468               fi-name
      469               ed-des
      470               tg-have-export
      471               tg-have-import
      472               fi-db-num-exp
      473               tg-send-news-exp
      474               fi-num-days-keep-exp
      475               tg-spec
      476           .
      477           run assign-fields in this-procedure .
      478       end.
      479       assign
      480           p-success = yes
      481       .
      482   END.
      483   ON CHOOSE OF bt-types-exp IN FRAME Dialog-Frame
      484   DO:
      485       run bge/oxmlexty.w (
      486             input p-mainmenu-handle
      487           , input ( if p-mode = 'ПРОСМОТР':U then 0 else 1 )
      488           , input 'экспорт':U
      489           , input p-esys-id
      490           , input p-db-num
      491       ) no-error.
      492       if error-status :error
      493       then do:
      494           message
      495                    vss-workfile vss-revision vss-description
      496               skip(1)
      497               skip "Ошибка списка типов экспорта."
      498               skip return-value
      499               skip trim(error-status :get-message(1))
      500                    trim(error-status :get-message(2))
      501                    trim(error-status :get-message(3))
      502           view-as alert-box error.
      503           undo, return no-apply .
      504       end.
      505   END.
      506   ON VALUE-CHANGED OF tg-have-export IN FRAME Dialog-Frame
      507   DO:
      508       assign
      509           tg-have-export
      510       .
      511       run manage-export in this-procedure (
      512           input tg-have-export
      513       ).
      514   END.
      515   ON VALUE-CHANGED OF tg-have-import IN FRAME Dialog-Frame
      516   DO:
      517       assign
      518           tg-have-import
      519       .
      520   END.
      521   ON VALUE-CHANGED OF tg-spec IN FRAME Dialog-Frame
      522   DO:
      523       assign
      524           tg-spec
      525       .
      526       run manage-spec in this-procedure (
      527           input tg-spec
      528       ).
      529   END.
      530   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   on F2 of frame Dialog-Frame anywhere do:
      532     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      533     return no-apply.
      534   end.
      535   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      536   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      537   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   on help of frame Dialog-Frame
      539   do:
      540     run gbl/app_help.p
      541       (input this-procedure :file-name
      542       ,input ''
      543       ,input ?
      544       ) no-error.
      545     if error-status :error then do:
      546       message
      547         "Ошибка при вызове помощи"
      548         error-status :get-message(1)
      549         view-as alert-box .
      550     end.
      551   end.
      552   run minbtn-set in this-procedure .
      553   on choose of b-help in frame Dialog-Frame
      554   do:
      555     apply "help":u to frame Dialog-Frame .
      556   end.
      557   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure minbtn-set :
      559       do
      560           on error undo, return error return-value
      561           :
      562           define variable ii              as integer       no-undo .
      563           define variable fh              as widget-handle no-undo .
      564           define variable hh              as widget-handle no-undo .
      565           define variable v-h             as handle        extent 4 no-undo .
      566           define variable v-name-button   as character     no-undo .
      567           define variable v-help-old-x    as decimal       no-undo .
      568           define variable v-help-old-y    as decimal       no-undo .
      569           define variable v-help-old-size as decimal       no-undo .
      570           define variable v-frame-width   as decimal       no-undo .
      571           define variable jj              as integer       no-undo .
      572           do
      573               on error undo, return error
      574               :
      575               assign
      576                   v-frame-width = frame Dialog-Frame:width - 0.3
      577                   fh            = frame Dialog-Frame:first-child
      578                   hh            = fh:first-child
      579                   ii            = 1
      580                   .
      581               do while valid-handle(hh):
      582                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      583                   do:
      584                       case lc(hh:name) :
      585                           when "b-help" then
      586                               do:
      587                                   hh:load-image-up("cmp/b-help.bmp":u) .
      588                                   hh:load-image-down("cmp/b-help.bmp":u) .
      589                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      590                                   hh:TOOLTIP = "Помощь" .
      591                                   v-help-old-x = hh:column .
      592                                   v-help-old-y = hh:row    .
      593                                   v-help-old-size = hh:width .
      594                                   hh:width-chars = 2.5 .
      595                               end.
      596                           when "b-print" then
      597                               do:
      598                                   hh:load-image("cmp/b-print.bmp":u) .
      599                                   hh:TOOLTIP = "Печать" .
      600                                   v-h[ii] = hh:handle .
      601                                   ii = ii + 1 .
      602                                   hh:width-chars = 3 .
      603                               end.
      604                           when "b-history" or
      605                           when "b-hist" then
      606                               do:
      607                                   hh:load-image("cmp/b-hist.bmp":u) .
      608                                   hh:TOOLTIP = "История" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-sch" then
      614                               do:
      615                                   hh:load-image("cmp/b-sch.bmp":u) .
      616                                   hh:TOOLTIP = "Установка Фильтра" .
      617                                   v-h[ii] = hh:handle .
      618                                   ii = ii + 1 .
      619                                   hh:width-chars = 3 .
      620                               end.
      621                           when "b-hist-user" then
      622                               do:
      623                                   hh:load-image("cmp/b-hist.bmp":u) .
      624                                   hh:TOOLTIP = "История пользователя" .
      625                                   ii = ii + 1 .
      626                               end.
      627                       end case.
      628                   end.
      629                   hh = hh:next-sibling.
      630               end.
      631               b-help:column = v-frame-width - b-help:width-chars.
      632               jj = 0.
      633               repeat ii = 4 to 1 by -1 :
      634                   if valid-handle (v-h[ii] ) then
      635                   do:
      636                       jj  = jj + 1 .
      637                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      638                       v-h[ii]:row    = v-help-old-y .
      639                   end.
      640               end.
      641           end.
      642       end.
      643   end procedure.
      644   MAIN-BLOCK:
      645   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      646      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      647       run init-fields in this-procedure .
      648       RUN enable_UI.
      649       run disable-all in this-procedure .
      650       run ui-enable in this-procedure .
      651     WAIT-FOR GO OF FRAME Dialog-Frame.
      652   END.
      653   RUN disable_UI.
      654   PROCEDURE assign-fields :
      655       define buffer buf_ext-system        for ub.ext-system.
      656   do
      657   for buf_ext-system
      658   on error undo, return error
      659   :
      660       find first buf_ext-system exclusive-lock
      661            where buf_ext-system.esys-id = p-esys-id
      662       .
      663       assign
      664           buf_ext-system.esys-name                       = fi-name
      665           buf_ext-system.esys-des                        = ed-des
      666           buf_ext-system.esys-have-export                = tg-have-export
      667           buf_ext-system.esys-have-import                = tg-have-import
      668           buf_ext-system.esys-db-num-exp                 = fi-db-num-exp
      669           buf_ext-system.esys-send-news-exp              = tg-send-news-exp
      670           buf_ext-system.esys-num-days-keep-exp          = fi-num-days-keep-exp
      671       .
      672       if p-mode = 'ДОБАВЛЕНИЕ':U
      673       then do:
      674           if tg-spec = yes
      675           then do:
      676               assign
      677                   buf_ext-system.esys-type = integer('1':U)
      678               .
      679           end.
      680           else do:
      681               assign
      682                   buf_ext-system.esys-type = integer('0':U)
      683               .
      684           end.
      685       end.
      686   end.
      687   END PROCEDURE.
      688   PROCEDURE check-data :
      689   define output parameter p-error-desc    as character        no-undo.
      690   define output parameter p-error         as logical          no-undo.
      691   do
      692   with frame Dialog-Frame
      693   on error undo, return error
      694   :
      695       if p-current-db-num <> 0
      696       then do:
      697           if fi-db-num-exp :sensitive = yes
      698           and integer( fi-db-num-exp ) <> p-current-db-num
      699           then do:
      700               assign
      701                   p-error      = yes
      702                   p-error-desc = substitute( "&2&1&3"
      703                                   , chr(10)
      704                                   , "Номер базы данных для экспорта"
      705                                   , "не равен номеру текущей базы данных." )
      706               .
      707           end.
      708       end.
      709   end.
      710   END PROCEDURE.
      711   PROCEDURE disable-all :
      712   do
      713   with frame Dialog-Frame
      714   on error undo, return error
      715   :
      716       disable
      717           all
      718           except
      719               b-exit
      720               b-help
      721       .
      722   end.
      723   END PROCEDURE.
      724   PROCEDURE disable_UI :
      725     HIDE FRAME Dialog-Frame.
      726   END PROCEDURE.
      727   PROCEDURE enable_UI :
      728     DISPLAY fi-name fi-des-label ed-des tg-spec tg-have-export fi-db-num-exp
      729             tg-send-news-exp fi-num-days-keep-exp tg-have-import fi-esys-id
      730         WITH FRAME Dialog-Frame.
      731     ENABLE b-exit b-cancel b-help RECT-1 RECT-2 fi-name ed-des tg-spec
      732            tg-have-export fi-db-num-exp tg-send-news-exp fi-num-days-keep-exp
      733            bt-types-exp tg-have-import
      734         WITH FRAME Dialog-Frame.
      735     VIEW FRAME Dialog-Frame.
      736   END PROCEDURE.
      737   PROCEDURE init-fields :
      738       define buffer buf_ext-system        for ub.ext-system.
      739   do
      740   for buf_ext-system
      741   on error undo, return error
      742   :
      743       assign
      744           fi-esys-id = p-esys-id
      745       .
      746       assign
      747           p-success = no
      748       .
      749       find first buf_ext-system exclusive-lock
      750            where buf_ext-system.esys-id = p-esys-id
      751              and buf_ext-system.db-num  = p-db-num
      752       no-error.
      753       if not available buf_ext-system
      754       then do:
      755           message
      756                    vss-workfile vss-revision vss-description
      757               skip(1)
      758               skip "Не удаётся получить запись внешней подсистемы"
      759               skip "для изменения."
      760           view-as alert-box error.
      761           undo, return error .
      762       end.
      763       assign
      764           fi-name                        = buf_ext-system.esys-name
      765           ed-des                         = buf_ext-system.esys-des
      766           tg-have-export                 = buf_ext-system.esys-have-export
      767           tg-have-import                 = buf_ext-system.esys-have-import
      768           fi-db-num-exp                  = buf_ext-system.esys-db-num-exp
      769           tg-send-news-exp               = buf_ext-system.esys-send-news-exp
      770           fi-num-days-keep-exp           = buf_ext-system.esys-num-days-keep-exp
      771           tg-spec                        = ( buf_ext-system.esys-type = 1 )
      772           v-oxmlextd-has-import              = buf_ext-system.esys-have-import
      773       .
      774       if tg-spec = yes
      775       then do:
      776           assign
      777               v-oxmlextd-can-change-exp   = no
      778               v-oxmlextd-have-export      = no
      779               tg-have-export              = no
      780           .
      781           if p-current-db-num = 0
      782           then do:
      783               assign
      784                   v-oxmlextd-have-import      = buf_ext-system.esys-have-import
      785                   v-oxmlextd-can-change-imp   = yes
      786               .
      787           end.
      788           else do:
      789               assign
      790                   v-oxmlextd-have-import      = no
      791                   v-oxmlextd-can-change-imp   = no
      792               .
      793           end.
      794       end.
      795       else do:
      796           assign
      797               v-oxmlextd-have-export      = tg-have-export
      798               v-oxmlextd-have-import      = no
      799               v-oxmlextd-can-change-imp   = no
      800           .
      801           assign
      802               v-oxmlextd-can-change-exp       = no
      803               v-oxmlextd-can-change-db-exp    = no
      804           .
      805           if p-current-db-num = 0
      806           then do:
      807               assign
      808                   v-oxmlextd-can-change-exp       = yes
      809                   v-oxmlextd-can-change-db-exp    = yes
      810               .
      811           end.
      812           else do:
      813               assign
      814                   v-oxmlextd-can-change-db-exp    = no
      815               .
      816               if buf_ext-system.esys-db-num-exp = p-current-db-num
      817               then do:
      818                   assign
      819                       v-oxmlextd-can-change-exp       = yes
      820                   .
      821               end.
      822               else do:
      823                   assign
      824                       v-oxmlextd-can-change-exp       = no
      825                   .
      826               end.
      827           end.
      828       end.
      829   end.
      830   END PROCEDURE.
      831   PROCEDURE manage-export :
      832   define input parameter p-have-export    as logical          no-undo.
      833   do
      834   with frame Dialog-Frame
      835   on error undo, return error
      836   :
      837       if p-have-export = yes
      838       then do:
      839           if v-oxmlextd-can-change-db-exp = yes
      840           then do:
      841               enable
      842                   fi-db-num-exp
      843               .
      844           end.
      845           else do:
      846               disable
      847                   fi-db-num-exp
      848               .
      849           end.
      850           enable
      851               tg-send-news-exp
      852               fi-num-days-keep-exp
      853               bt-types-exp
      854           .
      855       end.
      856       else do:
      857           disable
      858               fi-db-num-exp
      859               tg-send-news-exp
      860               fi-num-days-keep-exp
      861               bt-types-exp
      862           .
      863       end.
      864   end.
      865   END PROCEDURE.
      866   PROCEDURE manage-spec :
      867   define input parameter p-spec   as logical     no-undo.
      868   do
      869   with frame Dialog-Frame
      870   on error undo, return error
      871   :
      872       if p-spec = yes
      873       then do:
      874           disable
      875               tg-have-export
      876               fi-db-num-exp
      877               tg-send-news-exp
      878               tg-send-news-exp
      879               fi-num-days-keep-exp
      880               bt-types-exp
      881           .
      882           enable
      883               fi-num-days-keep-exp
      884           .
      885       end.
      886       else do:
      887           enable
      888               tg-have-export
      889               fi-db-num-exp
      890               tg-send-news-exp
      891               tg-send-news-exp
      892               fi-num-days-keep-exp
      893               bt-types-exp
      894           .
      895           run manage-export in this-procedure (
      896               input tg-have-export
      897           ).
      898       end.
      899   end.
      900   END PROCEDURE.
      901   PROCEDURE ui-enable :
      902   do
      903   with frame Dialog-Frame
      904   on error undo, return error
      905   :
      906       if tg-spec = yes
      907       then do:
      908           display
      909               tg-have-import
      910           .
      911           if p-mode = 'ДОБАВЛЕНИЕ':U
      912           or p-mode = 'ИЗМЕНЕНИЕ':U
      913           then do:
      914               enable
      915                   tg-have-import
      916               .
      917           end.
      918           else do:
      919               disable
      920                   tg-have-import
      921               .
      922           end.
      923       end.
      924       else do:
      925           hide
      926               tg-have-import
      927           .
      928       end.
      929       case p-mode
      930       :
      931           when 'ДОБАВЛЕНИЕ':U
      932           then do:
      933               enable
      934                   b-cancel
      935                   fi-name
      936                   ed-des
      937                   fi-num-days-keep-exp
      938               .
      939               if v-oxmlextd-can-change-exp = yes
      940               then do:
      941                   enable
      942                       tg-have-export
      943                   .
      944                   run manage-export in this-procedure (
      945                       input tg-have-export
      946                   ).
      947               end.
      948           end.
      949           when 'ИЗМЕНЕНИЕ':U
      950           then do:
      951               enable
      952                   b-cancel
      953                   fi-name
      954                   ed-des
      955                   fi-num-days-keep-exp
      956               .
      957               if v-oxmlextd-can-change-exp    = yes
      958               and tg-spec                     = no
      959               then do:
      960                   enable
      961                       tg-have-export
      962                   .
      963                   run manage-export in this-procedure (
      964                       input tg-have-export
      965                   ).
      966               end.
      967           end.
      968           when 'ПРОСМОТР':U
      969           then do:
      970               assign
      971                   b-exit   :label     = "В&ыход"
      972                   b-cancel :visible   = no
      973               .
      974               if tg-have-export   = yes
      975               and tg-spec         = no
      976               then do:
      977                   enable
      978                       bt-types-exp
      979                   .
      980               end.
      981           end.
      982           otherwise do:
      983               message
      984                   "Указанный режим просмотра записи некорректен."
      985               view-as alert-box error
      986               title vss-description.
      987               undo, return error.
      988           end.
      989       end case.
      990   end.
      991   END PROCEDURE.
