        1   DEFINE TEMP-TABLE tt-goods NO-UNDO LIKE bar-code
        2      field gds-name  as character
        3      field barcode   as character
        4      field GTIN      as character
        5      field qnty      as integer
        6      field type-mark as character
        7      index pi as UNIQUE gds-code barcode GTIN.
        8   define input parameter parparentproc as widget-handle no-undo .
        9   define input-output parameter table for tt-goods .
       10   define input parameter p-type-mark as character no-undo .
       11   define output parameter p-recid as recid  no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Сбор данных по GTIN и штрих-кодам".
       18   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       19   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21     define variable v-cntxt-db-num        as integer   no-undo .
       22     define variable v-cntxt-userid        as character no-undo .
       23     define variable v-cntxt-level         as character no-undo .
       24     define variable v-cntxt-host-code-obj as integer   no-undo .
       25     define variable v-cntxt-obj-type      as character no-undo .
       26     define variable v-cntxt-obj-code      as integer   no-undo .
       27     define variable v-cntxt-db-num-obj    as integer   no-undo .
       28     define variable v-cntxt-is-admin      as logical   no-undo .
       29   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       30     run mainmenu_getcntxt in parparentproc
       31       (output v-cntxt-db-num
       32       ,output v-cntxt-userid
       33       ,output v-cntxt-level
       34       ,output v-cntxt-host-code-obj
       35       ,output v-cntxt-obj-type
       36       ,output v-cntxt-obj-code
       37       ,output v-cntxt-db-num-obj
       38       ,output v-cntxt-is-admin
       39       ) .
       40   procedure vss-get-info :
       41     define output parameter p-vss-revision    like vss-revision    no-undo .
       42     define output parameter p-vss-author      like vss-author      no-undo .
       43     define output parameter p-vss-date        like vss-date        no-undo .
       44     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       45     define output parameter p-vss-archive     like vss-archive     no-undo .
       46     define output parameter p-vss-description like vss-description no-undo .
       47     assign
       48       p-vss-revision    = vss-revision
       49       p-vss-author      = vss-author
       50       p-vss-date        = vss-date
       51       p-vss-workfile    = vss-workfile
       52       p-vss-archive     = vss-archive
       53       p-vss-description = vss-description
       54     .
       55   end procedure.
       56   procedure vss-get-parameters :
       57     define output parameter p-vss-parameters as character no-undo .
       58   end procedure.
       59   define new global shared variable g#vssrevis-logger as handle    no-undo .
       60   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       61   define variable v-vssrevis-logger                   as handle    no-undo .
       62   procedure vss-logevent :
       63     define input  parameter p-extra-paramters as character no-undo .
       64     define variable v-vssrevis-parameters as character no-undo .
       65     do
       66     on error undo, return error return-value
       67     :
       68       if  valid-handle(v-vssrevis-logger)
       69       and v-vssrevis-logger :get-signature("logevent") <> ""
       70       then do:
       71         run vss-get-parameters in this-procedure
       72           (output v-vssrevis-parameters
       73           ).
       74         run logevent in v-vssrevis-logger
       75           (input vss-workfile
       76           ,input vss-revision
       77           ,input v-vssrevis-parameters
       78           ,input p-extra-paramters
       79           ).
       80       end.
       81     end.
       82   end procedure.
       83   assign
       84     v-vssrevis-logger = g#vssrevis-logger
       85   .
       86   if  valid-handle(v-vssrevis-logger)
       87   and v-vssrevis-logger :get-signature("logevent") <> ""
       88   then do:
       89     assign
       90       v-vssrevis-logevent = true
       91     .
       92     run vss-logevent in this-procedure (input vss-description) .
       93   end.
       94   define new global shared variable g#language as character no-undo .
       95   if g#language <> '' and g#language <> 'rus':U then do:
       96     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       97   end.
       98   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define new global shared variable g#attr-lib  as handle no-undo .
      100   define variable v-attr-lib-variable as handle no-undo .
      101   procedure gds-attr-name :
      102     define input  parameter p-code           as character no-undo .
      103     define output parameter p-type           as character no-undo .
      104     define output parameter p-format         as character no-undo .
      105     define output parameter p-label          as character no-undo .
      106     define output parameter p-user-can-edit  as logical   no-undo .
      107     define output parameter p-output-display as logical   no-undo .
      108     define output parameter p-other          as character no-undo .
      109     do
      110     on error undo, return error
      111     :
      112           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      113         (input  p-code
      114         ,output p-type
      115         ,output p-format
      116         ,output p-label
      117         ,output p-user-can-edit
      118         ,output p-output-display
      119         ,output p-other
      120         ) no-error .
      121       if error-status :error
      122       then do:
      123         undo, return error return-value .
      124       end.
      125     end.
      126   end procedure.
