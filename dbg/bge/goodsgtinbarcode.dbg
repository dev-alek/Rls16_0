      680   procedure proc-alt-shift-f2:
      681     if not ibs.th.gbl.gbl-var:rcode
      682   then
      683     run gbl\inidebug.p .
      684   end.
      685   procedure proc-alt-shift-f3:
      686     run gbl/prvssinf.p
      687       ( input this-procedure
      688       ) .
      689   end.
      690   define variable v-inform-launched as logical no-undo initial false .
      691   procedure proc-alt-shift-f4:
      692     define variable v-action as character no-undo .
      693     if v-inform-launched = false then do:
      694       assign
      695         v-inform-launched = true
      696       .
      697       run gbl/d-inform.w
      698         (  input self
      699         ,  input this-procedure
      700         , output v-action
      701         ) no-error .
      702       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      703       assign
      704         v-inform-launched = false
      705       .
      706     end.
      707   end.
      708   procedure proc-alt-f1:
      709     run gbl/corrhelp.p
      710       (input this-procedure
      711       ) .
      712   end .
      713   on alt-shift-f2 anywhere do:
      714     run proc-alt-shift-f2.
      715   end.
      716   on alt-shift-f3 anywhere do:
      717     run proc-alt-shift-f3 in this-procedure .
      718   end.
      719   on alt-shift-f4 anywhere do:
      720     run proc-alt-shift-f4 in this-procedure.
      721   end.
      722   on alt-f1 anywhere do:
      723     run proc-alt-f1 in this-procedure .
      724   end.
      725   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   function is-numeral return logical
      727     (input p-string   as character ,
      728      input char-avail as character) :
      729     define variable p-replace-string as character no-undo .
      730     define variable log-result       as logical  no-undo .
      731     if p-string = ? then
      732       return false .
      733     p-replace-string = p-string.
      734     if lookup ("*", char-avail) > 0 then
      735         p-replace-string = replace (p-replace-string, '*', '9').
      736     if lookup ("digit", char-avail) > 0 then
      737       assign
      738         p-replace-string = replace (p-replace-string, '0', '9')
      739         p-replace-string = replace (p-replace-string, '1', '9')
      740         p-replace-string = replace (p-replace-string, '2', '9')
      741         p-replace-string = replace (p-replace-string, '3', '9')
      742         p-replace-string = replace (p-replace-string, '4', '9')
      743         p-replace-string = replace (p-replace-string, '5', '9')
      744         p-replace-string = replace (p-replace-string, '6', '9')
      745         p-replace-string = replace (p-replace-string, '7', '9')
      746         p-replace-string = replace (p-replace-string, '8', '9')
      747         .
      748     else
      749        p-replace-string = replace (p-replace-string, '9', chr(15))
      750         .
      751     if lookup ("letter", char-avail) > 0 then
      752       assign
      753         p-replace-string = replace (p-replace-string, 'A', '9')
      754         p-replace-string = replace (p-replace-string, 'B', '9')
      755         p-replace-string = replace (p-replace-string, 'C', '9')
      756         p-replace-string = replace (p-replace-string, 'D', '9')
      757         p-replace-string = replace (p-replace-string, 'E', '9')
      758         p-replace-string = replace (p-replace-string, 'F', '9')
      759         p-replace-string = replace (p-replace-string, 'G', '9')
      760         p-replace-string = replace (p-replace-string, 'H', '9')
      761         p-replace-string = replace (p-replace-string, 'I', '9')
      762         p-replace-string = replace (p-replace-string, 'J', '9')
      763         p-replace-string = replace (p-replace-string, 'K', '9')
      764         p-replace-string = replace (p-replace-string, 'L', '9')
      765         p-replace-string = replace (p-replace-string, 'M', '9')
      766         p-replace-string = replace (p-replace-string, 'N', '9')
      767         p-replace-string = replace (p-replace-string, 'O', '9')
      768         p-replace-string = replace (p-replace-string, 'P', '9')
      769         p-replace-string = replace (p-replace-string, 'Q', '9')
      770         p-replace-string = replace (p-replace-string, 'R', '9')
      771         p-replace-string = replace (p-replace-string, 'S', '9')
      772         p-replace-string = replace (p-replace-string, 'T', '9')
      773         p-replace-string = replace (p-replace-string, 'U', '9')
      774         p-replace-string = replace (p-replace-string, 'V', '9')
      775         p-replace-string = replace (p-replace-string, 'W', '9')
      776         p-replace-string = replace (p-replace-string, 'X', '9')
      777         p-replace-string = replace (p-replace-string, 'Y', '9')
      778         p-replace-string = replace (p-replace-string, 'Z', '9')
      779         p-replace-string = replace (p-replace-string, '_', '9')
      780         .
      781     return p-replace-string = fill ('9', length (p-string)).
      782   end.
      783   define variable v-scan-str as character no-undo.
      784   define variable iLang      as integer   no-undo.
      785   define variable p-value-logical as logical no-undo.
      786   define variable p-value-character  as character no-undo.
      787   define variable p-value-date       as date no-undo.
      788   define variable p-value-decimal    as decimal no-undo.
      789   define variable p-value-integer    as integer no-undo.
      790   define variable p-param-type       as character no-undo.
      791   define variable v-tth as handle no-undo .
      792   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      793      LABEL "Отмена"
      794      SIZE 10 BY 1 .
      795   DEFINE BUTTON Btn_OK AUTO-GO
      796      LABEL "Ввод"
      797      SIZE 10 BY 1.
      798   DEFINE VARIABLE f-type-mark AS CHARACTER FORMAT "X(256)"
      799      LABEL "Тип маркировки"
      800      VIEW-AS COMBO-BOX INNER-LINES 5
      801      LIST-ITEM-PAIRS "","not-type",
      802      "Табачная продукция","tabak",
      803      "Обувь","shoes",
      804      "Духи и парфюмерия","perfume",
      805      "Легпром","industry",
      806      "Шины","tires",
      807      "Лекарства","apteka",
      808      "Фотокамеры/фотовспышки","photo",
      809      "Молочная продукция","milk",
      810      "Упакованная вода","water",
      811      "Стики","stiki"
      812      DROP-DOWN-LIST
      813      SIZE 33.5 BY 1.
      814   DEFINE VARIABLE f-bar-code  AS CHARACTER FORMAT "X(256)"
      815      LABEL "Штрих-код"
      816      VIEW-AS FILL-IN
      817      SIZE 33.5 BY 1.
      818   DEFINE VARIABLE f-gds-code  AS INTEGER   FORMAT ">>>>>>>>>>>>>>>9"
      819      LABEL "Код товара"
      820      VIEW-AS FILL-IN
      821      SIZE 33.5 BY 1.
      822   DEFINE VARIABLE f-gds-name  AS CHARACTER FORMAT "X(256)"
      823      LABEL "Название товара"
      824      VIEW-AS FILL-IN
      825      SIZE 33.5 BY 1.
      826   DEFINE VARIABLE f-GTIN      AS CHARACTER FORMAT "X(256)"
      827      LABEL "GTIN"
      828      VIEW-AS FILL-IN
      829      SIZE 33.5 BY 1.
      830   DEFINE VARIABLE f-qnty AS INTEGER FORMAT "->,>>>,>>9" INITIAL 1
      831        LABEL "Кол-во индивидуальных упаковок"
      832        VIEW-AS FILL-IN
      833        SIZE 14 BY 1.
      834   DEFINE FRAME Dialog-Frame
      835        Btn_OK AT ROW 1.25 COL 2
      836        Btn_Cancel AT ROW 1.25 COL 12
      837        f-gds-code AT ROW 3 COL 32 COLON-ALIGNED WIDGET-ID 12
      838        f-gds-name AT ROW 4.46 COL 32 COLON-ALIGNED WIDGET-ID 14
      839        f-bar-code AT ROW 5.92 COL 32 COLON-ALIGNED WIDGET-ID 16
      840        f-GTIN AT ROW 7.38 COL 32 COLON-ALIGNED WIDGET-ID 18
      841        f-qnty AT ROW 8.75 COL 32 COLON-ALIGNED WIDGET-ID 20
      842        f-type-mark AT ROW 10.29 COL 32 COLON-ALIGNED WIDGET-ID 22
      843        SPACE(1.62) SKIP(1.45)
      844       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      845            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      846            TITLE "Товар для ввода".
      847   ASSIGN
      848      FRAME Dialog-Frame:SCROLLABLE = FALSE.
      849   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      850      DO:
      851         run create-proc in this-procedure no-error .
      852         if error-status:error then return no-apply .
      853      END.
      854   ON ENTRY OF f-bar-code IN FRAME Dialog-Frame
      855      DO:
      856         run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      857         run adm/shattri.p (
      858                  input "get":U
      859                  ,input  v-cntxt-obj-type
      860                  ,input  v-cntxt-obj-code
      861                  ,input  'marking':U
      862                  ,input  'rus-key':U
      863                  ,output p-value-character
      864                  ,output p-value-date
      865                  ,output p-value-decimal
      866                  ,output p-value-integer
      867                  ,output p-value-logical
      868                  ,output p-param-type
      869                  ,input-output table-handle v-tth
      870                  ) no-error .
      871         IF p-value-logical = yes THEN  iLang = 68748313.
      872         run ActivateKeyboardLayout (input iLang, input 0).
      873      END.
      874   ON value-changed OF f-type-mark IN FRAME Dialog-Frame
      875      DO:
      876         assign f-type-mark .
      877      END.
      878   ON return,TAB,LEAVE OF f-bar-code IN FRAME Dialog-Frame
      879      DO:
      880         run scan-barCode .
      881         if return-value = 'cancel'
      882         then do:
      883            self:screen-value = "".
      884            return no-apply .
      885         end.
      886         apply "entry" to f-gtin IN FRAME Dialog-Frame.
      887   return no-apply.
      888      END.
      889   ON ENTRY OF f-GTIN IN FRAME Dialog-Frame
      890      DO:
      891         run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      892         run adm/shattri.p (
      893                  input "get":U
      894                  ,input  v-cntxt-obj-type
      895                  ,input  v-cntxt-obj-code
      896                  ,input  'marking':U
      897                  ,input  'rus-key':U
      898                  ,output p-value-character
      899                  ,output p-value-date
      900                  ,output p-value-decimal
      901                  ,output p-value-integer
      902                  ,output p-value-logical
      903                  ,output p-param-type
      904                  ,input-output table-handle v-tth
      905                  ) no-error .
      906         IF p-value-logical = yes THEN  iLang = 68748313.
      907         run ActivateKeyboardLayout (input iLang, input 0).
      908      END.
      909   ON LEAVE OF f-GTIN IN FRAME Dialog-Frame
      910      DO:
      911         define variable vTXt     as character no-undo .
      912         define variable bar_code as character no-undo .
      913         vTXt = f-GTIN:screen-value.
      914         if    length(vtxt) > 14
      915            then
      916         do:
      917            if    (length(vtxt) eq 14 + 7 + 4 + 4
      918               or length(vtxt) eq 14 + 7 + 4 )
      919               then
      920               f-GTIN:screen-value = substring(vtxt,1,14).
      921            else if vtxt begins "01"
      922                  then
      923                  f-GTIN:screen-value = substring(vtxt,3,14).
      924               else
      925               do:
      926               end.
      927         end.
      928         if length(f-GTIN:screen-value) ne 14
      929         then do:
      930            self:screen-value = "".
      931            message "Введенный код не Gtin. Gtin состоит из 14 символов."
      932               view-as alert-box.
      933            return no-apply.
      934         end.
      935         bar_code = substr (f-GTIN:screen-value, 1, length (f-GTIN:screen-value) - 1).
      936         run str/chk-sum.p
      937            (input-output bar_code
      938            ) no-error .
      939         if error-status :error
      940            then
      941         do:
      942            self:screen-value = "".
      943            message "Бар-код должен быть GTIN."
      944               view-as alert-box.
      945            return no-apply .
      946         end.
      947         if substr (bar_code, length (bar_code), 1) <> substr (f-GTIN:screen-value, length (bar_code), 1)
      948            then
      949         do:
      950            message "Бар-код должен быть GTIN."
      951               view-as alert-box.
      952            if session:debug-alert
      953               then
      954               message " Ваш код " + f-GTIN:screen-value + " Правильный GTIN " + bar_code
      955                  view-as alert-box.
      956            self:screen-value = "".
      957            return no-apply .
      958         end.
      959         assign f-GTIN .
      960      END.
      961   ON return,tab OF f-GTIN IN FRAME Dialog-Frame
      962     DO:
      963       apply "entry" to f-type-mark IN FRAME Dialog-Frame.
      964       return no-apply.
      965     END.
      966   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      967      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      968   MAIN-BLOCK:
      969   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      970      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      971       run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      972       run adm/shattri.p (
      973                  input "get":U
      974                  ,input  v-cntxt-obj-type
      975                  ,input  v-cntxt-obj-code
      976                  ,input  'marking':U
      977                  ,input  'rus-key':U
      978                  ,output p-value-character
      979                  ,output p-value-date
      980                  ,output p-value-decimal
      981                  ,output p-value-integer
      982                  ,output p-value-logical
      983                  ,output p-param-type
      984                  ,input-output table-handle v-tth
      985                  ) no-error .
      986         IF p-value-logical = yes THEN  iLang = 68748313.
      987       run ActivateKeyboardLayout (input iLang, input 0).
      988       run init-proc.
      989      f-type-mark = p-type-mark .
      990      for each tt-goods where gds-code = 0:
      991         delete tt-goods .
      992      end.
      993      RUN enable_UI.
      994      WAIT-FOR GO OF FRAME Dialog-Frame focus f-bar-code.
      995   END.
      996   RUN disable_UI.
      997   procedure LoadKeyboardLayoutA external "user32" :
      998      define input  parameter P1 as char.
      999      define input  parameter P2 as LONG.
     1000      define return parameter pret as LONG.
     1001   end procedure.
     1002   procedure ActivateKeyboardLayout external "user32" :
     1003      define input parameter P1 as LONG.
     1004      define input parameter P2 as LONG.
     1005   END PROCEDURE.
     1006   PROCEDURE create-proc :
     1007      if f-GTIN = "" or f-qnty = 0 or f-qnty = ? or f-bar-code = "" then
     1008      do:
     1009         message "Не все поля заполнены, сохранение не возможно"
     1010            view-as alert-box.
     1011         return error .
     1012      end.
     1013      display
     1014      f-bar-code
     1015      f-gds-code
     1016      f-gds-name
     1017      f-GTIN
     1018      f-qnty
     1019      f-type-mark
     1020      with frame Dialog-Frame .
     1021      find first tt-goods no-lock where tt-goods.gds-code = f-gds-code and
     1022         tt-goods.GTIN = f-GTIN no-error .
     1023      if not available (tt-goods) then
     1024      do:
     1025         create tt-goods .
     1026         assign
     1027            tt-goods.barcode  = f-bar-code
     1028            tt-goods.gds-code  = f-gds-code
     1029            tt-goods.gds-name  = f-gds-name
     1030            tt-goods.GTIN      = f-GTIN
     1031            tt-goods.qnty      = f-qnty
     1032            .
     1033            tt-goods.type-mark = f-type-mark:screen-value in frame Dialog-Frame
     1034            .
     1035         p-recid = recid (tt-goods) .
     1036      end.
     1037      else
     1038      do:
     1039         p-recid = recid (tt-goods) .
     1040         message "Данные уже сохранены"
     1041            view-as alert-box.
     1042         return error .
     1043      end.
     1044   END PROCEDURE.
     1045   PROCEDURE disable_UI :
     1046      HIDE FRAME Dialog-Frame.
     1047   END PROCEDURE.
     1048   PROCEDURE init-proc :
     1049   define variable v-list as character no-undo.
     1050   define variable vi as integer no-undo.
     1051   define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     1052   define variable objType  as ibs.th.gbl.propmap no-undo.
     1053   MarkType = ObjSrv:Env:Marking:Types:MAPTYPE.
     1054   do vi = 1 to MarkType:GetItemByLab(vi):
     1055   objType  = ObjSrv:Env:Marking:Types:CurrProp.
     1056       v-list = v-list + "," + objType:Label_ + "," + objType:NameProp.
     1057   end.
     1058   v-list = trim(v-list, ",").
     1059   f-type-mark:list-item-pairs in frame Dialog-Frame = v-list.
     1060   END PROCEDURE.
     1061   PROCEDURE enable_UI :
     1062      DISPLAY f-gds-code f-gds-name f-bar-code f-GTIN f-qnty f-type-mark
     1063         WITH FRAME Dialog-Frame.
     1064      ENABLE Btn_OK Btn_Cancel f-bar-code
     1065         WITH FRAME Dialog-Frame.
     1066   END PROCEDURE.
     1067   PROCEDURE scan-barCode :
     1068      define variable v_list    as character no-undo .
     1069      define variable ii        as integer   no-undo .
     1070      define variable v-barCode as character no-undo .
     1071      define buffer buf_goods         for ub.goods .
     1072      define buffer buf_bar-code      for ub.bar-code .
     1073      define buffer buf_bar-code-attr for ub.bar-code-attr .
     1074      define buffer buf_prod-bc       for ub.prod-bc .
     1075      define buffer buf_prod-bc-attr  for ub.prod-bc-attr.
     1076      define buffer buf_goods-attr    for ub.goods-attr .
     1077      define buffer base-bar-code     for ub.bar-code.
     1078      define variable v-rid            as recid     no-undo .
     1079      define variable v-b-str          like ub.prod-bc.b-str no-undo .
     1080      define variable v-gds-attr-type  as character no-undo .
     1081      define variable v-gds-attr-value as character no-undo .
     1082      if f-bar-code:screen-value in frame Dialog-Frame = ""
     1083         then
     1084      do:
     1085         f-bar-code:screen-value in frame Dialog-Frame = v-scan-str.
     1086      end.
     1087      v-scan-str = "".
     1088      assign
     1089         v-barCode = f-bar-code:screen-value in frame Dialog-Frame.
     1090      if not is-numeral (v-barCode,"digit")
     1091      then do:
     1092         message "Просканируйте штрих-код."
     1093         view-as alert-box.
     1094         f-bar-code = "" .
     1095         display f-bar-code with frame Dialog-Frame .
     1096         return 'cancel' .
     1097      end.
     1098      find first buf_prod-bc exclusive-lock where buf_prod-bc.b-str = string(v-barCode) no-error .
     1099      if not available (buf_prod-bc) then
     1100      do:
     1101         message "Штрих-код не найден в БД"
     1102            view-as alert-box.
     1103         f-bar-code = "" .
     1104         display f-bar-code with frame Dialog-Frame .
     1105         return 'cancel' .
     1106      end.
     1107      find first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code and
     1108         buf_bar-code.cli-base-rate = f-qnty no-error .
     1109      if not available (buf_bar-code) then
     1110      do:
     1111         message "Штрих-код не найден в БД"
     1112            view-as alert-box.
     1113         f-bar-code = "" .
     1114         display f-bar-code with frame Dialog-Frame .
     1115         return 'cancel' .
     1116      end.
     1117      for first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     1118         f-gds-code = buf_goods.gds-code .
     1119         f-gds-name = buf_goods.gds-name .
     1120         f-qnty = buf_bar-code.cli-base-rate .
     1121         f-bar-code = v-barCode .
     1122         RUN gds-attr-value (
     1123            INPUT buf_goods.gds-code,
     1124            INPUT 'mark-type':U,
     1125            OUTPUT v-gds-attr-value,
     1126            OUTPUT v-gds-attr-type
     1127            ).
     1128         f-type-mark = v-gds-attr-value .
     1129         display
     1130            f-bar-code
     1131            f-gds-code
     1132            f-gds-name
     1133            f-qnty
     1134            f-type-mark
     1135            with frame Dialog-Frame .
     1136         enable
     1137            f-GTIN
     1138            f-type-mark
     1139            with frame Dialog-Frame .
     1140      end.
     1141   end.
