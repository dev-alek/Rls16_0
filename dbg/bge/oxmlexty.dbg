     1685               assign
     1686                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1687                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1688               .
     1689             end.
     1690           end.
     1691           assign
     1692             v-object-handle = v-object-handle :next-sibling
     1693           .
     1694         end.
