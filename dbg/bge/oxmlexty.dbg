     1466     .
     1467   end procedure.
     1468   procedure diasize_set-height :
     1469     define input  parameter p-new-height  as decimal   no-undo .
     1470     define input  parameter p-move-resize as logical   no-undo .
     1471     do
     1472     on error undo, return error return-value
     1473     :
     1474       run diasize_change-height in this-procedure
     1475         (input  (p-new-height - frame Dialog-Frame :height)
     1476         ,input  p-move-resize
     1477         ) .
     1478     end.
     1479   end procedure.
     1480   procedure diasize_change-width :
     1481     define input  parameter p-change-value as decimal   no-undo .
     1482     define input  parameter p-move-resize  as logical   no-undo .
     1483     define variable v-field-group-handle   as handle    no-undo .
     1484     define variable v-object-handle        as handle    no-undo .
     1485     define variable v-frame-width          as decimal   no-undo .
     1486     define variable v-frame-virtual-width  as decimal   no-undo .
     1487     define variable v-browse-width         as decimal   no-undo .
     1488     define variable v-window-width         as decimal   no-undo .
     1489     define variable v-window-virtual-width as decimal   no-undo .
     1490     define variable v-change-sign          as integer   no-undo .
     1491     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1492     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1493     if p-change-value > 0
     1494     then do:
     1495       if frame Dialog-Frame :width + p-change-value >
     1496           session :width-chars
     1497       then do:
     1498         assign
     1499           p-change-value = session :width-chars - frame Dialog-Frame :width
     1500         .
     1501         if p-change-value <= 0
     1502         then do:
     1503           run diasize_position-resize-button in this-procedure .
     1504           return .
     1505         end.
     1506       end.
     1507     end.
     1508     if p-change-value < 0
     1509     then do:
     1510       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1511       then do:
     1512         assign
     1513           p-change-value = v-diasize-orig-frame-width
     1514                          - frame Dialog-Frame :width
     1515         .
     1516         if p-change-value >= 0
     1517         then do:
     1518           run diasize_position-resize-button in this-procedure .
     1519           return .
     1520         end.
     1521       end.
     1522     end.
     1523     if p-change-value >= 0
     1524     then do:
     1525       assign
     1526         v-change-sign = 1
     1527       .
     1528     end.
     1529     else do:
     1530       assign
     1531         v-change-sign = -1
     1532       .
     1533     end.
     1534     assign
     1535       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1536     .
     1537     if p-change-value = 0
     1538     then do:
     1539       run diasize_position-resize-button in this-procedure .
     1540       return .
     1541     end.
     1542     move_block:
