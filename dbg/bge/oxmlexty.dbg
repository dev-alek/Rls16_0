     1315           v-diasize-resize-button :column = 1
     1316         .
     1317       end.
     1318       if p-change-value > 0
     1319       then do:
     1320         if frame Dialog-Frame :scrollable = true
     1321         then do:
     1322           assign
     1323             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1324             no-error .
     1325           if error-status :error
     1326           or error-status :get-message(1) <> ""
     1327           then do:
     1328             undo move_block, retry move_block .
     1329           end.
     1330         end.
