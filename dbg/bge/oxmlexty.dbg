     1697         .
     1698       end.
     1699       do with frame Dialog-Frame
     1700       :
     1701         hide v-diasize-resize-button .
     1702         v-diasize-resize-button :row = 1.
     1703         v-diasize-resize-button :column = 1.
     1704       end.
     1705       if p-change-value > 0
     1706       then do:
     1707         if frame Dialog-Frame :scrollable = true
     1708         then do:
     1709           assign
     1710             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1711             no-error .
