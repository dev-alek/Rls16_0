     1766       end.
     1767       else do:
     1768         for each buf_temp-diasize-handle
     1769         on error undo move_block, retry move_block
     1770         :
     1771           assign
     1772             v-object-handle = buf_temp-diasize-handle.handle-value
     1773           .
     1774           if v-object-handle <> v-diasize-resize-button
     1775           then do:
     1776             assign
     1777               v-object-handle :col = v-object-handle :col + p-change-value
     1778               no-error .
     1779             if error-status :error
     1780             or error-status :get-message(1) <> ""
     1781             then do:
     1782               undo move_block, retry move_block .
     1783             end.
     1784           end.
     1785         end.
     1786         for each buf_temp-browse-handle
     1787           where buf_temp-browse-handle.browse-type = 'width':u
     1788         on error undo move_block, retry move_block
     1789         :
     1790           assign
     1791             buf_temp-browse-handle.browse-handle :width
     1792               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1793             no-error .
     1794           if error-status :error
     1795           or error-status :get-message(1) <> ""
     1796           then do:
     1797             undo move_block, retry move_block .
     1798           end.
     1799         end.
     1800         assign
     1801           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1802           no-error .
     1803         if error-status :error
     1804         or error-status :get-message(1) <> ""
     1805         then do:
     1806           undo move_block, retry move_block.
     1807         end.
     1808         assign
     1809           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1810         no-error .
     1811         if error-status :error
     1812         or error-status :get-message(1) <> ""
     1813         then do:
     1814           undo move_block, retry move_block.
     1815         end.
     1816         if frame Dialog-Frame :scrollable = true
     1817         then do:
     1818           assign
     1819             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1820           no-error .
     1821           if error-status :error
     1822           or error-status :get-message(1) <> ""
     1823           then do:
     1824             undo move_block, retry move_block.
     1825           end.
     1826         end.
     1827       end.
     1828       if p-move-resize
     1829       then do:
     1830         run diasize_position-resize-button in this-procedure .
     1831       end.
     1832       if v-diasize-wndstore = true
     1833       then do:
     1834         if connected("ub") = true
     1835         then do:
     1836           define variable v-cntxt-db-num        as integer   no-undo .
     1837           define variable v-cntxt-userid        as character no-undo .
     1838           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1839                                             , OUTPUT v-cntxt-userid
     1840                                             ) .
     1841           run gbl/wndsizew.p
     1842             (input  v-cntxt-db-num
     1843             ,input  v-cntxt-userid
     1844             ,input  v-diasize-proc-name
     1845             ,input  'width':u
     1846             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1847             ) .
     1848         end.
     1849       end.
     1850     end.
     1851     assign
     1852       v-diasize-change-size = false
     1853     .
     1854   end procedure.
     1855   procedure diasize_set-width :
     1856     define input  parameter p-new-width  as decimal   no-undo .
     1857     define input  parameter p-move-resize as logical   no-undo .
     1858     do
     1859     on error undo, return error return-value
     1860     :
     1861       run diasize_change-width in this-procedure
     1862         (input  (p-new-width - frame Dialog-Frame :width)
     1863         ,input  p-move-resize
     1864         ) .
     1865     end.
     1866   end procedure.
     1867   procedure diasize_position-resize-button :
     1868     do with frame Dialog-Frame
     1869     :
     1870       hide v-diasize-resize-button .
     1871       assign
     1872         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1873                     - 1
     1874                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1875         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1876                     - 1
     1877                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1878       .
     1879       view v-diasize-resize-button .
     1880     end.
     1881   end procedure.
     1882   on alt-right anywhere
     1883   do:
     1884     run diasize_change-width in this-procedure
     1885       (input 1
     1886       ,input true
     1887       ) .
     1888     return no-apply .
     1889   end.
     1890   on alt-left anywhere
     1891   do:
     1892     run diasize_change-width in this-procedure
     1893       (input -1
     1894       ,input true
     1895       ) .
     1896     return no-apply .
     1897   end.
     1898   on alt-down anywhere
     1899   do:
     1900     run diasize_change-height in this-procedure
     1901       (input 1
     1902       ,input true
     1903       ) .
     1904     return no-apply .
     1905   end.
     1906   on alt-up anywhere
     1907   do:
     1908     run diasize_change-height in this-procedure
     1909       (input -1
     1910       ,input true
     1911       ) .
     1912     return no-apply .
     1913   end.
     1914   on alt-enter of frame Dialog-Frame
     1915   do:
     1916     run diasize_maximize in this-procedure
     1917       (input  ?
     1918       ).
     1919     return no-apply .
     1920   end.
     1921   procedure diasize_end-move :
     1922     do
     1923     on error undo, return error return-value
     1924     :
     1925       define variable v-row-delta as decimal   no-undo .
     1926       define variable v-col-delta as decimal   no-undo .
     1927       define variable v-new-row as decimal   no-undo .
     1928       define variable v-new-col as decimal   no-undo .
     1929       assign
     1930         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1931         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1932       .
     1933       assign
     1934         v-row-delta = v-new-row - frame Dialog-Frame :height
     1935         v-col-delta = v-new-col - frame Dialog-Frame :width
     1936       .
     1937       run diasize_change-height in this-procedure
     1938         (input v-row-delta
     1939         ,input true
     1940         ) .
     1941       run diasize_change-width in this-procedure
     1942         (input v-col-delta
     1943         ,input true
     1944         ) .
     1945     end.
     1946   end procedure.
     1947   procedure diasize_maximize :
     1948     define input  parameter p-action as logical   no-undo .
     1949     do
     1950     on error undo, return error return-value
     1951     :
     1952       if p-action = ?
     1953       then do:
     1954         if v-diasize-need-maximize = true
     1955         then do:
     1956           assign
     1957             p-action = true
     1958           .
     1959         end.
     1960         else do:
     1961           assign
     1962             p-action = false
     1963           .
     1964         end.
     1965       end.
     1966       if p-action = true
     1967       then do:
     1968         run diasize_change-height in this-procedure
     1969           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1970               - frame Dialog-Frame :height-chars
     1971           ,input true
     1972           ) .
     1973         run diasize_change-width in this-procedure
     1974           (input session :width-chars
     1975               - frame Dialog-Frame :width-chars
     1976           ,input true
     1977           ) .
     1978         assign
     1979           v-diasize-need-maximize = false
     1980         .
     1981       end.
     1982       else do:
     1983         run diasize_change-width in this-procedure
     1984           (input v-diasize-orig-frame-width
     1985               - frame Dialog-Frame :width-chars
     1986           ,input true
     1987           ) .
     1988         run diasize_change-height in this-procedure
     1989           (input v-diasize-orig-frame-height
     1990               - frame Dialog-Frame :height-chars
     1991           ,input true
     1992           ) .
     1993         assign
     1994           v-diasize-need-maximize = true
     1995         .
     1996       end.
     1997     end.
     1998   end procedure.
     1999   procedure diasize_restore-orig-size :
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       assign
     2004         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2005         v-diasize-current-frame-height = frame Dialog-Frame :height
     2006       .
     2007       run diasize_set-height in this-procedure
     2008         (input  v-diasize-orig-frame-height
     2009         ,input  true
     2010         ) .
     2011       run diasize_set-width in this-procedure
     2012         (input  v-diasize-orig-frame-width
     2013         ,input  true
     2014         ) .
     2015     end.
     2016   end procedure.
     2017   procedure diasize_restore-current-size :
     2018     do
     2019     on error undo, return error return-value
     2020     :
     2021       run diasize_set-height in this-procedure
     2022         (input  v-diasize-current-frame-height
     2023         ,input  true
     2024         ) .
     2025       run diasize_set-width in this-procedure
     2026         (input  v-diasize-current-frame-width
     2027         ,input  true
     2028         ) .
     2029     end.
     2030   end procedure.
     2031   procedure diasize_set-browse-handle :
     2032     define input  parameter p-browse-handle as handle   no-undo .
     2033     define buffer buf_temp-browse-handle for temp-browse-handle .
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037       assign
     2038         v-diasize-browse-handle = p-browse-handle
     2039       .
     2040       for each buf_temp-browse-handle
     2041       on error undo, return error return-value
     2042       :
     2043         delete buf_temp-browse-handle .
     2044       end.
     2045     end.
     2046   end procedure.
     2047   procedure diasize_add_browse :
     2048     define input  parameter p-browse-type   as character no-undo .
     2049     define input  parameter p-browse-handle as handle    no-undo .
     2050     define buffer buf_temp-browse-handle for temp-browse-handle .
     2051     do
     2052     on error undo, return error return-value
     2053     :
     2054       assign
     2055         v-diasize-browse-number = v-diasize-browse-number + 1
     2056       .
     2057       create buf_temp-browse-handle .
     2058       assign
     2059         buf_temp-browse-handle.browse-type   = p-browse-type
     2060         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2061         buf_temp-browse-handle.browse-handle = p-browse-handle
     2062       .
     2063     end.
     2064   end procedure.
     2065   procedure diasize_init :
     2066     define variable v-default-value    as logical   no-undo .
     2067     define variable v-restore-saved    as logical   no-undo .
     2068     define variable v-resize-value-str as character no-undo .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       do with frame Dialog-Frame
     2073       :
     2074         assign
     2075           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2076           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2077           v-diasize-browse-handle     = browse br-table-not-sel :handle
     2078         .
     2079         create button v-diasize-resize-button
     2080         assign
     2081           parent        = frame Dialog-Frame :first-child
     2082           label         = "s"
     2083           height-pixels = 16
     2084           width-pixels  = 16
     2085           visible       = true
     2086           sensitive     = true
     2087           movable       = true
     2088           triggers:
     2089             on end-move persistent run diasize_end-move in this-procedure .
     2090           end triggers.
     2091         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2092         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2093         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2094         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2095         assign
     2096           v-diasize-wndmax = false
     2097         .
     2098         if connected("ub") = true
     2099         then do:
     2100           define variable v-cntxt-db-num        as integer   no-undo .
     2101           define variable v-cntxt-userid        as character no-undo .
     2102           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2103                                             , OUTPUT v-cntxt-userid
     2104                                             ) .
     2105           run gbl/wndpar_r.p
     2106             (input  v-cntxt-db-num
     2107             ,input  v-cntxt-userid
     2108             ,input  'wndmax':U
     2109             ,output v-diasize-wndmax
     2110             ,output v-default-value
     2111             ) .
     2112         end.
     2113         assign
     2114           v-diasize-wndstore = false
     2115         .
     2116         if connected("ub") = true
     2117         then do:
     2118           run gbl/wndpar_r.p
     2119             (input  v-cntxt-db-num
     2120             ,input  v-cntxt-userid
     2121             ,input  'wndstore':U
     2122             ,output v-diasize-wndstore
     2123             ,output v-default-value
     2124             ) .
     2125         end.
     2126         assign
     2127           v-diasize-proc-name = entry(1, program-name(2), '.')
     2128         .
     2129         if v-diasize-wndstore = true
     2130         then do:
     2131           assign
     2132             v-restore-saved = false
     2133           .
     2134           if connected("ub") = true
     2135           then do:
     2136             run gbl/wndsizer.p
     2137               (input  v-cntxt-db-num
     2138               ,input  v-cntxt-userid
     2139               ,input  v-diasize-proc-name
     2140               ,input  'height':u
     2141               ,output v-resize-value-str
     2142               ) .
     2143             if v-resize-value-str <> '':U
     2144             then do:
     2145               run diasize_change-height in this-procedure
     2146                 (input  integer(v-resize-value-str)
     2147                 ,input  true
     2148                 ) .
     2149               assign
     2150                 v-restore-saved = true
     2151               .
     2152             end.
     2153           end.
     2154           if connected("ub") = true
     2155           then do:
     2156             run gbl/wndsizer.p
     2157               (input  v-cntxt-db-num
     2158               ,input  v-cntxt-userid
     2159               ,input  v-diasize-proc-name
     2160               ,input  'width':u
     2161               ,output v-resize-value-str
     2162               ) .
     2163             if v-resize-value-str <> '':U
     2164             then do:
     2165               run diasize_change-width in this-procedure
     2166                 (input  integer(v-resize-value-str)
     2167                 ,input  true
     2168                 ) .
     2169               assign
     2170                 v-restore-saved = true
     2171               .
     2172             end.
     2173           end.
     2174           if v-restore-saved <> true
     2175           then do:
     2176             if v-diasize-wndmax = true
     2177             then do:
     2178               run diasize_maximize in this-procedure
     2179                 (input  true
     2180                 ) .
     2181             end.
     2182           end.
     2183         end.
     2184         else do:
     2185           if v-diasize-wndmax = true
     2186           then do:
     2187             run diasize_maximize in this-procedure
     2188               (input  true
     2189               ) .
     2190           end.
     2191         end.
     2192       end.
     2193     end.
     2194   end procedure.
     2195   procedure diasize_need-full-display :
     2196     define output parameter p-need-full-display as logical   no-undo .
     2197     do
     2198     on error undo, return error return-value
     2199     :
     2200       assign
     2201         p-need-full-display = v-diasize-need-full-display
     2202       .
     2203       assign
     2204         v-diasize-need-full-display = false
     2205       .
     2206     end.
     2207   end procedure.
     2208   procedure get-context :
     2209      define output parameter p-db-num as integer          no-undo.
     2210      define output parameter p-user-id as character        no-undo.
     2211      define variable v-login               as character    no-undo.
     2212      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2213      define buffer buf_user-login  for ub.user-login .
     2214      do
     2215      on error undo, return error
     2216      :
     2217            FIND FIRST buf_sys-ctrl no-lock.
     2218            ASSIGN
     2219               v-login = USERID("ub")
     2220               p-db-num = buf_sys-ctrl.db-num
     2221            .
     2222            FIND FIRST buf_user-login
     2223                 WHERE buf_user-login.db-num = p-db-num
     2224                   AND buf_user-login.user-login = v-login
     2225                 no-lock
     2226                 no-error
     2227                 .
     2228            IF AVAILABLE buf_user-login
     2229            THEN DO:
     2230               assign
     2231                  p-user-id = buf_user-login.user-id
     2232               .
     2233            END.
     2234      end.
     2235   end procedure.
     2236       run diasize_init in this-procedure .
     2237   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2238   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2239   MAIN-BLOCK:
     2240   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2241      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2242       run init-fields in this-procedure.
     2243       RUN enable_UI.
     2244       run ui-disable-all in this-procedure.
     2245       run ui-enable in this-procedure.
     2246       apply "value-changed" to br-table-sel.
     2247       apply "entry" to br-table-sel.
     2248     WAIT-FOR GO OF FRAME Dialog-Frame.
     2249   END.
     2250   RUN disable_UI.
     2251   PROCEDURE assign-export-table :
     2252       define buffer buf_esys-datatype-exp     for ub.esys-datatype-exp.
     2253       define buffer buf_temp_oxmltd_sel      for temp_oxmltd_sel.
     2254   do
     2255   for buf_esys-datatype-exp
     2256     , buf_temp_oxmltd_sel
     2257   on error undo, return error
     2258   :
     2259       for each buf_esys-datatype-exp exclusive-lock
     2260          where buf_esys-datatype-exp.esys-id = p-esys-id
     2261            and buf_esys-datatype-exp.db-num  = p-db-num
     2262       :
     2263           find first buf_temp_oxmltd_sel
     2264                where buf_temp_oxmltd_sel.id = buf_esys-datatype-exp.dte-id
     2265           no-error.
     2266           if not available buf_temp_oxmltd_sel
     2267           then do:
     2268               delete buf_esys-datatype-exp.
     2269           end.
     2270       end.
     2271       for each buf_temp_oxmltd_sel
     2272       :
     2273           find first buf_esys-datatype-exp exclusive-lock
     2274                where buf_esys-datatype-exp.esys-id = p-esys-id
     2275                  and buf_esys-datatype-exp.db-num  = p-db-num
     2276                  and buf_esys-datatype-exp.dte-id  = buf_temp_oxmltd_sel.id
     2277           no-error.
     2278           if not available buf_esys-datatype-exp
     2279           then do:
     2280               create buf_esys-datatype-exp.
     2281               assign
     2282                   buf_esys-datatype-exp.esys-id = p-esys-id
     2283                   buf_esys-datatype-exp.db-num  = p-db-num
     2284                   buf_esys-datatype-exp.dte-id  = buf_temp_oxmltd_sel.id
     2285               .
     2286           end.
     2287       end.
     2288   end.
     2289   END PROCEDURE.
     2290   PROCEDURE assign-import-table :
     2291       define buffer buf_esys-datatype-imp     for ub.esys-datatype-imp.
     2292       define buffer buf_temp_oxmltd_sel      for temp_oxmltd_sel.
     2293   do
     2294   for buf_esys-datatype-imp
     2295     , buf_temp_oxmltd_sel
     2296   on error undo, return error
     2297   :
     2298       for each buf_esys-datatype-imp exclusive-lock
     2299          where buf_esys-datatype-imp.esys-id = p-esys-id
     2300            and buf_esys-datatype-imp.db-num  = p-db-num
     2301       :
     2302           find first buf_temp_oxmltd_sel
     2303                where buf_temp_oxmltd_sel.id = buf_esys-datatype-imp.tdi-id
     2304           no-error.
     2305           if not available buf_temp_oxmltd_sel
     2306           then do:
     2307               delete buf_esys-datatype-imp.
     2308           end.
     2309       end.
     2310       for each buf_temp_oxmltd_sel
     2311       :
     2312           find first buf_esys-datatype-imp exclusive-lock
     2313                where buf_esys-datatype-imp.esys-id = p-esys-id
     2314                  and buf_esys-datatype-imp.db-num  = p-db-num
     2315                  and buf_esys-datatype-imp.tdi-id  = buf_temp_oxmltd_sel.id
     2316           no-error.
     2317           if not available buf_esys-datatype-imp
     2318           then do:
     2319               create buf_esys-datatype-imp.
     2320               assign
     2321                   buf_esys-datatype-imp.esys-id = p-esys-id
     2322                   buf_esys-datatype-imp.db-num  = p-db-num
     2323                   buf_esys-datatype-imp.tdi-id  = buf_temp_oxmltd_sel.id
     2324               .
     2325           end.
     2326       end.
     2327   end.
     2328   END PROCEDURE.
     2329   PROCEDURE change-properties :
     2330   define input parameter p-id     as integer          no-undo.
     2331   do
     2332   on error undo, return error
     2333   :
     2334   end.
     2335   END PROCEDURE.
     2336   PROCEDURE check-data :
     2337   do
     2338   on error undo, return error
     2339   :
     2340   end.
     2341   END PROCEDURE.
     2342   PROCEDURE disable_UI :
     2343     HIDE FRAME Dialog-Frame.
     2344   END PROCEDURE.
     2345   PROCEDURE disp-desc-not-sel :
     2346   define input parameter p-id     as integer          no-undo.
     2347       define buffer buf_datatype-exp     for ub.datatype-exp.
     2348       define buffer buf_datatype-imp     for ub.datatype-imp.
     2349   do
     2350   for buf_datatype-exp
     2351     , buf_datatype-imp
     2352   with frame Dialog-Frame
     2353   on error undo, return error
     2354   :
     2355       case p-impexp-type
     2356       :
     2357           when 'импорт':U
     2358           then do:
     2359               find first buf_datatype-imp no-lock
     2360                    where buf_datatype-imp.dti-id = p-id
     2361               no-error.
     2362               if available buf_datatype-imp
     2363               then do:
     2364                   assign
     2365                       ed-desc-not-sel :screen-value = buf_datatype-imp.dti-des
     2366                   .
     2367               end.
     2368           end.
     2369           when 'экспорт':U
     2370           then do:
     2371               find first buf_datatype-exp no-lock
     2372                    where buf_datatype-exp.dte-id = p-id
     2373               no-error.
     2374               if available buf_datatype-exp
     2375               then do:
     2376                   assign
     2377                       ed-desc-not-sel :screen-value = buf_datatype-exp.dte-des
     2378                   .
     2379               end.
     2380           end.
     2381       end case.
     2382   end.
     2383   END PROCEDURE.
     2384   PROCEDURE disp-desc-sel :
     2385   define input parameter p-id     as integer          no-undo.
     2386       define buffer buf_datatype-exp     for ub.datatype-exp.
     2387       define buffer buf_datatype-imp     for ub.datatype-imp.
     2388   do
     2389   for buf_datatype-exp
     2390     , buf_datatype-imp
     2391   with frame Dialog-Frame
     2392   on error undo, return error
     2393   :
     2394       case p-impexp-type
     2395       :
     2396           when 'импорт':U
     2397           then do:
     2398               find first buf_datatype-imp no-lock
     2399                    where buf_datatype-imp.dti-id = p-id
     2400               no-error.
     2401               if available buf_datatype-imp
     2402               then do:
     2403                   assign
     2404                       ed-desc-sel :screen-value = buf_datatype-imp.dti-des
     2405                   .
     2406               end.
     2407           end.
     2408           when 'экспорт':U
     2409           then do:
     2410               find first buf_datatype-exp no-lock
     2411                    where buf_datatype-exp.dte-id = p-id
     2412               no-error.
     2413               if available buf_datatype-exp
     2414               then do:
     2415                   assign
     2416                       ed-desc-sel :screen-value = buf_datatype-exp.dte-des
     2417                   .
     2418               end.
     2419           end.
     2420       end case.
     2421   end.
     2422   END PROCEDURE.
     2423   PROCEDURE enable_UI :
     2424     DISPLAY ed-desc-sel ed-desc-not-sel
     2425         WITH FRAME Dialog-Frame.
     2426     ENABLE b-exit b-cancel b-help bt-sel-properties br-table-sel br-table-not-sel
     2427            bt-select-type bt-deselect-type ed-desc-sel ed-desc-not-sel
     2428         WITH FRAME Dialog-Frame.
     2429     VIEW FRAME Dialog-Frame.
     2430     run local-open-query-not-sel in this-procedure .    run local-open-query-sel in this-procedure .
     2431   END PROCEDURE.
     2432   PROCEDURE init-fields :
     2433   do
     2434   on error undo, return error
     2435   :
     2436       run oxmltd-fill in this-procedure (
     2437             input p-impexp-type
     2438           , input p-esys-id
     2439           , input p-db-num
     2440       ) no-error.
     2441       if error-status :error
     2442       then do:
     2443           message
     2444                    vss-workfile vss-revision vss-description
     2445               skip(1)
     2446               skip "Ошибка заполнения таблиц данных."
     2447               skip return-value
     2448               skip trim(error-status :get-message(1))
     2449                    trim(error-status :get-message(2))
     2450                    trim(error-status :get-message(3))
     2451           view-as alert-box error.
     2452           undo, return error .
     2453       end.
     2454   end.
     2455   END PROCEDURE.
     2456   PROCEDURE local-open-query-not-sel :
     2457   do
     2458   on error undo, return error
     2459   :
     2460       open query br-table-not-sel
     2461           for each buf_init_temp_oxmltd_not_sel no-lock
     2462       .
     2463   end.
     2464   END PROCEDURE.
     2465   PROCEDURE local-open-query-sel :
     2466       open query br-table-sel
     2467           for each buf_init_temp_oxmltd_sel no-lock
     2468       .
     2469    END PROCEDURE.
     2470   PROCEDURE proc-get-type-name :
     2471   define input parameter p-id     as integer          no-undo.
     2472   define output parameter p-name  as character        no-undo.
     2473       define buffer buf_datatype-exp     for ub.datatype-exp.
     2474       define buffer buf_datatype-imp     for ub.datatype-imp.
     2475   do
     2476   for buf_datatype-exp
     2477     , buf_datatype-imp
     2478   on error undo, return error
     2479   :
     2480       case p-impexp-type
     2481       :
     2482           when 'импорт':U
     2483           then do:
     2484               find first buf_datatype-imp no-lock
     2485                    where buf_datatype-imp.dti-id = p-id
     2486               no-error.
     2487               if available buf_datatype-imp
     2488               then do:
     2489                   assign
     2490                       p-name = buf_datatype-imp.dti-name
     2491                   .
     2492               end.
     2493           end.
     2494           when 'экспорт':U
     2495           then do:
     2496               find first buf_datatype-exp no-lock
     2497                    where buf_datatype-exp.dte-id = p-id
     2498               no-error.
     2499               if available buf_datatype-exp
     2500               then do:
     2501                   assign
     2502                       p-name = buf_datatype-exp.dte-name
     2503                   .
     2504               end.
     2505           end.
     2506       end case.
     2507   end.
     2508   END PROCEDURE.
     2509   PROCEDURE select-and-move-down :
     2510   define input parameter p-browse-handle  as handle           no-undo.
     2511   define input parameter p-query-handle   as handle           no-undo.
     2512       define variable v-focused-row       as integer  no-undo.
     2513       define variable v-repositioned-row  as integer  no-undo.
     2514   do
     2515   with frame Dialog-Frame
     2516   on error undo, return error
     2517   :
     2518           assign
     2519               v-focused-row      = p-browse-handle :focused-row
     2520               v-repositioned-row = p-query-handle  :current-result-row
     2521           .
     2522           p-query-handle :get-next ().
     2523           if p-query-handle :query-off-end = no
     2524           then do:
     2525               if v-focused-row > p-browse-handle :height - 2
     2526               then do:
     2527                   assign
     2528                       v-repositioned-row  = v-repositioned-row + 1
     2529                   .
     2530               end.
     2531               else do:
     2532                   assign
     2533                       v-focused-row       = v-focused-row + 1
     2534                       v-repositioned-row  = v-repositioned-row + 1
     2535                   .
     2536               end.
     2537               p-browse-handle :set-repositioned-row( v-focused-row, "ALWAYS").
     2538               p-query-handle  :reposition-to-row( v-repositioned-row ).
     2539           end.
     2540   end.
     2541   END PROCEDURE.
     2542   PROCEDURE ui-disable-all :
     2543   do
     2544   with frame Dialog-Frame
     2545   on error undo, return error
     2546   :
     2547       disable
     2548           all
     2549           except
     2550               b-exit
     2551               b-help
     2552               br-table-sel
     2553               br-table-not-sel
     2554               bt-sel-properties
     2555       .
     2556   end.
     2557   END PROCEDURE.
     2558   PROCEDURE ui-enable :
     2559       define buffer buf_clients       for ub.clients.
     2560   do
     2561   for buf_clients
     2562   with frame Dialog-Frame
     2563   on error undo, return error
     2564   :
     2565       if p-mode = 1
     2566       then do:
     2567           enable
     2568               b-cancel
     2569               b-help
     2570               bt-sel-sel
     2571               bt-sel-sel-all
     2572               bt-sel-desel-all
     2573               bt-sel-reverse
     2574               bt-not-sel-sel
     2575               bt-not-sel-desel-all
     2576               bt-not-sel-all
     2577               bt-not-sel-reverse
     2578               ed-desc-not-sel
     2579               ed-desc-sel
     2580               bt-select-type
     2581               bt-deselect-type
     2582           .
     2583       end.
     2584       if p-mode = 0
     2585       then do:
     2586           hide
     2587               b-cancel
     2588           .
     2589           assign
     2590               b-exit :label = "В&ыход"
     2591           .
     2592       end.
     2593   end.
     2594   END PROCEDURE.
     2595   FUNCTION get-type-name RETURNS CHARACTER
     2596     ( input p-id as integer ) :
     2597       define variable v-name    as character    no-undo.
     2598     run proc-get-type-name in this-procedure (
     2599         input p-id
     2600       , output v-name
     2601     ).
     2602     RETURN v-name.
     2603   END FUNCTION.
