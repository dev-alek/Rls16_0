      596        SIZE 7 BY 1.
      597   DEFINE VARIABLE ed-desc-not-sel AS CHARACTER
      598        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      599        SIZE 43.5 BY 1.63
      600        FGCOLOR 2  NO-UNDO.
      601   DEFINE VARIABLE ed-desc-sel AS CHARACTER
      602        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      603        SIZE 43.5 BY 1.63
      604        FGCOLOR 2  NO-UNDO.
      605   DEFINE QUERY br-table-not-sel FOR
      606         buf_init_temp_oxmltd_not_sel SCROLLING.
      607   DEFINE QUERY br-table-sel FOR
      608         buf_init_temp_oxmltd_sel SCROLLING.
      609   DEFINE BROWSE br-table-not-sel
      610     QUERY br-table-not-sel NO-LOCK DISPLAY
      611         buf_init_temp_oxmltd_not_sel.sel format " */  "
      612       get-type-name( input buf_init_temp_oxmltd_not_sel.id ) format "X(40)"
      613       WITH NO-ROW-MARKERS SEPARATORS SIZE 43.5 BY 17.79 ROW-HEIGHT-CHARS .67 EXPANDABLE.
      614   DEFINE BROWSE br-table-sel
      615     QUERY br-table-sel NO-LOCK DISPLAY
      616         buf_init_temp_oxmltd_sel.sel format " */  "
      617         get-type-name( input buf_init_temp_oxmltd_sel.id ) format "X(40)"
      618       WITH NO-ROW-MARKERS SEPARATORS SIZE 43.5 BY 17.79 ROW-HEIGHT-CHARS .67 EXPANDABLE.
      619   DEFINE FRAME Dialog-Frame
      620        b-exit AT ROW 1 COL 2.5
      621        b-cancel AT ROW 1 COL 12.5
      622        b-help AT ROW 1 COL 88
      623        bt-sel-sel AT ROW 2.5 COL 2.5
      624        bt-sel-sel-all AT ROW 2.5 COL 5.5
      625        bt-sel-desel-all AT ROW 2.5 COL 8.5
      626        bt-sel-reverse AT ROW 2.5 COL 11.5
      627        bt-sel-properties AT ROW 2.5 COL 36
      628        bt-not-sel-sel AT ROW 2.5 COL 54.5
      629        bt-not-sel-all AT ROW 2.5 COL 57.5
      630        bt-not-sel-desel-all AT ROW 2.5 COL 60.5
      631        bt-not-sel-reverse AT ROW 2.5 COL 63.5
      632        br-table-sel AT ROW 3.75 COL 2.5
      633        br-table-not-sel AT ROW 3.75 COL 54.5
      634        bt-select-type AT ROW 10.5 COL 46.5
      635        bt-deselect-type AT ROW 11.5 COL 46.5
      636        ed-desc-sel AT ROW 21.75 COL 2.5 NO-LABEL
      637        ed-desc-not-sel AT ROW 21.75 COL 54.5 NO-LABEL
      638        "Остальные типы данных" VIEW-AS TEXT
      639             SIZE 26 BY 1 AT ROW 2.5 COL 72
      640        "Выбранные" VIEW-AS TEXT
      641             SIZE 10.5 BY 1 AT ROW 2.5 COL 16
      642        SPACE(72.47) SKIP(20.03)
      643       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      644            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      645            TITLE "Список типов данных OpenXML"
      646            CANCEL-BUTTON b-cancel.
      647   ASSIGN
      648          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      649          FRAME Dialog-Frame:HIDDEN           = TRUE.
      650   ASSIGN
      651          ed-desc-not-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      652   ASSIGN
      653          ed-desc-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      654   ON GO OF FRAME Dialog-Frame
      655   DO:
      656       run check-data in this-procedure.
      657       case p-impexp-type
      658       :
      659           when 'импорт':U
      660           then do:
      661               run assign-import-table in this-procedure.
      662           end.
      663           when 'экспорт':U
      664           then do:
      665               run assign-export-table in this-procedure.
      666           end.
      667       end case.
      668   END.
      669   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      670   DO:
      671     APPLY "END-ERROR":U TO SELF.
      672   END.
      673   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      674   DO:
      675   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   if lookup(self :type
      677            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      678            ) = 0
      679   then do:
      680     message
      681       "$Workfile$"
      682       "Указанному интерфейсному элементу фокус не может быть передан" skip
      683       "Интерфейсный элемент" self :name  skip
      684       "Тип" self :type  skip
      685       "Процедура" this-procedure :file-name skip
      686       view-as alert-box .
      687   end.
      688   else do:
      689     apply "entry":u to self  .
      690     if focus :handle <> self :handle  then do:
      691       return no-apply .
      692     end.
      693   end.
      694   END.
      695   ON MOUSE-SELECT-CLICK OF br-table-not-sel IN FRAME Dialog-Frame
      696   DO:
      697       if p-mode = 1
      698       then do:
      699           if available buf_init_temp_oxmltd_not_sel
      700           then do:
      701               assign
      702                   buf_init_temp_oxmltd_not_sel.sel = not( buf_init_temp_oxmltd_not_sel.sel )
      703               .
      704               display
      705                   sel
      706               with browse br-table-not-sel .
      707               apply "entry" to br-table-not-sel.
      708           end.
      709       end.
      710   END.
      711   ON VALUE-CHANGED OF br-table-not-sel IN FRAME Dialog-Frame
      712   or entry of br-table-not-sel IN FRAME Dialog-Frame
      713   DO:
      714       if available buf_init_temp_oxmltd_sel
      715       then do:
      716           run disp-desc-sel in this-procedure (
      717               input buf_init_temp_oxmltd_sel.id
      718           ).
      719       end.
      720       else do:
      721           assign
      722               ed-desc-sel :screen-value = "":U
      723           .
      724       end.
      725       if available buf_init_temp_oxmltd_not_sel
      726       then do:
      727           run disp-desc-not-sel in this-procedure (
      728               input buf_init_temp_oxmltd_not_sel.id
      729           ).
      730       end.
      731       else do:
      732           assign
      733               ed-desc-not-sel :screen-value = "":U
      734           .
      735       end.
      736   END.
      737   ON MOUSE-SELECT-CLICK OF br-table-sel IN FRAME Dialog-Frame
      738   DO:
      739       if p-mode = 1
      740       then do:
      741           if available buf_init_temp_oxmltd_sel
      742           then do:
      743               assign
      744                   buf_init_temp_oxmltd_sel.sel = not( buf_init_temp_oxmltd_sel.sel )
      745               .
      746               display
      747                   sel
      748               with browse br-table-sel .
      749               apply "entry" to br-table-sel.
      750           end.
      751       end.
      752   END.
      753   ON VALUE-CHANGED OF br-table-sel IN FRAME Dialog-Frame
      754   or entry of br-table-sel IN FRAME Dialog-Frame
      755   DO:
      756       if available buf_init_temp_oxmltd_sel
      757       then do:
      758           run disp-desc-sel in this-procedure (
      759               input buf_init_temp_oxmltd_sel.id
      760           ).
      761       end.
      762       else do:
      763           assign
      764               ed-desc-sel :screen-value = "":U
      765           .
      766       end.
      767       if available buf_init_temp_oxmltd_not_sel
      768       then do:
      769           run disp-desc-not-sel in this-procedure (
      770               input buf_init_temp_oxmltd_not_sel.id
      771           ).
      772       end.
      773       else do:
      774           assign
      775               ed-desc-not-sel :screen-value = "":U
      776           .
      777       end.
      778   END.
      779   ON CHOOSE OF bt-deselect-type IN FRAME Dialog-Frame
      780   or mouse-select-dblclick of br-table-sel in frame dialog-frame
      781   DO:
      782       if p-mode = 1
      783       then do:
      784           run oxmltd-deselect in this-procedure (
      785               input ( if available buf_init_temp_oxmltd_sel then buf_init_temp_oxmltd_sel.id else 0 )
      786           ) no-error.
      787           if error-status :error
      788           then do:
      789               message
      790                           vss-workfile vss-revision vss-description
      791                   skip(1)
      792                   skip "Ошибка отмены типа данных для экспорта."
      793                   skip return-value
      794                   skip trim(error-status :get-message(1))
      795                           trim(error-status :get-message(2))
      796                           trim(error-status :get-message(3))
      797               view-as alert-box error.
      798               undo, return no-apply .
      799           end.
      800           run local-open-query-not-sel in this-procedure .    run local-open-query-sel in this-procedure .
      801           apply "entry" to br-table-not-sel.
      802       end.
      803   END.
      804   ON CHOOSE OF bt-not-sel-all IN FRAME Dialog-Frame
      805   DO:
      806       for each buf_init_temp_oxmltd_not_sel
      807       :
      808           assign
      809               buf_init_temp_oxmltd_not_sel.sel = yes
      810           .
      811       end.
      812       br-table-not-sel :refresh().
      813       apply "entry" to br-table-not-sel.
      814   END.
      815   ON CHOOSE OF bt-not-sel-desel-all IN FRAME Dialog-Frame
      816   DO:
      817       for each buf_init_temp_oxmltd_not_sel
      818       :
      819           assign
      820               buf_init_temp_oxmltd_not_sel.sel = no
      821           .
      822       end.
      823       br-table-not-sel :refresh().
      824       apply "entry" to br-table-not-sel.
      825   END.
      826   ON CHOOSE OF bt-not-sel-reverse IN FRAME Dialog-Frame
      827   DO:
      828       for each buf_init_temp_oxmltd_not_sel
      829       :
      830           assign
      831               buf_init_temp_oxmltd_not_sel.sel = not( buf_init_temp_oxmltd_not_sel.sel )
      832           .
      833       end.
      834       br-table-not-sel :refresh().
      835       apply "entry" to br-table-not-sel.
      836   END.
      837   ON CHOOSE OF bt-not-sel-sel IN FRAME Dialog-Frame
      838   DO:
      839       if available buf_init_temp_oxmltd_not_sel
      840       then do:
      841           assign
      842               buf_init_temp_oxmltd_not_sel.sel = not( buf_init_temp_oxmltd_not_sel.sel )
      843           .
      844           display
      845               sel
      846           with browse br-table-not-sel .
      847           run select-and-move-down in this-procedure (
      848                 input browse br-table-not-sel :handle
      849               , input query br-table-not-sel :handle
      850           ).
      851           apply "entry" to br-table-not-sel.
      852       end.
      853   END.
      854   ON CHOOSE OF bt-sel-desel-all IN FRAME Dialog-Frame
      855   DO:
      856       for each buf_init_temp_oxmltd_sel
      857       :
      858           assign
      859               buf_init_temp_oxmltd_sel.sel = no
      860           .
      861       end.
      862       br-table-sel :refresh().
      863       apply "entry" to br-table-sel.
      864   END.
      865   ON CHOOSE OF bt-sel-properties IN FRAME Dialog-Frame
      866   DO:
      867       if available buf_init_temp_oxmltd_sel
      868       then do:
      869           run bge/oxmlextp.w (
      870                 input p-mainmenu-handle
      871               , input p-mode
      872               , input p-impexp-type
      873               , input p-esys-id
      874               , input p-db-num
      875               , input buf_init_temp_oxmltd_sel.id
      876           ) no-error.
      877           if error-status :error
      878           then do:
      879               message
      880                        vss-workfile vss-revision vss-description
      881                   skip(1)
      882                   skip "Ошибка изменения свойств типов"
      883                   skip "данных внешней подсистемы."
      884                   skip return-value
      885                   skip trim(error-status :get-message(1))
      886                        trim(error-status :get-message(2))
      887                        trim(error-status :get-message(3))
      888               view-as alert-box error.
      889               undo, return no-apply .
      890           end.
      891       end.
      892       br-table-sel :refresh().
      893       apply "entry" to br-table-sel.
      894   END.
      895   ON CHOOSE OF bt-sel-reverse IN FRAME Dialog-Frame
      896   DO:
      897       for each buf_init_temp_oxmltd_sel
      898       :
      899           assign
      900               buf_init_temp_oxmltd_sel.sel = not( buf_init_temp_oxmltd_sel.sel )
      901           .
      902       end.
      903       br-table-sel :refresh().
      904       apply "entry" to br-table-sel.
      905   END.
      906   ON CHOOSE OF bt-sel-sel IN FRAME Dialog-Frame
      907   DO:
      908       if available buf_init_temp_oxmltd_sel
      909       then do:
      910           assign
      911               buf_init_temp_oxmltd_sel.sel = not( buf_init_temp_oxmltd_sel.sel )
      912           .
      913           display
      914               sel
      915           with browse br-table-sel .
      916           run select-and-move-down in this-procedure (
      917                 input browse br-table-sel :handle
      918               , input query br-table-sel :handle
      919           ).
      920           apply "entry" to br-table-sel.
      921       end.
      922   END.
      923   ON CHOOSE OF bt-sel-sel-all IN FRAME Dialog-Frame
      924   DO:
      925       for each buf_init_temp_oxmltd_sel
      926       :
      927           assign
      928               buf_init_temp_oxmltd_sel.sel = yes
      929           .
      930       end.
      931       br-table-sel :refresh().
      932       apply "entry" to br-table-sel.
      933   END.
      934   ON CHOOSE OF bt-select-type IN FRAME Dialog-Frame
      935   or mouse-select-dblclick of br-table-not-sel in frame dialog-frame
      936   DO:
      937       if p-mode = 1
      938       then do:
      939           run oxmltd-select in this-procedure (
      940               input ( if available buf_init_temp_oxmltd_not_sel then buf_init_temp_oxmltd_not_sel.id else 0 )
      941           ) no-error.
      942           if error-status :error
      943           then do:
      944               message
      945                           vss-workfile vss-revision vss-description
      946                   skip(1)
      947                   skip "Ошибка выбора типа данных для экспорта."
      948                   skip return-value
      949                   skip trim(error-status :get-message(1))
      950                           trim(error-status :get-message(2))
      951                           trim(error-status :get-message(3))
      952               view-as alert-box error.
      953               undo, return no-apply .
      954           end.
      955           run local-open-query-not-sel in this-procedure .    run local-open-query-sel in this-procedure .
      956           apply "entry" to br-table-sel.
      957       end.
      958   END.
      959   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      960   on help of frame Dialog-Frame
      961   do:
      962     run gbl/app_help.p
      963       (input this-procedure :file-name
      964       ,input ''
      965       ,input ?
      966       ) no-error.
      967     if error-status :error then do:
      968       message
      969         "Ошибка при вызове помощи"
      970         error-status :get-message(1)
      971         view-as alert-box .
      972     end.
      973   end.
      974   run minbtn-set in this-procedure .
      975   on choose of b-help in frame Dialog-Frame
      976   do:
      977     apply "help":u to frame Dialog-Frame .
      978   end.
      979   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   procedure minbtn-set :
      981       do
      982           on error undo, return error return-value
      983           :
      984           define variable ii              as integer       no-undo .
      985           define variable fh              as widget-handle no-undo .
      986           define variable hh              as widget-handle no-undo .
      987           define variable v-h             as handle        extent 4 no-undo .
      988           define variable v-name-button   as character     no-undo .
      989           define variable v-help-old-x    as decimal       no-undo .
      990           define variable v-help-old-y    as decimal       no-undo .
      991           define variable v-help-old-size as decimal       no-undo .
      992           define variable v-frame-width   as decimal       no-undo .
      993           define variable jj              as integer       no-undo .
      994           do
      995               on error undo, return error
      996               :
      997               assign
      998                   v-frame-width = frame Dialog-Frame:width - 0.3
      999                   fh            = frame Dialog-Frame:first-child
     1000                   hh            = fh:first-child
     1001                   ii            = 1
     1002                   .
     1003               do while valid-handle(hh):
     1004                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1005                   do:
     1006                       case lc(hh:name) :
     1007                           when "b-help" then
     1008                               do:
     1009                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1010                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1011                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1012                                   hh:TOOLTIP = "Помощь" .
     1013                                   v-help-old-x = hh:column .
     1014                                   v-help-old-y = hh:row    .
     1015                                   v-help-old-size = hh:width .
     1016                                   hh:width-chars = 2.5 .
     1017                               end.
     1018                           when "b-print" then
     1019                               do:
     1020                                   hh:load-image("cmp/b-print.bmp":u) .
     1021                                   hh:TOOLTIP = "Печать" .
     1022                                   v-h[ii] = hh:handle .
     1023                                   ii = ii + 1 .
     1024                                   hh:width-chars = 3 .
     1025                               end.
     1026                           when "b-history" or
     1027                           when "b-hist" then
     1028                               do:
     1029                                   hh:load-image("cmp/b-hist.bmp":u) .
     1030                                   hh:TOOLTIP = "История" .
     1031                                   v-h[ii] = hh:handle .
     1032                                   ii = ii + 1 .
     1033                                   hh:width-chars = 3 .
     1034                               end.
     1035                           when "b-sch" then
     1036                               do:
     1037                                   hh:load-image("cmp/b-sch.bmp":u) .
     1038                                   hh:TOOLTIP = "Установка Фильтра" .
     1039                                   v-h[ii] = hh:handle .
     1040                                   ii = ii + 1 .
     1041                                   hh:width-chars = 3 .
     1042                               end.
     1043                           when "b-hist-user" then
     1044                               do:
     1045                                   hh:load-image("cmp/b-hist.bmp":u) .
     1046                                   hh:TOOLTIP = "История пользователя" .
     1047                                   ii = ii + 1 .
     1048                               end.
     1049                       end case.
     1050                   end.
     1051                   hh = hh:next-sibling.
     1052               end.
     1053               b-help:column = v-frame-width - b-help:width-chars.
     1054               jj = 0.
     1055               repeat ii = 4 to 1 by -1 :
     1056                   if valid-handle (v-h[ii] ) then
     1057                   do:
     1058                       jj  = jj + 1 .
     1059                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1060                       v-h[ii]:row    = v-help-old-y .
     1061                   end.
     1062               end.
     1063           end.
     1064       end.
     1065   end procedure.
     1066   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1067   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1068   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1069   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1070   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1071   define variable v-diasize-current-frame-height as decimal   no-undo .
     1072   define variable v-diasize-change-size          as logical   no-undo .
     1073   define variable v-diasize-resize-button        as handle    no-undo .
     1074   define variable v-diasize-wndmax               as logical   no-undo .
     1075   define variable v-diasize-wndstore             as logical   no-undo .
     1076   define variable v-diasize-proc-name            as character no-undo .
     1077   define variable v-diasize-browse-handle        as handle    no-undo .
     1078   define variable v-diasize-browse-number        as integer   no-undo .
     1079   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1080   define temp-table temp-diasize-handle no-undo
     1081     field handle-value  as handle
     1082     field save-position as decimal
     1083     index xpk is primary unique handle-value
     1084     .
     1085   define temp-table temp-browse-handle no-undo
     1086     field browse-type   as character
     1087     field browse-number as integer
     1088     field browse-handle as handle
     1089     field original-size as decimal
     1090     index xpk is primary unique browse-type browse-number
     1091     index xie browse-type browse-handle
     1092   .
     1093   procedure diasize_change-height :
     1094     define input  parameter p-change-value  as decimal   no-undo .
     1095     define input  parameter p-move-resize   as logical   no-undo .
     1096     define variable v-field-group-handle    as handle    no-undo .
     1097     define variable v-object-handle         as handle    no-undo .
     1098     define variable v-frame-height          as decimal   no-undo .
     1099     define variable v-frame-virtual-height  as decimal   no-undo .
     1100     define variable v-browse-height         as decimal   no-undo .
     1101     define variable v-window-height         as decimal   no-undo .
     1102     define variable v-window-virtual-height as decimal   no-undo .
     1103     define variable v-change-sign           as integer   no-undo .
     1104     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1105     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1106     if p-change-value > 0
     1107     then do:
     1108       if frame Dialog-Frame :height + p-change-value
     1109           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1110       then do:
     1111         assign
     1112           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1113                           - (frame Dialog-Frame :height-chars)
     1114         .
     1115         if p-change-value <= 0
     1116         then do:
     1117           run diasize_position-resize-button in this-procedure .
     1118           return .
     1119         end.
     1120       end.
     1121     end.
     1122     if p-change-value < 0
     1123     then do:
     1124       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1125       then do:
     1126         assign
     1127           p-change-value = v-diasize-orig-frame-height
     1128                          - (frame Dialog-Frame :height-chars)
     1129         .
     1130         if p-change-value >= 0
     1131         then do:
     1132           run diasize_position-resize-button in this-procedure .
     1133           return .
     1134         end.
     1135       end.
     1136     end.
     1137     if p-change-value >= 0
     1138     then do:
     1139       assign
     1140         v-change-sign = 1
     1141       .
     1142     end.
     1143     else do:
     1144       assign
     1145         v-change-sign = -1
     1146       .
     1147     end.
     1148     assign
     1149       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1150     .
     1151     if p-change-value = 0
     1152     then do:
     1153       run diasize_position-resize-button in this-procedure .
     1154       return .
     1155     end.
     1156     move_block:
     1157     do
     1158     on error undo move_block, retry move_block
     1159     :
     1160       if retry
     1161       then do:
     1162         do
     1163         on error undo move_block, leave move_block
     1164         :
     1165           if p-change-value > 0
     1166           then do:
     1167             for each buf_temp-diasize-handle
     1168             on error undo, next
     1169             :
     1170               assign
     1171                 v-object-handle = buf_temp-diasize-handle.handle-value
     1172               .
     1173               if v-object-handle <> v-diasize-resize-button
     1174               then do:
     1175                 assign
     1176                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1177                 .
     1178               end.
     1179             end.
     1180             assign
     1181               v-diasize-browse-handle :height = v-browse-height
     1182             .
     1183             for each buf_temp-browse-handle
     1184               where buf_temp-browse-handle.browse-type = 'height':u
     1185             on error undo, next
     1186             :
     1187               assign
     1188                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1189               .
     1190             end.
     1191             assign
     1192               frame Dialog-Frame :height = v-frame-height
     1193             .
     1194             if frame Dialog-Frame :scrollable = true
     1195             then do:
     1196               assign
     1197                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1198               .
     1199             end.
     1200             run diasize_position-resize-button in this-procedure .
     1201           end.
     1202           else do:
