     1670           and can-query(v-object-handle, "row")
     1671           and can-query(v-object-handle, "height")
     1672           and ( v-object-handle :col + v-object-handle :width
     1673                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1674               )
     1675           then do:
     1676             find first buf_temp-browse-handle
     1677               where buf_temp-browse-handle.browse-type   = 'width':u
     1678                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1679               no-error .
