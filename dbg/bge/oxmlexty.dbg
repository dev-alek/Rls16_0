        1   define input parameter p-mainmenu-handle    as widget-handle    no-undo.
        2   define input parameter p-mode               as integer          no-undo.
        3   define input parameter p-impexp-type        as character        no-undo.
        4   define input parameter p-esys-id            as integer          no-undo.
        5   define input parameter p-db-num             as integer          no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Типы данных для внешних подсистем OpenXML.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define new global shared variable g#library  as handle no-undo .
      296   define new global shared variable g#library2 as handle no-undo .
      297   define variable vss-include-info1 as character format "X(65)" no-undo
      298   initial "@(#)$Workfile$ $Revision$".
      299   define temp-table temp_oxmltd_sel no-undo
      300       field id    as integer
      301       field sel   as logical
      302       index pi is primary unique
      303           id
      304   .
      305   define temp-table temp_oxmltd_not_sel no-undo
      306       field id    as integer
      307       field sel   as logical
      308       index pi is primary unique
      309           id
      310   .
      311   procedure oxmltd-fill :
      312   define input parameter p-type       as character        no-undo.
      313   define input parameter p-esys-id    as integer          no-undo.
      314   define input parameter p-db-num     as integer          no-undo.
      315       define buffer buf_datatype-exp              for ub.datatype-exp.
      316       define buffer buf_datatype-imp              for ub.datatype-imp.
      317       define buffer buf_esys-datatype-exp         for ub.esys-datatype-exp.
      318       define buffer buf_esys-datatype-imp         for ub.esys-datatype-imp.
      319       define buffer buf_temp_oxmltd_sel           for temp_oxmltd_sel.
      320       define buffer buf_temp_oxmltd_not_sel       for temp_oxmltd_not_sel.
      321   do
      322   for buf_datatype-exp
      323     , buf_datatype-imp
      324     , buf_esys-datatype-exp
      325     , buf_esys-datatype-imp
      326     , buf_temp_oxmltd_sel
      327     , buf_temp_oxmltd_not_sel
      328   on error undo, return error
      329   :
      330       case p-type
      331       :
      332           when 'импорт':U
      333           then do:
      334               for each buf_datatype-imp no-lock
      335               on error undo, return error
      336               :
      337                   find first buf_esys-datatype-imp no-lock
      338                        where buf_esys-datatype-imp.esys-id = p-esys-id
      339                          and buf_esys-datatype-imp.db-num  = p-db-num
      340                          and buf_esys-datatype-imp.tdi-id  = buf_datatype-imp.dti-id
      341                   no-error.
      342                   if available buf_esys-datatype-imp
      343                   then do:
      344                       create buf_temp_oxmltd_sel.
      345                       assign
      346                           buf_temp_oxmltd_sel.id = buf_datatype-imp.dti-id
      347                       .
      348                   end.
      349                   else do:
      350                       create buf_temp_oxmltd_not_sel.
      351                       assign
      352                           buf_temp_oxmltd_not_sel.id = buf_datatype-imp.dti-id
      353                       .
      354                   end.
      355               end.
      356           end.
      357           when 'экспорт':U
      358           then do:
      359               for each buf_datatype-exp no-lock
      360               on error undo, return error
      361               :
      362                   find first buf_esys-datatype-exp no-lock
      363                        where buf_esys-datatype-exp.esys-id = p-esys-id
      364                          and buf_esys-datatype-exp.db-num  = p-db-num
      365                          and buf_esys-datatype-exp.dte-id  = buf_datatype-exp.dte-id
      366                   no-error.
      367                   if available buf_esys-datatype-exp
      368                   then do:
      369                       create buf_temp_oxmltd_sel.
      370                       assign
      371                           buf_temp_oxmltd_sel.id = buf_datatype-exp.dte-id
      372                       .
      373                   end.
      374                   else do:
      375                       create buf_temp_oxmltd_not_sel.
      376                       assign
      377                           buf_temp_oxmltd_not_sel.id = buf_datatype-exp.dte-id
      378                       .
      379                   end.
      380               end.
      381           end.
      382       end case.
      383   end.
      384   end procedure.
      385   procedure oxmltd-select-one :
      386   define input parameter p-selected-id as integer          no-undo.
      387       define buffer buf_temp_oxmltd_sel       for temp_oxmltd_sel.
      388       define buffer buf_temp_oxmltd_not_sel   for temp_oxmltd_not_sel.
      389   do
      390   for buf_temp_oxmltd_sel
      391     , buf_temp_oxmltd_not_sel
      392   on error undo, return error
      393   :
      394       find first buf_temp_oxmltd_not_sel
      395            where buf_temp_oxmltd_not_sel.id = p-selected-id
      396       no-error.
      397       if available buf_temp_oxmltd_not_sel
      398       then do:
      399           delete buf_temp_oxmltd_not_sel.
      400           find first buf_temp_oxmltd_sel
      401               where buf_temp_oxmltd_sel.id = p-selected-id
      402           no-error.
      403           if not available buf_temp_oxmltd_sel
      404           then do:
      405               create buf_temp_oxmltd_sel.
      406               assign
      407                   buf_temp_oxmltd_sel.id  = p-selected-id
      408                   buf_temp_oxmltd_sel.sel = yes
      409               .
      410           end.
      411       end.
      412   end.
      413   end procedure.
      414   procedure oxmltd-deselect-one :
      415   define input parameter p-selected-id as integer          no-undo.
      416       define buffer buf_temp_oxmltd_sel       for temp_oxmltd_sel.
      417       define buffer buf_temp_oxmltd_not_sel   for temp_oxmltd_not_sel.
      418   do
      419   for buf_temp_oxmltd_sel
      420     , buf_temp_oxmltd_not_sel
      421   on error undo, return error
      422   :
      423       find first buf_temp_oxmltd_sel
      424            where buf_temp_oxmltd_sel.id = p-selected-id
      425       no-error.
      426       if available buf_temp_oxmltd_sel
      427       then do:
      428           delete buf_temp_oxmltd_sel.
      429           find first buf_temp_oxmltd_not_sel
      430                where buf_temp_oxmltd_not_sel.id = p-selected-id
      431           no-error.
      432           if not available buf_temp_oxmltd_not_sel
      433           then do:
      434               create buf_temp_oxmltd_not_sel.
      435               assign
      436                   buf_temp_oxmltd_not_sel.id  = p-selected-id
      437                   buf_temp_oxmltd_not_sel.sel = yes
      438               .
      439           end.
      440       end.
      441   end.
      442   end procedure.
      443   procedure oxmltd-select :
      444   define input parameter p-selected-id as integer          no-undo.
      445       define variable v-have-selected    as logical      no-undo.
      446       define buffer buf_temp_oxmltd_not_sel   for temp_oxmltd_not_sel.
      447   do
      448   for buf_temp_oxmltd_not_sel
      449   on error undo, return error
      450   :
      451       assign
      452           v-have-selected = no
      453       .
      454       for each buf_temp_oxmltd_not_sel
      455          where buf_temp_oxmltd_not_sel.sel = yes
      456       :
      457           run oxmltd-select-one in this-procedure (
      458               input buf_temp_oxmltd_not_sel.id
      459           ).
      460           assign
      461               v-have-selected = yes
      462           .
      463       end.
      464       if v-have-selected = no
      465       and p-selected-id <> 0
      466       then do:
      467           run oxmltd-select-one in this-procedure (
      468               input p-selected-id
      469           ).
      470       end.
      471   end.
      472   end procedure.
      473   procedure oxmltd-deselect :
      474   define input parameter p-selected-id as integer          no-undo.
      475       define variable v-have-selected    as logical      no-undo.
      476       define buffer buf_temp_oxmltd_sel       for temp_oxmltd_sel.
      477   do
      478   for buf_temp_oxmltd_sel
      479   on error undo, return error
      480   :
      481       assign
      482           v-have-selected = no
      483       .
      484       for each buf_temp_oxmltd_sel
      485          where buf_temp_oxmltd_sel.sel = yes
      486       :
      487           run oxmltd-deselect-one in this-procedure (
      488               input buf_temp_oxmltd_sel.id
      489           ).
      490           assign
      491               v-have-selected             = yes
      492           .
      493       end.
      494       if v-have-selected = no
      495       and p-selected-id <> 0
      496       then do:
      497           run oxmltd-deselect-one in this-procedure (
      498               input p-selected-id
      499           ).
      500       end.
      501   end.
      502   end procedure.
