     1204             then do:
     1205               assign
     1206                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1207               .
     1208             end.
     1209             assign
     1210               frame Dialog-Frame :height = v-frame-height
     1211             .
     1212             assign
