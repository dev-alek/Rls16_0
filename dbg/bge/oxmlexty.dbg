     1722         or error-status :get-message(1) <> ""
     1723         then do:
     1724           undo move_block, retry move_block.
     1725         end.
     1726         assign
     1727           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1728         no-error .
     1729         if error-status :error
     1730         or error-status :get-message(1) <> ""
     1731         then do:
     1732           undo move_block, retry move_block.
     1733         end.
