     1445       if v-diasize-wndstore = true
     1446       then do:
     1447         if connected("ub") = true
     1448         then do:
     1449           define variable v-cntxt-db-num        as integer   no-undo .
     1450           define variable v-cntxt-userid        as character no-undo .
     1451           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1452                                             , OUTPUT v-cntxt-userid
     1453                                             ) .
     1454           run gbl/wndsizew.p
     1455             (input  v-cntxt-db-num
     1456             ,input  v-cntxt-userid
     1457             ,input  v-diasize-proc-name
     1458             ,input  'height':u
     1459             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1460             ) .
