       88   procedure prn-lib-prn-file :
       89     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       90     define input parameter p-DIsabledoptions as integer no-undo .
       91     define variable v-report-name as character no-undo .
       92     define variable v-user-action as character no-undo .
       93     define variable v-printed     as logical   no-undo .
       94     define variable v-exist       as logical   no-undo .
       95     do
       96       on error undo, return error
       97       :
       98       run prn-lib-get-report-name  in this-procedure (
       99         input parParentProc
      100         ,output v-report-name
      101         ).
      102   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      104     (input  v-report-name
      105     ,input  2
      106     ,output v-exist
      107     )  .
      108       if NOT v-exist then
      109       DO:
      110         Message
      111           "Нет заданий на печать ! "
      112           view-as alert-box .
      113         Return  .
      114       End.
      115       run gbl/prnfilen.w
      116         (input  ""
      117         ,input  p-DisabledOptions
      118         ,input  string(v-report-name )
      119         ,input  7
      120         ,output v-user-action
      121         ,output v-printed
      122         ) .
      123       if v-printed then
      124       do:
      125         return "YES" .
      126       end.
      127       else
      128       do:
      129         return "NO" .
      130       end.
      131     end.
      132   end procedure.
      133   procedure prn-lib-open-stream :
      134     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      135     define input parameter p-page-size    as integer no-undo .
      136     define input parameter p-is-stream    as logical no-undo .
      137     define input parameter p-append       as logical no-undo .
      138     define variable v-report-name as character no-undo .
      139     do
      140       on error undo, return error
      141       :
      142       run prn-lib-get-report-name  in this-procedure (
      143         input parParentProc
      144         ,output v-report-name
      145         ).
      146       if p-is-stream then
      147       do:
      148         if p-append then
      149         do:
      150           output stream PrnLibStream to value( v-report-name )
      151             page-size value(p-page-size) append .
      152         end.
      153         if not p-append then
      154         do:
      155           output stream PrnLibStream to value( v-report-name )
      156             page-size value(p-page-size) .
      157         end.
      158       end.
      159       if not p-is-stream then
      160       do:
      161         if p-append then
      162         do:
      163           output to value( v-report-name )
      164             page-size value(p-page-size) append .
      165         end.
      166         if not p-append then
      167         do:
      168           output to value( v-report-name )
      169             page-size value(p-page-size) .
      170         end.
      171       end.
      172     end.
      173   end procedure.
      174   procedure prn-lib-open-exp :
      175     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      176     define input parameter p-is-stream    as logical no-undo .
      177     define input parameter p-is-append    as logical no-undo .
      178     define output parameter p-ReportFileName as char init "report" no-undo.
      179     define output parameter p-process as logical no-undo .
      180     define variable glog as logical no-undo .
      181     do
      182       on error undo, return error
      183       :
      184       SYSTEM-DIALOG GET-FILE p-ReportFileName
      185         TITLE      "Укажите путь"
      186         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      187         ASK-OVERWRITE
      188         CREATE-TEST-FILE
      189         SAVE-AS
      190         USE-FILENAME
      191         DEFAULT-EXTENSION "txt"
      192         UPDATE glog
      193         .
      194       if not glog then  return.
      195       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      196       if p-is-stream then
      197       do:
      198         if p-is-append then
      199         do:
      200           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      201         end.
      202         else
      203         do:
      204           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      205         end.
      206       end.
      207       else
      208       do:
      209         if p-is-append then
      210         do:
      211           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      212         end.
      213         else
      214         do:
      215           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      216         end.
      217       end.
      218       p-process = yes.
      219     end.
      220   end procedure.
      221   procedure prn-lib-get-report-name :
