     1384         OPEN QUERY BROWSE-GOODS FOR EACH tt-goods NO-LOCK.
     1385      END.
     1386   ON value-changed OF f-type-mark IN FRAME Dialog-Frame
     1387   DO:
     1388         assign f-type-mark .
     1389      END.
     1390   ON CHOOSE OF MENU-ITEM m_save_1
     1391   DO:
     1392         define variable undelete as logical no-undo .
     1393         define variable v-dir as character no-undo .
     1394         v-dir = session:temp-directory .
     1395         run bge/to_file.w (input-output v-dir) no-error .
     1396         run define-full-path-Report(input 1, input v-dir, output v-file-name-rep-htm, output v-file-name-rep-exl).
     1397         message "Сохранить данные в файл?"
     1398         view-as alert-box question buttons yes-no update undelete.
     1399         if undelete then do:
     1400            run file-save in this-procedure no-error .
     1401            if error-status:error
     1402            then
     1403               return no-apply.
     1404         end.
     1405         apply 'choose' to btn_save in frame Dialog-Frame .
     1406      END.
     1407   ON CHOOSE OF MENU-ITEM m_save_2
     1408   DO:
     1409         define variable undelete as logical no-undo .
     1410         define variable v-dir as character no-undo .
     1411         v-dir = session:temp-directory .
     1412         run bge/to_file.w (input-output v-dir) no-error .
     1413         run define-full-path-Report(input 2, input v-dir, output v-file-name-rep-htm, output v-file-name-rep-exl).
     1414         message "Сохранить данные в файл?"
     1415         view-as alert-box question buttons yes-no update undelete.
     1416         if undelete then do:
     1417         run file-save in this-procedure no-error .
     1418         end.
     1419         apply 'choose' to btn_save in frame Dialog-Frame .
     1420      END.
     1421   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1422      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1423   MAIN-BLOCK:
     1424   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1425      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1426      run init-proc.
     1427   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1428     run mainmenu_getcntxt in parparentproc
     1429       (output v-cntxt-db-num
     1430       ,output v-cntxt-userid
     1431       ,output v-cntxt-level
     1432       ,output v-cntxt-host-code-obj
     1433       ,output v-cntxt-obj-type
     1434       ,output v-cntxt-obj-code
     1435       ,output v-cntxt-db-num-obj
     1436       ,output v-cntxt-is-admin
     1437       ) .
     1438      RUN enable_UI.
     1439      WAIT-FOR GO OF FRAME Dialog-Frame.
     1440   END.
     1441   RUN disable_UI.
     1442   PROCEDURE init-proc :
     1443   define variable v-list as character no-undo.
     1444   define variable vi as integer no-undo.
     1445   define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     1446   define variable objType  as ibs.th.gbl.propmap no-undo.
     1447   MarkType = ObjSrv:Env:Marking:Types:MAPTYPE.
     1448   do vi = 1 to MarkType:GetItemByLab(vi):
     1449   objType  = ObjSrv:Env:Marking:Types:CurrProp.
     1450       v-list = v-list + "," + objType:Label_ + "," + objType:NameProp.
     1451   end.
     1452   v-list = trim(v-list, ",").
     1453   f-type-mark:list-item-pairs in frame Dialog-Frame = v-list.
     1454   END PROCEDURE.
     1455   PROCEDURE create-file :
     1456      define input parameter p-file-name as character no-undo.
     1457      output to value(string(p-file-name)).
     1458      output close.
     1459   END PROCEDURE.
     1460   PROCEDURE define-full-path-Report :
     1461      define input parameter p-rep-num as integer no-undo.
     1462      define input parameter p-dir as character no-undo .
     1463      define output parameter p-file-name-rep-htm as character no-undo.
     1464      define output parameter p-file-name-rep-exl as character no-undo.
     1465      p-file-name-rep-htm = p-dir + "GTIN_" + string(v-cntxt-obj-code) + "_type_" + string(p-rep-num) + ".html".
     1466      p-file-name-rep-exl = p-dir + "GTIN_" + string(v-cntxt-obj-code) + "_type_" + string(p-rep-num) + ".xlsx".
     1467   END PROCEDURE.
     1468   PROCEDURE disable_UI :
     1469     HIDE FRAME Dialog-Frame.
     1470   END PROCEDURE.
     1471   PROCEDURE enable_UI :
     1472      ENABLE Btn_save Btn_Cancel Btn_open Btn_add_goods Btn_add_group Btn_del
     1473         BROWSE-GOODS f-type-mark
     1474         WITH FRAME Dialog-Frame.
     1475      OPEN QUERY BROWSE-GOODS FOR EACH tt-goods NO-LOCK.
     1476   END PROCEDURE.
     1477   PROCEDURE imp-GTIN :
     1478      DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     1479      DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     1480      DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     1481      DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     1482      DEFINE VARIABLE vLine             AS INTEGER          NO-UNDO.
     1483      DEFINE VARIABLE vChLine           AS CHARACTER        NO-UNDO.
     1484      DEFINE VARIABLE vCh               AS CHARACTER        NO-UNDO.
     1485      DEFINE VARIABLE vNoLine           AS INTEGER          NO-UNDO.
     1486      define variable v-gds-code        as character        no-undo .
     1487      define variable v-gds-name        as character        no-undo .
     1488      define variable v-bar-code        as character        no-undo .
     1489      define variable v-GTIN            as character        no-undo .
     1490      define variable v-qnty            as character        no-undo .
     1491      define variable v-mark-code       as character        no-undo .
     1492      CREATE "Excel.Application":U mExcelApplication no-error.
     1493      if error-status :error then
     1494      do:
     1495         message
     1496            "Ошибка при запуске Excel" skip
     1497            error-status :get-message(1) skip
     1498            view-as alert-box error .
     1499         undo, return error .
     1500      end.
     1501      ASSIGN
     1502         mExcelApplication:DisplayAlerts = NO
     1503         mWorkbook                       = mExcelApplication:WorkBooks:Add(v_os-file)
     1504         mWorkSheet                      = mWorkbook:Sheets:Item(1)
     1505         .
     1506      loopbl:
     1507      do vLine = 2 to 1000000:
     1508         ASSIGN
     1509            vChLine     = STRING(vLine)
     1510            v-gds-code  = ''
     1511            v-gds-name  = ''
     1512            v-bar-code  = ''
     1513            v-GTIN      = ''
     1514            v-qnty      = ''
     1515            v-mark-code = ''
     1516            .
     1517         v-gds-code = mWorkSheet:Range("B" + vChLine):FORMULA NO-ERROR.
     1518         if v-gds-code = ? then v-gds-code = mWorkSheet:Range("B" + vChLine):VALUE NO-ERROR.
     1519         v-gds-name = mWorkSheet:Range("C" + vChLine):VALUE NO-ERROR.
     1520         if v-gds-name = ? then v-gds-name = mWorkSheet:Range("C" + vChLine):FORMULA NO-ERROR.
     1521         v-bar-code = mWorkSheet:Range("D" + vChLine):FORMULA NO-ERROR.
     1522         if v-bar-code = ? then v-bar-code = mWorkSheet:Range("D" + vChLine):VALUE NO-ERROR.
     1523         v-GTIN = mWorkSheet:Range("E" + vChLine):FORMULA NO-ERROR.
     1524         if v-GTIN = ? then v-GTIN = mWorkSheet:Range("E" + vChLine):VALUE NO-ERROR.
     1525         v-qnty = mWorkSheet:Range("F" + vChLine):FORMULA NO-ERROR.
     1526         if v-qnty = ? then v-qnty = mWorkSheet:Range("F" + vChLine):FORMULA NO-ERROR.
     1527         v-mark-code = mWorkSheet:Range("G" + vChLine):FORMULA NO-ERROR.
     1528         if v-mark-code = ? then v-mark-code = mWorkSheet:Range("G" + vChLine):VALUE NO-ERROR.
     1529         if length(v-gds-code) > 0
     1530            or length(v-gds-name) > 0
     1531            or length(v-bar-code) > 0
     1532            or length(v-GTIN) > 0
     1533            or length(v-qnty) > 0
     1534            or length(v-mark-code) > 0
     1535            then
     1536         do :
     1537            vNoLine = 0 .
     1538         end.
     1539         else
     1540         do :
     1541            vNoLine = vNoLine + 1.
     1542            IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     1543            ELSE NEXT loopbl.
     1544         end.
     1545         find first tt-goods where tt-goods.gds-code = integer(v-gds-code) and tt-goods.barcode = v-bar-code and
     1546                                   tt-goods.GTIN     = v-GTIN no-error .
     1547         if not available (tt-goods) then do:
     1548         create tt-goods .
     1549         tt-goods.gds-code = integer(v-gds-code) .
     1550         tt-goods.gds-name = v-gds-name .
     1551         tt-goods.barcode = v-bar-code .
     1552         tt-goods.GTIN     = v-GTIN .
     1553         tt-goods.qnty     = integer(v-qnty) .
     1554         tt-goods.type-mark = get-mark-char(v-mark-code) .
     1555         release tt-goods .
     1556         end.
     1557      end.
     1558   END PROCEDURE.
     1559   PROCEDURE file-save :
     1560      define variable ii as integer no-undo .
     1561         if search (v-file-name-rep-htm) <> ? then
     1562      do:
     1563         os-delete value(v-file-name-rep-htm).
     1564      end.
     1565      if search (v-file-name-rep-exl) <> ? then
     1566      do:
     1567         os-delete value(v-file-name-rep-exl).
     1568      end.
     1569      run create-file(v-file-name-rep-htm).
     1570      run waitfram-show in this-procedure ( "ЖДИТЕ... Формирование отчёта") .
     1571      output stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8' .
     1572      put stream OutStr-html unformatted
     1573         "<!DOCTYPE HTML>" skip
     1574         ' <html>' skip
     1575         '  <head>' skip
     1576         '   <meta charset="utf-8">' skip
     1577         '    <style type="text/css">' skip
     1578         '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 500px; padding: 3px; ' + chr(125) skip
     1579         '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     1580         '      htm' skip
     1581         '      .rotate ' + chr(123) skip
     1582         '        -webkit-transform: rotate(-90deg);' skip
     1583         '        -moz-transform: rotate(-90deg);' skip
     1584         '        -ms-transform: rotate(-90deg);' skip
     1585         '        -o-transform: rotate(-90deg);' skip
     1586         '        transform: rotate(-90deg);' skip
     1587         '        -webkit-transform-origin: 50% 50%;' skip
     1588         '        -moz-transform-origin: 50% 50%;' skip
     1589         '        -ms-transform-origin: 50% 50%;' skip
     1590         '        -o-transform-origin: 50% 50%;' skip
     1591         '        transform-origin: 50% 50%;' skip
     1592         '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     1593         '          ' + chr(125) skip
     1594         '            th' + ' ' + chr(123) skip
     1595         '            border: 1px black solid;' skip
     1596         '            word-wrap: break-word;' skip
     1597         '          ' + chr(125) skip
     1598         '   </style>' skip
     1599         '  </head>' skip
     1600         .
     1601      put stream OutStr-html unformatted
     1602         '<body>' skip
     1603         '<table name="Лист1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1604         '<thead>' skip
     1605         .
     1606      put stream OutStr-html unformatted
     1607         '<tr class="set_columns">' skip
     1608         '<td style="width: 50px; border: none;"></td>' skip
     1609         '<td style="width: 60px; border: none;"></td>' skip
     1610         '<td style="width: 180px; border: none;"></td>' skip
     1611         '<td style="width: 120px; border: none;"></td>' skip
     1612         '<td style="width: 120px; border: none;"></td>' skip
     1613         '<td style="width: 80px; border: none;"></td>' skip
     1614         '<td style="width: 100px; border: none;"></td>' skip
     1615         '</tr>' skip
     1616         .
     1617      put stream OutStr-html unformatted
     1618         '     <tbody>' skip
     1619         '       <tr>' skip
     1620         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">№П/П</th>' skip
     1621         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">Код товара</th>' skip
     1622         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">Название товара</th>' skip
     1623         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">Штрих-код упаковки</th>' skip
     1624         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">GTIN упаковки</th>' skip
     1625         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">Кол-во единиц в упаковке</th>' skip
     1626         '         <th text_wrap="true" style="text-align: center; font-weight:bold;">Тип маркировки</th>' skip
     1627         '       </tr>' skip
     1628         .
     1629      for each tt-goods:
     1630         ii = ii + 1 .
     1631         put stream OutStr-html unformatted
     1632            '       <tr>' skip
     1633            '         <th text_wrap="true" style="text-align: center;">' + string(ii) + '</th>' skip
     1634            '         <th text_wrap="true" style="text-align: center;">' + string(tt-goods.gds-code) + '</th>' skip
     1635            '         <th text_wrap="true" style="text-align: center;">' + string(tt-goods.gds-name) + '</th>' skip
     1636            '         <th text_wrap="true" style="text-align: center;">' + string(tt-goods.barcode) + '</th>' skip
     1637            '         <th text_wrap="true" style="text-align: center;">' + string(tt-goods.GTIN) + '</th>' skip
     1638            '         <th text_wrap="true" style="text-align: center;">' + string(tt-goods.qnty) + '</th>' skip
     1639            '         <th text_wrap="true" style="text-align: center;">' + get-mark-integer(tt-goods.type-mark) + '</th>' skip
     1640            '       </tr>' skip
     1641            .
     1642      end.
     1643      put stream OutStr-html unformatted
     1644         '     </tbody>' skip
     1645         '   </table>' skip
     1646         '  </body>' skip
     1647         ' </html>' skip
     1648         .
     1649      output stream OutStr-html close.
     1650      run prn-lib-reportviewer in this-procedure (
     1651         input THIS-PROCEDURE
     1652         ,input v-file-name-rep-htm
     1653         ,input "GUI:FALSE" + chr(4) + "OS:7_32"
     1654         ) no-error.
     1655      if error-status:error then
     1656      do:
     1657         message return-value view-as alert-box.
     1658         run waitfram-hide in this-procedure .
     1659         return error.
     1660      end.
     1661      run waitfram-hide in this-procedure .
     1662      if  search (v-file-name-rep-exl) = ?
     1663      then do:
     1664         message "Oшибка создания файла. Промежуточный результат в " v-file-name-rep-htm
     1665         view-as alert-box.
     1666         return error.
     1667      end.
     1668      os-delete value(v-file-name-rep-htm) .
     1669   END PROCEDURE.
     1670   PROCEDURE proc-choose-file :
     1671      define variable ll_commit          AS LOG       NO-UNDO INIT NO.
     1672      define variable v-full-path        as character no-undo .
     1673      define variable v-path             as character no-undo .
     1674      define variable v-file-name        as character no-undo .
     1675      define variable v-file-name-no-ext as character no-undo .
     1676      define variable v-file-name-ext    as character no-undo .
     1677      if search (v-proc-name-err) <> ? then
     1678      do:
     1679         os-delete value(v-proc-name-err).
     1680      end.
     1681      if search (v-proc-name-GTIN) <> ? then
     1682      do:
     1683         os-delete value(v-proc-name-GTIN).
     1684      end.
     1685      SYSTEM-DIALOG GET-FILE v_os-file
     1686         TITLE "Выберите файл для импорта"
     1687         FILTERS
     1688         " MS Excel (*.xls,*.xlsx) " "*.xls,*.xlsx"
     1689         INITIAL-DIR v-init-dir
     1690         must-exist
     1691         default-extension "xls"
     1692         .
     1693      IF v_os-file <> "" THEN
     1694      DO:
     1695         run imp-GTIN .
     1696         INPUT FROM value(v_os-file).
     1697      end.
     1698   END PROCEDURE.
     1699   PROCEDURE proc-del :
     1700      delete tt-goods .
     1701      do transaction:
     1702         OPEN QUERY BROWSE-GOODS FOR EACH tt-goods NO-LOCK.
     1703      end.
     1704   END PROCEDURE.
     1705   FUNCTION get-mark-char RETURNS CHARACTER
     1706      ( input p-mark as character ) :
     1707      define variable v-mark as character no-undo.
     1708      define variable MarkType as ibs.th.str.marking.Types no-undo.
     1709      MarkType = ObjSrv:Env:Marking:Types.
     1710      v-mark = MarkType:GetNameProp(int(p-mark)).
     1711      return v-mark .
     1712   END FUNCTION.
     1713   FUNCTION get-mark-integer RETURNS CHARACTER
     1714      ( input p-mark as character) :
     1715      define variable v-mark as character no-undo .
     1716      define variable MarkType as ibs.th.str.marking.Types no-undo.
     1717      MarkType = ObjSrv:Env:Marking:Types.
     1718      v-mark = string(MarkType:GetKeyIntDB(p-mark)).
     1719      return v-mark .
     1720   END FUNCTION.
