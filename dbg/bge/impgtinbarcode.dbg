      937   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   define variable v-waitfram-action01         as character   no-undo .
      939   define variable v-waitfram-action02         as character   no-undo .
      940   define variable v-waitfram-action03         as character   no-undo .
      941   define variable mWaitFramTextBeg            as character   no-undo.
      942   define variable mWaitFramTextEnd            as character   no-undo.
      943   define variable mWaitFramView               as logical     no-undo.
      944   define variable mWaitProcEvent              as logical     no-undo init yes.
      945   define variable mWaitFramInterval           as integer     no-undo init 1 .
      946   define variable mWaitFramStop               as logical     no-undo.
      947   define variable mWaitFramStopUser           as logical     no-undo.
      948   define variable mWaitFramStopTimeOut        as logical     no-undo.
      949   define variable mWaitFramStartProc          as datetime-tz no-undo.
      950   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      951   define button B-WaitFramStop auto-end-key
      952        label "Стоп"
      953        size 10 by 1 tooltip "Остоновить процесс".
      954   define button B-viewProcInfo
      955        label "Информация"
      956        size 15 by 1 tooltip "Информация о процесс".
      957   define frame waitfram
      958     v-waitfram-action01 format "x(72)" no-label skip
      959     v-waitfram-action02 format "x(72)" no-label skip
      960     v-waitfram-action03 format "x(72)" no-label skip
      961     B-viewProcInfo
      962     B-WaitFramStop at row 4 col 30
      963     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      964     .
      965   define new global shared variable mBatchMode as logical no-undo init ?.
      966   define variable mFramBachModHandle as handle no-undo.
      967   mFramBachModHandle = frame waitfram:handle.
      968   define variable mFameOldVis as logical no-undo.
      969   define variable mVisCUrentVin as logical no-undo.
      970   if session:batch-mode
      971   then
      972      mBatchMode = yes.
      973   if mBatchMode = ? then do:
      974     mVisCUrentVin = current-window:visible.
      975     mFameOldVis = mFramBachModHandle:visible.
      976     mFramBachModHandle:visible  = yes.
      977     mBatchMode = mFramBachModHandle:visible ne yes.
      978     mFramBachModHandle:visible = mFameOldVis.
      979     current-window:visible = mVisCUrentVin.
      980   end.
      981    if  log-manager:logfile-name ne ?
      982     then DO:
      983         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      984         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      985         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      986     end.
      987   on choose of B-WaitFramStop in frame waitfram
      988   do:
      989     mWaitFramStop = yes.
      990     mWaitFramStopUser = yes.
      991   end.
      992   function waitfram-check-timeout returns logical():
      993      define variable vtime as int64 no-undo.
      994      if mWaitFramStopTimeOut
      995      then
      996         return yes.
      997      vtime = ( now - mWaitFramStartProc ) / 1000 .
      998      if     mWaitFramTimeOut ne ?
      999         and mWaitFramTimeOut ne 0
     1000         and mWaitFramTimeOut lt vtime
     1001      then do:
     1002         mWaitFramStopTimeOut = yes.
     1003      end.
     1004      return mWaitFramStopTimeOut.
     1005   end.
     1006   procedure waitfram-hide :
     1007     if not session:batch-mode
     1008     then do
     1009     on error undo, return error return-value
     1010     :
     1011       pause 0 before-hide .
     1012       if not mBatchMode then
     1013         hide frame waitfram .
     1014     if     not mWaitFramView
     1015        and mWaitProcEvent
     1016     then
     1017       process events .
     1018     end.
     1019   end procedure.
     1020   procedure waitfram-show :
     1021     define input  parameter p-message as character no-undo .
     1022     define variable v-left-margin as integer   no-undo .
     1023     if not session:batch-mode
     1024     then do
     1025     on error undo, return error return-value
     1026     :
     1027       if length(p-message) <= 70 then do:
     1028         assign
     1029           v-left-margin = integer((70 - length(p-message)) / 2)
     1030         .
     1031         assign
     1032           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1033         .
     1034         assign
     1035           v-waitfram-action01 = " "
     1036           v-waitfram-action02 = " "
     1037                                    + fill(" ", v-left-margin)
     1038                                    + p-message
     1039           v-waitfram-action03 = " "
     1040         .
     1041       end.
     1042       else do:
     1043         define variable vRindex1 as integer no-undo.
     1044         define variable vRindex2 as integer no-undo.
     1045         vRindex1 = r-index(p-message," ",70).
     1046         if vRindex1 = 0
     1047         then
     1048            vRindex1 = 70.
     1049         if length(p-message)  <= vRindex1 + 70 then do:
     1050           assign
     1051             v-waitfram-action01 = " "
     1052             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1053             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1054           .
     1055         end.
     1056         else do:
     1057           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1058           if vRindex2 <= vRindex1
     1059           then
     1060              vRindex2 = vRindex1 + 70.
     1061           assign
     1062             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1063             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1064             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1065           .
     1066         end.
     1067       end.
     1068       B-viewProcInfo:visible   in frame waitfram = no.
     1069       B-viewProcInfo:sensitive in frame waitfram = no.
     1070       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1071       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1072       if  (   mWaitFramView
     1073          or  mWaitProcEvent)
     1074          and not mBatchMode
     1075       then
     1076          display
     1077             v-waitfram-action01 skip
     1078             v-waitfram-action02 skip
     1079             v-waitfram-action03 skip
     1080          with frame waitfram .
     1081       if     mWaitFramView
     1082          then do:
     1083             if     mWaitFramInterval ne ?
     1084                and not mBatchMode
     1085             then
     1086                wait-for go of frame waitfram pause mWaitFramInterval.
     1087          end.
     1088          else
     1089             if     mWaitProcEvent
     1090                and not mBatchMode
     1091             then
     1092                process events .
     1093     end.
     1094   end procedure.
     1095      procedure waitfram-show-this:
     1096         define input  parameter iInterval as int64 no-undo.
     1097         define variable vtime as int64 no-undo.
     1098         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1099         mWaitFramInterval = iInterval.
     1100         run waitfram-show (substitute("&1&2 &3&4" ,
     1101                                       mWaitFramTextBeg ,
     1102                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1103                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1104                                       mWaitFramTextEnd
     1105                                      )
     1106                           ).
     1107      end.
     1108      procedure WaitFramRunPause:
     1109         define input  parameter iInterval as dec no-undo.
     1110         define variable vStart  as datetime-tz no-undo.
     1111         define variable vend    as datetime-tz no-undo.
     1112         define variable vint as int64 no-undo.
     1113         define variable vOk as logical no-undo.
     1114         vStart = now.
     1115         vend   = vStart.
     1116         publish "WaitFramPause" (iInterval,output vOk).
     1117         vend   =  now.
     1118         vint = vend - vStart.
     1119         vint = iInterval - vint / 1000.
     1120         if     not mWaitFramStop
     1121            and (   vint > 0
     1122                 or (    not vOk
     1123                     and iInterval eq ?
     1124                     )
     1125                 )
     1126         then
     1127            run waitfram-show-this (iInterval).
     1128         vend   =  now.
     1129         vint = vend - vStart.
     1130         vint = iInterval - vint / 1000.
     1131         if     not mWaitFramStop
     1132            and vint > 0
     1133         then do:
     1134            run gbl/pause.p (vint * 1000).
     1135         end.
     1136         if iInterval ne ?
     1137         then
     1138            publish "WaitFramStop".
     1139         waitfram-check-timeout().
     1140      end.
     1141      procedure WaitFramWaitFor:
     1142         define input  parameter iInterval as dec no-undo.
     1143         assign
     1144            mWaitFramStartProc   = now
     1145            mWaitFramStopUser    = no
     1146            mWaitFramStopTimeOut = no
     1147         .
     1148         block-wait:
     1149         do while not mWaitFramStop:
     1150            run WaitFramRunPause (iInterval).
     1151            if  waitfram-check-timeout()
     1152            then do:
     1153               leave block-wait.
     1154            end.
     1155         end.
     1156         run waitfram-hide.
     1157      end.
     1158   procedure waitfram-join :
     1159     define input  parameter p-line-1  as character no-undo .
     1160     define input  parameter p-line-2  as character no-undo .
     1161     define input  parameter p-line-3  as character no-undo .
     1162     define output parameter p-message as character no-undo .
     1163     do
     1164     on error undo, return error return-value
     1165     :
     1166       assign
     1167         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1168                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1169                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1170       .
     1171     end.
     1172   end procedure.
     1173   function waitfram-join-function returns character
     1174     (input p-line-1 as character
     1175     ,input p-line-2 as character
     1176     ,input p-line-3 as character
     1177     ).
     1178     define variable v-message as character no-undo .
     1179     run waitfram-join in this-procedure
     1180       (input  p-line-1
     1181       ,input  p-line-2
     1182       ,input  p-line-3
     1183       ,output v-message
     1184       ) .
     1185     return v-message .
     1186   end function .
     1187   function fnc-convert-dot-to-colon returns character
     1188       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1189   function fnc-convert-dot-to-colon returns character
     1190   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1191       define variable result as character no-undo.
     1192       define variable v-str-result as character no-undo.
     1193       if p-data = ? then p-data = 0 .
     1194       p-data = round(p-data, p-num).
     1195       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1196       return v-str-result.
     1197   END FUNCTION.
