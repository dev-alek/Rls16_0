      223     define output parameter p-report-name as character no-undo .
      224     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      225   end procedure.
      226   procedure prn-lib-reportviewer-report-name :
      227     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      228     define input parameter p-report-name-html as character no-undo .
      229     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      230   end procedure.
      231   procedure prn-lib-reportviewer :
      232     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      233     define input parameter p-report-name-html as character no-undo .
      234     define input parameter p-param        as character no-undo .
      235     define variable v-excel           as character no-undo init 'TRUE' .
      236     define variable v-value-character as character no-undo .
      237     define variable v-value-integer   as character no-undo .
      238     define variable v-value-date      as date      no-undo .
      239     define variable v-value-decimal   as decimal   no-undo .
      240     define variable rep-excel         as logical   no-undo .
      241     define variable excel-string      as character no-undo .
      242     define variable v-param-type      as character no-undo .
      243     define variable v-tth             as handle    no-undo .
      244     run adm/shattri.p (
      245       input "get":U
      246       ,input  ""
      247       ,input  0
      248       ,input  'report-glob':U
      249       ,input  'rep-excel':U
      250       ,output v-value-character
      251       ,output v-value-date
      252       ,output v-value-decimal
      253       ,output v-value-integer
      254       ,output rep-excel
      255       ,output v-param-type
      256       ,INPUT-OUTPUT table-handle v-tth
      257       )  .
      258     if rep-excel then v-excel = "TRUE" .
      259     else v-excel = "FALSE" .
      260     if p-param eq ""
      261     then
      262        p-param = "EXCEL:" + v-excel.
      263     else
      264        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      265     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      266   end procedure.
      267   define variable vss-include-info3 as character format "X(65)" no-undo
      268   initial "@(#)$Workfile$ $Revision$".
      269   procedure grplib-get-full-name :
      270      define input parameter p-node-code  as integer      no-undo.
      271      define output parameter p-full-name as character    no-undo.
      272      do
      273   on error undo, return error
      274   :
      275       define variable v-upper-code    as integer           no-undo.
      276       define buffer buf_gds-grp       for ub.gds-grp.
      277       define buffer buf_upper_gds-grp for ub.gds-grp.
      278       find first buf_gds-grp no-lock
      279            where buf_gds-grp.node-code = p-node-code
      280       no-error.
      281       if not available buf_gds-grp
      282       then do:
      283           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      284       end.
      285       assign
      286           p-full-name  = ""
      287           v-upper-code = 1
      288       .
      289       do while buf_gds-grp.upper-code <> 0
      290       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      291       :
      292           assign
      293               p-full-name  = buf_gds-grp.node-name
      294                            + (if p-full-name <> "" then chr(47) else "")
      295                            + p-full-name
      296               v-upper-code = buf_gds-grp.upper-code
      297           .
      298           find first buf_gds-grp no-lock
      299                where buf_gds-grp.node-code = v-upper-code
      300           no-error.
      301           if not available buf_gds-grp
      302           then do:
      303               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      304                                   + string( v-upper-code )
      305                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      306           end.
      307       end.
      308       assign
      309       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      310       .
      311   end.
      312   end .
      313   procedure grplib-get-node-from-full-name :
      314   define input parameter p-full-name as character no-undo .
      315   define output parameter p-node-code as integer no-undo .
      316   define variable v-ii as integer no-undo .
      317   define variable v-upper-code as integer no-undo .
      318   define variable v-root-code as integer no-undo .
      319   define variable v-entry as character no-undo .
      320   define buffer buf_gds-grp       for ub.gds-grp.
      321   do
      322   on error undo, return error
      323   :
      324     find first buf_gds-grp no-lock
      325         where buf_gds-grp.upper-code = 0
      326     no-error .
      327     if not available buf_gds-grp
      328     then do:
      329         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      330     end.
      331     else do:
      332       assign
      333       v-root-code = buf_gds-grp.node-code
      334       .
      335     end.
      336     v-upper-code = v-root-code.
      337     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      338       assign
      339       v-entry = entry(v-ii, p-full-name, chr(47)).
      340       if v-entry = '' then leave.
      341       find first buf_gds-grp no-lock where
      342                 buf_gds-grp.node-name = v-entry
      343             and buf_gds-grp.upper-code = v-upper-code
      344             no-error.
      345       if not available buf_gds-grp then do:
      346         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      347       end.
      348       else do:
      349         p-node-code = buf_gds-grp.node-code.
      350         v-upper-code = buf_gds-grp.node-code.
      351       end.
      352     end.
      353   end.
      354   end .
