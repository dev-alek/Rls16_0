        1   block-level on error undo, throw.
        2   define input parameter p-obj-type               as character        no-undo.
        3   define input parameter p-obj-code               as integer          no-undo.
        4   define input parameter p-date-to                as date             no-undo.
        5   define input parameter p-fact-order-to          as integer          no-undo.
        6   define input parameter p-obj-list               as character        no-undo.
        7   define input parameter p-parameter-list         as character        no-undo.
        8   define input parameter p-parts                  as character        no-undo.
        9   define input parameter p-xml-file-name          as character        no-undo.
       10   define input parameter p-log-file-name          as character        no-undo.
       11   define input parameter p-list-file-name         as character        no-undo.
       12   define input parameter p-xml-file-number        as integer          no-undo.
       13   define input parameter hedt                     as handle           no-undo.
       14   define input parameter hcnt                     as handle           no-undo.
