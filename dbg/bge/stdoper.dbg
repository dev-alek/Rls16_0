     2741                           run bgelib-tag-put( input 4, input "PartsAlcAttrAlcType"          , input string( v-PartsAlcAttrAlcType ) , input 1 ).
     2742                           run bgelib-tag-put( input 4, input "PartsAlcAttrAlcCode"          , input string(v-PartsAlcAttrAlcCode ) , input 1 ).
     2743                           run bgelib-tag-put( input 4, input "PartsAlcAttrRefA"          , input string(v-PartsAlcAttrRefA ) , input 1 ).
     2744                           run bgelib-tag-put( input 4, input "PartsAlcAttrRefB"          , input string( v-PartsAlcAttrRefB  ) , input 1 ).
     2745                           run bgelib-tag-put( input 4, input "PartsAlcAttrProd"          , input string( v-PartsAlcAttrProd ) , input 1 ).
     2746                           run bgelib-tag-put( input 4, input "PartsAlcAttrQualityCertify"       , input string( v-alc-quality-certif-path ) , input 1 ).
     2747                           run bgelib-tag-put( input 4, input "PartsAlcAttrCertifPath"           , input string( v-alc-certif-path ) , input 1 ).
     2748                           run bgelib-tag-put( input 4, input "PartsAlcAttrImpCode"              , input string( v-alc-imp-code ) , input 1 ).
     2749                           run bgelib-tag-put( input 4, input "PartsAlcAttrImpType"              , input string( v-alc-imp-type ) , input 1 ).
     2750                           run bgelib-tag-close( input 3, input "storePartsAlcAttr").
     2751                       end.
     2752                   run bgelib-tag-close( input 2, input "storeParts" ).
     2753             end.
     2754           end.
     2755       run bgelib-tag-close( input 1, input "storeGoods" ).
     2756   end.
     2757   end procedure.
     2758   procedure get-base-code-okv :
     2759   define input parameter p-base-code          as integer          no-undo.
     2760   define output parameter p-base-code-okv     as integer          no-undo.
     2761       define buffer buf_currency      for ub.currency.
     2762   do
     2763   for buf_currency
     2764   on error undo, return error
     2765   :
     2766       find first buf_currency no-lock
     2767            where buf_currency.curr-code = p-base-code
     2768       .
     2769       assign
     2770           p-base-code-okv = buf_currency.okv-code
     2771       .
     2772   end.
     2773   end procedure.
