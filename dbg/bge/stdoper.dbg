     2345   procedure write-result :
     2346   define input parameter p-obj-type       as character        no-undo.
     2347   define input parameter p-obj-code       as integer          no-undo.
     2348   define input parameter p-artic          as character        no-undo.
     2349   define input parameter p-prod-type      as character        no-undo.
     2350   define input parameter p-prod-code      as integer          no-undo.
     2351   define input parameter p-free-qnty         as decimal          no-undo.
     2352   define input parameter p-fact-order     as integer          no-undo.
     2353   define input parameter p-r-b-is-base    as logical          no-undo.
     2354       define variable v-gds-code          as integer      no-undo.
     2355       define variable v-gds-name          as character    no-undo.
     2356       define variable v-GoodsGrpCode as character no-undo.
     2357       define variable v-GoodsPackQnty as character no-undo.
     2358       define variable v-GoodsUnitBase as character no-undo.
     2359       define variable v-GoodsPS as character no-undo.
     2360       define variable v-GoodsCountryName as character no-undo.
     2361       define variable v-GoodsEnglName as character no-undo.
     2362       define variable v-GoodsProdName as character no-undo.
     2363       define variable v-GoodsWeight as character no-undo.
     2364       define variable v-GoodsWidth as character no-undo.
     2365       define variable v-GoodsLength as character no-undo.
     2366       define variable v-GoodsHeight as character no-undo.
     2367       define variable v-type as character no-undo.
     2368       define variable v-value as character no-undo.
     2369       define variable v-not-output-result as logical      no-undo.
     2370       define variable v-in-code as character no-undo.
     2371       define variable v-parts-code as character no-undo.
     2372       define variable v-fact-qnty as decimal no-undo.
     2373       define variable v-supp-type as character no-undo.
     2374       define variable v-supp-code as integer no-undo.
     2375       define VARIABLE v-price-cli as decimal no-undo.
     2376       define variable v-cst-code as character no-undo.
     2377       define VARIABLE v-gds-attr-value as character no-undo.
     2378       define VARIABLE v-gds-attr-type as character no-undo.
     2379       define VARIABLE v-alc-bottling-date like ub.parts.alc-bottling-date no-undo.
     2380       define VARIABLE v-alc-ref-ab-path like ub.parts.alc-ref-ab-path no-undo.
     2381       define VARIABLE v-alc-quality-certif-path like ub.parts.alc-quality-certif-path no-undo.
     2382       define VARIABLE v-alc-certif-path like ub.parts.alc-certif-path no-undo.
     2383       define VARIABLE v-alc-imp-code like ub.parts.alc-imp-code no-undo.
     2384       define VARIABLE v-alc-imp-type like ub.parts.alc-imp-type no-undo.
     2385       define buffer buf_goods             for ub.goods.
     2386       define buffer buf_crsa_stk-line     for ub.stk-line.
     2387       define buffer buf_cost_stk-line     for ub.stk-line.
     2388       define buffer buf_reserv_parts      for ub.parts.
     2389   do
     2390   for buf_goods
     2391     , buf_crsa_stk-line
     2392     , buf_cost_stk-line
     2393     , buf_reserv_parts
     2394   on error undo, return error
     2395   :
     2396       find last buf_cost_stk-line no-lock
     2397           where buf_cost_stk-line.obj-type  = p-obj-type
     2398             and buf_cost_stk-line.obj-code  = p-obj-code
     2399             and buf_cost_stk-line.artic     = p-artic
     2400             and buf_cost_stk-line.prod-type = p-prod-type
     2401             and buf_cost_stk-line.prod-code = p-prod-code
     2402             and buf_cost_stk-line.sum-type  = 'cost':U
     2403             and buf_cost_stk-line.cat-id    = '##,##':U
     2404             and buf_cost_stk-line.fact-order <= p-fact-order
     2405       use-index category
     2406       no-error.
     2407       find last buf_crsa_stk-line no-lock
     2408           where buf_crsa_stk-line.obj-type  = p-obj-type
     2409             and buf_crsa_stk-line.obj-code  = p-obj-code
     2410             and buf_crsa_stk-line.artic     = p-artic
     2411             and buf_crsa_stk-line.prod-type = p-prod-type
     2412             and buf_crsa_stk-line.prod-code = p-prod-code
