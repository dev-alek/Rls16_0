     1858   procedure thbjattr_code :
     1859      define input  parameter p-upper-code     as character no-undo .
     1860      define input  parameter p-code           as character no-undo .
     1861      define output parameter p-label          as character no-undo .
     1862      define output parameter p-user-can-edit  as logical   no-undo .
     1863      define output parameter p-output-display as logical   no-undo .
     1864      define output parameter p-other          as character no-undo .
     1865      define output parameter p-prop-list      as character no-undo .
     1866      define output parameter p-prop-type-list as character no-undo .
     1867      define output parameter p-prop-label-list as character no-undo .
     1868      define output parameter p-global          as logical no-undo .
     1869      define output parameter p-host           as logical no-undo .
     1870      define output parameter p-shop           as logical no-undo .
     1871      define output parameter p-store          as logical no-undo .
     1872      define output parameter p-db             as logical no-undo .
     1873      define variable p-region as logical no-undo.
     1874      run thbjattr_code_reg in this-procedure (
     1875                                               p-upper-code,
     1876                                               p-code,
     1877                                               output p-label,
     1878                                               output p-user-can-edit,
     1879                                               output p-output-display,
     1880                                               output p-other,
     1881                                               output p-prop-list,
     1882                                               output p-prop-type-list,
     1883                                               output p-prop-label-list,
     1884                                               output p-global,
     1885                                               output p-host,
     1886                                               output p-shop,
     1887                                               output p-store,
     1888                                               output p-db,
     1889                                               output p-region
     1890                                               ).
     1891   end procedure.
     1892   procedure thbjattr_code_reg :
     1893   define input  parameter p-upper-code     as character no-undo .
     1894   define input  parameter p-code           as character no-undo .
     1895   define output parameter p-label          as character no-undo .
     1896   define output parameter p-user-can-edit  as logical   no-undo .
     1897   define output parameter p-output-display as logical   no-undo .
     1898   define output parameter p-other          as character no-undo .
     1899   define output parameter p-prop-list      as character no-undo .
     1900   define output parameter p-prop-type-list as character no-undo .
     1901   define output parameter p-prop-label-list as character no-undo .
     1902   define output parameter p-global          as logical no-undo .
     1903   define output parameter p-host           as logical no-undo .
     1904   define output parameter p-shop           as logical no-undo .
     1905   define output parameter p-store          as logical no-undo .
     1906   define output parameter p-db             as logical no-undo .
     1907   define output parameter p-region         as logical no-undo .
     1908   do
     1909   on error undo, return error return-value
     1910   :
     1911       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1912       (input  p-upper-code
     1913       ,input  p-code
     1914       ,output p-label
     1915       ,output p-user-can-edit
     1916       ,output p-output-display
     1917       ,output p-other
     1918       ,output p-prop-list
     1919       ,output p-prop-type-list
     1920       ,output p-prop-label-list
     1921       ,output p-global
     1922       ,output p-host
     1923       ,output p-shop
     1924       ,output p-store
     1925       ,output p-db
     1926       ,output p-region
     1927       ) no-error .
     1928     if error-status :error
     1929     then do:
     1930       undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1)).
     1931     end.
     1932   end.
     1933   end procedure.
