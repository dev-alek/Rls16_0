      102   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   procedure cur-time :
      104      define output parameter p-today as date      no-undo .
      105      define output parameter p-time  as integer   no-undo .
      106     do
      107     on error undo, return error
      108     :
      109       define variable v-date1 as date      no-undo .
      110       define variable v-date2 as date      no-undo .
      111       define variable v-time  as integer   no-undo .
      112       assign
      113         v-date1 = today
      114         v-time  = time
      115         v-date2 = today
      116       .
      117       if v-date1 <> v-date2
      118       then do:
      119         assign
      120           v-date1 = today
      121           v-time  = v-time
      122         .
      123       end.
      124       assign
      125         p-today = v-date1
      126         p-time  = v-time
      127       .
      128     end.
      129   end.
      130   function cur-time-date returns character
      131   :
      132     return string(today, '99/99/9999':U) .
      133   end.
      134   function cur-time-mjd returns decimal
      135   :
      136     define variable v-date as date      no-undo .
      137     define variable v-time as integer   no-undo .
      138     run cur-time in this-procedure
      139       (output v-date
      140       ,output v-time
      141       ) .
      142     return integer(v-date) - 2400002 + (v-time / 86400) .
      143   end.
      144   function cur-time-get-ending-index returns integer
      145   (input p-number as integer
      146   )
      147   :
      148     if p-number < 0
      149     or p-number = ?
      150     then do:
      151       return 1 .
      152     end.
      153     define variable v-rest as integer   no-undo .
      154     assign
      155       p-number = p-number modulo 100
      156     .
      157     if p-number < 20
      158     then do:
      159       assign
      160         v-rest = p-number
      161       .
      162     end.
      163     else do:
      164       assign
      165         v-rest = p-number modulo 10
      166       .
      167     end.
      168     case v-rest :
      169       when 1
      170       then do:
      171         return 2 .
      172       end.
      173       when 2 or
      174       when 3 or
      175       when 4
      176       then do:
      177         return 3 .
      178       end.
      179       otherwise do:
      180         return 1 .
      181       end.
      182     end case .
      183   end.
      184   procedure cur-time-mjd-to-date :
      185      define input  parameter i-mjd-diff as decimal no-undo.
      186      define output parameter o-Date     as date    no-undo.
      187      define output parameter o-Time     as integer no-undo.
      188      define variable v-day-number as integer   no-undo .
      189      if    i-mjd-diff < 0
      190         or i-mjd-diff = ?
      191      then do:
      192         return "?" .
      193      end.
      194      assign
      195         v-day-number = truncate(i-mjd-diff,0).
      196         o-Date = date(v-day-number + 2400002).
      197         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199   end.
      200   function cur-time-mjd-to-string returns character
      201   (input p-mjd-diff as decimal
      202   )
      203   :
      204     define variable v-day-number as integer   no-undo .
      205     define variable v-seconds    as integer   no-undo .
      206     define variable v-hour       as integer   no-undo .
      207     define variable v-min        as integer   no-undo .
      208     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      209     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      210     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      211     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      212     if p-mjd-diff < 0
      213     or p-mjd-diff = ?
      214     then do:
      215       return "?" .
      216     end.
      217     assign
      218       v-day-number = integer(truncate(p-mjd-diff,0))
      219       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221     if v-seconds > 86400
      222     then do:
      223       assign
      224         v-seconds = 86400 - 1
      225       .
      226     end.
      227     if v-seconds < 0
      228     then do:
      229       assign
      230         v-seconds = 0
      231       .
      232     end.
      233     assign
      234       v-hour = truncate(v-seconds / 3600, 0)
      235     .
      236     assign
      237       v-seconds = v-seconds modulo 3600
      238     .
      239     assign
      240       v-min = truncate(v-seconds / 60, 0)
      241     .
      242     assign
      243       v-seconds = v-seconds modulo 60
      244     .
      245     return
      246         (if v-day-number <> 0
      247           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      248           else ""
      249         )
      250       + (if v-day-number <> 0 or v-hour <> 0
      251           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      252           else ""
      253         )
      254       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      255           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      256           else ""
      257         )
      258       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      259       .
      260   end.
      261   function cur-time-string returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      270   end.
      271   function cur-time-string-sec returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      280   end.
      281   function cur-time-custom  returns character
      282   (input p-prefix as character
      283   ,input p-date-format as character
      284   ,input p-delimiter as character
      285   ,input p-time-format as character
      286   ,input p-suffix as character
      287   )
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return
      296       p-prefix
      297       + string(v-date, p-date-format)
      298       + p-delimiter
      299       + string(v-time, p-time-format)
      300       + p-suffix
      301       .
      302   end.
      303   function cur-time-print  returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      312   end.
      313   function cur-time-datetime returns datetime
      314   :
      315     define variable v-char as character no-undo .
      316     define variable v-datetime as datetime no-undo .
      317     v-char = cur-time-string().
      318     v-datetime = datetime(v-char).
      319     return  v-datetime.
      320   end.
      321   function cur-time-string-msec returns character
      322   :
      323     define variable v-date as datetime  no-undo .
      324     v-date = now.
      325     return string(v-date) .
      326   end.
      327   define variable vss-include-info2 as character format "X(65)" no-undo
      328   initial "@(#)$Workfile$ $Revision$".
      329   procedure xmlchar-test :
      330   define input parameter p-in-string          as character        no-undo.
      331   define output parameter p-out-string-enc    as character        no-undo.
      332   define output parameter p-out-string-dec    as character        no-undo.
      333   do
      334   on error undo, return error
      335   :
      336          run xmlchar-encode in this-procedure
      337       (
      338             input p-in-string
      339           , output p-out-string-enc
      340       ).
      341          run xmlchar-decode in this-procedure
      342       (
      343             input p-out-string-enc
      344           , output p-out-string-dec
      345       ).
      346   end.
      347   end .
      348   procedure xmlchar-encode :
      349   define input parameter p-in-string      as character        no-undo.
      350   define output parameter p-out-string    as character        no-undo.
      351       define variable v-position      as integer      no-undo.
      352       define variable v-current-char  as character    no-undo.
      353   do
      354   on error undo, return error
      355   :
      356       assign
      357           p-out-string = "":U
      358       .
      359       case p-in-string
      360       :
      361           when ?
      362           then do:
      363               assign
      364                   p-out-string = "?":U
      365               .
      366           end.
      367           when "?":U
      368           then do:
      369               assign
      370                   p-out-string = "&#63;":U
      371               .
      372           end.
      373           otherwise do:
      374               do v-position = 1 to length( p-in-string )
      375               :
      376                   assign
      377                       v-current-char = substring( p-in-string, v-position, 1 )
      378                   .
      379                   case v-current-char
      380                   :
      381                       when "&":U
      382                       then do:
      383                           assign
      384                               p-out-string = p-out-string + "&amp;":U
      385                           .
      386                       end.
      387                       when ">":U
      388                       then do:
      389                           assign
      390                               p-out-string = p-out-string + "&gt;":U
      391                           .
      392                       end.
      393                       when "<":U
      394                       then do:
      395                           assign
      396                               p-out-string = p-out-string + "&lt;":U
      397                           .
      398                       end.
      399                       when "'":U
      400                       then do:
      401                           assign
      402                               p-out-string = p-out-string + "&apos;":U
      403                           .
      404                       end.
      405                       when '"':U
      406                       then do:
      407                           assign
      408                               p-out-string = p-out-string + "&quot;":U
      409                           .
      410                       end.
      411                       when chr(1)
      412                       then do:
      413                           assign
      414                               p-out-string = p-out-string + "":U
      415                           .
      416                       end.
      417                       when chr(2)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + "":U
      421                           .
      422                       end.
      423                       when chr(3)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + "":U
      427                           .
      428                       end.
      429                       when chr(4)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + "":U
      433                           .
      434                       end.
      435                       when chr(5)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + "":U
      439                           .
      440                       end.
      441                       when chr(6)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "":U
      445                           .
      446                       end.
      447                       when chr(7)
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "":U
      451                           .
      452                       end.
      453                       when chr(8)
      454                       then do:
      455                           assign
      456                               p-out-string = p-out-string + "":U
      457                           .
      458                       end.
      459                       when chr(9)
      460                       then do:
      461                           assign
      462                               p-out-string = p-out-string + "":U
      463                           .
      464                       end.
      465                       when chr(29)
      466                       then do:
      467                           assign
      468                               p-out-string = p-out-string + "":U
      469                           .
      470                       end.
      471                       when chr(10)
      472                       then do:
      473                           assign
      474                               p-out-string = p-out-string + "&#10;":U
      475                           .
      476                       end.
      477                       when chr(13)
      478                       then do:
      479                           assign
      480                               p-out-string = p-out-string + "&#13;":U
      481                           .
      482                       end.
      483                       otherwise do:
      484                           assign
      485                               p-out-string = p-out-string + v-current-char
      486                           .
      487                       end.
      488                   end case.
      489               end.
      490           end.
      491       end case.
      492   end.
      493   end .
