     2744           FIND FIRST buf_cash-pay NO-LOCK
     2745               WHERE RECID(buf_cash-pay) = v-cash-pay-recid NO-ERROR.
     2746           IF NOT AVAILABLE buf_cash-pay then next .
     2747           if CAN-FIND(FIRST tt-cash-pay
     2748                       WHERE tt-cash-pay.pay-code  = buf_cash-pay.cdpay-code
     2749                         AND tt-cash-pay.curr-code = buf_cash-pay.curr-code)   THEN NEXT.
     2750           CREATE tt-cash-pay.
     2751           ASSIGN
     2752               tt-cash-pay.pay-code  = buf_cash-pay.cdpay-code
     2753               tt-cash-pay.curr-code = buf_cash-pay.curr-code
     2754               .
     2755           release tt-cash-pay.
     2756       END.
     2757       v-need-pay-type = CAN-FIND (FIRST tt-cash-pay no-lock) .
     2758   if session :set-wait-state( "compiler" ) then.
