     2820                               , trim(error-status :get-message(3))
     2821                               )
     2822                               ).
     2823                           undo, return error .
     2824                       end.
     2825                   end.
     2826           end.
     2827       end case.
     2828       define variable v-full-path as character no-undo .
     2829            if v-place = 1 then v-full-path = v-ftp-adress .
     2830       else if v-place = 2 then v-full-path = session:temp-directory .
     2831       if v-per = 0 then .
