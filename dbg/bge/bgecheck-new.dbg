      996   define variable v-bge-xml-shift-mode    as logical           no-undo.
      997   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      998   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      999   define variable v-bge-xml-log-file-name as character    no-undo.
     1000   define variable v-bge-xml-dbf-file-name as character    no-undo.
     1001   define variable v-bge-xml-db-num-str    as character    no-undo .
     1002   define variable v-bge-xml-static-log-file-name as character    no-undo.
