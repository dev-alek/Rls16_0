     2773       case v-range:
     2774           when 1 then run init-temphost.
     2775           when 2 then do:
     2776                   run init-temphost.
     2777                   for each temp-obj where temp-obj.host-code <> v-host-code :
     2778                       delete temp-obj.
     2779                   end.
     2780           end.
     2781           when 3 then do:
     2782                   for each temp-obj :
     2783                       delete temp-obj.
     2784                   end.
     2785                   do v-obj-counter = 1 to num-entries ( v-obj-list ) / 2 :
     2786                       create temp-obj.
     2787                       assign
     2788                           temp-obj.obj-type = entry( v-obj-counter * 2 - 1, v-obj-list )
     2789                           temp-obj.obj-code = integer( entry( v-obj-counter * 2, v-obj-list ) )
     2790                       no-error .
     2791                       if error-status:error then do:
     2792                           run wp-XMLWriteLog in this-procedure (
     2793                               input v-log-file-name
     2794                               , input 1
     2795                               , input substitute( "*** Ошибка чтения списка объектов. &1. &2. &3. &4."
     2796                               , return-value
