     2897         end.
     2898         for each buf_chk-doc no-lock
     2899             where buf_chk-doc.obj-type = temp-obj.obj-type
     2900               and buf_chk-doc.obj-code = temp-obj.obj-code
     2901               and buf_chk-doc.chk-date >= v-date-from
     2902               and buf_chk-doc.chk-date <= v-date-to :
     2903           do:
