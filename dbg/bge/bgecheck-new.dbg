     1091   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1092                                             INPUT iFlagEmpty AS INTEGER).
     1093       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1094       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1095           DO:
     1096               IF iFlagEmpty = 0                           THEN RETURN "".
     1097               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1098               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1099               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1100               ELSE RETURN "".
     1101           END.
     1102       ELSE DO:
     1103           run xmlchar-encode in this-procedure (
     1104                 input sToPlace
     1105               , output sToPlace
     1106           ).
     1107           ASSIGN
     1108               sToPlace = sParName + '="' + sToPlace + '"'
     1109           .
     1110           RETURN sToPlace.
     1111       END.
     1112   END FUNCTION.
     1113   function bge-xml-date returns character
     1114   ( input p-date as date )
     1115   :
     1116     define variable v-date-str as character no-undo .
     1117     run bge-xml-date-to-str in this-procedure ( input   p-date
     1118                                               , output  v-date-str
     1119                                               ) .
     1120     return v-date-str.
     1121   end function.
     1122   function bge-xml-str-date returns character
     1123   ( input p-date-str as character )
     1124   :
     1125     define variable v-date-str as character no-undo .
     1126     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1127                                                   , output  v-date-str
     1128                                                   ) .
     1129     return v-date-str.
     1130   end function.
     1131   function bge-xml-normalize-dec returns decimal
     1132   ( input p-val as decimal )
     1133   :
     1134     return (if p-val = ? then 0 else p-val) .
     1135   end function.
     1136   PROCEDURE wp-XMLTagOpen:
     1137   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1138   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1139   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1140       define variable v-out-string    as character    no-undo.
     1141   do
     1142   on error undo, return error
     1143   :
     1144       if v-bge-xml-bgefmt = "dbf":U
     1145       then do:
     1146       end.
     1147       else do:
     1148           assign
     1149               v-out-string = substitute( "&1&2<&3&4>"
     1150                                       , chr(10)
     1151                                       , fill( " ":U, 4 * iTagLevel)
     1152                                       , sTagName
     1153                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1154                               )
     1155           .
     1156           put stream stmXMLOut unformatted
     1157               v-out-string
     1158           .
     1159       end.
     1160   end.
     1161   END PROCEDURE.
     1162   PROCEDURE wp-XMLTagPut:
     1163     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1164     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1165     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1166     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1167       define variable v-out-string    as character    no-undo.
     1168   do
     1169   on error undo, return error
     1170   :
     1171       if v-bge-xml-bgefmt = "dbf":U
     1172       then do:
     1173           if v-bge-xml-dbf-file-name <> "":U
     1174           then do:
     1175               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1176               export stream stmXMLOut
     1177                   sTagName
     1178                   sParValue
     1179               .
     1180               output stream stmXMLOut close.
     1181           end.
     1182       end.
     1183       else do:
     1184           IF  iFlagEmpty = 1
     1185           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1186           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1187           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1188           THEN DO:
     1189               run xmlchar-encode in this-procedure (
     1190                   input sParValue
     1191                   , output sParValue
     1192               ).
     1193               assign
     1194                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1195                                               , chr(10)
     1196                                               , FILL(" ", 4 * iTagLevel)
     1197                                               , sTagName
     1198                                               , sParValue
     1199                               )
     1200               .
     1201               PUT STREAM stmXMLOut UNFORMATTED
     1202                   v-out-string
     1203               .
     1204           END.
     1205       end.
     1206   end.
     1207   END PROCEDURE.
     1208   PROCEDURE wp-XMLTagClose:
     1209   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1210   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1211       define variable v-out-string    as character    no-undo.
     1212   do
     1213   on error undo, return error
     1214   :
     1215       if v-bge-xml-bgefmt = "dbf":U
     1216       then do:
     1217       end.
     1218       else do:
     1219           assign
     1220               v-out-string = substitute( "&1&2</&3>"
     1221                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1222                                   , fill( " ", 4 * iTagLevel )
     1223                                   , sTagName
     1224                           )
     1225           .
     1226           PUT STREAM stmXMLOut UNFORMATTED
     1227               v-out-string
     1228           .
     1229       end.
     1230   end.
     1231   END PROCEDURE.
     1232   PROCEDURE wp-XMLWriteLog:
     1233     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1234     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1235     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1236   define variable v-str              as character no-undo .
     1237   define variable v-error-append     as logical   no-undo .
     1238   define variable v-error-append-msg as character no-undo .
     1239   assign
     1240     v-str = chr(10)
     1241             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1242             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1243     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1244     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1245     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1246   .
     1247   run bge/bge-log.p (input v-str) no-error .
     1248   if error-status:error then do:
     1249     assign
     1250       v-error-append     = yes
     1251       v-error-append-msg = return-value
     1252     .
     1253   end.
     1254   run gbl/fileapnd.p
     1255     ( input sFileName
     1256     , input v-str
     1257     , input 10
     1258     ) no-error .
     1259   if error-status:error then do:
     1260     assign
     1261       v-error-append     = yes
     1262       v-error-append-msg = substitute( "&1&2&3"
     1263                                       , v-error-append-msg
     1264                                       , chr(10)
     1265                                       , return-value
     1266                                       )
     1267     .
     1268   end.
     1269   if v-error-append
     1270   then do:
     1271     return error substitute( "&1" , v-error-append-msg ) .
     1272   end.
     1273   END PROCEDURE.
     1274   PROCEDURE wp-XMLWriteEDT:
     1275     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1276     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1277     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1278       if valid-handle ( hEDT )
     1279       then do:
     1280           hEDT :move-to-eof().
     1281           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1282                                           OR sToWrite = "&Line") THEN "" ELSE
     1283                                           cur-time-string-sec() + " ").
     1284           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1285                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1286                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1287           hEDT :insert-string(chr(10)).
     1288       end.
     1289       process events.
     1290       output to 'bgescn.txt' append.
     1291           put unformatted
     1292               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1293                                           OR sToWrite = "&Line") THEN "" ELSE
     1294                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1295               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1296                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1297                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1298           .
     1299       output close.
     1300   END PROCEDURE.
     1301   PROCEDURE wp-XMLShowCNT:
     1302     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1303       if valid-handle( hCNT )
     1304       then do:
     1305           ASSIGN hCNT :VISIBLE = TRUE.
     1306       end.
     1307   END PROCEDURE.
     1308   PROCEDURE wp-XMLHideCNT:
     1309     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1310       if valid-handle( hCNT )
     1311       then do:
     1312           ASSIGN hCNT :VISIBLE = FALSE.
     1313       end.
     1314   END PROCEDURE.
     1315   PROCEDURE wp-XMLWriteCNT:
     1316     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1317     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1318       if valid-handle( hCNT )
     1319       then do:
     1320           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1321       end.
     1322   END PROCEDURE.
     1323   procedure bge-xml-write-header:
     1324   do
     1325   on error undo, return error
     1326   :
     1327   define input parameter p-xml-file-name  as character        no-undo.
     1328   define input parameter p-doc-name       as character        no-undo.
     1329   define input parameter p-version        as character        no-undo.
     1330   define input parameter p-db-num         as integer          no-undo.
     1331   define input parameter p-date-from      as date             no-undo.
     1332   define input parameter p-shift-num-from as integer          no-undo.
     1333   define input parameter p-date-to        as date             no-undo.
     1334   define input parameter p-shift-num-to   as integer          no-undo.
     1335   define input parameter p-obj-list       as character        no-undo.
     1336   define input parameter p-doc-type-list  as character        no-undo.
     1337   define input parameter p-pay-code       as logical          no-undo.
     1338   define input parameter p-cst            as logical          no-undo.
     1339   define input parameter p-parts          as logical          no-undo.
     1340   define input parameter p-chk-pay-code   as logical          no-undo.
     1341   define input parameter p-pay-desk       as logical          no-undo.
     1342   define input parameter p-pay-desk-cards as logical          no-undo.
     1343   define input parameter p-deleted        as logical          no-undo.
     1344   define input parameter p-opened-docs    as logical          no-undo.
     1345   define variable v-out-string    as character    no-undo.
     1346   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1347   assign
     1348       v-out-string = substitute( "&1&2&3"
     1349                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1350                           , chr(10)
     1351                           , "<IBS_Trade_House>":U )
     1352   .
     1353   put stream stmXMLOut unformatted
     1354       v-out-string
     1355   .
     1356   run wp-XMLTagOpen(1, "header","").
     1357   if v-bge-xml-bgeflold = "oracle":u
     1358   then do:
     1359     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1360     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1361     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1362     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1363     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1364   end.
     1365   run wp-XMLTagOpen( 2, "manifest", "").
     1366   run wp-XMLTagOpen( 3, "document", "").
     1367   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1368   run wp-XMLTagput( 4, "description", "", 0).
     1369   run wp-XMLTagput( 4, "version", p-version, 0).
     1370   run wp-XMLTagclose( 3, "document" ).
     1371   run wp-XMLTagclose( 2, "manifest" ).
     1372   run wp-XMLTagclose( 1, "header" ).
     1373   run wp-XMLTagOpen(1, "options","").
     1374   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1375   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1376   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1377   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1378   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1379   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1380   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1381   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1382   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1383   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1384   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1385   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1386   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1387   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1388   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1389   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1390   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1391   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1392   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1393   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1394   run wp-XMLTagClose(1, "options").
     1395   run wp-XMLTagOpen( 1, "body", "" ).
     1396   output stream stmXMLOut close.
     1397   end.
     1398   end procedure.
     1399   procedure xml-bge-write-footer:
     1400   do
     1401   on error undo, return error return-value
     1402   :
     1403   define input parameter p-xml-file-name as character    no-undo.
     1404   define variable v-error-num     as integer           no-undo.
     1405   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1406   run wp-XMLTagClose( 1, "body" ).
     1407   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1408   output stream stmXMLOut close.
     1409   if v-bge-xml-bgeflold = "oracle":u
     1410   then do:
     1411     define variable v-tmp-file-name         as character no-undo .
     1412     define variable v-zip-file-name         as character no-undo .
     1413     define variable v-exch-file-name        as character no-undo .
     1414     define variable v-heap-file-name        as character no-undo .
     1415     define variable v-i                     as integer   no-undo .
     1416     define variable v-file-name             as character no-undo .
     1417     define variable v-arc                   as character no-undo .
     1418     define variable v-str                   as character no-undo .
     1419     define variable v-exch-tmp-file-name    as character no-undo .
     1420     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1421     define variable v-bge-xml-exch-dir      as character no-undo .
     1422     define variable v-bge-xml-heap-dir      as character no-undo .
     1423     define variable v-bge-xml-compress-heap as logical   no-undo .
     1424     define variable v-home-dir              as character no-undo .
     1425     define variable v-os-command            as character no-undo .
     1426     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1427     if v-home-dir = ?
     1428     then do:
     1429       undo, return error substitute( "&1&2&3"
     1430                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1431                                     , chr(10)
     1432                                     , "Обратитесь к администратору.":u
     1433                                     ).
     1434     end.
     1435     assign
     1436       v-home-dir = v-home-dir
     1437     .
     1438     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1439     if error-status :error
     1440     then do:
     1441       undo, return error substitute( "&1&2&3"
     1442                                     , "Неверно задан каталог экспорта.":u
     1443                                     , chr(10)
     1444                                     , "Обратитесь к администратору.":u
     1445                                     ).
     1446     end.
     1447     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1448     if v-bge-xml-exch-dir = ?
     1449     then do:
     1450       undo, return error substitute( "&1&2&3"
     1451                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1452                                     , chr(10)
     1453                                     , "Обратитесь к администратору.":u
     1454                                     ).
     1455     end.
     1456     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1457     if error-status :error
     1458     then do:
     1459       undo, return error substitute( "&1&2&3"
     1460                                     , "Неверно задан каталог экспорта (exch).":u
     1461                                     , chr(10)
     1462                                     , "Обратитесь к администратору.":u
     1463                                     ).
     1464     end.
     1465     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1466     if v-bge-xml-heap-dir = ?
     1467     then do:
     1468       undo, return error substitute( "&1&2&3"
     1469                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1470                                     , chr(10)
     1471                                     , "Обратитесь к администратору.":u
     1472                                     ).
     1473     end.
     1474     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1475     if error-status :error
     1476     then do:
     1477       undo, return error substitute( "&1&2&3"
     1478                                     , "Неверно задан каталог экспорта (heap).":u
     1479                                     , chr(10)
     1480                                     , "Обратитесь к администратору.":u
     1481                                     ).
     1482     end.
     1483     get-key-value section "BGE" key "heap-compress" value v-str.
     1484     assign
     1485       v-i = int(v-str)
     1486     no-error .
     1487     if v-i = ? or v-i = 0
     1488     then do:
     1489       assign
     1490         v-bge-xml-compress-heap = no
     1491       .
     1492     end.
     1493     else do:
     1494       assign
     1495         v-bge-xml-compress-heap = yes
     1496       .
     1497     end.
     1498     assign
     1499       v-arc = search( "exe/7za.exe":u )
     1500     .
     1501     if v-arc = ? or v-arc = ""
     1502     then do:
     1503       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1504     end.
     1505     assign
     1506       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1507       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1508       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1509       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1510       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1511       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1512       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1513     .
     1514     run gbl/del-file.p (input v-tmp-file-name) .
     1515     run gbl/del-file.p (input v-zip-file-name) .
     1516     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1517     if v-error-num > 0
     1518     then do:
     1519         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1520                                      , p-xml-file-name + "xm1":u
     1521                                      , v-tmp-file-name
     1522                                      , v-error-num
     1523                                      ).
     1524     end.
     1525     assign
     1526       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1527                                    , v-arc
     1528                                    , v-zip-file-name
     1529                                    , v-tmp-file-name
     1530                                    )
     1531     .
     1532     os-command silent value ( v-os-command ) .
     1533     run gbl/del-file.p (input v-heap-file-name) .
     1534     if v-bge-xml-compress-heap = no
     1535     then do:
     1536       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1537       if v-error-num > 0
     1538       then do:
     1539           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1540                                        , v-tmp-file-name
     1541                                        , v-heap-file-name
     1542                                        , v-error-num
     1543                                        ) .
     1544       end.
     1545     end.
     1546     else do:
     1547       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1548       if v-error-num > 0
     1549       then do:
     1550           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1551                                        , v-zip-file-name
     1552                                        , v-heap-file-name
     1553                                        , v-error-num
     1554                                        ) .
     1555       end.
     1556     end.
     1557     run gbl/del-file.p (input v-tmp-file-name) .
     1558     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1559     if error-status :error then do:
     1560       undo, return error substitute( "&1&2&3"
     1561                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1562                                     , chr(10)
     1563                                     , "Обратитесь к администратору."
     1564                                     ).
     1565     end.
     1566     run gbl/del-file.p (input v-exch-file-name) .
     1567     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1568     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1569     if v-error-num > 0
     1570     then do:
     1571       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1572                                     , v-zip-file-name
     1573                                     , v-exch-tmp-file-name
     1574                                     , v-error-num
     1575                                     ) .
     1576     end.
     1577     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1578     if v-error-num > 0
     1579     then do:
     1580       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1581                                     , v-exch-tmp-file-name
     1582                                     , v-exch-file-name
     1583                                     , v-error-num
     1584                                     ) .
     1585     end.
     1586     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1587   end.
     1588   else do:
     1589     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1590     if v-error-num > 0
     1591     then do:
     1592       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1593                                     , p-xml-file-name + "xm1"
     1594                                     , p-xml-file-name + "xml"
     1595                                     , v-error-num
     1596                                     ) .
     1597     end.
     1598   end.
     1599   if opsys = "unix"
     1600   then do:
     1601       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1602   end.
     1603   end.
     1604   end procedure.
     1605   procedure xml-bge-filename0:
     1606   define input parameter p-prefix   as character no-undo .
     1607   define input parameter p-name     as character no-undo .
     1608   define input parameter p-shared-process as logical no-undo .
     1609   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1610   define output parameter p-xml-file-name  as character no-undo .
     1611   // define output parameter p-fullfnamenoext as character no-undo .
     1612   define output parameter p-locked         as logical      no-undo.
     1613   define variable v-fullfnamenoext as character no-undo .
     1614   define variable v-fileext        as character no-undo .
     1615   define variable v-fullfname      as character no-undo .
     1616   define variable v-error-num      as integer   no-undo .
     1617   do
     1618   on error undo, return error
     1619   :
     1620     case v-bge-xml-bgeflold :
     1621       when "old" then do:
     1622         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1623         v-fileext       = ".xml":U .
     1624         v-fullfname     = v-fullfnamenoext + v-fileext .
     1625         p-xml-file-name = v-fullfname .
     1626         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1627         if v-error-num > 0 then do:
     1628           return error.
     1629         end.
     1630       end.
     1631       when "var" then do:
     1632         case p-prefix :
     1633           when "doc" then do:
     1634             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1635             v-fileext       = ".xml":U .
     1636             v-fullfname     = v-fullfnamenoext + v-fileext .
     1637             p-xml-file-name = v-fullfname .
     1638           end.
     1639           when "day" then do:
     1640             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1641             v-fileext       = ".xml":U .
     1642             v-fullfname     = v-fullfnamenoext + v-fileext .
     1643             p-xml-file-name = v-fullfname .
     1644           end.
     1645           otherwise do:
     1646             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1647             v-fileext       = ".xml":U .
     1648             v-fullfname     = v-fullfnamenoext + v-fileext .
     1649             p-xml-file-name = v-fullfname .
     1650           end.
     1651         end case.
     1652         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1653         if v-error-num > 0 then do:
     1654           return error.
     1655         end.
     1656       end.
     1657       when "new" then do:
     1658                   run bge/genfname.p (
     1659                       input p-home-dir
     1660                       , input p-prefix
     1661                       , input ""
     1662                       , input "xml"
     1663                       , input ""
     1664                       , output p-xml-file-name
     1665                   ).
     1666       end.
     1667       when "no-parameter" then do:
     1668         if p-shared-process then do:
     1669                       run bge/genfname.p (
     1670                           input p-home-dir
     1671                           , input "d"
     1672                           , input ""
     1673                           , input "xml"
     1674                           , input ""
     1675                           , output p-xml-file-name
     1676                       ).
     1677         end.
     1678         else do:
     1679           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1680           v-fileext       = ".xml":U .
     1681           v-fullfname     = v-fullfnamenoext + v-fileext .
     1682           p-xml-file-name = v-fullfname .
     1683           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1684           if v-error-num > 0 then do:
     1685             return error.
     1686           end.
     1687         end.
     1688       end.
     1689     end case.
     1690     assign
     1691       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1692       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1693     .
     1694   end .
     1695   end procedure .
     1696   procedure xml-bge-filename :
     1697   do
     1698   on error undo, return error
     1699   :
     1700   define input parameter p-prefix             as character    no-undo.
     1701   define input parameter p-name               as character    no-undo.
     1702   define input parameter p-shared-process     as logical      no-undo.
     1703   define output parameter p-xml-file-name     as character    no-undo.
     1704   define output parameter p-log-file-name     as character    no-undo.
     1705   define output parameter p-locked            as logical      no-undo.
     1706   define variable v-home-dir          as character no-undo .
     1707   define variable v-error-num         as integer   no-undo .
     1708   define variable v-bge-xml-heap-dir  as character no-undo .
     1709       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1710       if v-home-dir = ?
     1711       then do:
     1712           message
     1713             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1714             skip(1)
     1715             skip "Обратитесь к администратору."
     1716           view-as alert-box error.
     1717           undo, return error .
     1718       end.
     1719       if v-bge-xml-bgeflold <> "oracle"
     1720       then do:
     1721         assign
     1722             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1723         .
     1724       end.
     1725       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1726       if error-status :error
     1727       then do:
     1728           message
     1729             skip "Неверно задан каталог экспорта."
     1730             skip(1)
     1731             skip "Обратитесь к администратору."
     1732           view-as alert-box error.
     1733           undo, return error .
     1734       end.
     1735       if v-bge-xml-bgefmt = "dbf":U
     1736       then do:
     1737           assign
     1738               p-xml-file-name = v-home-dir
     1739               p-locked        = no
     1740           .
     1741       end.
     1742       else do:
     1743           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1744             output p-xml-file-name, output p-locked) .
     1745       end.
     1746       if v-bge-xml-bgeflold = "oracle"
     1747       then do:
     1748         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1749         if v-bge-xml-heap-dir = ?
     1750         then do:
     1751           undo, return error substitute( "&1&2&3"
     1752                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1753                                         , chr(10)
     1754                                         , "Обратитесь к администратору.":u
     1755                                         ).
     1756         end.
     1757         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1758         if error-status :error
     1759         then do:
     1760           undo, return error substitute( "&1&2&3"
     1761                                         , "Неверно задан каталог экспорта (heap).":u
     1762                                         , chr(10)
     1763                                         , "Обратитесь к администратору.":u
     1764                                         ).
     1765         end.
     1766         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1767           assign
     1768             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1769           .
     1770         end.
     1771         else do:
     1772           assign
     1773             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1774           .
     1775         end.
     1776       end.
     1777       else do:
     1778         assign
     1779             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1780         .
     1781       end.
     1782       assign
     1783          v-bge-xml-static-log-file-name = p-log-file-name
     1784       .
     1785   end.
     1786   end procedure.
     1787   procedure bge-xml-read-config :
     1788   do
     1789   on error undo, return error return-value
     1790   :
     1791   define input  parameter p-last-date as date      no-undo .
     1792   define input  parameter p-db-num    as integer   no-undo .
     1793       define variable v-bgeclall      as character     no-undo.
     1794       define variable v-bgedict       as character     no-undo.
     1795       define variable v-bgeshift      as character     no-undo.
     1796       define variable v-par-type      as character     no-undo.
     1797       define variable v-bgeflnm       as character     no-undo.
     1798       define variable v-bgecliiv      as character     no-undo .
     1799       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1800       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1801       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1802       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1803       define variable v-db-num-str    as character     no-undo .
     1804       define variable v-param-type      as character  no-undo .
     1805       define variable v-value-character as character  no-undo .
     1806       define variable v-value-date      as date       no-undo .
     1807       define variable v-value-decimal   as decimal    no-undo .
     1808       define variable v-value-integer   as integer    no-undo .
     1809       define variable v-value-logical   as logical    no-undo .
     1810       define variable v-tth             as handle      no-undo .
     1811       run adm/shattri.p ( input "get":U
     1812                         , input  '':u
     1813                         , input  0
     1814                         , input  'bge-export':U
     1815                         , input  'bgeclall':U
     1816                         , output v-bgecliiv
     1817                         , output v-value-date
     1818                         , output v-value-decimal
     1819                         , output v-value-integer
     1820                         , output v-value-logical
     1821                         , output v-param-type
     1822                         , input-output table-handle v-tth
     1823                         ) no-error .
     1824       if error-status :error
     1825       then do:
     1826         assign
     1827           v-bge-xml-bgecliiv = no
     1828         .
     1829       end.
     1830       else do:
     1831         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1832       end.
     1833       delete object v-tth.
     1834       assign
     1835           v-bge-xml-bgeclall = no
     1836           v-bge-xml-bgedict  = no
     1837       .
     1838       run adm/shattri.p ( input "get":U
     1839                         , input  '':u
     1840                         , input  0
     1841                         , input  'bge-export':U
     1842                         , input  'bgeclall':U
     1843                         , output v-value-character
     1844                         , output v-value-date
     1845                         , output v-value-decimal
     1846                         , output v-value-integer
     1847                         , output v-value-logical
     1848                         , output v-param-type
     1849                         , input-output table-handle v-tth
     1850                         ) no-error .
     1851       if error-status :error
     1852       then do:
     1853         assign
     1854           v-bge-xml-bgeclall = no
     1855         .
     1856       end.
     1857       else do:
     1858         assign
     1859           v-bge-xml-bgeclall = v-value-logical
     1860         .
     1861       end.
     1862       delete object v-tth.
     1863       run adm/shattri.p ( input "get":U
     1864                         , input  '':u
     1865                         , input  0
     1866                         , input  'bge-export':U
     1867                         , input  'bgedict':U
     1868                         , output v-value-character
     1869                         , output v-value-date
     1870                         , output v-value-decimal
     1871                         , output v-value-integer
     1872                         , output v-value-logical
     1873                         , output v-param-type
     1874                         , input-output table-handle v-tth
     1875                         ) no-error .
     1876       if error-status :error
     1877       then do:
     1878         assign
     1879           v-bge-xml-bgedict = no
     1880         .
     1881       end.
     1882       else do:
     1883         assign
     1884           v-bge-xml-bgedict = v-value-logical
     1885         .
     1886       end.
     1887       delete object v-tth.
     1888       run adm/shattri.p ( input "get":U
     1889                         , input  '':u
     1890                         , input  0
     1891                         , input  'bge-export':U
     1892                         , input  'bgefmt':U
     1893                         , output v-value-character
     1894                         , output v-value-date
     1895                         , output v-value-decimal
     1896                         , output v-value-integer
     1897                         , output v-value-logical
     1898                         , output v-param-type
     1899                         , input-output table-handle v-tth
     1900                         ) no-error .
     1901       if error-status :error
     1902       then do:
     1903         assign
     1904           v-bge-xml-bgefmt  = "xml":U
     1905         .
     1906       end.
     1907       else do:
     1908         assign
     1909           v-bge-xml-bgefmt  = v-value-character
     1910         .
     1911       end.
     1912       delete object v-tth.
     1913       run adm/shattri.p ( input "get":U
     1914                         , input  '':u
     1915                         , input  0
     1916                         , input  'bge-export':U
     1917                         , input  'bgeshift':U
     1918                         , output v-value-character
     1919                         , output v-value-date
     1920                         , output v-value-decimal
     1921                         , output v-value-integer
     1922                         , output v-value-logical
     1923                         , output v-param-type
     1924                         , input-output table-handle v-tth
     1925                         ) no-error .
     1926       if error-status :error
     1927       then do:
     1928         assign
     1929             v-bge-xml-shift-mode = no
     1930         .
     1931       end.
     1932       else do:
     1933         assign
     1934             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1935         .
     1936       end.
     1937       delete object v-tth.
     1938       run adm/shattri.p ( input "get":U
     1939                         , input  '':u
     1940                         , input  0
     1941                         , input  'bge-export':U
     1942                         , input  'bgeflold':U
     1943                         , output v-value-character
     1944                         , output v-value-date
     1945                         , output v-value-decimal
     1946                         , output v-value-integer
     1947                         , output v-value-logical
     1948                         , output v-param-type
     1949                         , input-output table-handle v-tth
     1950                         ) no-error .
     1951       if error-status :error
     1952       then do:
     1953         assign
     1954           v-bge-xml-bgeflold = "no-parameter":U
     1955         .
     1956       end.
     1957       else do:
     1958         assign
     1959           v-bge-xml-bgeflold  = v-value-character
     1960         .
     1961       end.
     1962       delete object v-tth.
     1963       assign
     1964         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1965         v-bge-xml-db-num-str  = v-db-num-str
     1966       .
     1967       if p-last-date <> ?
     1968       then do:
     1969           run adm/shattri.p ( input "get":U
     1970                             , input  '':u
     1971                             , input  0
     1972                             , input  'bge-export':U
     1973                             , input  'bgeflnm':U
     1974                             , output v-value-character
     1975                             , output v-value-date
     1976                             , output v-value-decimal
     1977                             , output v-value-integer
     1978                             , output v-value-logical
     1979                             , output v-param-type
     1980                             , input-output table-handle v-tth
     1981                             ) no-error .
     1982           if error-status :error
     1983           then do:
     1984             assign
     1985               v-bgeflnm = '':U
     1986             .
     1987           end.
     1988           else do:
     1989             assign
     1990               v-bgeflnm = v-value-character
     1991             .
     1992           end.
     1993           delete object v-tth.
     1994           if v-bge-xml-bgeflold = "var"
     1995           then do:
     1996               if v-bgeflnm = ?
     1997               or num-entries( v-bgeflnm ) < 2
     1998               then do:
     1999                   assign
     2000                       v-bge-xml-bgeflold = "new"
     2001                   .
     2002               end.
     2003               else do:
     2004                   assign
     2005                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2006                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2007                   .
     2008                   assign
     2009                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2010                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2011                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2012                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2013                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2014                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2015                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2016                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2017                   .
     2018               end.
     2019           end.
     2020       end.
     2021   end.
     2022   end procedure.
     2023   procedure bge-xml-get-ref-filename :
     2024   define input parameter p-in-file-name       as character        no-undo.
     2025   define output parameter p-home-dir          as character        no-undo.
     2026   define output parameter p-out-file-name     as character        no-undo.
     2027   define output parameter p-locked            as logical          no-undo.
     2028       define variable v-counter       as integer      no-undo.
     2029       define variable v-error-level   as integer      no-undo.
     2030   do
     2031   on error undo, return error
     2032   :
     2033       run bge/bge-ini.p (
     2034             input "bge"
     2035           , output p-home-dir
     2036       ).
     2037       if return-value <> "OK"
     2038       then do:
     2039           undo, return error.
     2040       end.
     2041       assign
     2042           p-home-dir = p-home-dir + "\dict":U
     2043       .
     2044       run bge/dir_cd.p (
     2045           input p-home-dir
     2046           , input "CA"
     2047       ).
     2048       if return-value = "ERROR"
     2049       then do:
     2050           undo, return error.
     2051       end.
     2052       assign
     2053           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2054       .
     2055       assign
     2056           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2057       .
     2058       wait-lock:
     2059       do v-counter = 1 TO 3
     2060       :
     2061           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2062           if p-locked = no
     2063           then do:
     2064               leave wait-lock.
     2065           end.
     2066           else do:
     2067               readkey pause 1.
     2068           end.
     2069       END.
     2070       if p-locked = yes
     2071       then do:
     2072           undo, return error.
     2073       end.
     2074       run bge/os_copy.p (
     2075             input "D":U
     2076           , input p-out-file-name + "xml":U
     2077           , input "":U
     2078           , output v-error-level
     2079       ).
     2080       if v-error-level > 0
     2081       then do:
     2082           undo, return error.
     2083       end.
     2084   end.
     2085   end procedure.
     2086   procedure bge-xml-write-ref-header :
     2087   define input parameter p-bge-name as character        no-undo.
     2088   define input parameter p-file-name as character        no-undo.
     2089       define variable v-out-string    as character    no-undo.
     2090   do
     2091   on error undo, return error
     2092   :
     2093       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2094       put stream stmXMLOut unformatted
     2095           "<?xml version='1.0' encoding='windows-1251'?>":U
     2096       .
     2097       assign
     2098           v-out-string = substitute( "&1&2"
     2099                               , chr(10)
     2100                               , "<IBS_Trade_House>":U )
     2101       .
     2102       put stream stmXMLOut unformatted
     2103           v-out-string
     2104       .
     2105       run wp-XMLTagOpen( 1, "header", "" ).
     2106       if v-bge-xml-bgeflold = "oracle":u
     2107       then do:
     2108         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2109         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2110         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2111         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2112         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2113       end.
     2114       else do:
     2115         run wp-XMLTagOpen( 2, "delivery", "" ).
     2116         run wp-XMLTagOpen( 3, "to", "" ).
     2117         run wp-XMLTagClose( 3, "to" ).
     2118         run wp-XMLTagOpen( 3, "from", "" ).
     2119         run wp-XMLTagClose( 3, "from" ).
     2120         run wp-XMLTagClose( 2, "delivery" ).
     2121       end.
     2122       run wp-XMLTagOpen( 2, "manifest", "" ).
     2123       run wp-XMLTagOpen( 3, "document", "" ).
     2124       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2125       run wp-XMLTagPut( 4, "description", "", 0 ).
     2126       run wp-XMLTagClose( 3, "document" ).
     2127       run wp-XMLTagClose( 2, "manifest" ).
     2128       run wp-XMLTagClose( 1, "header" ).
     2129       run wp-XMLTagOpen( 1, "body", "" ).
     2130   end.
     2131   end procedure.
     2132   procedure bge-xml-write-ref-footer :
     2133   define input parameter p-file-name as character        no-undo.
     2134       define variable v-error-level   as integer      no-undo.
     2135   do
     2136   on error undo, return error
     2137   :
     2138       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2139       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2140       output stream stmXMLOut close.
     2141       run bge/os_copy.p (
     2142             input "M":U
     2143           , input p-file-name + "xm1":U
     2144           , input p-file-name + "xml":U
     2145           , output v-error-level
     2146       ).
     2147       if v-error-level > 0
     2148       then do:
     2149           undo, return error.
     2150       end.
     2151   end.
     2152   end procedure.
     2153   procedure bge-xml-out-dir :
     2154   define output parameter p-out-dir       as character    no-undo.
     2155   define output parameter p-log-file-name as character    no-undo.
     2156   do
     2157   on error undo, return error
     2158   :
     2159       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2160       if p-out-dir = ?
     2161       then do:
     2162           message
     2163             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2164                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2165             skip(1)
     2166             skip "Обратитесь к администратору."
     2167           view-as alert-box error.
     2168           undo, return error .
     2169       end.
     2170       if v-bge-xml-bgeflold <> "oracle" then assign
     2171         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2172       .
     2173       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2174       if error-status :error  then do:
     2175           run wp-XMLWriteLog in this-procedure (
     2176                 input p-log-file-name
     2177               , input 0
     2178               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2179                                   , p-out-dir
     2180                                   , return-value
     2181                                   , trim( error-status :get-message( 1 ) )
     2182                                   )
     2183           ).
     2184           undo, return error.
     2185       end.
     2186       assign
     2187           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2188           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2189       .
     2190   end.
     2191   end procedure.
     2192   procedure bge-xml-out-dir2 :
     2193   define output parameter p-out-dir       as character    no-undo.
     2194   define output parameter p-out-dirR      as character    no-undo.
     2195   define output parameter p-log-file-name as character    no-undo.
     2196   do
     2197   on error undo, return error
     2198   :
     2199       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2200       if p-out-dir = ?
     2201       then do:
     2202           message
     2203             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2204                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2205             skip(1)
     2206             skip "Обратитесь к администратору."
     2207           view-as alert-box error.
     2208           undo, return error .
     2209       end.
     2210       if v-bge-xml-bgeflold <> "oracle" then assign
     2211             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2212             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2213         .
     2214       else p-out-dirR = p-out-dir .
     2215       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2216       if error-status :error  then do:
     2217           run wp-XMLWriteLog in this-procedure (
     2218                 input p-log-file-name
     2219               , input 0
     2220               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2221                                   , p-out-dir
     2222                                   , return-value
     2223                                   , error-status :get-message( 1 )
     2224                                   )
     2225           ).
     2226           undo, return error.
     2227       end.
     2228       if p-out-dirR <> p-out-dir then do:
     2229         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2230         if error-status :error then do:
     2231           run wp-XMLWriteLog in this-procedure (
     2232                 input p-log-file-name
     2233               , input 0
     2234               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2235                                   , p-out-dirR
     2236                                   , return-value
     2237                                   , error-status :get-message( 1 )
     2238                                   )
     2239           ).
     2240           p-out-dirR = p-out-dir .
     2241         end.
     2242       end .
     2243       assign
     2244         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2245         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2246       .
     2247   end.
     2248   end procedure.
     2249   procedure bge-xml-out-file :
     2250   do
     2251   on error undo, return error
     2252   :
     2253   define input parameter p-out-dir            as character        no-undo.
     2254   define input parameter p-prefix             as character        no-undo.
     2255   define input parameter p-sheduled           as logical          no-undo.
     2256   define output parameter p-xml-file-name     as character        no-undo.
     2257   define output parameter p-locked            as logical          no-undo.
     2258   define variable v-home-dir      as character     no-undo.
     2259   define variable v-error-num     as integer       no-undo.
     2260   define variable v-today             as date         no-undo.
     2261   define variable v-time              as integer      no-undo.
     2262       if v-bge-xml-bgefmt = "dbf":U
     2263       then do:
     2264           assign
     2265               p-xml-file-name = p-out-dir
     2266               p-locked        = no
     2267           .
     2268       end.
     2269       else do:
     2270           if v-bge-xml-bgeflold = "firm":U
     2271           then do:
     2272               run bge/genfname.p (
     2273                     input p-out-dir
     2274                   , input p-prefix
     2275                   , input "":U
     2276                   , input "arj":U
     2277                   , input "":U
     2278                   , output p-xml-file-name
     2279               ).
     2280           end.
     2281           else do:
     2282               run bge/genfname.p (
     2283                     input p-out-dir
     2284                   , input p-prefix
     2285                   , input "":U
     2286                   , input "xml":U
     2287                   , input "":U
     2288                   , output p-xml-file-name
     2289               ).
     2290           end.
     2291           assign
     2292               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2293               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2294           .
     2295       end.
     2296   end.
     2297   end procedure.
     2298   procedure bge-xml-init-ext-doc-type :
     2299       define variable v-counter    as integer      no-undo.
     2300       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2301   do
     2302   for buf_temp_ext-doc-type
     2303   on error undo, return error
     2304   :
     2305       empty temp-table buf_temp_ext-doc-type.
     2306       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2307       :
     2308           create buf_temp_ext-doc-type.
     2309           assign
     2310               buf_temp_ext-doc-type.edt-key               = v-counter
     2311               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2312               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2313           .
     2314       end.
     2315   end.
     2316   end procedure.
     2317   procedure bge-xml-get-decimal-shift-num :
     2318   define input parameter p-shift-date     as date             no-undo.
     2319   define input parameter p-shift-num      as integer          no-undo.
     2320   define output parameter p-shift-decimal as decimal          no-undo.
     2321   do
     2322   on error undo, return error
     2323   :
     2324       assign
     2325           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2326       .
     2327   end.
     2328   end procedure.
     2329   procedure bge-xml-ora-exp-filename :
     2330     define input  parameter p-table-name  as character no-undo .
     2331     define input  parameter p-doc-code    as character no-undo .
     2332     define input  parameter p-obj-code    as integer   no-undo .
     2333     define output parameter p-filename    as character no-undo .
     2334     define output parameter p-seq-num     as integer   no-undo .
     2335     define variable v-ora-exp-seq     as integer   no-undo .
     2336     define variable v-ora-exp-seq-str as character no-undo .
     2337     define variable v-home-dir        as character no-undo.
     2338   do
     2339   on error undo, return error return-value
     2340   :
     2341     if v-bge-xml-bgeflold = "oracle":u
     2342     then do:
     2343       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2344       if v-home-dir = ?
     2345       then do:
     2346         undo, return error substitute( "&1&2&3":U
     2347                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2348                                       , chr(10)
     2349                                       , "Обратитесь к администратору.":U
     2350                                       ).
     2351       end.
     2352       assign
     2353           v-home-dir = v-home-dir
     2354       .
     2355       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2356       if error-status :error
     2357       then do:
     2358         undo, return error substitute( "&1&2&3":U
     2359                                       , "Неверно задан каталог экспорта.":U
     2360                                       , chr(10)
     2361                                       , "Обратитесь к администратору.":U
     2362                                       ).
     2363       end.
     2364       assign
     2365         v-ora-exp-seq = ?
     2366       .
     2367       if  p-table-name <> ? and
     2368           p-doc-code <> ?
     2369       then do:
     2370         run bge/get-oesq.p ( input p-table-name
     2371                            , input p-doc-code
     2372                            , output v-ora-exp-seq
     2373                            ) no-error .
     2374         if error-status :error = yes
     2375         then do:
     2376           undo, return error return-value .
     2377         end.
     2378       end.
     2379       if v-ora-exp-seq = ?
     2380       then do:
     2381         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2382         if error-status :error
     2383         then do:
     2384           undo, return error return-value .
     2385         end.
     2386       end.
     2387       if p-table-name <> ? and
     2388          p-doc-code   <> ?
     2389       then do:
     2390         run bge/oesqdoc.p ( input p-table-name
     2391                           , input p-doc-code
     2392                           , input v-ora-exp-seq
     2393                           ) no-error .
     2394         if error-status :error = yes
     2395         then do:
     2396           undo, return error return-value .
     2397         end.
     2398       end.
     2399       assign
     2400         p-seq-num  = v-ora-exp-seq
     2401         p-filename = substitute("&1/&2-000_&3."
     2402                                , v-home-dir
     2403                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2404                                , string(v-ora-exp-seq , "999999999")
     2405                                )
     2406       .
     2407     end.
     2408   end.
     2409   end procedure.
     2410   procedure bge-xml-date-to-str :
     2411     define input  parameter p-date  as date      no-undo .
     2412     define output parameter p-str   as character no-undo .
     2413   do
     2414   on error undo, return error return-value
     2415   :
     2416     if p-date <> ?
     2417     then do:
     2418       assign
     2419         p-str = substitute( "&1-&2-&3"
     2420                           , string( year(p-date)  , "9999")
     2421                           , string( month(p-date) , "99"  )
     2422                           , string( day(p-date)   , "99"  )
     2423                           )
     2424       .
     2425     end.
     2426     else do:
     2427       assign
     2428         p-str = ?
     2429       .
     2430     end.
     2431   end.
     2432   end procedure.
     2433   procedure bge-xml-date-str-to-str :
     2434     define input  parameter p-date-str  as character no-undo .
     2435     define output parameter p-str       as character no-undo .
     2436     define variable v-date          as date      no-undo .
     2437     define variable v-date-valid    as logical   no-undo .
     2438     define variable v-error-message as character no-undo .
     2439   do
     2440   on error undo, return error return-value
     2441   :
     2442     assign
     2443       p-str = ?
     2444     .
     2445     if p-date-str = ? or p-date-str = ""
     2446     then do:
     2447       return .
     2448     end.
     2449     run strtdate in this-procedure ( input  p-date-str
     2450                                    , output v-date
     2451                                    , output v-date-valid
     2452                                    , output v-error-message
     2453                                    ).
     2454     if v-date-valid <> true
     2455     then do:
     2456       return .
     2457     end.
     2458     assign
     2459       p-str = substitute( "&1-&2-&3"
     2460                         , string( year(v-date)  , "9999")
     2461                         , string( month(v-date) , "99"  )
     2462                         , string( day(v-date)   , "99"  )
     2463                         )
     2464     .
     2465   end.
     2466   end procedure.
     2467   procedure bge-xml-fill-tt-bgecliiv :
     2468     define input  parameter p-str as character no-undo .
     2469     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2470     define buffer buf_clients             for ub.clients.
     2471     define variable v-i         as integer   no-undo .
     2472     define variable v-count     as integer   no-undo .
     2473     define variable v-cli-count as integer   no-undo .
     2474     define variable v-client    as character no-undo .
     2475     define variable v-obj-type  as character no-undo .
     2476     define variable v-obj-code  as integer   no-undo .
     2477   do
     2478   on error undo, return error return-value
     2479   :
     2480     empty temp-table buf_tt-bge-xml-bgecliiv.
     2481     assign
     2482       v-bge-xml-bgecliiv = no
     2483       v-cli-count        = num-entries(p-str,';')
     2484     .
     2485     if v-cli-count > 0
     2486     then do:
     2487       _cli-cycle:
     2488       do v-i = 1 to v-cli-count
     2489       :
     2490         assign
     2491           v-client = entry(v-i , p-str, ';')
     2492         .
     2493         if num-entries(v-client) <> 2
     2494         then do:
     2495           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2496         end.
     2497         assign
     2498           v-obj-type = entry(1, v-client)
     2499         .
     2500         assign
     2501           v-obj-code = integer(entry(2, v-client))
     2502         no-error .
     2503         if error-status :error
     2504         then do:
     2505           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2506         end.
     2507         find first buf_clients no-lock
     2508           where buf_clients.obj-type = v-obj-type
     2509             and buf_clients.obj-code = v-obj-code
     2510         no-error.
     2511         if not available buf_clients
     2512         then do:
     2513           next _cli-cycle.
     2514         end.
     2515         find first buf_tt-bge-xml-bgecliiv no-lock
     2516           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2517             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2518         no-error .
     2519         if available buf_tt-bge-xml-bgecliiv
     2520         then do:
     2521           next _cli-cycle.
     2522         end.
     2523         create buf_tt-bge-xml-bgecliiv.
     2524         assign
     2525           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2526           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2527         .
     2528       end.
     2529     end.
     2530     else do:
     2531       assign
     2532         v-bge-xml-bgecliiv = no
     2533       .
     2534       return .
     2535     end.
     2536     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2537     if available buf_tt-bge-xml-bgecliiv
     2538     then do:
     2539       assign
     2540         v-bge-xml-bgecliiv = yes
     2541       .
     2542     end.
     2543   end.
     2544   end procedure.
     2545   procedure bge-xml-resolve-ext-doc-type :
     2546     define input  parameter p-ext-doc-type      as character no-undo .
     2547     define input  parameter p-obj-type          as character no-undo .
     2548     define input  parameter p-obj-code          as integer   no-undo .
     2549     define output parameter p-out-ext-doc-type  as character no-undo .
     2550     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2551   do
     2552   on error undo, return error return-value
     2553   :
     2554     assign
     2555       p-out-ext-doc-type = p-ext-doc-type
     2556     .
     2557     if p-ext-doc-type <> 'ie':U
     2558     then do:
     2559       return .
     2560     end.
     2561     if v-bge-xml-bgecliiv = yes
     2562     then do:
     2563       find first buf_tt-bge-xml-bgecliiv no-lock
     2564         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2565           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2566       no-error .
     2567       if available buf_tt-bge-xml-bgecliiv
     2568       then do:
     2569         assign
     2570           p-out-ext-doc-type = 'iv':U
     2571         .
     2572       end.
     2573     end.
     2574   end.
     2575   end procedure.
     2576   procedure safe-wp-xmltagput :
     2577     define input  parameter pTagLevel   as integer   no-undo .
     2578     define input  parameter pTagName    as character no-undo .
     2579     define input  parameter pParValue   as character no-undo .
     2580     define input  parameter pFlagEmpty  as integer   no-undo .
