     3038           run wp-xmltagput   in this-procedure ( input 3, input "Z-num"         , input string( buf_chk-doc.z-number   ), input 1 ).
     3039           if buf_chk-doc.chk-type = integer('43':U)
     3040           or buf_chk-doc.chk-type = integer('44':U)
     3041           then do :
     3042             run wp-xmltagput   in this-procedure ( input 3, input "Reason" , input string( buf_chk-doc.doc-num   ), input 1 ).
     3043             if num-entries(buf_chk-doc.doc-num2, ":") = 2
     3044             then do :
     3045               if entry(1, buf_chk-doc.doc-num2, ":") = "0"
     3046               then v-corr-type = "самостоятельно" .
     3047               else
     3048               if entry(1, buf_chk-doc.doc-num2, ":") = "1"
     3049               then v-corr-type = "по предписанию" .
     3050               else
