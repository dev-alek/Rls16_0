     2837       define variable v-trim-zero  as character no-undo.
     2838       define variable v-par-type   as character no-undo.
     2839       define variable v-must-open  as logical no-undo.
     2840       define variable v-is-started as logical no-undo.
     2841       DEFINE VARIABLE v-finded-pay-type AS LOGICAL   NO-UNDO.
