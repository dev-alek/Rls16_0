       22   define variable vss-revision    as character no-undo init "$Revision: eb694e4e9475, 2831, rls $":U .
       23   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       24   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:48:51 2021 +0300 $":U .
