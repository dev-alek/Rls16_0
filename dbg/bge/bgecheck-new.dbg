     2582   on error undo, return error return-value
     2583   :
     2584     if v-bge-xml-bgeflold = "oracle":u
     2585     then do:
     2586       return .
     2587     end.
     2588     run wp-xmltagput in this-procedure ( input pTagLevel
     2589                                        , input pTagName
     2590                                        , input pParValue
     2591                                        , input pFlagEmpty
     2592                                        ).
     2593   end.
     2594   end procedure.
