      625   define output parameter p-prop-type-list as character no-undo .
      626   define output parameter p-prop-label-list as character no-undo .
      627   define output parameter p-global          as logical no-undo .
      628   define output parameter p-host           as logical no-undo .
      629   define output parameter p-shop           as logical no-undo .
      630   define output parameter p-store          as logical no-undo .
      631   define output parameter p-db             as logical no-undo .
      632   define output parameter p-region         as logical no-undo .
      633   do
      634   on error undo, return error return-value
      635   :
      636       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      637       (input  p-upper-code
