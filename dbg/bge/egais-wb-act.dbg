        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter egais as class EGAIS no-undo.
        4   define input parameter bh-wb-egais as handle no-undo.
        5   define variable vss-revision               as character no-undo init "$Revision$":U .
        6   define variable vss-author                 as character no-undo init "$Author$":U .
        7   define variable vss-date                   as character no-undo init "$Date$":U .
        8   define variable vss-workfile               as character no-undo init "$Workfile$":U .
        9   define variable vss-archive                as character no-undo init "$Archive$":U .
       10   define variable vss-description            as character no-undo init "Журнал запросов ЕГАИС".
       11   define variable th-wb-egais                as handle    no-undo.
       12   define variable gh-wb-egais                as handle    no-undo.
       13   define variable bh-wb-gds-EG               as handle    no-undo.
       14   define variable browse-hdl-wb-egais        as handle    no-undo.
       15   define variable th-wb-egais-header         as handle    no-undo.
       16   define variable gh-wb-egais-header         as handle    no-undo.
       17   define variable bh-wb-gds-EG-header        as handle    no-undo.
       18   define variable browse-hdl-wb-egais-header as handle    no-undo.
       19   define variable bcol                       as handle    extent no-undo.
       20   define variable v-db-num                   as integer   no-undo .
       21   define variable v-user-id                  as character no-undo .
       22   define variable v-user-select              as character no-undo .
       23   define variable v-select-obj-type          as character no-undo .
       24   define variable v-select-obj-code          as integer   no-undo .
       25   define variable v-obj-uniq-key-rec         as character no-undo .
       26   define variable v-gds-uniq-key-rec         as character no-undo .
       27   define variable v-ext-sys                  as integer   no-undo .
       28   define variable v-rid                      as recid     no-undo .
       29   define variable v-uniq-key-rec             as character no-undo .
       30   define buffer buf_clients   for ub.clients .
       31   define buffer x_ext-classif for ub.ext-classif.
       32   define buffer buf_goods     for ub.goods .
       33   define new global shared variable g#language as character no-undo .
       34   if g#language <> '' and g#language <> 'rus':U then do:
       35     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       36   end.
       37   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       38   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       39   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       40   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       41   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       42   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       43   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       44   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       45   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       46   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       47   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       48   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       49   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       50   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       51   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       52   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       53   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       54   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       55   define new global shared variable g#library  as handle no-undo .
       56   define new global shared variable g#library2 as handle no-undo .
       57   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       58     define variable v-cntxt-db-num        as integer   no-undo .
       59     define variable v-cntxt-userid        as character no-undo .
       60     define variable v-cntxt-level         as character no-undo .
       61     define variable v-cntxt-host-code-obj as integer   no-undo .
       62     define variable v-cntxt-obj-type      as character no-undo .
       63     define variable v-cntxt-obj-code      as integer   no-undo .
       64     define variable v-cntxt-db-num-obj    as integer   no-undo .
       65     define variable v-cntxt-is-admin      as logical   no-undo .
       66   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure gen-key-rec :
       69     define input  parameter p-tbl-name    as character no-undo.
       70     define input  parameter p-bh_tbl-name as handle    no-undo.
       71     define output parameter p-key-rec     as character no-undo.
       72     do
       73     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       74     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       75     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       76     :
       77       define variable fh               as handle    no-undo .
       78       define variable v-ok             as logical   no-undo .
       79       define variable v-inform         as character no-undo .
       80       define variable v-ind            as integer   no-undo .
       81       define variable v-idx-field-qnty as integer   no-undo .
       82       if p-tbl-name = ?
       83         or p-tbl-name = "":U
       84       then do:
       85         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
       86       end.
       87       if not p-bh_tbl-name:available then do:
       88         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
       89       end.
       90       assign
       91         p-key-rec = p-tbl-name
       92         v-inform  = p-bh_tbl-name:index-information(1)
       93         v-ind     = 2
       94       .
       95       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       96       on error undo, return error
       97       :
       98         assign
       99           v-inform = p-bh_tbl-name:index-information( v-ind )
      100           v-ind    = v-ind + 1
      101         .
      102       end.
      103       if v-inform = ?
      104         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      105         or entry( 3, v-inform, ",":U ) <> "1":U
      106       then do:
      107         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      108       end.
      109       else do:
      110         assign
      111           v-idx-field-qnty = num-entries( v-inform ) - 4
      112         .
      113         if v-idx-field-qnty < 2 then do:
      114           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      115         end.
      116         do v-ind = 1 to v-idx-field-qnty by 2
      117         on error undo, return error
      118         :
      119           assign
      120             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      121             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      122           .
      123         end.
      124       end.
      125       if p-key-rec = ? then do:
      126         assign
      127           p-key-rec = "":U
      128         .
      129         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      130       end.
      131     end.
      132     return.
      133   end procedure.
      134   procedure gen-where-keyr-tab :
      135     define input  parameter i-tableSerach as character no-undo.
      136     define input  parameter i-tablekey   as character  no-undo.
      137     define input  parameter p-key-rec    as character  no-undo.
      138     define input  parameter p-key-handle as handle     no-undo .
      139     define input  parameter p-db-name    as character  no-undo .
      140     define input  parameter p-tt-handle  as handle     no-undo .
      141     define output parameter o-Where      as character  no-undo.
      142     do
      143     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      144     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      145     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      146     :
      147       define variable v-full-tbl-name  as character no-undo .
      148       define variable bh_tbl-name      as handle    no-undo .
      149       define variable fh_key           as handle    no-undo .
      150       define variable fh_search        as handle    no-undo .
      151       define variable v-field-num      as integer   no-undo .
      152       define variable v-count-fld      as integer   no-undo .
      153       define variable v-inform         as character no-undo .
      154       define variable v-ind            as integer   no-undo .
      155       define variable v-idx-field-qnty as integer   no-undo .
      156       define variable v-field-name     as character no-undo .
      157       define variable v-field-val      as character no-undo .
      158       define variable v-word-link      as character no-undo .
      159       define variable vTable           as character no-undo.
      160       define variable bh_tbl-key       as handle    no-undo .
      161       assign
      162         p-key-rec = trim( p-key-rec )
      163       .
      164       if p-key-handle <> ? then do:
      165         if not valid-handle(p-key-handle)
      166            or p-key-handle:type <> "buffer"
      167         then do:
      168           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      169         end.
      170         if num-entries( p-key-rec, chr(3) ) > 1
      171           or p-key-rec = ?
      172           or p-key-rec = "":U
      173         then do:
      174           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      175         end.
      176       end.
      177       else do:
      178         if p-key-rec = ?
      179           or p-key-rec = "":U
      180         then do:
      181           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      182         end.
      183       end.
      184       assign
      185         vTable = entry( 1 , p-key-rec, chr(3) )
      186       .
      187       if p-tt-handle <> ?
      188         and ( not valid-handle(p-tt-handle)
      189               or p-tt-handle:type <> "buffer"
      190             )
      191       then do:
      192         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      193       end.
      194       if p-tt-handle = ? then do:
      195         assign
      196           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      197         .
      198         create buffer bh_tbl-name for table v-full-tbl-name .
      199       end.
      200       else do:
      201         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      202       end.
      203       assign
      204         v-inform = bh_tbl-name:index-information(1)
      205         v-ind    = 2
      206       .
      207       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      208       on error undo, return error
      209       :
      210         assign
      211           v-inform = bh_tbl-name:index-information( v-ind )
      212           v-ind    = v-ind + 1
      213         .
      214       end.
      215       if v-inform = ?
      216         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      217         or entry( 3, v-inform, ",":U ) <> "1":U
      218       then do:
      219         delete object bh_tbl-name no-error.
      220         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      221       end.
      222       assign
      223         v-idx-field-qnty = num-entries( v-inform ) - 4
      224       .
      225       if v-idx-field-qnty < 2 then do:
      226         delete object bh_tbl-name no-error.
      227         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      228       end.
      229       assign
      230         o-where     = "where":U
      231         v-word-link = "":U
      232         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      233         v-count-fld = 0
      234       .
      235       if i-tablekey ne "" and i-tablekey ne ?
      236       then do:
      237         assign
      238           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      239         .
      240         create buffer bh_tbl-key for table v-full-tbl-name .
      241       end.
      242       if i-tableSerach ne "" and i-tableSerach ne ?
      243       then do:
      244         delete object bh_tbl-name no-error.
      245         assign
      246           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      247         .
      248         create buffer bh_tbl-name for table v-full-tbl-name .
      249       end.
      250       block_where:
      251       do v-ind = 1 to v-idx-field-qnty by 2
      252       on error undo, return error
      253       :
      254         assign
      255           v-count-fld = v-count-fld + 1
      256         .
      257         if p-key-handle = ?
      258           and v-count-fld > v-field-num
      259         then do:
      260           leave block_where.
      261         end.
      262         define variable VfieldKeyTable as handle no-undo.
      263         assign
      264           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      265           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      266         .
      267         if     bh_tbl-key ne ?
      268         then do:
      269            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      270            if VfieldKeyTable eq ?
      271            then next block_where.
      272         end.
      273         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      274         then
      275            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      276         else
      277            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      278         if p-key-handle = ? then do:
      279           assign
      280             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      281           .
      282         end.
      283         else do:
      284           assign
      285             fh_key = p-key-handle:buffer-field( v-field-name )
      286           .
      287           if fh_key = ?
      288             or not valid-handle( fh_key )
      289           then do:
      290             delete object bh_tbl-name.
      291             if     bh_tbl-key ne ?
      292             then
      293                delete object bh_tbl-key.
      294             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      295           end.
      296           assign
      297             v-field-val = fh_key:buffer-value
      298           .
      299         end.
      300         if fh_search:data-type ="character":U then do:
      301           assign
      302             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      303             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      304             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      305             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      306             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      307             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      308             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      309             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      310             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      311             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      312             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      313             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      314             v-field-val = substitute( '"&1"', v-field-val )
      315           .
      316         end.
      317         assign
      318           o-where = substitute( "&1 &2", o-where, v-field-val )
      319         .
      320         if v-word-link = "":U then do:
      321           assign
      322             v-word-link = "and":U
      323           .
      324         end.
      325       end.
      326       delete object bh_tbl-name.
      327       if     bh_tbl-key ne ?
      328       then
      329          delete object bh_tbl-key.
      330       if p-key-handle = ?
      331         and v-count-fld <> v-field-num
      332       then do:
      333         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      334       end.
      335     end.
      336   end procedure.
      337   procedure gen-hn-keyr-tab :
      338     define input  parameter i-tableSerach as character no-undo.
      339     define input  parameter i-tablekey   as character no-undo.
      340     define input  parameter p-key-rec    as character no-undo.
      341     define input  parameter p-key-handle as handle    no-undo .
      342     define input  parameter p-db-name    as character no-undo .
      343     define input  parameter p-tt-handle  as handle    no-undo .
      344     define input  parameter p-stts-lock  as integer   no-undo .
      345     define output parameter o-hn         as handle    no-undo.
      346     define variable v-full-tbl-name as character no-undo.
      347     define variable v-where         as character no-undo.
      348     define variable bh_tbl-name     as handle    no-undo.
      349     define variable vTable          as character no-undo.
      350     do
      351     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      352     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      353     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      354         run gen-where-keyr-tab(i-tableSerach,
      355                                i-tablekey,
      356                                p-key-rec,
      357                                p-key-handle,
      358                                p-db-name,
      359                                p-tt-handle,
      360                                output v-where).
      361         if i-tableSerach ne "" and i-tableSerach ne ?
      362         then do:
      363            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      364            create buffer bh_tbl-name for table v-full-tbl-name .
      365         end.
      366         else do:
      367            if p-tt-handle = ? then do:
      368               assign
      369                  vTable = entry( 1 , p-key-rec, chr(3) )
      370               .
      371               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      372               create buffer bh_tbl-name for table v-full-tbl-name .
      373            end.
      374            else do:
      375               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      376            end.
      377         end.
      378         if p-tt-handle = ? then do:
      379            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      380         end.
      381         else do:
      382            bh_tbl-name:find-first( v-where ) no-error .
      383         end.
      384         o-hn = bh_tbl-name.
      385      end.
      386   end procedure.
      387   procedure gen-hn-keyr :
      388     define input  parameter p-key-rec    as character no-undo.
      389     define input  parameter p-key-handle as handle    no-undo .
      390     define input  parameter p-db-name    as character no-undo .
      391     define input  parameter p-tt-handle  as handle    no-undo .
      392     define input  parameter p-stts-lock  as integer   no-undo .
      393     define output parameter o-hn         as handle    no-undo.
      394     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      395   end.
      396   procedure gen-row-keyr :
      397     define input  parameter p-key-rec    as character no-undo.
      398     define input  parameter p-key-handle as handle    no-undo .
      399     define input  parameter p-db-name    as character no-undo .
      400     define input  parameter p-tt-handle  as handle    no-undo .
      401     define input  parameter p-stts-lock  as integer   no-undo .
      402     define output parameter p-tbl-row    as rowid     no-undo.
      403     define output parameter p-tbl-name   as character no-undo.
      404     define variable vHn as handle no-undo.
      405       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      406       p-tbl-row = if vHn:available then vHn:rowid else ?.
      407       p-tbl-name =  vHn:table.
      408       delete object vHn no-error.
      409     if p-tbl-row = ? then do:
      410       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      411     end.
      412     else do:
      413       return.
      414     end.
      415   end procedure.
      416   procedure gen-key-fv :
      417     define input  parameter p-key-rec    as character no-undo .
      418     define output parameter p-field-list as character no-undo .
      419     define output parameter p-value-list as character no-undo.
      420     do
      421     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      422     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      423     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      424     :
      425       define variable v-full-tbl-name  as character no-undo .
      426       define variable bh_tbl-name      as handle    no-undo .
      427       define variable v-tbl-name       as character no-undo .
      428       define variable v-field-num      as integer   no-undo .
      429       define variable v-count-fld      as integer   no-undo .
      430       define variable v-inform         as character no-undo .
      431       define variable v-ind            as integer   no-undo .
      432       define variable v-idx-field-qnty as integer   no-undo .
      433       define variable v-delim-key      as character no-undo .
      434       if p-key-rec = ?
      435         or p-key-rec = "":U
      436       then do:
      437         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      438       end.
      439       assign
      440         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      441         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      442       .
      443       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      444       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      445       assign
      446         v-inform = bh_tbl-name:index-information(1)
      447         v-ind    = 2
      448       .
      449       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      450       on error undo, return error
      451       :
      452         assign
      453           v-inform = bh_tbl-name:index-information( v-ind )
      454           v-ind    = v-ind + 1
      455         .
      456       end.
      457       if v-inform = ?
      458         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      459         or entry( 3, v-inform, ",":U ) <> "1":U
      460       then do:
      461         delete object bh_tbl-name no-error.
      462         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      463       end.
      464       assign
      465         v-idx-field-qnty = num-entries( v-inform ) - 4
      466       .
      467       if v-idx-field-qnty < 2 then do:
      468         delete object bh_tbl-name no-error.
      469         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      470       end.
      471       assign
      472         p-field-list = "":U
      473         p-value-list = "":U
      474         v-delim-key  = "":U
      475         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      476         v-count-fld  = 0
      477       .
      478       block_where:
      479       do v-ind = 1 to v-idx-field-qnty by 2
      480       on error undo, return error
      481       :
      482         assign
      483           v-count-fld = v-count-fld + 1
      484         .
      485         if v-count-fld > v-field-num then do:
      486           leave block_where.
      487         end.
      488         assign
      489           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      490           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      491         .
      492         if v-ind = 1 then do:
      493           assign
      494             v-delim-key = chr(3)
      495           .
      496         end.
      497       end.
      498       delete object bh_tbl-name.
      499       if v-count-fld <> v-field-num then do:
      500         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      501       end.
      502     end.
      503   end procedure.
      504   procedure gen-key-field :
      505     define input  parameter p-table      as character no-undo .
      506     define output parameter p-field-list as character no-undo .
      507     do
      508     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      509     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      510     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      511     :
      512       define variable v-full-tbl-name  as character no-undo .
      513       define variable bh_tbl-name      as handle    no-undo .
      514       define variable v-tbl-name       as character no-undo .
      515       define variable v-field-num      as integer   no-undo .
      516       define variable v-count-fld      as integer   no-undo .
      517       define variable v-inform         as character no-undo .
      518       define variable v-ind            as integer   no-undo .
      519       define variable v-idx-field-qnty as integer   no-undo .
      520       define variable v-delim-key      as character no-undo .
      521       if p-table = ?
      522         or p-table = "":U
      523       then do:
      524         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      525       end.
      526       assign
      527         v-tbl-name      = p-table
      528         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      529       .
      530       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      531       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      532       assign
      533         v-inform = bh_tbl-name:index-information(1)
      534         v-ind    = 2
      535       .
      536       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      537       on error undo, return error
      538       :
      539         assign
      540           v-inform = bh_tbl-name:index-information( v-ind )
      541           v-ind    = v-ind + 1
      542         .
      543       end.
      544       if v-inform = ?
      545         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      546         or entry( 3, v-inform, ",":U ) <> "1":U
      547       then do:
      548         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      549       end.
      550       assign
      551         v-idx-field-qnty = num-entries( v-inform ) - 4
      552       .
      553       if v-idx-field-qnty < 2 then do:
      554         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      555       end.
      556       assign
      557         p-field-list = "":U
      558         v-delim-key  = "":U
      559         v-count-fld  = 0
      560       .
      561       block_where:
      562       do v-ind = 1 to v-idx-field-qnty by 2
      563       on error undo, return error
      564       :
      565         assign
      566           v-count-fld = v-count-fld + 1
      567         .
      568         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      569         if v-ind = 1 then do:
      570           assign
      571             v-delim-key = chr(3)
      572           .
      573         end.
      574       end.
      575       delete object bh_tbl-name.
      576     end.
      577   end procedure.
      578   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define new global shared variable g#attr-lib  as handle no-undo .
      580   define variable v-attr-lib-variable as handle no-undo .
      581   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      583   procedure thbjattr_code :
      584      define input  parameter p-upper-code     as character no-undo .
      585      define input  parameter p-code           as character no-undo .
      586      define output parameter p-label          as character no-undo .
      587      define output parameter p-user-can-edit  as logical   no-undo .
      588      define output parameter p-output-display as logical   no-undo .
      589      define output parameter p-other          as character no-undo .
      590      define output parameter p-prop-list      as character no-undo .
      591      define output parameter p-prop-type-list as character no-undo .
      592      define output parameter p-prop-label-list as character no-undo .
      593      define output parameter p-global          as logical no-undo .
      594      define output parameter p-host           as logical no-undo .
      595      define output parameter p-shop           as logical no-undo .
      596      define output parameter p-store          as logical no-undo .
      597      define output parameter p-db             as logical no-undo .
      598      define variable p-region as logical no-undo.
      599      run thbjattr_code_reg in this-procedure (
      600                                               p-upper-code,
      601                                               p-code,
      602                                               output p-label,
      603                                               output p-user-can-edit,
      604                                               output p-output-display,
      605                                               output p-other,
