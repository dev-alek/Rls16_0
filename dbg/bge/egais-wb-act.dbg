      644       ,output p-prop-type-list
      645       ,output p-prop-label-list
      646       ,output p-global
      647       ,output p-host
      648       ,output p-shop
      649       ,output p-store
      650       ,output p-db
      651       ,output p-region
      652       ) no-error .
      653     if error-status :error
      654     then do:
      655       undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1)).
      656     end.
