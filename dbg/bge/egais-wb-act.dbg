      607                                               output p-prop-type-list,
      608                                               output p-prop-label-list,
      609                                               output p-global,
      610                                               output p-host,
      611                                               output p-shop,
      612                                               output p-store,
      613                                               output p-db,
      614                                               output p-region
      615                                               ).
      616   end procedure.
      617   procedure thbjattr_code_reg :
      618   define input  parameter p-upper-code     as character no-undo .
      619   define input  parameter p-code           as character no-undo .
      620   define output parameter p-label          as character no-undo .
      621   define output parameter p-user-can-edit  as logical   no-undo .
      622   define output parameter p-output-display as logical   no-undo .
      623   define output parameter p-other          as character no-undo .
