      689                                 sw:start-element ("oref:address").
      690                                   sw:write-data-element ("oref:Country", entry (5, v-impor, chr(5)) ).
      691                                   sw:write-data-element ("oref:description", entry (6, v-impor, chr(5)) ).
      692                                 sw:end-element ("oref:address").
      693                               sw:end-element ("pref:Importer") .
      694                             end.
      695                           end.
      696                           else do:
