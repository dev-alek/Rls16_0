      698                           end.
      699                           sw:end-element ("ain:Product") .
      700                           sw:write-data-element ("ain:Quantity", string(tt-gds-act.qnty)) .
      701                           sw:start-element ("ain:InformAB") .
      702                               sw:start-element ("ain:InformABReg") .
      703                                   sw:start-element ("ain:InformA") .
      704                                       sw:write-data-element ("iab:Quantity", string(tt-gds-act.A-qnty)) no-error .
      705                                       sw:write-data-element ("iab:BottlingDate", string(iso-date(tt-gds-act.A-bottleDate))) no-error .
      706                                       sw:write-data-element ("iab:TTNNumber", tt-gds-act.A-ttnNumber) no-error .
      707                                       sw:write-data-element ("iab:TTNDate", string(iso-date(tt-gds-act.A-ttnDate))) no-error .
      708                                       if tt-gds-act.A-fixNumber <> ? and trim(tt-gds-act.A-fixNumber) <> "" then do :
      709                                           sw:write-data-element ("iab:EGAISFixNumber", tt-gds-act.A-fixNumber) no-error .
      710                                           sw:write-data-element ("iab:EGAISFixDate", string(iso-date(tt-gds-act.A-fixDate))) no-error .
