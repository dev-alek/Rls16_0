       92   procedure thbjattr_code :
       93      define input  parameter p-upper-code     as character no-undo .
       94      define input  parameter p-code           as character no-undo .
       95      define output parameter p-label          as character no-undo .
       96      define output parameter p-user-can-edit  as logical   no-undo .
       97      define output parameter p-output-display as logical   no-undo .
       98      define output parameter p-other          as character no-undo .
       99      define output parameter p-prop-list      as character no-undo .
      100      define output parameter p-prop-type-list as character no-undo .
      101      define output parameter p-prop-label-list as character no-undo .
      102      define output parameter p-global          as logical no-undo .
      103      define output parameter p-host           as logical no-undo .
      104      define output parameter p-shop           as logical no-undo .
      105      define output parameter p-store          as logical no-undo .
      106      define output parameter p-db             as logical no-undo .
      107      define variable p-region as logical no-undo.
      108      run thbjattr_code_reg in this-procedure (
      109                                               p-upper-code,
      110                                               p-code,
      111                                               output p-label,
      112                                               output p-user-can-edit,
      113                                               output p-output-display,
      114                                               output p-other,
      115                                               output p-prop-list,
      116                                               output p-prop-type-list,
      117                                               output p-prop-label-list,
      118                                               output p-global,
      119                                               output p-host,
      120                                               output p-shop,
      121                                               output p-store,
      122                                               output p-db,
      123                                               output p-region
      124                                               ).
      125   end procedure.
      126   procedure thbjattr_code_reg :
      127   define input  parameter p-upper-code     as character no-undo .
      128   define input  parameter p-code           as character no-undo .
      129   define output parameter p-label          as character no-undo .
      130   define output parameter p-user-can-edit  as logical   no-undo .
      131   define output parameter p-output-display as logical   no-undo .
      132   define output parameter p-other          as character no-undo .
      133   define output parameter p-prop-list      as character no-undo .
      134   define output parameter p-prop-type-list as character no-undo .
      135   define output parameter p-prop-label-list as character no-undo .
      136   define output parameter p-global          as logical no-undo .
      137   define output parameter p-host           as logical no-undo .
      138   define output parameter p-shop           as logical no-undo .
      139   define output parameter p-store          as logical no-undo .
      140   define output parameter p-db             as logical no-undo .
      141   define output parameter p-region         as logical no-undo .
      142   do
      143   on error undo, return error return-value
      144   :
      145       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      146       (input  p-upper-code
      147       ,input  p-code
      148       ,output p-label
      149       ,output p-user-can-edit
      150       ,output p-output-display
      151       ,output p-other
      152       ,output p-prop-list
      153       ,output p-prop-type-list
      154       ,output p-prop-label-list
      155       ,output p-global
      156       ,output p-host
      157       ,output p-shop
      158       ,output p-store
      159       ,output p-db
      160       ,output p-region
      161       ) no-error .
      162     if error-status :error
      163     then do:
      164       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      165     end.
      166   end.
      167   end procedure.
