      714                           sw:end-element ("ain:InformAB") .
      715           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
      716           if available tt-marks then do :
      717                           sw:start-element ("ain:MarkCodeInfo") .
      718               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      719                               sw:write-data-element ("ain:MarkCode", tt-marks.mark) .
      720               end.
      721                           sw:end-element ("ain:MarkCodeInfo") .
      722           end.
      723                       sw:end-element ("ain:Position") .
      724       end.
      725                   sw:end-element ("ain:Content") .
      726               sw:end-element ("ns:ActChargeOn") .
      727           sw:end-element ("ns:Document") .
      728       sw:end-element ("ns:Documents") .
      729       sw:end-document () .
      730       delete object sw.
      731   end procedure .
      732   procedure makeXML_v2 :
      733       create sax-writer sw .
      734       sw:formatted = true.
      735       sw:set-output-destination ("file", v-file).
      736       sw:encoding = "UTF-8".
      737       sw:start-document () .
      738       sw:start-element ("ns:Documents") .
      739       sw:insert-attribute ("Version", "1.0") .
      740       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      741       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      742       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef_v2") .
      743       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      744       sw:insert-attribute ("xmlns:iab", "http://fsrar.ru/WEGAIS/ActInventoryF1F2Info") .
      745       sw:insert-attribute ("xmlns:ainp", "http://fsrar.ru/WEGAIS/ActChargeOn_v2") .
      746       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
      747           sw:start-element ("ns:Owner") .
      748               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      749           sw:end-element ("ns:Owner") .
      750           sw:start-element ("ns:Document") .
      751               sw:start-element ("ns:ActChargeOn_v2") .
      752                   sw:start-element ("ainp:Header") .
      753                       sw:write-data-element ("ainp:Number", tt-act-header.num) .
      754                       sw:write-data-element ("ainp:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      755                       sw:write-data-element ("ainp:Note", "Необходимо поставить товарные позиции на баланс") .
      756                       if tt-act-header.type_ <> "Продукция полученная до 01.01.2016"
      757                       then
      758                         sw:write-data-element ("ainp:TypeChargeOn", tt-act-header.type_) .
      759                       else
      760                         sw:write-data-element ("ainp:TypeChargeOn", "Продукция, полученная до 01.01.2016") .
      761                       if tt-act-header.type_ = "Пересортица" and v-RegID <> "" and v-RegID <> ? then do :
      762                         sw:write-data-element ("ainp:ActWriteOff", v-RegID) .
      763                       end.
      764                   sw:end-element ("ainp:Header") .
      765                   sw:start-element ("ainp:Content") .
      766       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      767           if tt-gds-act.qnty <= 0 then next.
      768                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
      769                       sw:start-element ("ainp:Position") .
      770                           sw:write-data-element ("ainp:Identity", string(tt-gds-act.position_)) .
      771                           sw:start-element ("ainp:Product") .
      772                               sw:write-data-element ("pref:UnitType", (if buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1 then "Unpacked" else "Packed")) .
      773                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
      774                               sw:write-data-element ("pref:ShortName", "") .
      775                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
      776                               if not (buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1)
      777                               then sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
      778                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
      779                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
      780                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
      781                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
      782                           end.
      783                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
      784                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      785                                                                  and X_ext-classif-attr.db-num = 0
      786                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
      787                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
      788                                                                  and X_ext-classif-attr.Key#_three = 0
      789                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
      790                                                                  and X_ext-classif-attr.CharKey_two = ""
      791                                                                  and X_ext-classif-attr.CharKey_three = ""
      792                                                                  and X_ext-classif-attr.nonunique = 0
      793                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
      794                                                                  no-error .
      795                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
      796                             def var v-prod as char no-undo.
      797                             def var v-impor as char no-undo.
      798                             def var v-msg as char no-undo.
      799                             def var v-err as logical no-undo.
      800                             def var v-err-impor as logical no-undo.
      801                             v-err = false .
      802                             v-prod = ''.
      803                             v-impor = ''.
      804                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
      805                             if v-prod = ?
      806                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      807                             or v-prod = ""
      808                             or num-entries (v-prod, chr (5)) < 8
      809                             or entry (7, v-prod, chr(5)) = ""
      810                             then do:
      811                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
      812                               v-err = true .
      813                             end.
      814                             if not v-err then do :
      815                               sw:start-element ("pref:Producer") .
      816                                sw:start-element ("oref:" + entry (7, v-prod, chr(5))) .
      817                                 if entry (7, v-prod, chr(5)) <> "TS" then do :
      818                                     if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
      819                                     if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
      820                                 end.
      821                                 else if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:TSNUM", entry (2, v-prod, chr(5)) ).
      822                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
      823                                 sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
      824                                 sw:start-element ("oref:address").
      825                                   sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
      826                                   if entry (8, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:RegionCode", entry (8, v-prod, chr(5)) ).
      827                                   sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
      828                                 sw:end-element ("oref:address").
      829                                sw:end-element ("oref:" + entry (7, v-prod, chr(5))) .
      830                               sw:end-element ("pref:Producer") .
      831                             end.
      832                           end.
      833                           else do:
      834                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
      835                           end.
      836                           sw:end-element ("ainp:Product") .
      837                           sw:write-data-element ("ainp:Quantity", string(tt-gds-act.qnty)) .
      838                           sw:start-element ("ainp:InformF1F2") .
      839                               sw:start-element ("ainp:InformF1F2Reg") .
      840                                   sw:start-element ("ainp:InformF1") .
      841                                       sw:write-data-element ("iab:Quantity", string(tt-gds-act.A-qnty)) no-error .
      842                                       sw:write-data-element ("iab:BottlingDate", string(iso-date(tt-gds-act.A-bottleDate))) no-error .
      843                                       sw:write-data-element ("iab:TTNNumber", tt-gds-act.A-ttnNumber) no-error .
      844                                       sw:write-data-element ("iab:TTNDate", string(iso-date(tt-gds-act.A-ttnDate))) no-error .
      845                                       if tt-gds-act.A-fixNumber <> ? and trim(tt-gds-act.A-fixNumber) <> "" then do :
      846                                           sw:write-data-element ("iab:EGAISFixNumber", tt-gds-act.A-fixNumber) no-error .
      847                                           sw:write-data-element ("iab:EGAISFixDate", string(iso-date(tt-gds-act.A-fixDate))) no-error .
      848                                       end.
      849                                   sw:end-element ("ainp:InformF1") .
      850                               sw:end-element ("ainp:InformF1F2Reg") .
      851                           sw:end-element ("ainp:InformF1F2") .
      852           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
      853           if available tt-marks then do :
      854                           sw:start-element ("ainp:MarkCodeInfo") .
      855               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      856                               sw:write-data-element ("MarkCode", tt-marks.mark) .
      857               end.
      858                           sw:end-element ("ainp:MarkCodeInfo") .
      859           end.
      860                       sw:end-element ("ainp:Position") .
      861       end.
      862                   sw:end-element ("ainp:Content") .
      863               sw:end-element ("ns:ActChargeOn_v2") .
      864           sw:end-element ("ns:Document") .
      865       sw:end-element ("ns:Documents") .
      866       sw:end-document () .
      867       delete object sw.
      868   end procedure .
      869   procedure parseXML :
      870       empty temp-table tt-act-header .
      871       empty temp-table tt-gds-act .
      872       empty temp-table tt-marks .
      873       CREATE X-DOCUMENT hDoc.
      874       CREATE X-NODEREF hRoot.
      875       hDoc:encoding = 'utf-8'.
      876       hDoc:LOAD("file", search("temp.xml"),FALSE).
      877       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
      878       RUN GetChildren(hRoot, 1).
      879       DELETE OBJECT hDoc.
      880       DELETE OBJECT hRoot.
      881   end procedure .
      882   procedure GetChildren :
      883       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      884       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      885       DEFINE VARIABLE i AS INTEGER NO-UNDO.
      886       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      887       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      888       CREATE X-NODEREF hNoderef.
      889       CREATE X-NODEREF hText .
      890       REPEAT i = 1 TO hParent:NUM-CHILDREN:
      891           good = hParent:GET-CHILD(hNoderef,i).
      892           IF NOT good THEN
      893               LEAVE.
      894           IF hNoderef:SUBTYPE <> "element" THEN
      895               NEXT.
      896           hNoderef:GET-CHILD(hText, 1) no-error .
      897           IF hNoderef:NAME = "ain:Header" or hNoderef:NAME = "ainp:Header" THEN do :
      898               create tt-act-header .
      899               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
      900           end .
      901           .
      902           IF hNoderef:NAME = "ain:Number"
      903           OR hNoderef:NAME = "ainp:Number" THEN assign tt-act-header.num    = hText:node-value no-error .
      904           IF hNoderef:NAME = "ain:ActDate"
      905           OR hNoderef:NAME = "ainp:ActDate" THEN
      906               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      907           IF hNoderef:NAME = "ainp:TypeChargeOn" THEN do :
      908               assign tt-act-header.type_    = hText:node-value no-error .
      909               if tt-act-header.type_ = "Продукция, полученная до 01.01.2016" then tt-act-header.type_ = "Продукция полученная до 01.01.2016" .
      910           end.
      911           IF hNoderef:NAME = "ainp:ActWriteOff" THEN assign v-RegID    = hText:node-value no-error .
      912           IF hNoderef:NAME = "ain:Position"
      913           OR hNoderef:NAME = "ainp:Position" THEN do :
      914               assign ii = 0 .
      915               create tt-gds-act .
      916               assign tt-gds-act.num = tt-act-header.num .
      917           end.
      918           IF hNoderef:NAME = "ain:Identity"
      919           OR hNoderef:NAME = "ainp:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
      920           if hNoderef:NAME = "gds-code" THEN assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
      921           if hNoderef:NAME = "gds-name" THEN do :
      922               assign tt-gds-act.gds-name = hText:node-value no-error .
      923               if tt-gds-act.gds-name = ? or tt-gds-act.gds-name = ""
      924               then do :
      925                   find first goods no-lock where goods.gds-code = tt-gds-act.gds-code no-error .
      926                   if available goods then tt-gds-act.gds-name = goods.gds-name no-error .
      927               end.
      928           end.
      929           if hNoderef:NAME = "doc-code" THEN assign tt-gds-act.doc-code = hText:node-value no-error .
      930           if hNoderef:NAME = "part-code" THEN assign tt-gds-act.part-code = hText:node-value no-error .
      931           IF hNoderef:NAME = "pref:FullName" THEN assign tt-gds-act.egais-name = hText:node-value no-error .
      932           IF hNoderef:NAME = "pref:AlcCode" THEN do :
      933               assign tt-gds-act.alc-code = hText:node-value no-error .
      934               if tt-gds-act.gds-code = ? or tt-gds-act.gds-code = 0
      935               then do :
      936                   find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
      937                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
      938                                                      AND X_ext-classif.db-num = 0
      939                                                      and X_ext-classif.key#_two = v-ext-sys
      940                                                      and X_ext-classif.key#_three = 0
      941                                                      and X_ext-classif.charkey_one = tt-gds-act.alc-code
      942                                                      and X_eXt-classif.charkey_two = ""
      943                                                      and X_eXt-classif.charkey_three = ""
      944                                                      and X_eXt-classif.nonunique = 0
      945                                                      no-error.
      946                   if available X_ext-classif then do :
      947                       find first buf_goods no-lock where buf_goods.gds-code = X_ext-classif.key#_one .
      948                       assign
      949                           tt-gds-act.gds-code = buf_goods.gds-code
      950                           tt-gds-act.gds-name = buf_goods.gds-name
      951                       .
      952                       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
      953                                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
      954                                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
      955                                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
      956                                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
      957                                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
      958                                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
      959                                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
      960                                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
      961                                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
      962                                                              and X_ext-classif-attr.attr-code = 'egais-info'
      963                                                              no-error .
      964                       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
      965                   end.
      966               end.
      967           end.
      968           IF hNoderef:NAME = "ain:Quantity"
      969           OR hNoderef:NAME = "ainp:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
      970           IF hNoderef:NAME = "iab:Quantity" THEN assign tt-gds-act.A-qnty = decimal(hText:node-value) no-error .
      971           IF hNoderef:NAME = "iab:BottlingDate" THEN assign tt-gds-act.A-bottleDate = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      972           IF hNoderef:NAME = "iab:TTNNumber" THEN assign tt-gds-act.A-ttnNumber = hText:node-value no-error .
      973           IF hNoderef:NAME = "iab:TTNDate" THEN assign tt-gds-act.A-ttnDate = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      974           IF hNoderef:NAME = "iab:EGAISFixNumber" THEN assign tt-gds-act.A-fixNumber = hText:node-value no-error .
      975           IF hNoderef:NAME = "iab:EGAISFixDate" THEN assign tt-gds-act.A-fixDate = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      976           if available tt-gds-act and tt-gds-act.A-ttnNumber <> ""
      977           and tt-gds-act.A-ttnNumber <> ? and (tt-gds-act.doc-code = ? or tt-gds-act.doc-code = "")
      978           then do :
      979               find first buf_parts no-lock where buf_parts.cst-code = tt-gds-act.A-ttnNumber
      980                                              and buf_parts.artic = buf_goods.artic
      981                                               and buf_parts.prod-type = buf_goods.prod-type
      982                                               and buf_parts.prod-code = buf_goods.prod-code
      983                                               and buf_parts.obj-type = v-cntxt-obj-type
      984                                               and buf_parts.obj-code = v-cntxt-obj-code
      985                                               and buf_parts.out-code = 'free-zone':U
      986                                               no-error .
      987               if available buf_parts then do :
      988                   assign
      989                       tt-gds-act.part-code = buf_parts.part-code
      990                       tt-gds-act.doc-code  = buf_parts.in-code
      991                   .
      992               end.
      993               else do :
      994                   find first ub.doc-attr no-lock where ub.doc-attr.attr-code = 'nids':U and ub.doc-attr.attr-value = tt-gds-act.A-ttnNumber no-error .
      995                   if available ub.doc-attr then do :
      996                       assign tt-gds-act.doc-code = ub.doc-attr.doc-code .
      997                   end.
      998                   else do :
      999                       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = tt-gds-act.A-ttnNumber no-error .
     1000                       if available buf_trn-doc then do :
     1001                           assign tt-gds-act.doc-code = buf_trn-doc.doc-code .
     1002                       end.
     1003                   end.
     1004               end.
     1005           end.
     1006           IF hNoderef:NAME = "ain:MarkCode"
     1007           OR hNoderef:NAME = "ainp:MarkCode"
     1008           OR hNoderef:NAME = "MarkCode" THEN do :
     1009               create tt-marks.
     1010               assign
     1011                   tt-marks.num                    = tt-gds-act.num
     1012                   tt-marks.gds-part-position_     = tt-gds-act.position_
     1013                   tt-marks.mark                   = hText:node-value
     1014                   tt-marks.gds-code               = tt-gds-act.gds-code
     1015                   tt-marks.gds-name               = tt-gds-act.gds-name
     1016                   tt-marks.alc-code               = tt-gds-act.alc-code
     1017                   ii = ii + 1.
     1018               .
     1019               assign tt-gds-act.marks-qnty = ii .
     1020           end.
     1021           run GetChildren (hNoderef, (level + 1)).
     1022       END.
     1023       DELETE OBJECT hNoderef.
     1024       DELETE OBJECT hText.
     1025   END procedure.
     1026   DEFINE BUTTON Btn_lkp
     1027        LABEL "Просмотр"
     1028        SIZE 15 BY 1.13.
     1029   DEFINE BUTTON Btn_create
     1030        LABEL "Создать"
     1031        SIZE 15 BY 1.13.
     1032   DEFINE BUTTON Btn_chg
     1033        LABEL "Изменить"
     1034        SIZE 15 BY 1.13.
     1035   DEFINE BUTTON Btn_del
     1036        LABEL "Удалить"
     1037        SIZE 15 BY 1.13.
     1038   DEFINE BUTTON Btn_send
     1039        LABEL "Отправить"
     1040        SIZE 15 BY 1.13.
     1041   DEFINE BUTTON Btn_OK AUTO-GO
     1042        LABEL "Выход"
     1043        SIZE 15 BY 1.13
     1044        BGCOLOR 8 .
     1045   DEFINE BUTTON Btn_Ans
     1046        LABEL "Посмотреть ответ"
     1047        SIZE 20 BY 1.13
     1048        BGCOLOR 8 .
     1049   DEFINE BUTTON Btn_Edit
     1050        LABEL "Редактировать"
     1051        SIZE 15 BY 1.13 tooltip "Вернуть в 'Новые' для редактирования"
     1052        BGCOLOR 8 .
     1053   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
     1054        LABEL "Дата с"
     1055        VIEW-AS FILL-IN
     1056        SIZE 9.5 BY 1 NO-UNDO.
     1057   DEFINE VARIABLE f-date-2 AS DATE FORMAT "99/99/99":U
     1058        LABEL "по"
     1059        VIEW-AS FILL-IN
     1060        SIZE 9.5 BY 1 NO-UNDO.
     1061   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
     1062        VIEW-AS RADIO-SET HORIZONTAL
     1063        RADIO-BUTTONS
     1064             "Новые", 1,
     1065             "Отправленные", 2
     1066        SIZE 27 BY 1.25 NO-UNDO.
     1067   DEFINE FRAME Dialog-Frame
     1068        Btn_OK AT ROW 1.2 COL 2
     1069        Btn_create at row 1.2 col 17
     1070        Btn_chg at row 1.2 col 32
     1071        Btn_del at row 1.2 col 47
     1072        Btn_send at row 1.2 col 62
     1073        Btn_Ans AT ROW 1.2 COL 32 WIDGET-ID 10
     1074        Btn_lkp AT ROW 1.2 COL 17 WIDGET-ID 12
     1075            Btn_Edit AT ROW 1.2 COL 52
     1076        RADIO-SET-1 AT ROW 1.2 COL 80 NO-LABEL WIDGET-ID 2
     1077        f-date AT ROW 2.5 COL 8.63 COLON-ALIGNED WIDGET-ID 22
     1078        f-date-2 AT ROW 2.5 COL 22.75 COLON-ALIGNED WIDGET-ID 26
     1079        SPACE(2) SKIP(22.2)
     1080       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1081            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1082            TITLE "Акты постановки на баланс в ЕГАИС"
     1083            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
     1084   ASSIGN
     1085          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1086          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1087   ON window-close OF FRAME Dialog-Frame
     1088   do:
     1089       delete object egais no-error .
     1090     apply "END-ERROR":U to self.
     1091   end.
     1092   ON CHOOSE OF Btn_lkp IN FRAME Dialog-Frame
     1093   DO:
     1094       if not bh-act-header:available then return no-apply .
     1095       run bge/egais-act-balance.w (parparentproc, 'ПРОСМОТР':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
     1096   END.
     1097   ON CHOOSE OF Btn_Edit IN FRAME Dialog-Frame
     1098   DO:
     1099       if not bh-act-header:available then return no-apply .
     1100       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
     1101       entry(3, buf_clob-bind.descr, chr(4)) = string(no) no-error .
     1102       entry(4, buf_clob-bind.descr, chr(4)) = "" no-error .
     1103       entry(6, buf_clob-bind.descr, chr(4)) = "" no-error .
     1104       bh-act-header:buffer-field ("is-sent"):buffer-value = string(no) no-error .
     1105       bh-act-header:buffer-field ("answer_"):buffer-value = "" no-error .
     1106       bh-act-header:buffer-field ("RegID"):buffer-value = "" no-error .
     1107       find first ub.esys-all-attr
     1108                   where ub.esys-all-attr.table-name = "esys-pck-sent"
     1109                   and ub.esys-all-attr.attr-code = "egais"
     1110                   and ub.esys-all-attr.key2       = 4
     1111                   and ub.esys-all-attr.attr-value = buf_clob-bind.uniq-key-rec
     1112                   no-error.
     1113       if available (ub.esys-all-attr )
     1114       then do:
     1115         delete ub.esys-all-attr .
     1116       end.
     1117       run refresh-query .
     1118   END.
     1119   ON CHOOSE OF Btn_create IN FRAME Dialog-Frame
     1120   DO:
     1121       run bge/egais-act-balance.w (parparentproc, 'ДОБАВЛЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
     1122       bh-act-header = egais:GetHndlTable(3, "").
     1123       run refresh-query.
     1124   END.
     1125   ON CHOOSE OF Btn_chg IN FRAME Dialog-Frame
     1126   DO:
     1127       if not bh-act-header:available then return no-apply .
     1128       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
     1129       run bge/egais-act-balance.w (parparentproc, 'ИЗМЕНЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
     1130       bh-act-header = egais:GetHndlTable(3, "").
     1131           run refresh-query.
     1132   END.
     1133   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
     1134   DO:
     1135       if not bh-act-header:available then return no-apply .
     1136       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
     1137       delete buf_clob-bind .
     1138       bh-act-header:buffer-delete () .
     1139       run refresh-query.
     1140   END.
     1141   ON CHOOSE OF Btn_send IN FRAME Dialog-Frame
     1142   DO:
     1143       if not bh-act-header:available then return no-apply .
     1144       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
     1145       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     1146       os-delete "ActChargeOn.xml".
     1147       os-delete "ActChargeOn_v2.xml".
     1148       os-delete "temp.xml".
     1149       copy-lob
     1150       from  object buf_clob-data.cdata
     1151       to  file 'temp.xml'
     1152       no-convert
     1153       no-error .
     1154       run  parseXML in this-procedure .
     1155       if egais:VerXSD = "1" then do :
     1156           v-file = 'ActChargeOn.xml'.
     1157           run makeXML .
     1158       end.
     1159       if egais:VerXSD = "2" then do :
     1160           v-file = 'ActChargeOn_v2.xml'.
     1161           run makeXML_v2 .
     1162       end.
     1163       egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
     1164       egais:SendRequestUTM() .
     1165       glog = egais:IsSent .
     1166       glog = egais:StatusErr .
     1167       if glog then do :
     1168           message egais:Msg view-as alert-box.
     1169           return no-apply.
     1170       end.
     1171       else do :
     1172           entry (3, buf_clob-bind.descr, chr(4)) = "yes".
     1173           bh-act-header:buffer-field ("is-sent"):buffer-value = true.
     1174       end.
     1175       run refresh-query.
     1176       message "Акт " egais:inNum " отправлен" view-as alert-box .
     1177   END.
     1178   ON CHOOSE OF Btn_Ans IN FRAME Dialog-Frame
     1179   DO:
     1180     if not bh-act-header:available
     1181       then return no-apply.
     1182     v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
     1183     egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
     1184     egais:GetHndlTable(2, bh-act-header:buffer-field ("num"):buffer-value) .
     1185     glog = egais:StatusErr .
     1186     if glog
     1187     and (bh-act-header:buffer-field ("answer_"):buffer-value = ""
     1188       or bh-act-header:buffer-field ("answer_"):buffer-value = ? )
     1189     then do :
     1190           message egais:Msg view-as alert-box.
     1191           return no-apply.
     1192     end.
     1193     else do :
     1194       message (bh-act-header:buffer-field ("answer_"):buffer-value) skip(1)
     1195          "Сохранить ответ?" view-as alert-box information buttons yes-no update glog.
     1196       if glog
     1197       then do :
     1198           v-ans-name = bh-act-header:buffer-field ("num"):buffer-value + "_ANS.txt" .
     1199           output to value(v-ans-name) .
     1200               put unformatted bh-act-header:buffer-field ("answer_"):buffer-value skip .
     1201           output close.
     1202           message "Ответ сохранен в файл " v-ans-name " в рабочей директории" view-as alert-box information .
     1203       end.
     1204     end.
     1205     run refresh-query.
     1206   END.
     1207   ON value-changed OF RADIO-SET-1 IN FRAME Dialog-Frame
     1208   do:
     1209     assign RADIO-SET-1 .
     1210     if RADIO-SET-1 = 1
     1211     then do :
     1212       ENABLE Btn_create Btn_chg Btn_del Btn_send
     1213         WITH FRAME Dialog-Frame.
     1214       HIDE Btn_Ans Btn_lkp Btn_Edit in FRAME Dialog-Frame.
     1215     end.
     1216     else do :
     1217       ENABLE Btn_Ans Btn_lkp Btn_Edit
     1218         WITH FRAME Dialog-Frame.
     1219       HIDE Btn_create Btn_chg Btn_del Btn_send in FRAME Dialog-Frame.
     1220     end.
     1221     run refresh-query.
     1222   end.
     1223   ON leave OF f-date IN FRAME Dialog-Frame
     1224   do:
     1225     run refresh-query.
     1226   end.
     1227   ON return OF f-date IN FRAME Dialog-Frame
     1228   do:
     1229     run refresh-query.
     1230   end.
     1231   ON leave OF f-date-2 IN FRAME Dialog-Frame
     1232   do:
     1233     run refresh-query.
     1234   end.
     1235   ON return OF f-date-2 IN FRAME Dialog-Frame
     1236   do:
     1237     run refresh-query.
     1238   end.
     1239   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     1240   then frame Dialog-Frame:PARENT = active-window.
     1241   MAIN-BLOCK:
     1242   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     1243      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     1244   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     1246     (output v-db-num
     1247     ,output v-user-id
     1248     ) no-error .
     1249     empty temp-table thbjattr_thbj-attr .
     1250     run adm/shattri.p (
     1251          input "get":U
     1252         ,input v-cntxt-obj-type
     1253         ,input v-cntxt-obj-code
     1254         ,input 'egais':U
     1255         ,input 'egais-fsrar':U
     1256         ,output v-value-character
     1257         ,output v-value-date
     1258         ,output v-value-decimal
     1259         ,output v-value-integer
     1260         ,output v-value-logical
     1261         ,output v-value-type
     1262         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1263         ) no-error .
     1264     assign
     1265       v-fs-rar = v-value-character
     1266     .
     1267     run adm/shattri.p (
     1268          input "get":U
     1269         ,input '':U
     1270         ,input 0
     1271         ,input 'egais':U
     1272         ,input 'egais-exsys':U
     1273         ,output v-value-character
     1274         ,output v-value-date
     1275         ,output v-value-decimal
     1276         ,output v-value-integer
     1277         ,output v-value-logical
     1278         ,output v-value-type
     1279         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1280         ) no-error .
     1281     assign v-ext-sys = v-value-integer .
     1282     egais = new ActBalance (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
     1283     egais:DbNum = v-db-num .
     1284     egais:User_Id = v-user-id .
     1285     bh-act-header = egais:GetHndlTable(3, "").
     1286     create query qh-act-header.
     1287     f-date = date (now) - 31.
     1288     f-date-2 = ?.
     1289     run refresh-query.
     1290     create browse browse-hdl-act-header
     1291       assign
     1292         title     = 'Акты постановки на баланс ЕГАИС'
     1293         frame     = frame Dialog-Frame:handle
     1294         query     = qh-act-header
     1295         x         = 10
     1296         y         = 60
     1297         width     = 104
     1298         height    = 22
     1299         visible   = true
     1300         read-only = true
     1301         sensitive = true
     1302         separators = true
     1303         column-resizable = true
     1304         column-scrolling = true
     1305         triggers:
     1306         end triggers
     1307     .
     1308     on row-display of browse-hdl-act-header do :
     1309         if valid-handle (calc-col-hndl) then do :
     1310             if RADIO-SET-1 = 1 then calc-col-hndl:SCREEN-VALUE = "Новый" .
     1311             else do :
     1312               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
     1313               if v-RegID = "" or v-RegID = ? or num-entries(v-RegID, CHR(5)) <> 2 then calc-col-hndl:SCREEN-VALUE = "Отправлен" .
     1314               if num-entries(v-RegID, CHR(5)) = 2 then do :
     1315                   if entry(2, v-RegID, CHR(5)) = "R" then do :
     1316                       calc-col-hndl:SCREEN-VALUE = "Отклонен" .
     1317                       calc-col-hndl:bgcolor = red_color .
     1318                   end.
     1319                   if entry(2, v-RegID, CHR(5)) = "A" then do :
     1320                       calc-col-hndl:SCREEN-VALUE = "Принят" .
     1321                       calc-col-hndl:bgcolor = green_color .
     1322                   end.
     1323               end.
     1324             end.
     1325         end.
     1326         if valid-handle (calc-col-hndl2) then do :
     1327             if RADIO-SET-1 = 1 then calc-col-hndl2:SCREEN-VALUE = " - " .
     1328             else do :
     1329               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
     1330               calc-col-hndl2:SCREEN-VALUE = entry(1, v-RegID, CHR(5)) .
     1331             end.
     1332         end.
     1333     end.
     1334     ON value-changed OF browse-hdl-act-header
     1335     do:
     1336         if calc-col-hndl:SCREEN-VALUE = "Отклонен" then enable Btn_Edit with FRAME Dialog-Frame .
     1337                                                    else disable Btn_Edit with FRAME Dialog-Frame .
     1338     end.
     1339     if not bh-act-header = ?
     1340     then do:
     1341       do ii = 1 to bh-act-header:num-fields - 4:
     1342         bcol[ii] = browse-hdl-act-header:add-like-column('tt-act-header' + '.' + bh-act-header:buffer-field (ii):name, 0, 'FILL-IN').
     1343       end.
     1344           bcol[3] = browse-hdl-act-header:add-like-column('tt-act-header.type_', 0, 'FILL-IN').
     1345           calc-col-hndl = browse-hdl-act-header:add-calc-column("char", "X(10)", "", "Статус") .
     1346           calc-col-hndl2 = browse-hdl-act-header:add-calc-column("char", "X(20)", "", "RegID") .
     1347       browse-hdl-act-header:get-browse-column (1):width-chars = 26.
     1348       browse-hdl-act-header:get-browse-column (2):width-chars = 10.
     1349       browse-hdl-act-header:get-browse-column (3):width-chars = 34.
     1350       browse-hdl-act-header:get-browse-column (4):width-chars = 10.
     1351       browse-hdl-act-header:get-browse-column (5):width-chars = 17.
     1352     end.
     1353     run enable_UI.
     1354     apply "value-changed" to RADIO-SET-1 in frame Dialog-Frame.
     1355     wait-for go of frame Dialog-Frame.
     1356   end.
     1357   run disable_UI.
     1358   PROCEDURE disable_UI :
     1359     HIDE FRAME Dialog-Frame.
     1360   END PROCEDURE.
     1361   PROCEDURE enable_UI :
     1362     DISPLAY RADIO-SET-1 f-date f-date-2
     1363         WITH FRAME Dialog-Frame.
     1364     ENABLE Btn_OK RADIO-SET-1 f-date f-date-2
     1365         WITH FRAME Dialog-Frame.
     1366     VIEW FRAME Dialog-Frame.
     1367   END PROCEDURE.
     1368   PROCEDURE refresh-query :
     1369   def var v-proposition  as char no-undo.
     1370   if bh-act-header = ?
     1371     then return .
     1372     assign input frame Dialog-Frame
     1373       f-date
     1374       f-date-2
     1375     .
     1376     v-proposition =
     1377       (if f-date <> ? then " and tt-act-header.date_ >= " + string (f-date) else "") +
     1378       (if f-date-2 <> ? then " and tt-act-header.date_ <= " + string (f-date-2) else "")
     1379       .
     1380   case RADIO-SET-1 :
     1381       when 1  then
     1382       do:
     1383         qh-act-header:query-close.
     1384         qh-act-header:set-buffers (bh-act-header).
     1385         qh-act-header:query-prepare ( substitute ("for each tt-act-header where not tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1386         qh-act-header:query-open.
     1387         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition) no-error .
     1388       end.
     1389       when 2  then
     1390       do:
     1391         qh-act-header:query-close.
     1392         qh-act-header:set-buffers (bh-act-header).
     1393         qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1394         qh-act-header:query-open.
     1395         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition ) no-error .
     1396       end.
     1397     end.
     1398   if bh-act-header:available
     1399     then qh-act-header:reposition-to-rowid ( bh-act-header:rowid ) no-error.
     1400   if valid-handle (browse-hdl-act-header) then apply "value-changed" to browse-hdl-act-header.
     1401   end.
     1402   PROCEDURE proc-row-leave :
     1403     if false then do:
     1404       do ii = 1 to extent (bcol).
     1405         bcol[ii]:bgcolor = RED_COLOR.
     1406       end.
     1407     end.
     1408   end.
