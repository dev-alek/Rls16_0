      378   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   define temp-table tt-act-header
      380       field num           as character        label "№ акта"      format "X(30)"
      381       field date_         as date             label "Дата акта"
      382       field is-sent       as logical
      383       field answer_       as character        label "Ответ"       format "X(1500)"
      384       field type_         as character        label "Основание"   format "X(35)"
      385       field RegID         as character        label "Рег. номер"  format "X(50)"
      386       index pi as primary unique
      387           num
      388   .
      389   define temp-table tt-gds-act
      390       field num           as character                label "№ акта"
      391       field position_     as integer                  label "№ пп"                    format ">>>9"
      392       field gds-code      like ub.goods.gds-code      label "Код товара   "
      393       field part-code     like ub.parts.part-code     label "Партия"
      394       field doc-code      as character                label "№ накладной TH"
      395       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
      396       field alc-code      as character                label "Алкогольный код"         format "X(21)"
      397       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
      398       field qnty          as decimal                  label "Количество"
      399       field inform-A      as character                label "Справка А"               format "X(20)"
      400       field A-qnty        as decimal                  label "Кол-во в справке"
      401       field A-bottleDate  as date                     label "Дата розлива"
      402       field A-ttnNumber   as character                label "№ ТТН справки А"         format "X(15)"
      403       field A-ttnDate     as date                     label "Дата"
      404       field A-fixNumber   as character                label "№ фиксации в ЕГАИС"      format "X(20)"
      405       field A-fixDate     as date                     label "Дата фикс."
      406       field inform-B      as character                label "Справка Б"               format "X(20)"
      407       field marks-qnty    as integer                  label "Кол-во марок"
      408       field egais-name    as character
      409       index pi as primary unique
      410           position_
      411       index code
      412           gds-code doc-code
      413   .
      414   define new shared temp-table tt-marks
      415       field num                 as character            label "№ акта"
      416       field gds-part-position_  as integer
      417       field mark                as character            label "Марка"          format "X(100)"
      418       field new_                as logical
      419       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
      420       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
      421       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
      422       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
      423       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
      424       field flag                as logical              label "T"
      425       field reserv              as integer              label "R"
      426       field parts               as character            label "Партия"         format "X(130)"
      427       index pi as primary unique
      428           mark
      429   .
      430   define variable sw as handle no-undo .
      431   define variable v-file              as character no-undo initial "ActChargeOn1.xml".
      432   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
      433   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
      434   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
      435   procedure makeXML_TH :
      436       create sax-writer sw .
      437       sw:formatted = true.
      438       sw:set-output-destination ("file", v-file).
      439       sw:encoding = "UTF-8".
      440       sw:start-document () .
      441       sw:start-element ("ns:Documents") .
      442       sw:insert-attribute ("Version", "1.0") .
      443       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      444       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      445       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef") .
      446       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
      447       sw:insert-attribute ("xmlns:ain", "http://fsrar.ru/WEGAIS/ActChargeOn") .
      448       sw:insert-attribute ("xmlns:ainp", "http://fsrar.ru/WEGAIS/ActChargeOn_v2") .
      449       sw:insert-attribute ("xmlns:iab", "http://fsrar.ru/WEGAIS/ActInventoryABInfo") .
      450           sw:start-element ("ns:Owner") .
      451               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      452           sw:end-element ("ns:Owner") .
      453           sw:start-element ("ns:Document") .
      454               sw:start-element ("ns:ActChargeOn") .
      455                   sw:start-element ("ain:Header") .
      456                       sw:write-data-element ("ain:Number", tt-act-header.num) .
      457                       sw:write-data-element ("ain:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      458                       sw:write-data-element ("ain:Note", "Необходимо поставить товарные позиции на баланс") .
      459                       if egais:VerXSD = "2"
      460                       then do :
      461                           if tt-act-header.type_ <> "Продукция полученная до 01.01.2016"
      462                           then
      463                             sw:write-data-element ("ainp:TypeChargeOn", tt-act-header.type_) no-error .
      464                           else
      465                             sw:write-data-element ("ainp:TypeChargeOn", "Продукция, полученная до 01.01.2016") no-error .
      466                       end.
      467                   sw:end-element ("ain:Header") .
      468                   sw:start-element ("ain:Content") .
      469       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      470           if tt-gds-act.qnty <= 0 then next.
      471                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
      472                       sw:start-element ("ain:Position") .
      473                           sw:write-data-element ("ain:Identity", string(tt-gds-act.position_)) .
      474                           sw:start-element ("ain:Product") .
      475                               sw:write-data-element ("pref:Type", "АП") .
      476                               sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
      477                               sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
      478                               sw:write-data-element ("doc-code", tt-gds-act.doc-code) no-error .
      479                               sw:write-data-element ("part-code", tt-gds-act.part-code) no-error .
      480                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
      481                               sw:write-data-element ("pref:ShortName", "") .
      482                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
      483                               sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
      484                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
      485                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
      486                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
      487                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
      488                           end.
      489                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
      490                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      491                                                                  and X_ext-classif-attr.db-num = 0
      492                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
      493                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
      494                                                                  and X_ext-classif-attr.Key#_three = 0
      495                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
      496                                                                  and X_ext-classif-attr.CharKey_two = ""
      497                                                                  and X_ext-classif-attr.CharKey_three = ""
      498                                                                  and X_ext-classif-attr.nonunique = 0
      499                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
      500                                                                  no-error .
      501                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
      502                             def var v-prod as char no-undo.
      503                             def var v-impor as char no-undo.
      504                             def var v-msg as char no-undo.
      505                             v-prod = ''.
      506                             v-impor = ''.
      507                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
      508                             if egais:VerXSD = "1"
      509                             and (v-prod = ?
      510                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      511                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      512                             or v-prod = ""
      513                             or num-entries (v-prod, chr (5)) < 6 )
      514                             then do:
      515                               message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
      516                             end.
      517                             if egais:VerXSD = "2"
      518                             and (v-prod = ?
      519                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      520                             or v-prod = ""
      521                             or num-entries (v-prod, chr (5)) < 8
      522                             or entry (7, v-prod, chr(5)) = "" )
      523                             then do:
      524                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
      525                             end.
      526                             v-impor = entry (2, X_ext-classif-attr.attr-value, chr(4)) no-error.
      527                             if egais:VerXSD = "1"
      528                             and num-entries (v-impor, chr (5)) > 0 and num-entries (v-impor, chr (5)) < 6
      529                               then
      530                             do:
      531                               message "У товара неверно указан импортер из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
      532                             end.
      533                             sw:start-element ("pref:Producer") .
      534                               if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
      535                               if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
      536                               sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
      537                               sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
      538                               sw:start-element ("oref:address").
      539                                 sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
      540                                 sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
      541                               sw:end-element ("oref:address").
      542                             sw:end-element ("pref:Producer") .
      543                             if egais:VerXSD = "1"
      544                             and v-impor <> ""
      545                             and v-impor <> ?
      546                             and v-impor <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      547                             and v-impor <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) then do:
      548                               sw:start-element ("pref:Importer") .
      549                                 if entry (2, v-impor, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-impor, chr(5)) ).
      550                                 if entry (3, v-impor, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-impor, chr(5)) ).
      551                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-impor, chr(5)) ).
      552                                 sw:write-data-element ("oref:FullName", entry (4, v-impor, chr(5)) ).
      553                                 sw:start-element ("oref:address").
      554                                   sw:write-data-element ("oref:Country", entry (5, v-impor, chr(5)) ).
      555                                   sw:write-data-element ("oref:description", entry (6, v-impor, chr(5)) ).
      556                                 sw:end-element ("oref:address").
      557                               sw:end-element ("pref:Importer") .
      558                             end.
      559                           end.
      560                           else do:
      561                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
      562                           end.
      563                           sw:end-element ("ain:Product") .
      564                           sw:write-data-element ("ain:Quantity", string(tt-gds-act.qnty)) .
      565                           sw:start-element ("ain:InformAB") .
      566                               sw:start-element ("ain:InformABReg") .
      567                                   sw:start-element ("ain:InformA") .
      568                                       sw:write-data-element ("iab:Quantity", string(tt-gds-act.A-qnty)) no-error .
      569                                       sw:write-data-element ("iab:BottlingDate", string(iso-date(tt-gds-act.A-bottleDate))) no-error .
      570                                       sw:write-data-element ("iab:TTNNumber", tt-gds-act.A-ttnNumber) no-error .
      571                                       sw:write-data-element ("iab:TTNDate", string(iso-date(tt-gds-act.A-ttnDate))) no-error .
      572                                       if tt-gds-act.A-fixNumber <> ? and trim(tt-gds-act.A-fixNumber) <> "" then do :
      573                                           sw:write-data-element ("iab:EGAISFixNumber", tt-gds-act.A-fixNumber) no-error .
      574                                           sw:write-data-element ("iab:EGAISFixDate", string(iso-date(tt-gds-act.A-fixDate))) no-error .
      575                                       end.
      576                                   sw:end-element ("ain:InformA") .
      577                               sw:end-element ("ain:InformABReg") .
      578                           sw:end-element ("ain:InformAB") .
      579           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
      580           if available tt-marks then do :
      581                           sw:start-element ("ain:MarkCodeInfo") .
      582               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      583                               sw:write-data-element ("ain:MarkCode", tt-marks.mark) .
      584               end.
      585                           sw:end-element ("ain:MarkCodeInfo") .
      586           end.
      587                       sw:end-element ("ain:Position") .
      588       end.
      589                   sw:end-element ("ain:Content") .
      590               sw:end-element ("ns:ActChargeOn") .
      591           sw:end-element ("ns:Document") .
      592       sw:end-element ("ns:Documents") .
      593       sw:end-document () .
      594       delete object sw.
      595   end procedure .
      596   procedure makeXML :
      597       create sax-writer sw .
      598       sw:formatted = true.
      599       sw:set-output-destination ("file", v-file).
      600       sw:encoding = "UTF-8".
      601       sw:start-document () .
      602       sw:start-element ("ns:Documents") .
      603       sw:insert-attribute ("Version", "1.0") .
      604       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      605       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      606       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef") .
      607       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
      608       sw:insert-attribute ("xmlns:ain", "http://fsrar.ru/WEGAIS/ActChargeOn") .
      609       sw:insert-attribute ("xmlns:iab", "http://fsrar.ru/WEGAIS/ActInventoryABInfo") .
      610           sw:start-element ("ns:Owner") .
      611               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      612           sw:end-element ("ns:Owner") .
      613           sw:start-element ("ns:Document") .
      614               sw:start-element ("ns:ActChargeOn") .
      615                   sw:start-element ("ain:Header") .
      616                       sw:write-data-element ("ain:Number", tt-act-header.num) .
      617                       sw:write-data-element ("ain:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      618                       sw:write-data-element ("ain:Note", "Необходимо поставить товарные позиции на баланс") .
      619                   sw:end-element ("ain:Header") .
      620                   sw:start-element ("ain:Content") .
      621       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      622           if tt-gds-act.qnty <= 0 then next.
      623                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
      624                       sw:start-element ("ain:Position") .
      625                           sw:write-data-element ("ain:Identity", string(tt-gds-act.position_)) .
      626                           sw:start-element ("ain:Product") .
      627                               sw:write-data-element ("pref:Type", "АП") .
      628                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
      629                               sw:write-data-element ("pref:ShortName", "") .
      630                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
      631                               sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
      632                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
      633                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
      634                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
      635                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
      636                           end.
      637                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
      638                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      639                                                                  and X_ext-classif-attr.db-num = 0
      640                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
      641                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
      642                                                                  and X_ext-classif-attr.Key#_three = 0
      643                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
      644                                                                  and X_ext-classif-attr.CharKey_two = ""
      645                                                                  and X_ext-classif-attr.CharKey_three = ""
      646                                                                  and X_ext-classif-attr.nonunique = 0
      647                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
      648                                                                  no-error .
      649                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
      650                             def var v-prod as char no-undo.
      651                             def var v-impor as char no-undo.
      652                             def var v-msg as char no-undo.
      653                             v-prod = ''.
      654                             v-impor = ''.
      655                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
      656                             if v-prod = ?
      657                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      658                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      659                             or v-prod = ""
      660                             or num-entries (v-prod, chr (5)) < 6
      661                             then do:
      662                               message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
