      336   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      337        LABEL "Отмена"
      338        SIZE 10 BY 1
      339        BGCOLOR 8 .
      340   DEFINE BUTTON Btn_del
      341        LABEL "Удалить"
      342        SIZE 10 BY 1
      343        BGCOLOR 8 .
      344   DEFINE BUTTON Btn_EXIT AUTO-GO
      345        LABEL "Выход"
      346        SIZE 10 BY 1
      347        BGCOLOR 8 .
      348   DEFINE BUTTON Btn_goods
      349        LABEL "Товары"
      350        SIZE 10 BY 1
      351        BGCOLOR 8 .
      352   DEFINE BUTTON Btn_excpmarks
      353        LABEL "Неучт. марки"
      354        SIZE 13 BY 1
      355        BGCOLOR 8 .
      356   DEFINE BUTTON Btn_imp
      357        LABEL "Импорт"
      358        SIZE 10 BY 1
      359        BGCOLOR 8 .
      360   DEFINE BUTTON Btn_OK AUTO-GO
      361        LABEL "Ввод"
      362        SIZE 10 BY 1
      363        BGCOLOR 8 .
      364   DEFINE VARIABLE v-mark AS CHARACTER FORMAT "X(255)"
      365        LABEL "Марка"
      366        VIEW-AS FILL-IN
      367        SIZE 80 BY 1.
      368   DEFINE VARIABLE v-qnty-goods AS INTEGER FORMAT "->>>>9":U INITIAL 0
      369        LABEL "кол-во в партии"
      370        VIEW-AS FILL-IN
      371        SIZE 5.5 BY 1 NO-UNDO.
      372   DEFINE VARIABLE v-qnty-marks AS INTEGER FORMAT ">>>>9":U INITIAL 0
      373        LABEL "кол-во марок"
      374        VIEW-AS FILL-IN
      375        SIZE 5.5 BY 1 NO-UNDO.
      376   DEFINE QUERY br-marks FOR
      377         tt-marks SCROLLING.
      378   DEFINE BROWSE br-marks
      379     QUERY br-marks NO-LOCK DISPLAY
      380         (IF tt-marks.flag THEN "+":U ELSE "-":U) FORMAT "x(1)":U COLUMN-LABEL "Т"
      381       (IF tt-marks.reserv = 1 THEN "+":U ELSE "-":U) FORMAT "x(1)":U COLUMN-LABEL "R"
      382       tt-marks.parts
      383       WIDTH 10
      384       tt-marks.mark
      385       WIDTH 40
      386       tt-marks.alc-code
      387       WIDTH 20
      388       tt-marks.gds-code
      389       WIDTH 10
      390       tt-marks.gds-name
      391       WIDTH 30
      392       tt-marks.impor-full-name
      393       WIDTH 30
      394       tt-marks.prod-full-name
      395       WIDTH 30
      396       WITH NO-ROW-MARKERS SEPARATORS SIZE 112 BY 20.21 FIT-LAST-COLUMN.
      397   DEFINE FRAME Dialog-Frame
      398        Btn_OK AT ROW 1.25 COL 2
      399        Btn_EXIT AT ROW 1.25 COL 2
      400        Btn_Cancel AT ROW 1.25 COL 12
      401        Btn_del AT ROW 1.25 COL 22
      402        Btn_imp AT ROW 1.25 COL 32
      403        Btn_goods AT ROW 1.25 COL 42
      404        Btn_excpmarks AT ROW 1.25 COL 52 WIDGET-ID 12
      405        v-qnty-marks AT ROW 1.25 COL 106 COLON-ALIGNED WIDGET-ID 8
      406        v-qnty-goods AT ROW 2.25 COL 106 COLON-ALIGNED WIDGET-ID 10
      407        v-mark AT ROW 2.71 COL 7 COLON-ALIGNED
      408        br-marks AT ROW 4 COL 2
      409        SPACE(1.00) SKIP(0.29)
      410       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      411            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      412            TITLE "Ввод Акцизных марок"
      413            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      414   ASSIGN
      415          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      416          FRAME Dialog-Frame:HIDDEN           = TRUE.
      417   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      418   DO:
      419         APPLY "END-ERROR":U TO SELF.
      420       END.
      421   ON ROW-DISPLAY OF br-marks IN FRAME Dialog-Frame
      422   DO:
      423       if p-num = "" and p-position = 0 then
      424       do:
      425         if tt-marks.gds-code = 0 then
      426         do:
      427           tt-marks.gds-code:BGCOLOR in browse br-marks = red_COLOR.
      428           tt-marks.alc-code:BGCOLOR in browse br-marks = red_COLOR.
      429           tt-marks.mark:BGCOLOR in browse br-marks = red_COLOR.
      430           tt-marks.gds-name:BGCOLOR in browse br-marks = red_COLOR.
      431           tt-marks.prod-full-name:BGCOLOR in browse br-marks = red_COLOR.
      432           tt-marks.impor-full-name:BGCOLOR in browse br-marks = red_COLOR.
      433         end.
      434         if tt-marks.flag = yes then
      435         do:
      436           tt-marks.gds-code:BGCOLOR in browse br-marks = DARK_GREY_COLOR.
      437         end.
      438       end.
      439   END.
      440   ON VALUE-CHANGED OF br-marks IN FRAME Dialog-Frame
      441   DO:
      442     if available tt-marks then do:
      443           if tt-marks.gds-code <> 0 and p-mode = 'ИЗМЕНЕНИЕ':U then do:
      444             enable Btn_goods
      445             WITH FRAME Dialog-Frame.
      446           end.
      447           else do:
      448             disable Btn_goods
      449             WITH FRAME Dialog-Frame.
      450           end.
      451      end.
      452   END.
      453   ON choose OF Btn_Cancel IN FRAME Dialog-Frame
      454   DO:
      455         for each tt-marks exclusive-lock where tt-marks.new_ :
      456           delete tt-marks .
      457         end.
      458         for each tt-del-marks where not tt-del-marks.new_ :
      459           create tt-marks.
      460           buffer-copy tt-del-marks to tt-marks .
      461         end.
      462       END.
      463   ON choose OF Btn_del IN FRAME Dialog-Frame
      464   DO:
      465         if not available tt-marks then return no-apply .
      466         find first tt-del-marks no-lock where tt-del-marks.mark = tt-marks.mark no-error .
      467         if not available tt-del-marks
      468         then do :
      469             create tt-del-marks.
      470             buffer-copy tt-marks to tt-del-marks .
      471         end.
      472         delete tt-marks .
      473         open query br-marks for each tt-marks where tt-marks.num = p-num and tt-marks.gds-part-position_ = p-position.
      474       END.
      475   ON choose OF Btn_goods IN FRAME Dialog-Frame
      476   DO:
      477         define variable v-prod-full-name as character no-undo .
      478         define variable v-import-full-name as character no-undo .
      479         if available tt-marks then
      480         do:
      481           v-mode = 'ПРОСМОТР':U.
      482           v-gds-code = 0 .
      483           run bge/egais-goods-mark.w ( input parparentproc, input v-mode, input-output tt-marks.alc-code, input-output v-gds-code, output v-gds-name, output v-prod-full-name, output v-import-full-name )  .
      484           if v-gds-code <> 0 then
      485           do:
      486             assign
      487               tt-marks.gds-code = v-gds-code
      488               tt-marks.gds-name = v-gds-name
      489               tt-marks.prod-full-name = v-prod-full-name
      490               tt-marks.impor-full-name = v-import-full-name
      491               .
      492           end.
      493           Br-marks:refresh() in frame Dialog-Frame .
      494         end.
      495         else
      496           message "Не выбран алког. код"
      497             view-as alert-box.
      498       END.
      499   ON CHOOSE OF Btn_excpmarks IN FRAME Dialog-Frame
      500   DO:
      501     excMarks = new excisemarks(v-cntxt-obj-type, v-cntxt-obj-code).
      502     excMarks:GetMarkForInvDoc(v-key-rec, p-alc-code, input-output table tt-marks-doc).
      503     for each tt-marks-doc:
      504       create tt-marks.
      505       assign
      506         tt-marks.alc-code = tt-marks-doc.alc-code
      507         tt-marks.gds-code = tt-marks-doc.gds-code
      508         tt-marks.mark = tt-marks-doc.exciseMark
      509       no-error.
      510       if error-status:error
      511         then delete tt-marks.
      512     end.
      513     open query br-marks for each tt-marks .
      514     assign
      515       v-mark:screen-value = "" .
      516     assign v-mark .
      517     apply "entry" to v-mark in FRAME Dialog-Frame.
      518   END.
      519   ON choose OF Btn_imp IN FRAME Dialog-Frame
      520   DO:
      521         run proc-choose-file no-error .
      522         open query br-marks for each tt-marks  where tt-marks.num = p-num and tt-marks.gds-part-position_ = p-position .
      523         assign
      524           v-mark:screen-value = "" .
      525         assign v-mark .
      526         apply "entry" to v-mark in FRAME Dialog-Frame.
      527   END.
      528   ON choose OF Btn_OK IN FRAME Dialog-Frame
      529   DO:
      530         for each tt-marks exclusive-lock :
      531           assign
      532             tt-marks.new_ = false .
      533         end.
      534       END.
      535   ON return OF v-mark IN FRAME Dialog-Frame
      536   DO:
      537               define variable v-error as logical no-undo init no.
      538               output stream str-err to value(v-proc-name-err) append.
      539               output stream str-alc to value(v-proc-name-alc) append.
      540               def var ii as int.
      541               assign
      542                   v-mark = v-mark:screen-value .
      543               RUN ProcAlcCode IN THIS-PROCEDURE (input v-mark, output v-alc-code, output l-error, output v-error-lang) no-error.
      544               if v-error-lang then
      545               do:
      546                   message "Не корректно считана акцизная марка, перед считыванием переключите клавиатуру на английскую раскладку."
      547                       view-as alert-box.
      548                   put stream str-err unformatted
      549                       "Не корректно считана акцизная марка, акцизная марка содержит не допустимые символы или русские буквы."
      550                       skip .
      551                   assign
      552                       v-mark              = ""
      553                       v-mark:screen-value = ""
      554                       .
      555               end.
      556               else
      557               do:
      558                   if l-error then
      559                   do:
      560                       message substitute ("Алког. код не преобразовывается в десятичную систему из акцизной марки: &1", v-mark)
      561                           view-as alert-box.
      562                       v-alc-code = "".
      563                       put stream str-err unformatted
      564                           substitute ("Алког. код не преобразовывается в десятичную систему из акцизной марки: &1", v-mark)
      565                           skip .
      566                   end.
      567                   else
      568                   do:
      569                       extGdsObj = new ExtGds (true).
      570                       extGdsObj:OpenQueryExtGds(0, v-alc-code).
      571                       if extGdsObj:NumBundles = 0 then
      572                       do:
      573                           message substitute ("Для алког. кода &1 не найден товар (не установлено соответствие)", v-alc-code)
      574                               view-as alert-box.
      575                           put stream str-err unformatted
      576                               substitute ("Для алког. кода &1 не найден товар (не установлено соответствие)", v-alc-code)
      577                               skip .
      578                           if p-num = "" and p-position = 0 then
      579                           do:
      580                               find first tt-marks where tt-marks.mark = v-mark no-lock no-error.
      581                               if not available tt-marks then
      582                               do:
      583                                   create tt-marks .
      584                               end.
      585                               assign
      586                                   tt-marks.mark     = v-mark
      587                                   tt-marks.new_     = true
      588                                   tt-marks.alc-code = v-alc-code
      589                                   .
      590                           end.
      591                       end.
      592                       else
      593                       do:
      594                           if p-alc-code <> "" and p-alc-code <> extGdsObj:GetExtGdsValue(1):AlcCode then
      595                           do :
      596                               message "Не тот товар! Вы вводите марки для алк. кода " + p-alc-code skip
      597                                   "Алк. код в марке - " extGdsObj:GetExtGdsValue(1):AlcCode view-as alert-box .
      598                           end.
      599                           if (p-alc-code <> "" and p-alc-code = extGdsObj:GetExtGdsValue(1):AlcCode) or p-alc-code = "" then
      600                           do:
      601                               find first tt-marks where tt-marks.mark = v-mark no-lock no-error.
      602                               if AVAILABLE tt-marks then
      603                               do:
      604                                   MESSAGE "Марка с таким" v-mark "кодом уже введена"
      605                                       VIEW-AS ALERT-BOX.
      606                               end.
      607                               else
      608                               do:
      609                                   create tt-marks .
      610                               end.
      611                               assign
      612                                   tt-marks.num                = p-num
      613                                   tt-marks.gds-part-position_ = p-position
      614                                   tt-marks.mark               = v-mark
      615                                   tt-marks.new_               = true .
      616                               tt-marks.gds-code           = extGdsObj:GetExtGdsValue(1):GdsCode .
      617                               tt-marks.alc-code           = extGdsObj:GetExtGdsValue(1):AlcCode .
      618                               tt-marks.prod-full-name     = extGdsObj:GetExtGdsValue(1):FullNameProd .
      619                               tt-marks.impor-full-name    = extGdsObj:GetExtGdsValue(1):FullNameImpor .
      620                               .
      621                               v-gds-code = extGdsObj:GetExtGdsValue(1):GdsCode .
      622                               find first ub.goods where ub.goods.gds-code = v-gds-code no-lock no-error.
      623                               if available ub.goods then tt-marks.gds-name = ub.goods.gds-name .
      624                               if extGdsObj:NumBundles > 1 then tt-marks.flag = yes .
      625                               if p-num = "" and p-position = 0 then
      626                               do:
      627                                   do ii = 1 to extGdsObj:NumBundles:
      628                                       find first ub.goods where ub.goods.gds-code = v-gds-code no-lock no-error.
      629                                       if available ub.goods then v-gds-name = ub.goods.gds-name .
      630                                       put stream str-alc unformatted
      631                                           substitute  ("&1 &2 &3 &4 &5 &6 &7 &8 &9",extGdsObj:GetExtGdsValue(ii):AlcCode, extGdsObj:GetExtGdsValue(ii):GdsCode, v-gds-name,
      632                                           extGdsObj:GetExtGdsValue(ii):CliRegIdProd, extGdsObj:GetExtGdsValue(ii):FullNameProd, extGdsObj:GetExtGdsValue(ii):INNProd,
      633                                           extGdsObj:GetExtGdsValue(ii):KPPProd, extGdsObj:GetExtGdsValue(ii):CountryProd, extGdsObj:GetExtGdsValue(ii):CliRegIdImpor).
      634                                       put stream str-alc unformatted
      635                                           substitute  ("&1 &2 &3 &4", extGdsObj:GetExtGdsValue(ii):FullNameImpor, extGdsObj:GetExtGdsValue(ii):INNImpor, extGdsObj:GetExtGdsValue(ii):KPPImpor, extGdsObj:GetExtGdsValue(ii):CountryImpor) skip .
      636                                   end.
      637                               end.
      638                           end.
      639                       end.
      640                       delete object extGdsObj .
      641                   end.
      642                   open query br-marks for each tt-marks  where tt-marks.num = p-num and tt-marks.gds-part-position_ = p-position .
      643                   assign
      644                       v-mark:screen-value = "" .
      645                   assign v-mark .
      646                   run count-marks-parts no-error .
      647                   apply "entry" to v-mark in FRAME Dialog-Frame.
      648               end.
      649               output stream str-alc close.
      650               output stream str-err close.
      651               apply "value-changed" to br-marks IN FRAME Dialog-Frame .
      652           END.
      653     IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      654       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      655     MAIN-BLOCK:
      656     DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      657       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      658       if num-entries (p-mode) > 1
      659       then do:
      660         assign
      661           v-key-rec = entry (2, p-mode)
      662           p-mode = entry (1, p-mode)
      663         .
      664       end.
      665       RUN count-marks-parts no-error .
      666       RUN enable_UI.
      667       WAIT-FOR GO OF FRAME Dialog-Frame.
      668     END.
      669     RUN disable_UI.
      670   PROCEDURE disable_UI :
      671     HIDE FRAME Dialog-Frame.
      672   END PROCEDURE.
      673   PROCEDURE enable_UI :
      674       br-marks:column-resizable in frame dialog-frame = true .
      675       ENABLE Btn_OK Btn_Cancel Btn_del Btn_imp Btn_EXIT v-mark br-marks Btn_excpmarks
      676           WITH FRAME Dialog-Frame.
      677       DISABLE Btn_goods v-qnty-marks v-qnty-goods
      678           WITH FRAME Dialog-Frame.
      679       if p-mode = 'ИЗМЕНЕНИЕ':U then
      680       do:
      681           if p-num = "" and p-position = 0 then
      682           do:
      683               disable Btn_Cancel Btn_del Btn_OK
      684                   WITH FRAME Dialog-Frame.
      685               hide Btn_OK v-qnty-marks v-qnty-goods
      686                   IN FRAME Dialog-Frame.
      687           end.
      688           else
      689           do:
      690               hide Btn_EXIT
      691                   IN FRAME Dialog-Frame.
      692           end.
      693       end.
      694       else
      695       do:
      696           disable Btn_Cancel Btn_del Btn_OK Btn_imp
      697               WITH FRAME Dialog-Frame.
      698           hide Btn_OK
      699               IN FRAME Dialog-Frame.
      700       end.
      701       VIEW FRAME Dialog-Frame.
      702       open query br-marks for each tt-marks  where tt-marks.num = p-num and tt-marks.gds-part-position_ = p-position .
      703       apply "value-changed" to br-marks IN FRAME Dialog-Frame .
      704   END PROCEDURE.
      705   PROCEDURE proc-choose-file :
      706       if search (v-proc-name-err) <> ? then
      707       do:
      708           os-delete value(v-proc-name-err).
      709       end.
      710       if search (v-proc-name-alc) <> ? then
      711       do:
      712           os-delete value(v-proc-name-alc).
      713       end.
      714       DEFINE VARIABLE vCh AS CHARACTER NO-UNDO.
      715       DEFINE VARIABLE vLg AS LOGICAL   NO-UNDO.
      716       def    var      ii  as int.
      717       SYSTEM-DIALOG GET-FILE vCh
      718           MUST-EXIST
      719           TITLE "Выбор файла"
      720           USE-FILENAME UPDATE vLg.
      721       IF vCh <> "" THEN
      722       DO:
      723           output stream str-err to value(v-proc-name-err)  APPEND .
      724           output stream str-alc to value(v-proc-name-alc)  APPEND .
      725           INPUT FROM value(vCh).
      726           REPEAT:
      727               IMPORT v-mark.
      728               find first tt-marks where tt-marks.mark = v-mark no-lock no-error .
      729               if not available tt-marks then
      730               do:
      731                   create tt-marks.
      732                   tt-marks.mark = v-mark .
      733                   run ProcAlcCode  IN THIS-PROCEDURE (input v-mark, output v-alc-code, output l-error, output v-error-lang ) no-error.
      734                   if v-error-lang then
      735                   do:
      736                       put stream str-err unformatted
      737                           "Не корректно считана акцизная марка, акцизная марка содержит не допустимые символы или русские буквы."
      738                           skip .
      739                       v-alc-code = "".
      740                       l-error = yes .
      741                   end.
      742                   else
      743                   do:
      744                       if p-alc-code <> "" and v-alc-code <> p-alc-code then
      745                       do:
      746                           put stream str-err unformatted
      747                               substitute ("Алког. кода &1 не соответствует алког. коду в партии", v-alc-code)
      748                               skip.
      749                           l-error = yes .
      750                       end.
      751                       else
      752                       do:
      753                           extGdsObj = new ExtGds (true).
      754                           extGdsObj:OpenQueryExtGds(0, v-alc-code).
      755                           if extGdsObj:NumBundles = 0 then
      756                           do:
      757                               put stream str-err unformatted
      758                                   substitute ("Для алког. кода &1 не найден товар (не установлено соответствие)", v-alc-code)
      759                                   skip.
      760                               l-error = yes .
      761                               if p-num = "" and p-position = 0 then
      762                               do:
      763                                   find first tt-marks where tt-marks.mark = v-mark no-lock no-error.
      764                                   if not available tt-marks then
      765                                   do:
      766                                       create tt-marks .
      767                                   end.
      768                                   assign
      769                                       tt-marks.mark     = v-mark
      770                                       tt-marks.new_     = true
      771                                       tt-marks.alc-code = v-alc-code .
      772                               end.
      773                           end.
      774                           else
      775                           do:
      776                               find first tt-marks where tt-marks.mark = v-mark no-lock no-error.
      777                               if not available tt-marks then
      778                               do:
      779                                   create tt-marks .
      780                               end.
      781                               assign
      782                                   tt-marks.num                = p-num
      783                                   tt-marks.gds-part-position_ = p-position
      784                                   tt-marks.mark               = v-mark
      785                                   tt-marks.new_               = true .
      786                               tt-marks.gds-code           = extGdsObj:GetExtGdsValue(1):GdsCode .
      787                               tt-marks.alc-code           = v-alc-code .
      788                               tt-marks.prod-full-name     = extGdsObj:GetExtGdsValue(1):FullNameProd .
      789                               tt-marks.impor-full-name    = extGdsObj:GetExtGdsValue(1):FullNameImpor .
      790                               .
      791                               v-gds-code = extGdsObj:GetExtGdsValue(1):GdsCode .
      792                               find first ub.goods where ub.goods.gds-code = v-gds-code no-lock no-error.
      793                               if available ub.goods then tt-marks.gds-name = ub.goods.gds-name .
      794                               if extGdsObj:NumBundles > 1 then tt-marks.flag = yes .
      795                               if p-num = "" and p-position = 0 then
      796                               do:
      797                                   put stream str-alc unformatted
      798                                       substitute  ("Информация по марке: &1:", v-mark) skip .
      799                                   do ii = 1 to extGdsObj:NumBundles:
      800                                       find first ub.goods where ub.goods.gds-code = v-gds-code no-lock no-error.
      801                                       if available ub.goods then v-gds-name = ub.goods.gds-name .
      802                                       put stream str-alc unformatted
      803                                           substitute  ("&1 &2 &3 &4 &5 &6 &7 &8 &9",extGdsObj:GetExtGdsValue(ii):AlcCode, extGdsObj:GetExtGdsValue(ii):GdsCode, v-gds-name,
      804                                           extGdsObj:GetExtGdsValue(ii):CliRegIdProd, extGdsObj:GetExtGdsValue(ii):FullNameProd, extGdsObj:GetExtGdsValue(ii):INNProd,
      805                                           extGdsObj:GetExtGdsValue(ii):KPPProd, extGdsObj:GetExtGdsValue(ii):CountryProd, extGdsObj:GetExtGdsValue(ii):CliRegIdImpor).
      806                                       put stream str-alc unformatted
      807                                           substitute  ("&1 &2 &3 &4", extGdsObj:GetExtGdsValue(ii):FullNameImpor, extGdsObj:GetExtGdsValue(ii):INNImpor, extGdsObj:GetExtGdsValue(ii):KPPImpor, extGdsObj:GetExtGdsValue(ii):CountryImpor) skip .
      808                                   end.
      809                               end.
      810                           end.
      811                       end.
      812                   end.
      813               end.
      814           END.
      815           INPUT CLOSE.
      816           output stream str-alc close.
      817           output stream str-err close.
      818           if l-error then
      819           do:
      820               if search (v-proc-name-err) <> ? then
      821               do:
      822                   run gbl/prnfilen.w
      823                       (input  substitute ("Не все марки были загружены")
      824                       ,input  0
      825                       ,input  v-proc-name-err
      826                       ,input  7
      827                       ,output v-user-action
      828                       ,output v-printed
      829                       ).
      830               end.
      831           end.
      832           else
      833           do:
      834               if p-num = "" and p-position = 0 then
      835               do:
      836                   message substitute("Импорт акцизных марок завершен успешно и выгружены в &2.",v-proc-name-alc)
      837                       view-as alert-box.
      838               end.
      839               else
      840               do:
      841                   message substitute("Импорт акцизных марок завершен успешно.")
      842                       view-as alert-box.
      843               end.
      844           end.
      845           delete object extGdsObj no-error.
      846       END.
      847       else os-delete value(v-proc-name-err).
      848       run count-marks-parts no-error .
      849   END PROCEDURE.
      850   PROCEDURE count-marks-parts :
      851       do
      852           on error undo, return error
      853           :
      854           DEFINE VARIABLE ii as INTEGER no-undo .
      855           open query br-marks for each tt-marks  where tt-marks.num = p-num and tt-marks.gds-part-position_ = p-position .
      856           ii = 0 .
      857           v-qnty-goods = p-qnty-goods .
      858           if p-alc-code <> "" then
      859           do:
      860               for each tt-marks where tt-marks.alc-code = p-alc-code :
      861                   ii = ii + 1 .
      862               end.
      863           end.
      864           else
      865           do:
      866               for each tt-marks :
      867                   ii = ii + 1 .
      868               end.
      869           end.
      870           v-qnty-marks = ii .
      871           display
      872               v-qnty-marks
      873               v-qnty-goods
      874               with frame Dialog-Frame.
      875       end.
      876   END PROCEDURE.
