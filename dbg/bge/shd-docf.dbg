       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define  temp-table temp-host no-undo
       86     field host-code like ub.store.host-code
       87     index xpk host-code
       88   .
       89   define  temp-table temp-obj no-undo
       90     field obj-type  like ub.clients.obj-type
       91     field obj-code  like ub.clients.obj-code
       92     field host-code like ub.store.host-code
       93     field db-num    like ub.clients.db-num
       94     index xpk  obj-type obj-code
       95     index xie1 host-code
       96     index xie2 db-num host-code
       97   .
       98   procedure init-temphost:
       99     define buffer buf_store   for ub.store .
      100     define buffer buf_shop    for ub.shop .
      101     define buffer buf_clients for ub.clients .
      102     define buffer buf_db for ub.db .
      103     define buffer buf_temp-host for temp-host .
      104     define buffer buf_temp-obj for temp-obj .
      105     do
      106     on error undo, return error return-value
      107     :
      108       for each buf_store
      109       on error undo, return error
      110       :
      111         find first buf_temp-host
      112           where buf_temp-host.host-code = buf_store.host-code
      113           no-error .
      114         if not available buf_temp-host
      115         then do:
      116           create buf_temp-host .
      117           assign
      118             buf_temp-host.host-code = buf_store.host-code
      119           .
      120         end.
      121         find first buf_clients no-lock
      122           where buf_clients.obj-type = 'скл':U
      123             and buf_clients.obj-code = buf_store.obj-code
      124           no-error .
      125         if not available buf_clients
      126         then do:
      127           message
      128             "Ошибка при поиске клиента" skip
      129             "Клиент" 'скл':U buf_store.obj-code skip
      130             view-as alert-box error .
      131           undo, return error .
      132         end.
      133         create buf_temp-obj .
      134         assign
      135           buf_temp-obj.obj-type  = 'скл':U
      136           buf_temp-obj.obj-code  = buf_store.obj-code
      137           buf_temp-obj.host-code = buf_store.host-code
      138           buf_temp-obj.db-num    = buf_clients.db-num
      139         .
      140       end.
      141       for each buf_shop
      142       on error undo, return error
      143       :
      144         find first buf_temp-host
      145           where buf_temp-host.host-code = buf_shop.host-code
      146           no-error .
      147         if not available buf_temp-host
      148         then do:
      149           create buf_temp-host .
      150           assign
      151             buf_temp-host.host-code = buf_shop.host-code
      152           .
      153         end.
      154         find first buf_clients no-lock
      155           where buf_clients.obj-type = 'маг':U
      156             and buf_clients.obj-code = buf_shop.obj-code
      157           no-error .
      158         if not available buf_clients then do:
      159           message
      160             "Ошибка при поиске клиента" skip
      161             "Клиент" 'маг':U buf_shop.obj-code skip
      162             view-as alert-box error .
      163           undo, return error .
      164         end.
      165         create buf_temp-obj .
      166         assign
      167           buf_temp-obj.obj-type  = 'маг':U
      168           buf_temp-obj.obj-code  = buf_shop.obj-code
      169           buf_temp-obj.host-code = buf_shop.host-code
      170           buf_temp-obj.db-num    = buf_clients.db-num
      171         .
      172       end.
      173     end.
      174   end.
      175   define variable vss-include-info1 as character format "X(65)" no-undo
      176   initial "@(#)$Workfile$ $Revision$".
      177   DEF STREAM stmXMLOut.
      178   DEF STREAM stmXMLLog.
      179   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   procedure cur-time :
      181      define output parameter p-today as date      no-undo .
      182      define output parameter p-time  as integer   no-undo .
      183     do
      184     on error undo, return error
      185     :
      186       define variable v-date1 as date      no-undo .
      187       define variable v-date2 as date      no-undo .
      188       define variable v-time  as integer   no-undo .
      189       assign
      190         v-date1 = today
      191         v-time  = time
      192         v-date2 = today
      193       .
      194       if v-date1 <> v-date2
      195       then do:
      196         assign
      197           v-date1 = today
      198           v-time  = v-time
      199         .
      200       end.
      201       assign
      202         p-today = v-date1
      203         p-time  = v-time
      204       .
      205     end.
      206   end.
      207   function cur-time-date returns character
      208   :
      209     return string(today, '99/99/9999':U) .
      210   end.
      211   function cur-time-mjd returns decimal
      212   :
      213     define variable v-date as date      no-undo .
      214     define variable v-time as integer   no-undo .
      215     run cur-time in this-procedure
      216       (output v-date
      217       ,output v-time
      218       ) .
      219     return integer(v-date) - 2400002 + (v-time / 86400) .
      220   end.
      221   function cur-time-get-ending-index returns integer
      222   (input p-number as integer
      223   )
      224   :
      225     if p-number < 0
      226     or p-number = ?
      227     then do:
      228       return 1 .
      229     end.
      230     define variable v-rest as integer   no-undo .
      231     assign
      232       p-number = p-number modulo 100
      233     .
      234     if p-number < 20
      235     then do:
      236       assign
      237         v-rest = p-number
      238       .
      239     end.
      240     else do:
      241       assign
      242         v-rest = p-number modulo 10
      243       .
      244     end.
      245     case v-rest :
      246       when 1
      247       then do:
      248         return 2 .
      249       end.
      250       when 2 or
      251       when 3 or
      252       when 4
      253       then do:
      254         return 3 .
      255       end.
      256       otherwise do:
      257         return 1 .
      258       end.
      259     end case .
      260   end.
      261   procedure cur-time-mjd-to-date :
      262      define input  parameter i-mjd-diff as decimal no-undo.
      263      define output parameter o-Date     as date    no-undo.
      264      define output parameter o-Time     as integer no-undo.
      265      define variable v-day-number as integer   no-undo .
      266      if    i-mjd-diff < 0
      267         or i-mjd-diff = ?
      268      then do:
      269         return "?" .
      270      end.
      271      assign
      272         v-day-number = truncate(i-mjd-diff,0).
      273         o-Date = date(v-day-number + 2400002).
      274         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      275     .
      276   end.
      277   function cur-time-mjd-to-string returns character
      278   (input p-mjd-diff as decimal
      279   )
      280   :
      281     define variable v-day-number as integer   no-undo .
      282     define variable v-seconds    as integer   no-undo .
      283     define variable v-hour       as integer   no-undo .
      284     define variable v-min        as integer   no-undo .
      285     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      286     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      287     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      288     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      289     if p-mjd-diff < 0
      290     or p-mjd-diff = ?
      291     then do:
      292       return "?" .
      293     end.
      294     assign
      295       v-day-number = integer(truncate(p-mjd-diff,0))
      296       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      297     .
      298     if v-seconds > 86400
      299     then do:
      300       assign
      301         v-seconds = 86400 - 1
      302       .
      303     end.
      304     if v-seconds < 0
      305     then do:
      306       assign
      307         v-seconds = 0
      308       .
      309     end.
      310     assign
      311       v-hour = truncate(v-seconds / 3600, 0)
      312     .
      313     assign
      314       v-seconds = v-seconds modulo 3600
      315     .
      316     assign
      317       v-min = truncate(v-seconds / 60, 0)
      318     .
      319     assign
      320       v-seconds = v-seconds modulo 60
      321     .
      322     return
      323         (if v-day-number <> 0
      324           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      325           else ""
      326         )
      327       + (if v-day-number <> 0 or v-hour <> 0
      328           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      329           else ""
      330         )
      331       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      332           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      333           else ""
      334         )
      335       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      336       .
      337   end.
      338   function cur-time-string returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      347   end.
      348   function cur-time-string-sec returns character
      349   :
      350     define variable v-date as date      no-undo .
      351     define variable v-time as integer   no-undo .
      352     run cur-time in this-procedure
      353       (output v-date
      354       ,output v-time
      355       ) .
      356     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      357   end.
      358   function cur-time-custom  returns character
      359   (input p-prefix as character
      360   ,input p-date-format as character
      361   ,input p-delimiter as character
      362   ,input p-time-format as character
      363   ,input p-suffix as character
      364   )
      365   :
      366     define variable v-date as date      no-undo .
      367     define variable v-time as integer   no-undo .
      368     run cur-time in this-procedure
      369       (output v-date
      370       ,output v-time
      371       ) .
      372     return
      373       p-prefix
      374       + string(v-date, p-date-format)
      375       + p-delimiter
      376       + string(v-time, p-time-format)
      377       + p-suffix
      378       .
      379   end.
      380   function cur-time-print  returns character
      381   :
      382     define variable v-date as date      no-undo .
      383     define variable v-time as integer   no-undo .
      384     run cur-time in this-procedure
      385       (output v-date
      386       ,output v-time
      387       ) .
      388     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      389   end.
      390   function cur-time-datetime returns datetime
      391   :
      392     define variable v-char as character no-undo .
      393     define variable v-datetime as datetime no-undo .
      394     v-char = cur-time-string().
      395     v-datetime = datetime(v-char).
      396     return  v-datetime.
      397   end.
      398   function cur-time-string-msec returns character
      399   :
      400     define variable v-date as datetime  no-undo .
      401     v-date = now.
      402     return string(v-date) .
      403   end.
      404   define variable vss-include-info3 as character format "X(65)" no-undo
      405   initial "@(#)$Workfile$ $Revision$".
      406   procedure xmlchar-test :
      407   define input parameter p-in-string          as character        no-undo.
      408   define output parameter p-out-string-enc    as character        no-undo.
      409   define output parameter p-out-string-dec    as character        no-undo.
      410   do
      411   on error undo, return error
      412   :
      413          run xmlchar-encode in this-procedure
      414       (
      415             input p-in-string
      416           , output p-out-string-enc
      417       ).
      418          run xmlchar-decode in this-procedure
      419       (
      420             input p-out-string-enc
      421           , output p-out-string-dec
      422       ).
      423   end.
      424   end .
      425   procedure xmlchar-encode :
      426   define input parameter p-in-string      as character        no-undo.
      427   define output parameter p-out-string    as character        no-undo.
      428       define variable v-position      as integer      no-undo.
      429       define variable v-current-char  as character    no-undo.
      430   do
      431   on error undo, return error
      432   :
      433       assign
      434           p-out-string = "":U
      435       .
      436       case p-in-string
      437       :
      438           when ?
      439           then do:
      440               assign
      441                   p-out-string = "?":U
      442               .
      443           end.
      444           when "?":U
      445           then do:
      446               assign
      447                   p-out-string = "&#63;":U
      448               .
      449           end.
      450           otherwise do:
      451               do v-position = 1 to length( p-in-string )
      452               :
      453                   assign
      454                       v-current-char = substring( p-in-string, v-position, 1 )
      455                   .
      456                   case v-current-char
      457                   :
      458                       when "&":U
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "&amp;":U
      462                           .
      463                       end.
      464                       when ">":U
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "&gt;":U
      468                           .
      469                       end.
      470                       when "<":U
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "&lt;":U
      474                           .
      475                       end.
      476                       when "'":U
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "&apos;":U
      480                           .
      481                       end.
      482                       when '"':U
      483                       then do:
      484                           assign
      485                               p-out-string = p-out-string + "&quot;":U
      486                           .
      487                       end.
      488                       when chr(1)
      489                       then do:
      490                           assign
      491                               p-out-string = p-out-string + "":U
      492                           .
      493                       end.
      494                       when chr(2)
      495                       then do:
      496                           assign
      497                               p-out-string = p-out-string + "":U
      498                           .
      499                       end.
      500                       when chr(3)
      501                       then do:
      502                           assign
      503                               p-out-string = p-out-string + "":U
      504                           .
      505                       end.
      506                       when chr(4)
      507                       then do:
      508                           assign
      509                               p-out-string = p-out-string + "":U
      510                           .
      511                       end.
      512                       when chr(5)
      513                       then do:
      514                           assign
      515                               p-out-string = p-out-string + "":U
      516                           .
      517                       end.
      518                       when chr(6)
      519                       then do:
      520                           assign
      521                               p-out-string = p-out-string + "":U
      522                           .
      523                       end.
      524                       when chr(7)
      525                       then do:
      526                           assign
      527                               p-out-string = p-out-string + "":U
      528                           .
      529                       end.
      530                       when chr(8)
      531                       then do:
      532                           assign
      533                               p-out-string = p-out-string + "":U
      534                           .
      535                       end.
      536                       when chr(9)
      537                       then do:
      538                           assign
      539                               p-out-string = p-out-string + "":U
      540                           .
      541                       end.
      542                       when chr(29)
      543                       then do:
      544                           assign
      545                               p-out-string = p-out-string + "":U
      546                           .
      547                       end.
      548                       when chr(10)
      549                       then do:
      550                           assign
      551                               p-out-string = p-out-string + "&#10;":U
      552                           .
      553                       end.
      554                       when chr(13)
      555                       then do:
      556                           assign
      557                               p-out-string = p-out-string + "&#13;":U
      558                           .
      559                       end.
      560                       otherwise do:
      561                           assign
      562                               p-out-string = p-out-string + v-current-char
      563                           .
      564                       end.
      565                   end case.
      566               end.
      567           end.
      568       end case.
      569   end.
      570   end .
      571   procedure xmlchar-encode-1c :
