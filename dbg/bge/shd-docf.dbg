      641                       then do:
      642                           assign
      643                               p-out-string = p-out-string + " ":U
      644                           .
      645                       end.
      646                       when chr(9)
      647                       then do:
      648                           assign
      649                               p-out-string = p-out-string + " ":U
      650                           .
      651                       end.
      652                       when chr(29)
      653                       then do:
      654                           assign
      655                               p-out-string = p-out-string + " ":U
      656                           .
      657                       end.
      658                       when chr(10)
      659                       then do:
      660                           assign
      661                               p-out-string = p-out-string + " ":U
      662                           .
      663                       end.
      664                       when chr(13)
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + " ":U
      668                           .
      669                       end.
      670                       otherwise do:
      671                           assign
      672                               p-out-string = p-out-string + v-current-char
      673                           .
      674                       end.
      675                   end case.
      676               end.
      677           end.
      678       end case.
      679   end.
      680   end .
      681   procedure xmlchar-decode :
      682   define input parameter p-in-string      as character        no-undo.
      683   define output parameter p-out-string    as character        no-undo.
      684       define variable v-position      as integer      no-undo.
      685       define variable v-last-position as integer      no-undo.
      686       define variable v-temp-integer  as integer      no-undo.
      687       define variable v-current-char  as character    no-undo.
      688       define variable v-next-char     as character    no-undo.
      689       define variable v-success       as logical      no-undo.
      690   do
      691   on error undo, return error
      692   :
      693       assign
      694           p-out-string = "":U
      695           v-position   = 0
      696       .
      697       replace-cycle:
      698       do while yes
      699       on error undo, return error
      700       :
      701           assign
      702               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      703           .
      704           if v-last-position <= v-position
      705           then do:
      706               if v-position = 0
      707               then do:
      708                   assign
      709                       p-out-string = p-in-string
      710                   .
      711               end.
      712               else do:
      713                   assign
      714                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      715                   .
      716               end.
      717               leave replace-cycle.
      718           end.
      719           else do:
      720               assign
      721                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      722                   v-position      = v-last-position
      723                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      724               .
      725               if v-current-char = "#":U
      726               then do:
      727                   assign
      728                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      729                   .
      730                   if v-last-position > 0
      731                   then do:
      732                       run xmlchar-read-integer in this-procedure
      733                        (
      734                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      735                           , output v-temp-integer
      736                           , output v-success
      737                       ).
      738                       if v-success = yes
      739                       and v-temp-integer >= 1
      740                       and v-temp-integer <= 255
      741                       then do:
      742                           assign
      743                               p-out-string = p-out-string + chr( v-temp-integer )
      744                               v-position   = v-last-position + 1
      745                           .
      746                       end.
      747                       else do:
      748                           assign
      749                               p-out-string = p-out-string + "&":U
      750                               v-position   = v-position   + 1
      751                           .
      752                       end.
      753                   end.
      754                   else do:
      755                       assign
      756                           p-out-string = p-out-string + "&":U
      757                           v-position   = v-position   + 1
      758                       .
      759                   end.
      760               end.
      761               else do:
      762                   case substring( p-in-string, v-position + 1, 3 )
      763                   :
      764                       when "lt;":U
      765                       then do:
      766                           assign
      767                               p-out-string = p-out-string + "<":U
      768                               v-position   = v-position   + 3
      769                           .
      770                       end.
      771                       when "gt;":U
      772                       then do:
      773                           assign
      774                               p-out-string = p-out-string + ">":U
      775                               v-position   = v-position   + 3
      776                           .
      777                       end.
      778                       otherwise do:
      779                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      780                           then do:
      781                               assign
      782                                   p-out-string = p-out-string + "&":U
      783                                   v-position   = v-position   + 4
      784                               .
      785                           end.
      786                           else do:
      787                               case substring( p-in-string, v-position + 1, 5 )
      788                               :
      789                                   when "quot;":U
      790                                   then do:
      791                                       assign
      792                                           p-out-string = p-out-string + '"':U
      793                                           v-position   = v-position   + 5
      794                                       .
      795                                   end.
      796                                   when "apos;":U
      797                                   then do:
      798                                       assign
      799                                           p-out-string = p-out-string + "'":U
      800                                           v-position   = v-position   + 5
      801                                       .
      802                                   end.
      803                                   otherwise do:
      804                                       assign
      805                                           p-out-string = p-out-string + "&":U
      806                                       .
      807                                   end.
      808                               end case.
      809                           end.
      810                       end.
      811                   end case.
      812               end.
      813           end.
      814       end.
      815   end.
      816   end .
      817   procedure xmlchar-read-integer :
      818   define input parameter p-input-string      as character        no-undo.
      819   define output parameter p-output-integer   as integer          no-undo.
      820   define output parameter p-success       as logical          no-undo.
      821   do
      822   on error undo, return error
      823   :
      824       assign
      825           p-output-integer = integer( p-input-string )
      826       no-error.
      827       if error-status :error
      828       then do:
      829           assign
      830               p-success           = no
      831               p-output-integer    = 0
      832           .
      833       end.
      834       else do:
      835           assign
      836               p-success           = yes
      837           .
      838       end.
      839   end.
      840   end.
      841   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842   procedure strtdate :
      843     define input  parameter p-str         as character no-undo .
      844     define output parameter p-value       as date      no-undo .
      845     define output parameter p-data-valid  as logical   no-undo .
      846     define output parameter p-message     as character no-undo .
      847   do
      848   on error undo, return error return-value
      849   :
      850     define variable v-value       as date      no-undo .
      851     define variable v-i           as integer   no-undo .
      852     define variable v-num         as integer   no-undo .
      853     define variable v-delim       as character no-undo .
      854     define variable v-delim-list  as character no-undo .
      855     define variable v-day         as integer   no-undo .
      856     define variable v-month       as integer   no-undo .
      857     define variable v-year        as integer   no-undo .
      858     define variable v-day-str     as character no-undo .
      859     define variable v-month-str   as character no-undo .
      860     define variable v-year-str    as character no-undo .
      861     assign
      862       p-value       = ?
      863       p-data-valid  = false
      864     .
      865     if p-str = ?
      866     then do:
      867       assign
      868         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      869       .
      870       return .
      871     end.
      872     if p-str = ""
      873     then do:
      874       assign
      875         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      876       .
      877       return .
      878     end.
      879     if length(p-str)  > 10
      880     then do:
      881       assign
      882         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      883       .
      884       return .
      885     end.
      886     assign
      887       v-delim-list = '/,-,.':U
      888     .
      889     _delim:
      890     do v-i = 1 to num-entries( v-delim-list )
      891     :
      892       assign
      893         v-delim = entry( v-i , v-delim-list )
      894         v-num   = num-entries( p-str , v-delim )
      895       .
      896       if v-num <> 3
      897       then do:
      898         assign
      899           v-delim = ''
      900         .
      901       end.
      902       else do:
      903         leave _delim.
      904       end.
      905     end.
      906     if v-delim = ''
      907     then do:
      908       assign
      909         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      910       .
      911       return .
      912     end.
      913     assign
      914       v-day-str   = entry( 1, p-str , v-delim)
      915       v-month-str = entry( 2, p-str , v-delim)
      916       v-year-str  = entry( 3, p-str , v-delim)
      917     .
      918     if  length(v-day-str) > 2   or
      919         length(v-day-str) < 1   or
      920         length(v-month-str) > 2 or
      921         length(v-month-str) < 1 or
      922         (
      923           length(v-year-str) <> 2 and
      924           length(v-year-str) <> 4
      925         )
      926     then do:
      927       assign
      928         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      929       .
      930       return .
      931     end.
      932     if length( v-year-str ) = 2
      933     then do:
      934       assign
      935         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      936       .
      937     end.
      938     assign
      939       v-day   = integer( v-day-str )
      940       v-month = integer( v-month-str)
      941       v-year  = integer( v-year-str)
      942     no-error .
      943     if error-status :error
      944     then do:
      945       assign
      946         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      947       .
      948       return .
      949     end.
      950     if v-day < 1  or
      951        v-day > 31 or
      952        v-month < 1 or
      953        v-month > 12 or
      954        v-year < 0   or
      955        v-year > 5000
      956     then do:
      957       assign
      958         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      959       .
      960       return .
      961     end.
      962     assign
      963       v-value = date( v-month, v-day, v-year )
      964     no-error .
      965     if error-status :error
      966     then do:
      967       assign
      968         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      969       .
      970       return .
      971     end.
      972     assign
      973       p-value       = v-value
      974       p-data-valid  = true
      975     .
      976   end.
      977   end procedure.
