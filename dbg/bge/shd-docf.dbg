        1   block-level on error undo, throw.
        2   define input parameter p-db-num         as integer    no-undo.
        3   define input parameter p-date-from      as date       no-undo.
        4   define input parameter p-date-to        as date       no-undo.
        5   define input parameter p-range          as integer    no-undo.
        6   define input parameter p-obj-list       as character  no-undo.
        7   define input parameter p-doc-type-list  as character  no-undo.
        8   define input parameter p-pay-code       as logical    no-undo.
        9   define input parameter p-cst            as logical    no-undo.
