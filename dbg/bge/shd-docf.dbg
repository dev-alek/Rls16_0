      984   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      985   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      986   define variable v-bge-xml-log-file-name as character    no-undo.
      987   define variable v-bge-xml-dbf-file-name as character    no-undo.
