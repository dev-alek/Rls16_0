     1446      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1447   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1448     run mainmenu_getcntxt in parparentproc
     1449       (output v-cntxt-db-num
     1450       ,output v-cntxt-userid
     1451       ,output v-cntxt-level
     1452       ,output v-cntxt-host-code-obj
     1453       ,output v-cntxt-obj-type
     1454       ,output v-cntxt-obj-code
     1455       ,output v-cntxt-db-num-obj
     1456       ,output v-cntxt-is-admin
     1457       ) .
     1458     RUN enable_UI.
