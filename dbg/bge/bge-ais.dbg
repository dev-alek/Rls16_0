      800   procedure thobjs :
      801      define input        parameter parparentproc     as widget-handle no-undo .
      802      define input        parameter i-bttns           as character     no-undo .
      803      define input        parameter i-list-mode       as character     no-undo.
      804      define input        parameter i-obj-type        as character     no-undo.
      805      define input        parameter i-db-num          as integer       no-undo.
      806      define input        parameter i-host-code       as integer       no-undo.
      807      define input-output parameter p-rid-list        as character     no-undo .
