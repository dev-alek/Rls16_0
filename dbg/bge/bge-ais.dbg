     1463   RUN disable_UI.
     1464   PROCEDURE disable_UI :
     1465     HIDE FRAME Dialog-Frame.
     1466   END PROCEDURE.
     1467   PROCEDURE enable_UI :
     1468     DISPLAY DateSales SelObj DateOrder
     1469         WITH FRAME Dialog-Frame.
     1470     ENABLE b-exit b-quit b-help RECT-1 RECT-2 DateSales e-obj-list SelObj
     1471            DateOrder
     1472         WITH FRAME Dialog-Frame.
     1473     VIEW FRAME Dialog-Frame.
     1474   END PROCEDURE.
     1475   PROCEDURE exp-ais :
     1476   do
     1477     on error undo, return error
     1478     :
     1479       define buffer buf_sys-ctrl      for ub.sys-ctrl .
     1480       define buffer buf_rvs-doc       for ub.rvs-doc .
     1481       define buffer prev_rvs-doc      for ub.rvs-doc .
     1482       define buffer buf_rvs-line      for ub.rvs-line .
     1483       define buffer buf_rvs-line-pump for ub.rvs-line-pump .
     1484       define buffer buf_goods         for ub.goods .
     1485       define buffer buf_trn-doc       for ub.trn-doc .
     1486       define buffer buf_doc-line      for ub.doc-line .
     1487       define buffer buf_place         for ub.place .
     1488       define buffer buf_ord-doc       for ub.ord-doc .
     1489       define buffer buf_ord-line      for ub.ord-line .
     1490       define variable v-curr-db          as integer   no-undo .
     1491       define variable v-delim            as character no-undo .
     1492       define variable v-str-obj-list     as character no-undo .
     1493       define variable v-attr-type        as character no-undo .
     1494       define variable v-attr-delivery    as character no-undo .
     1495       define variable v-attr-notdelivery as character no-undo .
     1496       define variable v-coeff            as decimal   no-undo .
     1497       define variable v-obj              as character no-undo .
     1498       define variable v-action           as character no-undo .
     1499       define variable v-cnt              as integer   no-undo .
     1500       def frame inf
     1501         v-obj    label "Объект" format "x(11)" skip
     1502         v-action label "":U format "x(40)" skip
     1503         v-cnt    label "Записей"
     1504         with view-as dialog-box side-labels 1 columns three-d title "** Разбор пакета".
     1505       find first buf_sys-ctrl no-lock .
     1506       assign
     1507         v-curr-db = buf_sys-ctrl.db-num
     1508       .
     1509       assign
     1510         v-exp-file-name = ".":U + chr(92) + "ais.xml":U
     1511         v-log-file-name = ".":U + chr(92) + "ais.log":U
     1512       .
     1513       output stream ExpStream to value( v-exp-file-name ) .
     1514       output stream LogStream to value( v-log-file-name ) append.
     1515       assign
     1516         file-info :file-name = v-exp-file-name
     1517         v-exp-file-name = file-info :full-pathname
     1518         file-info :file-name = v-log-file-name
     1519         v-log-file-name = file-info :full-pathname
     1520       .
     1521       output stream LogStream close .
     1522       put stream ExpStream unformatted
     1523         space(0) '<?xml version="1.0" encoding="windows-1251"?>':U skip
     1524         space(0) '<root>':U skip
     1525         space(2) '<Header>':U skip
     1526         space(4) '<Manifest>':U skip
     1527         space(6) '<Name>':U v-exp-file-name '</Name>':U skip
     1528         space(6) '<Version> 14.1':U replace( vss-revision + vss-date, '$':U, ' ':U ) '</Version>':U skip
     1529         space(6) '</Manifest>':U skip
     1530         space(2) '</Header>':U skip
     1531         space(2) '<Options>':U skip
     1532         space(4) '<ExportDate>':U cur-time-date() '</ExportDate>':U skip
     1533         space(4) '<ExportTime>':U string( time, 'HH:MM:SS' ) '</ExportTime>':U skip
     1534         space(4) '<DbNum>':U v-curr-db '</DbNum>':U skip
     1535         space(4) '<DateSales>':U string( DateSales, "99/99/9999" ) '</DateSales>':U skip
     1536         space(4) '<DateOrder>':U string( DateOrder, "99/99/9999" ) '</DateOrder>':U skip
     1537         space(4) '<ObjList>':U
     1538       .
     1539       run write-to-log( 'Экспорт данных для АИС ТПС' ) .
     1540       run write-to-log( substitute( 'Версия 14.1 &1', replace( vss-revision + vss-date, '$':U, ' ':U ) )  ) .
     1541       run write-to-log( substitute( 'Начало выгрузки: &1', cur-time-string-sec() ) ) .
     1542       run write-to-log( substitute( 'Текущая БД: &1', v-curr-db ) ) .
     1543       run write-to-log( substitute( 'Дата объема продаж: &1', string( DateSales, "99/99/9999" ) ) ) .
     1544       run write-to-log( substitute( 'Дата прогноза продаж: &1', string( DateOrder, "99/99/9999" ) ) ) .
     1545       assign
     1546         v-delim = '':U
     1547       .
     1548       for each t-obj-list
     1549       on error undo, return error
     1550       :
     1551         assign
     1552           v-str-obj-list = v-str-obj-list + substitute( "&1&2 &3", v-delim, t-obj-list.obj-type, t-obj-list.obj-code )
     1553         .
     1554         if v-delim = '':U then do:
     1555           assign
     1556             v-delim = ',':U
     1557           .
     1558         end.
     1559       end.
     1560       run write-to-log( substitute( 'Объекты (&1): &2', SelObj, v-str-obj-list ) ).
     1561       assign
     1562         v-delim = '':U
     1563       .
     1564       for each t-obj-list
     1565       on error undo, return error
     1566       :
     1567         find first buf_rvs-doc no-lock
     1568           where buf_rvs-doc.obj-type = t-obj-list.obj-type
     1569             and buf_rvs-doc.obj-code = t-obj-list.obj-code
     1570             and buf_rvs-doc.shift-date = DateSales
     1571             and buf_rvs-doc.rvs-type = 'смена':U
     1572           no-error
     1573         .
     1574         if not available buf_rvs-doc then do:
     1575           run write-to-log( substitute( "На объекте &1 &2 нет сменных сверок за дату &3. Расчет по этому объекту невозможен."
     1576                                         ,t-obj-list.obj-type
     1577                                         ,t-obj-list.obj-code
     1578                                         ,DateSales
     1579                                        )
     1580                           ) .
     1581           delete t-obj-list.
     1582         end.
     1583         else do:
     1584           find first buf_rvs-doc no-lock
     1585             where buf_rvs-doc.obj-type = t-obj-list.obj-type
     1586               and buf_rvs-doc.obj-code = t-obj-list.obj-code
     1587               and buf_rvs-doc.shift-date = DateSales
     1588               and buf_rvs-doc.rvs-type = 'смена':U
     1589               and buf_rvs-doc.status_ <> 'факт':U
     1590             no-error
     1591           .
     1592           if available buf_rvs-doc then do:
     1593             run write-to-log( substitute( "На объекте &1 &2 есть незакрытая сверка. Расчет по этому объекту невозможен."
     1594                                           ,t-obj-list.obj-type
     1595                                           ,t-obj-list.obj-code
     1596                                         )
     1597                             ) .
     1598             delete t-obj-list.
     1599           end.
     1600           else do:
     1601             put stream ExpStream unformatted
     1602               v-delim t-obj-list.obj-type ',' t-obj-list.obj-code
     1603             .
     1604             if v-delim = '':U then do:
     1605               assign
     1606                 v-delim = ',':U
     1607               .
     1608             end.
     1609           end.
     1610         end.
     1611       end.
     1612       put stream ExpStream unformatted
     1613         '</ObjList>':U skip
     1614         space(2) '</Options>':U skip
     1615         space(2) '<Body>':U skip
     1616       .
     1617       view frame inf.
     1618       for each t-obj-list no-lock
     1619       on error undo, return error
     1620       :
     1621         assign
     1622           v-obj = t-obj-list.obj-type + " ":U + string( t-obj-list.obj-code )
     1623         .
     1624         run clntattr-value( input t-obj-list.obj-type
     1625                            ,input t-obj-list.obj-code
     1626                            ,input 'delivery':U
     1627                            ,output v-attr-delivery
     1628                            ,output v-attr-type
     1629                           ) no-error.
     1630         if error-status :error then do:
     1631           run write-to-log( substitute( 'Ошибка при чтении атрибута атрибута "Временной интервал возможности доставки" для объекта &1 &2'
     1632                                         ,t-obj-list.obj-type
     1633                                         ,t-obj-list.obj-code
     1634                                       )
     1635                             + chr(10)
     1636                             + return-value + chr(10)
     1637                             + error-status :get-message ( error-status :num-messages ) + chr(10)
     1638                           ) .
     1639         end.
     1640         else do:
     1641           if v-attr-delivery = "":U then do:
     1642             run write-to-log( substitute( 'Для объекта &1 &2 не задан временной интервал возможности доставки'
     1643                                           ,t-obj-list.obj-type
     1644                                           ,t-obj-list.obj-code
     1645                                          )
     1646                             ) .
     1647           end.
     1648         end.
     1649         run clntattr-value( input t-obj-list.obj-type
     1650                            ,input t-obj-list.obj-code
     1651                            ,input 'notdelivery':U
     1652                            ,output v-attr-notdelivery
     1653                            ,output v-attr-type
     1654                           ) no-error.
     1655         if error-status :error then do:
     1656           run write-to-log( substitute( 'Ошибка при чтении атрибута атрибута "Временной интервал, запрещенный к доставке" для объекта &1 &2'
     1657                                         ,t-obj-list.obj-type
     1658                                         ,t-obj-list.obj-code
     1659                                       )
     1660                             + chr(10)
     1661                             + return-value + chr(10)
     1662                             + error-status :get-message ( error-status :num-messages ) + chr(10)
     1663                           ) .
     1664         end.
     1665         else do:
     1666           if v-attr-notdelivery = "":U then do:
     1667             run write-to-log( substitute( 'Для объекта &1 &2 не задан временной интервал, запрещенный к доставке'
     1668                                           ,t-obj-list.obj-type
     1669                                           ,t-obj-list.obj-code
     1670                                          )
     1671                             ) .
     1672           end.
     1673         end.
     1674         put stream ExpStream unformatted
     1675           space(4) '<ObjInfo>':U skip
     1676           space(6) '<ObjType>':U t-obj-list.obj-type '</ObjType>':U skip
     1677           space(6) '<ObjCode>':U t-obj-list.obj-code '</ObjCode>':U skip
     1678           space(6) '<TimeDelivery>':U v-attr-delivery '</TimeDelivery>':U skip
     1679           space(6) '<TimeNotDelivery>':U v-attr-notdelivery '</TimeNotDelivery>':U skip
     1680           space(4) '</ObjInfo>':U skip
     1681         .
     1682         find first buf_rvs-doc no-lock
     1683           where buf_rvs-doc.obj-type = t-obj-list.obj-type
     1684             and buf_rvs-doc.obj-code = t-obj-list.obj-code
     1685             and buf_rvs-doc.shift-date = DateSales
     1686             and buf_rvs-doc.rvs-type = 'смена':U
     1687         .
     1688         for each buf_rvs-line-pump no-lock
     1689           where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     1690         on error undo, return error
     1691         :
     1692           find first buf_goods no-lock
     1693             where buf_goods.gds-code = buf_rvs-line-pump.gds-code
     1694           .
     1695           find first t-goods
     1696             where t-goods.obj-type  = buf_rvs-line-pump.obj-type
     1697               and t-goods.obj-code  = buf_rvs-line-pump.obj-code
     1698               and t-goods.artic     = buf_goods.artic
     1699               and t-goods.prod-type = buf_goods.prod-type
     1700               and t-goods.prod-code = buf_goods.prod-code
     1701             no-error
     1702           .
     1703           if not available t-goods then do:
     1704             create t-goods .
     1705             assign
     1706               t-goods.obj-type  = buf_rvs-line-pump.obj-type
     1707               t-goods.obj-code  = buf_rvs-line-pump.obj-code
     1708               t-goods.artic     = buf_goods.artic
     1709               t-goods.prod-type = buf_goods.prod-type
     1710               t-goods.prod-code = buf_goods.prod-code
     1711               t-goods.gds-name  = buf_goods.gds-name
     1712             .
     1713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1714     (input  buf_goods.gds-code
     1715     ,input  ?
     1716     ,output t-goods.b-code
     1717     )  .
     1718             assign
     1719               v-action = "Расчет объема продаж"
     1720               v-cnt    = 0
     1721             .
     1722             for each buf_trn-doc no-lock
     1723               where buf_trn-doc.obj-type     = buf_rvs-doc.obj-type
     1724                 and buf_trn-doc.obj-code     = buf_rvs-doc.obj-code
     1725                 and buf_trn-doc.shift-date   = DateSales
     1726             on error undo, return error
     1727             :
     1728               if buf_trn-doc.status_ = 'факт':U
     1729                 and ( buf_trn-doc.ext-doc-type = 'es':U
     1730                       or buf_trn-doc.ext-doc-type = 'ee':U
     1731                       or buf_trn-doc.ext-doc-type = 'rs':U
     1732                       or buf_trn-doc.ext-doc-type = 're':U
     1733                     )
     1734               then do:
     1735                 if buf_trn-doc.ext-doc-type = 'rs':U
     1736                    or buf_trn-doc.ext-doc-type = 're':U
     1737                 then do:
     1738                   assign
     1739                     v-coeff = -1
     1740                   .
     1741                 end.
     1742                 else do:
     1743                   assign
     1744                     v-coeff = 1
     1745                   .
     1746                 end.
     1747                 for each buf_doc-line no-lock
     1748                   where buf_doc-line.doc-code  = buf_trn-doc.doc-code
     1749                     and buf_doc-line.prod-type = buf_goods.prod-type
     1750                     and buf_doc-line.prod-code = buf_goods.prod-code
     1751                     and buf_doc-line.artic     = buf_goods.artic
     1752                 on error undo, return error
     1753                 :
     1754                   assign
     1755                     t-goods.SalesVolume = t-goods.SalesVolume + v-coeff * buf_doc-line.fact-qnty
     1756                     t-goods.SalesWeight = t-goods.SalesVolume * buf_doc-line.fact-density
     1757                   .
     1758                   assign
     1759                     v-cnt = v-cnt + 1
     1760                   .
     1761                   display
     1762                     v-obj
     1763                     v-action
     1764                     v-cnt
     1765                     with frame inf .
     1766                 end.
     1767               end.
     1768             end.
     1769             assign
     1770               v-action = "Просмотр заказов"
     1771               v-cnt    = 0
     1772             .
     1773             for each buf_ord-doc no-lock
     1774               where buf_ord-doc.obj-type   = buf_rvs-doc.obj-type
     1775                 and buf_ord-doc.obj-code   = buf_rvs-doc.obj-code
     1776                 and buf_ord-doc.ship-date  = DateOrder
     1777                 and buf_ord-doc.doc-type   = 'ОФ':U
     1778                 and buf_ord-doc.status_   <> 'новый':U
     1779                 and buf_ord-doc.status_   <> 'отказ':U
     1780               ,each buf_ord-line no-lock
     1781               where buf_ord-line.doc-code  = buf_ord-doc.doc-code
     1782                 and buf_ord-line.artic     = buf_goods.artic
     1783                 and buf_ord-line.prod-type = buf_goods.prod-type
     1784                 and buf_ord-line.prod-code = buf_goods.prod-code
     1785             on error undo, return error
     1786             :
     1787               assign
     1788                 t-goods.OrderQnty = t-goods.OrderQnty + buf_ord-line.qnty
     1789               .
     1790               assign
     1791                 v-cnt = v-cnt + 1
     1792               .
     1793               display
     1794                 v-obj
     1795                 v-action
     1796                 v-cnt
     1797                 with frame inf .
     1798             end.
     1799             if v-cnt = 0 then do:
     1800               run write-to-log( substitute( 'На объекте &1 &2 нет ни одной заявки на &3 по товару &4 &5 &6'
     1801                                             ,t-obj-list.obj-type
     1802                                             ,t-obj-list.obj-code
     1803                                             ,string( DateOrder, "99/99/9999":U )
     1804                                             ,buf_goods.artic
     1805                                             ,buf_goods.prod-type
     1806                                             ,buf_goods.prod-code
     1807                                           )
     1808                               ) .
     1809             end.
     1810             assign
     1811               v-action = "Сбор информации по танкам"
     1812               v-cnt    = 0
     1813             .
     1814             for each buf_rvs-line no-lock
     1815               where buf_rvs-line.gds-code = buf_goods.gds-code
     1816                 and buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1817             on error undo, return error
     1818             :
     1819               find first buf_place no-lock
     1820                 where buf_place.obj-type = buf_rvs-line.obj-type
     1821                   and buf_place.obj-code = buf_rvs-line.obj-code
     1822                   and buf_place.pl-code  = buf_rvs-line.pl-code
     1823               .
     1824               create t-goods-tank .
     1825               assign
     1826                 t-goods-tank.obj-type  = buf_rvs-line-pump.obj-type
     1827                 t-goods-tank.obj-code  = buf_rvs-line-pump.obj-code
     1828                 t-goods-tank.artic     = buf_goods.artic
     1829                 t-goods-tank.prod-type = buf_goods.prod-type
     1830                 t-goods-tank.prod-code = buf_goods.prod-code
     1831                 t-goods-tank.TankNum   = buf_place.loc1
     1832                 t-goods-tank.StkTank   = buf_rvs-line.state-measure-qnty
     1833               .
     1834               assign
     1835                 v-cnt = v-cnt + 1
     1836               .
     1837               display
     1838                 v-obj
     1839                 v-action
     1840                 v-cnt
     1841                 with frame inf .
     1842             end.
     1843           end.
     1844           assign
     1845             t-goods.SalesVolCounter = t-goods.SalesVolCounter + buf_rvs-line-pump.state-el-cnt
     1846           .
     1847         end.
     1848         find first prev_rvs-doc no-lock
     1849           where prev_rvs-doc.obj-type = t-obj-list.obj-type
     1850             and prev_rvs-doc.obj-code = t-obj-list.obj-code
     1851             and prev_rvs-doc.shift-date < DateSales
     1852             and prev_rvs-doc.rvs-type = 'смена':U
     1853           no-error
     1854         .
     1855         for each buf_rvs-line-pump no-lock
     1856           where buf_rvs-line-pump.rvs-code = prev_rvs-doc.rvs-code
     1857         on error undo, return error
     1858         :
     1859           find first buf_goods no-lock
     1860             where buf_goods.gds-code = buf_rvs-line-pump.gds-code
     1861           .
     1862           find first t-goods
     1863             where t-goods.obj-type  = buf_rvs-line-pump.obj-type
     1864               and t-goods.obj-code  = buf_rvs-line-pump.obj-code
     1865               and t-goods.artic     = buf_goods.artic
     1866               and t-goods.prod-type = buf_goods.prod-type
     1867               and t-goods.prod-code = buf_goods.prod-code
     1868             no-error
     1869           .
     1870           if available t-goods then do:
     1871             assign
     1872               t-goods.SalesVolCounter = t-goods.SalesVolCounter - buf_rvs-line-pump.state-el-cnt
     1873             .
     1874           end.
     1875         end.
     1876         assign
     1877           v-action = "Вывод информации в файл"
     1878           v-cnt    = ?
     1879         .
     1880         display
     1881           v-obj
     1882           v-action
     1883           v-cnt
     1884           with frame inf .
     1885         for each t-goods no-lock
     1886         on error undo, return error
     1887         :
     1888           put stream ExpStream unformatted
     1889             space(4) '<Good>':U skip
     1890             space(6) '<ObjType>':U t-goods.obj-type '</ObjType>':U skip
     1891             space(6) '<ObjCode>':U t-goods.obj-code '</ObjCode>':U skip
     1892             space(6) '<Artic>':U t-goods.artic '</Artic>':U skip
     1893             space(6) '<ProdType>':U t-goods.prod-type '</ProdType>':U skip
     1894             space(6) '<ProdCode>':U t-goods.prod-code '</ProdCode>':U skip
     1895             space(6) '<BarCode>':U t-goods.b-code '</BarCode>':U skip
     1896             space(6) '<GdsName>':U t-goods.gds-name '</GdsName>':U skip
     1897             space(6) '<SalesVolCounter>':U t-goods.SalesVolCounter '</SalesVolCounter>':U skip
     1898             space(6) '<SalesVolume>':U t-goods.SalesVolume '</SalesVolume>':U skip
     1899             space(6) '<SalesWeight>':U t-goods.SalesWeight '</SalesWeight>':U skip
     1900             space(6) '<OrderQty>':U t-goods.OrderQnty '</OrderQty>':U skip
     1901             space(4) '</Good>':U skip
     1902           .
     1903           for each t-goods-tank no-lock
     1904             where t-goods-tank.obj-type  = t-goods.obj-type
     1905               and t-goods-tank.obj-code  = t-goods.obj-code
     1906               and t-goods-tank.artic     = t-goods.artic
     1907               and t-goods-tank.prod-type = t-goods.prod-type
     1908               and t-goods-tank.prod-code = t-goods.prod-code
     1909           on error undo, return error
     1910           :
     1911             put stream ExpStream unformatted
     1912               space(4) '<Tank>':U skip
     1913               space(6) '<ObjType>':U t-goods-tank.obj-type '</ObjType>':U skip
     1914               space(6) '<ObjCode>':U t-goods-tank.obj-code '</ObjCode>':U skip
     1915               space(6) '<Artic>':U t-goods-tank.artic '</Artic>':U skip
     1916               space(6) '<ProdType>':U t-goods-tank.prod-type '</ProdType>':U skip
     1917               space(6) '<ProdCode>':U t-goods-tank.prod-code '</ProdCode>':U skip
     1918               space(6) '<TankNum>':U t-goods-tank.TankNum '</TankNum>':U skip
     1919               space(6) '<StkTank>':U t-goods-tank.StkTank '</StkTank>':U skip
     1920               space(4) '</Tank>':U skip
     1921             .
     1922           end.
     1923         end.
     1924       end.
     1925       hide frame inf .
     1926       put stream ExpStream unformatted
     1927         space(2) '</Body>':U skip
     1928         space(0) '</root>':U skip
     1929       .
     1930       run write-to-log( substitute( 'Окончание выгрузки: &1', cur-time-string-sec() ) ) .
     1931       output stream ExpStream close.
     1932       message
     1933         "Отчет выведен в файл" v-exp-file-name skip
     1934         "Создан log файл" v-log-file-name
     1935         view-as alert-box information.
     1936     end.
     1937     return .
     1938   END PROCEDURE.
     1939   PROCEDURE write-to-log :
     1940   define input parameter v-message as character no-undo .
     1941     do
     1942     on error undo, return error
     1943     :
     1944       output stream LogStream to value( v-log-file-name ) append.
     1945       put stream LogStream unformatted
     1946         cur-time-string-sec() chr(32) v-cntxt-userid chr(32) chr(32) v-message skip
     1947       .
     1948       output stream LogStream close.
     1949     end.
     1950     return .
     1951   END PROCEDURE.
