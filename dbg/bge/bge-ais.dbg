      817   end.
      818   define stream ExpStream .
      819   define stream LogStream .
      820   define temp-table t-obj-list no-undo
      821     field obj-type  as character
      822     field obj-code  as integer
      823     field host-code as integer
      824     index pi is unique primary obj-type obj-code
      825     index firm host-code
      826   .
      827   define temp-table t-goods no-undo
      828     field obj-type        as character
      829     field obj-code        as integer
      830     field artic           as character
      831     field prod-type       as character
      832     field prod-code       as integer
      833     field b-code          as integer
      834     field gds-name        as character
      835     field SalesVolCounter as decimal
      836     field SalesVolume     as decimal
      837     field SalesWeight     as decimal
      838     field OrderQnty       as decimal
      839     index pi is unique obj-type obj-code artic prod-type prod-code
      840     index goods artic prod-type prod-code
      841   .
      842   define temp-table t-goods-tank no-undo
      843     field obj-type        as character
      844     field obj-code        as integer
      845     field artic           as character
      846     field prod-type       as character
      847     field prod-code       as integer
      848     field TankNum         as character
      849     field StkTank         as decimal
      850     index pi obj-type obj-code artic prod-type prod-code TankNum
      851     index goods artic prod-type prod-code
      852     index tank TankNum
      853   .
      854   define variable v-exp-file-name    as character no-undo .
      855   define variable v-log-file-name    as character no-undo .
      856   DEFINE BUTTON b-exit AUTO-GO
      857        LABEL "&Ввод"
      858        SIZE 10 BY 1
      859        BGCOLOR 8 .
      860   DEFINE BUTTON b-help
      861        LABEL "Помо&щь"
      862        SIZE 10 BY 1
      863        BGCOLOR 8 .
      864   DEFINE BUTTON b-obj DEFAULT
      865        IMAGE-UP FILE "btn-down-arrow":U
      866        IMAGE-DOWN FILE "btn-down-arrow":U
      867        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      868        LABEL "":L
      869        SIZE 2.5 BY 1.08.
      870   DEFINE BUTTON b-quit AUTO-END-KEY
      871        LABEL "&Отмена"
      872        SIZE 10 BY 1
      873        BGCOLOR 8 .
      874   DEFINE VARIABLE e-obj-list AS CHARACTER
      875        VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
      876        SIZE 15.75 BY 3.42 NO-UNDO.
      877   DEFINE VARIABLE DateOrder AS DATE FORMAT "99/99/9999":U
      878        LABEL "прогноза продаж"
      879         VIEW-AS TEXT
      880        SIZE 11 BY .67 NO-UNDO.
      881   DEFINE VARIABLE DateSales AS DATE FORMAT "99/99/9999":U
      882        LABEL "объема продаж"
      883        VIEW-AS FILL-IN
      884        SIZE 11 BY 1 NO-UNDO.
      885   DEFINE VARIABLE SelObj AS CHARACTER INITIAL "Глобально"
      886        VIEW-AS RADIO-SET VERTICAL
      887        RADIO-BUTTONS
      888             "Глобально", "Глобально",
      889   "По фирме", "По фирме",
      890   "Выборочно", "Выборочно"
      891        SIZE 13.25 BY 2.17 NO-UNDO.
      892   DEFINE RECTANGLE RECT-1
      893        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      894        SIZE 35.25 BY 4.
      895   DEFINE RECTANGLE RECT-2
      896        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      897        SIZE 35.25 BY 4.
      898   DEFINE FRAME Dialog-Frame
      899        b-exit AT ROW 1.17 COL 2
      900        b-quit AT ROW 1.17 COL 12
      901        b-help AT ROW 1.17 COL 27
      902        DateSales AT ROW 4 COL 20 COLON-ALIGNED
      903        e-obj-list AT ROW 6.79 COL 20.63 NO-LABEL
      904        SelObj AT ROW 7.96 COL 3.5 NO-LABEL
      905        b-obj AT ROW 9.25 COL 17.38
      906        DateOrder AT ROW 5.29 COL 20 COLON-ALIGNED
      907        "Дата выгрузки:" VIEW-AS TEXT
      908             SIZE 15.75 BY .83 AT ROW 2.79 COL 3
      909        "Выбор объектов:" VIEW-AS TEXT
      910             SIZE 17.25 BY .83 AT ROW 6.79 COL 3
      911        RECT-1 AT ROW 2.46 COL 2
      912        RECT-2 AT ROW 6.46 COL 2
      913        SPACE(1.12) SKIP(0.41)
      914       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      915            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      916            TITLE "Экспорт данных для АИС ТПС"
      917            CANCEL-BUTTON b-quit.
      918   ASSIGN
      919          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      920          FRAME Dialog-Frame:HIDDEN           = TRUE.
      921   ASSIGN
      922          e-obj-list:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      923   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      924   DO:
      925     APPLY "END-ERROR":U TO SELF.
      926   END.
      927   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      928   DO:
      929     assign
      930       DateSales
      931       DateOrder
      932     .
      933     if DateSales = ? then do:
      934       message
      935         substitute( "Не задана дата выгрузки" )
      936         view-as alert-box error
      937       .
      938       apply "entry" to DateSales in frame Dialog-Frame .
      939       return no-apply.
      940     end.
      941     if SelObj = 'Выборочно' then do:
      942       find first t-obj-list no-lock
      943         no-error
      944       .
      945       if not available t-obj-list then do:
      946         message
      947           substitute( "Не задано ни одного объекта." )
      948           view-as alert-box error
      949         .
      950         apply "entry" to SelObj in frame Dialog-Frame .
      951         return no-apply.
      952       end.
      953     end.
      954     run exp-ais in this-procedure .
      955   END.
      956   ON CHOOSE OF b-obj IN FRAME Dialog-Frame
      957   DO:
      958     define variable v-user-select as logical   no-undo .
      959     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      960   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   run userobjs_select-many in this-procedure
      962     (input  parparentproc
      963     ,input  v-cntxt-db-num
      964     ,input  v-cntxt-userid
      965     ,input  v-cntxt-host-code-obj
      966     ,input  v-cntxt-obj-type
      967     ,input  v-cntxt-obj-code
      968     ,output v-user-select
      969     )  .
      970     if v-user-select = true
      971     then do:
      972       for each t-obj-list
      973       on error undo, return no-apply
      974       :
      975         delete t-obj-list .
      976       end.
      977       assign
      978         e-obj-list    = "":U
      979       .
      980       for each buf_userobjs_temp-user-obj
      981       on error undo, return no-apply
      982       :
      983         create t-obj-list .
      984         assign
      985           t-obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
      986           t-obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
      987           e-obj-list = e-obj-list + t-obj-list.obj-type + string( t-obj-list.obj-code ) + " ":U
      988         .
      989       end.
      990       display
      991         e-obj-list
      992         with frame Dialog-Frame
      993       .
      994     end.
      995   END.
      996   ON LEAVE OF DateSales IN FRAME Dialog-Frame
      997   DO:
      998     assign     DateSales   no-error .   if error-status :error then do:     message       error-status :get-message (1)       view-as alert-box error     .     return no-apply .   end.   assign     DateOrder = DateSales + 2   .   display     DateOrder     with frame Dialog-Frame   .
      999   END.
     1000   ON RETURN OF DateSales IN FRAME Dialog-Frame
     1001   DO:
     1002     assign     DateSales   no-error .   if error-status :error then do:     message       error-status :get-message (1)       view-as alert-box error     .     return no-apply .   end.   assign     DateOrder = DateSales + 2   .   display     DateOrder     with frame Dialog-Frame   .
     1003     apply "entry" to SelObj in frame Dialog-Frame .
     1004     return no-apply.
     1005   END.
     1006   ON RETURN OF SelObj IN FRAME Dialog-Frame
     1007   DO:
     1008     apply "choose" to b-exit in frame Dialog-Frame .
     1009   END.
     1010   ON VALUE-CHANGED OF SelObj IN FRAME Dialog-Frame
     1011   DO:
     1012     define buffer buf_db      for ub.db  .
     1013     define buffer buf_clients for ub.clients .
     1014     define variable v-object-available as logical   no-undo .
     1015     assign
     1016       SelObj
     1017     .
     1018     for each t-obj-list
     1019     on error undo, return no-apply
     1020     :
     1021       delete t-obj-list .
     1022     end.
     1023     assign
     1024       e-obj-list = "":U
     1025     .
     1026     case SelObj :
     1027       when "Выборочно" then do:
     1028         enable b-obj with frame Dialog-Frame .
     1029       end.
     1030       when "По фирме" then do:
     1031         disable b-obj with frame Dialog-Frame .
     1032         for each buf_clients no-lock
     1033           where buf_clients.host-code = v-cntxt-host-code-obj
     1034         on error undo, return no-apply
     1035         :
     1036   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
