     1073           on error undo, return no-apply
     1074           :
     1075   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1077     (input  v-cntxt-db-num
     1078     ,input  0
     1079     ,input  v-cntxt-userid
     1080     ,input  buf_clients.obj-type
     1081     ,input  buf_clients.obj-code
     1082     ,output v-object-available
     1083     ) no-error .
     1084             if error-status :error
     1085             then do:
     1086               message
     1087                 vss-workfile vss-revision vss-description skip
     1088                 "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1089                 error-status :get-message(1) skip
     1090                 return-value skip
