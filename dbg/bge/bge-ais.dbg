     1260        )
     1261     or (can-query (self, "read-only")
     1262        and
     1263        self :read-only = false
     1264        )
     1265     then do:
     1266       if self :handle <> focus :handle
     1267       then do:
     1268         apply "entry":u to self .
     1269       end.
     1270       run gbl/getcurdt.p
     1271         (output v-curr-sv-date
     1272         ) .
     1273       assign
     1274         self :screen-value = string(v-curr-sv-date) .
     1275       .
     1276     end.
     1277     return no-apply.
     1278   end.
     1279   on ctrl-b of DateSales in frame Dialog-Frame
     1280   do:
     1281     if (can-query (self, "sensitive")
     1282        and
     1283        self :sensitive = true
     1284        )
     1285     or (can-query (self, "read-only")
     1286        and
     1287        self :read-only = false
     1288        )
     1289     then do:
     1290       if self :handle <> focus :handle
     1291       then do:
     1292         apply "entry":u to self .
     1293       end.
     1294       define variable v-curr-sv-date as date no-undo .
     1295       define variable v-new-sv-date  as date no-undo .
     1296       assign
     1297         v-curr-sv-date = date(self :screen-value) no-error
     1298       .
     1299       if v-curr-sv-date = ?
     1300       then do:
     1301         run gbl/getcurdt.p
     1302           (output v-curr-sv-date
     1303           ) .
     1304       end.
     1305       if v-curr-sv-date <> ?
     1306       then do:
     1307         assign
     1308           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1309         .
     1310         assign
     1311           self :screen-value = string(v-new-sv-date) .
     1312         .
     1313       end.
     1314     end.
     1315     return no-apply .
     1316   end.
     1317   on ctrl-e of DateSales in frame Dialog-Frame
     1318   do:
     1319     if (can-query (self, "sensitive")
     1320        and
     1321        self :sensitive = true
     1322        )
     1323     or (can-query (self, "read-only")
     1324        and
     1325        self :read-only = false
     1326        )
     1327     then do:
     1328       if self :handle <> focus :handle
     1329       then do:
     1330         apply "entry":u to self .
     1331       end.
     1332       define variable v-curr-sv-date as date no-undo .
     1333       define variable v-new-sv-date  as date no-undo .
     1334       assign
     1335         v-curr-sv-date = date(self :screen-value) no-error
     1336       .
     1337       if v-curr-sv-date = ?
     1338       then do:
     1339         run gbl/getcurdt.p
     1340           (output v-curr-sv-date
     1341           ) .
     1342       end.
     1343       if v-curr-sv-date <> ?
     1344       then do:
     1345         run gbl/lastdate.p
     1346           (input  v-curr-sv-date
     1347           ,output v-new-sv-date
     1348           ).
     1349         assign
     1350           self :screen-value = string(v-new-sv-date) .
     1351         .
     1352       end.
     1353     end.
     1354     return no-apply .
     1355   end.
     1356   on ctrl-f of DateSales in frame Dialog-Frame
     1357   do:
     1358     if (can-query (self, "sensitive")
     1359        and
     1360        self :sensitive = true
     1361        )
     1362     or (can-query (self, "read-only")
     1363        and
     1364        self :read-only = false
     1365        )
     1366     then do:
     1367       if self :handle <> focus :handle
     1368       then do:
     1369         apply "entry":u to self .
     1370       end.
     1371       define variable v-ok            as logical   no-undo .
     1372       define variable v-curr-sv-date  as date      no-undo .
     1373       define variable v-description   as character no-undo .
     1374       assign
     1375         v-curr-sv-date = date(self :screen-value) no-error
     1376       .
     1377       if v-curr-sv-date = ?
     1378       then do:
     1379         run gbl/getcurdt.p
     1380           (output v-curr-sv-date
     1381           ) .
     1382       end.
     1383       if v-curr-sv-date <> ?
     1384       then do:
     1385         run gbl/d-inpday.w
     1386           (input ?
     1387           ,input "Выбор даты"
     1388           ,input v-description
     1389           ,input ""
     1390           ,input-output v-curr-sv-date
     1391           ,output v-ok
     1392           ).
     1393         if v-ok = true
     1394         then do:
     1395           assign
     1396             self :screen-value = string(v-curr-sv-date) .
     1397           .
     1398         end.
     1399       end.
     1400     end.
     1401     return no-apply .
     1402   end.
     1403     define MENU m-ed-date10
