     1228        self :read-only = false
     1229        )
     1230     then do:
     1231       assign
     1232         self :screen-value = ?
     1233       .
     1234     end.
     1235     return no-apply.
     1236   end.
     1237   on delete-character of DateSales in frame Dialog-Frame
     1238   do:
     1239     if (can-query (self, "sensitive")
     1240        and
     1241        self :sensitive = true
     1242        )
