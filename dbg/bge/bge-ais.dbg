      395   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   procedure cur-time :
      397      define output parameter p-today as date      no-undo .
      398      define output parameter p-time  as integer   no-undo .
      399     do
      400     on error undo, return error
      401     :
      402       define variable v-date1 as date      no-undo .
      403       define variable v-date2 as date      no-undo .
      404       define variable v-time  as integer   no-undo .
      405       assign
      406         v-date1 = today
      407         v-time  = time
      408         v-date2 = today
      409       .
      410       if v-date1 <> v-date2
      411       then do:
      412         assign
      413           v-date1 = today
      414           v-time  = v-time
      415         .
      416       end.
      417       assign
      418         p-today = v-date1
      419         p-time  = v-time
      420       .
      421     end.
      422   end.
      423   function cur-time-date returns character
      424   :
      425     return string(today, '99/99/9999':U) .
      426   end.
      427   function cur-time-mjd returns decimal
      428   :
      429     define variable v-date as date      no-undo .
      430     define variable v-time as integer   no-undo .
      431     run cur-time in this-procedure
      432       (output v-date
      433       ,output v-time
      434       ) .
      435     return integer(v-date) - 2400002 + (v-time / 86400) .
      436   end.
      437   function cur-time-get-ending-index returns integer
      438   (input p-number as integer
      439   )
      440   :
      441     if p-number < 0
      442     or p-number = ?
      443     then do:
      444       return 1 .
      445     end.
      446     define variable v-rest as integer   no-undo .
      447     assign
      448       p-number = p-number modulo 100
      449     .
      450     if p-number < 20
      451     then do:
      452       assign
      453         v-rest = p-number
      454       .
      455     end.
      456     else do:
      457       assign
      458         v-rest = p-number modulo 10
      459       .
      460     end.
      461     case v-rest :
      462       when 1
      463       then do:
      464         return 2 .
      465       end.
      466       when 2 or
      467       when 3 or
      468       when 4
      469       then do:
      470         return 3 .
      471       end.
      472       otherwise do:
      473         return 1 .
      474       end.
      475     end case .
      476   end.
      477   procedure cur-time-mjd-to-date :
      478      define input  parameter i-mjd-diff as decimal no-undo.
      479      define output parameter o-Date     as date    no-undo.
      480      define output parameter o-Time     as integer no-undo.
      481      define variable v-day-number as integer   no-undo .
      482      if    i-mjd-diff < 0
      483         or i-mjd-diff = ?
      484      then do:
      485         return "?" .
      486      end.
      487      assign
      488         v-day-number = truncate(i-mjd-diff,0).
      489         o-Date = date(v-day-number + 2400002).
      490         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      491     .
      492   end.
      493   function cur-time-mjd-to-string returns character
      494   (input p-mjd-diff as decimal
      495   )
      496   :
      497     define variable v-day-number as integer   no-undo .
      498     define variable v-seconds    as integer   no-undo .
      499     define variable v-hour       as integer   no-undo .
      500     define variable v-min        as integer   no-undo .
      501     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      502     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      503     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      504     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      505     if p-mjd-diff < 0
      506     or p-mjd-diff = ?
      507     then do:
      508       return "?" .
      509     end.
      510     assign
      511       v-day-number = integer(truncate(p-mjd-diff,0))
      512       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      513     .
      514     if v-seconds > 86400
      515     then do:
      516       assign
      517         v-seconds = 86400 - 1
      518       .
      519     end.
      520     if v-seconds < 0
      521     then do:
      522       assign
      523         v-seconds = 0
      524       .
      525     end.
      526     assign
      527       v-hour = truncate(v-seconds / 3600, 0)
      528     .
      529     assign
      530       v-seconds = v-seconds modulo 3600
      531     .
      532     assign
      533       v-min = truncate(v-seconds / 60, 0)
      534     .
      535     assign
      536       v-seconds = v-seconds modulo 60
      537     .
      538     return
      539         (if v-day-number <> 0
      540           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      541           else ""
      542         )
      543       + (if v-day-number <> 0 or v-hour <> 0
      544           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      545           else ""
      546         )
      547       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      548           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      549           else ""
      550         )
      551       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      552       .
      553   end.
      554   function cur-time-string returns character
      555   :
      556     define variable v-date as date      no-undo .
      557     define variable v-time as integer   no-undo .
      558     run cur-time in this-procedure
      559       (output v-date
      560       ,output v-time
      561       ) .
      562     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      563   end.
      564   function cur-time-string-sec returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      573   end.
      574   function cur-time-custom  returns character
      575   (input p-prefix as character
      576   ,input p-date-format as character
      577   ,input p-delimiter as character
      578   ,input p-time-format as character
      579   ,input p-suffix as character
      580   )
      581   :
      582     define variable v-date as date      no-undo .
      583     define variable v-time as integer   no-undo .
      584     run cur-time in this-procedure
      585       (output v-date
      586       ,output v-time
      587       ) .
      588     return
      589       p-prefix
      590       + string(v-date, p-date-format)
      591       + p-delimiter
      592       + string(v-time, p-time-format)
      593       + p-suffix
      594       .
      595   end.
      596   function cur-time-print  returns character
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      605   end.
      606   function cur-time-datetime returns datetime
      607   :
      608     define variable v-char as character no-undo .
      609     define variable v-datetime as datetime no-undo .
      610     v-char = cur-time-string().
      611     v-datetime = datetime(v-char).
      612     return  v-datetime.
      613   end.
      614   function cur-time-string-msec returns character
      615   :
      616     define variable v-date as datetime  no-undo .
      617     v-date = now.
      618     return string(v-date) .
      619   end.
      620   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      621     define variable v-cntxt-db-num        as integer   no-undo .
      622     define variable v-cntxt-userid        as character no-undo .
      623     define variable v-cntxt-level         as character no-undo .
      624     define variable v-cntxt-host-code-obj as integer   no-undo .
      625     define variable v-cntxt-obj-type      as character no-undo .
      626     define variable v-cntxt-obj-code      as integer   no-undo .
      627     define variable v-cntxt-db-num-obj    as integer   no-undo .
      628     define variable v-cntxt-is-admin      as logical   no-undo .
      629   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   define temp-table userobjs_temp-user-obj no-undo
      631     field obj-type as character
      632     field obj-code as integer
      633     index xpk is primary unique obj-type obj-code
      634     .
      635   procedure userobjs_clear :
      636     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      637     do
      638     on error undo, return error return-value
      639     :
      640       for each buf_userobjs_temp-user-obj
      641       on error undo, return error return-value
      642       :
      643         delete buf_userobjs_temp-user-obj .
      644       end.
      645     end.
      646   end .
      647   procedure userobjs_object-count :
      648     define output parameter p-total-count as integer   no-undo .
      649     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      650     do
      651     on error undo, return error return-value
      652     :
      653       assign
      654         p-total-count = 0
      655       .
      656       for each buf_userobjs_temp-user-obj
      657       on error undo, return error return-value
      658       :
      659         assign
      660           p-total-count = p-total-count + 1
      661         .
      662       end.
      663     end.
      664   end.
      665   procedure userobjs_append :
      666      define input  parameter p-obj-type as character no-undo .
      667      define input  parameter p-obj-code as integer   no-undo .
      668     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      669     do
      670     on error undo, return error return-value
      671     :
      672       find first buf_userobjs_temp-user-obj
      673         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      674           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      675         no-error .
      676       if not available buf_userobjs_temp-user-obj
      677       then do:
      678         create buf_userobjs_temp-user-obj .
      679         assign
      680           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      681           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      682         .
      683       end.
      684     end.
      685   end.
      686   procedure userobjs_object-exist :
      687     define output parameter p-object-exist as logical   no-undo .
      688     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      689     do
      690     on error undo, return error return-value
      691     :
      692       find first buf_userobjs_temp-user-obj
      693         no-error .
      694       if not available buf_userobjs_temp-user-obj
      695       then do:
      696         assign
      697           p-object-exist = false
      698         .
      699       end.
      700       else do:
      701         assign
      702           p-object-exist = true
      703         .
      704       end.
      705     end.
      706   end.
      707   procedure userobjs_transfer :
      708     define input  parameter p-callback-handle as handle no-undo .
      709     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      710     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      711     do
      712     on error undo, return error return-value
      713     :
      714       if valid-handle(p-callback-handle) <> true
      715       then do:
      716         message
      717           vss-workfile vss-revision vss-description skip
      718           "Ошибка задания входных параметров" skip
      719           "Неизвестный указатель на процедуру" skip
      720           view-as alert-box error .
      721         undo, return error return-value .
      722       end.
      723       if p-callback-handle :get-signature("userobjs_append") = ""
      724       then do:
      725         message
      726           vss-workfile vss-revision vss-description skip
      727           "Ошибка задания входных параметров" skip
      728           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      729                     ,p-callback-handle :file-name
      730                     ) skip
      731           view-as alert-box error .
      732         undo, return error return-value .
      733       end.
      734       for each buf_userobjs_temp-user-obj
      735       on error undo, return error return-value
      736       :
      737         run userobjs_append in p-callback-handle
      738           (input  buf_userobjs_temp-user-obj.obj-type
      739           ,input  buf_userobjs_temp-user-obj.obj-code
      740           ) .
      741       end.
      742     end.
      743   end procedure.
      744   procedure userobjs_select-one :
      745      define input  parameter parparentproc     as widget-handle no-undo .
      746      define input  parameter p-db-num          as integer   no-undo .
      747      define input  parameter p-user-id         as character no-undo .
      748      define input  parameter p-host-code-obj   as integer   no-undo .
      749      define input  parameter p-obj-type        as character no-undo .
      750      define input  parameter p-obj-code        as integer   no-undo .
      751      define output parameter p-user-select     as logical   no-undo .
      752      define output parameter p-select-obj-type as character no-undo .
      753      define output parameter p-select-obj-code as character no-undo .
      754     do
      755     on error undo, return error return-value
      756     :
      757       run gbl/userobjs.w
      758         (input  parparentproc
      759         ,input  this-procedure :handle
      760         ,input  p-db-num
      761         ,input  p-user-id
      762         ,input  p-host-code-obj
      763         ,input  p-obj-type
      764         ,input  p-obj-code
      765         ,INPUT  "b-sel"
      766         ,output p-user-select
      767         ,output p-select-obj-type
      768         ,output p-select-obj-code
      769         ) .
      770     end.
      771   end.
      772   procedure userobjs_select-many :
      773     define input  parameter parparentproc   as widget-handle no-undo .
      774     define input  parameter p-db-num        as integer   no-undo .
      775     define input  parameter p-user-id       as character no-undo .
      776     define input  parameter p-host-code-obj as integer   no-undo .
      777     define input  parameter p-obj-type      as character no-undo .
      778     define input  parameter p-obj-code      as integer   no-undo .
