     1717   define variable v-db-num as integer no-undo .
     1718   DEFINE VARIABLE v-today as date no-undo .
     1719   DEFINE VARIABLE v-time as integer no-undo .
     1720   define variable v-doc-code as character no-undo .
     1721   define variable fi-pay-code as integer no-undo .
     1722   define buffer buf_fbr-doc for ub.fbr-doc.
     1723   define buffer buf_curr-accnt for ub.curr-accnt.
     1724   do
     1725   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1726   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1727   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1728   :
     1729   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1731     (input  p-obj-type
     1732     ,input  p-obj-code
     1733     ,output v-host-code
     1734     )  .
     1735   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1737     (input  p-obj-type
     1738     ,input  p-obj-code
     1739     ,output v-obj-db-num
     1740     )  .
     1741   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1743     (output v-db-num
     1744     )  .
     1745   if v-obj-db-num <> v-db-num then do:
     1746     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1747                             , chr(10)
     1748                             , p-obj-type
     1749                             , p-obj-code
     1750                             , v-obj-db-num
     1751                             , v-db-num).
     1752   end.
     1753   run cur-time in this-procedure ( output v-today, output v-time).
     1754   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1756     (input  p-obj-type
     1757     ,input  p-obj-code
     1758     ,output v-today
     1759     )  .
     1760   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1762     (input  v-host-code
     1763     ,output v-base-code
     1764     )  .
     1765   find last buf_curr-accnt no-lock
     1766       where buf_curr-accnt.curr-code = v-base-code
     1767         and buf_curr-accnt.exch-date <= v-today use-index pi
     1768   no-error.
     1769   if not available buf_curr-accnt
     1770   then do:
     1771     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1772                                     , string(v-today, "99/99/9999")
     1773                                     , v-base-code).
     1774   end.
     1775   run doc-code in this-procedure (
     1776         input  "main"
     1777       , input  p-obj-type
     1778       , input  p-obj-code
     1779       , input  ?
     1780       , output v-doc-code
     1781   ) no-error.
     1782   if error-status:error
     1783   then do:
     1784     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1785                                   , chr(10)
     1786                                   , error-status:get-message(1)
     1787                                   , return-value ).
     1788   end.
     1789   run trg/chkdocnm.p (
     1790         input v-doc-code
     1791       , input 'fbr-doc':U
     1792       , input ?
     1793   ) no-error.
     1794   if error-status:error
     1795   then do:
     1796     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1797                                   , chr(10)
     1798                                   , error-status:get-message(1)
     1799                                   , return-value ).
     1800   end.
     1801   create buf_fbr-doc.
     1802   assign
     1803   buf_fbr-doc.doc-code  = v-doc-code
     1804   buf_fbr-doc.creid     = p-userid
     1805   buf_fbr-doc.doc-date  = v-today
     1806   buf_fbr-doc.doc-type  = 'производство':U
     1807   buf_fbr-doc.host-code = v-host-code
     1808   buf_fbr-doc.obj-code  = p-obj-code
     1809   buf_fbr-doc.obj-type  = p-obj-type
     1810   buf_fbr-doc.PS        = "@"
     1811   buf_fbr-doc.status_   = 'новый':U
     1812   buf_fbr-doc.user-db-num = v-obj-db-num
     1813   buf_fbr-doc.user-name   = p-userid
     1814   .
     1815   run fbrlib_get-default-pay-code in this-procedure (
     1816         input buf_fbr-doc.obj-type
     1817       , input buf_fbr-doc.obj-code
     1818       , output fi-pay-code
     1819   ).
     1820   buf_fbr-doc.pay-code = fi-pay-code.
     1821   p-recid = recid(buf_fbr-doc).
     1822   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1823   end.
     1824   end procedure.
     1825   procedure fbrlib_get-default-pay-code :
     1826   define input parameter p-obj-type   as character        no-undo.
     1827   define input parameter p-obj-code   as integer          no-undo.
     1828   define output parameter p-pay-code  as integer          no-undo.
     1829   define variable v-host-code as integer no-undo .
     1830   define buffer buf_shop          for ub.shop.
     1831   define buffer buf_store         for ub.store.
     1832   define buffer buf_sysconf       for ub.sysconf.
     1833   do
     1834   for buf_shop
     1835     , buf_store
     1836     , buf_sysconf
     1837   on error undo, return error
     1838   :
     1839     case p-obj-type  :
     1840       when 'маг':U then do:
     1841           find first buf_shop no-lock
     1842                 where buf_shop.obj-code = p-obj-code
     1843           no-error.
     1844           if available buf_shop
     1845           then do:
     1846               assign
     1847                   p-pay-code = buf_shop.fbr-pay
     1848               .
     1849           end.
     1850       end.
     1851       when 'скл':U then do:
     1852           find first buf_store no-lock
     1853                 where buf_store.obj-code = p-obj-code
     1854           no-error.
     1855           if available buf_store
     1856           then do:
     1857               assign
     1858                   p-pay-code = buf_store.fbr-pay
     1859               .
     1860           end.
     1861       end.
     1862     end case.
     1863     if p-pay-code = ?
     1864     or p-pay-code = 0
     1865     then do:
     1866   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1868     (input  p-obj-type
     1869     ,input  p-obj-code
     1870     ,output v-host-code
     1871     )  .
     1872         find first buf_sysconf no-lock
     1873               where buf_sysconf.host-code = v-host-code
     1874         no-error.
     1875         if available buf_sysconf
     1876         then do:
     1877             assign
     1878                 p-pay-code = buf_sysconf.fbr-pay
     1879             .
     1880         end.
     1881     end.
     1882     if p-pay-code = ?
     1883     or p-pay-code = 0
     1884     then do:
     1885   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1887     (input  p-obj-type
     1888     ,input  p-obj-code
     1889     ,output p-pay-code
     1890     )  .
     1891     end.
     1892   end.
     1893   end procedure.
     1894   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1895   do
     1896   on error undo, return error
     1897   :
     1898   define input parameter p-fbr-doc-code as character    no-undo.
     1899       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1900       define variable v-gds-name      as character    no-undo.
     1901       define buffer buf_fbr-doc               for ub.fbr-doc.
     1902       define buffer buf_fbr-line              for ub.fbr-line.
     1903       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1904       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1905       find first buf_fbr-doc no-lock
     1906            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1907       .
     1908       for each buf_temp_fbrlib_recipe
     1909       :
     1910           delete buf_temp_fbrlib_recipe.
     1911       end.
     1912       for each buf_fbr-line no-lock
     1913          where buf_fbr-line.doc-code = p-fbr-doc-code
     1914       :
     1915           find first buf_temp_fbrlib_recipe
     1916                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1917           no-error.
     1918           if not available buf_temp_fbrlib_recipe
     1919           then do:
     1920               create buf_temp_fbrlib_recipe.
     1921               assign
     1922                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1923                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1924               .
     1925           end.
     1926       end.
     1927       for each buf_temp_fbrlib_recipe
     1928       :
     1929           assign
     1930               buf_temp_fbrlib_recipe.count-income                = 0
     1931               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1932               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1933               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1934               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1935               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1936               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1937               buf_temp_fbrlib_recipe.count-write-off             = 0
     1938               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1939               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1940               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1941               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1942               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1943               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1944           .
     1945           for each buf_fbr-line no-lock
     1946              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1947                and buf_fbr-line.trn-type     = 'при':U
     1948                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1949           :
     1950               if ( buf_fbr-line.price-base   = ?
     1951                   or buf_fbr-line.price-rubl = ?
     1952                   or buf_fbr-line.price-base <= 0
     1953                   or buf_fbr-line.price-rubl <= 0 )
     1954               and buf_fbr-line.fact-qnty <> 0
     1955               and buf_fbr-line.rsrv-qnty <> ?
     1956               and buf_fbr-doc.is-free    = no
     1957               then do:
     1958   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1959   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1960     (input  buf_fbr-line.artic
     1961     ,input  buf_fbr-line.prod-type
     1962     ,input  buf_fbr-line.prod-code
     1963     ,output v-gds-name
     1964     ) no-error .
     1965                   if error-status :error
     1966                   then do:
     1967                       assign
     1968                           v-gds-name = ""
     1969                       .
     1970                   end.
     1971                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1972                                                 ,vss-description
     1973                                                 ,buf_fbr-doc.doc-code
     1974                                                 ,chr(10)
     1975                                                 ,buf_fbr-line.recipe-code
     1976                                                 ,buf_fbr-line.artic
     1977                                                 ,v-gds-name).
     1978               end.
     1979               assign
     1980                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1981                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1982                                                                   + buf_fbr-line.fact-qnty
     1983                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1984                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1985               .
     1986               if buf_fbr-line.is-waste = no
     1987               then do:
     1988                   assign
     1989                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1990                                                                       + buf_fbr-line.price-sum-base
     1991                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1992                                                                       + buf_fbr-line.price-sum-rubl
     1993                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1994                                                                       + buf_fbr-line.price-sum-vat-base
     1995                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1996                                                                       + buf_fbr-line.price-sum-vat-rubl
     1997                   .
     1998               end.
     1999           end.
     2000           for each buf_fbr-line no-lock
     2001              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2002                and buf_fbr-line.trn-type     = 'спи':U
     2003                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2004           :
     2005               if ( buf_fbr-line.price-base   = ?
     2006                   or buf_fbr-line.price-rubl = ?
     2007                   or buf_fbr-line.price-base <= 0
     2008                   or buf_fbr-line.price-rubl <= 0 )
     2009               and buf_fbr-line.fact-qnty <> 0
     2010               and buf_fbr-line.rsrv-qnty <> ?
     2011               and buf_fbr-doc.is-free    = no
     2012               and buf_fbr-doc.status_    = 'разрешен':U
     2013               then do:
     2014   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2016     (input  buf_fbr-line.artic
     2017     ,input  buf_fbr-line.prod-type
     2018     ,input  buf_fbr-line.prod-code
     2019     ,output v-gds-name
     2020     ) no-error .
     2021                   if error-status :error
     2022                   then do:
     2023                       assign
     2024                           v-gds-name = ""
     2025                       .
     2026                   end.
     2027                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2028                                                 ,vss-description
     2029                                                 ,buf_fbr-doc.doc-code
     2030                                                 ,chr(10)
     2031                                                 ,buf_fbr-line.recipe-code
     2032                                                 ,buf_fbr-line.artic
     2033                                                 ,v-gds-name).
     2034               end.
     2035               assign
     2036                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     2037                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     2038                                                                   + buf_fbr-line.fact-qnty
     2039                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     2040                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2041               .
     2042               if buf_fbr-line.is-waste = no
     2043               then do:
     2044                   assign
     2045                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2046                                                                       + buf_fbr-line.price-sum-base
     2047                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2048                                                                       + buf_fbr-line.price-sum-rubl
     2049                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2050                                                                       + buf_fbr-line.price-sum-vat-base
     2051                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2052                                                                       + buf_fbr-line.price-sum-vat-rubl
     2053                   .
     2054               end.
     2055           end.
     2056           if buf_fbr-doc.status_    = 'разрешен':U
     2057           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2058           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2059           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2060           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2061               )
     2062           then do:
     2063            undo, return error
     2064               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2065                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2066                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2067                           "Сумма в &9.&4&7&4&4&8&2"
     2068                          , buf_fbr-doc.doc-code
     2069                          , chr(10)
     2070                          , buf_temp_fbrlib_recipe.recipe-code
     2071                          , chr(9)
     2072                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2073                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2074                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2075                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2076                          , "руб"
     2077                          )
     2078              +
     2079              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2080                         "НДС в &7.&1&5&1&1&6&4"
     2081                        ,  chr(9)
     2082                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2083                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2084                        ,chr(10)
     2085                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2086                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2087                        ,"руб"
     2088                        )       .
     2089           end.
     2090       end.
     2091   end.
     2092   end procedure.
     2093   procedure fbrlib-fill-sum-fbr-doc :
     2094   do
     2095   on error undo, return error
     2096   :
     2097   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2098   define input parameter p-mode           as character    no-undo.
     2099       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2100       define buffer buf_fbr-doc           for ub.fbr-doc.
     2101       define buffer buf_fbr-line          for ub.fbr-line.
     2102       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2103       define variable v-in-count          as integer       no-undo.
     2104       define variable v-out-count         as integer       no-undo.
     2105       find first buf_fbr-doc exclusive-lock
     2106            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2107       .
     2108       find first buf_temp_fbrlib_recipe no-error.
     2109       if not available buf_temp_fbrlib_recipe
     2110       then do:
     2111           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2112               input buf_fbr-doc.doc-code
     2113           ) no-error.
     2114           if error-status :error
     2115           then do:
     2116               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2117                                              , vss-description
     2118                                              , chr(10)
     2119                                              , error-status:get-message(1)
     2120                                              , return-value ).
     2121           end.
     2122       end.
     2123       assign
     2124           v-in-count                  = 0
     2125           buf_fbr-doc.in-qnty         = 0
     2126           buf_fbr-doc.in-sale         = 0
     2127           buf_fbr-doc.in-base         = 0
     2128           buf_fbr-doc.in-rubl         = 0
     2129           buf_fbr-doc.in-vat-base     = 0
     2130           buf_fbr-doc.in-vat-rubl     = 0
     2131           v-out-count                 = 0
     2132           buf_fbr-doc.out-qnty        = 0
     2133           buf_fbr-doc.out-sale        = 0
     2134           buf_fbr-doc.out-base        = 0
     2135           buf_fbr-doc.out-rubl        = 0
     2136           buf_fbr-doc.out-vat-base    = 0
     2137           buf_fbr-doc.out-vat-rubl    = 0
     2138       .
     2139       for each buf_temp_fbrlib_recipe
     2140       :
     2141           assign
     2142               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2143               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2144               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2145               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2146               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2147               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2148               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2149               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2150               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2151               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2152               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2153               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2154               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2155               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2156           .
     2157       end.
     2158       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2159       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2160       or p-mode <> 'факт':U
     2161       then do:
     2162           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2163           then do:
     2164               assign
     2165                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2166                                   + string( v-out-count, ">>>,>>9" )
     2167                                   + chr(10) + "Строк исходных товаров : "
     2168                                   + string( v-in-count, ">>>,>>9" )
     2169               .
     2170           end.
     2171       end.
     2172       else do:
     2173         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2174                                       "Сумма списанных товаров в &3 - &4&2" +
     2175                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2176                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2177                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2178                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2179                                       , buf_fbr-doc.doc-code
     2180                                       , chr(10)
     2181                                       , "рублях"
     2182                                       , round( buf_fbr-doc.out-rubl, 2 )
     2183                                       , round( buf_fbr-doc.in-rubl,  2 )
     2184                                       , round( buf_fbr-doc.in-rubl,  2 )
     2185                                       , round( buf_fbr-doc.out-base, 2 )
     2186                                       , round( buf_fbr-doc.in-base,  2 )).
     2187       end.
     2188   end.
     2189   end procedure.
     2190   procedure fbrlib-calc-prices :
     2191   do
     2192   on error undo, return error
     2193   :
     2194   define input parameter p-fbr-line-recid as recid        no-undo.
     2195   define input parameter p-price-obj-type as character    no-undo.
     2196   define input parameter p-price-obj-code as integer      no-undo.
     2197   define output parameter p-current-price as decimal      no-undo.
     2198       define variable v-void          as decimal       no-undo.
     2199       define variable v-void-char     as character     no-undo.
     2200       define variable v-gds-code      as integer       no-undo.
     2201       define variable v-b-code        as integer       no-undo.
     2202       define buffer buf_fbr-doc   for ub.fbr-doc.
     2203       define buffer buf_fbr-line  for ub.fbr-line.
     2204       define buffer buf_gds-prt   for ub.gds-prt.
     2205       define buffer buf_bar-code  for ub.bar-code.
     2206       find first buf_fbr-line no-lock
     2207           where recid( buf_fbr-line ) = p-fbr-line-recid
     2208       .
     2209   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2211     (input  buf_fbr-line.artic
     2212     ,input  buf_fbr-line.prod-type
     2213     ,input  buf_fbr-line.prod-code
     2214     ,output v-gds-code
     2215     ) no-error .
     2216       if error-status :error
     2217       then do:
     2218         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2219                                         ,vss-workfile
     2220                                         ,vss-revision
     2221                                         ,vss-description
     2222                                         ,chr(10)
     2223                                         , error-status:get-message(1)
     2224                                         , return-value
     2225                                         , buf_fbr-line.artic
     2226                                         ).
     2227       end.
     2228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2229     (input  v-gds-code
     2230     ,input  ?
     2231     ,output v-b-code
     2232     ) no-error .
     2233       if error-status :error
     2234       then do:
     2235         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2236                                         ,vss-workfile
     2237                                         ,vss-revision
     2238                                         ,vss-description
     2239                                         ,chr(10)
     2240                                         , error-status:get-message(1)
     2241                                         , return-value
     2242                                         , v-gds-code
     2243                                         ).
     2244       end.
     2245       if buf_fbr-line.is-calc = no
     2246       then do:
     2247   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2248   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2249     (input  p-price-obj-type
     2250     ,input  p-price-obj-code
     2251     ,input  v-b-code
     2252     ,input  0
     2253     ,input  0
     2254     ,output v-void-char
     2255     ,output p-current-price
     2256     ,output v-void
     2257     ,output v-void
     2258     ) no-error .
     2259           if error-status :error
     2260           then do:
     2261             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2262                                             ,vss-workfile
     2263                                             ,vss-revision
     2264                                             ,vss-description
     2265                                             ,chr(10)
     2266                                             , error-status:get-message(1)
     2267                                             , return-value
     2268                                             , v-gds-code
     2269                                             ).
     2270           end.
     2271       end.
     2272       else do:
     2273           assign
     2274               p-current-price = buf_fbr-line.price-sale
     2275           .
     2276       end.
     2277   end.
     2278   end procedure.
     2279   procedure fbrlib-put-in-order-recipe :
     2280   do
     2281   on error undo, return error
     2282   :
     2283   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2284       define variable v-recipe-counter    as integer          no-undo.
     2285       define variable v-recipe-amount     as integer init 0   no-undo.
     2286       define variable v-child-counter     as integer          no-undo.
     2287       define variable v-is-call-cycle     as logical          no-undo.
     2288       define variable v-str as character     no-undo.
     2289       define buffer buf_in_fbr-line       for ub.fbr-line.
     2290       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2291       define buffer buf_fbr-line          for ub.fbr-line.
     2292       define buffer buf_recipe-gds        for ub.recipe-gds.
     2293       define buffer buf_recipe            for ub.recipe.
     2294       for each temp_recipe-childs-qnty
     2295       :
     2296           delete temp_recipe-childs-qnty.
     2297       end.
     2298       for each temp_recipe-childs
     2299       :
     2300           delete temp_recipe-childs.
     2301       end.
     2302       for each temp_recipe-order
     2303       :
     2304           delete temp_recipe-order.
     2305       end.
     2306       for each buf_fbr-line no-lock
     2307          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2308       on error undo, return error
     2309       :
     2310           find first temp_recipe-childs-qnty
     2311                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2312           no-error.
     2313           if not available temp_recipe-childs-qnty
     2314           then do:
     2315               create temp_recipe-childs-qnty.
     2316               assign
     2317                   v-recipe-amount                     = v-recipe-amount + 1
     2318                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2319                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2320                   temp_recipe-childs-qnty.childs-qnty = 0
     2321                   v-child-counter                     = 0
     2322               .
     2323           end.
     2324       end.
     2325       for each buf_in_fbr-line no-lock
     2326          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2327            and buf_in_fbr-line.trn-type = 'спи':U
     2328       on error undo, return error
     2329       :
     2330           for each buf_dress_fbr-line no-lock
     2331              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2332                and buf_dress_fbr-line.trn-type    = 'при':U
     2333                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2334                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2335                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2336           on error undo, return error
     2337           :
     2338               find first buf_recipe no-lock
     2339                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2340               .
     2341               if buf_in_fbr-line.is-comp = yes
     2342               then do:
     2343                   find last temp_recipe-childs-qnty
     2344                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2345                   .
     2346                   assign
     2347                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2348                   .
     2349                   create temp_recipe-childs.
     2350                   assign
     2351                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2352                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2353                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2354                   .
     2355               end.
     2356               else do:
     2357               end.
     2358           end.
     2359       end.
     2360       for each buf_in_fbr-line no-lock
     2361          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2362            and buf_in_fbr-line.trn-type = 'при':U
     2363       on error undo, return error
     2364       :
     2365           find first buf_recipe no-lock
     2366                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2367           no-error.
     2368           if buf_in_fbr-line.is-comp = no
     2369           then do:
     2370           end.
     2371           else do:
     2372               for each buf_recipe-gds no-lock
     2373               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2374               :
     2375                   for each buf_fbr-line no-lock
     2376                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2377                       and buf_fbr-line.trn-type    = 'при':U
     2378                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2379                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2380                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2381                   on error undo, return error
     2382                   :
     2383                       find first buf_recipe no-lock
     2384                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2385                       .
     2386                       if buf_recipe.recipe-type = 'разделка':U
     2387                       then do:
     2388                       end.
     2389                       else do:
     2390                           find last temp_recipe-childs-qnty
     2391                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2392                           .
     2393                           assign
     2394                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2395                           .
     2396                           create temp_recipe-childs.
     2397                           assign
     2398                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2399                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2400                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2401                           .
     2402                       end.
     2403                   end.
     2404               end.
     2405           end.
     2406       end.
     2407       for each temp_recipe-order
     2408       on error undo, return error
     2409       :
     2410           delete temp_recipe-order.
     2411       end.
     2412       assign
     2413           v-fbrlib-recipe-order = 0
     2414       .
     2415       do v-recipe-counter = 1 to v-recipe-amount
     2416       on error undo, return error
     2417       :
     2418           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2419                 input v-recipe-counter
     2420               , input 0
     2421               , output v-is-call-cycle
     2422           ).
     2423           if v-is-call-cycle = yes
     2424           then do:
     2425               message
     2426                       "Достигнут максимальный уровень вложенности рецептов."
     2427                   skip(1)
     2428                   skip "Невозможно упорядочить рецепты."
     2429                   skip(1)
     2430                   skip "Необходимо изменить структуру рецептов,"
     2431                   skip "используемых при формировании"
     2432                   skip "данного документа производства."
     2433               view-as alert-box error
     2434               title "Невозможно рассчитать документ производства".
     2435               for each temp_recipe-childs-qnty
     2436               :
     2437                   delete temp_recipe-childs-qnty.
     2438               end.
     2439               for each temp_recipe-childs
     2440               :
     2441                   delete temp_recipe-childs.
     2442               end.
     2443               for each temp_recipe-order
     2444               :
     2445                   delete temp_recipe-order.
     2446               end.
     2447               for each temp_recipe-order
     2448               on error undo, return error
     2449               :
     2450                   delete temp_recipe-order.
     2451               end.
     2452               for each temp_fbrlib_recipe
     2453               on error undo, return error
     2454               :
     2455                   delete temp_recipe-order.
     2456               end.
     2457               undo, return error.
     2458           end.
     2459       end.
     2460   end.
     2461   end procedure.
     2462   procedure fbrlib-add-recipe-in-tmp-order :
     2463   do
     2464   on error undo, return error
     2465   :
     2466   define input parameter p-order              as integer      no-undo.
     2467   define input parameter p-call-counter       as integer      no-undo.
     2468   define output parameter p-is-call-cycle     as logical      no-undo.
     2469       define variable v-nodes-counter     as integer       no-undo.
     2470       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2471       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2472       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2473       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2474       assign
     2475           p-call-counter = p-call-counter + 1
     2476       .
     2477       if p-call-counter > 50
     2478       then do:
     2479           assign
     2480               p-is-call-cycle = yes
     2481           .
     2482       end.
     2483       else do:
     2484           find first buf_temp_recipe-childs-qnty
     2485                where buf_temp_recipe-childs-qnty.order = p-order
     2486           .
     2487           find first buf_temp_recipe-order
     2488                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2489           no-error.
     2490           if not available buf_temp_recipe-order
     2491           then do:
     2492               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2493               :
     2494                   find first buf_temp_recipe-childs
     2495                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2496                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2497                   .
     2498                   find first buf_c_temp_recipe-childs-qnty
     2499                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2500                   .
     2501                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2502                         input buf_c_temp_recipe-childs-qnty.order
     2503                       , input p-call-counter
     2504                       , output p-is-call-cycle
     2505                   ).
     2506                   if p-is-call-cycle = yes
     2507                   then do:
     2508                       return.
     2509                   end.
     2510               end.
     2511               assign
     2512                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2513               .
     2514               create buf_temp_recipe-order.
     2515               assign
     2516                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2517                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2518               .
     2519           end.
     2520       end.
     2521   end.
     2522   end procedure.
     2523   procedure fbrlib-get-trn-type :
     2524   define input parameter p-recipe-code    as character    no-undo.
     2525   define input parameter p-goods-recid    as recid        no-undo.
     2526   define input parameter p-is-integration as logical      no-undo.
     2527   define output parameter p-is-comp       as logical      no-undo.
     2528   define output parameter p-trn-type      as character    no-undo.
     2529   define buffer buf_recipe    for ub.recipe.
     2530   define buffer buf_goods     for ub.goods.
     2531   do
     2532   for buf_recipe
     2533     , buf_goods
     2534   on error undo, return error
     2535   :
     2536       find first buf_goods no-lock
     2537            where recid( buf_goods ) = p-goods-recid
     2538       .
     2539       find first buf_recipe no-lock
     2540            where buf_recipe.recipe-code = p-recipe-code
     2541       no-error.
     2542       if not available buf_recipe
     2543       then do:
     2544           assign
     2545               p-is-comp = no
     2546               p-trn-type = "":U
     2547           .
     2548           undo, return.
     2549       end.
     2550       if  buf_recipe.artic        = buf_goods.artic
     2551       and buf_recipe.prod-type    = buf_goods.prod-type
     2552       and buf_recipe.prod-code    = buf_goods.prod-code
     2553       then do:
     2554           assign
     2555               p-is-comp = yes
     2556           .
     2557       end.
     2558       else do:
     2559           assign
     2560               p-is-comp = no
     2561           .
     2562       end.
     2563       case buf_recipe.recipe-type
     2564       :
     2565           when 'производство':U
     2566           then do:
     2567               if p-is-comp = yes
     2568               then do:
     2569                   assign
     2570                       p-trn-type = 'при':U
     2571                   .
     2572               end.
     2573               else do:
     2574                   assign
     2575                       p-trn-type = 'спи':U
     2576                   .
     2577               end.
     2578           end.
     2579           when 'альтернатива':U
     2580           then do:
     2581               if p-is-comp = yes
     2582               then do:
     2583                   assign
     2584                       p-trn-type = 'при':U
     2585                   .
     2586               end.
     2587               else do:
     2588                   assign
     2589                       p-trn-type = 'спи':U
     2590                   .
     2591               end.
     2592           end.
     2593           when 'разделка':U
     2594           then do:
     2595               if p-is-comp = no
     2596               then do:
     2597                   assign
     2598                       p-trn-type = 'при':U
     2599                   .
     2600               end.
     2601               else do:
     2602                   assign
     2603                       p-trn-type = 'спи':U
     2604                   .
     2605               end.
     2606           end.
     2607           when 'комплектация':U
     2608           then do:
     2609               if p-is-integration = ?
     2610               then do:
     2611                   message
     2612                       "Выберите тип операции по рецепту комплектации:"
     2613                       skip (2) "YES - комплектация"
     2614                       skip     "NO - разукомплектация"
     2615                   view-as alert-box question
     2616                   buttons YES-NO
     2617                   update p-is-integration.
     2618               end.
     2619               if p-is-integration = yes
     2620               then do:
     2621                   if p-is-comp = yes
     2622                   then do:
     2623                       assign
     2624                           p-trn-type = 'при':U
     2625                       .
     2626                   end.
     2627                   else do:
     2628                       assign
     2629                           p-trn-type = 'спи':U
     2630                       .
     2631                   end.
     2632               end.
     2633               else do:
     2634                   if p-is-comp = yes
     2635                   then do:
     2636                       assign
     2637                           p-trn-type = 'спи':U
     2638                       .
     2639                   end.
     2640                   else do:
     2641                       assign
     2642                           p-trn-type = 'при':U
     2643                       .
     2644                   end.
     2645               end.
     2646           end.
     2647       end case.
     2648   end.
     2649   end procedure.
     2650   procedure fbrlib-get-mark :
     2651   define input parameter p-recipe-code    as character    no-undo.
     2652   define output parameter p-mark          as logical    no-undo.
     2653   define buffer buf_goods-attr     for ub.goods-attr.
     2654   define buffer buf_recipe-gds for ub.recipe-gds .
     2655       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2656            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2657                                               buf_goods-attr.attr-code = 'mark-type':U:
     2658            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2659               p-mark = true .
     2660               return .
     2661            end.
     2662       end.
     2663   end procedure.
     2664   procedure fbrlib-check-temp-tables :
     2665   do
     2666   on error undo, return error
     2667   :
     2668   define input parameter p-title  as character    no-undo.
     2669       define variable v-str               as character        no-undo.
     2670       assign
     2671           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2672       .
     2673       for each temp_recipe-childs-qnty
     2674       on error undo, return error
     2675       :
     2676           assign
     2677               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2678                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2679                       + "   " + string( temp_recipe-childs-qnty.order )
     2680                       + chr(10)
     2681           .
     2682       end.
     2683       assign
     2684           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2685       .
     2686       for each temp_recipe-childs
     2687       on error undo, return error
     2688       :
     2689           assign
     2690               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2691                       + "   " + string( temp_recipe-childs.child-code )
     2692                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2693                       + chr(10)
     2694           .
     2695       end.
     2696       assign
     2697           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2698       .
     2699       for each temp_recipe-order
     2700       on error undo, return error
     2701       :
     2702           assign
     2703               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2704                       + "   " + string( temp_recipe-order.order )
     2705                       + chr(10)
     2706           .
     2707       end.
     2708       assign
     2709           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2710       .
     2711       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2712       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2713       for each temp_fbrlib_recipe
     2714       on error undo, return error
     2715       :
     2716           assign
     2717               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2718                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2719                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2720                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2721                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2722                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2723                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2724                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2725                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2726                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2727                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2728                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2729                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2730                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2731                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2732                       + chr(10)
     2733           .
     2734           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2735       end.
     2736   end.
     2737   end procedure.
     2738   procedure fbrlib-s-coeff-value :
     2739   define input  parameter p-gds-code    as integer        no-undo.
     2740   define input  parameter p-date        as date           no-undo.
     2741   define input  parameter p-obj-type    as character      no-undo.
     2742   define input  parameter p-obj-code    as integer        no-undo.
     2743   define output parameter p-coeff-value as decimal        no-undo.
     2744   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2745       define variable v-date          as date         no-undo.
     2746       define variable v-host-code     as integer      no-undo.
     2747       define buffer buf_goods       for ub.goods.
     2748       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2749       define buffer buf_clients     for ub.clients.
     2750       define buffer buf_s-coeff     for ub.s-coeff.
     2751   do
     2752   for buf_goods
     2753     , buf_fbr-gds-obj
     2754     , buf_clients
     2755     , buf_s-coeff
     2756   on error undo, return error return-value
     2757   :
     2758       find first buf_goods no-lock
     2759            where buf_goods.gds-code = p-gds-code
     2760       no-error .
     2761       if not available buf_goods
     2762       then do:
     2763          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2764       end.
     2765       find first buf_clients no-lock
     2766            where buf_clients.obj-type = p-obj-type
     2767              and buf_clients.obj-code = p-obj-code
     2768       no-error.
     2769       if not available buf_clients
     2770       then do:
     2771          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2772       end.
     2773       assign
     2774           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2775       .
     2776       find first buf_fbr-gds-obj no-lock
     2777            where buf_fbr-gds-obj.gds-code = p-gds-code
     2778              and buf_fbr-gds-obj.obj-type = p-obj-type
     2779              and buf_fbr-gds-obj.obj-code = p-obj-code
     2780       no-error.
     2781       if not available buf_fbr-gds-obj
     2782       or buf_fbr-gds-obj.is-season = no
     2783       then do:
     2784           assign
     2785               p-coeff-value = 0
     2786           .
     2787           return.
     2788       end.
     2789   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2791     (input  p-obj-type
     2792     ,input  p-obj-code
     2793     ,output v-host-code
     2794     )  .
     2795       find last buf_s-coeff no-lock
     2796           where buf_s-coeff.gds-code = p-gds-code
     2797             and buf_s-coeff.host-code = v-host-code
     2798             and buf_s-coeff.obj-type = p-obj-type
     2799             and buf_s-coeff.obj-code = p-obj-code
     2800             and buf_s-coeff.s-date <= v-date
     2801       no-error.
     2802       if available buf_s-coeff
     2803       then do:
     2804           assign
     2805               p-coeff-value = buf_s-coeff.coeff-value
     2806           .
     2807           return.
     2808       end.
     2809       find last buf_s-coeff no-lock
     2810           where buf_s-coeff.gds-code = p-gds-code
     2811             and buf_s-coeff.host-code = v-host-code
     2812             and buf_s-coeff.obj-type = "":U
     2813             and buf_s-coeff.obj-code = 0
     2814             and buf_s-coeff.s-date <= v-date
     2815       no-error.
     2816       if available buf_s-coeff
     2817       then do:
     2818           assign
     2819               p-coeff-value = buf_s-coeff.coeff-value
     2820           .
     2821           return.
     2822       end.
     2823       find last buf_s-coeff no-lock
     2824           where buf_s-coeff.gds-code = p-gds-code
     2825             and buf_s-coeff.host-code = 0
     2826             and buf_s-coeff.obj-type = "":U
     2827             and buf_s-coeff.obj-code = 0
     2828             and buf_s-coeff.s-date <= v-date
     2829       no-error.
     2830       if available buf_s-coeff
     2831       then do:
     2832           assign
     2833               p-coeff-value = buf_s-coeff.coeff-value
     2834           .
     2835       end.
     2836       else do:
     2837           assign
     2838               p-coeff-value = 0
     2839           .
     2840       end.
     2841   end.
     2842   end procedure.
     2843   procedure fbrlib_create-fbr-recipe-gds :
     2844   define input parameter p-doc-code         as character      no-undo.
     2845   define input parameter p-recipe-code      as character      no-undo.
     2846   define input parameter p-prod-type        as character      no-undo.
     2847   define input parameter p-prod-code        as integer        no-undo.
     2848   define input parameter p-artic            as character      no-undo.
     2849   define input parameter p-gds-code         as integer        no-undo.
     2850   define input parameter p-is-waste         as logical        no-undo.
     2851   define input parameter p-proc-number      as integer        no-undo.
     2852   define input parameter p-obj-date         as date           no-undo.
     2853   define input parameter p-obj-type         as character      no-undo.
     2854   define input parameter p-obj-code         as integer        no-undo.
     2855   define input parameter p-calc-method      as decimal        no-undo.
     2856   define input parameter p-coeff-waste      as decimal        no-undo.
     2857   define input parameter p-orig-qnty        as decimal        no-undo.
     2858   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2859       define variable v-coeff-season  as decimal      no-undo.
     2860       define variable v-void-decimal  as decimal      no-undo.
     2861       define variable v-void-integer  as integer      no-undo.
     2862       define variable v-recipe-type   as character    no-undo.
     2863       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2864       define buffer buf_goods             for ub.goods.
     2865       define buffer buf_recipe            for ub.recipe.
     2866   do
     2867   for buf_fbr-recipe-gds
     2868     , buf_recipe
     2869     , buf_goods
     2870   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2871   :
     2872       find first buf_fbr-recipe-gds exclusive-lock
     2873            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2874              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2875              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2876              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2877              and buf_fbr-recipe-gds.artic       = p-artic
     2878       no-error.
     2879       if not available buf_fbr-recipe-gds
     2880       then do:
     2881           create buf_fbr-recipe-gds.
     2882           assign
     2883               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2884               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2885               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2886               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2887               buf_fbr-recipe-gds.artic              = p-artic
     2888               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2889               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2890               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2891               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2892               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2893           .
     2894           find first buf_goods no-lock
     2895                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2896                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2897                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2898           .
     2899           run fbrlib-s-coeff-value in this-procedure (
     2900                 input buf_goods.gds-code
     2901               , input p-obj-date
     2902               , input p-obj-type
     2903               , input p-obj-code
     2904               , output v-coeff-season
     2905           ) no-error.
     2906           if error-status:error
     2907           then do:
     2908               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2909           end.
     2910           assign
     2911               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2912               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2913               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2914           .
     2915           run fbrlib-get-recipe-type in this-procedure (
     2916                 input buf_fbr-recipe-gds.doc-code
     2917               , input buf_fbr-recipe-gds.recipe-code
     2918               , output v-recipe-type
     2919           ).
     2920           if v-recipe-type <> 'производство':U
     2921           then do:
     2922               assign
     2923                   buf_fbr-recipe-gds.coeff-value  = 0
     2924                   buf_fbr-recipe-gds.coeff-waste  = 0
     2925                   buf_fbr-recipe-gds.calc-method  = 1
     2926                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2927               .
     2928           end.
     2929           else do:
     2930               run fbrlib-calc-brutto in this-procedure (
     2931                     input v-recipe-type
     2932                   , input buf_fbr-recipe-gds.qnty
     2933                   , input buf_fbr-recipe-gds.coeff-value
     2934                   , input buf_fbr-recipe-gds.coeff-waste
     2935                   , input 0
     2936                   , input 3
     2937                   , output v-void-decimal
     2938                   , output v-void-decimal
     2939                   , output buf_fbr-recipe-gds.brutto-qnty
     2940                   , output v-void-integer
     2941               ).
     2942               assign
     2943                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2944               .
     2945               run fbrlib-calc-brutto in this-procedure (
     2946                     input v-recipe-type
     2947                   , input buf_fbr-recipe-gds.qnty
     2948                   , input buf_fbr-recipe-gds.coeff-value
     2949                   , input buf_fbr-recipe-gds.coeff-waste
     2950                   , input buf_fbr-recipe-gds.brutto-qnty
     2951                   , input buf_fbr-recipe-gds.calc-method
     2952                   , output buf_fbr-recipe-gds.qnty
     2953                   , output v-void-decimal
     2954                   , output v-void-decimal
     2955                   , output v-void-integer
     2956               ).
     2957           end.
     2958       end.
     2959   end.
     2960   end procedure.
     2961   procedure fbrlib-set-default-recipe :
     2962   define input parameter p-obj-type   as character    no-undo.
     2963   define input parameter p-obj-code   as integer      no-undo.
     2964   define input parameter p-gds-code   as integer      no-undo.
     2965       define variable v-artic             as character    no-undo.
     2966       define variable v-prod-type         as character    no-undo.
     2967       define variable v-prod-code         as character    no-undo.
     2968       define variable v-recipe-code       as character    no-undo.
     2969       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2970       define variable v-recipe-found      as logical      no-undo.
     2971       define buffer buf_recipe        for ub.recipe.
     2972       define buffer buf_other_recipe  for ub.recipe.
     2973       define buffer buf_goods         for ub.goods.
     2974       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2975   do
     2976   for buf_recipe
     2977     , buf_goods
     2978     , buf_fbr-gds-obj
     2979   on error undo, return error
     2980   :
     2981       find first buf_goods no-lock
     2982            where buf_goods.gds-code = p-gds-code
     2983       .
     2984       run fbrlib-get-obj-recipe in this-procedure (
     2985             input p-obj-type
     2986           , input p-obj-code
     2987           , input p-gds-code
     2988           , output v-recipe-code
     2989       ).
     2990       if v-recipe-code <> ""
     2991       then do:
     2992           find first buf_recipe no-lock
     2993               where buf_recipe.recipe-code = v-recipe-code
     2994           no-error.
     2995           if not available buf_recipe
     2996           then do:
     2997               assign
     2998                   v-recipe-code = ""
     2999               .
     3000           end.
     3001       end.
     3002       if v-recipe-code = ""
     3003       then do:
     3004           find first buf_fbr-gds-obj exclusive-lock
     3005                where buf_fbr-gds-obj.obj-type = p-obj-type
     3006                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3007                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3008           no-error.
     3009           if not available buf_fbr-gds-obj
     3010           then do:
     3011               run ref/fgdsobj1.p (
     3012                     input-output v-fbr-gds-obj-recid
     3013                   , input 'ДОБАВЛЕНИЕ':U
     3014                   , input no
     3015                   , input p-gds-code
     3016                   , input p-obj-type
     3017                   , input p-obj-code
     3018                   , input 0
     3019                   , input ""
     3020                   , input 0
     3021                   , input no
     3022                   , input no
     3023                   , input no
     3024                   , input no
     3025                   , input no
     3026                   , input no
     3027               ) no-error.
     3028               if error-status:error
     3029               then do:
     3030                   message
     3031                           vss-workfile vss-revision vss-description
     3032                       skip "Ошибка изменения атрибутов товара на объекте"
     3033                       skip return-value
     3034                       skip trim(error-status :get-message(1))
     3035                               trim(error-status :get-message(2))
     3036                               trim(error-status :get-message(3))
     3037                   view-as alert-box error.
     3038                   undo, return error .
     3039               end.
     3040               find first buf_fbr-gds-obj exclusive-lock
     3041                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3042               .
     3043           end.
     3044           assign
     3045               v-recipe-found = no
     3046           .
     3047           for first buf_recipe no-lock
     3048               where buf_recipe.obj-type    = p-obj-type
     3049                 and buf_recipe.obj-code    = p-obj-code
     3050                 and buf_recipe.artic       = buf_goods.artic
     3051                 and buf_recipe.prod-type   = buf_goods.prod-type
     3052                 and buf_recipe.prod-code   = buf_goods.prod-code
     3053                 and buf_recipe.recipe-type = 'производство':U
     3054                 or (
     3055                     buf_recipe.obj-type    = ""
     3056                 and buf_recipe.obj-code    = 0
     3057                 and buf_recipe.artic       = buf_goods.artic
     3058                 and buf_recipe.prod-type   = buf_goods.prod-type
     3059                 and buf_recipe.prod-code   = buf_goods.prod-code
     3060                 and buf_recipe.recipe-type = 'производство':U
     3061                     )
     3062           :
     3063               assign
     3064                   v-recipe-found = yes
     3065                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3066               .
     3067           end.
     3068           if v-recipe-found = no
     3069           then do:
     3070               for first buf_recipe no-lock
     3071                   where buf_recipe.obj-type    = p-obj-type
     3072                     and buf_recipe.obj-code    = p-obj-code
     3073                     and buf_recipe.artic       = buf_goods.artic
     3074                     and buf_recipe.prod-type   = buf_goods.prod-type
     3075                     and buf_recipe.prod-code   = buf_goods.prod-code
     3076                     and buf_recipe.recipe-type <> 'альтернатива':U
     3077                     or (
     3078                         buf_recipe.obj-type    = ""
     3079                     and buf_recipe.obj-code    = 0
     3080                     and buf_recipe.artic       = buf_goods.artic
     3081                     and buf_recipe.prod-type   = buf_goods.prod-type
     3082                     and buf_recipe.prod-code   = buf_goods.prod-code
     3083                     and buf_recipe.recipe-type <> 'альтернатива':U
     3084                         )
     3085               :
     3086                   assign
     3087                       v-recipe-found = yes
     3088                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3089                   .
     3090               end.
     3091               if v-recipe-found = no
     3092               then do:
     3093                   for first buf_recipe no-lock
     3094                       where buf_recipe.obj-type    = p-obj-type
     3095                         and buf_recipe.obj-code    = p-obj-code
     3096                         and buf_recipe.artic       = buf_goods.artic
     3097                         and buf_recipe.prod-type   = buf_goods.prod-type
     3098                         and buf_recipe.prod-code   = buf_goods.prod-code
     3099                         or (
     3100                             buf_recipe.obj-type    = ""
     3101                         and buf_recipe.obj-code    = 0
     3102                         and buf_recipe.artic       = buf_goods.artic
     3103                         and buf_recipe.prod-type   = buf_goods.prod-type
     3104                         and buf_recipe.prod-code   = buf_goods.prod-code
     3105                             )
     3106                   :
     3107                       assign
     3108                           v-recipe-found = yes
     3109                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3110                       .
     3111                   end.
     3112                   if v-recipe-found = no
     3113                   then do:
     3114                       assign
     3115                           buf_fbr-gds-obj.default-recipe-code = ""
     3116                       .
     3117                   end.
     3118               end.
     3119           end.
     3120       end.
     3121   end.
     3122   end procedure.
     3123   procedure fbrlib-get-obj-recipe :
     3124   define input parameter p-obj-type       as character    no-undo.
     3125   define input parameter p-obj-code       as integer      no-undo.
     3126   define input parameter p-gds-code       as integer      no-undo.
     3127   define output parameter p-recipe-code   as character    no-undo.
     3128       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3129   do
     3130   for buf_fbr-gds-obj
     3131   on error undo, return error
     3132   :
     3133       find first buf_fbr-gds-obj no-lock
     3134            where buf_fbr-gds-obj.obj-type = p-obj-type
     3135              and buf_fbr-gds-obj.obj-code = p-obj-code
     3136              and buf_fbr-gds-obj.gds-code = p-gds-code
     3137       no-error.
     3138       if available buf_fbr-gds-obj
     3139       then do:
     3140           assign
     3141               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3142           .
     3143       end.
     3144       else do:
     3145           assign
     3146               p-recipe-code = ""
     3147           .
     3148       end.
     3149   end.
     3150   end procedure.
     3151   procedure fbrlib-create-or-update-recipe-gds :
     3152   define input parameter p-recipe-code    as character        no-undo.
     3153   define input parameter p-gds-code       as integer          no-undo.
     3154   define input parameter p-is-waste       as logical          no-undo.
     3155   define input parameter p-qnty           as decimal          no-undo.
     3156   define input parameter p-proc-number    as integer          no-undo.
     3157   define input parameter p-nws-self       as logical          no-undo.
     3158       define variable v-max-proc-num  as integer      no-undo.
     3159       define variable v-recipe-type   as character    no-undo.
     3160       define buffer buf_goods             for ub.goods.
     3161       define buffer buf_recipe-gds        for ub.recipe-gds.
     3162       define buffer buf_recipe            for ub.recipe.
     3163       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3164   do
     3165   for buf_goods
     3166     , buf_recipe-gds
     3167     , buf_recipe
     3168     , buf_proc_recipe-gds
     3169   on error undo, return error
     3170   :
     3171       find first buf_recipe no-lock
     3172            where buf_recipe.recipe-code = p-recipe-code
     3173       .
     3174       find first buf_goods no-lock
     3175            where buf_goods.gds-code = p-gds-code
     3176       .
     3177       find first buf_recipe-gds
     3178            where buf_recipe-gds.recipe-code = p-recipe-code
     3179              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3180              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3181              and buf_recipe-gds.artic       = buf_goods.artic
     3182       no-error.
     3183       if not available buf_recipe-gds
     3184       then do:
     3185           create buf_recipe-gds.
     3186           assign
     3187               buf_recipe-gds.recipe-code = p-recipe-code
     3188               buf_recipe-gds.gds-code    = p-gds-code
     3189               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3190               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3191               buf_recipe-gds.artic       = buf_goods.artic
     3192           .
     3193           assign
     3194               buf_recipe-gds.is-waste    = no
     3195               buf_recipe-gds.qnty        = 0
     3196               buf_recipe-gds.coeff-waste = 0
     3197               buf_recipe-gds.brutto-qnty = 0
     3198               buf_recipe-gds.proc-number = 0
     3199               buf_recipe-gds.nws-self    = no
     3200           .
     3201       end.
     3202       assign
     3203           buf_recipe-gds.is-waste    = p-is-waste
     3204       .
     3205       run fbrlib-get-recipe-type in this-procedure (
     3206             input "":U
     3207           , input buf_recipe-gds.recipe-code
     3208           , output v-recipe-type
     3209       ).
     3210       if v-recipe-type <> 'производство':U
     3211       then do:
     3212           assign
     3213               buf_recipe-gds.calc-method = 1
     3214               buf_recipe-gds.qnty        = p-qnty
     3215               buf_recipe-gds.brutto-qnty = p-qnty
     3216               buf_recipe-gds.coeff-waste = 0
     3217           .
     3218       end.
     3219       else do:
     3220           assign
     3221               buf_recipe-gds.calc-method = 1
     3222               buf_recipe-gds.brutto-qnty = p-qnty
     3223           .
     3224           run fbrlib-calc-brutto in this-procedure (
     3225                 input v-recipe-type
     3226               , input 0
     3227               , input 0
     3228               , input buf_recipe-gds.coeff-waste
     3229               , input buf_recipe-gds.brutto-qnty
     3230               , input 1
     3231               , output buf_recipe-gds.qnty
     3232               , output buf_recipe-gds.coeff-waste
     3233               , output buf_recipe-gds.brutto-qnty
     3234               , output buf_recipe-gds.calc-method
     3235           ).
     3236       end.
     3237       assign
     3238           buf_recipe-gds.nws-self    = p-nws-self
     3239       .
     3240       if buf_recipe.recipe-type = 'альтернатива':U
     3241       and buf_recipe-gds.proc-number <> 0
     3242       then do:
     3243       end.
     3244       else do:
     3245           if p-proc-number <> 0
     3246           then do:
     3247               assign
     3248                   buf_recipe-gds.proc-number = p-proc-number
     3249               .
     3250           end.
     3251           else do:
     3252               assign
     3253                   v-max-proc-num = 0
     3254               .
     3255               for each buf_proc_recipe-gds no-lock
     3256                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3257               :
     3258                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3259                   then do:
     3260                       assign
     3261                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3262                       .
     3263                   end.
     3264               end.
     3265               assign
     3266                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3267               .
     3268           end.
     3269       end.
     3270   end.
     3271   end procedure.
     3272   PROCEDURE fbrlib-create-or-update-recipe :
     3273   define input parameter p-mode               as character    no-undo.
     3274   define input parameter p-obj-type           as character    no-undo.
     3275   define input parameter p-obj-code           as integer      no-undo.
     3276   define input parameter p-recipe-code        as character    no-undo.
     3277   define input parameter p-recipe-type        as character    no-undo.
     3278   define input parameter p-gds-code           as integer      no-undo.
     3279   define input parameter p-name               as character    no-undo.
     3280   define input parameter p-design             as character    no-undo.
     3281   define input parameter p-order              as integer      no-undo.
     3282   define input parameter p-quality            as character    no-undo.
     3283   define input parameter p-ref-num            as character    no-undo.
     3284   define input parameter p-technique          as character    no-undo.
     3285   define input parameter p-template           as character    no-undo.
     3286   define input parameter p-qnty               as decimal      no-undo.
     3287   define input parameter p-portion-qnty       as integer      no-undo.
     3288   define input parameter p-portion-weight     as decimal      no-undo.
     3289   define output parameter p-new-recipe-code   as character    no-undo.
     3290       define variable v-host-code         as integer      no-undo.
     3291       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3292       define buffer buf_recipe    for ub.recipe.
     3293       define buffer buf_goods     for ub.goods.
     3294   do
     3295   for buf_recipe
     3296     , buf_goods
     3297   on error undo, return error
     3298   :
     3299       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3300       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3301       then do:
     3302           message
     3303               skip "Ошибка задания типа операции для создания или измения рецепта."
     3304               skip (1)
     3305               skip "Задан тип операции:" p-mode
     3306           view-as alert-box error.
     3307           undo, return error .
     3308       end.
     3309       if p-recipe-code = ""
     3310       then do:
     3311   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3313     (input  p-obj-type
     3314     ,input  p-obj-code
     3315     ,output v-host-code
     3316     )  .
     3317           find first buf_goods no-lock
     3318                where buf_goods.gds-code = p-gds-code
     3319           .
     3320           create buf_recipe .
     3321           run fbrcode-gen-recipe-code in this-procedure (
     3322                 input p-obj-type
     3323               , input p-obj-code
     3324               , output buf_recipe.recipe-code
     3325           ).
     3326           assign
     3327               buf_recipe.artic               = buf_goods.artic
     3328               buf_recipe.prod-type           = buf_goods.prod-type
     3329               buf_recipe.prod-code           = buf_goods.prod-code
     3330               buf_recipe.recipe-type         = p-recipe-type
     3331               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3332               buf_recipe.gds-code            = p-gds-code
     3333               buf_recipe.host-code           = v-host-code
     3334               buf_recipe.obj-type            = p-obj-type
     3335               buf_recipe.obj-code            = p-obj-code
     3336               buf_recipe.recipe-design       = ""
     3337               buf_recipe.recipe-order        = 0
     3338               buf_recipe.recipe-quality      = ""
     3339               buf_recipe.recipe-ref-num      = ""
     3340               buf_recipe.recipe-technique    = ""
     3341               buf_recipe.recipe-template     = ""
     3342               buf_recipe.qnty                = 1.0
     3343               buf_recipe.portion-qnty        = 1
     3344               buf_recipe.portion-weight      = 0
     3345           .
     3346       end.
     3347       if p-name <> ""
     3348       then do:
     3349           assign
     3350               buf_recipe.recipe-name = p-name
     3351           .
     3352       end.
     3353       assign
     3354           buf_recipe.recipe-design       = p-design
     3355           buf_recipe.recipe-order        = p-order
     3356           buf_recipe.recipe-quality      = p-quality
     3357           buf_recipe.recipe-ref-num      = p-ref-num
     3358           buf_recipe.recipe-technique    = p-technique
     3359           buf_recipe.recipe-template     = p-template
     3360           buf_recipe.qnty                = p-qnty
     3361           buf_recipe.portion-qnty        = p-portion-qnty
     3362           buf_recipe.portion-weight      = p-portion-weight
     3363       .
     3364       assign
     3365           p-new-recipe-code = buf_recipe.recipe-code
     3366       .
     3367       run fbrlib-set-default-recipe in this-procedure (
     3368             input p-obj-type
     3369           , input p-obj-code
     3370           , input buf_goods.gds-code
     3371       ).
     3372   end.
     3373   END PROCEDURE.
     3374   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3375   define input parameter parparentproc-handle as widget-handle no-undo .
     3376   define input parameter p-doc-code   as character no-undo.
     3377   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3378       define variable v-shift-on      as logical      no-undo.
     3379       define variable v-shift-date    as date         no-undo.
     3380       define variable v-shift-num     as integer      no-undo.
     3381       define variable v-shift-name    as character    no-undo.
     3382       define variable v-obj-date      as date         no-undo.
     3383       define variable v-chip-num      as integer      no-undo.
     3384       define buffer buf_fbr-doc       for ub.fbr-doc.
     3385       define buffer buf_fbr-line      for ub.fbr-line.
     3386       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3387       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3388       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3389       define buffer buf_marking-lines for ub.marking-lines .
     3390       define buffer buf_marking       for ub.marking .
     3391       define buffer buf_goods         for ub.goods .
     3392   do
     3393   for buf_fbr-doc
     3394     , buf_fbr-line
     3395     , buf_c-fbr-doc
     3396     , buf_fbr-recipe
     3397     , buf_fbr-recipe-gds
     3398     , buf_goods
     3399     , buf_marking
     3400     , buf_marking-lines
     3401   on error undo, return error
     3402   :
     3403   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3404     define variable v-cntxt-db-num        as integer   no-undo .
     3405     define variable v-cntxt-userid        as character no-undo .
     3406     define variable v-cntxt-level         as character no-undo .
     3407     define variable v-cntxt-host-code-obj as integer   no-undo .
     3408     define variable v-cntxt-obj-type      as character no-undo .
     3409     define variable v-cntxt-obj-code      as integer   no-undo .
     3410     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3411     define variable v-cntxt-is-admin      as logical   no-undo .
     3412   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3413     run mainmenu_getcntxt in parparentproc-handle
     3414       (output v-cntxt-db-num
     3415       ,output v-cntxt-userid
     3416       ,output v-cntxt-level
     3417       ,output v-cntxt-host-code-obj
     3418       ,output v-cntxt-obj-type
     3419       ,output v-cntxt-obj-code
     3420       ,output v-cntxt-db-num-obj
     3421       ,output v-cntxt-is-admin
     3422       ) .
     3423       if search ("delfbr.err") <> ?
     3424       then do:
     3425           os-delete "delfbr.err".
     3426       end.
     3427     _del-block:
     3428       do transaction
     3429     on error undo _del-block, return error return-value
     3430     on endkey undo _del-block , return error return-value
     3431     on stop undo _del-block , return error return-value
     3432       :
     3433           find first buf_fbr-doc exclusive-lock
     3434                where buf_fbr-doc.doc-code = p-doc-code
     3435           no-error.
     3436           if not available buf_fbr-doc
     3437           then do:
     3438         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3439                                           ,vss-workfile
     3440                                           ,vss-revision
     3441                                           ,vss-description
     3442                                           ,chr(10)
     3443                                           , p-doc-code).
     3444           end.
     3445           run fbrlib-delete-fact-trn-doc in this-procedure (
     3446               input parparentproc-handle
     3447              ,input p-doc-code
     3448              ,input 'при':U
     3449              ,input p-chip-num
     3450              ,output v-chip-num
     3451           ) no-error.
     3452           if error-status :error
     3453           then do:
     3454               run fbrlib-print-del-error-message in this-procedure .
     3455         undo _del-block, return error.
     3456           end.
     3457           assign
     3458           p-chip-num = (if p-chip-num = ?
     3459                         then v-chip-num
     3460                         else p-chip-num).
     3461           run fbrlib-delete-fact-trn-doc in this-procedure (
     3462               input parparentproc-handle
     3463              ,input p-doc-code
     3464              ,input 'рас':U
     3465              ,input p-chip-num
     3466              ,output v-chip-num
     3467           ) no-error.
     3468           if error-status :error
     3469           then do:
     3470               run fbrlib-print-del-error-message in this-procedure .
     3471         undo _del-block, return error.
     3472           end.
     3473           run fbrlib-delete-fact-trn-doc in this-procedure (
     3474               input parparentproc-handle
     3475              ,input p-doc-code
     3476              ,input 'спи':U
     3477              ,input p-chip-num
     3478              ,output v-chip-num
     3479           ) no-error.
     3480           if error-status :error
     3481           then do:
     3482               run fbrlib-print-del-error-message in this-procedure .
     3483         undo _del-block, return error.
     3484           end.
     3485           create buf_c-fbr-doc.
     3486           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3487   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3488   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3489     (input  buf_fbr-doc.obj-type
     3490     ,input  buf_fbr-doc.obj-code
     3491     ,output v-obj-date
     3492     ) no-error .
     3493           if error-status :error
     3494           or v-obj-date = ?
     3495           then do:
     3496         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3497           end.
     3498   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3500     (input  buf_fbr-doc.obj-type
     3501     ,input  buf_fbr-doc.obj-code
     3502     ,input  'shift-on=request'
     3503     ,output v-shift-on
     3504     )  .
     3505           if v-shift-on
     3506           then do:
     3507   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3509     (input  buf_fbr-doc.obj-type
     3510     ,input  buf_fbr-doc.obj-code
     3511     ,output v-shift-date
     3512     ,output v-shift-num
     3513     ,output v-shift-name
     3514     ) no-error .
     3515               if error-status :error
     3516               then do:
     3517           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3518               end.
     3519           end.
     3520           else do:
     3521               assign
     3522                   v-shift-date = ?
     3523                   v-shift-num  = ?
     3524                   v-shift-name = ?
     3525               .
     3526           end.
     3527           define variable v-today       as date         no-undo.
     3528           define variable v-time        as integer      no-undo.
     3529           run cur-time in this-procedure (
     3530                 output v-today
     3531               , output v-time
     3532           ).
     3533           assign
     3534               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3535               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3536               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3537               buf_c-fbr-doc.corr-date        = v-today
     3538               buf_c-fbr-doc.corr-time        = v-time
     3539               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3540               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3541               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3542               buf_c-fbr-doc.is-del           = yes
     3543           .
     3544           assign
     3545               buf_fbr-doc.is-del = yes
     3546           .
     3547           for each buf_fbr-line exclusive-lock
     3548              where buf_fbr-line.doc-code = p-doc-code
     3549       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3550       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3551       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3552           :
     3553               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3554                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3555                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3556               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3557                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3558                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3559                                                       and buf_marking-lines.in-code  = "manufacturing"
     3560                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3561                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3562                                                       and buf_marking-lines.prt-code = 0
     3563               :
     3564                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3565                   assign
     3566                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3567                   .
     3568                 end .
     3569                 delete buf_marking-lines.
     3570               end .
     3571               delete buf_fbr-line.
     3572           end.
     3573           for each buf_fbr-recipe exclusive-lock
     3574              where buf_fbr-recipe.doc-code = p-doc-code
     3575       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3576       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3577       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3578           :
     3579               delete buf_fbr-recipe.
     3580           end.
     3581           for each buf_fbr-recipe-gds exclusive-lock
     3582              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3583       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3584       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3585       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3586           :
     3587               delete buf_fbr-recipe-gds.
     3588           end.
     3589           delete buf_fbr-doc.
     3590       end.
     3591   end.
     3592   END PROCEDURE.
     3593   PROCEDURE fbrlib-del-trn-doc :
     3594   do
     3595   on error undo, return error
     3596   :
     3597   define input parameter parparentproc        as widget-handle no-undo .
     3598   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3599   define input parameter p-trn-doc-type       as character    no-undo.
     3600   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3601   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3602       define variable v-trn-doc-doc-code  as character     no-undo.
     3603       define buffer buf_trn-doc       for ub.trn-doc.
     3604   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3605     define variable v-cntxt-db-num        as integer   no-undo .
     3606     define variable v-cntxt-userid        as character no-undo .
     3607     define variable v-cntxt-level         as character no-undo .
     3608     define variable v-cntxt-host-code-obj as integer   no-undo .
     3609     define variable v-cntxt-obj-type      as character no-undo .
     3610     define variable v-cntxt-obj-code      as integer   no-undo .
     3611     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3612     define variable v-cntxt-is-admin      as logical   no-undo .
     3613   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3614     run mainmenu_getcntxt in parparentproc
     3615       (output v-cntxt-db-num
     3616       ,output v-cntxt-userid
     3617       ,output v-cntxt-level
     3618       ,output v-cntxt-host-code-obj
     3619       ,output v-cntxt-obj-type
     3620       ,output v-cntxt-obj-code
     3621       ,output v-cntxt-db-num-obj
     3622       ,output v-cntxt-is-admin
     3623       ) .
     3624       run fbrcode-trn-doc in this-procedure (
     3625             input 'производство':U
     3626           , input p-fbr-doc-doc-code
     3627           , input p-trn-doc-type
     3628           , output v-trn-doc-doc-code
     3629       ).
     3630       find first buf_trn-doc no-lock
     3631            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3632       no-error.
     3633       if available buf_trn-doc
     3634       then do:
     3635           run str/del-doc.p (
     3636                 input parparentproc
     3637               , input buf_trn-doc.doc-code
     3638               , input v-cntxt-db-num
     3639               , input "del-doc.err"
     3640               , input ?
     3641               , input p-fbr-doc-doc-code
     3642               , input v-cntxt-userid
     3643               , input 0
     3644               , input p-phchip-num
     3645               , output p-chip-num
     3646           ) no-error.
     3647           if error-status :error
     3648           then do:
     3649             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3650                                           ,v-trn-doc-doc-code
     3651                                           ,p-fbr-doc-doc-code
     3652                                           , chr(10)
     3653                                           , error-status:get-message(1)
     3654                                           , return-value ).
     3655           end.
     3656       end.
     3657   end.
     3658   END PROCEDURE.
     3659   PROCEDURE fbrlib-delete-fact-trn-doc :
     3660   define input parameter parparentproc    as widget-handle    no-undo.
     3661   define input parameter p-fbr-doc-code   as character        no-undo.
     3662   define input parameter p-doc-type       as character    no-undo.
     3663   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3664   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3665       define variable v-doc-code          as character        no-undo.
     3666       define variable v-ext-doc-type      as character        no-undo.
     3667       define variable v-trn-doc-recid     as recid            no-undo.
     3668       define variable varchip-code        as integer          no-undo.
     3669       define variable varchip-code2       as integer          no-undo.
     3670       define variable v-chip-counter      as integer          no-undo.
     3671       define buffer buf_trn-doc       for ub.trn-doc.
     3672       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3673       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3674   do
     3675   for buf_trn-doc
     3676     , buf_pri_trn-doc
     3677     , buf_cons_trn-doc
     3678   on error undo, return error
     3679   :
     3680   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3681     define variable v-cntxt-db-num        as integer   no-undo .
     3682     define variable v-cntxt-userid        as character no-undo .
     3683     define variable v-cntxt-level         as character no-undo .
     3684     define variable v-cntxt-host-code-obj as integer   no-undo .
     3685     define variable v-cntxt-obj-type      as character no-undo .
     3686     define variable v-cntxt-obj-code      as integer   no-undo .
     3687     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3688     define variable v-cntxt-is-admin      as logical   no-undo .
     3689   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3690     run mainmenu_getcntxt in parparentproc
     3691       (output v-cntxt-db-num
     3692       ,output v-cntxt-userid
     3693       ,output v-cntxt-level
     3694       ,output v-cntxt-host-code-obj
     3695       ,output v-cntxt-obj-type
     3696       ,output v-cntxt-obj-code
     3697       ,output v-cntxt-db-num-obj
     3698       ,output v-cntxt-is-admin
     3699       ) .
     3700       run fbrcode-trn-doc in this-procedure (
     3701             input 'производство':U
     3702           , input p-fbr-doc-code
     3703           , input p-doc-type
     3704           , output v-doc-code
     3705       ).
     3706       find first buf_trn-doc no-lock
     3707            where buf_trn-doc.doc-code = v-doc-code
     3708       no-error.
     3709       if not available buf_trn-doc
     3710       then do:
     3711           if p-doc-type <> 'спи':U
     3712           then do:
     3713               message
     3714                   "Не найден документ '" p-doc-type "'"
     3715                   "по документу производства " p-fbr-doc-code
     3716               view-as alert-box.
     3717               undo, return error.
     3718           end.
     3719           else do:
     3720           end.
     3721       end.
     3722       else do:
     3723           assign
     3724               v-trn-doc-recid = recid( buf_trn-doc )
     3725               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3726           .
     3727           if v-ext-doc-type = 'ev':U
     3728           then do:
     3729               find first buf_pri_trn-doc no-lock
     3730                    where buf_pri_trn-doc.out-code     = v-doc-code
     3731                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3732               no-error.
     3733               if available buf_pri_trn-doc
     3734               then do:
     3735                   run str/del-doc.p (
     3736                         input parparentproc
     3737                       , input buf_pri_trn-doc.doc-code
     3738                       , input v-cntxt-db-num
     3739                       , input "delfbr.err"
     3740                       , input ?
     3741                       , input p-fbr-doc-code
     3742                       , input v-cntxt-userid
     3743                       , input 0
     3744                       , input (if p-ph-chip-num <> ?
     3745                               then p-ph-chip-num
     3746                               else (if varchip-code <> 0
     3747                                   then varchip-code
     3748                                   else ?)
     3749                               )
     3750                       , output varchip-code2
     3751                   ) no-error.
     3752                   if error-status :error
     3753                   then do:
     3754                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3755                                                   ,buf_pri_trn-doc.doc-code
     3756                                                   ,p-fbr-doc-code
     3757                                                   , chr(10)
     3758                                                   , error-status:get-message(1)
     3759                                                   , return-value ).
     3760                   end.
     3761               end.
     3762           end.
     3763           define buffer buf_out_trn-doc       for ub.trn-doc.
     3764           if p-doc-type = 'при':U
     3765           then do:
     3766               assign
     3767                   v-chip-counter = 0
     3768               .
     3769               for each buf_out_trn-doc exclusive-lock
     3770                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3771               on error undo, return error
     3772               :
     3773                   assign
     3774                       v-chip-counter = v-chip-counter + 1
     3775                   .
     3776                   if v-chip-counter > 1
     3777                   then do:
     3778                       assign
     3779                           varchip-code = varchip-code2
     3780                       .
     3781                   end.
     3782                   run str/del-doc.p (
     3783                         input parparentproc
     3784                       , input buf_out_trn-doc.doc-code
     3785                       , input v-cntxt-db-num
     3786                       , input "delfbr.err"
     3787                       , input ?
     3788                       , input p-fbr-doc-code
     3789                       , input v-cntxt-userid
     3790                       , input 0
     3791                       , input (if p-ph-chip-num <> ?
     3792                               then p-ph-chip-num
     3793                               else (if varchip-code <> 0
     3794                                   then varchip-code
     3795                                   else ?)
     3796                               )
     3797                       , output varchip-code2
     3798                   ) no-error.
     3799                   if error-status :error
     3800                   then do:
     3801                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3802                                                   ,buf_out_trn-doc.doc-code
     3803                                                   ,buf_trn-doc.doc-code
     3804                                                   ,p-fbr-doc-code
     3805                                                   , chr(10)
     3806                                                   , error-status:get-message(1)
     3807                                                   , return-value ).
     3808                   end.
     3809               end.
     3810           end.
     3811           run str/del-doc.p (
     3812                 input parparentproc
     3813               , input buf_trn-doc.doc-code
     3814               , input v-cntxt-db-num
     3815               , input "delfbr.err"
     3816               , input ?
     3817               , input p-fbr-doc-code
     3818               , input v-cntxt-userid
     3819               , input 0
     3820               , input (if p-ph-chip-num <> ?
     3821                        then p-ph-chip-num
     3822                        else (if varchip-code <> 0
     3823                              then varchip-code
     3824                              else ?)
     3825                        )
     3826               , output varchip-code2
     3827           ) no-error.
     3828           if error-status :error
     3829           then do:
     3830               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3831                                             ,buf_trn-doc.doc-code
     3832                                             ,p-fbr-doc-code
     3833                                             , chr(10)
     3834                                             , error-status:get-message(1)
     3835                                             , return-value ).
     3836           end.
     3837           if p-doc-type = 'рас':U
     3838           or p-doc-type = 'спи':U
     3839           then do:
     3840               assign
     3841                   v-chip-counter = 0
     3842               .
     3843               for each buf_cons_trn-doc no-lock
     3844                  where buf_cons_trn-doc.out-code      = v-doc-code
     3845                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3846               :
     3847                   assign
     3848                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3849                       v-chip-counter = v-chip-counter + 1
     3850                   .
     3851                   assign
     3852                   varchip-code = if v-chip-counter = 2
     3853                                  then varchip-code2
     3854                                  else varchip-code.
     3855                   run str/del-doc.p (
     3856                         input parparentproc
     3857                       , input buf_cons_trn-doc.doc-code
     3858                       , input v-cntxt-db-num
     3859                       , input "delfbr.err"
     3860                       , input ?
     3861                       , input ?
     3862                       , input v-cntxt-userid
     3863                       , input 0
     3864                       , input (if p-ph-chip-num <> ?
     3865                                then p-ph-chip-num
     3866                                else ( if v-chip-counter = 1
     3867                                       then ?
     3868                                       else varchip-code )
     3869                                )
     3870                       , output varchip-code2
     3871                   ) no-error.
     3872                   if error-status :error
     3873                   then do:
     3874                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3875                                                     ,buf_cons_trn-doc.doc-code
     3876                                                     ,p-fbr-doc-code
     3877                                                     , chr(10)
     3878                                                     , error-status:get-message(1)
     3879                                                     , return-value ).
     3880                   end.
     3881                   assign
     3882                       p-chip-num = varchip-code2
     3883                   .
     3884               end.
     3885           end.
     3886           assign
     3887               p-chip-num = varchip-code2
     3888           .
     3889       end.
     3890   end.
     3891   END PROCEDURE.
     3892   PROCEDURE fbrlib-print-del-error-message :
     3893   do
     3894   on error undo, return error
     3895   :
     3896       define variable v-user-action   as character    no-undo.
     3897       define variable v-printed       as logical      no-undo.
     3898       message
     3899           vss-workfile vss-revision vss-description
     3900           skip "Ошибка при удалении документа."
     3901           skip return-value
     3902           skip trim(error-status :get-message(1))
     3903           skip trim(error-status :get-message(2))
     3904           skip trim(error-status :get-message(3))
     3905       view-as alert-box error.
     3906       if search ("delfbr.err") <> ?
     3907       then do:
     3908         run gbl/prnfilen.w
     3909           (input  "Ошибки при удалении документа производства"
     3910           ,input  0
     3911           ,input  "delfbr.err"
     3912           ,input  7
     3913           ,output v-user-action
     3914           ,output v-printed
     3915           ).
     3916       end.
     3917   end.
     3918   END PROCEDURE.
     3919   procedure fbrlib-calc-brutto :
     3920   define input parameter p-recipe-type        as character        no-undo.
     3921   define input parameter p-netto              as decimal          no-undo.
     3922   define input parameter p-coeff-value        as decimal          no-undo.
     3923   define input parameter p-coeff-waste        as decimal          no-undo.
     3924   define input parameter p-brutto             as decimal          no-undo.
     3925   define input parameter p-calc-method        as integer          no-undo.
     3926   define output parameter p-new-netto         as decimal          no-undo.
     3927   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3928   define output parameter p-new-brutto        as decimal          no-undo.
     3929   define output parameter p-new-calc-method   as integer          no-undo.
     3930   do
     3931   on error undo, return error
     3932   :
     3933       if p-recipe-type <> 'производство':U
     3934       then do:
     3935           assign
     3936               p-new-coeff-waste = 0
     3937               p-new-calc-method = 1
     3938               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3939               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3940           .
     3941       end.
     3942       else do:
     3943           assign
     3944               p-new-calc-method = p-calc-method
     3945           .
     3946           if p-coeff-waste = 0
     3947           then do:
     3948               assign
     3949                   p-coeff-value = 0
     3950               .
     3951           end.
     3952           case p-calc-method
     3953           :
     3954               when 1
     3955               then do:
     3956                   assign
     3957                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3958                       p-new-coeff-waste   = p-coeff-waste
     3959                       p-new-brutto        = p-brutto
     3960                   .
     3961               end.
     3962               when 2
     3963               then do:
     3964                   assign
     3965                       p-new-netto         = p-netto
     3966                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3967                       p-new-brutto        = p-brutto
     3968                   .
     3969               end.
     3970               when 3
     3971               then do:
     3972                   assign
     3973                       p-new-netto         = p-netto
     3974                       p-new-coeff-waste   = p-coeff-waste
     3975                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3976                   .
     3977               end.
     3978               otherwise do:
     3979                   define variable v-yesno    as logical      no-undo.
     3980                   assign
     3981                       v-yesno = yes
     3982                   .
     3983                   message
     3984                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3985                       skip "Значение метода должно быть 1, 2 или 3."
     3986                       skip(1)
     3987                       skip "Заданное значение:" p-calc-method
     3988                       skip(1)
     3989                       skip "Установить значение метода расчета 1"
     3990                       skip "(расчет нетто по брутто и проценту потерь)?"
     3991                   view-as alert-box warning
     3992                   buttons yes-no
     3993                   title "Неверное значение метода пересчета в строках документа-производства"
     3994                   update v-yesno
     3995                   .
     3996                   if v-yesno = yes
     3997                   then do:
     3998                       assign
     3999                           p-new-calc-method   = 1
     4000                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4001                           p-new-coeff-waste   = p-coeff-waste
     4002                           p-new-brutto        = p-brutto
     4003                       .
     4004                   end.
     4005                   else do:
     4006                       message
     4007                               vss-workfile vss-revision vss-description
     4008                           skip(1)
     4009                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4010                           skip return-value
     4011                           skip trim(error-status :get-message(1))
     4012                               trim(error-status :get-message(2))
     4013                               trim(error-status :get-message(3))
     4014                       view-as alert-box error
     4015                       title "Неверное значение метода расчета"
     4016                       .
     4017                       undo, return error .
     4018                   end.
     4019               end.
     4020           end case.
     4021       end.
     4022   end.
     4023   end procedure.
     4024   procedure fbrlib-check-brutto :
     4025   define input parameter p-recipe-type        as character        no-undo.
     4026   define input parameter p-netto              as decimal          no-undo.
     4027   define input parameter p-coeff-value        as decimal          no-undo.
     4028   define input parameter p-coeff-waste        as decimal          no-undo.
     4029   define input parameter p-brutto             as decimal          no-undo.
     4030   define input parameter p-calc-method        as integer          no-undo.
     4031   define output parameter p-error-message     as character        no-undo.
     4032   define output parameter p-not-good          as logical          no-undo.
     4033   do
     4034   on error undo, return error
     4035   :
     4036       if p-recipe-type <> 'производство':U
     4037       then do:
     4038           if p-netto <> p-brutto
     4039           or p-coeff-waste <> 0
     4040           then do:
     4041               assign
     4042                   p-not-good      = yes
     4043                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4044                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4045               .
     4046           end.
     4047       end.
     4048       else do:
     4049           if p-coeff-waste = 0
     4050           then do:
     4051               assign
     4052                   p-coeff-value = 0
     4053               .
     4054           end.
     4055           case p-calc-method
     4056           :
     4057               when 1
     4058               then do:
     4059                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4060                   then do:
     4061                       assign
     4062                           p-not-good      = yes
     4063                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4064                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4065                       .
     4066                   end.
     4067               end.
     4068               when 2
     4069               then do:
     4070                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4071                   then do:
     4072                       assign
     4073                           p-not-good      = yes
     4074                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4075                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4076                       .
     4077                   end.
     4078               end.
     4079               when 3
     4080               then do:
     4081                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4082                   then do:
     4083                       assign
     4084                           p-not-good      = yes
     4085                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4086                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4087                       .
     4088                   end.
     4089               end.
     4090               otherwise do:
     4091                   assign
     4092                       p-not-good      = yes
     4093                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4094                   .
     4095               end.
     4096           end case.
     4097       end.
     4098   end.
     4099   end procedure.
     4100   procedure fbrlib-check-fbr-recipe :
     4101   define input parameter p-doc-code       as character        no-undo.
     4102   define input parameter p-recipe-code    as character        no-undo.
     4103   define output parameter p-is-correct    as logical          no-undo.
     4104       define variable v-comp-factor    as decimal      no-undo.
     4105       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4106       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4107       define buffer buf_fbr-line          for ub.fbr-line.
     4108   do
     4109   for buf_fbr-recipe
     4110     , buf_fbr-recipe-gds
     4111     , buf_fbr-line
     4112   on error undo, return error
     4113   :
     4114       assign
     4115           p-is-correct = yes
     4116       .
     4117       find first buf_fbr-recipe no-lock
     4118            where buf_fbr-recipe.doc-code    = p-doc-code
     4119              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4120       .
     4121       if not available buf_fbr-recipe then do:
     4122         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4123       end.
     4124       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4125       then do:
     4126       end.
     4127       else do:
     4128           find first buf_fbr-line no-lock
     4129                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4130                  and buf_fbr-line.is-comp     = yes
     4131                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4132                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4133                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4134                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4135           .
     4136           assign
     4137               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4138           .
     4139           recipe-line-cycle:
     4140           for each buf_fbr-recipe-gds no-lock
     4141              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4142                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4143           on error undo, return error
     4144           :
     4145               find first buf_fbr-line no-lock
     4146                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4147                      and buf_fbr-line.is-comp     = no
     4148                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4149                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4150                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4151                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4152               .
     4153               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4154               then do:
     4155                   assign
     4156                       p-is-correct = no
     4157                   .
     4158                   leave recipe-line-cycle.
     4159               end.
     4160           end.
     4161       end.
     4162   end.
     4163   end procedure.
     4164   procedure fbrlib-get-recipe-type :
     4165   define input parameter p-fbr-doc-code   as character        no-undo.
     4166   define input parameter p-recipe-code    as character        no-undo.
     4167   define output parameter p-recipe-type   as character        no-undo.
     4168       define buffer buf_recipe        for ub.recipe.
     4169       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4170   do
     4171   for buf_recipe
     4172     , buf_fbr-recipe
     4173   on error undo, return error
     4174   :
     4175       if p-fbr-doc-code = ""
     4176       then do:
     4177           find first buf_recipe no-lock
     4178                where buf_recipe.recipe-code = p-recipe-code
     4179           no-error.
     4180           if available buf_recipe
     4181           then do:
     4182               assign
     4183                   p-recipe-type = buf_recipe.recipe-type
     4184               .
     4185           end.
     4186           else do:
     4187               assign
     4188                   p-recipe-type = "":U
     4189               .
     4190           end.
     4191       end.
     4192       else do:
     4193           find first buf_fbr-recipe no-lock
     4194                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4195                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4196           no-error.
     4197           if available buf_fbr-recipe
     4198           then do:
     4199               assign
     4200                   p-recipe-type = buf_fbr-recipe.recipe-type
     4201               .
     4202           end.
     4203           else do:
     4204               assign
     4205                   p-recipe-type = "":U
     4206               .
     4207           end.
     4208       end.
     4209   end.
     4210   end procedure.
     4211   PROCEDURE calc-comp-from-ingr :
     4212   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4213   define input parameter p-fact-qnty                          as decimal      no-undo.
     4214   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4215   define output parameter p-comp-qnty                         as decimal      no-undo.
     4216       define variable v-ingr-qnty     as decimal       no-undo.
     4217       define buffer buf_i_fbr-line    for ub.fbr-line.
     4218       define buffer buf_fbr-line      for ub.fbr-line.
     4219       define buffer buf_recipe        for ub.fbr-recipe.
     4220       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4221   do
     4222   for buf_i_fbr-line
     4223     , buf_fbr-line
     4224     , buf_recipe
     4225     , buf_recipe-gds
     4226   on error undo, return error
     4227   :
     4228       find first buf_i_fbr-line no-lock
     4229            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4230       .
     4231       find first buf_recipe no-lock
     4232            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4233              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4234       no-error.
     4235       if not available buf_recipe
     4236       then do:
     4237           message
     4238                   vss-workfile vss-revision vss-description
     4239               skip "В строке производства не указан рецепт."
     4240               skip "Невозможно рассчитать количество составного товара."
     4241               skip return-value
     4242               skip trim(error-status :get-message(1))
     4243                   trim(error-status :get-message(2))
     4244                   trim(error-status :get-message(3))
     4245           view-as alert-box error.
     4246           undo, return error .
     4247       end.
     4248       if buf_recipe.recipe-type = 'альтернатива':U
     4249       then do:
     4250           for each buf_fbr-line no-lock
     4251              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4252                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4253                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4254           on error undo, return error
     4255           :
     4256               find first buf_recipe-gds no-lock
     4257                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4258                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4259                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4260                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4261                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4262               .
     4263               assign
     4264                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4265               .
     4266           end.
     4267           assign
     4268               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4269           .
     4270       end.
     4271       else do:
     4272           find first buf_recipe-gds no-lock
     4273                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4274                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4275                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4276                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4277                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4278           .
     4279           assign
     4280               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4281           .
     4282       end.
     4283       find first buf_fbr-line no-lock
     4284            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4285              and buf_fbr-line.is-comp     = yes
     4286              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4287       .
     4288       assign
     4289           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4290       .
     4291   end.
     4292   END PROCEDURE.
     4293   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4294   define input parameter p-recipe-code    as character    no-undo.
     4295   define input parameter p-gds-code       as integer      no-undo.
     4296   define output parameter p-line-qnty     as decimal      no-undo.
     4297   define output parameter p-used-qnty     as decimal      no-undo.
     4298   define output parameter p-recipe-qnty   as decimal      no-undo.
     4299       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4300   do
     4301   for buf_temp_dressing-ingr
     4302   on error undo, return error
     4303   :
     4304       find first buf_temp_dressing-ingr no-lock
     4305            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4306              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4307       no-error.
     4308       if available buf_temp_dressing-ingr
     4309       then do:
     4310           assign
     4311               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4312               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4313               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4314           .
     4315       end.
     4316       else do:
     4317           assign
     4318               p-line-qnty     = 0
     4319               p-used-qnty     = 0
     4320               p-recipe-qnty   = 0
     4321           .
     4322       end.
     4323   end.
     4324   END PROCEDURE.
     4325   PROCEDURE fbrlib_adjust-recipe :
     4326   do
     4327   on error undo, return error
     4328   :
     4329   define input parameter parparentproc as widget-handle no-undo .
     4330   define input parameter p-fbrhist-handle as handle no-undo .
     4331   define input parameter p-doc-code       as character    no-undo.
     4332   define input parameter p-recipe-code    as character    no-undo.
     4333   define input parameter p-price-sale-obj-type as character no-undo .
     4334   define input parameter p-price-sale-obj-code as integer no-undo .
     4335       define variable v-recipe-qnty       as decimal      no-undo.
     4336       define variable v-comp-qnty         as decimal      no-undo.
     4337       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4338       define variable v-ingr-qnty         as decimal      no-undo.
     4339       define variable v-qnty              as decimal      no-undo.
     4340       define variable v-coeff-waste       as decimal      no-undo.
     4341       define variable v-brutto-qnty       as decimal      no-undo.
     4342       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4343       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4344       define buffer buf_fbr-line          for ub.fbr-line.
     4345       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4346       find first buf_fbr-recipe no-lock
     4347            where buf_fbr-recipe.doc-code      = p-doc-code
     4348              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4349       .
     4350       assign
     4351           v-recipe-qnty = buf_fbr-recipe.qnty
     4352       .
     4353       find first buf_fbr-line no-lock
     4354            where buf_fbr-line.doc-code    = p-doc-code
     4355              and buf_fbr-line.is-comp     = yes
     4356              and buf_fbr-line.recipe-code = p-recipe-code
     4357       .
     4358       assign
     4359           v-comp-qnty = buf_fbr-line.fact-qnty
     4360       .
     4361       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4362       then do:
     4363       end.
     4364       else do:
     4365           for each buf_fbr-recipe-gds no-lock
     4366              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4367                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4368           on error undo, return error
     4369           :
     4370               find first buf_fbr-line no-lock
     4371                    where buf_fbr-line.doc-code    = p-doc-code
     4372                      and buf_fbr-line.is-comp     = no
     4373                      and buf_fbr-line.recipe-code = p-recipe-code
     4374                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4375                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4376                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4377               .
     4378               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4379               then do:
     4380                   do transaction
     4381                   on error undo, return error
     4382                   :
     4383                       find first buf_el_fbr-recipe-gds exclusive-lock
     4384                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4385                       .
     4386                       assign
     4387                           buf_el_fbr-recipe-gds.calc-method   = 1
     4388                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4389                       .
     4390                       run fbrlib-calc-brutto in this-procedure (
     4391                             input buf_fbr-recipe.recipe-type
     4392                           , input 0
     4393                           , input buf_el_fbr-recipe-gds.coeff-value
     4394                           , input buf_el_fbr-recipe-gds.coeff-waste
     4395                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4396                           , input 1
     4397                           , output buf_el_fbr-recipe-gds.qnty
     4398                           , output buf_el_fbr-recipe-gds.coeff-waste
     4399                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4400                           , output buf_el_fbr-recipe-gds.calc-method
     4401                       ).
     4402                   end.
     4403               end.
     4404           end.
     4405           run fbrlib_adjust-doc-lines in this-procedure (
     4406                 input parparentproc
     4407               , input p-fbrhist-handle
     4408               , input p-doc-code
     4409               , input p-recipe-code
     4410               , input p-price-sale-obj-type
     4411               , input p-price-sale-obj-code
     4412           ).
     4413       end.
     4414   end.
     4415   END PROCEDURE.
     4416   PROCEDURE fbrlib_adjust-doc-lines :
     4417   define input parameter parparentproc as widget-handle no-undo .
     4418   define input parameter p-fbrhist-handle as handle no-undo .
     4419   define input parameter p-doc-code       as character    no-undo.
     4420   define input parameter p-recipe-code    as character    no-undo.
     4421   define input parameter p-price-sale-obj-type as character no-undo .
     4422   define input parameter p-price-sale-obj-code as integer no-undo .
     4423   define variable v-comp-qnty         as decimal      no-undo.
     4424   define variable v-trn-type          as character    no-undo.
     4425   define variable v-ingr-qnty         as decimal      no-undo.
     4426   define variable v-recipe-qnty       as decimal      no-undo.
     4427   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4428   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4429   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4430   define buffer buf_fbr-line          for ub.fbr-line.
     4431   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4432   define buffer buf_goods             for ub.goods.
     4433   define buffer buf_fbr-doc           for ub.fbr-doc.
     4434   do
     4435   for buf_fbr-recipe
     4436     , buf_fbr-recipe-gds
     4437     , buf_fbr-line
     4438     , buf_coeff_fbr-line
     4439     , buf_goods
     4440     , buf_fbr-doc
     4441   on error undo, return error
     4442   :
     4443       find first buf_fbr-line no-lock
     4444            where buf_fbr-line.doc-code      = p-doc-code
     4445              and buf_fbr-line.is-comp       = yes
     4446              and buf_fbr-line.recipe-code   = p-recipe-code
     4447       .
     4448       find first buf_fbr-doc no-lock
     4449            where buf_fbr-doc.doc-code      = p-doc-code
     4450       .
     4451       assign
     4452           v-comp-qnty = buf_fbr-line.fact-qnty
     4453           v-trn-type  = buf_fbr-line.trn-type
     4454       .
     4455       find first buf_fbr-recipe no-lock
     4456            where buf_fbr-recipe.doc-code    = p-doc-code
     4457              and buf_fbr-recipe.recipe-code = p-recipe-code
     4458       .
     4459       assign
     4460       v-recipe-qnty = buf_fbr-recipe.qnty
     4461       .
     4462       do transaction
     4463       on error undo, return error
     4464       :
     4465           for each buf_fbr-recipe-gds no-lock
     4466              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4467                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4468           on error undo, return error
     4469           :
     4470               find first buf_fbr-line no-lock
     4471                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4472                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4473                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4474                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4475                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4476               no-error.
     4477               if not available buf_fbr-line
     4478               then do:
     4479                   find first buf_goods no-lock
     4480                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4481                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4482                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4483                   .
     4484                   run str/fbr-crln.p (
     4485                         input parparentproc
     4486                       , input recid( buf_fbr-doc )
     4487                       , input recid( buf_goods )
     4488                       , input buf_fbr-recipe-gds.recipe-code
     4489                       , input v-trn-type
     4490                       , input no
     4491                       , input no
     4492                       , input buf_fbr-doc.obj-type
     4493                       , input buf_fbr-doc.obj-code
     4494                       , output v-fbr-v-fbr-doc-line-recid
     4495                   ).
     4496                   find first buf_fbr-line no-lock
     4497                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4498                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4499                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4500                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4501                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4502                   no-error.
     4503                   if not available buf_fbr-line
     4504                   then do:
     4505                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4506                                                      , p-doc-code
     4507                                                      , buf_fbr-recipe-gds.artic
     4508                                                      , buf_fbr-recipe-gds.prod-type
     4509                                                      , buf_fbr-recipe-gds.prod-code).
     4510                   end.
     4511               end.
     4512               find first buf_coeff_fbr-line exclusive-lock
     4513                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4514               .
     4515               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4516               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4517               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4518               then do:
     4519                   assign
     4520                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4521                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4522                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4523                   .
     4524               end.
     4525           end.
     4526       end.
     4527       define variable v-need-goods    as logical       no-undo.
     4528       define variable v-need-goods-list       as character     no-undo.
     4529       define variable v-need-goods-qnty-list  as character     no-undo.
     4530       find first buf_fbr-line no-lock
     4531            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4532              and buf_fbr-line.is-comp     = yes
     4533              and buf_fbr-line.recipe-code = p-recipe-code
     4534       .
     4535       run str/fbr-qnty.p (
     4536             input parparentproc
     4537           , input p-fbrhist-handle
     4538           , input recid( buf_fbr-doc )
     4539           , input recid( buf_fbr-line )
     4540           , input no
     4541           , input "ingr"
     4542           , input no
     4543           , input p-price-sale-obj-type
     4544           , input p-price-sale-obj-code
     4545           , input no
     4546           , input no
     4547           , input no
     4548           , output v-need-goods
     4549           , output v-need-goods-list
     4550           , output v-need-goods-qnty-list
     4551       ).
     4552   end.
     4553   END PROCEDURE.
     4554   procedure fbrlib_check-before-close :
     4555   define input parameter p-doc-code as character no-undo .
     4556   define variable same-sale as decimal no-undo .
     4557   define variable is-waste as logical no-undo .
     4558   define variable fix-price as logical no-undo .
     4559   define buffer buf_fbr-doc for ub.fbr-doc.
     4560   define buffer buf_fbr-line for ub.fbr-line.
     4561   define buffer buf_goods for ub.goods.
     4562   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4563   do
     4564   on error undo, return error
     4565   :
     4566     for each buf_fbr-line no-lock
     4567         where buf_fbr-line.doc-code = p-doc-code
     4568       , each buf_goods no-lock
     4569         where buf_goods.artic     = buf_fbr-line.artic
     4570           and buf_goods.prod-type = buf_fbr-line.prod-type
     4571           and buf_goods.prod-code = buf_fbr-line.prod-code
     4572     break by buf_fbr-line.prod-type
     4573           by buf_fbr-line.prod-code
     4574           by buf_fbr-line.artic
     4575     :
     4576       if first-of (buf_fbr-line.artic)
     4577       then do:
     4578         assign
     4579         same-sale = buf_fbr-line.price-sale
     4580         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4581         fix-price = buf_fbr-line.is-calc
     4582         .
     4583       end.
     4584       if same-sale <> buf_fbr-line.price-sale
     4585       then do:
     4586           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4587                                         ,p-doc-code
     4588                                         ,buf_goods.artic
     4589                                         ,buf_goods.gds-name
     4590                                         ,chr(10)).
     4591       end.
     4592       if fix-price <> buf_fbr-line.is-calc then do:
     4593           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4594                                         ,p-doc-code
     4595                                         ,buf_goods.artic
     4596                                         ,buf_goods.gds-name
     4597                                         ,chr(10)).
     4598       end.
     4599       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4600       then do:
     4601         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4602                                         ,p-doc-code
     4603                                         ,buf_goods.artic
     4604                                         ,buf_goods.gds-name
     4605                                         ,chr(10)).
     4606       end.
     4607       if buf_fbr-line.rsrv-qnty <> ?
     4608       and buf_goods.gds-type <> 'у':U
     4609       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4610       and buf_fbr-line.fact-qnty <> 0
     4611       then do:
     4612         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4613           if  can-find(first buf_fbr-gds-obj no-lock where
     4614                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4615               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4616               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4617               and buf_fbr-gds-obj.is-null-price  )  then .
     4618                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4619                                         ,p-doc-code
     4620                                         ,buf_goods.artic
     4621                                         ,buf_goods.gds-name
     4622                                         ,chr(10)
     4623                                         ,buf_fbr-line.recipe-code
     4624                                         ).
     4625         end.
     4626         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4627                                         ,p-doc-code
     4628                                         ,buf_goods.artic
     4629                                         ,buf_goods.gds-name
     4630                                         ,chr(10)
     4631                                         ,buf_fbr-line.recipe-code
     4632                                         ).
     4633       end.
     4634     end.
     4635   end.
     4636   end procedure.
     4637   define input parameter p-mode       as character    no-undo.
     4638   define input parameter table for temp_bgelib_goods .
     4639       define variable v-counter               as integer      no-undo.
     4640       define variable v-xml-file-name         as character    no-undo.
     4641       define variable v-log-file-name         as character    no-undo.
     4642       define variable v-list-file-name        as character    no-undo.
     4643       define variable v-xml-file-number       as integer      no-undo.
     4644       define variable v-cancel                as logical      no-undo.
     4645       define variable v-parameter-list        as character    no-undo.
     4646       define buffer buf_goods     for ub.goods.
     4647   do
     4648   for buf_goods
     4649   on error undo, return error
     4650   :
     4651       run bgelib-filename in this-procedure (
     4652             input "gds"
     4653           , output v-xml-file-name
     4654           , output v-log-file-name
     4655           , output v-list-file-name
     4656       ).
     4657       run gbl/waitfrsp.w (
     4658             input substring( v-xml-file-name, 1, 1 )
     4659           , input 200
     4660           , output v-cancel
     4661       ) .
     4662       if v-cancel = yes
     4663       then do:
     4664           undo, return error .
     4665       end.
     4666       run bgelib-write-log in this-procedure (
     4667             input v-log-file-name
     4668           , input 1
     4669           , input "&DLine"
     4670       ).
     4671       run bgelib-write-log in this-procedure (
     4672             input v-log-file-name
     4673           , input 1
     4674           , input substitute( "Начало выгрузки справочника товаров в файл &1"
     4675                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     4676                             )
     4677       ).
     4678       assign
     4679           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     4680                                                  , 4
     4681                                                  , "docName"          , "goods":U
     4682                                                  , "version"          , replace("15.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     4683                                                  , "exportDate"       , string( today,          "99/99/9999" )
     4684                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     4685                                                 )
     4686       .
     4687       run bgelib-write-header in this-procedure (
     4688             input yes
     4689           , input v-xml-file-name
     4690           , input v-list-file-name
     4691           , input 1
     4692           , input no
     4693           , input ""
     4694           , input ""
     4695           , input ""
     4696           , input v-parameter-list
     4697       ).
     4698       if lookup( "list":U, p-mode ) = 0
     4699       then do:
     4700           for each buf_goods no-lock
     4701           on error undo, return error
     4702           :
     4703               run export-good in this-procedure (
     4704                     input buf_goods.gds-code
     4705                   , input v-parameter-list
     4706                   , input v-xml-file-name
     4707                   , input v-log-file-name
     4708                   , input v-list-file-name
     4709                   , input v-xml-file-number
     4710                   , output v-xml-file-name
     4711                   , output v-xml-file-number
     4712               ).
     4713           end.
     4714       end.
     4715       else do:
     4716           for each temp_bgelib_goods
     4717           on error undo, return error
     4718           :
     4719               run export-good in this-procedure (
     4720                     input temp_bgelib_goods.gds-code
     4721                   , input v-parameter-list
     4722                   , input v-xml-file-name
     4723                   , input v-log-file-name
     4724                   , input v-list-file-name
     4725                   , input v-xml-file-number
     4726                   , output v-xml-file-name
     4727                   , output v-xml-file-number
     4728               ).
     4729           end.
     4730       end.
     4731       run bgelib-write-footer in this-procedure (
     4732             input yes
     4733           , input v-xml-file-name
     4734           , input v-list-file-name
     4735           , input no
     4736           , input ""
     4737       ).
     4738       run bgelib-write-log in this-procedure (
     4739             input v-log-file-name
     4740           , input 1
     4741           , input substitute( "Данные выгружены в файл &1"
     4742                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     4743                             )
     4744       ).
     4745       run bgelib-write-log in this-procedure (
     4746             input v-log-file-name
     4747           , input 1
     4748           , input "&DLine"
     4749       ).
     4750   end.
     4751   procedure export-good:
     4752   do
     4753   on error undo, return error
     4754   :
     4755   define input parameter p-gds-code as integer no-undo.
     4756   define input parameter p-parameter-list         as character    no-undo.
     4757   define input parameter p-xml-file-name          as character    no-undo.
     4758   define input parameter p-log-file-name          as character    no-undo.
     4759   define input parameter p-list-file-name         as character    no-undo.
     4760   define input parameter p-xml-file-number        as integer      no-undo.
     4761   define output parameter p-last-xml-file-name    as character    no-undo.
     4762   define output parameter p-last-xml-file-number  as integer      no-undo.
     4763       define variable v-barcode       like ub.bar-code.b-code no-undo.
     4764       define variable v-vat-pc        as decimal      no-undo.
     4765       define variable v-slt-pc        as decimal      no-undo.
     4766       define variable v-need-new-file as logical      no-undo.
     4767       define variable v-void-string   as character    no-undo.
     4768       define variable v-prev-filename as character    no-undo.
     4769       define variable v-rate-code     as integer      no-undo.
     4770       define buffer buf_goods     for ub.goods.
     4771       define buffer buf_units     for ub.units.
     4772       define buffer buf_prod-bc   for ub.prod-bc.
     4773       assign
     4774           p-last-xml-file-name   = p-xml-file-name
     4775           p-last-xml-file-number = p-xml-file-number
     4776       .
     4777       run bgelib-check-file-size in this-procedure (
     4778             input p-xml-file-name + "tmp"
     4779           , output v-need-new-file
     4780       ).
     4781       if v-need-new-file = yes
     4782       then do:
     4783           assign
     4784               v-prev-filename = p-xml-file-name
     4785           .
     4786           run bgelib-filename in this-procedure (
     4787                 input "gds"
     4788               , output p-xml-file-name
     4789               , output v-void-string
     4790               , output v-void-string
     4791           ).
     4792           run bgelib-write-footer in this-procedure (
     4793                 input no
     4794               , input v-prev-filename
     4795               , input p-list-file-name
     4796               , input yes
     4797               , input p-xml-file-name + "xml":U
     4798           ).
     4799           run bgelib-write-log in this-procedure (
     4800                 input p-log-file-name
     4801               , input 1
     4802               , input substitute( "Данные выгружены в файл &1"
     4803                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     4804                               )
     4805           ).
     4806           assign
     4807               p-last-xml-file-number   = p-xml-file-number + 1
     4808               p-last-xml-file-name     = p-xml-file-name
     4809           .
     4810           run bgelib-write-header in this-procedure (
     4811                 input no
     4812               , input p-last-xml-file-name
     4813               , input p-list-file-name
     4814               , input p-last-xml-file-number
     4815               , input yes
     4816               , input v-prev-filename + "xml":U
     4817               , input ""
     4818               , input ""
     4819               , input p-parameter-list
     4820           ).
     4821           assign
     4822               v-need-new-file = no
     4823           .
     4824       end.
     4825       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     4826       find first buf_goods no-lock
     4827            where buf_goods.gds-code = p-gds-code
     4828       .
     4829   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
     4831     (input  buf_goods.gds-code
     4832     ,input  '1':U
     4833     ,input  ?
     4834     ,output v-vat-pc
     4835     ) no-error .
     4836   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4837   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
     4838     (input  buf_goods.gds-code
     4839     ,input  '2':U
     4840     ,input  ?
     4841     ,output v-slt-pc
     4842     ) no-error .
     4843       run get-tax-rate-code in this-procedure (
     4844             input buf_goods.gds-code
     4845           , input integer( '1':U )
     4846           , input ?
     4847           , output v-rate-code
     4848       ).
     4849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4850     (input  buf_goods.gds-code
     4851     ,input  ?
     4852     ,output v-barcode
     4853     ) no-error .
     4854    .
     4855       if error-status :error
     4856       then do:
     4857           run bgelib-write-log in this-procedure (
     4858               input p-log-file-name,
     4859               input 2,
     4860               input substitute( "*** ERR *** Не найден бар-код товара: &1"
     4861                                   , p-gds-code  )
     4862           ).
     4863       end.
     4864       run bgelib-tag-open in this-procedure ( input 0, input "gds", input "" ).
     4865       run bgelib-tag-put in this-procedure ( input 1, input "goodID"  , input string( buf_goods.gds-code ), input 0 ).
     4866       run bgelib-tag-put in this-procedure ( input 1, input "articul" , input buf_goods.artic             , input 0 ).
     4867       if buf_goods.stts <> 0
     4868       then do:
     4869           run bgelib-tag-put in this-procedure ( input 1, input "deleted", input "yes", input 0).
     4870       end.
     4871           run bgelib-tag-put in this-procedure ( input 1, input "prodtype", input buf_goods.prod-type, input 0 ).
     4872           run bgelib-tag-put in this-procedure ( input 1, input "prodcode", input buf_goods.prod-code, input 0 ).
     4873       run bgelib-tag-put in this-procedure ( input 1, input "units"     , input buf_goods.unit-base           , input 0 ).
     4874       run bgelib-tag-put in this-procedure ( input 1, input "type"      , input buf_goods.gds-type            , input 0 ).
     4875       run bgelib-tag-put in this-procedure ( input 1, input "minstock"  , input string(buf_goods.min-stock)   , input 0 ).
     4876       run bgelib-tag-put in this-procedure ( input 1, input "okdp"      , input buf_goods.okdp                , input 0 ).
     4877       run bgelib-tag-put in this-procedure ( input 1, input "name"      , input buf_goods.gds-name            , input 0 ).
     4878       if lookup( "good-ext":U, p-mode ) <> 0
     4879       then do:
     4880           define variable v-have-recipe          as logical      no-undo.
     4881           define variable v-is-ingredient        as logical      no-undo.
     4882           define variable v-can-be-income        as logical      no-undo.
     4883           define variable v-can-be-write-off     as logical      no-undo.
     4884           run get-fbr-trn-type in this-procedure (
     4885                 input buf_goods.gds-code
     4886               , output v-have-recipe
     4887               , output v-is-ingredient
     4888               , output v-can-be-income
     4889               , output v-can-be-write-off
     4890           ).
     4891           run bgelib-tag-put in this-procedure ( input 1, input trim( "labelname    " ), input string( buf_goods.label-name    ), input 0 ).
     4892           run bgelib-tag-put in this-procedure ( input 1, input trim( "destin       " ), input string( buf_goods.destin        ), input 0 ).
     4893           run bgelib-tag-put in this-procedure ( input 1, input trim( "attrib       " ), input string( buf_goods.attrib        ), input 0 ).
     4894           run bgelib-tag-put in this-procedure ( input 1, input trim( "userRule     " ), input string( buf_goods.user-rule     ), input 0 ).
     4895           run bgelib-tag-put in this-procedure ( input 1, input trim( "sert         " ), input string( buf_goods.sert          ), input 0 ).
     4896           run bgelib-tag-put in this-procedure ( input 1, input trim( "struct       " ), input string( buf_goods.struct        ), input 0 ).
     4897           run bgelib-tag-put in this-procedure ( input 1, input trim( "deadline     " ), input string( buf_goods.deadline      ), input 0 ).
     4898           run bgelib-tag-put in this-procedure ( input 1, input trim( "sort         " ), input string( buf_goods.sort          ), input 0 ).
     4899           run bgelib-tag-put in this-procedure ( input 1, input trim( "unitCST      " ), input string( buf_goods.unit-cst      ), input 0 ).
     4900           run bgelib-tag-put in this-procedure ( input 1, input trim( "CSTBaseRate  " ), input string( buf_goods.cst-base-rate ), input 0 ).
     4901           run bgelib-tag-put in this-procedure ( input 1, input trim( "nationality  " ), input string( buf_goods.nationality   ), input 0 ).
     4902           run bgelib-tag-put in this-procedure ( input 1, input trim( "normalWastage" ), input string( buf_goods.normal-wastage), input 0 ).
     4903           run bgelib-tag-put in this-procedure ( input 1, input trim( "normalWaste  " ), input string( buf_goods.normal-waste  ), input 0 ).
     4904           run bgelib-tag-put in this-procedure ( input 1, input trim( "haveRecipe   " ), input string( v-have-recipe           ), input 3 ).
     4905           run bgelib-tag-put in this-procedure ( input 1, input trim( "isIngredient " ), input string( v-is-ingredient         ), input 3 ).
     4906           run bgelib-tag-put in this-procedure ( input 1, input trim( "canBeIncome  " ), input string( v-can-be-income         ), input 3 ).
     4907           run bgelib-tag-put in this-procedure ( input 1, input trim( "canBeWriteOff" ), input string( v-can-be-write-off      ), input 3 ).
     4908       end.
     4909       run bgelib-tag-put in this-procedure ( input 1, "Vat"           , input string( v-vat-pc )              , input 0 ).
     4910       run bgelib-tag-put in this-procedure ( input 1, "VATRateCode"   , input string( v-rate-code )           , input 0 ).
     4911       run bgelib-tag-put in this-procedure ( input 1, "SLT"           , input string( v-slt-pc )              , input 0 ).
     4912       run bgelib-tag-put in this-procedure ( input 1, "country"       , input buf_goods.alpha1                , input 0 ).
     4913       run bgelib-tag-put in this-procedure ( input 1, "margin"        , input string( buf_goods.increase-pc ) , input 0 ).
     4914       find first buf_units no-lock
     4915            where buf_units.unit-name = buf_goods.unit-base
     4916       no-error.
     4917       if available buf_units
     4918       then do:
     4919           run bgelib-tag-put in this-procedure ( input 1, input "unitType", input buf_units.type, input 0 ).
     4920       end.
     4921       else do:
     4922           run bgelib-tag-put in this-procedure ( input 1, input "unitType", input "", input 0 ).
     4923           run bgelib-write-log in this-procedure (
     4924               input p-log-file-name,
     4925               input 2,
     4926               input substitute( "*** ERR *** Не найден тип: &1 для товара: &2"
     4927                                   , buf_goods.unit-base
     4928                                   , p-gds-code  )
     4929           ).
     4930       end.
     4931       run bgelib-tag-put in this-procedure ( input 1, input "barcode"     , input string( v-barcode )             , input 0 ).
     4932       run bgelib-tag-put in this-procedure ( input 1, input "groupcode"   , input string(buf_goods.grp-code)      , input 0 ).
     4933       run bgelib-tag-put in this-procedure ( input 1, input "condKeepCode", input string(buf_goods.cond-keep-code), input 0 ).
     4934       run bgelib-tag-put in this-procedure ( input 1, input "unitCli"     , input string( buf_goods.unit-cli        ), input 0 ).
     4935       run bgelib-tag-put in this-procedure ( input 1, input "cliBaseRate" , input string( buf_goods.cli-base-rate   ), input 0 ).
     4936       run bgelib-tag-put in this-procedure ( input 1, input "msCart"      , input string( buf_goods.ms-cart         ), input 0 ).
     4937       run bgelib-tag-put in this-procedure ( input 1, input "wtCart"      , input string( buf_goods.wt-cart         ), input 0 ).
     4938       run bgelib-tag-put in this-procedure ( input 1, input "qntyCart"    , input string( buf_goods.qnty-cart       ), input 0 ).
     4939       run bgelib-tag-put in this-procedure ( input 1, input "msBase"      , input string( buf_goods.ms-base         ), input 0 ).
     4940       run bgelib-tag-put in this-procedure ( input 1, input "wtBase"      , input string( buf_goods.wt-base         ), input 0 ).
     4941       run bgelib-tag-put in this-procedure ( input 1, input "comment"   , input buf_goods.PS              , input 0 ).
     4942       run bgelib-tag-close in this-procedure ( input 0, input "gds").
     4943       for each buf_prod-bc no-lock
     4944          where buf_prod-bc.b-code = v-barcode
     4945       on error undo, return error
     4946       :
     4947           run bgelib-tag-open in this-procedure ( input 0, input "gdsBcode", input "" ).
     4948           run bgelib-tag-put in this-procedure ( input 1, input "goodID"    , input string( buf_goods.gds-code  ), input 0 ).
     4949           run bgelib-tag-put in this-procedure ( input 1, input "bcodeStr"  , input string( buf_prod-bc.b-str   ), input 0 ).
     4950           run bgelib-tag-put in this-procedure ( input 1, input "bcodeOn"   , input string( buf_prod-bc.bc-on   ), input 0 ).
     4951           run bgelib-tag-close in this-procedure ( input 0, input "gdsBcode").
     4952       end.
     4953       output stream stmxmlout close.
     4954   end.
     4955   end procedure.
     4956   procedure get-tax-rate-code :
     4957   define input parameter p-gds-code   as integer          no-undo.
     4958   define input parameter p-tax-code   as integer          no-undo.
     4959   define input parameter p-date       as date             no-undo.
     4960   define output parameter p-rate-code as integer          no-undo.
     4961       define variable v-today             as date         no-undo.
     4962       define variable v-time              as integer      no-undo.
     4963       define variable v-fact-order        as integer      no-undo.
     4964       define buffer buf_tax-rate-gds      for ub.tax-rate-gds.
     4965   do
     4966   for buf_tax-rate-gds
     4967   on error undo, return error
     4968   :
     4969       run cur-time in this-procedure (
     4970             output v-today
     4971           , output v-time
     4972       ).
     4973       if p-date = ?
     4974       then do:
     4975           assign
     4976               p-date = v-today
     4977           .
     4978       end.
     4979       run factord-end-day in this-procedure (
     4980             input p-date
     4981           , output v-fact-order
     4982       ).
     4983       find last buf_tax-rate-gds no-lock
     4984           where buf_tax-rate-gds.gds-code   = p-gds-code
     4985             and buf_tax-rate-gds.tax-code   = p-tax-code
     4986             and buf_tax-rate-gds.host-code  = 0
     4987             and buf_tax-rate-gds.obj-type   = ""
     4988             and buf_tax-rate-gds.obj-code   = 0
     4989             and buf_tax-rate-gds.fact-order <= v-fact-order
     4990       no-error .
     4991       if not available buf_tax-rate-gds
     4992       then do:
     4993           assign
     4994               p-rate-code = 0
     4995           .
     4996       end.
     4997       else do:
     4998           assign
     4999               p-rate-code = buf_tax-rate-gds.rate-code
     5000           .
     5001       end.
     5002   end.
     5003   end procedure.
     5004   procedure get-fbr-trn-type :
     5005   define input parameter p-gds-code           as integer          no-undo.
     5006   define output parameter p-have-recipe       as logical          no-undo.
     5007   define output parameter p-is-ingredient     as logical          no-undo.
     5008   define output parameter p-can-be-income     as logical          no-undo.
     5009   define output parameter p-can-be-write-off  as logical          no-undo.
     5010       define variable v-is-comp       as logical      no-undo.
     5011       define variable v-trn-type      as character    no-undo.
     5012       define variable v-recipe-type   as character    no-undo.
     5013       define buffer buf_goods         for ub.goods.
     5014       define buffer buf_recipe        for ub.recipe.
     5015       define buffer buf_recipe-gds    for ub.recipe-gds.
     5016   do
     5017   for buf_goods
     5018     , buf_recipe
     5019     , buf_recipe-gds
     5020   on error undo, return error
     5021   :
     5022       find first buf_goods no-lock
     5023            where buf_goods.gds-code = p-gds-code
     5024       .
     5025       assign
     5026           p-have-recipe       = no
     5027           p-is-ingredient     = no
     5028           p-can-be-income     = no
     5029           p-can-be-write-off  = no
     5030       .
     5031       find first buf_recipe no-lock
     5032            where buf_recipe.artic       = buf_goods.artic
     5033              and buf_recipe.prod-type   = buf_goods.prod-type
     5034              and buf_recipe.prod-code   = buf_goods.prod-code
     5035       no-error.
     5036       if available buf_recipe
     5037       then do:
     5038           assign
     5039               p-have-recipe = yes
     5040           .
     5041       end.
     5042       find first buf_recipe-gds no-lock
     5043            where buf_recipe-gds.artic       = buf_goods.artic
     5044              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     5045              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     5046       no-error.
     5047       if available buf_recipe-gds
     5048       then do:
     5049           assign
     5050               p-is-ingredient = yes
     5051           .
     5052       end.
     5053       if p-have-recipe = yes
     5054       then do:
     5055           find first buf_recipe no-lock
     5056                where buf_recipe.artic       = buf_goods.artic
     5057                  and buf_recipe.prod-type   = buf_goods.prod-type
     5058                  and buf_recipe.prod-code   = buf_goods.prod-code
     5059                  and buf_recipe.recipe-type = 'комплектация':U
     5060           no-error.
     5061           if available buf_recipe
     5062           then do:
     5063               assign
     5064                   p-can-be-income    = yes
     5065                   p-can-be-write-off = yes
     5066               .
     5067               return .
     5068           end.
     5069           else do:
     5070               calc-trn-type-by-recipe:
     5071               for each buf_recipe no-lock
     5072                  where buf_recipe.artic       = buf_goods.artic
     5073                    and buf_recipe.prod-type   = buf_goods.prod-type
     5074                    and buf_recipe.prod-code   = buf_goods.prod-code
     5075               on error undo, return error
     5076               :
     5077                   run fbrlib-get-trn-type in this-procedure (
     5078                         input buf_recipe.recipe-code
     5079                       , input recid( buf_goods )
     5080                       , input yes
     5081                       , output v-is-comp
     5082                       , output v-trn-type
     5083                   ).
     5084                   if v-trn-type = 'при':U
     5085                   then do:
     5086                       assign
     5087                           p-can-be-income    = yes
     5088                       .
     5089                   end.
     5090                   if v-trn-type = 'спи':U
     5091                   then do:
     5092                       assign
     5093                           p-can-be-write-off = yes
     5094                       .
     5095                   end.
     5096               end.
     5097           end.
     5098       end.
     5099       if p-is-ingredient = yes
     5100       then do:
     5101           calc-trn-type-by-recipe-gds:
     5102           for each buf_recipe-gds no-lock
     5103              where buf_recipe-gds.artic       = buf_goods.artic
     5104                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     5105                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     5106           on error undo, return error
     5107           :
     5108               run fbrlib-get-recipe-type in this-procedure (
     5109                     input "":U
     5110                   , input buf_recipe-gds.recipe-code
     5111                   , output v-recipe-type
     5112               ).
     5113               if v-recipe-type = 'комплектация':U
     5114               then do:
     5115                   assign
     5116                       p-can-be-income    = yes
     5117                       p-can-be-write-off = yes
     5118                   .
     5119                   return .
     5120               end.
     5121               run fbrlib-get-trn-type in this-procedure (
     5122                     input buf_recipe-gds.recipe-code
     5123                   , input recid( buf_goods )
     5124                   , input yes
     5125                   , output v-is-comp
     5126                   , output v-trn-type
     5127               ).
     5128               if v-trn-type = 'при':U
     5129               then do:
     5130                   assign
     5131                       p-can-be-income    = yes
     5132                   .
     5133               end.
     5134               if v-trn-type = 'спи':U
     5135               then do:
     5136                   assign
     5137                       p-can-be-write-off = yes
     5138                   .
     5139               end.
     5140           end.
     5141       end.
     5142   end.
     5143   end procedure.
