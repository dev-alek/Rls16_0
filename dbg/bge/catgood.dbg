     1708   procedure fbrlib_create-fbr-doc :
     1709   define input parameter p-obj-type as character no-undo .
     1710   define input parameter p-obj-code as integer no-undo .
     1711   define input parameter p-userid as character no-undo .
     1712   define output parameter p-fbr-doc-code as character no-undo .
     1713   define output parameter p-recid as recid no-undo .
