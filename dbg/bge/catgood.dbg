      585   procedure xmlchar-decode :
      586   define input parameter p-in-string      as character        no-undo.
      587   define output parameter p-out-string    as character        no-undo.
      588       define variable v-position      as integer      no-undo.
      589       define variable v-last-position as integer      no-undo.
      590       define variable v-temp-integer  as integer      no-undo.
      591       define variable v-current-char  as character    no-undo.
      592       define variable v-next-char     as character    no-undo.
      593       define variable v-success       as logical      no-undo.
      594   do
      595   on error undo, return error
      596   :
      597       assign
      598           p-out-string = "":U
      599           v-position   = 0
      600       .
      601       replace-cycle:
      602       do while yes
      603       on error undo, return error
      604       :
      605           assign
      606               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      607           .
      608           if v-last-position <= v-position
      609           then do:
      610               if v-position = 0
      611               then do:
      612                   assign
      613                       p-out-string = p-in-string
      614                   .
      615               end.
      616               else do:
      617                   assign
      618                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      619                   .
      620               end.
      621               leave replace-cycle.
      622           end.
      623           else do:
      624               assign
      625                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      626                   v-position      = v-last-position
      627                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      628               .
      629               if v-current-char = "#":U
      630               then do:
      631                   assign
      632                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      633                   .
      634                   if v-last-position > 0
      635                   then do:
      636                       run xmlchar-read-integer in this-procedure
      637                        (
      638                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      639                           , output v-temp-integer
      640                           , output v-success
      641                       ).
      642                       if v-success = yes
      643                       and v-temp-integer >= 1
      644                       and v-temp-integer <= 255
      645                       then do:
      646                           assign
      647                               p-out-string = p-out-string + chr( v-temp-integer )
      648                               v-position   = v-last-position + 1
      649                           .
      650                       end.
      651                       else do:
      652                           assign
      653                               p-out-string = p-out-string + "&":U
      654                               v-position   = v-position   + 1
      655                           .
      656                       end.
      657                   end.
      658                   else do:
      659                       assign
      660                           p-out-string = p-out-string + "&":U
      661                           v-position   = v-position   + 1
      662                       .
      663                   end.
      664               end.
      665               else do:
      666                   case substring( p-in-string, v-position + 1, 3 )
      667                   :
      668                       when "lt;":U
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + "<":U
      672                               v-position   = v-position   + 3
      673                           .
      674                       end.
      675                       when "gt;":U
      676                       then do:
      677                           assign
      678                               p-out-string = p-out-string + ">":U
      679                               v-position   = v-position   + 3
      680                           .
      681                       end.
      682                       otherwise do:
      683                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      684                           then do:
      685                               assign
      686                                   p-out-string = p-out-string + "&":U
      687                                   v-position   = v-position   + 4
      688                               .
      689                           end.
      690                           else do:
      691                               case substring( p-in-string, v-position + 1, 5 )
      692                               :
      693                                   when "quot;":U
      694                                   then do:
      695                                       assign
      696                                           p-out-string = p-out-string + '"':U
      697                                           v-position   = v-position   + 5
      698                                       .
      699                                   end.
      700                                   when "apos;":U
      701                                   then do:
      702                                       assign
      703                                           p-out-string = p-out-string + "'":U
      704                                           v-position   = v-position   + 5
      705                                       .
      706                                   end.
      707                                   otherwise do:
      708                                       assign
      709                                           p-out-string = p-out-string + "&":U
      710                                       .
      711                                   end.
      712                               end case.
      713                           end.
      714                       end.
      715                   end case.
      716               end.
      717           end.
      718       end.
      719   end.
      720   end .
      721   procedure xmlchar-read-integer :
      722   define input parameter p-input-string      as character        no-undo.
      723   define output parameter p-output-integer   as integer          no-undo.
      724   define output parameter p-success       as logical          no-undo.
      725   do
      726   on error undo, return error
      727   :
      728       assign
      729           p-output-integer = integer( p-input-string )
      730       no-error.
      731       if error-status :error
      732       then do:
      733           assign
      734               p-success           = no
      735               p-output-integer    = 0
      736           .
      737       end.
      738       else do:
      739           assign
      740               p-success           = yes
      741           .
      742       end.
      743   end.
      744   end.
      745   define variable v-bgelib-bgeclall           as logical      no-undo.
      746   define variable v-bgelib-bgedict            as logical      no-undo.
      747   define temp-table temp_ext-doc-type no-undo
      748       field edt-key               as integer
      749       field ext-doc-type          as character
      750       field ext-doc-type-label    as character
      751       index pi is primary unique
      752           edt-key
      753   .
      754   define temp-table temp_bgelib_goods no-undo
      755       field gds-code as integer
      756       index pi is primary unique
      757           gds-code
      758   .
      759   define temp-table temp_bgelib_clients no-undo
      760       field obj-type as character
      761       field obj-code as integer
      762       index pi is primary unique
      763           obj-type
      764           obj-code
      765   .
      766   define temp-table temp_bgelib_dis-card no-undo
      767       field d-card as character
      768       index pi is primary unique
      769           d-card
      770   .
      771   define temp-table temp_bgelib_trn-doc no-undo
      772       field doc-code as integer
      773   .
      774   procedure bgelib-tag-open:
      775   do
      776   on error undo, return error
      777   :
      778   define input parameter v-tag-level  as integer      no-undo.
      779   define input parameter v-tag-name   as character    no-undo.
      780   define input parameter v-tag-value  as character    no-undo.
      781       put stream stmXMLOut unformatted
      782           chr(10)
      783           + fill(" ", 4 * v-tag-level)
      784           + "<" + v-tag-name
      785           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      786           + v-tag-value + ">"
      787       .
      788   end.
      789   end procedure.
      790   procedure bgelib-tag-put:
      791   do
      792   on error undo, return error
      793   :
      794   define input parameter v-tag-level      as integer      no-undo.
      795   define input parameter v-tag-name       as character    no-undo.
      796   define input parameter v-tag-value      as character    no-undo.
      797   define input parameter v-empty-mode     as integer      no-undo.
      798       v-tag-name = trim(v-tag-name).
      799       if  v-empty-mode = 1
      800       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      801       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      802       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      803       then do:
      804           run xmlchar-encode in this-procedure (
      805                 input v-tag-value
      806               , output v-tag-value
      807           ).
      808           put stream stmXMLOut unformatted
      809               chr(10) + fill(" ", 4 * v-tag-level)
      810                           + '<' + v-tag-name + '>'
      811                           + v-tag-value
      812                           + '</' + v-tag-name + '>'
      813           .
      814       end.
      815   end.
      816   end procedure.
      817   procedure bgelib-tag-close:
      818   do
      819   on error undo, return error
      820   :
      821   define input parameter v-tag-level as integer      no-undo.
      822   define input parameter v-tag-name  as character    no-undo.
      823       put stream stmXMLOut unformatted
      824           chr(10)
      825           + fill( " ", 4 * v-tag-level)
      826           + '</' + v-tag-name + '>'
      827       .
      828   end.
      829   end procedure.
      830   procedure bgelib-write-log:
      831   do
      832   on error undo, return error
      833   :
      834   define input parameter v-filename   as character    no-undo.
      835   define input parameter v-log-level  as integer      no-undo.
      836   define input parameter v-out-string as character    no-undo.
      837       output stream stmXMLLog to value( v-filename ) append.
      838       put stream stmXMLLog unformatted
      839           chr(10)
      840       .
      841       put stream stmXMLLog unformatted
      842           ( if v-log-level = 0
      843             or v-out-string = "&DLine"
      844             or v-out-string = "&Line"
      845             then ""
      846             else cur-time-string-sec() + " " )
      847       .
      848       put stream stmXMLLog unformatted
      849           ( if v-out-string = "&Line"
      850             then fill( "-", 80 )
      851             else if v-out-string = "&DLine"
      852                  then fill( "=", 80 )
      853                  else v-out-string )
      854       .
      855       output stream stmXMLLog close.
      856   end.
      857   end procedure.
      858   procedure bgelib-write-edt:
      859   do
      860   on error undo, return error
      861   :
      862   define input parameter v-editor-handle    as handle       no-undo.
      863   define input parameter v-log-level        as integer      no-undo.
      864   define input parameter v-out-string       as character    no-undo.
      865       if valid-handle ( v-editor-handle )
      866       then do:
      867           v-editor-handle :move-to-eof().
      868           v-editor-handle :insert-string( ( if v-log-level = 0
      869                                             or v-out-string = "&DLine"
      870                                             or v-out-string = "&Line"
      871                                             then ""
      872                                             else cur-time-string-sec() + " "
      873                                         ) ).
      874           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      875                                             then fill( "-", 80 )
      876                                             else if v-out-string = "&DLine" then fill("=", 80)
      877                                             else fill( " ", v-log-level) + v-out-string
      878                                         ) ).
      879           v-editor-handle :insert-string( chr(10) ).
      880       end.
      881       process events.
      882       output to 'bgescn.txt' append.
      883           put unformatted
      884               chr(10)
      885               string( ( if v-log-level = 0
      886                         or v-out-string = "&DLine"
      887                         or v-out-string = "&Line"
      888                         then ""
      889                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      890                     ) )
      891               string( ( if v-out-string = "&Line"
      892                         then fill( "-", 80 )
      893                         else if v-out-string = "&DLine"
      894                              then fill( "=", 80 )
      895                              else fill( " ", v-log-level ) + v-out-string
      896                     ) )
      897           .
      898       output close.
      899   end.
      900   end procedure.
      901   procedure bgelib-show-cnt:
      902   do
      903   on error undo, return error
      904   :
      905   define input parameter v-fillin-handle     as handle   no-undo.
      906       if valid-handle( v-fillin-handle )
      907       then do:
      908           assign
      909               v-fillin-handle :visible = true
      910           .
      911       end.
      912   end.
      913   end procedure.
      914   procedure bgelib-hide-cnt:
      915   do
      916   on error undo, return error
      917   :
      918   define input parameter v-fillin-handle     as handle   no-undo.
      919       if valid-handle( v-fillin-handle )
      920       then do:
      921           assign v-fillin-handle :visible = false.
      922       end.
      923   end.
      924   end procedure.
      925   procedure bgelib-write-cnt:
      926   do
      927   on error undo, return error
      928   :
      929   define input parameter v-fillin-handle    as handle       no-undo.
      930   define input parameter v-fillin-string    as character    no-undo.
      931       if valid-handle( v-fillin-handle )
      932       then do:
      933           assign
      934               v-fillin-handle :SCREEN-value = v-fillin-string
      935           .
      936       end.
      937   end.
      938   end procedure.
      939   procedure bgelib-write-header:
      940   do
      941   on error undo, return error
      942   :
      943   define input parameter p-first-file     as logical      no-undo.
      944   define input parameter p-xml-file-name  as character    no-undo.
      945   define input parameter p-list-file-name as character    no-undo.
      946   define input parameter p-file-number    as integer      no-undo.
      947   define input parameter p-have-prev      as logical      no-undo.
      948   define input parameter p-prev-filename  as character    no-undo.
      949   define input parameter p-obj-list       as character    no-undo.
      950   define input parameter p-doc-type-list  as character    no-undo.
      951   define input parameter p-parameter-list as character    no-undo.
      952       define variable v-counter    as integer        no-undo.
      953       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      954       put stream stmXMLOut unformatted
      955           "<?xml version='1.0' encoding='windows-1251'?>"
      956       .
      957       run bgelib-tag-open( input 0, input "root"  , input "" ).
      958       run bgelib-tag-open( input 0, input "header", input "" ).
      959       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      960       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      961       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      962       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      963       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      964       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      965       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      966       :
      967           run bgelib-tag-put(
      968                 input 1
      969               , input entry( 2 * v-counter, p-parameter-list )
      970               , input entry( 2 * v-counter + 1, p-parameter-list )
      971               , input 0
      972           ).
      973       end.
      974       run bgelib-tag-close( input 0, input "header" ).
      975       output stream stmXMLOut close.
      976       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      977       if p-first-file = yes
      978       then do:
      979           put stream stmXMLOut unformatted
      980               "<?xml version='1.0' encoding='windows-1251'?>"
      981           .
      982           run bgelib-tag-open( input 0, input "export", input "" ).
      983       end.
      984       run bgelib-tag-open( input 1, input "file", input "" ).
      985       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      986       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      987       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      988       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      989       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      990       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      991       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      992       :
      993           run bgelib-tag-put(
      994                 input 2
      995               , input trim(entry( 2 * v-counter, p-parameter-list ))
      996               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      997               , input 0
      998           ).
      999       end.
     1000       run bgelib-tag-close( input 1, input "file" ).
     1001       output stream stmXMLOut close.
     1002   end.
     1003   end procedure.
     1004   procedure bgelib-write-footer:
     1005   do
     1006   on error undo, return error
     1007   :
     1008   define input parameter p-last-file      as logical      no-undo.
     1009   define input parameter p-xml-file-name  as character    no-undo.
     1010   define input parameter p-list-file-name as character    no-undo.
     1011   define input parameter p-have-next      as logical      no-undo.
     1012   define input parameter p-next-file-name as character    no-undo.
     1013       define variable v-error-num     as integer           no-undo.
     1014       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1015       if p-have-next = yes
     1016       then do:
     1017           run bgelib-tag-open( input 0, input "footer", "" ).
     1018           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1019           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1020           run bgelib-tag-close( input 0, input "footer" ).
     1021       end.
     1022       run bgelib-tag-close( input 0, input "root" ).
     1023       output stream stmXMLOut close.
     1024       run bge/os_copy.p (
     1025             input "M"
     1026           , input p-xml-file-name + "tmp"
     1027           , input p-xml-file-name + "xml"
     1028           , output v-error-num
     1029       ).
     1030       if p-last-file = yes
     1031       then do:
     1032           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1033               run bgelib-tag-close( input 0, input "export" ).
     1034           output stream stmXMLOut close.
     1035           run bge/os_copy.p (
     1036                 input "M"
     1037               , input p-list-file-name + "tmp"
     1038               , input p-list-file-name + "xml"
     1039               , output v-error-num
     1040           ).
     1041       end.
     1042   end.
     1043   end procedure.
     1044   procedure bgelib-filename :
     1045   do
     1046   on error undo, return error
     1047   :
     1048   define input parameter p-prefix             as character    no-undo.
     1049   define output parameter p-xml-file-name     as character    no-undo.
     1050   define output parameter p-log-file-name     as character    no-undo.
     1051   define output parameter p-list-file-name    as character    no-undo.
     1052       define variable v-home-dir  as character    no-undo.
     1053       define variable v-error-num as integer      no-undo.
     1054       get-key-value section "BGE" key "outdir" value v-home-dir.
     1055       if v-home-dir = ?
     1056       then do:
     1057           message
     1058             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1059             skip(1)
     1060             skip "Обратитесь к администратору."
     1061           view-as alert-box error.
     1062           undo, return error .
     1063       end.
     1064       run gbl/dir-cre.p (
     1065           input v-home-dir
     1066       ) no-error.
     1067       if error-status :error
     1068       then do:
     1069           message
     1070             skip "Неверно задан каталог экспорта."
     1071             skip(1)
     1072             skip "Обратитесь к администратору."
     1073           view-as alert-box error.
     1074           undo, return error .
     1075       end.
     1076       run bge/genfname.p (
     1077             input v-home-dir
     1078           , input p-prefix
     1079           , input ""
     1080           , input "xml"
     1081           , input "tmp"
     1082           , output p-xml-file-name
     1083       ).
     1084       assign
     1085           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1086           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1087           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1088       .
     1089   end.
     1090   end procedure.
     1091   procedure bgelib-read-config :
     1092   do
     1093   on error undo, return error
     1094   :
     1095   define variable v-par-type as character     no-undo.
     1096     define variable v-param-type      as character  no-undo .
     1097     define variable v-value-character as character  no-undo .
     1098     define variable v-value-date      as date       no-undo .
     1099     define variable v-value-decimal   as decimal    no-undo .
     1100     define variable v-value-integer   as integer    no-undo .
     1101     define variable v-value-logical   as logical    no-undo .
     1102     define variable v-tth             as handle     no-undo .
     1103       assign
     1104           v-bgelib-bgeclall = no
     1105           v-bgelib-bgedict  = no
     1106       .
     1107       run adm/shattri.p ( input "get":U
     1108                         , input  '':u
     1109                         , input  0
     1110                         , input  'bge-export':U
     1111                         , input  'bgeclall':U
     1112                         , output v-value-character
     1113                         , output v-value-date
     1114                         , output v-value-decimal
     1115                         , output v-value-integer
     1116                         , output v-value-logical
     1117                         , output v-param-type
     1118                         , input-output table-handle v-tth
     1119                         ) no-error .
     1120       if error-status :error
     1121       then do:
     1122         assign
     1123           v-bgelib-bgeclall = no
     1124         .
     1125       end.
     1126       else do:
     1127         assign
     1128           v-bgelib-bgeclall = v-value-logical
     1129         .
     1130       end.
     1131       delete object v-tth.
     1132       run adm/shattri.p ( input "get":U
     1133                         , input  '':u
     1134                         , input  0
     1135                         , input  'bge-export':U
     1136                         , input  'bgedict':U
     1137                         , output v-value-character
     1138                         , output v-value-date
     1139                         , output v-value-decimal
     1140                         , output v-value-integer
     1141                         , output v-value-logical
     1142                         , output v-param-type
     1143                         , input-output table-handle v-tth
     1144                         ) no-error .
     1145       if error-status :error
     1146       then do:
     1147         assign
     1148           v-bgelib-bgedict = no
     1149         .
     1150       end.
     1151       else do:
     1152         assign
     1153           v-bgelib-bgedict = v-value-logical
     1154         .
     1155       end.
     1156       delete object v-tth.
     1157       run adm/shattri.p ( input "get":U
     1158                         , input  '':u
     1159                         , input  0
     1160                         , input  'bge-export':U
     1161                         , input  'bgefmt':U
     1162                         , output v-value-character
     1163                         , output v-value-date
     1164                         , output v-value-decimal
     1165                         , output v-value-integer
     1166                         , output v-value-logical
     1167                         , output v-param-type
     1168                         , input-output table-handle v-tth
     1169                         ) no-error .
     1170       if error-status :error
     1171       then do:
     1172         assign
     1173           v-bgelib-bgefmt  = "xml":U
     1174         .
     1175       end.
     1176       else do:
     1177         assign
     1178           v-bgelib-bgefmt  = v-value-character
     1179         .
     1180       end.
     1181       delete object v-tth.
     1182       run adm/shattri.p ( input "get":U
     1183                         , input  '':u
     1184                         , input  0
     1185                         , input  'bge-export':U
     1186                         , input  'bgeflold':U
     1187                         , output v-value-character
     1188                         , output v-value-date
     1189                         , output v-value-decimal
     1190                         , output v-value-integer
     1191                         , output v-value-logical
     1192                         , output v-param-type
     1193                         , input-output table-handle v-tth
     1194                         ) no-error .
     1195       if error-status :error
     1196       then do:
     1197         assign
     1198           v-bgelib-bgeflold  = "old":U
     1199         .
     1200       end.
     1201       else do:
     1202         assign
     1203           v-bgelib-bgeflold  = v-value-character
     1204         .
     1205       end.
     1206       delete object v-tth.
     1207   end.
     1208   end procedure.
     1209   procedure bgelib-check-file-size :
     1210   do
     1211   on error undo, return error
     1212   :
     1213   define input parameter p-out-filename   as character    no-undo.
     1214   define output parameter p-is-big        as logical      no-undo.
     1215       define variable v-current-position    as integer        no-undo.
     1216       assign
     1217           v-current-position = seek( stmXMLOut )
     1218       .
     1219       if v-current-position / 1024 / 1024  >= 100
     1220       then do:
     1221           assign
     1222               p-is-big = yes
     1223           .
     1224       end.
     1225   end.
     1226   end procedure.
     1227   procedure bgelib-init-ext-doc-type :
     1228       define variable v-counter    as integer      no-undo.
     1229       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1230   do
     1231   for buf_temp_ext-doc-type
     1232   on error undo, return error
     1233   :
     1234       empty temp-table buf_temp_ext-doc-type.
     1235       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1236       :
     1237           create buf_temp_ext-doc-type.
     1238           assign
     1239               buf_temp_ext-doc-type.edt-key               = v-counter
     1240               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1241               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1242           .
     1243       end.
     1244   end.
     1245   end procedure.
     1246   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   procedure factord :
     1248     define input  parameter p-fact-date            as date    no-undo .
     1249     define input  parameter p-fact-time            as integer no-undo .
     1250     define input  parameter p-fact-num             as integer no-undo .
     1251     define input  parameter p-shift-date           as date    no-undo .
     1252     define input  parameter p-shift-num            as integer no-undo .
     1253     define input  parameter p-shift-on             as logical no-undo .
     1254     define output parameter p-fact-order           as decimal no-undo .
     1255     define output parameter p-shift-end-fact-order as decimal no-undo .
     1256     define output parameter p-day-end-fact-order   as decimal no-undo .
     1257     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1258     if p-fact-date = ?
     1259     then do:
     1260       return error "Не указана фактическая дата" .
     1261     end.
     1262     define variable v-fact-date-num as integer no-undo .
     1263     assign
     1264       v-fact-date-num = integer(p-fact-date)
     1265     .
     1266     if p-fact-num = ?
     1267     or p-fact-num = 0
     1268     then do:
     1269       return error "Не задан p-fact-num " + string(p-fact-num) .
     1270     end.
     1271     if p-fact-num < 0
     1272     then do:
     1273       return error "Отрицательный fact-num " + string(p-fact-num) .
     1274     end.
     1275     if p-fact-num >= 100000000
     1276     then do:
     1277       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1278     end.
     1279     if p-shift-on = true
     1280     then do:
     1281       if p-shift-date = ?
     1282       then do:
     1283         return error "Не задана дата смены" .
     1284       end.
     1285       if p-shift-num = ?
     1286       or p-shift-num = 0
     1287       then do:
     1288         return error "Не задан номер смены" .
     1289       end.
     1290     end.
     1291     else do:
     1292       assign
     1293         p-shift-date = p-fact-date
     1294         p-shift-num  = 24
     1295       .
     1296     end.
     1297     define variable v-shift-offset as integer no-undo .
     1298     if p-shift-date = p-fact-date
     1299     then do:
     1300       assign
     1301         v-shift-offset = 1
     1302       .
     1303     end.
     1304     if p-shift-date < p-fact-date
     1305     then do:
     1306       assign
     1307         v-shift-offset = 0
     1308       .
     1309     end.
     1310     if p-shift-date > p-fact-date
     1311     then do:
     1312       message
     1313         vss-workfile vss-revision vss-description skip
     1314         "Неправильная дата закрытия смены" skip
     1315         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1316         view-as alert-box error .
     1317       undo, return error
     1318         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1319           ,string(p-fact-date, '99/99/9999':U)
     1320           ,string(p-shift-date, '99/99/9999':U)
     1321           )
     1322       .
     1323     end.
     1324     if p-shift-num < 1
     1325     or p-shift-num > 24
     1326     then do:
     1327       message
     1328         vss-workfile vss-revision vss-description skip
     1329         "Неправильный номер смены" skip
     1330         "p-shift-num" p-shift-num skip
     1331         view-as alert-box error .
     1332       undo, return error return-value .
     1333     end.
     1334     assign
     1335       p-fact-order           = v-fact-date-num
     1336                              + v-shift-offset * 0.5
     1337                              + p-shift-num    * 0.02 - 0.01
     1338                              + p-fact-num     * 0.0000000001
     1339       p-shift-end-fact-order = v-fact-date-num
     1340                              + v-shift-offset * 0.5
     1341                              + p-shift-num    * 0.02
     1342       p-day-end-fact-order   = v-fact-date-num
     1343                              + 0.99
     1344     .
     1345     if p-fact-order           <= v-fact-date-num
     1346     or p-shift-end-fact-order <= v-fact-date-num
     1347     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1348     or p-shift-end-fact-order >= p-day-end-fact-order
     1349     then do:
     1350       message
     1351         vss-workfile vss-revision vss-description skip
     1352         "Внутренняя ошибка при генерации фактического номера" skip
     1353         "p-fact-date"            p-fact-date            skip
     1354         "p-fact-time"            p-fact-time            skip
     1355         "p-fact-num"             p-fact-num             skip
     1356         "p-shift-date"           p-shift-date           skip
     1357         "p-shift-num"            p-shift-num            skip
     1358         "p-shift-on"             p-shift-on             skip
     1359         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1360         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1361         "v-fact-date-num"        v-fact-date-num        skip
     1362         view-as alert-box error .
     1363       undo, return error return-value .
     1364     end.
     1365   end procedure.
     1366   procedure day-begin-fact-order :
     1367     define input  parameter p-fact-date            as date    no-undo .
     1368     define output parameter p-day-begin-fact-order as decimal no-undo .
     1369     do
     1370     on error undo, return error return-value
     1371     :
     1372       if p-fact-date = ?
     1373       then do:
     1374         assign
     1375           p-day-begin-fact-order = 0
     1376         .
     1377       end.
     1378       else do:
     1379         assign
     1380           p-day-begin-fact-order = integer(p-fact-date)
     1381         .
     1382       end.
     1383     end.
     1384   end procedure.
     1385   procedure factord-max-fact-order :
     1386     define output parameter p-max-fact-order as decimal   no-undo .
     1387     do
     1388     on error undo, return error return-value
     1389     :
     1390       run day-begin-fact-order in this-procedure
     1391         (input  date(1, 1, 5000)
     1392         ,output p-max-fact-order
     1393         ) .
     1394     end.
     1395   end procedure.
     1396   procedure factord-cut-archive :
     1397     define input  parameter p-obj-type             as character no-undo .
     1398     define input  parameter p-obj-code             as integer   no-undo .
     1399     define input  parameter p-fact-date            as date      no-undo .
     1400     define output parameter p-shift-on             as logical   no-undo .
     1401     define output parameter p-shift-date           as date      no-undo .
     1402     define output parameter p-shift-num            as integer   no-undo .
     1403     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1404     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1405     define variable v-fact-order as decimal   no-undo .
     1406     define buffer buf_shift-obj for ub.shift-obj .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1412     (input  p-obj-type
     1413     ,input  p-obj-code
     1414     ,input  'shift-on=request'
     1415     ,output p-shift-on
     1416     ) no-error .
     1417       if error-status :error
     1418       then do:
     1419         message
     1420           vss-workfile vss-revision vss-description skip
     1421           "Ошибка при определении атрибута объекта" skip
     1422           "Объект" p-obj-type p-obj-code skip
     1423           error-status :get-message(1) skip
     1424           return-value skip
     1425           view-as alert-box error .
     1426         undo, return error return-value .
     1427       end.
     1428       if p-shift-on = false
     1429       then do:
     1430         assign
     1431           p-shift-date               = ?
     1432           p-shift-num                = 0
     1433         .
     1434       end.
     1435       else do:
     1436         find first buf_shift-obj share-lock
     1437           where buf_shift-obj.obj-type   = p-obj-type
     1438             and buf_shift-obj.obj-code   = p-obj-code
     1439             and buf_shift-obj.shift-date > p-fact-date
     1440           use-index pi
     1441           no-error .
     1442         if not available buf_shift-obj
     1443         or buf_shift-obj.status_ <> 'зкр':U
     1444         then do:
     1445           message
     1446             vss-workfile vss-revision vss-description skip
     1447             "Невозможно вычислить последнюю смену" skip
     1448             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1449             "Объект" p-obj-type p-obj-code skip
     1450             "Дата" p-fact-date skip
     1451             view-as alert-box error .
     1452           undo, return error return-value .
     1453         end.
     1454         find last buf_shift-obj share-lock
     1455           where buf_shift-obj.obj-type = p-obj-type
     1456             and buf_shift-obj.obj-code = p-obj-code
     1457             and buf_shift-obj.shift-date <= p-fact-date
     1458           use-index pi
     1459           no-error .
     1460         if available buf_shift-obj
     1461         then do:
     1462           if  buf_shift-obj.status_ = 'зкр':U
     1463           then do:
     1464             assign
     1465               p-shift-date = buf_shift-obj.shift-date
     1466               p-shift-num  = buf_shift-obj.shift-num
     1467             .
     1468           end.
     1469           else do:
     1470             message
     1471               vss-workfile vss-revision vss-description skip
     1472               "Невозможно вычислить последнюю смену" skip
     1473               "Статус смены отличен от статуса" 'зкр':U skip
     1474               "Объект" p-obj-type p-obj-code skip
     1475               "Дата" p-fact-date skip
     1476               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1477               view-as alert-box error .
     1478             undo, return error return-value .
     1479           end.
     1480         end.
     1481         else do:
     1482           assign
     1483             p-shift-date = p-fact-date - 1
     1484             p-shift-num  = 1
     1485           .
     1486         end.
     1487       end.
     1488       run factord in this-procedure
     1489         (input  p-fact-date
     1490         ,input  1
     1491         ,input  1
     1492         ,input  p-shift-date
     1493         ,input  p-shift-num
     1494         ,input  p-shift-on
     1495         ,output v-fact-order
     1496         ,output p-shift-end-fact-order
     1497         ,output p-day-end-fact-order
     1498         ) no-error .
     1499       if error-status :error
     1500       then do:
     1501         message
     1502           vss-workfile vss-revision vss-description skip
     1503           "Ошибка при вызове процедуры factord"
     1504           error-status :get-message(1) skip
     1505           return-value skip
     1506           view-as alert-box error .
     1507         undo, return error return-value .
     1508       end.
     1509     end.
     1510   end procedure.
     1511   procedure factord-lock-shift :
     1512     define input  parameter p-obj-type  as character no-undo .
     1513     define input  parameter p-obj-code  as integer   no-undo .
     1514     define input  parameter p-fact-date as date      no-undo .
     1515     define parameter buffer buf_shift-obj for ub.shift-obj .
     1516     define variable v-shift-on      as logical   no-undo .
     1517     define variable v-extra-message as character no-undo .
     1518     define variable v-error as character no-undo .
     1519     do
     1520     on error undo, return error return-value
     1521     :
     1522   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1523   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1524     (input  p-obj-type
     1525     ,input  p-obj-code
     1526     ,input  'shift-on=request'
     1527     ,output v-shift-on
     1528     ) no-error .
     1529       if error-status :error
     1530       then do:
     1531         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1532         undo, return error v-error .
     1533       end.
     1534       if v-shift-on = true
     1535       then do:
     1536         find first buf_shift-obj share-lock
     1537           where buf_shift-obj.obj-type   = p-obj-type
     1538             and buf_shift-obj.obj-code   = p-obj-code
     1539             and buf_shift-obj.shift-date > p-fact-date
     1540           use-index pi
     1541           no-error .
     1542         if not available buf_shift-obj
     1543         or buf_shift-obj.status_ <> 'зкр':U
     1544         then do:
     1545           find last buf_shift-obj
     1546             where buf_shift-obj.obj-type = p-obj-type
     1547               and buf_shift-obj.obj-code = p-obj-code
     1548               and buf_shift-obj.status_  = 'зкр':U
     1549             use-index stts
     1550             no-error .
     1551           if available buf_shift-obj
     1552           then do:
     1553             assign
     1554               v-extra-message =
     1555                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1556                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1557                               )
     1558             .
     1559           end.
     1560           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1561           undo, return error v-error .
     1562         end.
     1563       end.
     1564     end.
     1565   end procedure.
     1566   procedure factord-end-day :
     1567     define input  parameter p-fact-date            as date    no-undo .
     1568     define output parameter p-day-end-fact-order   as decimal no-undo .
     1569     do
     1570     on error undo, return error return-value
     1571     :
     1572       if p-fact-date = ?
     1573       then do:
     1574         return error "Не указана фактическая дата" .
     1575       end.
     1576       assign
     1577         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1578       .
     1579     end.
     1580   end procedure.
     1581   procedure factord-to-date :
     1582     define input  parameter p-fact-order as decimal no-undo .
     1583     define output parameter p-fact-date  as date    no-undo .
     1584     define variable v-ref-date  as date      no-undo .
     1585     define variable v-ref-delta as integer   no-undo .
     1586     do
     1587     on error undo, return error return-value
     1588     :
     1589       if p-fact-order = ?
     1590       or p-fact-order = 0
     1591       then do:
     1592         return error "Не указан fact-order" .
     1593       end.
     1594       assign
     1595         v-ref-date  = date(1, 1, 2000)
     1596       .
     1597       assign
     1598         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1599       .
     1600       assign
     1601         p-fact-date = v-ref-date + v-ref-delta
     1602       .
     1603     end.
     1604   end procedure.
     1605   procedure factord-to-fact-num :
     1606     define input  parameter p-fact-order as decimal no-undo .
     1607     define output parameter p-fact-num   as integer no-undo .
     1608     define variable v-fact-order-trunc as decimal no-undo .
     1609     do
     1610     on error undo, return error return-value
     1611     :
     1612       if p-fact-order = ?
     1613       or p-fact-order = 0
     1614       then do:
     1615         return error "Не указан fact-order" .
     1616       end.
     1617       assign
     1618        v-fact-order-trunc = truncate(p-fact-order, 2)
     1619       .
     1620       assign
     1621         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1622       .
     1623     end.
     1624   end procedure.
     1625   procedure factord-to-shift-num :
     1626     define input  parameter p-fact-order as decimal no-undo .
     1627     define output parameter p-shift-num   as integer no-undo .
     1628     define variable  p-shift-numd  as decimal   no-undo .
     1629     define variable v-fact-order-trunc as decimal no-undo .
     1630     do
     1631     on error undo, return error return-value
     1632     :
     1633       if p-fact-order = ?
     1634       or p-fact-order = 0
     1635       then do:
     1636         return error "Не указан fact-order" .
     1637       end.
     1638       assign
     1639        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1640       .
     1641       if v-fact-order-trunc < 0.5 then do:
     1642         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1643       end.
     1644       assign
     1645         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1646         .
     1647        assign
     1648         p-shift-num = truncate (p-shift-numd , 0)
     1649       .
     1650     end.
     1651   end procedure.
     1652   define variable vss-include-info6 as character format "X(65)" no-undo
     1653   initial "@(#)$Workfile$ $Revision$".
