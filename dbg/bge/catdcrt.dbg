        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Apr 10 12:04:11 2018 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: catdcrt.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/catdcrt.p $":U .
        7   define variable vss-description as character no-undo init "Выгрузка справочника дисконтных карт".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "X(65)" no-undo
       67   initial "@(#)$Workfile$ $Revision$".
       68   define variable v-bgelib-bgefmt        as character         no-undo.
       69   define variable v-bgelib-bgeflold      as character         no-undo.
       70   define stream stmXMLOut.
       71   define stream stmXMLLog.
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure cur-time :
       74      define output parameter p-today as date      no-undo .
       75      define output parameter p-time  as integer   no-undo .
       76     do
       77     on error undo, return error
       78     :
       79       define variable v-date1 as date      no-undo .
       80       define variable v-date2 as date      no-undo .
       81       define variable v-time  as integer   no-undo .
       82       assign
       83         v-date1 = today
       84         v-time  = time
       85         v-date2 = today
       86       .
       87       if v-date1 <> v-date2
       88       then do:
       89         assign
       90           v-date1 = today
       91           v-time  = v-time
       92         .
       93       end.
       94       assign
       95         p-today = v-date1
       96         p-time  = v-time
       97       .
       98     end.
       99   end.
      100   function cur-time-date returns character
      101   :
      102     return string(today, '99/99/9999':U) .
      103   end.
      104   function cur-time-mjd returns decimal
      105   :
      106     define variable v-date as date      no-undo .
      107     define variable v-time as integer   no-undo .
      108     run cur-time in this-procedure
      109       (output v-date
      110       ,output v-time
      111       ) .
      112     return integer(v-date) - 2400002 + (v-time / 86400) .
      113   end.
      114   function cur-time-get-ending-index returns integer
      115   (input p-number as integer
      116   )
      117   :
      118     if p-number < 0
      119     or p-number = ?
      120     then do:
      121       return 1 .
      122     end.
      123     define variable v-rest as integer   no-undo .
      124     assign
      125       p-number = p-number modulo 100
      126     .
      127     if p-number < 20
      128     then do:
      129       assign
      130         v-rest = p-number
      131       .
      132     end.
      133     else do:
      134       assign
      135         v-rest = p-number modulo 10
      136       .
      137     end.
      138     case v-rest :
      139       when 1
      140       then do:
      141         return 2 .
      142       end.
      143       when 2 or
      144       when 3 or
      145       when 4
      146       then do:
      147         return 3 .
      148       end.
      149       otherwise do:
      150         return 1 .
      151       end.
      152     end case .
      153   end.
      154   procedure cur-time-mjd-to-date :
      155      define input  parameter i-mjd-diff as decimal no-undo.
      156      define output parameter o-Date     as date    no-undo.
      157      define output parameter o-Time     as integer no-undo.
      158      define variable v-day-number as integer   no-undo .
      159      if    i-mjd-diff < 0
      160         or i-mjd-diff = ?
      161      then do:
      162         return "?" .
      163      end.
      164      assign
      165         v-day-number = truncate(i-mjd-diff,0).
      166         o-Date = date(v-day-number + 2400002).
      167         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      168     .
      169   end.
      170   function cur-time-mjd-to-string returns character
      171   (input p-mjd-diff as decimal
      172   )
      173   :
      174     define variable v-day-number as integer   no-undo .
      175     define variable v-seconds    as integer   no-undo .
      176     define variable v-hour       as integer   no-undo .
      177     define variable v-min        as integer   no-undo .
      178     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      179     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      180     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      181     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      182     if p-mjd-diff < 0
      183     or p-mjd-diff = ?
      184     then do:
      185       return "?" .
      186     end.
      187     assign
      188       v-day-number = integer(truncate(p-mjd-diff,0))
      189       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191     if v-seconds > 86400
      192     then do:
      193       assign
      194         v-seconds = 86400 - 1
      195       .
      196     end.
      197     if v-seconds < 0
      198     then do:
      199       assign
      200         v-seconds = 0
      201       .
      202     end.
      203     assign
      204       v-hour = truncate(v-seconds / 3600, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 3600
      208     .
      209     assign
      210       v-min = truncate(v-seconds / 60, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 60
      214     .
      215     return
      216         (if v-day-number <> 0
      217           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0
      221           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      225           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      226           else ""
      227         )
      228       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      229       .
      230   end.
      231   function cur-time-string returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-string-sec returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      250   end.
      251   function cur-time-custom  returns character
      252   (input p-prefix as character
      253   ,input p-date-format as character
      254   ,input p-delimiter as character
      255   ,input p-time-format as character
      256   ,input p-suffix as character
      257   )
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return
      266       p-prefix
      267       + string(v-date, p-date-format)
      268       + p-delimiter
      269       + string(v-time, p-time-format)
      270       + p-suffix
      271       .
      272   end.
      273   function cur-time-print  returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-datetime returns datetime
      284   :
      285     define variable v-char as character no-undo .
      286     define variable v-datetime as datetime no-undo .
      287     v-char = cur-time-string().
      288     v-datetime = datetime(v-char).
      289     return  v-datetime.
      290   end.
      291   function cur-time-string-msec returns character
      292   :
      293     define variable v-date as datetime  no-undo .
      294     v-date = now.
      295     return string(v-date) .
      296   end.
      297   define variable vss-include-info2 as character format "X(65)" no-undo
      298   initial "@(#)$Workfile$ $Revision$".
      299   procedure xmlchar-test :
      300   define input parameter p-in-string          as character        no-undo.
      301   define output parameter p-out-string-enc    as character        no-undo.
      302   define output parameter p-out-string-dec    as character        no-undo.
      303   do
      304   on error undo, return error
      305   :
      306          run xmlchar-encode in this-procedure
      307       (
      308             input p-in-string
      309           , output p-out-string-enc
      310       ).
      311          run xmlchar-decode in this-procedure
      312       (
      313             input p-out-string-enc
      314           , output p-out-string-dec
      315       ).
      316   end.
      317   end .
      318   procedure xmlchar-encode :
      319   define input parameter p-in-string      as character        no-undo.
      320   define output parameter p-out-string    as character        no-undo.
      321       define variable v-position      as integer      no-undo.
      322       define variable v-current-char  as character    no-undo.
      323   do
      324   on error undo, return error
      325   :
      326       assign
      327           p-out-string = "":U
      328       .
      329       case p-in-string
      330       :
      331           when ?
      332           then do:
      333               assign
      334                   p-out-string = "?":U
      335               .
      336           end.
      337           when "?":U
      338           then do:
      339               assign
      340                   p-out-string = "&#63;":U
      341               .
      342           end.
      343           otherwise do:
      344               do v-position = 1 to length( p-in-string )
      345               :
      346                   assign
      347                       v-current-char = substring( p-in-string, v-position, 1 )
      348                   .
      349                   case v-current-char
      350                   :
      351                       when "&":U
      352                       then do:
      353                           assign
      354                               p-out-string = p-out-string + "&amp;":U
      355                           .
      356                       end.
      357                       when ">":U
      358                       then do:
      359                           assign
      360                               p-out-string = p-out-string + "&gt;":U
      361                           .
      362                       end.
      363                       when "<":U
      364                       then do:
      365                           assign
      366                               p-out-string = p-out-string + "&lt;":U
      367                           .
      368                       end.
      369                       when "'":U
      370                       then do:
      371                           assign
      372                               p-out-string = p-out-string + "&apos;":U
      373                           .
      374                       end.
      375                       when '"':U
      376                       then do:
      377                           assign
      378                               p-out-string = p-out-string + "&quot;":U
      379                           .
      380                       end.
      381                       when chr(1)
      382                       then do:
      383                           assign
      384                               p-out-string = p-out-string + "":U
      385                           .
      386                       end.
      387                       when chr(2)
      388                       then do:
      389                           assign
      390                               p-out-string = p-out-string + "":U
      391                           .
      392                       end.
      393                       when chr(3)
      394                       then do:
      395                           assign
      396                               p-out-string = p-out-string + "":U
      397                           .
      398                       end.
      399                       when chr(4)
      400                       then do:
      401                           assign
      402                               p-out-string = p-out-string + "":U
      403                           .
      404                       end.
      405                       when chr(5)
      406                       then do:
      407                           assign
      408                               p-out-string = p-out-string + "":U
      409                           .
      410                       end.
      411                       when chr(6)
      412                       then do:
      413                           assign
      414                               p-out-string = p-out-string + "":U
      415                           .
      416                       end.
      417                       when chr(7)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + "":U
      421                           .
      422                       end.
      423                       when chr(8)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + "":U
      427                           .
      428                       end.
      429                       when chr(9)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + "":U
      433                           .
      434                       end.
      435                       when chr(29)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + "":U
      439                           .
      440                       end.
      441                       when chr(10)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "&#10;":U
      445                           .
      446                       end.
      447                       when chr(13)
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "&#13;":U
      451                           .
      452                       end.
      453                       otherwise do:
      454                           assign
      455                               p-out-string = p-out-string + v-current-char
      456                           .
      457                       end.
      458                   end case.
      459               end.
      460           end.
      461       end case.
      462   end.
      463   end .
      464   procedure xmlchar-encode-1c :
