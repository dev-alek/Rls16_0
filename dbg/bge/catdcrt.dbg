      574   procedure xmlchar-decode :
      575   define input parameter p-in-string      as character        no-undo.
      576   define output parameter p-out-string    as character        no-undo.
      577       define variable v-position      as integer      no-undo.
      578       define variable v-last-position as integer      no-undo.
      579       define variable v-temp-integer  as integer      no-undo.
      580       define variable v-current-char  as character    no-undo.
      581       define variable v-next-char     as character    no-undo.
      582       define variable v-success       as logical      no-undo.
      583   do
      584   on error undo, return error
      585   :
      586       assign
      587           p-out-string = "":U
      588           v-position   = 0
      589       .
      590       replace-cycle:
      591       do while yes
      592       on error undo, return error
      593       :
      594           assign
      595               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      596           .
      597           if v-last-position <= v-position
      598           then do:
      599               if v-position = 0
      600               then do:
      601                   assign
      602                       p-out-string = p-in-string
      603                   .
      604               end.
      605               else do:
      606                   assign
      607                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      608                   .
      609               end.
      610               leave replace-cycle.
      611           end.
      612           else do:
      613               assign
      614                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      615                   v-position      = v-last-position
      616                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      617               .
      618               if v-current-char = "#":U
      619               then do:
      620                   assign
      621                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      622                   .
      623                   if v-last-position > 0
      624                   then do:
      625                       run xmlchar-read-integer in this-procedure
      626                        (
      627                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      628                           , output v-temp-integer
      629                           , output v-success
      630                       ).
      631                       if v-success = yes
      632                       and v-temp-integer >= 1
      633                       and v-temp-integer <= 255
      634                       then do:
      635                           assign
      636                               p-out-string = p-out-string + chr( v-temp-integer )
      637                               v-position   = v-last-position + 1
      638                           .
      639                       end.
      640                       else do:
      641                           assign
      642                               p-out-string = p-out-string + "&":U
      643                               v-position   = v-position   + 1
      644                           .
      645                       end.
      646                   end.
      647                   else do:
      648                       assign
      649                           p-out-string = p-out-string + "&":U
      650                           v-position   = v-position   + 1
      651                       .
      652                   end.
      653               end.
      654               else do:
      655                   case substring( p-in-string, v-position + 1, 3 )
      656                   :
      657                       when "lt;":U
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + "<":U
      661                               v-position   = v-position   + 3
      662                           .
      663                       end.
      664                       when "gt;":U
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + ">":U
      668                               v-position   = v-position   + 3
      669                           .
      670                       end.
      671                       otherwise do:
      672                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      673                           then do:
      674                               assign
      675                                   p-out-string = p-out-string + "&":U
      676                                   v-position   = v-position   + 4
      677                               .
      678                           end.
      679                           else do:
      680                               case substring( p-in-string, v-position + 1, 5 )
      681                               :
      682                                   when "quot;":U
      683                                   then do:
      684                                       assign
      685                                           p-out-string = p-out-string + '"':U
      686                                           v-position   = v-position   + 5
      687                                       .
      688                                   end.
      689                                   when "apos;":U
      690                                   then do:
      691                                       assign
      692                                           p-out-string = p-out-string + "'":U
      693                                           v-position   = v-position   + 5
      694                                       .
      695                                   end.
      696                                   otherwise do:
      697                                       assign
      698                                           p-out-string = p-out-string + "&":U
      699                                       .
      700                                   end.
      701                               end case.
      702                           end.
      703                       end.
      704                   end case.
      705               end.
      706           end.
      707       end.
      708   end.
      709   end .
      710   procedure xmlchar-read-integer :
      711   define input parameter p-input-string      as character        no-undo.
      712   define output parameter p-output-integer   as integer          no-undo.
      713   define output parameter p-success       as logical          no-undo.
      714   do
      715   on error undo, return error
      716   :
      717       assign
      718           p-output-integer = integer( p-input-string )
      719       no-error.
      720       if error-status :error
      721       then do:
      722           assign
      723               p-success           = no
      724               p-output-integer    = 0
      725           .
      726       end.
      727       else do:
      728           assign
      729               p-success           = yes
      730           .
      731       end.
      732   end.
      733   end.
      734   define variable v-bgelib-bgeclall           as logical      no-undo.
      735   define variable v-bgelib-bgedict            as logical      no-undo.
      736   define temp-table temp_ext-doc-type no-undo
      737       field edt-key               as integer
      738       field ext-doc-type          as character
      739       field ext-doc-type-label    as character
      740       index pi is primary unique
      741           edt-key
      742   .
      743   define temp-table temp_bgelib_goods no-undo
      744       field gds-code as integer
      745       index pi is primary unique
      746           gds-code
      747   .
      748   define temp-table temp_bgelib_clients no-undo
      749       field obj-type as character
      750       field obj-code as integer
      751       index pi is primary unique
      752           obj-type
      753           obj-code
      754   .
      755   define temp-table temp_bgelib_dis-card no-undo
      756       field d-card as character
      757       index pi is primary unique
      758           d-card
      759   .
      760   define temp-table temp_bgelib_trn-doc no-undo
      761       field doc-code as integer
      762   .
      763   procedure bgelib-tag-open:
      764   do
      765   on error undo, return error
      766   :
      767   define input parameter v-tag-level  as integer      no-undo.
      768   define input parameter v-tag-name   as character    no-undo.
      769   define input parameter v-tag-value  as character    no-undo.
      770       put stream stmXMLOut unformatted
      771           chr(10)
      772           + fill(" ", 4 * v-tag-level)
      773           + "<" + v-tag-name
      774           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      775           + v-tag-value + ">"
      776       .
      777   end.
      778   end procedure.
      779   procedure bgelib-tag-put:
      780   do
      781   on error undo, return error
      782   :
      783   define input parameter v-tag-level      as integer      no-undo.
      784   define input parameter v-tag-name       as character    no-undo.
      785   define input parameter v-tag-value      as character    no-undo.
      786   define input parameter v-empty-mode     as integer      no-undo.
      787       v-tag-name = trim(v-tag-name).
      788       if  v-empty-mode = 1
      789       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      790       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      791       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      792       then do:
      793           run xmlchar-encode in this-procedure (
      794                 input v-tag-value
      795               , output v-tag-value
      796           ).
      797           put stream stmXMLOut unformatted
      798               chr(10) + fill(" ", 4 * v-tag-level)
      799                           + '<' + v-tag-name + '>'
      800                           + v-tag-value
      801                           + '</' + v-tag-name + '>'
      802           .
      803       end.
      804   end.
      805   end procedure.
      806   procedure bgelib-tag-close:
      807   do
      808   on error undo, return error
      809   :
      810   define input parameter v-tag-level as integer      no-undo.
      811   define input parameter v-tag-name  as character    no-undo.
      812       put stream stmXMLOut unformatted
      813           chr(10)
      814           + fill( " ", 4 * v-tag-level)
      815           + '</' + v-tag-name + '>'
      816       .
      817   end.
      818   end procedure.
      819   procedure bgelib-write-log:
      820   do
      821   on error undo, return error
      822   :
      823   define input parameter v-filename   as character    no-undo.
      824   define input parameter v-log-level  as integer      no-undo.
      825   define input parameter v-out-string as character    no-undo.
      826       output stream stmXMLLog to value( v-filename ) append.
      827       put stream stmXMLLog unformatted
      828           chr(10)
      829       .
      830       put stream stmXMLLog unformatted
      831           ( if v-log-level = 0
      832             or v-out-string = "&DLine"
      833             or v-out-string = "&Line"
      834             then ""
      835             else cur-time-string-sec() + " " )
      836       .
      837       put stream stmXMLLog unformatted
      838           ( if v-out-string = "&Line"
      839             then fill( "-", 80 )
      840             else if v-out-string = "&DLine"
      841                  then fill( "=", 80 )
      842                  else v-out-string )
      843       .
      844       output stream stmXMLLog close.
      845   end.
      846   end procedure.
      847   procedure bgelib-write-edt:
      848   do
      849   on error undo, return error
      850   :
      851   define input parameter v-editor-handle    as handle       no-undo.
      852   define input parameter v-log-level        as integer      no-undo.
      853   define input parameter v-out-string       as character    no-undo.
      854       if valid-handle ( v-editor-handle )
      855       then do:
      856           v-editor-handle :move-to-eof().
      857           v-editor-handle :insert-string( ( if v-log-level = 0
      858                                             or v-out-string = "&DLine"
      859                                             or v-out-string = "&Line"
      860                                             then ""
      861                                             else cur-time-string-sec() + " "
      862                                         ) ).
      863           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      864                                             then fill( "-", 80 )
      865                                             else if v-out-string = "&DLine" then fill("=", 80)
      866                                             else fill( " ", v-log-level) + v-out-string
      867                                         ) ).
      868           v-editor-handle :insert-string( chr(10) ).
      869       end.
      870       process events.
      871       output to 'bgescn.txt' append.
      872           put unformatted
      873               chr(10)
      874               string( ( if v-log-level = 0
      875                         or v-out-string = "&DLine"
      876                         or v-out-string = "&Line"
      877                         then ""
      878                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      879                     ) )
      880               string( ( if v-out-string = "&Line"
      881                         then fill( "-", 80 )
      882                         else if v-out-string = "&DLine"
      883                              then fill( "=", 80 )
      884                              else fill( " ", v-log-level ) + v-out-string
      885                     ) )
      886           .
      887       output close.
      888   end.
      889   end procedure.
      890   procedure bgelib-show-cnt:
      891   do
      892   on error undo, return error
      893   :
      894   define input parameter v-fillin-handle     as handle   no-undo.
      895       if valid-handle( v-fillin-handle )
      896       then do:
      897           assign
      898               v-fillin-handle :visible = true
      899           .
      900       end.
      901   end.
      902   end procedure.
      903   procedure bgelib-hide-cnt:
      904   do
      905   on error undo, return error
      906   :
      907   define input parameter v-fillin-handle     as handle   no-undo.
      908       if valid-handle( v-fillin-handle )
      909       then do:
      910           assign v-fillin-handle :visible = false.
      911       end.
      912   end.
      913   end procedure.
      914   procedure bgelib-write-cnt:
      915   do
      916   on error undo, return error
      917   :
      918   define input parameter v-fillin-handle    as handle       no-undo.
      919   define input parameter v-fillin-string    as character    no-undo.
      920       if valid-handle( v-fillin-handle )
      921       then do:
      922           assign
      923               v-fillin-handle :SCREEN-value = v-fillin-string
      924           .
      925       end.
      926   end.
      927   end procedure.
      928   procedure bgelib-write-header:
      929   do
      930   on error undo, return error
      931   :
      932   define input parameter p-first-file     as logical      no-undo.
      933   define input parameter p-xml-file-name  as character    no-undo.
      934   define input parameter p-list-file-name as character    no-undo.
      935   define input parameter p-file-number    as integer      no-undo.
      936   define input parameter p-have-prev      as logical      no-undo.
      937   define input parameter p-prev-filename  as character    no-undo.
      938   define input parameter p-obj-list       as character    no-undo.
      939   define input parameter p-doc-type-list  as character    no-undo.
      940   define input parameter p-parameter-list as character    no-undo.
      941       define variable v-counter    as integer        no-undo.
      942       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      943       put stream stmXMLOut unformatted
      944           "<?xml version='1.0' encoding='windows-1251'?>"
      945       .
      946       run bgelib-tag-open( input 0, input "root"  , input "" ).
      947       run bgelib-tag-open( input 0, input "header", input "" ).
      948       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      949       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      950       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      951       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      952       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      953       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      954       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      955       :
      956           run bgelib-tag-put(
      957                 input 1
      958               , input entry( 2 * v-counter, p-parameter-list )
      959               , input entry( 2 * v-counter + 1, p-parameter-list )
      960               , input 0
      961           ).
      962       end.
      963       run bgelib-tag-close( input 0, input "header" ).
      964       output stream stmXMLOut close.
      965       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      966       if p-first-file = yes
      967       then do:
      968           put stream stmXMLOut unformatted
      969               "<?xml version='1.0' encoding='windows-1251'?>"
      970           .
      971           run bgelib-tag-open( input 0, input "export", input "" ).
      972       end.
      973       run bgelib-tag-open( input 1, input "file", input "" ).
      974       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      975       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      976       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      977       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      978       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      979       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      980       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      981       :
      982           run bgelib-tag-put(
      983                 input 2
      984               , input trim(entry( 2 * v-counter, p-parameter-list ))
      985               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      986               , input 0
      987           ).
      988       end.
      989       run bgelib-tag-close( input 1, input "file" ).
      990       output stream stmXMLOut close.
      991   end.
      992   end procedure.
      993   procedure bgelib-write-footer:
      994   do
      995   on error undo, return error
      996   :
      997   define input parameter p-last-file      as logical      no-undo.
      998   define input parameter p-xml-file-name  as character    no-undo.
      999   define input parameter p-list-file-name as character    no-undo.
     1000   define input parameter p-have-next      as logical      no-undo.
     1001   define input parameter p-next-file-name as character    no-undo.
     1002       define variable v-error-num     as integer           no-undo.
     1003       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1004       if p-have-next = yes
     1005       then do:
     1006           run bgelib-tag-open( input 0, input "footer", "" ).
     1007           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1008           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1009           run bgelib-tag-close( input 0, input "footer" ).
     1010       end.
     1011       run bgelib-tag-close( input 0, input "root" ).
     1012       output stream stmXMLOut close.
     1013       run bge/os_copy.p (
     1014             input "M"
     1015           , input p-xml-file-name + "tmp"
     1016           , input p-xml-file-name + "xml"
     1017           , output v-error-num
     1018       ).
     1019       if p-last-file = yes
     1020       then do:
     1021           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1022               run bgelib-tag-close( input 0, input "export" ).
     1023           output stream stmXMLOut close.
     1024           run bge/os_copy.p (
     1025                 input "M"
     1026               , input p-list-file-name + "tmp"
     1027               , input p-list-file-name + "xml"
     1028               , output v-error-num
     1029           ).
     1030       end.
     1031   end.
     1032   end procedure.
     1033   procedure bgelib-filename :
     1034   do
     1035   on error undo, return error
     1036   :
     1037   define input parameter p-prefix             as character    no-undo.
     1038   define output parameter p-xml-file-name     as character    no-undo.
     1039   define output parameter p-log-file-name     as character    no-undo.
     1040   define output parameter p-list-file-name    as character    no-undo.
     1041       define variable v-home-dir  as character    no-undo.
     1042       define variable v-error-num as integer      no-undo.
     1043       get-key-value section "BGE" key "outdir" value v-home-dir.
     1044       if v-home-dir = ?
     1045       then do:
     1046           message
     1047             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1048             skip(1)
     1049             skip "Обратитесь к администратору."
     1050           view-as alert-box error.
     1051           undo, return error .
     1052       end.
     1053       run gbl/dir-cre.p (
     1054           input v-home-dir
     1055       ) no-error.
     1056       if error-status :error
     1057       then do:
     1058           message
     1059             skip "Неверно задан каталог экспорта."
     1060             skip(1)
     1061             skip "Обратитесь к администратору."
     1062           view-as alert-box error.
     1063           undo, return error .
     1064       end.
     1065       run bge/genfname.p (
     1066             input v-home-dir
     1067           , input p-prefix
     1068           , input ""
     1069           , input "xml"
     1070           , input "tmp"
     1071           , output p-xml-file-name
     1072       ).
     1073       assign
     1074           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1075           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1076           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1077       .
     1078   end.
     1079   end procedure.
     1080   procedure bgelib-read-config :
     1081   do
     1082   on error undo, return error
     1083   :
     1084   define variable v-par-type as character     no-undo.
     1085     define variable v-param-type      as character  no-undo .
     1086     define variable v-value-character as character  no-undo .
     1087     define variable v-value-date      as date       no-undo .
     1088     define variable v-value-decimal   as decimal    no-undo .
     1089     define variable v-value-integer   as integer    no-undo .
     1090     define variable v-value-logical   as logical    no-undo .
     1091     define variable v-tth             as handle     no-undo .
     1092       assign
     1093           v-bgelib-bgeclall = no
     1094           v-bgelib-bgedict  = no
     1095       .
     1096       run adm/shattri.p ( input "get":U
     1097                         , input  '':u
     1098                         , input  0
     1099                         , input  'bge-export':U
     1100                         , input  'bgeclall':U
     1101                         , output v-value-character
     1102                         , output v-value-date
     1103                         , output v-value-decimal
     1104                         , output v-value-integer
     1105                         , output v-value-logical
     1106                         , output v-param-type
     1107                         , input-output table-handle v-tth
     1108                         ) no-error .
     1109       if error-status :error
     1110       then do:
     1111         assign
     1112           v-bgelib-bgeclall = no
     1113         .
     1114       end.
     1115       else do:
     1116         assign
     1117           v-bgelib-bgeclall = v-value-logical
     1118         .
     1119       end.
     1120       delete object v-tth.
     1121       run adm/shattri.p ( input "get":U
     1122                         , input  '':u
     1123                         , input  0
     1124                         , input  'bge-export':U
     1125                         , input  'bgedict':U
     1126                         , output v-value-character
     1127                         , output v-value-date
     1128                         , output v-value-decimal
     1129                         , output v-value-integer
     1130                         , output v-value-logical
     1131                         , output v-param-type
     1132                         , input-output table-handle v-tth
     1133                         ) no-error .
     1134       if error-status :error
     1135       then do:
     1136         assign
     1137           v-bgelib-bgedict = no
     1138         .
     1139       end.
     1140       else do:
     1141         assign
     1142           v-bgelib-bgedict = v-value-logical
     1143         .
     1144       end.
     1145       delete object v-tth.
     1146       run adm/shattri.p ( input "get":U
     1147                         , input  '':u
     1148                         , input  0
     1149                         , input  'bge-export':U
     1150                         , input  'bgefmt':U
     1151                         , output v-value-character
     1152                         , output v-value-date
     1153                         , output v-value-decimal
     1154                         , output v-value-integer
     1155                         , output v-value-logical
     1156                         , output v-param-type
     1157                         , input-output table-handle v-tth
     1158                         ) no-error .
     1159       if error-status :error
     1160       then do:
     1161         assign
     1162           v-bgelib-bgefmt  = "xml":U
     1163         .
     1164       end.
     1165       else do:
     1166         assign
     1167           v-bgelib-bgefmt  = v-value-character
     1168         .
     1169       end.
     1170       delete object v-tth.
     1171       run adm/shattri.p ( input "get":U
     1172                         , input  '':u
     1173                         , input  0
     1174                         , input  'bge-export':U
     1175                         , input  'bgeflold':U
     1176                         , output v-value-character
     1177                         , output v-value-date
     1178                         , output v-value-decimal
     1179                         , output v-value-integer
     1180                         , output v-value-logical
     1181                         , output v-param-type
     1182                         , input-output table-handle v-tth
     1183                         ) no-error .
     1184       if error-status :error
     1185       then do:
     1186         assign
     1187           v-bgelib-bgeflold  = "old":U
     1188         .
     1189       end.
     1190       else do:
     1191         assign
     1192           v-bgelib-bgeflold  = v-value-character
     1193         .
     1194       end.
     1195       delete object v-tth.
     1196   end.
     1197   end procedure.
     1198   procedure bgelib-check-file-size :
     1199   do
     1200   on error undo, return error
     1201   :
     1202   define input parameter p-out-filename   as character    no-undo.
     1203   define output parameter p-is-big        as logical      no-undo.
     1204       define variable v-current-position    as integer        no-undo.
     1205       assign
     1206           v-current-position = seek( stmXMLOut )
     1207       .
     1208       if v-current-position / 1024 / 1024  >= 100
     1209       then do:
     1210           assign
     1211               p-is-big = yes
     1212           .
     1213       end.
     1214   end.
     1215   end procedure.
     1216   procedure bgelib-init-ext-doc-type :
     1217       define variable v-counter    as integer      no-undo.
     1218       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1219   do
     1220   for buf_temp_ext-doc-type
     1221   on error undo, return error
     1222   :
     1223       empty temp-table buf_temp_ext-doc-type.
     1224       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1225       :
     1226           create buf_temp_ext-doc-type.
     1227           assign
     1228               buf_temp_ext-doc-type.edt-key               = v-counter
     1229               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1230               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1231           .
     1232       end.
     1233   end.
     1234   end procedure.
     1235   define input parameter p-mode           as character    no-undo.
     1236   define input parameter table for temp_bgelib_dis-card .
     1237   do
     1238   on error undo, return error
     1239   :
     1240       define variable v-counter           as integer       no-undo.
     1241       define variable v-xml-file-name     as character     no-undo.
     1242       define variable v-log-file-name     as character     no-undo.
     1243       define variable v-list-file-name    as character     no-undo.
     1244       define variable v-xml-file-number   as integer       no-undo.
     1245       define variable v-cancel            as logical       no-undo.
     1246       define variable v-parameter-list    as character     no-undo.
     1247       define buffer buf_dis-card      for ub.dis-card.
     1248       run bgelib-read-config in this-procedure no-error.
     1249       if error-status :error
     1250       then do:
     1251           message
     1252           vss-workfile vss-revision vss-description
     1253           skip "Ошибка чтения параметров экспорта."
     1254           skip "Для экспорта данных будут приняты параметры по умолчанию."
     1255           skip return-value
     1256           skip trim(error-status :get-message(1))
     1257                trim(error-status :get-message(2))
     1258                trim(error-status :get-message(3))
     1259           view-as alert-box error.
     1260       end.
     1261       run bgelib-filename in this-procedure (
     1262             input "dct"
     1263           , output v-xml-file-name
     1264           , output v-log-file-name
     1265           , output v-list-file-name
     1266       ).
     1267       run gbl/waitfrsp.w (
     1268             input substring( v-xml-file-name, 1, 1 )
     1269           , input 200
     1270           , output v-cancel
     1271       ) .
     1272       if v-cancel = yes
     1273       then do:
     1274           undo, return error .
     1275       end.
     1276       run bgelib-write-log in this-procedure (
     1277             input v-log-file-name
     1278           , input 1
     1279           , input "&DLine"
     1280       ).
     1281       run bgelib-write-log in this-procedure (
     1282             input v-log-file-name
     1283           , input 1
     1284           , input substitute( "Начало выгрузки справочника дисконтных карт в файл &1"
     1285                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1286                             )
     1287       ).
     1288       assign
     1289           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1290                                                  , 4
     1291                                                  , "docName"          , "discCard":U
     1292                                                  , "version"          , replace("15.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1293                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1294                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1295                                                 )
     1296           v-xml-file-number       =   1
     1297       .
     1298       run bgelib-write-header in this-procedure (
     1299             input yes
     1300           , input v-xml-file-name
     1301           , input v-list-file-name
     1302           , input v-xml-file-number
     1303           , input no
     1304           , input ""
     1305           , input ""
     1306           , input ""
     1307           , input v-parameter-list
     1308       ).
     1309       if lookup( "list":U, p-mode ) = 0
     1310       then do:
     1311           for each buf_dis-card no-lock
     1312           :
     1313               run write-dcard in this-procedure (
     1314                     input buf_dis-card.d-card
     1315                   , input v-parameter-list
     1316                   , input v-xml-file-name
     1317                   , input v-log-file-name
     1318                   , input v-list-file-name
     1319                   , input v-xml-file-number
     1320                   , output v-xml-file-name
     1321                   , output v-xml-file-number
     1322               ) no-error.
     1323               if error-status :error
     1324               then do:
     1325                   run bgelib-write-log in this-procedure (
     1326                         input v-log-file-name
     1327                       , input 1
     1328                       , input substitute(  "*** ERR: *** Ошибка выгрузки дисконтной карты номер &1. &2. &3.", buf_dis-card.d-card, trim(error-status :get-message(1)), trim(error-status :get-message(2)) )
     1329                   ).
     1330               end.
     1331           end.
     1332       end.
     1333       else do:
     1334           for each temp_bgelib_dis-card no-lock
     1335           :
     1336               run write-dcard in this-procedure (
     1337                     input temp_bgelib_dis-card.d-card
     1338                   , input v-parameter-list
     1339                   , input v-xml-file-name
     1340                   , input v-log-file-name
     1341                   , input v-list-file-name
     1342                   , input v-xml-file-number
     1343                   , output v-xml-file-name
     1344                   , output v-xml-file-number
     1345               ) no-error.
     1346               if error-status :error
     1347               then do:
     1348                   run bgelib-write-log in this-procedure (
     1349                         input v-log-file-name
     1350                       , input 1
     1351                       , input substitute(  "*** ERR: *** Ошибка выгрузки дисконтной карты номер &1. &2. &3.", temp_bgelib_dis-card.d-card, trim(error-status :get-message(1)), trim(error-status :get-message(2)) )
     1352                   ).
     1353               end.
     1354           end.
     1355       end.
     1356       run bgelib-write-footer in this-procedure (
     1357             input yes
     1358           , input v-xml-file-name
     1359           , input v-list-file-name
     1360           , input no
     1361           , input ""
     1362       ).
     1363       run bgelib-write-log in this-procedure (
     1364             input v-log-file-name
     1365           , input 1
     1366           , input substitute( "Данные выгружены в файл &1"
     1367                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1368                             )
     1369       ).
     1370       run bgelib-write-log in this-procedure (
     1371             input v-log-file-name
     1372           , input 1
     1373           , input "&DLine"
     1374       ).
     1375   end.
     1376   procedure write-dcard :
     1377   do
     1378   on error undo, return error
     1379   :
     1380   define input parameter p-dcard                  as character    no-undo.
     1381   define input parameter p-parameter-list         as character    no-undo.
     1382   define input parameter p-xml-file-name          as character    no-undo.
     1383   define input parameter p-log-file-name          as character    no-undo.
     1384   define input parameter p-list-file-name         as character    no-undo.
     1385   define input parameter p-xml-file-number        as integer      no-undo.
     1386   define output parameter p-last-xml-file-name    as character    no-undo.
     1387   define output parameter p-last-xml-file-number  as integer      no-undo.
     1388       define variable v-need-new-file as logical      no-undo.
     1389       define variable v-void-string   as character      no-undo.
     1390       define variable v-prev-filename as character      no-undo.
     1391       define buffer buf_dis-card      for ub.dis-card.
     1392       assign
     1393           p-last-xml-file-name   = p-xml-file-name
     1394           p-last-xml-file-number = p-xml-file-number
     1395       .
     1396       run bgelib-check-file-size in this-procedure (
     1397             input p-xml-file-name + "tmp"
     1398           , output v-need-new-file
     1399       ).
     1400       if v-need-new-file = yes
     1401       then do:
     1402           assign
     1403               v-prev-filename = p-xml-file-name
     1404           .
     1405           run bgelib-filename in this-procedure (
     1406                 input "dct"
     1407               , output p-xml-file-name
     1408               , output v-void-string
     1409               , output v-void-string
     1410           ).
     1411           run bgelib-write-footer in this-procedure (
     1412                 input no
     1413               , input v-prev-filename
     1414               , input p-list-file-name
     1415               , input yes
     1416               , input p-xml-file-name + "xml":U
     1417           ).
     1418           run bgelib-write-log in this-procedure (
     1419                 input p-log-file-name
     1420               , input 1
     1421               , input substitute( "Данные выгружены в файл &1"
     1422                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1423                               )
     1424           ).
     1425           assign
     1426               p-last-xml-file-number   = p-xml-file-number + 1
     1427               p-last-xml-file-name     = p-xml-file-name
     1428           .
     1429           run bgelib-write-header in this-procedure (
     1430                 input no
     1431               , input p-last-xml-file-name
     1432               , input p-list-file-name
     1433               , input p-last-xml-file-number
     1434               , input yes
     1435               , input v-prev-filename + "xml":U
     1436               , input ""
     1437               , input ""
     1438               , input p-parameter-list
     1439           ).
     1440           assign
     1441               v-need-new-file = no
     1442           .
     1443       end.
     1444       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1445       find first buf_dis-card no-lock
     1446            where buf_dis-card.d-card = p-dcard
     1447       .
     1448   run bgelib-tag-open in this-procedure ( input 1, input "dct", input "").
     1449   run bgelib-tag-put in this-procedure ( input 2, "cardID"         , input buf_dis-card.d-card                      , input 0 ).
     1450   run bgelib-tag-put in this-procedure ( input 2, "cardNum"        , input string( buf_dis-card.card-num           ), input 0 ).
     1451   run bgelib-tag-put in this-procedure ( input 2, "sourceDCard"    , input string( buf_dis-card.sourced-card       ), input 0 ).
     1452   run bgelib-tag-put in this-procedure ( input 2, "validDate"      , input string( buf_dis-card.valid-date         ), input 0 ).
     1453   run bgelib-tag-put in this-procedure ( input 2, "cliType"        , input string( buf_dis-card.cli-type           ), input 0 ).
     1454   run bgelib-tag-put in this-procedure ( input 2, "cliCode"        , input string( buf_dis-card.cli-code           ), input 0 ).
     1455   run bgelib-tag-put in this-procedure ( input 2, "hostcode"       , input string( buf_dis-card.emitent-host-code  ), input 0 ).
     1456   run bgelib-tag-put in this-procedure ( input 2, "isCreditCard"   , input string( buf_dis-card.credit-card        ), input 0 ).
     1457   run bgelib-tag-put in this-procedure ( input 2, "creditLimit"    , input string( buf_dis-card.lim-kr             ), input 0 ).
     1458   run bgelib-tag-put in this-procedure ( input 2, "pcntDiscount"   , input string( buf_dis-card.d-pcnt             ), input 0 ).
     1459   run bgelib-tag-put in this-procedure ( input 2, "pcntDiscItog"   , input string( buf_dis-card.cash-d-pcnt        ), input 0 ).
     1460   run bgelib-tag-put in this-procedure ( input 2, "pcntDiscMethod" , input string( buf_dis-card.d-pcnt-method      ), input 0 ).
     1461   run bgelib-tag-put in this-procedure ( input 2, "issureCode"     , input string( buf_dis-card.issue-code         ), input 0 ).
     1462   run bgelib-tag-put in this-procedure ( input 2, "issureDate"     , input string( buf_dis-card.issue-date         ), input 0 ).
     1463   run bgelib-tag-put in this-procedure ( input 2, "saldoBase"      , input string( buf_dis-card.saldo-base         ), input 0 ).
     1464   run bgelib-tag-put in this-procedure ( input 2, "saldoRubl"      , input string( buf_dis-card.saldo-rubl         ), input 0 ).
     1465   run bgelib-tag-put in this-procedure ( input 2, "status"         , input string( buf_dis-card.status_            ), input 0 ).
     1466   run bgelib-tag-put in this-procedure ( input 2, "type"           , input string( buf_dis-card.type               ), input 0 ).
     1467   run bgelib-tag-close in this-procedure ( input 1, input "dct" ).
     1468       output stream stmxmlout close.
     1469   end.
     1470   end procedure.
