        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter as-ref as log no-undo.
        3   define output parameter unit-name as character init ? no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":u .
        5   define variable vss-author      as character no-undo init "$Author$":u .
        6   define variable vss-date        as character no-undo init "$Date$":u .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        8   define variable vss-archive     as character no-undo init "$Archive$":u .
        9   define variable vss-description as character no-undo init "Справочник единиц измерения" .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable ri as recid no-undo.
      125   define variable glog as logical no-undo .
      126   define variable v-guid_ as character no-undo .
      127   define buffer buf_units-attr for ub.units-attr .
      128   define temp-table tt-units like ub.units
      129     field guid_ as character format "X(40)"
      130   .
      131   DEFINE BUTTON b-connect
      132        LABEL "&Связать":L
      133        SIZE 10 BY 1.
      134   DEFINE BUTTON b-exit AUTO-END-KEY
      135        LABEL "&Выход ":L
      136        SIZE 10 BY 1.
      137   DEFINE BUTTON b-del
      138        LABEL "&Удалить":L
      139        SIZE 10 BY 1 tooltip "Удалить связку с данными ФГИС Меркурий".
      140   DEFINE BUTTON b-select
      141        LABEL "Вы&брать":L
      142        SIZE 10 BY 1.
      143   DEFINE QUERY br-units FOR tt-units SCROLLING.
      144   DEFINE BROWSE br-units QUERY br-units NO-LOCK DISPLAY
      145         tt-units.unit-name
      146         tt-units.long-name FORMAT "X(30)"
      147         tt-units.OKEI COLUMn-LABEL "Код!ОКЕИ"
      148         tt-units.guid_ column-label "GUID в ФГИС Меркурий" format "X(40)"
      149       WITH SEPARATORS
      150              size 86.25 by 12.58
      151            .
      152   DEFINE FRAME d-units
      153        br-units at row 2.5 col 3
      154        b-exit at row 1 col 1
      155        b-connect at row 1 col 11
      156        b-select at row 1 col 11
      157        b-del at row 1 col 21
      158       WITH VIEW-AS DIALOG-BOX
      159            SIDE-LABELS THREE-D
      160            SCROLLABLE size 91.88 by 16.25
      161            TITLE "Синхронизация единиц измерения с ФГИС Меркурий":L.
      162   ASSIGN
      163          FRAME d-units:SCROLLABLE       = FALSE.
      164   ON CHOOSE OF b-connect IN FRAME d-units
      165   DO:
      166     if not available tt-units then return no-apply .
      167     run bge\units-merc-connect.w (input parparentproc,
      168                                   output v-guid_ ) .
      169     if v-guid_ <> ""
      170     then do :
      171       tt-units.guid_ = v-guid_ .
      172       find first buf_units-attr exclusive-lock where buf_units-attr.unit-name = tt-units.unit-name
      173                                                  and buf_units-attr.attr-code = "MercGuid"
      174                                                  no-error .
      175       if not available buf_units-attr
      176       then do :
      177         create buf_units-attr .
      178         assign
      179           buf_units-attr.unit-name = tt-units.unit-name
      180           buf_units-attr.attr-code = "MercGuid"
      181         .
      182       end.
      183       buf_units-attr.attr-value = v-guid_ .
      184       br-units:refresh () .
      185     end.
      186   END.
      187   ON CHOOSE OF B-del IN FRAME d-units
      188   DO:
      189     if not available tt-units or tt-units.guid_ = "" then return no-apply .
      190     find first buf_units-attr exclusive-lock where buf_units-attr.unit-name = tt-units.unit-name
      191                                                  and buf_units-attr.attr-code = "MercGuid"
      192                                                  no-error .
      193     if available buf_units-attr
      194     then do :
      195       delete buf_units-attr .
      196     end.
      197     tt-units.guid_ = "" .
      198     br-units:refresh () .
      199   END.
      200   ON CHOOSE OF b-select IN FRAME d-units
      201   DO:
      202       if available tt-units then
      203           do:
      204               unit-name = tt-units.unit-name .
      205               apply  "GO" to FRAME d-units.
      206           end.
      207   END.
      208   ON DEFAULT-ACTION OF br-units IN FRAME d-units
      209   DO:
      210       if as-ref then
      211           do:
      212                   apply "CHOOSE":U to b-select.
      213           end.
      214   END.
      215   ON RETURN OF br-units IN FRAME d-units
      216   DO:
      217       if as-ref then
      218           do:
      219                   apply "CHOOSE":U to b-select.
      220           end.
      221   END.
      222   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      223   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      224   ON WINDOW-CLOSE OF FRAME d-units APPLY "END-ERROR":U TO SELF.
      225   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      226     run mainmenu_getcntxt in parparentproc
      227       (output v-cntxt-db-num
      228       ,output v-cntxt-userid
      229       ,output v-cntxt-level
      230       ,output v-cntxt-host-code-obj
      231       ,output v-cntxt-obj-type
      232       ,output v-cntxt-obj-code
      233       ,output v-cntxt-db-num-obj
      234       ,output v-cntxt-is-admin
      235       ) .
      236     empty temp-table tt-units .
      237     for each ub.units no-lock :
      238       create tt-units.
      239       buffer-copy ub.units to tt-units.
      240       find first ub.units-attr no-lock where ub.units-attr.unit-name = ub.units.unit-name
      241                                          and ub.units-attr.attr-code = "MercGuid" no-error .
      242       if available ub.units-attr then tt-units.guid_ =  ub.units-attr.attr-value .
      243     end.
      244     RUN enable_UI.
      245     if available tt-units then
      246         glog = br-units:select-focused-row( ).
      247   do  on endkey undo, leave  on error undo, leave:
      248     WAIT-FOR GO OF FRAME d-units.
      249   end.
      250   RUN disable_UI.
      251   PROCEDURE disable_UI :
      252     HIDE FRAME d-units.
      253   END PROCEDURE.
      254   PROCEDURE enable_UI :
      255       b-select:visible IN FRAME d-units = as-ref .
      256       b-connect:visible IN FRAME d-units = not as-ref .
      257       b-del:visible IN FRAME d-units = not as-ref .
      258       ENABLE  br-units b-exit
      259                       b-connect     WHEN v-cntxt-db-num = 0
      260                       b-del         WHEN v-cntxt-db-num = 0
      261                       b-select      WHEN b-select:visible
      262           WITH FRAME d-units.
      263       OPEN QUERY br-units FOR EACH tt-units exclusive-LOCK  .
      264   END PROCEDURE.
