        1   block-level on error undo, throw.
        2   define input parameter parparentproc  as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: ecc773e5a8dc, 1421, test $":U .
        4   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo init "$Date: Fri Jun 29 17:59:55 2018 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: egais-marks.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: bge/egais-marks.p $":U .
        8   define variable vss-description as character no-undo init "Интерфейс для расшифровки акцизной марки".
        9   define temp-table tt-act-header
       10       field num           as character        label "№ акта"      format "X(30)"
       11       field date_         as date             label "Дата акта"
       12       field is-sent       as logical
       13       field answer_       as character        label "Ответ"       format "X(1500)"
       14       field type_         as character        label "Основание"   format "X(35)"
       15       field RegID         as character        label "Рег. номер"  format "X(50)"
       16       index pi as primary unique
       17           num
       18   .
       19   define temp-table tt-gds-act
       20       field num           as character                label "№ акта"
       21       field position_     as integer                  label "№ пп"                    format ">>>9"
       22       field gds-code      like ub.goods.gds-code      label "Код товара   "
       23       field part-code     like ub.parts.part-code     label "Партия"
       24       field doc-code      as character                label "№ накладной TH"
       25       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
       26       field alc-code      as character                label "Алкогольный код"         format "X(21)"
       27       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
       28       field qnty          as decimal                  label "Количество"
       29       field inform-A      as character                label "Справка А"               format "X(20)"
       30       field A-qnty        as decimal                  label "Кол-во в справке"
       31       field A-bottleDate  as date                     label "Дата розлива"
       32       field A-ttnNumber   as character                label "№ ТТН справки А"         format "X(15)"
       33       field A-ttnDate     as date                     label "Дата"
       34       field A-fixNumber   as character                label "№ фиксации в ЕГАИС"      format "X(20)"
       35       field A-fixDate     as date                     label "Дата фикс."
       36       field inform-B      as character                label "Справка Б"               format "X(20)"
       37       field marks-qnty    as integer                  label "Кол-во марок"
       38       field egais-name    as character
       39       index pi as primary unique
       40           position_
       41       index code
       42           gds-code doc-code
       43   .
       44   define new shared temp-table tt-marks
       45       field num                 as character            label "№ акта"
       46       field gds-part-position_  as integer
       47       field mark                as character            label "Марка"          format "X(100)"
       48       field new_                as logical
       49       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
       50       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
       51       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
       52       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
       53       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
       54       field flag                as logical              label "T"
       55       field reserv              as integer              label "R"
       56       field parts               as character            label "Партия"         format "X(130)"
       57       index pi as primary unique
       58           mark
       59   .
       60   procedure vss-get-info :
       61     define output parameter p-vss-revision    like vss-revision    no-undo .
       62     define output parameter p-vss-author      like vss-author      no-undo .
       63     define output parameter p-vss-date        like vss-date        no-undo .
       64     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       65     define output parameter p-vss-archive     like vss-archive     no-undo .
       66     define output parameter p-vss-description like vss-description no-undo .
       67     assign
       68       p-vss-revision    = vss-revision
       69       p-vss-author      = vss-author
       70       p-vss-date        = vss-date
       71       p-vss-workfile    = vss-workfile
       72       p-vss-archive     = vss-archive
       73       p-vss-description = vss-description
       74     .
       75   end procedure.
       76   procedure vss-get-parameters :
       77     define output parameter p-vss-parameters as character no-undo .
       78   end procedure.
       79   define new global shared variable g#vssrevis-logger as handle    no-undo .
       80   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       81   define variable v-vssrevis-logger                   as handle    no-undo .
       82   procedure vss-logevent :
       83     define input  parameter p-extra-paramters as character no-undo .
       84     define variable v-vssrevis-parameters as character no-undo .
       85     do
       86     on error undo, return error return-value
       87     :
       88       if  valid-handle(v-vssrevis-logger)
       89       and v-vssrevis-logger :get-signature("logevent") <> ""
       90       then do:
       91         run vss-get-parameters in this-procedure
       92           (output v-vssrevis-parameters
       93           ).
       94         run logevent in v-vssrevis-logger
       95           (input vss-workfile
       96           ,input vss-revision
       97           ,input v-vssrevis-parameters
       98           ,input p-extra-paramters
       99           ).
      100       end.
      101     end.
      102   end procedure.
      103   assign
      104     v-vssrevis-logger = g#vssrevis-logger
      105   .
      106   if  valid-handle(v-vssrevis-logger)
      107   and v-vssrevis-logger :get-signature("logevent") <> ""
      108   then do:
      109     assign
      110       v-vssrevis-logevent = true
      111     .
      112     run vss-logevent in this-procedure (input vss-description) .
      113   end.
      114   define new global shared variable g#language as character no-undo .
      115   if g#language <> '' and g#language <> 'rus':U then do:
      116     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      117   end.
      118    main-block:
      119   do
      120   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      121   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      122   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      123   :
      124     run bge/egais-ab-marks.w (
      125     input parparentproc ,
      126     input ""  ,
      127     input 0   ,
      128     input ""  ,
      129     input 0   ,
      130     input 'ИЗМЕНЕНИЕ':U ,
      131     input-output table tt-marks
      132     ) .
      133   end.
