        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Apr 10 12:04:11 2018 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: bgeprc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/bgeprc.p $":U .
        7   define variable vss-description as character no-undo init "Экспорт цен товаров.".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define  temp-table temp-host no-undo
       74     field host-code like ub.store.host-code
       75     index xpk host-code
       76   .
       77   define  temp-table temp-obj no-undo
       78     field obj-type  like ub.clients.obj-type
       79     field obj-code  like ub.clients.obj-code
       80     field host-code like ub.store.host-code
       81     field db-num    like ub.clients.db-num
       82     index xpk  obj-type obj-code
       83     index xie1 host-code
       84     index xie2 db-num host-code
       85   .
       86   procedure init-temphost:
       87     define buffer buf_store   for ub.store .
       88     define buffer buf_shop    for ub.shop .
       89     define buffer buf_clients for ub.clients .
       90     define buffer buf_db for ub.db .
       91     define buffer buf_temp-host for temp-host .
       92     define buffer buf_temp-obj for temp-obj .
       93     do
       94     on error undo, return error return-value
       95     :
       96       for each buf_store
       97       on error undo, return error
       98       :
       99         find first buf_temp-host
      100           where buf_temp-host.host-code = buf_store.host-code
      101           no-error .
      102         if not available buf_temp-host
      103         then do:
      104           create buf_temp-host .
      105           assign
      106             buf_temp-host.host-code = buf_store.host-code
      107           .
      108         end.
      109         find first buf_clients no-lock
      110           where buf_clients.obj-type = 'скл':U
      111             and buf_clients.obj-code = buf_store.obj-code
      112           no-error .
      113         if not available buf_clients
      114         then do:
      115           message
      116             "Ошибка при поиске клиента" skip
      117             "Клиент" 'скл':U buf_store.obj-code skip
      118             view-as alert-box error .
      119           undo, return error .
      120         end.
      121         create buf_temp-obj .
      122         assign
      123           buf_temp-obj.obj-type  = 'скл':U
      124           buf_temp-obj.obj-code  = buf_store.obj-code
      125           buf_temp-obj.host-code = buf_store.host-code
      126           buf_temp-obj.db-num    = buf_clients.db-num
      127         .
      128       end.
      129       for each buf_shop
      130       on error undo, return error
      131       :
      132         find first buf_temp-host
      133           where buf_temp-host.host-code = buf_shop.host-code
      134           no-error .
      135         if not available buf_temp-host
      136         then do:
      137           create buf_temp-host .
      138           assign
      139             buf_temp-host.host-code = buf_shop.host-code
      140           .
      141         end.
      142         find first buf_clients no-lock
      143           where buf_clients.obj-type = 'маг':U
      144             and buf_clients.obj-code = buf_shop.obj-code
      145           no-error .
      146         if not available buf_clients then do:
      147           message
      148             "Ошибка при поиске клиента" skip
      149             "Клиент" 'маг':U buf_shop.obj-code skip
      150             view-as alert-box error .
      151           undo, return error .
      152         end.
      153         create buf_temp-obj .
      154         assign
      155           buf_temp-obj.obj-type  = 'маг':U
      156           buf_temp-obj.obj-code  = buf_shop.obj-code
      157           buf_temp-obj.host-code = buf_shop.host-code
      158           buf_temp-obj.db-num    = buf_clients.db-num
      159         .
      160       end.
      161     end.
      162   end.
      163   define variable vss-include-info1 as character format "X(65)" no-undo
      164   initial "@(#)$Workfile$ $Revision$".
      165   define variable v-bgelib-bgefmt        as character         no-undo.
      166   define variable v-bgelib-bgeflold      as character         no-undo.
      167   define stream stmXMLOut.
      168   define stream stmXMLLog.
      169   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   procedure cur-time :
      171      define output parameter p-today as date      no-undo .
      172      define output parameter p-time  as integer   no-undo .
      173     do
      174     on error undo, return error
      175     :
      176       define variable v-date1 as date      no-undo .
      177       define variable v-date2 as date      no-undo .
      178       define variable v-time  as integer   no-undo .
      179       assign
      180         v-date1 = today
      181         v-time  = time
      182         v-date2 = today
      183       .
      184       if v-date1 <> v-date2
      185       then do:
      186         assign
      187           v-date1 = today
      188           v-time  = v-time
      189         .
      190       end.
      191       assign
      192         p-today = v-date1
      193         p-time  = v-time
      194       .
      195     end.
      196   end.
      197   function cur-time-date returns character
      198   :
      199     return string(today, '99/99/9999':U) .
      200   end.
      201   function cur-time-mjd returns decimal
      202   :
      203     define variable v-date as date      no-undo .
      204     define variable v-time as integer   no-undo .
      205     run cur-time in this-procedure
      206       (output v-date
      207       ,output v-time
      208       ) .
      209     return integer(v-date) - 2400002 + (v-time / 86400) .
      210   end.
      211   function cur-time-get-ending-index returns integer
      212   (input p-number as integer
      213   )
      214   :
      215     if p-number < 0
      216     or p-number = ?
      217     then do:
      218       return 1 .
      219     end.
      220     define variable v-rest as integer   no-undo .
      221     assign
      222       p-number = p-number modulo 100
      223     .
      224     if p-number < 20
      225     then do:
      226       assign
      227         v-rest = p-number
      228       .
      229     end.
      230     else do:
      231       assign
      232         v-rest = p-number modulo 10
      233       .
      234     end.
      235     case v-rest :
      236       when 1
      237       then do:
      238         return 2 .
      239       end.
      240       when 2 or
      241       when 3 or
      242       when 4
      243       then do:
      244         return 3 .
      245       end.
      246       otherwise do:
      247         return 1 .
      248       end.
      249     end case .
      250   end.
      251   procedure cur-time-mjd-to-date :
      252      define input  parameter i-mjd-diff as decimal no-undo.
      253      define output parameter o-Date     as date    no-undo.
      254      define output parameter o-Time     as integer no-undo.
      255      define variable v-day-number as integer   no-undo .
      256      if    i-mjd-diff < 0
      257         or i-mjd-diff = ?
      258      then do:
      259         return "?" .
      260      end.
      261      assign
      262         v-day-number = truncate(i-mjd-diff,0).
      263         o-Date = date(v-day-number + 2400002).
      264         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      265     .
      266   end.
      267   function cur-time-mjd-to-string returns character
      268   (input p-mjd-diff as decimal
      269   )
      270   :
      271     define variable v-day-number as integer   no-undo .
      272     define variable v-seconds    as integer   no-undo .
      273     define variable v-hour       as integer   no-undo .
      274     define variable v-min        as integer   no-undo .
      275     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      276     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      277     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      278     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      279     if p-mjd-diff < 0
      280     or p-mjd-diff = ?
      281     then do:
      282       return "?" .
      283     end.
      284     assign
      285       v-day-number = integer(truncate(p-mjd-diff,0))
      286       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      287     .
      288     if v-seconds > 86400
      289     then do:
      290       assign
      291         v-seconds = 86400 - 1
      292       .
      293     end.
      294     if v-seconds < 0
      295     then do:
      296       assign
      297         v-seconds = 0
      298       .
      299     end.
      300     assign
      301       v-hour = truncate(v-seconds / 3600, 0)
      302     .
      303     assign
      304       v-seconds = v-seconds modulo 3600
      305     .
      306     assign
      307       v-min = truncate(v-seconds / 60, 0)
      308     .
      309     assign
      310       v-seconds = v-seconds modulo 60
      311     .
      312     return
      313         (if v-day-number <> 0
      314           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      315           else ""
      316         )
      317       + (if v-day-number <> 0 or v-hour <> 0
      318           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      319           else ""
      320         )
      321       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      322           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      323           else ""
      324         )
      325       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      326       .
      327   end.
      328   function cur-time-string returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      337   end.
      338   function cur-time-string-sec returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      347   end.
      348   function cur-time-custom  returns character
      349   (input p-prefix as character
      350   ,input p-date-format as character
      351   ,input p-delimiter as character
      352   ,input p-time-format as character
      353   ,input p-suffix as character
      354   )
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return
      363       p-prefix
      364       + string(v-date, p-date-format)
      365       + p-delimiter
      366       + string(v-time, p-time-format)
      367       + p-suffix
      368       .
      369   end.
      370   function cur-time-print  returns character
      371   :
      372     define variable v-date as date      no-undo .
      373     define variable v-time as integer   no-undo .
      374     run cur-time in this-procedure
      375       (output v-date
      376       ,output v-time
      377       ) .
      378     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      379   end.
      380   function cur-time-datetime returns datetime
      381   :
      382     define variable v-char as character no-undo .
      383     define variable v-datetime as datetime no-undo .
      384     v-char = cur-time-string().
      385     v-datetime = datetime(v-char).
      386     return  v-datetime.
      387   end.
      388   function cur-time-string-msec returns character
      389   :
      390     define variable v-date as datetime  no-undo .
      391     v-date = now.
      392     return string(v-date) .
      393   end.
      394   define variable vss-include-info3 as character format "X(65)" no-undo
      395   initial "@(#)$Workfile$ $Revision$".
      396   procedure xmlchar-test :
      397   define input parameter p-in-string          as character        no-undo.
      398   define output parameter p-out-string-enc    as character        no-undo.
      399   define output parameter p-out-string-dec    as character        no-undo.
      400   do
      401   on error undo, return error
      402   :
      403          run xmlchar-encode in this-procedure
      404       (
      405             input p-in-string
      406           , output p-out-string-enc
      407       ).
      408          run xmlchar-decode in this-procedure
      409       (
      410             input p-out-string-enc
      411           , output p-out-string-dec
      412       ).
      413   end.
      414   end .
      415   procedure xmlchar-encode :
      416   define input parameter p-in-string      as character        no-undo.
      417   define output parameter p-out-string    as character        no-undo.
      418       define variable v-position      as integer      no-undo.
      419       define variable v-current-char  as character    no-undo.
      420   do
      421   on error undo, return error
      422   :
      423       assign
      424           p-out-string = "":U
      425       .
      426       case p-in-string
      427       :
      428           when ?
      429           then do:
      430               assign
      431                   p-out-string = "?":U
      432               .
      433           end.
      434           when "?":U
      435           then do:
      436               assign
      437                   p-out-string = "&#63;":U
      438               .
      439           end.
      440           otherwise do:
      441               do v-position = 1 to length( p-in-string )
      442               :
      443                   assign
      444                       v-current-char = substring( p-in-string, v-position, 1 )
      445                   .
      446                   case v-current-char
      447                   :
      448                       when "&":U
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + "&amp;":U
      452                           .
      453                       end.
      454                       when ">":U
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + "&gt;":U
      458                           .
      459                       end.
      460                       when "<":U
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + "&lt;":U
      464                           .
      465                       end.
      466                       when "'":U
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + "&apos;":U
      470                           .
      471                       end.
      472                       when '"':U
      473                       then do:
      474                           assign
      475                               p-out-string = p-out-string + "&quot;":U
      476                           .
      477                       end.
      478                       when chr(1)
      479                       then do:
      480                           assign
      481                               p-out-string = p-out-string + "":U
      482                           .
      483                       end.
      484                       when chr(2)
      485                       then do:
      486                           assign
      487                               p-out-string = p-out-string + "":U
      488                           .
      489                       end.
      490                       when chr(3)
      491                       then do:
      492                           assign
      493                               p-out-string = p-out-string + "":U
      494                           .
      495                       end.
      496                       when chr(4)
      497                       then do:
      498                           assign
      499                               p-out-string = p-out-string + "":U
      500                           .
      501                       end.
      502                       when chr(5)
      503                       then do:
      504                           assign
      505                               p-out-string = p-out-string + "":U
      506                           .
      507                       end.
      508                       when chr(6)
      509                       then do:
      510                           assign
      511                               p-out-string = p-out-string + "":U
      512                           .
      513                       end.
      514                       when chr(7)
      515                       then do:
      516                           assign
      517                               p-out-string = p-out-string + "":U
      518                           .
      519                       end.
      520                       when chr(8)
      521                       then do:
      522                           assign
      523                               p-out-string = p-out-string + "":U
      524                           .
      525                       end.
      526                       when chr(9)
      527                       then do:
      528                           assign
      529                               p-out-string = p-out-string + "":U
      530                           .
      531                       end.
      532                       when chr(29)
      533                       then do:
      534                           assign
      535                               p-out-string = p-out-string + "":U
      536                           .
      537                       end.
      538                       when chr(10)
      539                       then do:
      540                           assign
      541                               p-out-string = p-out-string + "&#10;":U
      542                           .
      543                       end.
      544                       when chr(13)
      545                       then do:
      546                           assign
      547                               p-out-string = p-out-string + "&#13;":U
      548                           .
      549                       end.
      550                       otherwise do:
      551                           assign
      552                               p-out-string = p-out-string + v-current-char
      553                           .
      554                       end.
      555                   end case.
      556               end.
      557           end.
      558       end case.
      559   end.
      560   end .
      561   procedure xmlchar-encode-1c :
      562   define input parameter p-in-string      as character        no-undo.
      563   define output parameter p-out-string    as character        no-undo.
      564       define variable v-position      as integer      no-undo.
      565       define variable v-current-char  as character    no-undo.
      566   do
      567   on error undo, return error
      568   :
      569       assign
      570           p-out-string = "":U
      571       .
      572       case p-in-string
      573       :
      574           when ?
      575           then do:
      576               assign
      577                   p-out-string = "?":U
      578               .
      579           end.
      580           otherwise do:
