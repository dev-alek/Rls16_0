      654                       when chr(13)
      655                       then do:
      656                           assign
      657                               p-out-string = p-out-string + " ":U
      658                           .
      659                       end.
      660                       otherwise do:
      661                           assign
      662                               p-out-string = p-out-string + v-current-char
      663                           .
      664                       end.
      665                   end case.
      666               end.
      667           end.
      668       end case.
      669   end.
      670   end .
      671   procedure xmlchar-decode :
      672   define input parameter p-in-string      as character        no-undo.
      673   define output parameter p-out-string    as character        no-undo.
      674       define variable v-position      as integer      no-undo.
      675       define variable v-last-position as integer      no-undo.
      676       define variable v-temp-integer  as integer      no-undo.
      677       define variable v-current-char  as character    no-undo.
      678       define variable v-next-char     as character    no-undo.
      679       define variable v-success       as logical      no-undo.
      680   do
      681   on error undo, return error
      682   :
      683       assign
      684           p-out-string = "":U
      685           v-position   = 0
      686       .
      687       replace-cycle:
      688       do while yes
      689       on error undo, return error
      690       :
      691           assign
      692               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      693           .
      694           if v-last-position <= v-position
      695           then do:
      696               if v-position = 0
      697               then do:
      698                   assign
      699                       p-out-string = p-in-string
      700                   .
      701               end.
      702               else do:
      703                   assign
      704                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      705                   .
      706               end.
      707               leave replace-cycle.
      708           end.
      709           else do:
      710               assign
      711                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      712                   v-position      = v-last-position
      713                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      714               .
      715               if v-current-char = "#":U
      716               then do:
      717                   assign
      718                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      719                   .
      720                   if v-last-position > 0
      721                   then do:
      722                       run xmlchar-read-integer in this-procedure
      723                        (
      724                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      725                           , output v-temp-integer
      726                           , output v-success
      727                       ).
      728                       if v-success = yes
      729                       and v-temp-integer >= 1
      730                       and v-temp-integer <= 255
      731                       then do:
      732                           assign
      733                               p-out-string = p-out-string + chr( v-temp-integer )
      734                               v-position   = v-last-position + 1
      735                           .
      736                       end.
      737                       else do:
      738                           assign
      739                               p-out-string = p-out-string + "&":U
      740                               v-position   = v-position   + 1
      741                           .
      742                       end.
      743                   end.
      744                   else do:
      745                       assign
      746                           p-out-string = p-out-string + "&":U
      747                           v-position   = v-position   + 1
      748                       .
      749                   end.
      750               end.
      751               else do:
      752                   case substring( p-in-string, v-position + 1, 3 )
      753                   :
      754                       when "lt;":U
      755                       then do:
      756                           assign
      757                               p-out-string = p-out-string + "<":U
      758                               v-position   = v-position   + 3
      759                           .
      760                       end.
      761                       when "gt;":U
      762                       then do:
      763                           assign
      764                               p-out-string = p-out-string + ">":U
      765                               v-position   = v-position   + 3
      766                           .
      767                       end.
      768                       otherwise do:
      769                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      770                           then do:
      771                               assign
      772                                   p-out-string = p-out-string + "&":U
      773                                   v-position   = v-position   + 4
      774                               .
      775                           end.
      776                           else do:
      777                               case substring( p-in-string, v-position + 1, 5 )
      778                               :
      779                                   when "quot;":U
      780                                   then do:
      781                                       assign
      782                                           p-out-string = p-out-string + '"':U
      783                                           v-position   = v-position   + 5
      784                                       .
      785                                   end.
      786                                   when "apos;":U
      787                                   then do:
      788                                       assign
      789                                           p-out-string = p-out-string + "'":U
      790                                           v-position   = v-position   + 5
      791                                       .
      792                                   end.
      793                                   otherwise do:
      794                                       assign
      795                                           p-out-string = p-out-string + "&":U
      796                                       .
      797                                   end.
      798                               end case.
      799                           end.
      800                       end.
      801                   end case.
      802               end.
      803           end.
      804       end.
      805   end.
      806   end .
      807   procedure xmlchar-read-integer :
      808   define input parameter p-input-string      as character        no-undo.
      809   define output parameter p-output-integer   as integer          no-undo.
      810   define output parameter p-success       as logical          no-undo.
      811   do
      812   on error undo, return error
      813   :
      814       assign
      815           p-output-integer = integer( p-input-string )
      816       no-error.
      817       if error-status :error
      818       then do:
      819           assign
      820               p-success           = no
      821               p-output-integer    = 0
      822           .
      823       end.
      824       else do:
      825           assign
      826               p-success           = yes
      827           .
      828       end.
      829   end.
      830   end.
      831   define variable v-bgelib-bgeclall           as logical      no-undo.
      832   define variable v-bgelib-bgedict            as logical      no-undo.
      833   define temp-table temp_ext-doc-type no-undo
      834       field edt-key               as integer
      835       field ext-doc-type          as character
      836       field ext-doc-type-label    as character
      837       index pi is primary unique
      838           edt-key
      839   .
      840   define temp-table temp_bgelib_goods no-undo
      841       field gds-code as integer
      842       index pi is primary unique
      843           gds-code
      844   .
      845   define temp-table temp_bgelib_clients no-undo
      846       field obj-type as character
      847       field obj-code as integer
      848       index pi is primary unique
      849           obj-type
      850           obj-code
      851   .
      852   define temp-table temp_bgelib_dis-card no-undo
      853       field d-card as character
      854       index pi is primary unique
      855           d-card
      856   .
      857   define temp-table temp_bgelib_trn-doc no-undo
      858       field doc-code as integer
      859   .
      860   procedure bgelib-tag-open:
      861   do
      862   on error undo, return error
      863   :
      864   define input parameter v-tag-level  as integer      no-undo.
      865   define input parameter v-tag-name   as character    no-undo.
      866   define input parameter v-tag-value  as character    no-undo.
      867       put stream stmXMLOut unformatted
      868           chr(10)
      869           + fill(" ", 4 * v-tag-level)
      870           + "<" + v-tag-name
      871           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      872           + v-tag-value + ">"
      873       .
      874   end.
      875   end procedure.
      876   procedure bgelib-tag-put:
      877   do
      878   on error undo, return error
      879   :
      880   define input parameter v-tag-level      as integer      no-undo.
      881   define input parameter v-tag-name       as character    no-undo.
      882   define input parameter v-tag-value      as character    no-undo.
      883   define input parameter v-empty-mode     as integer      no-undo.
      884       v-tag-name = trim(v-tag-name).
      885       if  v-empty-mode = 1
      886       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      887       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      888       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      889       then do:
      890           run xmlchar-encode in this-procedure (
      891                 input v-tag-value
      892               , output v-tag-value
      893           ).
      894           put stream stmXMLOut unformatted
      895               chr(10) + fill(" ", 4 * v-tag-level)
      896                           + '<' + v-tag-name + '>'
      897                           + v-tag-value
      898                           + '</' + v-tag-name + '>'
      899           .
      900       end.
      901   end.
      902   end procedure.
      903   procedure bgelib-tag-close:
      904   do
      905   on error undo, return error
      906   :
      907   define input parameter v-tag-level as integer      no-undo.
      908   define input parameter v-tag-name  as character    no-undo.
      909       put stream stmXMLOut unformatted
      910           chr(10)
      911           + fill( " ", 4 * v-tag-level)
      912           + '</' + v-tag-name + '>'
      913       .
      914   end.
      915   end procedure.
      916   procedure bgelib-write-log:
      917   do
      918   on error undo, return error
      919   :
      920   define input parameter v-filename   as character    no-undo.
      921   define input parameter v-log-level  as integer      no-undo.
      922   define input parameter v-out-string as character    no-undo.
      923       output stream stmXMLLog to value( v-filename ) append.
      924       put stream stmXMLLog unformatted
      925           chr(10)
      926       .
      927       put stream stmXMLLog unformatted
      928           ( if v-log-level = 0
      929             or v-out-string = "&DLine"
      930             or v-out-string = "&Line"
      931             then ""
      932             else cur-time-string-sec() + " " )
      933       .
      934       put stream stmXMLLog unformatted
      935           ( if v-out-string = "&Line"
      936             then fill( "-", 80 )
      937             else if v-out-string = "&DLine"
      938                  then fill( "=", 80 )
      939                  else v-out-string )
      940       .
      941       output stream stmXMLLog close.
      942   end.
      943   end procedure.
      944   procedure bgelib-write-edt:
      945   do
      946   on error undo, return error
      947   :
      948   define input parameter v-editor-handle    as handle       no-undo.
      949   define input parameter v-log-level        as integer      no-undo.
      950   define input parameter v-out-string       as character    no-undo.
      951       if valid-handle ( v-editor-handle )
      952       then do:
      953           v-editor-handle :move-to-eof().
      954           v-editor-handle :insert-string( ( if v-log-level = 0
      955                                             or v-out-string = "&DLine"
      956                                             or v-out-string = "&Line"
      957                                             then ""
      958                                             else cur-time-string-sec() + " "
      959                                         ) ).
      960           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      961                                             then fill( "-", 80 )
      962                                             else if v-out-string = "&DLine" then fill("=", 80)
      963                                             else fill( " ", v-log-level) + v-out-string
      964                                         ) ).
      965           v-editor-handle :insert-string( chr(10) ).
      966       end.
      967       process events.
      968       output to 'bgescn.txt' append.
      969           put unformatted
      970               chr(10)
      971               string( ( if v-log-level = 0
      972                         or v-out-string = "&DLine"
      973                         or v-out-string = "&Line"
      974                         then ""
      975                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      976                     ) )
      977               string( ( if v-out-string = "&Line"
      978                         then fill( "-", 80 )
      979                         else if v-out-string = "&DLine"
      980                              then fill( "=", 80 )
      981                              else fill( " ", v-log-level ) + v-out-string
      982                     ) )
      983           .
      984       output close.
      985   end.
      986   end procedure.
      987   procedure bgelib-show-cnt:
      988   do
      989   on error undo, return error
      990   :
      991   define input parameter v-fillin-handle     as handle   no-undo.
      992       if valid-handle( v-fillin-handle )
      993       then do:
      994           assign
      995               v-fillin-handle :visible = true
      996           .
      997       end.
      998   end.
      999   end procedure.
     1000   procedure bgelib-hide-cnt:
     1001   do
     1002   on error undo, return error
     1003   :
     1004   define input parameter v-fillin-handle     as handle   no-undo.
     1005       if valid-handle( v-fillin-handle )
     1006       then do:
     1007           assign v-fillin-handle :visible = false.
     1008       end.
     1009   end.
     1010   end procedure.
     1011   procedure bgelib-write-cnt:
     1012   do
     1013   on error undo, return error
     1014   :
     1015   define input parameter v-fillin-handle    as handle       no-undo.
     1016   define input parameter v-fillin-string    as character    no-undo.
     1017       if valid-handle( v-fillin-handle )
     1018       then do:
     1019           assign
     1020               v-fillin-handle :SCREEN-value = v-fillin-string
     1021           .
     1022       end.
     1023   end.
     1024   end procedure.
     1025   procedure bgelib-write-header:
     1026   do
     1027   on error undo, return error
     1028   :
     1029   define input parameter p-first-file     as logical      no-undo.
     1030   define input parameter p-xml-file-name  as character    no-undo.
     1031   define input parameter p-list-file-name as character    no-undo.
     1032   define input parameter p-file-number    as integer      no-undo.
     1033   define input parameter p-have-prev      as logical      no-undo.
     1034   define input parameter p-prev-filename  as character    no-undo.
     1035   define input parameter p-obj-list       as character    no-undo.
     1036   define input parameter p-doc-type-list  as character    no-undo.
     1037   define input parameter p-parameter-list as character    no-undo.
     1038       define variable v-counter    as integer        no-undo.
     1039       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1040       put stream stmXMLOut unformatted
     1041           "<?xml version='1.0' encoding='windows-1251'?>"
     1042       .
     1043       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1044       run bgelib-tag-open( input 0, input "header", input "" ).
     1045       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1046       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1047       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1048       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1049       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1050       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1051       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1052       :
     1053           run bgelib-tag-put(
     1054                 input 1
     1055               , input entry( 2 * v-counter, p-parameter-list )
     1056               , input entry( 2 * v-counter + 1, p-parameter-list )
     1057               , input 0
     1058           ).
     1059       end.
     1060       run bgelib-tag-close( input 0, input "header" ).
     1061       output stream stmXMLOut close.
     1062       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1063       if p-first-file = yes
     1064       then do:
     1065           put stream stmXMLOut unformatted
     1066               "<?xml version='1.0' encoding='windows-1251'?>"
     1067           .
     1068           run bgelib-tag-open( input 0, input "export", input "" ).
     1069       end.
     1070       run bgelib-tag-open( input 1, input "file", input "" ).
     1071       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1072       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1073       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1074       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1075       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1076       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1077       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1078       :
     1079           run bgelib-tag-put(
     1080                 input 2
     1081               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1082               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1083               , input 0
     1084           ).
     1085       end.
     1086       run bgelib-tag-close( input 1, input "file" ).
     1087       output stream stmXMLOut close.
     1088   end.
     1089   end procedure.
     1090   procedure bgelib-write-footer:
     1091   do
     1092   on error undo, return error
     1093   :
     1094   define input parameter p-last-file      as logical      no-undo.
     1095   define input parameter p-xml-file-name  as character    no-undo.
     1096   define input parameter p-list-file-name as character    no-undo.
     1097   define input parameter p-have-next      as logical      no-undo.
     1098   define input parameter p-next-file-name as character    no-undo.
     1099       define variable v-error-num     as integer           no-undo.
     1100       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1101       if p-have-next = yes
     1102       then do:
     1103           run bgelib-tag-open( input 0, input "footer", "" ).
     1104           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1105           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1106           run bgelib-tag-close( input 0, input "footer" ).
     1107       end.
     1108       run bgelib-tag-close( input 0, input "root" ).
     1109       output stream stmXMLOut close.
     1110       run bge/os_copy.p (
     1111             input "M"
     1112           , input p-xml-file-name + "tmp"
     1113           , input p-xml-file-name + "xml"
     1114           , output v-error-num
     1115       ).
     1116       if p-last-file = yes
     1117       then do:
     1118           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1119               run bgelib-tag-close( input 0, input "export" ).
     1120           output stream stmXMLOut close.
     1121           run bge/os_copy.p (
     1122                 input "M"
     1123               , input p-list-file-name + "tmp"
     1124               , input p-list-file-name + "xml"
     1125               , output v-error-num
     1126           ).
     1127       end.
     1128   end.
     1129   end procedure.
     1130   procedure bgelib-filename :
     1131   do
     1132   on error undo, return error
     1133   :
     1134   define input parameter p-prefix             as character    no-undo.
     1135   define output parameter p-xml-file-name     as character    no-undo.
     1136   define output parameter p-log-file-name     as character    no-undo.
     1137   define output parameter p-list-file-name    as character    no-undo.
     1138       define variable v-home-dir  as character    no-undo.
     1139       define variable v-error-num as integer      no-undo.
     1140       get-key-value section "BGE" key "outdir" value v-home-dir.
     1141       if v-home-dir = ?
     1142       then do:
     1143           message
     1144             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1145             skip(1)
     1146             skip "Обратитесь к администратору."
     1147           view-as alert-box error.
     1148           undo, return error .
     1149       end.
     1150       run gbl/dir-cre.p (
     1151           input v-home-dir
     1152       ) no-error.
     1153       if error-status :error
     1154       then do:
     1155           message
     1156             skip "Неверно задан каталог экспорта."
     1157             skip(1)
     1158             skip "Обратитесь к администратору."
     1159           view-as alert-box error.
     1160           undo, return error .
     1161       end.
     1162       run bge/genfname.p (
     1163             input v-home-dir
     1164           , input p-prefix
     1165           , input ""
     1166           , input "xml"
     1167           , input "tmp"
     1168           , output p-xml-file-name
     1169       ).
     1170       assign
     1171           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1172           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1173           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1174       .
     1175   end.
     1176   end procedure.
     1177   procedure bgelib-read-config :
     1178   do
     1179   on error undo, return error
     1180   :
     1181   define variable v-par-type as character     no-undo.
     1182     define variable v-param-type      as character  no-undo .
     1183     define variable v-value-character as character  no-undo .
     1184     define variable v-value-date      as date       no-undo .
     1185     define variable v-value-decimal   as decimal    no-undo .
     1186     define variable v-value-integer   as integer    no-undo .
     1187     define variable v-value-logical   as logical    no-undo .
     1188     define variable v-tth             as handle     no-undo .
     1189       assign
     1190           v-bgelib-bgeclall = no
     1191           v-bgelib-bgedict  = no
     1192       .
     1193       run adm/shattri.p ( input "get":U
     1194                         , input  '':u
     1195                         , input  0
     1196                         , input  'bge-export':U
     1197                         , input  'bgeclall':U
     1198                         , output v-value-character
     1199                         , output v-value-date
     1200                         , output v-value-decimal
     1201                         , output v-value-integer
     1202                         , output v-value-logical
     1203                         , output v-param-type
     1204                         , input-output table-handle v-tth
     1205                         ) no-error .
     1206       if error-status :error
     1207       then do:
     1208         assign
     1209           v-bgelib-bgeclall = no
     1210         .
     1211       end.
     1212       else do:
     1213         assign
     1214           v-bgelib-bgeclall = v-value-logical
     1215         .
     1216       end.
     1217       delete object v-tth.
     1218       run adm/shattri.p ( input "get":U
     1219                         , input  '':u
     1220                         , input  0
     1221                         , input  'bge-export':U
     1222                         , input  'bgedict':U
     1223                         , output v-value-character
     1224                         , output v-value-date
     1225                         , output v-value-decimal
     1226                         , output v-value-integer
     1227                         , output v-value-logical
     1228                         , output v-param-type
     1229                         , input-output table-handle v-tth
     1230                         ) no-error .
     1231       if error-status :error
     1232       then do:
     1233         assign
     1234           v-bgelib-bgedict = no
     1235         .
     1236       end.
     1237       else do:
     1238         assign
     1239           v-bgelib-bgedict = v-value-logical
     1240         .
     1241       end.
     1242       delete object v-tth.
     1243       run adm/shattri.p ( input "get":U
     1244                         , input  '':u
     1245                         , input  0
     1246                         , input  'bge-export':U
     1247                         , input  'bgefmt':U
     1248                         , output v-value-character
     1249                         , output v-value-date
     1250                         , output v-value-decimal
     1251                         , output v-value-integer
     1252                         , output v-value-logical
     1253                         , output v-param-type
     1254                         , input-output table-handle v-tth
     1255                         ) no-error .
     1256       if error-status :error
     1257       then do:
     1258         assign
     1259           v-bgelib-bgefmt  = "xml":U
     1260         .
     1261       end.
     1262       else do:
     1263         assign
     1264           v-bgelib-bgefmt  = v-value-character
     1265         .
     1266       end.
     1267       delete object v-tth.
     1268       run adm/shattri.p ( input "get":U
     1269                         , input  '':u
     1270                         , input  0
     1271                         , input  'bge-export':U
     1272                         , input  'bgeflold':U
     1273                         , output v-value-character
     1274                         , output v-value-date
     1275                         , output v-value-decimal
     1276                         , output v-value-integer
     1277                         , output v-value-logical
     1278                         , output v-param-type
     1279                         , input-output table-handle v-tth
     1280                         ) no-error .
     1281       if error-status :error
     1282       then do:
     1283         assign
     1284           v-bgelib-bgeflold  = "old":U
     1285         .
     1286       end.
     1287       else do:
     1288         assign
     1289           v-bgelib-bgeflold  = v-value-character
     1290         .
     1291       end.
     1292       delete object v-tth.
     1293   end.
     1294   end procedure.
     1295   procedure bgelib-check-file-size :
     1296   do
     1297   on error undo, return error
     1298   :
     1299   define input parameter p-out-filename   as character    no-undo.
     1300   define output parameter p-is-big        as logical      no-undo.
     1301       define variable v-current-position    as integer        no-undo.
     1302       assign
     1303           v-current-position = seek( stmXMLOut )
     1304       .
     1305       if v-current-position / 1024 / 1024  >= 100
     1306       then do:
     1307           assign
     1308               p-is-big = yes
     1309           .
     1310       end.
     1311   end.
     1312   end procedure.
     1313   procedure bgelib-init-ext-doc-type :
     1314       define variable v-counter    as integer      no-undo.
     1315       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1316   do
     1317   for buf_temp_ext-doc-type
     1318   on error undo, return error
     1319   :
     1320       empty temp-table buf_temp_ext-doc-type.
     1321       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1322       :
     1323           create buf_temp_ext-doc-type.
     1324           assign
     1325               buf_temp_ext-doc-type.edt-key               = v-counter
     1326               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1327               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1328           .
     1329       end.
     1330   end.
     1331   end procedure.
     1332   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1334   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1335   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1336   define variable gp-excise     like ub.price-list.excise     no-undo.
     1337   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1338   define variable gp-fact-order as decimal   no-undo .
     1339   define variable gp-price-sale-parts as decimal   no-undo .
     1340   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1341     define variable v-cntxt-db-num        as integer   no-undo .
     1342     define variable v-cntxt-userid        as character no-undo .
     1343     define variable v-cntxt-level         as character no-undo .
     1344     define variable v-cntxt-host-code-obj as integer   no-undo .
     1345     define variable v-cntxt-obj-type      as character no-undo .
     1346     define variable v-cntxt-obj-code      as integer   no-undo .
     1347     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1348     define variable v-cntxt-is-admin      as logical   no-undo .
     1349   define input parameter parparentproc    as handle           no-undo.
     1350   define input parameter p-shedule        as logical          no-undo.
     1351   define input parameter p-mode           as character        no-undo.
     1352   define input parameter table for temp_bgelib_goods .
     1353   define input parameter p-host-code      as integer          no-undo.
     1354   define input parameter p-range          as integer          no-undo.
     1355   define input parameter p-obj-list       as character        no-undo.
     1356   define input parameter p-edt-handle     as handle           no-undo.
     1357   define input parameter p-cnt-handle     as handle           no-undo.
     1358       define variable v-have-rights       as logical          no-undo.
     1359       define variable v-log-string        as character        no-undo.
     1360       define variable v-obj-counter       as integer          no-undo.
     1361       define variable v-xml-file-name     as character        no-undo.
     1362       define variable v-log-file-name     as character        no-undo.
     1363       define variable v-list-file-name    as character        no-undo.
     1364       define variable v-xml-file-number   as integer          no-undo.
     1365       define variable v-cancel            as logical          no-undo.
     1366       define variable v-parameter-list    as character        no-undo.
     1367   do
     1368   on error undo, return error
     1369   :
     1370       process events.
     1371       if p-shedule = no
     1372       then do:
     1373   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374     run mainmenu_getcntxt in parparentproc
     1375       (output v-cntxt-db-num
     1376       ,output v-cntxt-userid
     1377       ,output v-cntxt-level
     1378       ,output v-cntxt-host-code-obj
     1379       ,output v-cntxt-obj-type
     1380       ,output v-cntxt-obj-code
     1381       ,output v-cntxt-db-num-obj
     1382       ,output v-cntxt-is-admin
     1383       ) .
     1384   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   do:
     1386     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1387       (input  v-cntxt-db-num
     1388       ,input  v-cntxt-userid
     1389       ,input  0
     1390       ,input  'actn_references_export':U
     1391       ,input  'global':U
     1392       ,input  0
     1393       ,input  '':U
     1394       ,input  0
     1395       ,input  0
     1396       ,input  0
     1397       ,input  0
     1398       ,input  yes
     1399       ,output v-have-rights
     1400       )  .
     1401   end.
     1402           if not v-have-rights
     1403           then do:
     1404               undo, return error.
     1405           end.
     1406       end.
     1407       run bgelib-read-config in this-procedure no-error.
     1408       if error-status :error
     1409       then do:
     1410           message
     1411           vss-workfile vss-revision vss-description
     1412           skip "Ошибка чтения параметров экспорта."
     1413           skip "Для экспорта данных будут приняты параметры по умолчанию."
     1414           skip return-value
     1415           skip trim(error-status :get-message(1))
     1416                trim(error-status :get-message(2))
     1417                trim(error-status :get-message(3))
     1418           view-as alert-box error.
     1419       end.
     1420       run init-temphost.
     1421       assign
     1422           v-log-string = ", по всем фирмам"
     1423       .
     1424       case p-range:
     1425       when 2
     1426       then do:
     1427           for each temp-obj
     1428           where temp-obj.host-code <> p-host-code
     1429           :
     1430               delete temp-obj.
     1431           end.
     1432           assign
     1433               v-log-string = ", по фирме (код фирмы " + string( p-host-code ) + ")"
     1434           .
     1435       end.
     1436       when 3
     1437       then do:
     1438           for each temp-obj
     1439           :
     1440               delete temp-obj.
     1441           end.
     1442           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1443           :
     1444               create temp-obj.
     1445               assign
     1446                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     1447                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1448               no-error .
     1449               if error-status :error
     1450               then do:
     1451                   message
     1452                   vss-workfile vss-revision vss-description
     1453                   skip "Ошибка чтения списка объектов"
     1454                   skip return-value
     1455                   skip trim(error-status :get-message(1))
     1456                       trim(error-status :get-message(2))
     1457                       trim(error-status :get-message(3))
     1458                   view-as alert-box error.
     1459                   undo, return error .
     1460               end.
     1461   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1463     (input  temp-obj.obj-type
     1464     ,input  temp-obj.obj-code
     1465     ,output temp-obj.host-code
     1466     ) no-error .
     1467               if error-status :error
     1468               then do:
     1469                   message
     1470                   vss-workfile vss-revision vss-description
     1471                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     1472                   skip return-value
     1473                   skip trim(error-status :get-message(1))
     1474                       trim(error-status :get-message(2))
     1475                       trim(error-status :get-message(3))
     1476                   view-as alert-box error.
     1477                   undo, return error .
     1478               end.
     1479           end.
     1480           assign
     1481               v-log-string = ", по объектам: " + p-obj-list
     1482           .
     1483       end.
     1484       end case.
     1485       run bgelib-filename in this-procedure (
     1486             input "prc"
     1487           , output v-xml-file-name
     1488           , output v-log-file-name
     1489           , output v-list-file-name
     1490       ).
     1491       run gbl/waitfrsp.w (
     1492             input substring( v-xml-file-name, 1, 1 )
     1493           , input 200
     1494           , output v-cancel
     1495       ) .
     1496       if v-cancel = yes
     1497       then do:
     1498           undo, return error .
     1499       end.
     1500       run bgelib-write-log in this-procedure (
     1501             input v-log-file-name
     1502           , input 1
     1503           , input "&DLine"
     1504       ).
     1505       run bgelib-write-log in this-procedure (
     1506             input v-log-file-name
     1507           , input 1
     1508           , input substitute( "Начало выгрузки в файл &1"
     1509                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1510                             )
     1511       ).
     1512       run bgelib-write-log in this-procedure (
     1513             input v-log-file-name
     1514           , input 1
     1515           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     1516       ).
     1517       assign
     1518           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1519                                                  , 4
     1520                                                  , "docName"          , "prices":U
     1521                                                  , "version"          , replace("14.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1522                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1523                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1524                                                 )
     1525       .
     1526       run bgelib-write-header in this-procedure (
     1527             input yes
     1528           , input v-xml-file-name
     1529           , input v-list-file-name
     1530           , input 1
     1531           , input no
     1532           , input "":U
     1533           , input p-obj-list
     1534           , input "":U
     1535           , input v-parameter-list
     1536       ).
     1537       object-of-list:
     1538       for each temp-obj
     1539       :
     1540           run export-prices-by-object in this-procedure (
     1541                 input temp-obj.host-code
     1542               , input temp-obj.obj-type
     1543               , input temp-obj.obj-code
     1544               , input v-xml-file-name
     1545               , input v-log-file-name
     1546               , input v-list-file-name
     1547               , input v-xml-file-number
     1548               , output v-xml-file-name
     1549               , output v-xml-file-number
     1550           ) no-error.
     1551           if error-status :error
     1552           then do:
     1553               message
     1554               vss-workfile vss-revision vss-description
     1555               skip "Ошибка экспорта цен товаров по объекту"
     1556               skip "Тип объекта:" temp-obj.obj-type
     1557               skip "Код объекта:" temp-obj.obj-code
     1558               skip return-value
     1559               skip trim(error-status :get-message(1))
     1560                    trim(error-status :get-message(2))
     1561                    trim(error-status :get-message(3))
     1562               view-as alert-box error.
     1563               next object-of-list.
     1564           end.
     1565       end.
     1566       run bgelib-write-footer in this-procedure (
     1567             input yes
     1568           , input v-xml-file-name
     1569           , input v-list-file-name
     1570           , input no
     1571           , input ""
     1572       ).
     1573       run bgelib-write-log in this-procedure (
     1574             input v-log-file-name
     1575           , input 1
     1576           , input substitute( "Данные выгружены в файл &1"
     1577                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1578                             )
     1579       ).
     1580       run bgelib-write-log in this-procedure (
     1581             input v-log-file-name
     1582           , input 1
     1583           , input "&DLine"
     1584       ).
     1585   end.
     1586   procedure export-prices-by-object :
     1587   define input parameter p-host-code              as integer      no-undo.
     1588   define input parameter p-obj-type               as character    no-undo.
     1589   define input parameter p-obj-code               as integer      no-undo.
     1590   define input parameter p-xml-file-name          as character    no-undo.
     1591   define input parameter p-log-file-name          as character    no-undo.
     1592   define input parameter p-list-file-name         as character    no-undo.
     1593   define input parameter p-xml-file-number        as integer      no-undo.
     1594   define output parameter p-new-xml-file-name     as character    no-undo.
     1595   define output parameter p-new-xml-file-number   as integer      no-undo.
     1596       define variable v-cnt-is-active    as logical      no-undo.
     1597       define variable v-goods-counter    as integer      no-undo.
     1598       define buffer buf_goods     for ub.goods.
     1599   do
     1600   on error undo, return error
     1601   :
     1602       assign
     1603           p-new-xml-file-name     = p-xml-file-name
     1604           p-new-xml-file-number   = p-xml-file-number
     1605       .
     1606       run bgelib-write-edt(
     1607             input p-edt-handle
     1608           , input 1
     1609           , input string( p-obj-type ) + " " + string( p-obj-code )
     1610       ).
     1611       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1612       export-goods-on-object:
     1613       for each buf_goods no-lock
     1614       on error undo, return error
     1615       :
     1616   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1617   gp-fact-order = 0 .
     1618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1619     (input  buf_goods.gds-code
     1620     ,input  ?
     1621     ,output gp-b-code
     1622     ) no-error .
     1623   if error-status:error then do:
     1624     message
     1625       error-status :get-message(1) skip
     1626       return-value skip
     1627       view-as alert-box error .
     1628     return error.
     1629   end.
     1630   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1632     (input  p-obj-type
     1633     ,input  p-obj-code
     1634     ,input  gp-b-code
     1635     ,input  0
     1636     ,input  gp-fact-order
     1637     ,output gp-doc-num
     1638     ,output gp-price-sale
     1639     ,output gp-road-tax
     1640     ,output gp-excise
     1641     ) no-error .
     1642   if error-status:error then do:
     1643     return error.
     1644   end.
     1645   gp-price-sale-parts = gp-price-sale.
     1646   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1647   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     1648     (input  p-obj-type
     1649     ,input  p-obj-code
     1650     ,input  gp-b-code
     1651     ,input  0
     1652     ,input  gp-fact-order
     1653     ,output gp-doc-num
     1654     ,output gp-price-sale-parts
     1655     ,output gp-road-tax
     1656     ,output gp-excise
     1657     ) no-error .
     1658   if error-status:error then do:
     1659     return error.
     1660   end.
     1661   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1662       gp-price-sale = gp-price-sale-parts.
     1663    end.
     1664           if error-status :error
     1665           then do:
     1666               run bgelib-write-log in this-procedure (
     1667                     input v-log-file-name
     1668                   , input 1
     1669                   , input substitute( "*** ERR *** Не удалось определить цену продажи на объекте &1 &2 для товара с кодом &3"
     1670                                       , p-obj-type
     1671                                       , p-obj-code
     1672                                       , buf_goods.gds-code )
     1673               ).
     1674               undo export-goods-on-object, next export-goods-on-object.
     1675           end.
     1676           if gp-price-sale <> ?
     1677           then do:
     1678               run bgelib-tag-open in this-procedure ( input 0, input "prc", input "" ).
     1679               run bgelib-tag-put in this-procedure ( input 1, input "objType"  , input string( p-obj-type )           , input 1 ).
     1680               run bgelib-tag-put in this-procedure ( input 1, input "objCode"  , input string( p-obj-code )           , input 1 ).
     1681               run bgelib-tag-put in this-procedure ( input 1, input "goodsID"  , input string( buf_goods.gds-code )   , input 1 ).
     1682               run bgelib-tag-put in this-procedure ( input 1, input "docID"    , input string( gp-doc-num )           , input 0 ).
     1683               run bgelib-tag-put in this-procedure ( input 1, input "price"    , input string( gp-price-sale )        , input 1 ).
     1684               run bgelib-tag-put in this-procedure ( input 1, input "roadTax"  , input string( gp-road-tax   )        , input 2 ).
     1685               run bgelib-tag-put in this-procedure ( input 1, input "excise"   , input string( gp-excise     )        , input 2 ).
     1686               run bgelib-tag-close in this-procedure ( input 0, input "prc" ).
     1687           end.
     1688           if v-cnt-is-active = no
     1689           then do:
     1690               run bgelib-show-cnt in this-procedure (
     1691                   input p-cnt-handle
     1692               ).
     1693               assign
     1694                   v-cnt-is-active = yes
     1695               .
     1696               run bgelib-write-cnt(
     1697                     input p-cnt-handle
     1698                   , input substitute( "Объект: &1&2 Товаров: &3", p-obj-type, p-obj-code, 1 )
     1699               ).
     1700               process events.
     1701           end.
     1702           assign
     1703               v-goods-counter = v-goods-counter + 1
     1704           .
     1705           if v-goods-counter modulo 100 = 0
     1706           then do:
     1707               run bgelib-write-cnt(
     1708                     input p-cnt-handle
     1709                   , input substitute( "Объект: &1&2 Товаров: &3", p-obj-type, p-obj-code, v-goods-counter )
     1710               ).
     1711               process events.
     1712           end.
     1713       end.
     1714       output stream stmxmlout close.
     1715       run bgelib-hide-cnt in this-procedure (
     1716           input p-cnt-handle
     1717       ).
     1718   end.
     1719   end procedure.
