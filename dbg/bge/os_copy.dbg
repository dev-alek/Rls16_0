        1   block-level on error undo, throw.
        2   define input parameter  v-operation as character format "X(1)"  no-undo.
        3   define input parameter  v-file-in   as character                no-undo.
        4   define input parameter  v-file-out  as character                no-undo.
        5   define output parameter v-error-num as integer                  no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: c89b59c2f62e, 135, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Feb 16 20:48:25 2015 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: os_copy.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: bge/os_copy.p $":U .
       11   define variable vss-description as character no-undo init "Копирование, перенос, удаление, печать файлов ОС".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70       define variable v-error-name as char extent 19 init [
       71           "Чужой файл",
       72           "Нет такого файла/директории",
       73           "Работа процедуры прервана",
       74           "Ошибка ввода-вывода",
       75           "Неправильный номер файла",
       76           "Слишком много процессов",
       77           "Не хватает памяти",
       78           "Нарушение прав доступа",
       79           "Неправильный адрес",
       80           "Файл не удален",
       81           "Нет такого устройства",
       82           "Вместо директории указан файл",
       83           "Вместо файла указана директория",
       84           "Переполнение таблицы файлов",
       85           "Слишком много открытых файлов",
       86           "Слишком большой файл",
       87           "Не хватает места на диске",
       88           "Директория не пуста",
       89           "НЕИЗВЕСТНАЯ ОШИБКА"
       90       ] no-undo.
       91       define variable v-operation-num  as integer     no-undo.
       92       define variable v-operation-list as character   no-undo.
       93       define variable v-operation-name as character extent 4 init [
       94             "Копирование из "
       95           , "Перенос из "
       96           , "Удаление "
       97           , "Печать "
       98       ] no-undo.
       99   do
      100   on error undo, return error
      101   :
      102       assign
      103           v-operation-list    = "CMDP"
      104           v-operation-num     = index( v-operation-list, v-operation )
      105       .
      106       if v-operation-num = 0
      107       then do:
      108           message
      109                    vss-workfile vss-revision vss-description
      110               skip "Неправильный тип операции."
      111               skip return-value
      112               skip trim(error-status :get-message(1))
      113                    trim(error-status :get-message(2))
      114                    trim(error-status :get-message(3))
      115           view-as alert-box error.
      116           undo, return error .
      117       end.
      118       assign
      119           v-operation-name[ v-operation-num ] = v-operation-name[ v-operation-num ]
      120                                                   + v-file-in
      121                                                   + ( if v-operation-num > 2
      122                                                       then ""
      123                                                       else " в " + v-file-out )
      124       .
      125       case v-operation-num:
      126           when 1
      127           then do:
      128               os-copy value(v-file-in) value(v-file-out).
      129           end.
      130           when 2
      131           then do:
      132               os-rename value(v-file-in) value(v-file-out).
      133               if os-error = 999
      134               then do:
      135                   os-copy value(v-file-in) value(v-file-out).
      136                   if os-error = 0 then OS-DELETE value(v-file-in) RECURSIVE.
      137               end.
      138           end.
      139           when 3
      140           then do:
      141               os-delete value( v-file-in ) recursive.
      142           end.
      143           when 4
      144           then do:
      145               os-command silent copy value(v-file-in) value(v-file-out).
      146           end.
      147       end case.
      148       assign
      149           v-error-num = ( if v-operation-num = 3 and os-error = 2 then 0 else os-error ).
      150       .
      151       if v-error-num > 0
      152       then do:
      153           message
      154                    vss-workfile vss-revision vss-description
      155               skip v-operation-name[ v-operation-num ]
      156                       + " - ошибка "
      157                       + trim( string( v-error-num, ">>9" ) )
      158                       + ": "
      159                       + v-error-name[ min( v-error-num, 19 ) ]
      160               skip return-value
      161               skip trim(error-status :get-message(1))
      162                    trim(error-status :get-message(2))
      163                    trim(error-status :get-message(3))
      164           view-as alert-box error.
      165           undo, return error .
      166       end.
      167   end.
