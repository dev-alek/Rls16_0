      664   DEFINE INPUT PARAMETER p-log-handle AS HANDLE NO-UNDO.
      665   DEFINE INPUT PARAMETER p-company AS char NO-UNDO.
      666   DEFINE INPUT PARAMETER p-directory AS CHARACTER NO-UNDO.
      667   DEFINE INPUT PARAMETER p-prefix AS char NO-UNDO.
      668   DEFINE INPUT PARAMETER p-grp-fuel AS char NO-UNDO.
      669   DEFINE INPUT PARAMETER p-grp-spec AS char NO-UNDO.
      670   DEFINE VARIABLE v-logname AS CHARACTER NO-UNDO.
      671   DEFINE VARIABLE file_name AS CHARACTER NO-UNDO.
      672   DEFINE VARIABLE v-date-file AS CHARACTER NO-UNDO.
      673   DEFINE VARIABLE v-numfile AS INTEGER INITIAL 0 NO-UNDO.
      674   DEFINE VARIABLE v-num-SHC AS INTEGER INITIAL 0 NO-UNDO.
      675   DEFINE VARIABLE v-num-SHE AS INTEGER INITIAL 0 NO-UNDO.
      676   DEFINE VARIABLE v-num-SG  AS INTEGER INITIAL 0 NO-UNDO.
      677   DEFINE VARIABLE v-num-SHM AS INTEGER INITIAL 0 NO-UNDO.
      678   define variable v-attr-value    as character no-undo .
      679   define variable v-attr-type     as character no-undo .
      680   def var v-name as char no-undo.
      681   DEFINE VARIABLE v-delim AS CHARACTER NO-UNDO init ';'.
      682   define variable v-is-petrol                 as logical      no-undo.
      683   define variable v-is-pieces                 as logical      no-undo.
      684   DEFINE BUFFER buf_gds-grp FOR gds-grp.
      685   DEFINE BUFFER buf_goods FOR goods.
      686   v-logname = p-directory + "exp-carbon.txt":U.
      687   v-date-file  = STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + substring(string(time,"HH:MM"),1,2) + substring(string(time,"HH:MM"),4,2).
      688   file_name = p-directory + 'TK_':U + v-date-file  + '.csv'.
      689   OUTPUT TO VALUE(file_name).
      690       FIND FIRST db-attr WHERE db-attr.db-num = g#db-num AND db-attr.attr-code = 'Carbon-fileId':U NO-ERROR.
      691       IF AVAILABLE db-attr THEN DO:
      692               v-numfile = INTEGER(db-attr.attr-value) + 1.
      693       END.
      694       ELSE DO:
      695           CREATE db-attr.
      696           ASSIGN
      697               db-attr.db-num = g#db-num
      698               db-attr.attr-code = 'Carbon-fileId':U
      699               db-attr.attr-value =  "1"
      700               v-numfile = 0.
      701       END.
      702     put unformatted  substitute("H&1&2&1&3&1&4&1INC&10",v-delim,'CTL_TNKBP_FED',v-numfile,v-date-file) skip.
      703     Put unformatted substitute("SHC&1&2&1&2&1&2",v-delim,p-prefix) skip.
      704     v-num-SHC = v-num-SHC + 1.
      705     Put unformatted substitute ("SHE&1&2&1&2_&3&1Топливо",v-delim,p-prefix,p-grp-fuel) skip.
      706     v-num-SHE = v-num-SHE + 1.
      707     Put unformatted substitute ("SHE&1&2&1&2_&3&1Спец. группа",v-delim,p-prefix,p-grp-spec) skip.
      708     v-num-SHE = v-num-SHE + 1.
      709     run put-grp(1).
      710     If index(v-name,';') > 0 then v-name = '"' + v-name + '"'.
      711     for each buf_goods where stts = 0 no-lock:
      712         v-name = replace(buf_goods.gds-name,'"',"'").
      713         Put unformatted substitute ("SG&1&2_&3&1&4",v-delim,p-prefix,buf_goods.gds-code,v-name) skip.
      714         v-num-SG = v-num-SG + 1.
      715   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      716     (
      717        input buf_goods.artic
      718     ,  input buf_goods.prod-type
      719     ,  input buf_goods.prod-code
      720     , output v-is-petrol
      721     , output v-is-pieces
      722     ) .
      723          run gds-attr-value in this-procedure
      724           ( input  buf_goods.gds-code
      725           , input  'ban-bonus':U
      726           , output v-attr-value
      727           , output v-attr-type
      728           ) .
      729         if lookup(v-attr-value, 'true,yes':u) > 0 then do:
      730          Put unformatted substitute ("SHM&1&2_&3&1&2&1&2_&4",v-delim,p-prefix,buf_goods.gds-code,p-grp-spec) skip.
      731         end.
      732         else if v-is-petrol then do:
      733             Put unformatted substitute ("SHM&1&2_&3&1&2&1&2_&4",v-delim,p-prefix,buf_goods.gds-code,p-grp-fuel) skip.
      734         end.
      735         else Put unformatted substitute ("SHM&1&2_&3&1&2&1&2_&4",v-delim,p-prefix,buf_goods.gds-code,buf_goods.grp-code) skip.
      736         v-num-SHM = v-num-SHM + 1.
      737     end.
      738     put unformatted  substitute("T&10&10&1&2&10&10&10&1&3&10&1&4&10&10&10&1&5&10&10",v-delim,v-num-SHC,v-num-SHE,v-num-SG,v-num-SHM) skip.
      739     output close.
      740     db-attr.attr-value = string(v-numfile).
      741     procedure put-grp :
      742       define input parameter p-upper   as integer          no-undo.
      743       for each buf_gds-grp where  buf_gds-grp.upper-code = p-upper   no-lock :
      744         Put unformatted substitute ("SHE&1&2&1&2_&3&1&5&4",v-delim,p-prefix,buf_gds-grp.node-code,if buf_gds-grp.upper-code > 1 then ';' + p-prefix + '_' + string(buf_gds-grp.upper-code) else '',buf_gds-grp.node-name) skip.
      745         v-num-SHE = v-num-SHE + 1.
      746         run put-grp(buf_gds-grp.node-code).
      747       end.
      748     end procedure.
