        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: $":U.
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U.
        4   define variable vss-date        as character no-undo init "$Date: $":U.
        5   define variable vss-workfile    as character no-undo init "$Workfile: exp-ATD-shd.p $":U.
        6   define variable vss-archive     as character no-undo init "$Archive: bge/exp-ATD-shd.p $":U.
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input parameter parparentproc as widget-handle no-undo.
       67   define input parameter p_parent-handle as widget-handle no-undo.
       68   define input parameter p_log-handle as handle no-undo.
       69   define input parameter p_db-num-char as character no-undo.
       70   define input parameter p_task-type as character no-undo.
       71   define input parameter p_task-num as integer no-undo.
       72   define input parameter p_db-num as integer no-undo.
       73   define buffer buf_clients for clients.
       74   define temp-table shd-obj-temp no-undo
       75       field obj-type as character
       76       field obj-code as integer.
       77   define variable v-param-list      as character no-undo.
       78   define variable v-param-type      as character no-undo.
       79   define variable p-region          as character no-undo.
       80   define variable FILL-IN-Dir       as character no-undo.
       81   define variable FILL-IN_esys      as character no-undo   .
       82   define variable RADIO-SET-Objects as integer   no-undo.
       83   define variable t_doc_ras         as character no-undo  .
       84   define variable t_doc_pri         as logical   no-undo.
       85   define variable bge-shift-attr    as logical   no-undo.
       86   define variable exp-bge-stts      as logical   no-undo.
       87   define variable i-pit             as integer   no-undo.
       88   define variable i-nom             as integer   no-undo.
       89   define variable v-grp-code-nom    as character no-undo   .
       90   define variable v-grp-code-pit    as character no-undo   .
       91   define variable code_no-exp       as character no-undo   .
       92   define variable v-list-pay        as character no-undo   .
       93   define variable v-list-abbr       as character no-undo   .
       94   define variable v-entry           as character no-undo.
       95   define variable v-obj-list        as character no-undo.
       96   define variable ii                as integer   no-undo.
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define temp-table temp-schedule-free no-undo
       99   field free-id as character
      100   field free-task-name as character
      101   field proc-run-name as character
      102   field proc-param-edit-name as character
      103   field conf-param as character
      104   field is-gbd as logical
      105   field is-ubd as logical
      106   field enable-concurrent-0 as logical
      107   field enable-concurrent-db as logical
      108   field other-info as character
      109   field enc-key as character
      110   field is-rum as logical
      111   index pi is unique primary
      112   free-id.
      113   procedure schedule-attr-name :
      114   do
      115     on error undo, return error
      116     :
      117     define input  parameter p-code           as character no-undo .
      118     define output parameter p-type           as character no-undo .
      119     define output parameter p-format         as character no-undo .
      120     define output parameter p-label          as character no-undo .
      121     define output parameter p-user-can-edit  as logical   no-undo .
      122     define output parameter p-output-display as logical   no-undo .
      123     define output parameter p-other          as character no-undo .
      124       if index(p-code, chr(4)) > 0 then do:
      125         p-code = entry(1, p-code, chr(4)).
      126       end.
      127       case p-code :
      128               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      129               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      130               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      131               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      132               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      133               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      134               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      135               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      136               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      137         otherwise do:
      138           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      139         end.
      140       end.
      141     end.
      142   end procedure.
      143   procedure schedule-attr-tooltip :
      144   do
      145     on error undo, return error
      146     :
      147       define input  parameter p-code    as character no-undo .
      148       define output parameter p-tooltip as character no-undo .
      149       define output parameter p-label   as character no-undo .
      150       if index(p-code, chr(4)) > 0 then do:
      151         p-code = entry(1, p-code, chr(4)).
      152       end.
      153       case p-code :
      154               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      155               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      156               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      157               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      158               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      159               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      160               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      161               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      162               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      163         otherwise do:
      164               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      165         end.
      166       end.
      167     end.
      168   end procedure.
      169   procedure schedule-attr-value :
      170   do
      171   on error undo, return error return-value
      172   :
      173   define input parameter  p-cre-db-num as integer    no-undo.
      174   define input parameter  p-task-type  as character  no-undo.
      175   define input parameter  p-task-num   as integer    no-undo.
      176   define input parameter  p-code       as character  no-undo.
      177   define output parameter p-value      as character  no-undo.
      178   define output parameter p-type       as character  no-undo.
      179       define variable v-format         as character no-undo .
      180       define variable v-label          as character no-undo .
      181       define variable v-user-can-edit  as logical   no-undo .
      182       define variable v-output-display as logical   no-undo .
      183       define variable v-other          as character no-undo .
      184       define buffer buf_schedule-attr for ub.schedule-attr.
      185       run schedule-attr-name in this-procedure (
      186             input  p-code
      187           , output p-type
      188           , output v-format
      189           , output v-label
      190           , output v-user-can-edit
      191           , output v-output-display
      192           , output v-other
      193       ) no-error .
      194       if error-status :error
      195       then do:
      196           undo, return error return-value .
      197       end.
      198       if p-code begins ('schd-free-id':U + chr(4))
      199       and entry(2, p-code, chr(4)) = '':U then do:
      200         find first buf_schedule-attr no-lock
      201             where buf_schedule-attr.cre-db-num = p-cre-db-num
      202               and buf_schedule-attr.task-type  = p-task-type
      203               and buf_schedule-attr.task-num   = p-task-num
      204               and buf_schedule-attr.attr-code  begins p-code
      205         no-error .
      206       end.
      207       else do:
      208         find first buf_schedule-attr no-lock
      209             where buf_schedule-attr.cre-db-num = p-cre-db-num
      210               and buf_schedule-attr.task-type  = p-task-type
      211               and buf_schedule-attr.task-num   = p-task-num
      212               and buf_schedule-attr.attr-code  = p-code
      213         no-error .
      214       end.
      215       if available buf_schedule-attr
      216       then do:
      217           assign
      218               p-value = buf_schedule-attr.attr-value
      219           .
      220       end.
      221       else do:
      222         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      223            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      224         end.
      225         else do:
      226           assign
      227               p-value = if p-type = 'L':U then "no":U else ""
      228           .
      229         end.
      230       end.
      231   end.
      232   end procedure.
      233   procedure schedule-attr-write :
      234   do
      235   on error undo, return error
      236   :
      237   define input parameter p-cre-db-num  as integer   no-undo.
      238   define input parameter p-task-type   as character no-undo.
      239   define input parameter p-task-num    as integer   no-undo.
      240   define input parameter p-code        as character no-undo.
      241   define input parameter p-value       as character no-undo.
      242       define variable v-type              as character                no-undo.
      243       define variable v-format            as character                no-undo.
      244       define variable v-label             as character                no-undo.
      245       define variable v-user-can-edit     as logical                  no-undo.
      246       define variable v-output-display    as logical                  no-undo.
      247       define variable v-other             as character                no-undo.
      248       define buffer buf_schedule-attr for ub.schedule-attr .
      249       run schedule-attr-name in this-procedure (
      250             input  p-code
      251           , output v-type
      252           , output v-format
      253           , output v-label
      254           , output v-user-can-edit
      255           , output v-output-display
      256           , output v-other
      257       ) no-error.
      258       if error-status :error
      259       then do:
      260           undo, return error return-value.
      261       end.
      262       find first buf_schedule-attr exclusive-lock
      263            where buf_schedule-attr.cre-db-num = p-cre-db-num
      264              and buf_schedule-attr.task-type  = p-task-type
      265              and buf_schedule-attr.task-num   = p-task-num
      266              and buf_schedule-attr.attr-code  = p-code
      267       no-error.
      268       if not available buf_schedule-attr
      269       then do:
      270           create buf_schedule-attr.
      271           assign
      272             buf_schedule-attr.cre-db-num = p-cre-db-num
      273             buf_schedule-attr.task-type  = p-task-type
      274             buf_schedule-attr.task-num   = p-task-num
      275             buf_schedule-attr.attr-code  = p-code
      276             buf_schedule-attr.attr-value = p-value
      277           .
      278       end.
      279       else do:
      280           assign
      281               buf_schedule-attr.attr-value = p-value
      282           .
      283       end.
      284   end.
      285   end procedure.
      286   procedure schedule-attr-delete :
      287   do
      288   on error undo, return error
      289   :
      290   define input  parameter p-cre-db-num  as integer   no-undo.
      291   define input  parameter p-task-type   as character no-undo.
      292   define input  parameter p-task-num    as integer   no-undo.
      293   define input  parameter p-code        as character no-undo.
      294   define output parameter p-deleted     as logical   no-undo.
      295       define buffer buf_schedule-attr for ub.schedule-attr .
      296       define variable v-type              as character                no-undo.
      297       define variable v-format            as character                no-undo.
      298       define variable v-label             as character                no-undo.
      299       define variable v-user-can-edit     as logical                  no-undo.
      300       define variable v-output-display    as logical                  no-undo.
      301       define variable v-other             as character                no-undo.
      302       run schedule-attr-name in this-procedure (
      303             input p-code
      304           , output v-type
      305           , output v-format
      306           , output v-label
      307           , output v-user-can-edit
      308           , output v-output-display
      309           , output v-other
      310       ) no-error .
      311       if error-status :error
      312       then do:
      313           undo, return error return-value .
      314       end.
      315       find first buf_schedule-attr exclusive-lock
      316            where buf_schedule-attr.cre-db-num = p-cre-db-num
      317              and buf_schedule-attr.task-type  = p-task-type
      318              and buf_schedule-attr.task-num   = p-task-num
      319              and buf_schedule-attr.attr-code  = p-code
      320       no-error.
      321       if not available buf_schedule-attr
      322       then do:
      323           assign
      324               p-deleted = no
      325           .
      326       end.
      327       else do:
      328           delete buf_schedule-attr.
      329           assign
      330               p-deleted = yes
      331           .
      332       end.
      333   end.
      334   end procedure.
      335   procedure schedule-attr-news :
      336   do
      337   on error undo, return error
      338   :
      339       define input  parameter p-code           as character no-undo .
      340       define output parameter p-news           as logical   no-undo .
      341       if index(p-code, chr(4)) > 0 then do:
      342         p-code = entry(1, p-code, chr(4)).
      343       end.
      344       case p-code :
      345               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      346               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      347               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      348               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      349               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      350               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      351               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      352               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      353               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      354         otherwise do:
      355           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      356         end.
      357       end.
      358   end.
      359   end procedure.
      360   procedure schedule-attr-extract-logical :
      361   do
      362   on error undo, return error
      363   :
      364   define input  parameter p-parameter-number   as integer      no-undo.
      365   define input  parameter p-parameter-list     as character    no-undo.
      366   define output parameter p-parameter-value   as logical      no-undo.
      367       if num-entries( p-parameter-list ) > p-parameter-number - 1
      368       then do:
      369           assign
      370               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      371           .
      372       end.
      373       else do:
      374           assign
      375               p-parameter-value   = no
      376           .
      377       end.
      378   end.
      379   end procedure.
      380   procedure schedule-attr-get-free-id :
      381   do
      382   on error undo, return error return-value
      383   :
      384     define input  parameter p-cre-db-num  as integer   no-undo.
      385     define input  parameter p-task-type   as character no-undo.
      386     define input  parameter p-task-num    as integer   no-undo.
      387     define output parameter p-free-id     as character no-undo.
      388     define buffer buf_schedule-attr for ub.schedule-attr.
      389     find first buf_schedule-attr no-lock
      390         where buf_schedule-attr.cre-db-num = p-cre-db-num
      391           and buf_schedule-attr.task-type  = p-task-type
      392           and buf_schedule-attr.task-num   = p-task-num
      393           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      394     no-error .
      395     if available buf_schedule-attr then
      396     assign
      397     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      398     no-error
      399     .
      400   end.
      401   end procedure.
      402   procedure schedule-attr-get-free-props :
      403     define input parameter p-free-id as character no-undo .
      404     define output parameter p-value as character no-undo .
      405     define buffer buf_temp-schedule-free for temp-schedule-free.
      406     do
      407     on error undo, return error return-value
      408     :
      409       find first buf_temp-schedule-free no-lock no-error .
      410       if not available buf_temp-schedule-free then do:
      411         run schedule-attr-fill-free-props in this-procedure .
      412       end.
      413       find first buf_temp-schedule-free where
      414               buf_temp-schedule-free.free-id = p-free-id no-error.
      415       if available buf_temp-schedule-free then do:
      416         assign
      417         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      418                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      419                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      420                   buf_temp-schedule-free.conf-param           + chr(4) +
      421                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      422                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      423                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      424                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      425                   buf_temp-schedule-free.other-info
      426         .
      427       end.
      428       else do:
      429        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      430                              "id произвольной задачи - &5"
      431                              ,vss-workfile
      432                              ,vss-revision
      433                              ,vss-description
      434                              ,chr(10)
      435                              ,p-free-id).
      436       end.
      437     end.
      438   end procedure.
      439   procedure schedule-attr-is-rum-free-id :
      440   define input parameter p-free-id as character no-undo .
      441   define output parameter p-is-rum as logical no-undo .
      442   define buffer buf_temp-schedule-free for temp-schedule-free.
      443   do
      444   on error undo, return error
      445   :
      446       find first buf_temp-schedule-free no-lock no-error .
      447       if not available buf_temp-schedule-free then do:
      448         run schedule-attr-fill-free-props in this-procedure .
      449       end.
      450       find first buf_temp-schedule-free where
      451               buf_temp-schedule-free.free-id = p-free-id no-error.
      452       if available buf_temp-schedule-free
      453       and buf_temp-schedule-free.is-rum
      454       then do:
      455         p-is-rum = yes.
      456       end.
      457   end.
      458   end procedure.
      459   procedure schedule-attr-fill-free-props :
      460   define variable v-path                    as character                no-undo .
      461   DEFINE VARIABLE v-full-path               as character                no-undo .
      462   DEFINE VARIABLE v-file-name               as character                no-undo .
      463   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      464   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      465   define buffer buf_temp-schedule-free for temp-schedule-free.
      466   define variable v-answer as logical no-undo .
      467     do
      468     on error undo, return error substitute("&1 &2 &3&4&5&4"
      469                                           ,vss-workfile
      470                                           ,vss-revision
      471                                           ,vss-description
      472                                           ,chr(10)
      473                                           ,error-status:get-message(1) )
      474     :
      475       run gbl/filename.p (
      476                       input 'cmp/shd-free.d'
      477                     ,output v-full-path
      478                     ,output v-path
      479                     ,output v-file-name
      480                     ,output v-file-name-no-ext
      481                     ,output v-file-name-ext
      482                     ) .
      483       input from value(v-full-path).
      484       repeat :
      485         create buf_temp-schedule-free.
      486         import buf_temp-schedule-free.
      487       END.
      488       input close.
      489       _ff:
      490       for each buf_temp-schedule-free :
      491         if buf_temp-schedule-free.free-id = '':U then do:
      492            delete buf_temp-schedule-free.
      493            next _ff.
      494          end.
      495          run schedule-attr-check-enc in this-procedure (
      496                                                       input  buf_temp-schedule-free.free-id
      497                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      498                                                               buf_temp-schedule-free.proc-param-edit-name +
      499                                                               buf_temp-schedule-free.conf-param +
      500                                                               string(buf_temp-schedule-free.is-gbd) +
      501                                                               string(buf_temp-schedule-free.is-ubd) +
      502                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      503                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      504                                                               string(buf_temp-schedule-free.other-info)
      505                                                               )
      506                                                       ,input  buf_temp-schedule-free.enc-key
      507                                                       ,output v-answer    ) no-error .
      508          if error-status:error
      509          or not v-answer then delete buf_temp-schedule-free.
      510        end.
      511     end.
      512   end procedure.
      513   Function schedule-attr-reverse returns character (str as character).
      514      define variable rev_incl_s as character init "" no-undo .
      515      define variable rev_incl_i as integer no-undo .
      516      define variable rev_incl_l as integer no-undo .
      517      rev_incl_l = length(str).
      518      do rev_incl_i = 1 to rev_incl_l:
      519         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      520      end.
      521      return rev_incl_s.
      522   end.
      523   procedure schedule-attr-check-enc.
      524     define input  parameter p-free-id   as character no-undo .
      525     define input  parameter p-value     as character no-undo .
      526     define input  parameter p-enc-value as character no-undo .
      527     define output parameter p-answer    as logical   no-undo .
      528     define variable tmp         as character no-undo .
      529     define variable v-enc-value as character no-undo .
      530     assign
      531     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      532     .
      533     run schedule-attr-pswd-enc in this-procedure
      534       ( input tmp
      535        ,output v-enc-value
      536       ) no-error .
      537     if error-status:error then do:
      538       message
      539         vss-workfile vss-revision vss-description skip
      540         "Ошибка при вызове процедуры pswd-enc" skip
      541         return-value skip
      542         error-status :get-message(1) skip
      543         view-as alert-box error .
      544       undo, return error .
      545     end.
      546     if v-enc-value = p-enc-value then do:
      547       assign
      548         p-answer = true
      549       .
      550     end.
      551     else do:
      552       assign
      553         p-answer = false
      554       .
      555     end.
      556   end.
      557   procedure schedule-attr-conf-enc.
      558     define input  parameter p-free-id   as character no-undo .
      559     define input  parameter p-value     as character no-undo .
      560     define output parameter p-enc-value as character no-undo .
      561     define variable tmp         as character no-undo .
      562     assign
      563       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      564     .
      565     run schedule-attr-pswd-enc in this-procedure
      566       ( input tmp
      567        ,output p-enc-value
      568       ) no-error .
      569     if error-status:error then do:
      570       message
      571         vss-workfile vss-revision vss-description skip
      572         "Ошибка при вызове процедуры pswd-enc" skip
      573         return-value skip
      574         error-status :get-message(1) skip
      575         view-as alert-box error .
      576       undo, return error .
      577     end.
      578   end procedure.
      579   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   procedure schedule-attr-pswd-enc :
      581     define input parameter  pswd     as character no-undo .
      582     define output parameter enc-pswd as character no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         enc-pswd = encode(pswd + string(index(pswd, "k")))
      588       .
      589     end.
      590   end procedure.
      591   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      592       input p_task-type,
      593       input p_task-num,
      594       input 'schedule-param-list':U,
      595       output v-param-list,
      596       output v-param-type).
      597   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      598       input p_task-type,
      599       input p_task-num,
      600       input 'schedule-obj-list':U,
      601       output v-obj-list,
      602       output v-param-type) no-error.
      603   assign
      604       FILL-IN-Dir = entry(1,v-param-list,chr(4))
      605       RADIO-SET-Objects = integer(entry(2,v-param-list,chr(4)) )
      606       p-region = entry(3,v-param-list,chr(4))
      607   no-error.
      608   do ii = 1 to num-entries(v-obj-list, chr(4)) on error undo, next:
      609       v-entry = entry(ii, v-obj-list, chr(4)).
      610       find first buf_clients where buf_clients.obj-type = entry(1, v-entry, chr(44))
      611           and buf_clients.obj-code = integer(entry(2, v-entry, chr(44))) no-lock no-error.
      612       if available buf_clients then
      613       do:
      614           create shd-obj-temp.
      615           assign
      616               shd-obj-temp.obj-code = buf_clients.obj-code
      617               shd-obj-temp.obj-type = buf_clients.obj-type.
      618       end.
      619   end.
      620   run bge/bge-exp-ATD.p (input table shd-obj-temp,
      621       input FILL-IN-Dir,
      622       input p_log-handle,
      623       input  ?,
      624       input 0,
      625       input ?,
      626       input 0,
      627       input p-region,
      628       input "shd"
      629       ) no-error.
