     1475   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476   define new global shared variable g#trdcalib as handle no-undo.
     1477   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   define temp-table tt-act-header
     1479       field num           as character        label "№ акта"      format "X(30)"
     1480       field date_         as date             label "Дата акта"
     1481       field is-sent       as logical
     1482       field answer_       as character        label "Ответ"       format "X(1500)"
     1483       field type_         as character        label "Основание"   format "X(35)"
     1484       field RegID         as character        label "Рег. номер"  format "X(50)"
     1485       index pi as primary unique
     1486           num
     1487   .
     1488   define temp-table tt-gds-act
     1489       field num           as character                label "№ акта"
     1490       field position_     as integer                  label "№ пп"                    format ">>>9"
     1491       field gds-code      like ub.goods.gds-code      label "Код товара   "
     1492       field part-code     like ub.parts.part-code     label "Партия"
     1493       field doc-code      as character                label "№ накладной TH"
     1494       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
     1495       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     1496       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     1497       field qnty          as decimal                  label "Количество"
     1498       field inform-A      as character                label "Справка А"               format "X(20)"
     1499       field A-qnty        as decimal                  label "Кол-во в справке"
     1500       field A-bottleDate  as date                     label "Дата розлива"
     1501       field A-ttnNumber   as character                label "№ ТТН справки А"         format "X(15)"
     1502       field A-ttnDate     as date                     label "Дата"
     1503       field A-fixNumber   as character                label "№ фиксации в ЕГАИС"      format "X(20)"
     1504       field A-fixDate     as date                     label "Дата фикс."
     1505       field inform-B      as character                label "Справка Б"               format "X(20)"
     1506       field marks-qnty    as integer                  label "Кол-во марок"
     1507       field egais-name    as character
     1508       index pi as primary unique
     1509           position_
     1510       index code
     1511           gds-code doc-code
     1512   .
     1513   define shared  temp-table tt-marks
     1514       field num                 as character            label "№ акта"
     1515       field gds-part-position_  as integer
     1516       field mark                as character            label "Марка"          format "X(100)"
     1517       field new_                as logical
     1518       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
     1519       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
     1520       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
     1521       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
     1522       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
     1523       field flag                as logical              label "T"
     1524       field reserv              as integer              label "R"
     1525       field parts               as character            label "Партия"         format "X(130)"
     1526       index pi as primary unique
     1527           mark
     1528   .
     1529   define variable sw as handle no-undo .
     1530   define variable v-file              as character no-undo initial "ActChargeOn1.xml".
     1531   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     1532   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     1533   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     1534   procedure makeXML_TH :
     1535       create sax-writer sw .
     1536       sw:formatted = true.
     1537       sw:set-output-destination ("file", v-file).
     1538       sw:encoding = "UTF-8".
     1539       sw:start-document () .
     1540       sw:start-element ("ns:Documents") .
     1541       sw:insert-attribute ("Version", "1.0") .
     1542       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1543       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1544       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef") .
     1545       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     1546       sw:insert-attribute ("xmlns:ain", "http://fsrar.ru/WEGAIS/ActChargeOn") .
     1547       sw:insert-attribute ("xmlns:ainp", "http://fsrar.ru/WEGAIS/ActChargeOn_v2") .
     1548       sw:insert-attribute ("xmlns:iab", "http://fsrar.ru/WEGAIS/ActInventoryABInfo") .
     1549           sw:start-element ("ns:Owner") .
     1550               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1551           sw:end-element ("ns:Owner") .
     1552           sw:start-element ("ns:Document") .
     1553               sw:start-element ("ns:ActChargeOn") .
     1554                   sw:start-element ("ain:Header") .
     1555                       sw:write-data-element ("ain:Number", tt-act-header.num) .
     1556                       sw:write-data-element ("ain:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1557                       sw:write-data-element ("ain:Note", "Необходимо поставить товарные позиции на баланс") .
     1558                       if egais:VerXSD = "2"
     1559                       then do :
     1560                           if tt-act-header.type_ <> "Продукция полученная до 01.01.2016"
     1561                           then
     1562                             sw:write-data-element ("ainp:TypeChargeOn", tt-act-header.type_) no-error .
     1563                           else
     1564                             sw:write-data-element ("ainp:TypeChargeOn", "Продукция, полученная до 01.01.2016") no-error .
     1565                       end.
     1566                   sw:end-element ("ain:Header") .
     1567                   sw:start-element ("ain:Content") .
     1568       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1569           if tt-gds-act.qnty <= 0 then next.
     1570                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
     1571                       sw:start-element ("ain:Position") .
     1572                           sw:write-data-element ("ain:Identity", string(tt-gds-act.position_)) .
     1573                           sw:start-element ("ain:Product") .
     1574                               sw:write-data-element ("pref:Type", "АП") .
     1575                               sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
     1576                               sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
     1577                               sw:write-data-element ("doc-code", tt-gds-act.doc-code) no-error .
     1578                               sw:write-data-element ("part-code", tt-gds-act.part-code) no-error .
     1579                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
     1580                               sw:write-data-element ("pref:ShortName", "") .
     1581                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
     1582                               sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
     1583                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
     1584                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
     1585                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
     1586                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
     1587                           end.
     1588                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
     1589                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
     1590                                                                  and X_ext-classif-attr.db-num = 0
     1591                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
     1592                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
     1593                                                                  and X_ext-classif-attr.Key#_three = 0
     1594                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
     1595                                                                  and X_ext-classif-attr.CharKey_two = ""
     1596                                                                  and X_ext-classif-attr.CharKey_three = ""
     1597                                                                  and X_ext-classif-attr.nonunique = 0
     1598                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
     1599                                                                  no-error .
     1600                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
     1601                             def var v-prod as char no-undo.
     1602                             def var v-impor as char no-undo.
     1603                             def var v-msg as char no-undo.
     1604                             v-prod = ''.
     1605                             v-impor = ''.
     1606                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
     1607                             if egais:VerXSD = "1"
     1608                             and (v-prod = ?
     1609                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1610                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1611                             or v-prod = ""
     1612                             or num-entries (v-prod, chr (5)) < 6 )
     1613                             then do:
     1614                               message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1615                             end.
     1616                             if egais:VerXSD = "2"
     1617                             and (v-prod = ?
     1618                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1619                             or v-prod = ""
     1620                             or num-entries (v-prod, chr (5)) < 8
     1621                             or entry (7, v-prod, chr(5)) = "" )
     1622                             then do:
     1623                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
     1624                             end.
     1625                             v-impor = entry (2, X_ext-classif-attr.attr-value, chr(4)) no-error.
     1626                             if egais:VerXSD = "1"
     1627                             and num-entries (v-impor, chr (5)) > 0 and num-entries (v-impor, chr (5)) < 6
     1628                               then
     1629                             do:
     1630                               message "У товара неверно указан импортер из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1631                             end.
     1632                             sw:start-element ("pref:Producer") .
     1633                               if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
     1634                               if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
     1635                               sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
     1636                               sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
     1637                               sw:start-element ("oref:address").
     1638                                 sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
     1639                                 sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
     1640                               sw:end-element ("oref:address").
     1641                             sw:end-element ("pref:Producer") .
     1642                             if egais:VerXSD = "1"
     1643                             and v-impor <> ""
     1644                             and v-impor <> ?
     1645                             and v-impor <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1646                             and v-impor <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) then do:
     1647                               sw:start-element ("pref:Importer") .
     1648                                 if entry (2, v-impor, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-impor, chr(5)) ).
     1649                                 if entry (3, v-impor, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-impor, chr(5)) ).
     1650                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-impor, chr(5)) ).
     1651                                 sw:write-data-element ("oref:FullName", entry (4, v-impor, chr(5)) ).
     1652                                 sw:start-element ("oref:address").
     1653                                   sw:write-data-element ("oref:Country", entry (5, v-impor, chr(5)) ).
     1654                                   sw:write-data-element ("oref:description", entry (6, v-impor, chr(5)) ).
     1655                                 sw:end-element ("oref:address").
     1656                               sw:end-element ("pref:Importer") .
     1657                             end.
     1658                           end.
     1659                           else do:
     1660                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1661                           end.
     1662                           sw:end-element ("ain:Product") .
     1663                           sw:write-data-element ("ain:Quantity", string(tt-gds-act.qnty)) .
     1664                           sw:start-element ("ain:InformAB") .
     1665                               sw:start-element ("ain:InformABReg") .
     1666                                   sw:start-element ("ain:InformA") .
     1667                                       sw:write-data-element ("iab:Quantity", string(tt-gds-act.A-qnty)) no-error .
     1668                                       sw:write-data-element ("iab:BottlingDate", string(iso-date(tt-gds-act.A-bottleDate))) no-error .
     1669                                       sw:write-data-element ("iab:TTNNumber", tt-gds-act.A-ttnNumber) no-error .
     1670                                       sw:write-data-element ("iab:TTNDate", string(iso-date(tt-gds-act.A-ttnDate))) no-error .
     1671                                       if tt-gds-act.A-fixNumber <> ? and trim(tt-gds-act.A-fixNumber) <> "" then do :
     1672                                           sw:write-data-element ("iab:EGAISFixNumber", tt-gds-act.A-fixNumber) no-error .
     1673                                           sw:write-data-element ("iab:EGAISFixDate", string(iso-date(tt-gds-act.A-fixDate))) no-error .
     1674                                       end.
     1675                                   sw:end-element ("ain:InformA") .
     1676                               sw:end-element ("ain:InformABReg") .
     1677                           sw:end-element ("ain:InformAB") .
     1678           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
     1679           if available tt-marks then do :
     1680                           sw:start-element ("ain:MarkCodeInfo") .
     1681               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     1682                               sw:write-data-element ("ain:MarkCode", tt-marks.mark) .
     1683               end.
     1684                           sw:end-element ("ain:MarkCodeInfo") .
     1685           end.
     1686                       sw:end-element ("ain:Position") .
     1687       end.
     1688                   sw:end-element ("ain:Content") .
     1689               sw:end-element ("ns:ActChargeOn") .
     1690           sw:end-element ("ns:Document") .
     1691       sw:end-element ("ns:Documents") .
     1692       sw:end-document () .
     1693       delete object sw.
     1694   end procedure .
     1695   procedure makeXML :
     1696       create sax-writer sw .
     1697       sw:formatted = true.
     1698       sw:set-output-destination ("file", v-file).
     1699       sw:encoding = "UTF-8".
     1700       sw:start-document () .
     1701       sw:start-element ("ns:Documents") .
     1702       sw:insert-attribute ("Version", "1.0") .
     1703       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1704       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1705       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef") .
     1706       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     1707       sw:insert-attribute ("xmlns:ain", "http://fsrar.ru/WEGAIS/ActChargeOn") .
     1708       sw:insert-attribute ("xmlns:iab", "http://fsrar.ru/WEGAIS/ActInventoryABInfo") .
     1709           sw:start-element ("ns:Owner") .
     1710               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1711           sw:end-element ("ns:Owner") .
     1712           sw:start-element ("ns:Document") .
     1713               sw:start-element ("ns:ActChargeOn") .
     1714                   sw:start-element ("ain:Header") .
     1715                       sw:write-data-element ("ain:Number", tt-act-header.num) .
     1716                       sw:write-data-element ("ain:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1717                       sw:write-data-element ("ain:Note", "Необходимо поставить товарные позиции на баланс") .
     1718                   sw:end-element ("ain:Header") .
     1719                   sw:start-element ("ain:Content") .
     1720       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1721           if tt-gds-act.qnty <= 0 then next.
     1722                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
     1723                       sw:start-element ("ain:Position") .
     1724                           sw:write-data-element ("ain:Identity", string(tt-gds-act.position_)) .
     1725                           sw:start-element ("ain:Product") .
     1726                               sw:write-data-element ("pref:Type", "АП") .
     1727                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
     1728                               sw:write-data-element ("pref:ShortName", "") .
     1729                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
     1730                               sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
     1731                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
     1732                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
     1733                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
     1734                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
     1735                           end.
     1736                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
     1737                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
     1738                                                                  and X_ext-classif-attr.db-num = 0
     1739                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
     1740                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
     1741                                                                  and X_ext-classif-attr.Key#_three = 0
     1742                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
     1743                                                                  and X_ext-classif-attr.CharKey_two = ""
     1744                                                                  and X_ext-classif-attr.CharKey_three = ""
     1745                                                                  and X_ext-classif-attr.nonunique = 0
     1746                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
     1747                                                                  no-error .
     1748                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
     1749                             def var v-prod as char no-undo.
     1750                             def var v-impor as char no-undo.
     1751                             def var v-msg as char no-undo.
     1752                             v-prod = ''.
     1753                             v-impor = ''.
     1754                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
     1755                             if v-prod = ?
     1756                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1757                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1758                             or v-prod = ""
     1759                             or num-entries (v-prod, chr (5)) < 6
     1760                             then do:
     1761                               message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1762                             end.
     1763                             v-impor = entry (2, X_ext-classif-attr.attr-value, chr(4)) no-error.
     1764                             if num-entries (v-impor, chr (5)) > 0 and num-entries (v-impor, chr (5)) < 6
     1765                               then
     1766                             do:
     1767                               message "У товара неверно указан импортер из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1768                             end.
     1769                             sw:start-element ("pref:Producer") .
     1770                               if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
     1771                               if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
     1772                               sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
     1773                               sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
     1774                               sw:start-element ("oref:address").
     1775                                 sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
     1776                                 sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
     1777                               sw:end-element ("oref:address").
     1778                             sw:end-element ("pref:Producer") .
     1779                             if v-impor <> ""
     1780                             and v-impor <> ?
     1781                             and v-impor <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1782                             and v-impor <> chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) then do:
     1783                               sw:start-element ("pref:Importer") .
     1784                                 if entry (2, v-impor, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-impor, chr(5)) ).
     1785                                 if entry (3, v-impor, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-impor, chr(5)) ).
     1786                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-impor, chr(5)) ).
     1787                                 sw:write-data-element ("oref:FullName", entry (4, v-impor, chr(5)) ).
     1788                                 sw:start-element ("oref:address").
     1789                                   sw:write-data-element ("oref:Country", entry (5, v-impor, chr(5)) ).
     1790                                   sw:write-data-element ("oref:description", entry (6, v-impor, chr(5)) ).
     1791                                 sw:end-element ("oref:address").
     1792                               sw:end-element ("pref:Importer") .
     1793                             end.
     1794                           end.
     1795                           else do:
     1796                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1797                           end.
     1798                           sw:end-element ("ain:Product") .
     1799                           sw:write-data-element ("ain:Quantity", string(tt-gds-act.qnty)) .
     1800                           sw:start-element ("ain:InformAB") .
     1801                               sw:start-element ("ain:InformABReg") .
     1802                                   sw:start-element ("ain:InformA") .
     1803                                       sw:write-data-element ("iab:Quantity", string(tt-gds-act.A-qnty)) no-error .
     1804                                       sw:write-data-element ("iab:BottlingDate", string(iso-date(tt-gds-act.A-bottleDate))) no-error .
     1805                                       sw:write-data-element ("iab:TTNNumber", tt-gds-act.A-ttnNumber) no-error .
     1806                                       sw:write-data-element ("iab:TTNDate", string(iso-date(tt-gds-act.A-ttnDate))) no-error .
     1807                                       if tt-gds-act.A-fixNumber <> ? and trim(tt-gds-act.A-fixNumber) <> "" then do :
     1808                                           sw:write-data-element ("iab:EGAISFixNumber", tt-gds-act.A-fixNumber) no-error .
     1809                                           sw:write-data-element ("iab:EGAISFixDate", string(iso-date(tt-gds-act.A-fixDate))) no-error .
     1810                                       end.
     1811                                   sw:end-element ("ain:InformA") .
     1812                               sw:end-element ("ain:InformABReg") .
     1813                           sw:end-element ("ain:InformAB") .
     1814           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
     1815           if available tt-marks then do :
     1816                           sw:start-element ("ain:MarkCodeInfo") .
     1817               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     1818                               sw:write-data-element ("ain:MarkCode", tt-marks.mark) .
     1819               end.
     1820                           sw:end-element ("ain:MarkCodeInfo") .
     1821           end.
     1822                       sw:end-element ("ain:Position") .
     1823       end.
     1824                   sw:end-element ("ain:Content") .
     1825               sw:end-element ("ns:ActChargeOn") .
     1826           sw:end-element ("ns:Document") .
     1827       sw:end-element ("ns:Documents") .
     1828       sw:end-document () .
     1829       delete object sw.
     1830   end procedure .
     1831   procedure makeXML_v2 :
     1832       create sax-writer sw .
     1833       sw:formatted = true.
     1834       sw:set-output-destination ("file", v-file).
     1835       sw:encoding = "UTF-8".
     1836       sw:start-document () .
     1837       sw:start-element ("ns:Documents") .
     1838       sw:insert-attribute ("Version", "1.0") .
     1839       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1840       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1841       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef_v2") .
     1842       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1843       sw:insert-attribute ("xmlns:iab", "http://fsrar.ru/WEGAIS/ActInventoryF1F2Info") .
     1844       sw:insert-attribute ("xmlns:ainp", "http://fsrar.ru/WEGAIS/ActChargeOn_v2") .
     1845       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
     1846           sw:start-element ("ns:Owner") .
     1847               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1848           sw:end-element ("ns:Owner") .
     1849           sw:start-element ("ns:Document") .
     1850               sw:start-element ("ns:ActChargeOn_v2") .
     1851                   sw:start-element ("ainp:Header") .
     1852                       sw:write-data-element ("ainp:Number", tt-act-header.num) .
     1853                       sw:write-data-element ("ainp:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1854                       sw:write-data-element ("ainp:Note", "Необходимо поставить товарные позиции на баланс") .
     1855                       if tt-act-header.type_ <> "Продукция полученная до 01.01.2016"
     1856                       then
     1857                         sw:write-data-element ("ainp:TypeChargeOn", tt-act-header.type_) .
     1858                       else
     1859                         sw:write-data-element ("ainp:TypeChargeOn", "Продукция, полученная до 01.01.2016") .
     1860                       if tt-act-header.type_ = "Пересортица" and v-RegID <> "" and v-RegID <> ? then do :
     1861                         sw:write-data-element ("ainp:ActWriteOff", v-RegID) .
     1862                       end.
     1863                   sw:end-element ("ainp:Header") .
     1864                   sw:start-element ("ainp:Content") .
     1865       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1866           if tt-gds-act.qnty <= 0 then next.
     1867                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
     1868                       sw:start-element ("ainp:Position") .
     1869                           sw:write-data-element ("ainp:Identity", string(tt-gds-act.position_)) .
     1870                           sw:start-element ("ainp:Product") .
     1871                               sw:write-data-element ("pref:UnitType", (if buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1 then "Unpacked" else "Packed")) .
     1872                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
     1873                               sw:write-data-element ("pref:ShortName", "") .
     1874                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
     1875                               if not (buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1)
     1876                               then sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
     1877                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
     1878                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
     1879                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
     1880                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
     1881                           end.
     1882                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
     1883                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
     1884                                                                  and X_ext-classif-attr.db-num = 0
     1885                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
     1886                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
     1887                                                                  and X_ext-classif-attr.Key#_three = 0
     1888                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
     1889                                                                  and X_ext-classif-attr.CharKey_two = ""
     1890                                                                  and X_ext-classif-attr.CharKey_three = ""
     1891                                                                  and X_ext-classif-attr.nonunique = 0
     1892                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
     1893                                                                  no-error .
     1894                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
     1895                             def var v-prod as char no-undo.
     1896                             def var v-impor as char no-undo.
     1897                             def var v-msg as char no-undo.
     1898                             def var v-err as logical no-undo.
     1899                             def var v-err-impor as logical no-undo.
     1900                             v-err = false .
     1901                             v-prod = ''.
     1902                             v-impor = ''.
     1903                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
     1904                             if v-prod = ?
     1905                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     1906                             or v-prod = ""
     1907                             or num-entries (v-prod, chr (5)) < 8
     1908                             or entry (7, v-prod, chr(5)) = ""
     1909                             then do:
     1910                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
     1911                               v-err = true .
     1912                             end.
     1913                             if not v-err then do :
     1914                               sw:start-element ("pref:Producer") .
     1915                                sw:start-element ("oref:" + entry (7, v-prod, chr(5))) .
     1916                                 if entry (7, v-prod, chr(5)) <> "TS" then do :
     1917                                     if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
     1918                                     if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
     1919                                 end.
     1920                                 else if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:TSNUM", entry (2, v-prod, chr(5)) ).
     1921                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
     1922                                 sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
     1923                                 sw:start-element ("oref:address").
     1924                                   sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
     1925                                   if entry (8, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:RegionCode", entry (8, v-prod, chr(5)) ).
     1926                                   sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
     1927                                 sw:end-element ("oref:address").
     1928                                sw:end-element ("oref:" + entry (7, v-prod, chr(5))) .
     1929                               sw:end-element ("pref:Producer") .
     1930                             end.
     1931                           end.
     1932                           else do:
     1933                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     1934                           end.
     1935                           sw:end-element ("ainp:Product") .
     1936                           sw:write-data-element ("ainp:Quantity", string(tt-gds-act.qnty)) .
     1937                           sw:start-element ("ainp:InformF1F2") .
     1938                               sw:start-element ("ainp:InformF1F2Reg") .
     1939                                   sw:start-element ("ainp:InformF1") .
     1940                                       sw:write-data-element ("iab:Quantity", string(tt-gds-act.A-qnty)) no-error .
     1941                                       sw:write-data-element ("iab:BottlingDate", string(iso-date(tt-gds-act.A-bottleDate))) no-error .
     1942                                       sw:write-data-element ("iab:TTNNumber", tt-gds-act.A-ttnNumber) no-error .
     1943                                       sw:write-data-element ("iab:TTNDate", string(iso-date(tt-gds-act.A-ttnDate))) no-error .
     1944                                       if tt-gds-act.A-fixNumber <> ? and trim(tt-gds-act.A-fixNumber) <> "" then do :
     1945                                           sw:write-data-element ("iab:EGAISFixNumber", tt-gds-act.A-fixNumber) no-error .
     1946                                           sw:write-data-element ("iab:EGAISFixDate", string(iso-date(tt-gds-act.A-fixDate))) no-error .
     1947                                       end.
     1948                                   sw:end-element ("ainp:InformF1") .
     1949                               sw:end-element ("ainp:InformF1F2Reg") .
     1950                           sw:end-element ("ainp:InformF1F2") .
     1951           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
     1952           if available tt-marks then do :
     1953                           sw:start-element ("ainp:MarkCodeInfo") .
     1954               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     1955                               sw:write-data-element ("MarkCode", tt-marks.mark) .
     1956               end.
     1957                           sw:end-element ("ainp:MarkCodeInfo") .
     1958           end.
     1959                       sw:end-element ("ainp:Position") .
     1960       end.
     1961                   sw:end-element ("ainp:Content") .
     1962               sw:end-element ("ns:ActChargeOn_v2") .
     1963           sw:end-element ("ns:Document") .
     1964       sw:end-element ("ns:Documents") .
     1965       sw:end-document () .
     1966       delete object sw.
     1967   end procedure .
     1968   procedure parseXML :
     1969       empty temp-table tt-act-header .
     1970       empty temp-table tt-gds-act .
     1971       empty temp-table tt-marks .
     1972       CREATE X-DOCUMENT hDoc.
     1973       CREATE X-NODEREF hRoot.
     1974       hDoc:encoding = 'utf-8'.
     1975       hDoc:LOAD("file", search("temp.xml"),FALSE).
     1976       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1977       RUN GetChildren(hRoot, 1).
     1978       DELETE OBJECT hDoc.
     1979       DELETE OBJECT hRoot.
     1980   end procedure .
     1981   procedure GetChildren :
     1982       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1983       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1984       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1985       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1986       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     1987       CREATE X-NODEREF hNoderef.
     1988       CREATE X-NODEREF hText .
     1989       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1990           good = hParent:GET-CHILD(hNoderef,i).
     1991           IF NOT good THEN
     1992               LEAVE.
     1993           IF hNoderef:SUBTYPE <> "element" THEN
     1994               NEXT.
     1995           hNoderef:GET-CHILD(hText, 1) no-error .
     1996           IF hNoderef:NAME = "ain:Header" or hNoderef:NAME = "ainp:Header" THEN do :
     1997               create tt-act-header .
     1998               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
     1999           end .
     2000           .
     2001           IF hNoderef:NAME = "ain:Number"
     2002           OR hNoderef:NAME = "ainp:Number" THEN assign tt-act-header.num    = hText:node-value no-error .
     2003           IF hNoderef:NAME = "ain:ActDate"
     2004           OR hNoderef:NAME = "ainp:ActDate" THEN
     2005               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2006           IF hNoderef:NAME = "ainp:TypeChargeOn" THEN do :
     2007               assign tt-act-header.type_    = hText:node-value no-error .
     2008               if tt-act-header.type_ = "Продукция, полученная до 01.01.2016" then tt-act-header.type_ = "Продукция полученная до 01.01.2016" .
     2009           end.
     2010           IF hNoderef:NAME = "ainp:ActWriteOff" THEN assign v-RegID    = hText:node-value no-error .
     2011           IF hNoderef:NAME = "ain:Position"
     2012           OR hNoderef:NAME = "ainp:Position" THEN do :
     2013               assign ii = 0 .
     2014               create tt-gds-act .
     2015               assign tt-gds-act.num = tt-act-header.num .
     2016           end.
     2017           IF hNoderef:NAME = "ain:Identity"
     2018           OR hNoderef:NAME = "ainp:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     2019           if hNoderef:NAME = "gds-code" THEN assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
     2020           if hNoderef:NAME = "gds-name" THEN do :
     2021               assign tt-gds-act.gds-name = hText:node-value no-error .
     2022               if tt-gds-act.gds-name = ? or tt-gds-act.gds-name = ""
     2023               then do :
     2024                   find first goods no-lock where goods.gds-code = tt-gds-act.gds-code no-error .
     2025                   if available goods then tt-gds-act.gds-name = goods.gds-name no-error .
     2026               end.
     2027           end.
     2028           if hNoderef:NAME = "doc-code" THEN assign tt-gds-act.doc-code = hText:node-value no-error .
     2029           if hNoderef:NAME = "part-code" THEN assign tt-gds-act.part-code = hText:node-value no-error .
     2030           IF hNoderef:NAME = "pref:FullName" THEN assign tt-gds-act.egais-name = hText:node-value no-error .
     2031           IF hNoderef:NAME = "pref:AlcCode" THEN do :
     2032               assign tt-gds-act.alc-code = hText:node-value no-error .
     2033               if tt-gds-act.gds-code = ? or tt-gds-act.gds-code = 0
     2034               then do :
     2035                   find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2036                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2037                                                      AND X_ext-classif.db-num = 0
     2038                                                      and X_ext-classif.key#_two = v-ext-sys
     2039                                                      and X_ext-classif.key#_three = 0
     2040                                                      and X_ext-classif.charkey_one = tt-gds-act.alc-code
     2041                                                      and X_eXt-classif.charkey_two = ""
     2042                                                      and X_eXt-classif.charkey_three = ""
     2043                                                      and X_eXt-classif.nonunique = 0
     2044                                                      no-error.
     2045                   if available X_ext-classif then do :
     2046                       find first buf_goods no-lock where buf_goods.gds-code = X_ext-classif.key#_one .
     2047                       assign
     2048                           tt-gds-act.gds-code = buf_goods.gds-code
     2049                           tt-gds-act.gds-name = buf_goods.gds-name
     2050                       .
     2051                       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2052                                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2053                                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2054                                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2055                                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2056                                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2057                                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2058                                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2059                                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2060                                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2061                                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2062                                                              no-error .
     2063                       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2064                   end.
     2065               end.
     2066           end.
     2067           IF hNoderef:NAME = "ain:Quantity"
     2068           OR hNoderef:NAME = "ainp:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     2069           IF hNoderef:NAME = "iab:Quantity" THEN assign tt-gds-act.A-qnty = decimal(hText:node-value) no-error .
     2070           IF hNoderef:NAME = "iab:BottlingDate" THEN assign tt-gds-act.A-bottleDate = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2071           IF hNoderef:NAME = "iab:TTNNumber" THEN assign tt-gds-act.A-ttnNumber = hText:node-value no-error .
     2072           IF hNoderef:NAME = "iab:TTNDate" THEN assign tt-gds-act.A-ttnDate = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2073           IF hNoderef:NAME = "iab:EGAISFixNumber" THEN assign tt-gds-act.A-fixNumber = hText:node-value no-error .
     2074           IF hNoderef:NAME = "iab:EGAISFixDate" THEN assign tt-gds-act.A-fixDate = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2075           if available tt-gds-act and tt-gds-act.A-ttnNumber <> ""
     2076           and tt-gds-act.A-ttnNumber <> ? and (tt-gds-act.doc-code = ? or tt-gds-act.doc-code = "")
     2077           then do :
     2078               find first buf_parts no-lock where buf_parts.cst-code = tt-gds-act.A-ttnNumber
     2079                                              and buf_parts.artic = buf_goods.artic
     2080                                               and buf_parts.prod-type = buf_goods.prod-type
     2081                                               and buf_parts.prod-code = buf_goods.prod-code
     2082                                               and buf_parts.obj-type = v-cntxt-obj-type
     2083                                               and buf_parts.obj-code = v-cntxt-obj-code
     2084                                               and buf_parts.out-code = 'free-zone':U
     2085                                               no-error .
     2086               if available buf_parts then do :
     2087                   assign
     2088                       tt-gds-act.part-code = buf_parts.part-code
     2089                       tt-gds-act.doc-code  = buf_parts.in-code
     2090                   .
     2091               end.
     2092               else do :
     2093                   find first ub.doc-attr no-lock where ub.doc-attr.attr-code = 'nids':U and ub.doc-attr.attr-value = tt-gds-act.A-ttnNumber no-error .
     2094                   if available ub.doc-attr then do :
     2095                       assign tt-gds-act.doc-code = ub.doc-attr.doc-code .
     2096                   end.
     2097                   else do :
     2098                       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = tt-gds-act.A-ttnNumber no-error .
     2099                       if available buf_trn-doc then do :
     2100                           assign tt-gds-act.doc-code = buf_trn-doc.doc-code .
     2101                       end.
     2102                   end.
     2103               end.
     2104           end.
     2105           IF hNoderef:NAME = "ain:MarkCode"
     2106           OR hNoderef:NAME = "ainp:MarkCode"
     2107           OR hNoderef:NAME = "MarkCode" THEN do :
     2108               create tt-marks.
     2109               assign
     2110                   tt-marks.num                    = tt-gds-act.num
     2111                   tt-marks.gds-part-position_     = tt-gds-act.position_
     2112                   tt-marks.mark                   = hText:node-value
     2113                   tt-marks.gds-code               = tt-gds-act.gds-code
     2114                   tt-marks.gds-name               = tt-gds-act.gds-name
     2115                   tt-marks.alc-code               = tt-gds-act.alc-code
     2116                   ii = ii + 1.
     2117               .
     2118               assign tt-gds-act.marks-qnty = ii .
     2119           end.
     2120           run GetChildren (hNoderef, (level + 1)).
     2121       END.
     2122       DELETE OBJECT hNoderef.
     2123       DELETE OBJECT hText.
     2124   END procedure.
     2125   define new shared temp-table tt-exts
     2126       field ext-rec as recid
     2127       field gds-code as integer
     2128       index pi as primary unique
     2129           ext-rec gds-code
     2130   .
     2131   define buffer buf_tt-marks for tt-marks .
     2132   define variable select-list as longchar no-undo .
     2133   FUNCTION get-mark RETURNS CHARACTER
     2134   (buffer local-gds for tt-gds-act ):
     2135   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     2136                                                              else return "".
     2137   end function.
     2138   define menu m-add
     2139       menu-item m-goods   label "товары по свободной зоне"
     2140       menu-item m-marks   label "по акцизным маркам"
     2141       menu-item m-one-good label "один товар"
     2142   .
     2143   DEFINE BUTTON b-cancel AUTO-END-KEY
     2144        LABEL "Выход"
     2145        SIZE 15 BY 1.14
     2146        BGCOLOR 8 .
     2147   DEFINE BUTTON b-good
     2148        LABEL "Добавить"
     2149        SIZE 15 BY 1.14
     2150        BGCOLOR 8 .
     2151   DEFINE BUTTON b-marks
     2152        LABEL "Ввести марки"
     2153        SIZE 15 BY 1.14 TOOLTIP "Ввести марки"
     2154        BGCOLOR 8 .
     2155   DEFINE BUTTON b-alc-code
     2156        LABEL "Выбор алк. кода"
     2157        SIZE 20 BY 1.14 TOOLTIP "Выбрать алкогольный код"
     2158        BGCOLOR 8 .
     2159   DEFINE BUTTON b-del
     2160        LABEL "Удалить строку"
     2161        SIZE 15 BY 1.14 TOOLTIP "Удалить строку акта"
     2162        BGCOLOR 8 .
     2163   DEFINE BUTTON b-save
     2164        LABEL "Сохранить"
     2165        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     2166        BGCOLOR 8 .
     2167   DEFINE BUTTON b-mark
     2168        LABEL "&*"
     2169        SIZE 3 BY 1.14 .
     2170   DEFINE BUTTON b-sel-all
     2171        LABEL "&+":L
     2172        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     2173   DEFINE BUTTON b-unmark
     2174        LABEL "&-":L
     2175        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     2176   DEFINE QUERY br-gds-act FOR
     2177         tt-gds-act SCROLLING.
     2178   DEFINE BROWSE br-gds-act
     2179     QUERY br-gds-act  DISPLAY
     2180       get-mark(BUFFER tt-gds-act) COLUMN-LABEL "*"  FORMAT "X(1)":U
     2181       tt-gds-act.position_
     2182       tt-gds-act.doc-code
     2183       tt-gds-act.gds-code
     2184       tt-gds-act.alc-code
     2185       tt-gds-act.gds-name
     2186       tt-gds-act.qnty
     2187       tt-gds-act.A-qnty
     2188       tt-gds-act.A-bottleDate
     2189       tt-gds-act.A-ttnNumber
     2190       tt-gds-act.A-ttnDate
     2191       tt-gds-act.A-fixNumber
     2192       tt-gds-act.A-fixDate
     2193       tt-gds-act.marks-qnty
     2194     ENABLE
     2195       tt-gds-act.qnty
     2196       tt-gds-act.A-qnty
     2197       tt-gds-act.A-bottleDate
     2198       tt-gds-act.A-ttnNumber
     2199       tt-gds-act.A-ttnDate
     2200       tt-gds-act.A-fixNumber
     2201       tt-gds-act.A-fixDate
     2202       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     2203   DEFINE FRAME Dialog-Frame
     2204       b-cancel at row 1.2 col 2
     2205       b-good at row 1.2 col 32
     2206       b-marks at row 1.2 col 47
     2207       b-alc-code at row 1.2 col 62
     2208       b-del at row 1.2 col 82
     2209       b-save at row 1.2 col 17
     2210       tt-act-header.num at row 2.5 col 2 format "X(22)"
     2211       tt-act-header.date_ at row 2.5 col 34
     2212       tt-act-header.type_ at row 2.5 col 57
     2213           view-as combo-box inner-lines 7
     2214           list-items "Пересортица,Излишки,Продукция полученная до 01.01.2016"
     2215           DROP-DOWN-LIST
     2216       b-mark AT ROW 4 COL 2
     2217       b-sel-all AT ROW 4 COL 5
     2218       b-unmark AT ROW 4 COL 8
     2219       br-gds-act at row 5.2 col 2
     2220        SPACE(0.5) SKIP(0.5)
     2221       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2222            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2223            TITLE "Акт постановки товаров на баланс" WIDGET-ID 100.
     2224   ASSIGN
     2225          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2226          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2227   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2228   DO:
     2229     APPLY "END-ERROR":U TO SELF.
     2230   END.
     2231   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2232   DO:
     2233     run proc-b-mark in this-procedure no-error.
     2234   END.
     2235   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     2236   DO:
     2237     assign select-list = "".
     2238     if not available tt-gds-act then return.
     2239     for each tt-gds-act no-lock :
     2240   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2241   define variable v-str-recid11 as character no-undo .
     2242   define variable v-num-entry11 as integer   no-undo .
     2243   assign
     2244     v-str-recid11 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     2245     v-num-entry11 = lookup( v-str-recid11 , select-list )
     2246   .
     2247   if v-num-entry11 > 0 then do:
     2248     assign
     2249       entry( v-num-entry11, select-list ) = "":U
     2250       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2251     .
     2252   end.
     2253   else do:
     2254     assign
     2255       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid11
     2256     .
     2257   end.
     2258     end.
     2259     br-gds-act:refresh() in frame Dialog-Frame .
     2260   END.
     2261   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     2262   DO:
     2263     if not available tt-gds-act then return.
     2264     select-list  = "".
     2265     br-gds-act:refresh() in frame Dialog-Frame .
     2266   END.
     2267   ON VALUE-CHANGED OF tt-act-header.type_ IN FRAME Dialog-Frame
     2268   DO:
     2269     assign tt-act-header.type_.
     2270     if tt-act-header.type_ = "Пересортица" then do :
     2271         message "Выберите соответствующий акт о списании" view-as alert-box.
     2272         run bge/egais-all-act-writeOff.w (input parparentproc, input yes, output v-RegID ) .
     2273         if v-RegID = ? or v-RegID = "" then do :
     2274           tt-act-header.type_ = "Продукция полученная до 01.01.2016" .
     2275           display tt-act-header.type_  with frame Dialog-Frame.
     2276           message "Акт постановки на баланс с типом 'Пересортица' невозможно отправить без указания соответствующего акта о списании!" view-as alert-box.
     2277         end.
     2278     end.
     2279   END.
     2280   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2281   DO:
     2282       if p-mode <> 'ПРОСМОТР':U then do :
     2283           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2284           view-as alert-box question buttons yes-no update glog.
     2285           if not glog then return no-apply .
     2286       end.
     2287   END.
     2288   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2289   DO:
     2290       define variable v-tt-rec as recid.
     2291       if available tt-gds-act  AND select-list = ""
     2292       then
     2293       select-list = string( recid( tt-gds-act ) ) .
     2294       if not available tt-gds-act and select-list = "" then do :
     2295           message "Выберите строку" view-as alert-box .
     2296           return no-apply.
     2297       end.
     2298       else
     2299       do ii = 1 to num-entries (select-list) :
     2300         v-tt-rec = integer(entry(ii, select-list)) .
     2301         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     2302           for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2303               delete tt-marks .
     2304           end.
     2305           delete tt-gds-act .
     2306         end.
     2307       end.
     2308       nn = 0 .
     2309       for each tt-gds-act exclusive-lock :
     2310           nn = nn + 1 .
     2311           for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2312               tt-marks.gds-part-position_ = nn .
     2313           end.
     2314           tt-gds-act.position_ = nn .
     2315       end.
     2316       select-list = "" .
     2317       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2318   END.
     2319   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     2320   DO:
     2321       define variable prev-num as character no-undo .
     2322       prev-num = tt-act-header.num .
     2323       assign tt-act-header.num .
     2324       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     2325           assign tt-gds-act.num = tt-act-header.num .
     2326       end.
     2327       for each tt-marks exclusive-lock where tt-marks.num = prev-num :
     2328           assign tt-marks.num = tt-act-header.num .
     2329       end.
     2330   END.
     2331   ON CHOOSE OF b-marks IN FRAME Dialog-Frame
     2332   DO:
     2333       if not available tt-gds-act then do :
     2334           message "Выберите строку" view-as alert-box .
     2335           return no-apply.
     2336       end.
     2337       run bge/egais-ab-marks.w (parparentproc, tt-gds-act.num, tt-gds-act.position_, tt-gds-act.alc-code, tt-gds-act.qnty, 'ИЗМЕНЕНИЕ':U, input-output table tt-marks) .
     2338       assign ii = 0 .
     2339       for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2340           ii = ii + 1 .
     2341       end.
     2342       assign tt-gds-act.marks-qnty = ii .
     2343       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2344       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     2345   END.
     2346   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2347   DO:
     2348       assign
     2349           tt-act-header.num
     2350           tt-act-header.date_
     2351           tt-act-header.type_
     2352       no-error.
     2353       find first tt-gds-act no-error .
     2354       if not available tt-gds-act then do :
     2355           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     2356           return no-apply.
     2357       end.
     2358       if can-find(tt-gds-act no-lock where tt-gds-act.qnty < 1 )
     2359       then do :
     2360           message "П Р Е Д У П Р Е Ж Д Е Н И Е" skip
     2361                   "В одной или нескольких строках не указано количество." skip
     2362                   "Строки с нулевым количеством сохранены не будут!!!" skip
     2363                   "Всё равно продолжить сохраненине?" view-as alert-box question buttons yes-no update glog .
     2364           if not glog then return no-apply.
     2365       end.
     2366       if can-find(tt-gds-act no-lock where tt-gds-act.A-ttnNumber = ? or trim(tt-gds-act.A-ttnNumber) = ""
     2367                                         or tt-gds-act.A-ttnDate = ? or trim(string(tt-gds-act.A-ttnDate)) = "" )
     2368       then do :
     2369           message "П Р Е Д У П Р Е Ж Д Е Н И Е" skip
     2370                   "В одной или нескольких строках не заполнены поля   номер/дата ТТН." skip
     2371                   "Такой акт не может быть отправлен в ЕГАИС." skip
     2372                   "Всё равно продолжить сохраненине?" view-as alert-box question buttons yes-no update glog .
     2373           if not glog then return no-apply.
     2374       end.
     2375       if can-find(tt-gds-act no-lock where tt-gds-act.A-bottleDate = ? or trim(string(tt-gds-act.A-bottleDate)) = "" )
     2376       then do :
     2377           message "П Р Е Д У П Р Е Ж Д Е Н И Е" skip
     2378                   "В одной или нескольких строках не заполнено поле   дата розлива." skip
     2379                   "Такой акт не может быть отправлен в ЕГАИС." skip
     2380                   "Всё равно продолжить сохраненине?" view-as alert-box question buttons yes-no update glog .
     2381           if not glog then return no-apply.
     2382       end.
     2383       if can-find(tt-gds-act no-lock where tt-gds-act.A-fixDate = ? or trim(string(tt-gds-act.A-fixDate)) = "" )
     2384       then do :
     2385           message "П Р Е Д У П Р Е Ж Д Е Н И Е" skip
     2386                   "В одной или нескольких строках не заполнено поле   дата фиксации в ЕГАИС." skip
     2387                   "Всё равно продолжить сохраненине?" view-as alert-box question buttons yes-no update glog .
     2388           if not glog then return no-apply.
     2389       end.
     2390       run makeXML_TH in this-procedure no-error.
     2391       if error-status:error then return return-value .
     2392       assign
     2393           v-clob-db-num = ?
     2394           v-int64-id = 0
     2395           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4)
     2396                  + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_ + chr(4) + tt-act-header.type_
     2397       .
     2398       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     2399                                                 and buf_clob-bind.field-name_  = 'egais-ab':U no-error .
     2400       if available buf_clob-bind then do :
     2401           if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2402               message "Акт с таким номером уже существует!" view-as alert-box .
     2403               return no-apply .
     2404           end.
     2405           assign
     2406               v-clob-db-num = buf_clob-bind.db-num
     2407               v-int64-id = buf_clob-bind.int64-id
     2408               v-part-num = buf_clob-bind.part-num
     2409           .
     2410           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     2411                     ,input "add-new,yes"
     2412                     ,input ?
     2413                     ,input tt-act-header.num
     2414                     ,input 'egais-ab':U
     2415                     ,input v-info
     2416                     ,input-output v-part-num
     2417                     ,input 'egais-ab':U
     2418                     ,input-output v-clob-db-num
     2419                     ,input-output v-int64-id
     2420                     ,input search (v-file)
     2421                     ,input ''
     2422                     ) no-error .
     2423            if error-status:error then message return-value view-as alert-box.
     2424       end.
     2425       else do :
     2426           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2427                     ,input ",yes"
     2428                     ,input ?
     2429                     ,input tt-act-header.num
     2430                     ,input 'egais-ab':U
     2431                     ,input v-info
     2432                     ,input-output v-part-num
     2433                     ,input 'egais-ab':U
     2434                     ,input-output v-clob-db-num
     2435                     ,input-output v-int64-id
     2436                     ,input search (v-file)
     2437                     ,input ''
     2438                     ) no-error .
     2439       end.
     2440       message "Сохранение завершено" view-as alert-box.
     2441   END.
     2442   on choose of menu-item m-goods in menu m-add
     2443   DO:
     2444       define variable v-user-action    as character no-undo.
     2445       define variable v-printed        as logical   no-undo.
     2446       run ref/gds-ref.p
     2447       ( parparentproc
     2448       ,'b-sel,b-mark,b-add'
     2449       ,?
     2450       ,?
     2451       ,'свободно':U
     2452       ,?
     2453       ,?
     2454       ,?
     2455       ,?
     2456       ,v-cntxt-obj-type
     2457       ,v-cntxt-obj-code
     2458       ,?
     2459       , output v-rid-list) no-error.
     2460       if v-rid-list = "" or v-rid-list = ?
     2461       then return no-apply.
     2462       if search ("act-bal_log.err") <> ? then do:
     2463         os-delete value("act-bal_log.err").
     2464       end.
     2465       output stream str-log to value("act-bal_log.err") append .
     2466       err-good = false .
     2467       _goods_ :
     2468       do jj = 1 to num-entries(v-rid-list) :
     2469           find buf_goods where recid (buf_goods) = integer(entry(jj, v-rid-list)) no-lock.
     2470           run gds-attr-value(
     2471             buf_goods.gds-code,
     2472             'alcohol-prod':U,
     2473             output par-alcohol,
     2474             output par-type
     2475           ).
     2476           if par-alcohol = "" or par-alcohol = "no" then
     2477           do :
     2478               put stream str-log unformatted
     2479                   string(today) + "   " + string(time, "hh:mm:ss") + " :  товар " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  не является алкогольной продукцией" skip.
     2480               err-good = true .
     2481               next _goods_ .
     2482           end.
     2483           run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2484                                               ,input (buffer buf_goods:handle)
     2485                                               ,output v-gds-uniq-key-rec).
     2486           exts = 0 .
     2487           for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2488                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2489                                          AND X_ext-classif.db-num = 0
     2490                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2491                                          and X_ext-classif.key#_two = v-ext-sys
     2492                                          and X_ext-classif.key#_three = 0
     2493                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2494                                          and X_eXt-classif.charkey_two = ""
     2495                                          and X_eXt-classif.charkey_three = ""
     2496                                          and X_eXt-classif.nonunique = 0 :
     2497               find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2498                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2499               if not available tt-exts then do :
     2500                   create tt-exts .
     2501                   assign
     2502                       tt-exts.ext-rec = recid(x_ext-classif)
     2503                       tt-exts.gds-code = buf_goods.gds-code
     2504                   .
     2505               end.
     2506               exts = exts + 1 .
     2507           end.
     2508           if exts = 0 then do :
     2509               put stream str-log unformatted
     2510                   string(today) + "   " + string(time, "hh:mm:ss") + " :  товар " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  не синхронизирован с ЕГАИС" skip.
     2511               err-good = true .
     2512               next _goods_ .
     2513           end.
     2514           else do :
     2515               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2516                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2517                                                  AND X_ext-classif.db-num = 0
     2518                                                  and X_ext-classif.key#_one = buf_goods.gds-code
     2519                                                  and X_ext-classif.key#_two = v-ext-sys
     2520                                                  and X_ext-classif.key#_three = 0
     2521                                                  and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2522                                                  and X_eXt-classif.charkey_two = ""
     2523                                                  and X_eXt-classif.charkey_three = ""
     2524                                                  and X_eXt-classif.nonunique = 0
     2525                                                  .
     2526           end.
     2527           find first buf_parts no-lock where buf_parts.artic = buf_goods.artic
     2528                                       and buf_parts.prod-type = buf_goods.prod-type
     2529                                       and buf_parts.prod-code = buf_goods.prod-code
     2530                                       and buf_parts.obj-type = v-cntxt-obj-type
     2531                                       and buf_parts.obj-code = v-cntxt-obj-code
     2532                                       and buf_parts.out-code = 'free-zone':U no-error .
     2533           if not available buf_parts  then do :
     2534               put stream str-log unformatted
     2535                   string(today) + "   " + string(time, "hh:mm:ss") + " :  у товара " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  нет партий свободной зоны" skip.
     2536               err-good = true .
     2537               next _goods_ .
     2538           end.
     2539           _parts_ :
     2540           for each buf_parts no-lock where buf_parts.artic = buf_goods.artic
     2541                                       and buf_parts.prod-type = buf_goods.prod-type
     2542                                       and buf_parts.prod-code = buf_goods.prod-code
     2543                                       and buf_parts.obj-type = v-cntxt-obj-type
     2544                                       and buf_parts.obj-code = v-cntxt-obj-code
     2545                                       and buf_parts.out-code = 'free-zone':U ,
     2546           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.in-code :
     2547               if buf_parts.qnty <= 0 then next _parts_ .
     2548               assign nn = nn + 1 .
     2549               create tt-gds-act.
     2550               assign
     2551                   tt-gds-act.gds-code         = buf_goods.gds-code
     2552                   tt-gds-act.alc-code         = X_ext-classif.charkey_one
     2553                   tt-gds-act.gds-name         = buf_goods.gds-name
     2554                   tt-gds-act.doc-code         = buf_trn-doc.doc-code
     2555                   tt-gds-act.doc-date         = buf_trn-doc.fact-date
     2556                   tt-gds-act.num              = tt-act-header.num
     2557                   tt-gds-act.part-code        = buf_parts.part-code
     2558                   tt-gds-act.position_        = nn
     2559                   tt-gds-act.qnty             = buf_parts.qnty
     2560                   tt-gds-act.marks-qnty       = 0
     2561                   tt-gds-act.A-bottleDate     = buf_parts.alc-bottling-date
     2562                   tt-gds-act.A-qnty           = buf_parts.qnty
     2563               .
     2564               find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2565                                                      and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2566                                                      and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2567                                                      and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2568                                                      and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2569                                                      and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2570                                                      and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2571                                                      and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2572                                                      and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2573                                                      and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2574                                                      and X_ext-classif-attr.attr-code = 'egais-info'
     2575                                                      no-error .
     2576               if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2577               if buf_parts.cst-code <> "" then do :
     2578                   assign tt-gds-act.A-ttnNumber      = buf_parts.cst-code .
     2579               end.
     2580               else do :
     2581   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2582                           input 'nids':U ,
     2583                          output v-attr-value ,
     2584                          output v-attr-type )  .
     2585                   if v-attr-value <> "" and v-attr-value <> ? then do :
     2586                       assign tt-gds-act.A-ttnNumber  =  v-attr-value .
     2587   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2588                           input 'dids':U ,
     2589                          output v-attr-value ,
     2590                          output v-attr-type )  .
     2591                       assign tt-gds-act.A-ttnDate = if v-attr-value = "" or v-attr-value = ? then buf_trn-doc.doc-date else date( v-attr-value ) .
     2592                   end.
     2593                   else do :
     2594                       assign
     2595                           tt-gds-act.A-ttnNumber  = buf_trn-doc.doc-code
     2596                           tt-gds-act.A-ttnDate    = buf_trn-doc.doc-date
     2597                       .
     2598                   end.
     2599               end.
     2600           end.
     2601       end.
     2602       output stream str-log close .
     2603       if err-good then do :
     2604           message "Не все выбранные товары добавлены в акт!" view-as alert-box .
     2605           run gbl/prnfilen.w
     2606              (input  "Ошибки при добавлении товаров"
     2607              ,input  0
     2608              ,input  "act-bal_log.err"
     2609              ,input  7
     2610              ,output v-user-action
     2611              ,output v-printed
     2612              ).
     2613       end.
     2614       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2615       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     2616   END.
     2617   on choose of menu-item m-marks in menu m-add
     2618   DO:
     2619       run bge/egais-ab-marks.w (parparentproc, tt-act-header.num, ?, "", 0, 'ИЗМЕНЕНИЕ':U, input-output table tt-marks) .
     2620       for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = ? and tt-marks.num = tt-act-header.num :
     2621           find first tt-gds-act exclusive-lock where tt-gds-act.alc-code = tt-marks.alc-code no-error .
     2622           if not available tt-gds-act then do :
     2623               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2624                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2625                                                  AND X_ext-classif.db-num = 0
     2626                                                  and X_ext-classif.key#_two = v-ext-sys
     2627                                                  and X_ext-classif.key#_three = 0
     2628                                                  and X_ext-classif.charkey_one = tt-marks.alc-code
     2629                                                  and X_eXt-classif.charkey_two = ""
     2630                                                  and X_eXt-classif.charkey_three = ""
     2631                                                  and X_eXt-classif.nonunique = 0
     2632                                                  .
     2633               find first buf_goods no-lock where buf_goods.gds-code = X_ext-classif.key#_one .
     2634               nn = nn + 1 .
     2635               create tt-gds-act .
     2636               assign
     2637                   tt-gds-act.gds-code         = buf_goods.gds-code
     2638                   tt-gds-act.alc-code         = X_ext-classif.charkey_one
     2639                   tt-gds-act.gds-name         = buf_goods.gds-name
     2640                   tt-gds-act.num              = tt-act-header.num
     2641                   tt-gds-act.position_        = nn
     2642                   tt-gds-act.marks-qnty       = 0
     2643               .
     2644               find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2645                                                      and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2646                                                      and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2647                                                      and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2648                                                      and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2649                                                      and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2650                                                      and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2651                                                      and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2652                                                      and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2653                                                      and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2654                                                      and X_ext-classif-attr.attr-code = 'egais-info'
     2655                                                      no-error .
     2656               if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2657           end.
     2658           if not can-find(buf_tt-marks where buf_tt-marks.mark = tt-marks.mark
     2659                                          and buf_tt-marks.gds-part-position_ <> ?)
     2660           then
     2661           assign
     2662               tt-marks.gds-part-position_ = tt-gds-act.position_
     2663               tt-gds-act.marks-qnty       = tt-gds-act.marks-qnty + 1
     2664               tt-gds-act.A-qnty           = tt-gds-act.A-qnty + 1
     2665               tt-gds-act.qnty             = tt-gds-act.qnty + 1
     2666           .
     2667       end.
     2668       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2669       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     2670   END.
     2671   on choose of menu-item m-one-good in menu m-add
     2672   DO:
     2673       run ref/gds-ref.p
     2674       ( parparentproc
     2675       ,'b-sel,b-add'
     2676       ,?
     2677       ,?
     2678       ,'все':U
     2679       ,?
     2680       ,?
     2681       ,?
     2682       ,?
     2683       ,v-cntxt-obj-type
     2684       ,v-cntxt-obj-code
     2685       ,?
     2686       , output v-rid-list) no-error.
     2687       if v-rid-list = "" or v-rid-list = ?
     2688       then return no-apply.
     2689       find buf_goods where recid (buf_goods) = integer(v-rid-list) no-lock.
     2690       run gds-attr-value(
     2691         buf_goods.gds-code,
     2692         'alcohol-prod':U,
     2693         output par-alcohol,
     2694         output par-type
     2695       ).
     2696       if par-alcohol = "" or par-alcohol = "no" then
     2697       do :
     2698           message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     2699           return no-apply .
     2700       end.
     2701       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2702                                           ,input (buffer buf_goods:handle)
     2703                                           ,output v-gds-uniq-key-rec).
     2704       exts = 0 .
     2705       for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2706                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2707                                          AND X_ext-classif.db-num = 0
     2708                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2709                                          and X_ext-classif.key#_two = v-ext-sys
     2710                                          and X_ext-classif.key#_three = 0
     2711                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2712                                          and X_eXt-classif.charkey_two = ""
     2713                                          and X_eXt-classif.charkey_three = ""
     2714                                          and X_eXt-classif.nonunique = 0 :
     2715           find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2716                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2717           if not available tt-exts then do :
     2718               create tt-exts .
     2719               assign
     2720                   tt-exts.ext-rec = recid(X_ext-classif)
     2721                   tt-exts.gds-code = buf_goods.gds-code
     2722               .
     2723           end.
     2724           exts = exts + 1 .
     2725       end.
     2726       if exts = 0 then do :
     2727           message "Выбранный товар не синхронизирован с ЕГАИС. (Нет алкогольного кода)" view-as alert-box.
     2728           return no-apply.
     2729       end.
     2730       else if exts = 1 then do :
     2731           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2732                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2733                                              AND X_ext-classif.db-num = 0
     2734                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2735                                              and X_ext-classif.key#_two = v-ext-sys
     2736                                              and X_ext-classif.key#_three = 0
     2737                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2738                                              and X_eXt-classif.charkey_two = ""
     2739                                              and X_eXt-classif.charkey_three = ""
     2740                                              and X_eXt-classif.nonunique = 0
     2741                                              .
     2742       end.
     2743       else do :
     2744           run bge/egais-select-alc-code.w (input buf_goods.gds-code, output p-ext-rec) .
     2745           find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2746           if not available X_ext-classif then return no-apply.
     2747       end.
     2748       nn = nn + 1 .
     2749       create tt-gds-act .
     2750       assign
     2751           tt-gds-act.gds-code         = buf_goods.gds-code
     2752           tt-gds-act.alc-code         = X_ext-classif.charkey_one
     2753           tt-gds-act.gds-name         = buf_goods.gds-name
     2754           tt-gds-act.num              = tt-act-header.num
     2755           tt-gds-act.position_        = nn
     2756           tt-gds-act.marks-qnty       = 0
     2757       .
     2758       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2759                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2760                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2761                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2762                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2763                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2764                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2765                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2766                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2767                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2768                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2769                                              no-error .
     2770       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2771       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2772       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     2773   END.
     2774   on choose of b-alc-code IN FRAME Dialog-Frame
     2775   do :
     2776       if not available tt-gds-act then return no-apply .
     2777       run bge/egais-select-alc-code.w (input tt-gds-act.gds-code, output p-ext-rec) .
     2778       find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2779       if not available X_ext-classif then return no-apply.
     2780       assign tt-gds-act.alc-code = X_ext-classif.charkey_one .
     2781       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2782                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2783                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2784                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2785                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2786                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2787                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2788                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2789                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2790                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2791                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2792                                              no-error .
     2793       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2794       br-gds-act:refresh() .
     2795   end.
     2796   on row-display of br-gds-act in FRAME Dialog-Frame
     2797   DO :
     2798       exts = 0 .
     2799       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2800           exts = exts + 1 .
     2801       end.
     2802       if exts > 1 then tt-gds-act.alc-code:bgcolor in browse br-gds-act = yellow_color .
     2803   end.
     2804   on value-changed of br-gds-act IN FRAME Dialog-Frame
     2805   DO :
     2806   if available tt-gds-act then do :
     2807       exts = 0 .
     2808       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2809           exts = exts + 1 .
     2810       end.
     2811       if exts > 1
     2812       and not can-find(tt-marks where tt-marks.alc-code = tt-gds-act.alc-code)
     2813       then enable b-alc-code WITH FRAME Dialog-Frame.
     2814       else disable b-alc-code WITH FRAME Dialog-Frame.
     2815   end.
     2816   end.
     2817   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2818   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2819   MAIN-BLOCK:
     2820   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2821      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2822       assign
     2823           b-good:popup-menu in frame Dialog-Frame = menu m-add:handle
     2824           b-good:menu-mouse = 1
     2825           nn = 0
     2826           tt-act-header.type_:list-items = "Пересортица,Излишки,Продукция полученная до 01.01.2016"
     2827       .
     2828       empty temp-table tt-exts .
     2829       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2830           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2831           create tt-act-header .
     2832           assign
     2833               tt-act-header.num = "ACO-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2834               tt-act-header.date_ = TODAY
     2835               tt-act-header.is-sent = no
     2836               tt-act-header.type_ = "Продукция полученная до 01.01.2016"
     2837           .
     2838           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2839           enable  tt-act-header.date_ b-good with frame Dialog-Frame.
     2840           if egais:VerXSD = "2" then do :
     2841               display tt-act-header.type_ with frame Dialog-Frame.
     2842               enable  tt-act-header.type_ with frame Dialog-Frame.
     2843           end.
     2844           else hide tt-act-header.type_ in frame Dialog-Frame.
     2845       end.
     2846       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2847           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2848                                     and buf_clob-bind.field-name_ = 'egais-ab':U
     2849                                     and buf_clob-bind.part-num = 1  .
     2850           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2851           copy-lob
     2852           from  object buf_clob-data.cdata
     2853           to  file 'temp.xml'
     2854           no-convert
     2855           no-error .
     2856           empty temp-table tt-marks no-error .
     2857           run parseXML in this-procedure .
     2858           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2859           if egais:VerXSD = "2" then do :
     2860               display tt-act-header.type_ with frame Dialog-Frame.
     2861               if p-mode = 'ИЗМЕНЕНИЕ':U then enable  tt-act-header.type_ with frame Dialog-Frame.
     2862           end.
     2863           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2864           for each tt-gds-act no-lock :
     2865               nn = nn + 1 .
     2866               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2867               if not available buf_goods then do :
     2868                   message "По алкогольному коду " tt-gds-act.alc-code " не найден товар из TH. Вероятно, кто-то удалил связку." view-as alert-box.
     2869                   next.
     2870               end.
     2871               run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2872                                               ,input (buffer buf_goods:handle)
     2873                                               ,output v-gds-uniq-key-rec).
     2874               for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2875                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2876                                              AND X_ext-classif.db-num = 0
     2877                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2878                                              and X_ext-classif.key#_two = v-ext-sys
     2879                                              and X_ext-classif.key#_three = 0
     2880                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2881                                              and X_eXt-classif.charkey_two = ""
     2882                                              and X_eXt-classif.charkey_three = ""
     2883                                              and X_eXt-classif.nonunique = 0 :
     2884                   find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2885                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2886                   if not available tt-exts then do :
     2887                       create tt-exts .
     2888                       assign
     2889                           tt-exts.ext-rec = recid(X_ext-classif)
     2890                           tt-exts.gds-code = tt-gds-act.gds-code
     2891                       .
     2892                   end.
     2893               end.
     2894           end .
     2895           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2896           if p-mode = 'ПРОСМОТР':U then disable b-good with frame Dialog-Frame.
     2897           else enable b-good with frame Dialog-Frame.
     2898       end.
     2899   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2900   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2901   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2902   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2903   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2904   define variable v-diasize-current-frame-height as decimal   no-undo .
     2905   define variable v-diasize-change-size          as logical   no-undo .
     2906   define variable v-diasize-resize-button        as handle    no-undo .
     2907   define variable v-diasize-wndmax               as logical   no-undo .
     2908   define variable v-diasize-wndstore             as logical   no-undo .
     2909   define variable v-diasize-proc-name            as character no-undo .
     2910   define variable v-diasize-browse-handle        as handle    no-undo .
     2911   define variable v-diasize-browse-number        as integer   no-undo .
     2912   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2913   define temp-table temp-diasize-handle no-undo
     2914     field handle-value  as handle
     2915     field save-position as decimal
     2916     index xpk is primary unique handle-value
     2917     .
     2918   define temp-table temp-browse-handle no-undo
     2919     field browse-type   as character
     2920     field browse-number as integer
     2921     field browse-handle as handle
     2922     field original-size as decimal
     2923     index xpk is primary unique browse-type browse-number
     2924     index xie browse-type browse-handle
     2925   .
     2926   procedure diasize_change-height :
     2927     define input  parameter p-change-value  as decimal   no-undo .
     2928     define input  parameter p-move-resize   as logical   no-undo .
     2929     define variable v-field-group-handle    as handle    no-undo .
     2930     define variable v-object-handle         as handle    no-undo .
     2931     define variable v-frame-height          as decimal   no-undo .
     2932     define variable v-frame-virtual-height  as decimal   no-undo .
     2933     define variable v-browse-height         as decimal   no-undo .
     2934     define variable v-window-height         as decimal   no-undo .
     2935     define variable v-window-virtual-height as decimal   no-undo .
     2936     define variable v-change-sign           as integer   no-undo .
     2937     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2938     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2939     if p-change-value > 0
     2940     then do:
     2941       if frame Dialog-Frame :height + p-change-value
     2942           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2943       then do:
     2944         assign
     2945           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2946                           - (frame Dialog-Frame :height-chars)
     2947         .
     2948         if p-change-value <= 0
     2949         then do:
     2950           run diasize_position-resize-button in this-procedure .
     2951           return .
     2952         end.
     2953       end.
     2954     end.
     2955     if p-change-value < 0
     2956     then do:
     2957       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2958       then do:
     2959         assign
     2960           p-change-value = v-diasize-orig-frame-height
     2961                          - (frame Dialog-Frame :height-chars)
     2962         .
     2963         if p-change-value >= 0
     2964         then do:
     2965           run diasize_position-resize-button in this-procedure .
     2966           return .
     2967         end.
     2968       end.
     2969     end.
     2970     if p-change-value >= 0
     2971     then do:
     2972       assign
     2973         v-change-sign = 1
     2974       .
     2975     end.
     2976     else do:
     2977       assign
     2978         v-change-sign = -1
     2979       .
     2980     end.
     2981     assign
     2982       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2983     .
     2984     if p-change-value = 0
     2985     then do:
     2986       run diasize_position-resize-button in this-procedure .
     2987       return .
     2988     end.
     2989     move_block:
     2990     do
     2991     on error undo move_block, retry move_block
     2992     :
     2993       if retry
     2994       then do:
     2995         do
     2996         on error undo move_block, leave move_block
     2997         :
     2998           if p-change-value > 0
     2999           then do:
     3000             for each buf_temp-diasize-handle
     3001             on error undo, next
     3002             :
     3003               assign
     3004                 v-object-handle = buf_temp-diasize-handle.handle-value
     3005               .
     3006               if v-object-handle <> v-diasize-resize-button
     3007               then do:
     3008                 assign
     3009                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3010                 .
     3011               end.
     3012             end.
     3013             assign
     3014               v-diasize-browse-handle :height = v-browse-height
     3015             .
     3016             for each buf_temp-browse-handle
     3017               where buf_temp-browse-handle.browse-type = 'height':u
     3018             on error undo, next
     3019             :
     3020               assign
     3021                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3022               .
     3023             end.
     3024             assign
     3025               frame Dialog-Frame :height = v-frame-height
     3026             .
     3027             if frame Dialog-Frame :scrollable = true
     3028             then do:
     3029               assign
     3030                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3031               .
     3032             end.
     3033             run diasize_position-resize-button in this-procedure .
     3034           end.
     3035           else do:
     3036             if frame Dialog-Frame :scrollable = true
     3037             then do:
     3038               assign
     3039                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3040               .
     3041             end.
     3042             assign
     3043               frame Dialog-Frame :height = v-frame-height
     3044             .
     3045             assign
     3046               v-diasize-browse-handle :height = v-browse-height
     3047             .
     3048             for each buf_temp-browse-handle
     3049               where buf_temp-browse-handle.browse-type = 'height':u
     3050             on error undo, next
     3051             :
     3052               assign
     3053                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3054               .
     3055             end.
     3056             for each buf_temp-diasize-handle
     3057             on error undo, next
     3058             :
     3059               assign
     3060                 v-object-handle = buf_temp-diasize-handle.handle-value
     3061               .
     3062               if v-object-handle <> v-diasize-resize-button
     3063               then do:
     3064                 assign
     3065                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3066                 .
     3067               end.
     3068             end.
     3069             run diasize_position-resize-button in this-procedure .
     3070           end.
     3071           assign
     3072             v-diasize-change-size = false
     3073           .
     3074           leave move_block .
     3075         end.
     3076       end.
     3077       assign
     3078         v-diasize-need-full-display = true
     3079       .
     3080       if v-diasize-change-size = false
     3081       then do:
     3082         assign
     3083           v-diasize-change-size = true
     3084         .
     3085       end.
     3086       else do:
     3087         return .
     3088       end.
     3089       assign
     3090         v-frame-height = frame Dialog-Frame :height
     3091         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3092         v-browse-height = v-diasize-browse-handle :height
     3093       .
     3094       for each buf_temp-browse-handle
     3095         where buf_temp-browse-handle.browse-type = 'height':u
     3096       :
     3097         assign
     3098           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3099         .
     3100       end.
     3101       for each buf_temp-diasize-handle
     3102       :
     3103         delete buf_temp-diasize-handle .
     3104       end.
     3105       assign
     3106         v-field-group-handle = frame Dialog-Frame :first-child
     3107       .
     3108       do while valid-handle(v-field-group-handle)
     3109       :
     3110         assign
     3111           v-object-handle = v-field-group-handle :first-child
     3112         .
     3113         do while valid-handle(v-object-handle)
     3114         :
     3115           if  v-object-handle <> v-diasize-browse-handle :handle
     3116           and can-query(v-object-handle, "row")
     3117           and can-query(v-object-handle, "height")
     3118           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3119           then do:
     3120             find first buf_temp-browse-handle
     3121               where buf_temp-browse-handle.browse-type   = 'height':u
     3122                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3123               no-error .
     3124             if available buf_temp-browse-handle
     3125             then do:
     3126             end.
     3127             else do:
     3128               create buf_temp-diasize-handle .
     3129               assign
     3130                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3131                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3132               .
     3133             end.
     3134           end.
     3135           assign
     3136             v-object-handle = v-object-handle :next-sibling
     3137           .
     3138         end.
     3139         assign
     3140           v-field-group-handle = v-field-group-handle :next-sibling
     3141         .
     3142       end.
     3143       do with frame Dialog-Frame
     3144       :
     3145         hide v-diasize-resize-button .
     3146         assign
     3147           v-diasize-resize-button :row    = 1
     3148           v-diasize-resize-button :column = 1
     3149         .
     3150       end.
     3151       if p-change-value > 0
     3152       then do:
     3153         if frame Dialog-Frame :scrollable = true
     3154         then do:
     3155           assign
     3156             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3157             no-error .
     3158           if error-status :error
     3159           or error-status :get-message(1) <> ""
     3160           then do:
     3161             undo move_block, retry move_block .
     3162           end.
     3163         end.
     3164         assign
     3165           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3166           no-error .
     3167         if error-status :error
     3168         or error-status :get-message(1) <> ""
     3169         then do:
     3170           undo move_block, retry move_block .
     3171         end.
     3172         assign
     3173           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3174           no-error .
     3175         if error-status :error
     3176         or error-status :get-message(1) <> ""
     3177         then do:
     3178           undo move_block, retry move_block .
     3179         end.
     3180         for each buf_temp-browse-handle
     3181           where buf_temp-browse-handle.browse-type = 'height':u
     3182         on error undo move_block, retry move_block
     3183         :
     3184           assign
     3185             buf_temp-browse-handle.browse-handle :height
     3186               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3187             no-error .
     3188           if error-status :error
     3189           or error-status :get-message(1) <> ""
     3190           then do:
     3191             undo move_block, retry move_block .
     3192           end.
     3193         end.
     3194         for each buf_temp-diasize-handle
     3195         on error undo move_block, retry move_block
     3196         :
     3197           assign
     3198             v-object-handle = buf_temp-diasize-handle.handle-value
     3199           .
     3200           if v-object-handle <> v-diasize-resize-button
     3201           then do:
     3202             assign
     3203               v-object-handle :row = v-object-handle :row + p-change-value
     3204               no-error .
     3205             if error-status :error
     3206             or error-status :get-message(1) <> ""
     3207             then do:
     3208               undo move_block, retry move_block .
     3209             end.
     3210           end.
     3211         end.
     3212       end.
     3213       else do:
     3214         for each buf_temp-diasize-handle
     3215         on error undo move_block, retry move_block
     3216         :
     3217           assign
     3218             v-object-handle = buf_temp-diasize-handle.handle-value
     3219           .
     3220           if v-object-handle <> v-diasize-resize-button
     3221           then do:
     3222             assign
     3223               v-object-handle :row = v-object-handle :row + p-change-value
     3224               no-error .
     3225             if error-status :error
     3226             or error-status :get-message(1) <> ""
     3227             then do:
     3228               undo move_block, retry move_block .
     3229             end.
     3230           end.
     3231         end.
     3232         assign
     3233           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3234           no-error .
     3235         if error-status :error
     3236         or error-status :get-message(1) <> ""
     3237         then do:
     3238           undo move_block, retry move_block .
     3239         end.
     3240         for each buf_temp-browse-handle
     3241           where buf_temp-browse-handle.browse-type = 'height':u
     3242         on error undo move_block, retry move_block
     3243         :
     3244           assign
     3245             buf_temp-browse-handle.browse-handle :height
     3246               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3247             no-error .
     3248           if error-status :error
     3249           or error-status :get-message(1) <> ""
     3250           then do:
     3251             undo move_block, retry move_block .
     3252           end.
     3253         end.
     3254         assign
     3255           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3256           no-error .
     3257         if error-status :error
     3258         or error-status :get-message(1) <> ""
     3259         then do:
     3260           undo move_block, retry move_block .
     3261         end.
     3262         if frame Dialog-Frame :scrollable = true
     3263         then do:
     3264           assign
     3265             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3266             no-error .
     3267           if error-status :error
     3268           or error-status :get-message(1) <> ""
     3269           then do:
     3270             undo move_block, retry move_block .
     3271           end.
     3272         end.
     3273       end.
     3274       if p-move-resize = true
     3275       then do:
     3276         run diasize_position-resize-button in this-procedure .
     3277       end.
     3278       if v-diasize-wndstore = true
     3279       then do:
     3280         if connected("ub") = true
     3281         then do:
     3282           define variable v-cntxt-db-num        as integer   no-undo .
     3283           define variable v-cntxt-userid        as character no-undo .
     3284           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3285                                             , OUTPUT v-cntxt-userid
     3286                                             ) .
     3287           run gbl/wndsizew.p
     3288             (input  v-cntxt-db-num
     3289             ,input  v-cntxt-userid
     3290             ,input  v-diasize-proc-name
     3291             ,input  'height':u
     3292             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3293             ) .
     3294         end.
     3295       end.
     3296     end.
     3297     assign
     3298       v-diasize-change-size = false
     3299     .
     3300   end procedure.
     3301   procedure diasize_set-height :
     3302     define input  parameter p-new-height  as decimal   no-undo .
     3303     define input  parameter p-move-resize as logical   no-undo .
     3304     do
     3305     on error undo, return error return-value
     3306     :
     3307       run diasize_change-height in this-procedure
     3308         (input  (p-new-height - frame Dialog-Frame :height)
     3309         ,input  p-move-resize
     3310         ) .
     3311     end.
     3312   end procedure.
     3313   procedure diasize_change-width :
     3314     define input  parameter p-change-value as decimal   no-undo .
     3315     define input  parameter p-move-resize  as logical   no-undo .
     3316     define variable v-field-group-handle   as handle    no-undo .
     3317     define variable v-object-handle        as handle    no-undo .
     3318     define variable v-frame-width          as decimal   no-undo .
     3319     define variable v-frame-virtual-width  as decimal   no-undo .
     3320     define variable v-browse-width         as decimal   no-undo .
     3321     define variable v-window-width         as decimal   no-undo .
     3322     define variable v-window-virtual-width as decimal   no-undo .
     3323     define variable v-change-sign          as integer   no-undo .
     3324     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3325     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3326     if p-change-value > 0
     3327     then do:
     3328       if frame Dialog-Frame :width + p-change-value >
     3329           session :width-chars
     3330       then do:
     3331         assign
     3332           p-change-value = session :width-chars - frame Dialog-Frame :width
     3333         .
     3334         if p-change-value <= 0
     3335         then do:
     3336           run diasize_position-resize-button in this-procedure .
     3337           return .
     3338         end.
     3339       end.
     3340     end.
     3341     if p-change-value < 0
     3342     then do:
     3343       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3344       then do:
     3345         assign
     3346           p-change-value = v-diasize-orig-frame-width
     3347                          - frame Dialog-Frame :width
     3348         .
     3349         if p-change-value >= 0
     3350         then do:
     3351           run diasize_position-resize-button in this-procedure .
     3352           return .
     3353         end.
     3354       end.
     3355     end.
     3356     if p-change-value >= 0
     3357     then do:
     3358       assign
     3359         v-change-sign = 1
     3360       .
     3361     end.
     3362     else do:
     3363       assign
     3364         v-change-sign = -1
     3365       .
     3366     end.
     3367     assign
     3368       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3369     .
     3370     if p-change-value = 0
     3371     then do:
     3372       run diasize_position-resize-button in this-procedure .
     3373       return .
     3374     end.
     3375     move_block:
     3376     do
     3377     on error undo move_block, leave move_block
     3378     :
     3379       if retry
     3380       then do:
     3381         do
     3382         on error undo move_block, leave move_block
     3383         :
     3384           if p-change-value > 0
     3385           then do:
     3386             for each buf_temp-diasize-handle
     3387             on error undo, next
     3388             :
     3389               assign
     3390                 v-object-handle = buf_temp-diasize-handle.handle-value
     3391               .
     3392               if v-object-handle <> v-diasize-resize-button
     3393               then do:
     3394                 assign
     3395                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3396                 .
     3397               end.
     3398             end.
     3399             assign
     3400               v-diasize-browse-handle :width = v-browse-width
     3401             .
     3402             for each buf_temp-browse-handle
     3403               where buf_temp-browse-handle.browse-type = 'width':u
     3404             on error undo, next
     3405             :
     3406               assign
     3407                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3408               .
     3409             end.
     3410             assign
     3411               frame Dialog-Frame :width = v-frame-width
     3412             .
     3413             if frame Dialog-Frame :scrollable = true
     3414             then do:
     3415               assign
     3416                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3417               .
     3418             end.
     3419             run diasize_position-resize-button in this-procedure .
     3420           end.
     3421           else do:
     3422             if frame Dialog-Frame :scrollable = true
     3423             then do:
     3424               assign
     3425                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3426               .
     3427             end.
     3428             assign
     3429               frame Dialog-Frame :width = v-frame-width
     3430             .
     3431             for each buf_temp-browse-handle
     3432               where buf_temp-browse-handle.browse-type = 'width':u
     3433             on error undo, next
     3434             :
     3435               assign
     3436                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3437               .
     3438             end.
     3439             assign
     3440               v-diasize-browse-handle :width = v-browse-width
     3441             .
     3442             for each buf_temp-diasize-handle
     3443             on error undo, next
     3444             :
     3445               assign
     3446                 v-object-handle = buf_temp-diasize-handle.handle-value
     3447               .
     3448               if v-object-handle <> v-diasize-resize-button
     3449               then do:
     3450                 assign
     3451                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3452                 .
     3453               end.
     3454             end.
     3455             run diasize_position-resize-button in this-procedure .
     3456           end.
     3457           assign
     3458             v-diasize-change-size = false
     3459           .
     3460           leave move_block .
     3461         end.
     3462       end.
     3463       assign
     3464         v-diasize-need-full-display = true
     3465       .
     3466       if v-diasize-change-size = false
     3467       then do:
     3468         assign
     3469           v-diasize-change-size = true
     3470         .
     3471       end.
     3472       else do:
     3473         return .
     3474       end.
     3475       assign
     3476         v-frame-width = frame Dialog-Frame :width
     3477         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3478         v-browse-width = v-diasize-browse-handle :width
     3479       .
     3480       for each buf_temp-browse-handle
     3481         where buf_temp-browse-handle.browse-type = 'width':u
     3482       :
     3483         assign
     3484           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3485         .
     3486       end.
     3487       for each buf_temp-diasize-handle
     3488       :
     3489         delete buf_temp-diasize-handle .
     3490       end.
     3491       assign
     3492         v-field-group-handle = frame Dialog-Frame :first-child
     3493       .
     3494       do while valid-handle(v-field-group-handle)
     3495       :
     3496         assign
     3497           v-object-handle = v-field-group-handle :first-child
     3498         .
     3499         do while valid-handle(v-object-handle)
     3500         :
     3501           if  v-object-handle <> v-diasize-browse-handle :handle
     3502           and v-object-handle <> v-diasize-resize-button
     3503           and can-query(v-object-handle, "row")
     3504           and can-query(v-object-handle, "height")
     3505           and ( v-object-handle :col + v-object-handle :width
     3506                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3507               )
     3508           then do:
     3509             find first buf_temp-browse-handle
     3510               where buf_temp-browse-handle.browse-type   = 'width':u
     3511                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3512               no-error .
     3513             if available buf_temp-browse-handle
     3514             then do:
     3515             end.
     3516             else do:
     3517               create buf_temp-diasize-handle .
     3518               assign
     3519                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3520                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3521               .
     3522             end.
     3523           end.
     3524           assign
     3525             v-object-handle = v-object-handle :next-sibling
     3526           .
     3527         end.
     3528         assign
     3529           v-field-group-handle = v-field-group-handle :next-sibling
     3530         .
     3531       end.
     3532       do with frame Dialog-Frame
     3533       :
     3534         hide v-diasize-resize-button .
     3535         v-diasize-resize-button :row = 1.
     3536         v-diasize-resize-button :column = 1.
     3537       end.
     3538       if p-change-value > 0
     3539       then do:
     3540         if frame Dialog-Frame :scrollable = true
     3541         then do:
     3542           assign
     3543             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3544             no-error .
     3545           if error-status :error
     3546           or error-status :get-message(1) <> ""
     3547           then do:
     3548             undo move_block, retry move_block.
     3549           end.
     3550         end.
     3551         assign
     3552           frame Dialog-Frame :width = v-frame-width + p-change-value
     3553           no-error .
     3554         if error-status :error
     3555         or error-status :get-message(1) <> ""
     3556         then do:
     3557           undo move_block, retry move_block.
     3558         end.
     3559         assign
     3560           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3561         no-error .
     3562         if error-status :error
     3563         or error-status :get-message(1) <> ""
     3564         then do:
     3565           undo move_block, retry move_block.
     3566         end.
     3567         for each buf_temp-browse-handle
     3568           where buf_temp-browse-handle.browse-type = 'width':u
     3569         on error undo move_block, retry move_block
     3570         :
     3571           assign
     3572             buf_temp-browse-handle.browse-handle :width
     3573               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3574             no-error .
     3575           if error-status :error
     3576           or error-status :get-message(1) <> ""
     3577           then do:
     3578             undo move_block, retry move_block .
     3579           end.
     3580         end.
     3581         for each buf_temp-diasize-handle
     3582         on error undo move_block, retry move_block
     3583         :
     3584           assign
     3585             v-object-handle = buf_temp-diasize-handle.handle-value
     3586           .
     3587           if v-object-handle <> v-diasize-resize-button
     3588           then do:
     3589             assign
     3590               v-object-handle :col = v-object-handle :col + p-change-value
     3591               no-error .
     3592             if error-status :error
     3593             or error-status :get-message(1) <> ""
     3594             then do:
     3595               undo move_block, retry move_block .
     3596             end.
     3597           end.
     3598         end.
     3599       end.
     3600       else do:
     3601         for each buf_temp-diasize-handle
     3602         on error undo move_block, retry move_block
     3603         :
     3604           assign
     3605             v-object-handle = buf_temp-diasize-handle.handle-value
     3606           .
     3607           if v-object-handle <> v-diasize-resize-button
     3608           then do:
     3609             assign
     3610               v-object-handle :col = v-object-handle :col + p-change-value
     3611               no-error .
     3612             if error-status :error
     3613             or error-status :get-message(1) <> ""
     3614             then do:
     3615               undo move_block, retry move_block .
     3616             end.
     3617           end.
     3618         end.
     3619         for each buf_temp-browse-handle
     3620           where buf_temp-browse-handle.browse-type = 'width':u
     3621         on error undo move_block, retry move_block
     3622         :
     3623           assign
     3624             buf_temp-browse-handle.browse-handle :width
     3625               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3626             no-error .
     3627           if error-status :error
     3628           or error-status :get-message(1) <> ""
     3629           then do:
     3630             undo move_block, retry move_block .
     3631           end.
     3632         end.
     3633         assign
     3634           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3635           no-error .
     3636         if error-status :error
     3637         or error-status :get-message(1) <> ""
     3638         then do:
     3639           undo move_block, retry move_block.
     3640         end.
     3641         assign
     3642           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3643         no-error .
     3644         if error-status :error
     3645         or error-status :get-message(1) <> ""
     3646         then do:
     3647           undo move_block, retry move_block.
     3648         end.
     3649         if frame Dialog-Frame :scrollable = true
     3650         then do:
     3651           assign
     3652             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3653           no-error .
     3654           if error-status :error
     3655           or error-status :get-message(1) <> ""
     3656           then do:
     3657             undo move_block, retry move_block.
     3658           end.
     3659         end.
     3660       end.
     3661       if p-move-resize
     3662       then do:
     3663         run diasize_position-resize-button in this-procedure .
     3664       end.
     3665       if v-diasize-wndstore = true
     3666       then do:
     3667         if connected("ub") = true
     3668         then do:
     3669           define variable v-cntxt-db-num        as integer   no-undo .
     3670           define variable v-cntxt-userid        as character no-undo .
     3671           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3672                                             , OUTPUT v-cntxt-userid
     3673                                             ) .
     3674           run gbl/wndsizew.p
     3675             (input  v-cntxt-db-num
     3676             ,input  v-cntxt-userid
     3677             ,input  v-diasize-proc-name
     3678             ,input  'width':u
     3679             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3680             ) .
     3681         end.
     3682       end.
     3683     end.
     3684     assign
     3685       v-diasize-change-size = false
     3686     .
     3687   end procedure.
     3688   procedure diasize_set-width :
     3689     define input  parameter p-new-width  as decimal   no-undo .
     3690     define input  parameter p-move-resize as logical   no-undo .
     3691     do
     3692     on error undo, return error return-value
     3693     :
     3694       run diasize_change-width in this-procedure
     3695         (input  (p-new-width - frame Dialog-Frame :width)
     3696         ,input  p-move-resize
     3697         ) .
     3698     end.
     3699   end procedure.
     3700   procedure diasize_position-resize-button :
     3701     do with frame Dialog-Frame
     3702     :
     3703       hide v-diasize-resize-button .
     3704       assign
     3705         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3706                     - 1
     3707                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3708         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3709                     - 1
     3710                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3711       .
     3712       view v-diasize-resize-button .
     3713     end.
     3714   end procedure.
     3715   on alt-right anywhere
     3716   do:
     3717     run diasize_change-width in this-procedure
     3718       (input 1
     3719       ,input true
     3720       ) .
     3721     return no-apply .
     3722   end.
     3723   on alt-left anywhere
     3724   do:
     3725     run diasize_change-width in this-procedure
     3726       (input -1
     3727       ,input true
     3728       ) .
     3729     return no-apply .
     3730   end.
     3731   on alt-down anywhere
     3732   do:
     3733     run diasize_change-height in this-procedure
     3734       (input 1
     3735       ,input true
     3736       ) .
     3737     return no-apply .
     3738   end.
     3739   on alt-up anywhere
     3740   do:
     3741     run diasize_change-height in this-procedure
     3742       (input -1
     3743       ,input true
     3744       ) .
     3745     return no-apply .
     3746   end.
     3747   on alt-enter of frame Dialog-Frame
     3748   do:
     3749     run diasize_maximize in this-procedure
     3750       (input  ?
     3751       ).
     3752     return no-apply .
     3753   end.
     3754   procedure diasize_end-move :
     3755     do
     3756     on error undo, return error return-value
     3757     :
     3758       define variable v-row-delta as decimal   no-undo .
     3759       define variable v-col-delta as decimal   no-undo .
     3760       define variable v-new-row as decimal   no-undo .
     3761       define variable v-new-col as decimal   no-undo .
     3762       assign
     3763         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3764         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3765       .
     3766       assign
     3767         v-row-delta = v-new-row - frame Dialog-Frame :height
     3768         v-col-delta = v-new-col - frame Dialog-Frame :width
     3769       .
     3770       run diasize_change-height in this-procedure
     3771         (input v-row-delta
     3772         ,input true
     3773         ) .
     3774       run diasize_change-width in this-procedure
     3775         (input v-col-delta
     3776         ,input true
     3777         ) .
     3778     end.
     3779   end procedure.
     3780   procedure diasize_maximize :
     3781     define input  parameter p-action as logical   no-undo .
     3782     do
     3783     on error undo, return error return-value
     3784     :
     3785       if p-action = ?
     3786       then do:
     3787         if v-diasize-need-maximize = true
     3788         then do:
     3789           assign
     3790             p-action = true
     3791           .
     3792         end.
     3793         else do:
     3794           assign
     3795             p-action = false
     3796           .
     3797         end.
     3798       end.
     3799       if p-action = true
     3800       then do:
     3801         run diasize_change-height in this-procedure
     3802           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3803               - frame Dialog-Frame :height-chars
     3804           ,input true
     3805           ) .
     3806         run diasize_change-width in this-procedure
     3807           (input session :width-chars
     3808               - frame Dialog-Frame :width-chars
     3809           ,input true
     3810           ) .
     3811         assign
     3812           v-diasize-need-maximize = false
     3813         .
     3814       end.
     3815       else do:
     3816         run diasize_change-width in this-procedure
     3817           (input v-diasize-orig-frame-width
     3818               - frame Dialog-Frame :width-chars
     3819           ,input true
     3820           ) .
     3821         run diasize_change-height in this-procedure
     3822           (input v-diasize-orig-frame-height
     3823               - frame Dialog-Frame :height-chars
     3824           ,input true
     3825           ) .
     3826         assign
     3827           v-diasize-need-maximize = true
     3828         .
     3829       end.
     3830     end.
     3831   end procedure.
     3832   procedure diasize_restore-orig-size :
     3833     do
     3834     on error undo, return error return-value
     3835     :
     3836       assign
     3837         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3838         v-diasize-current-frame-height = frame Dialog-Frame :height
     3839       .
     3840       run diasize_set-height in this-procedure
     3841         (input  v-diasize-orig-frame-height
     3842         ,input  true
     3843         ) .
     3844       run diasize_set-width in this-procedure
     3845         (input  v-diasize-orig-frame-width
     3846         ,input  true
     3847         ) .
     3848     end.
     3849   end procedure.
     3850   procedure diasize_restore-current-size :
     3851     do
     3852     on error undo, return error return-value
     3853     :
     3854       run diasize_set-height in this-procedure
     3855         (input  v-diasize-current-frame-height
     3856         ,input  true
     3857         ) .
     3858       run diasize_set-width in this-procedure
     3859         (input  v-diasize-current-frame-width
     3860         ,input  true
     3861         ) .
     3862     end.
     3863   end procedure.
     3864   procedure diasize_set-browse-handle :
     3865     define input  parameter p-browse-handle as handle   no-undo .
     3866     define buffer buf_temp-browse-handle for temp-browse-handle .
     3867     do
     3868     on error undo, return error return-value
     3869     :
     3870       assign
     3871         v-diasize-browse-handle = p-browse-handle
     3872       .
     3873       for each buf_temp-browse-handle
     3874       on error undo, return error return-value
     3875       :
     3876         delete buf_temp-browse-handle .
     3877       end.
     3878     end.
     3879   end procedure.
     3880   procedure diasize_add_browse :
     3881     define input  parameter p-browse-type   as character no-undo .
     3882     define input  parameter p-browse-handle as handle    no-undo .
     3883     define buffer buf_temp-browse-handle for temp-browse-handle .
     3884     do
     3885     on error undo, return error return-value
     3886     :
     3887       assign
     3888         v-diasize-browse-number = v-diasize-browse-number + 1
     3889       .
     3890       create buf_temp-browse-handle .
     3891       assign
     3892         buf_temp-browse-handle.browse-type   = p-browse-type
     3893         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3894         buf_temp-browse-handle.browse-handle = p-browse-handle
     3895       .
     3896     end.
     3897   end procedure.
     3898   procedure diasize_init :
     3899     define variable v-default-value    as logical   no-undo .
     3900     define variable v-restore-saved    as logical   no-undo .
     3901     define variable v-resize-value-str as character no-undo .
     3902     do
     3903     on error undo, return error return-value
     3904     :
     3905       do with frame Dialog-Frame
     3906       :
     3907         assign
     3908           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3909           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3910           v-diasize-browse-handle     = browse br-gds-act :handle
     3911         .
     3912         create button v-diasize-resize-button
     3913         assign
     3914           parent        = frame Dialog-Frame :first-child
     3915           label         = "s"
     3916           height-pixels = 16
     3917           width-pixels  = 16
     3918           visible       = true
     3919           sensitive     = true
     3920           movable       = true
     3921           triggers:
     3922             on end-move persistent run diasize_end-move in this-procedure .
     3923           end triggers.
     3924         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3925         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3926         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3927         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3928         assign
     3929           v-diasize-wndmax = false
     3930         .
     3931         if connected("ub") = true
     3932         then do:
     3933           define variable v-cntxt-db-num        as integer   no-undo .
     3934           define variable v-cntxt-userid        as character no-undo .
     3935           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3936                                             , OUTPUT v-cntxt-userid
     3937                                             ) .
     3938           run gbl/wndpar_r.p
     3939             (input  v-cntxt-db-num
     3940             ,input  v-cntxt-userid
     3941             ,input  'wndmax':U
     3942             ,output v-diasize-wndmax
     3943             ,output v-default-value
     3944             ) .
     3945         end.
     3946         assign
     3947           v-diasize-wndstore = false
     3948         .
     3949         if connected("ub") = true
     3950         then do:
     3951           run gbl/wndpar_r.p
     3952             (input  v-cntxt-db-num
     3953             ,input  v-cntxt-userid
     3954             ,input  'wndstore':U
     3955             ,output v-diasize-wndstore
     3956             ,output v-default-value
     3957             ) .
     3958         end.
     3959         assign
     3960           v-diasize-proc-name = entry(1, program-name(2), '.')
     3961         .
     3962         if v-diasize-wndstore = true
     3963         then do:
     3964           assign
     3965             v-restore-saved = false
     3966           .
     3967           if connected("ub") = true
     3968           then do:
     3969             run gbl/wndsizer.p
     3970               (input  v-cntxt-db-num
     3971               ,input  v-cntxt-userid
     3972               ,input  v-diasize-proc-name
     3973               ,input  'height':u
     3974               ,output v-resize-value-str
     3975               ) .
     3976             if v-resize-value-str <> '':U
     3977             then do:
     3978               run diasize_change-height in this-procedure
     3979                 (input  integer(v-resize-value-str)
     3980                 ,input  true
     3981                 ) .
     3982               assign
     3983                 v-restore-saved = true
     3984               .
     3985             end.
     3986           end.
     3987           if connected("ub") = true
     3988           then do:
     3989             run gbl/wndsizer.p
     3990               (input  v-cntxt-db-num
     3991               ,input  v-cntxt-userid
     3992               ,input  v-diasize-proc-name
     3993               ,input  'width':u
     3994               ,output v-resize-value-str
     3995               ) .
     3996             if v-resize-value-str <> '':U
     3997             then do:
     3998               run diasize_change-width in this-procedure
     3999                 (input  integer(v-resize-value-str)
     4000                 ,input  true
     4001                 ) .
     4002               assign
     4003                 v-restore-saved = true
     4004               .
     4005             end.
     4006           end.
     4007           if v-restore-saved <> true
     4008           then do:
     4009             if v-diasize-wndmax = true
     4010             then do:
     4011               run diasize_maximize in this-procedure
     4012                 (input  true
     4013                 ) .
     4014             end.
     4015           end.
     4016         end.
     4017         else do:
     4018           if v-diasize-wndmax = true
     4019           then do:
     4020             run diasize_maximize in this-procedure
     4021               (input  true
     4022               ) .
     4023           end.
     4024         end.
     4025       end.
     4026     end.
     4027   end procedure.
     4028   procedure diasize_need-full-display :
     4029     define output parameter p-need-full-display as logical   no-undo .
     4030     do
     4031     on error undo, return error return-value
     4032     :
     4033       assign
     4034         p-need-full-display = v-diasize-need-full-display
     4035       .
     4036       assign
     4037         v-diasize-need-full-display = false
     4038       .
     4039     end.
     4040   end procedure.
     4041   procedure get-context :
     4042      define output parameter p-db-num as integer          no-undo.
     4043      define output parameter p-user-id as character        no-undo.
     4044      define variable v-login               as character    no-undo.
     4045      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4046      define buffer buf_user-login  for ub.user-login .
     4047      do
     4048      on error undo, return error
     4049      :
     4050            FIND FIRST buf_sys-ctrl no-lock.
     4051            ASSIGN
     4052               v-login = USERID("ub")
     4053               p-db-num = buf_sys-ctrl.db-num
     4054            .
     4055            FIND FIRST buf_user-login
     4056                 WHERE buf_user-login.db-num = p-db-num
     4057                   AND buf_user-login.user-login = v-login
     4058                 no-lock
     4059                 no-error
     4060                 .
     4061            IF AVAILABLE buf_user-login
     4062            THEN DO:
     4063               assign
     4064                  p-user-id = buf_user-login.user-id
     4065               .
     4066            END.
     4067      end.
     4068   end procedure.
     4069       run diasize_init in this-procedure .
     4070       RUN enable_UI.
     4071       WAIT-FOR GO OF FRAME Dialog-Frame.
     4072   END.
     4073   RUN disable_UI.
     4074   PROCEDURE proc-b-mark :
     4075     define variable varlog as logical   no-undo .
     4076     if not available tt-gds-act then return.
     4077     run local-mark in this-procedure.
     4078     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     4079     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     4080     br-gds-act:refresh() in frame Dialog-Frame .
     4081   END PROCEDURE.
     4082   PROCEDURE local-mark :
     4083     if not available tt-gds-act then do:
     4084       message "Неправильный выбор строки.".
     4085       return no-apply.
     4086     end.
     4087   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4088   define variable v-str-recid14 as character no-undo .
     4089   define variable v-num-entry14 as integer   no-undo .
     4090   assign
     4091     v-str-recid14 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     4092     v-num-entry14 = lookup( v-str-recid14 , select-list )
     4093   .
     4094   if v-num-entry14 > 0 then do:
     4095     assign
     4096       entry( v-num-entry14, select-list ) = "":U
     4097       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4098     .
     4099   end.
     4100   else do:
     4101     assign
     4102       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid14
     4103     .
     4104   end.
     4105     br-gds-act:refresh() in frame Dialog-Frame .
     4106   END PROCEDURE.
     4107   PROCEDURE disable_UI :
     4108     HIDE FRAME Dialog-Frame.
     4109   END PROCEDURE.
     4110   PROCEDURE enable_UI :
     4111     ENABLE b-cancel b-marks b-save br-gds-act b-del b-mark b-sel-all b-unmark
     4112         WITH FRAME Dialog-Frame.
     4113     VIEW FRAME Dialog-Frame.
     4114       if p-mode = 'ПРОСМОТР':U then do :
     4115           disable  tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     4116           define variable hCol as handle no-undo .
     4117           define variable hBr  as handle no-undo .
     4118           define variable i    as integer no-undo .
     4119           hBr = browse br-gds-act:handle .
     4120           do i = 7 to 13 :
     4121               hCol = hBr:GET-BROWSE-COLUMN(i).
     4122               hCol:read-only = true .
     4123           end.
     4124           hide b-good b-marks b-save b-del b-alc-code in FRAME Dialog-Frame.
     4125       end.
     4126   END PROCEDURE.
