      583   procedure xmlchar-decode :
      584   define input parameter p-in-string      as character        no-undo.
      585   define output parameter p-out-string    as character        no-undo.
      586       define variable v-position      as integer      no-undo.
      587       define variable v-last-position as integer      no-undo.
      588       define variable v-temp-integer  as integer      no-undo.
      589       define variable v-current-char  as character    no-undo.
      590       define variable v-next-char     as character    no-undo.
      591       define variable v-success       as logical      no-undo.
      592   do
      593   on error undo, return error
      594   :
      595       assign
      596           p-out-string = "":U
      597           v-position   = 0
      598       .
      599       replace-cycle:
      600       do while yes
      601       on error undo, return error
      602       :
      603           assign
      604               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      605           .
      606           if v-last-position <= v-position
      607           then do:
      608               if v-position = 0
      609               then do:
      610                   assign
      611                       p-out-string = p-in-string
      612                   .
      613               end.
      614               else do:
      615                   assign
      616                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      617                   .
      618               end.
      619               leave replace-cycle.
      620           end.
      621           else do:
      622               assign
      623                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      624                   v-position      = v-last-position
      625                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      626               .
      627               if v-current-char = "#":U
      628               then do:
      629                   assign
      630                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      631                   .
      632                   if v-last-position > 0
      633                   then do:
      634                       run xmlchar-read-integer in this-procedure
      635                        (
      636                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      637                           , output v-temp-integer
      638                           , output v-success
      639                       ).
      640                       if v-success = yes
      641                       and v-temp-integer >= 1
      642                       and v-temp-integer <= 255
      643                       then do:
      644                           assign
      645                               p-out-string = p-out-string + chr( v-temp-integer )
      646                               v-position   = v-last-position + 1
      647                           .
      648                       end.
      649                       else do:
      650                           assign
      651                               p-out-string = p-out-string + "&":U
      652                               v-position   = v-position   + 1
      653                           .
      654                       end.
      655                   end.
      656                   else do:
      657                       assign
      658                           p-out-string = p-out-string + "&":U
      659                           v-position   = v-position   + 1
      660                       .
      661                   end.
      662               end.
      663               else do:
      664                   case substring( p-in-string, v-position + 1, 3 )
      665                   :
      666                       when "lt;":U
      667                       then do:
      668                           assign
      669                               p-out-string = p-out-string + "<":U
      670                               v-position   = v-position   + 3
      671                           .
      672                       end.
      673                       when "gt;":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + ">":U
      677                               v-position   = v-position   + 3
      678                           .
      679                       end.
      680                       otherwise do:
      681                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      682                           then do:
      683                               assign
      684                                   p-out-string = p-out-string + "&":U
      685                                   v-position   = v-position   + 4
      686                               .
      687                           end.
      688                           else do:
      689                               case substring( p-in-string, v-position + 1, 5 )
      690                               :
      691                                   when "quot;":U
      692                                   then do:
      693                                       assign
      694                                           p-out-string = p-out-string + '"':U
      695                                           v-position   = v-position   + 5
      696                                       .
      697                                   end.
      698                                   when "apos;":U
      699                                   then do:
      700                                       assign
      701                                           p-out-string = p-out-string + "'":U
      702                                           v-position   = v-position   + 5
      703                                       .
      704                                   end.
      705                                   otherwise do:
      706                                       assign
      707                                           p-out-string = p-out-string + "&":U
      708                                       .
      709                                   end.
      710                               end case.
      711                           end.
      712                       end.
      713                   end case.
      714               end.
      715           end.
      716       end.
      717   end.
      718   end .
      719   procedure xmlchar-read-integer :
      720   define input parameter p-input-string      as character        no-undo.
      721   define output parameter p-output-integer   as integer          no-undo.
      722   define output parameter p-success       as logical          no-undo.
      723   do
      724   on error undo, return error
      725   :
      726       assign
      727           p-output-integer = integer( p-input-string )
      728       no-error.
      729       if error-status :error
      730       then do:
      731           assign
      732               p-success           = no
      733               p-output-integer    = 0
      734           .
      735       end.
      736       else do:
      737           assign
      738               p-success           = yes
      739           .
      740       end.
      741   end.
      742   end.
      743   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      744   procedure strtdate :
      745     define input  parameter p-str         as character no-undo .
      746     define output parameter p-value       as date      no-undo .
      747     define output parameter p-data-valid  as logical   no-undo .
      748     define output parameter p-message     as character no-undo .
      749   do
      750   on error undo, return error return-value
      751   :
      752     define variable v-value       as date      no-undo .
      753     define variable v-i           as integer   no-undo .
      754     define variable v-num         as integer   no-undo .
      755     define variable v-delim       as character no-undo .
      756     define variable v-delim-list  as character no-undo .
      757     define variable v-day         as integer   no-undo .
      758     define variable v-month       as integer   no-undo .
      759     define variable v-year        as integer   no-undo .
      760     define variable v-day-str     as character no-undo .
      761     define variable v-month-str   as character no-undo .
      762     define variable v-year-str    as character no-undo .
      763     assign
      764       p-value       = ?
      765       p-data-valid  = false
      766     .
      767     if p-str = ?
      768     then do:
      769       assign
      770         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      771       .
      772       return .
      773     end.
      774     if p-str = ""
      775     then do:
      776       assign
      777         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      778       .
      779       return .
      780     end.
      781     if length(p-str)  > 10
      782     then do:
      783       assign
      784         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      785       .
      786       return .
      787     end.
      788     assign
      789       v-delim-list = '/,-,.':U
      790     .
      791     _delim:
      792     do v-i = 1 to num-entries( v-delim-list )
      793     :
      794       assign
      795         v-delim = entry( v-i , v-delim-list )
      796         v-num   = num-entries( p-str , v-delim )
      797       .
      798       if v-num <> 3
      799       then do:
      800         assign
      801           v-delim = ''
      802         .
      803       end.
      804       else do:
      805         leave _delim.
      806       end.
      807     end.
      808     if v-delim = ''
      809     then do:
      810       assign
      811         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      812       .
      813       return .
      814     end.
      815     assign
      816       v-day-str   = entry( 1, p-str , v-delim)
      817       v-month-str = entry( 2, p-str , v-delim)
      818       v-year-str  = entry( 3, p-str , v-delim)
      819     .
      820     if  length(v-day-str) > 2   or
      821         length(v-day-str) < 1   or
      822         length(v-month-str) > 2 or
      823         length(v-month-str) < 1 or
      824         (
      825           length(v-year-str) <> 2 and
      826           length(v-year-str) <> 4
      827         )
      828     then do:
      829       assign
      830         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      831       .
      832       return .
      833     end.
      834     if length( v-year-str ) = 2
      835     then do:
      836       assign
      837         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      838       .
      839     end.
      840     assign
      841       v-day   = integer( v-day-str )
      842       v-month = integer( v-month-str)
      843       v-year  = integer( v-year-str)
      844     no-error .
      845     if error-status :error
      846     then do:
      847       assign
      848         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      849       .
      850       return .
      851     end.
      852     if v-day < 1  or
      853        v-day > 31 or
      854        v-month < 1 or
      855        v-month > 12 or
      856        v-year < 0   or
      857        v-year > 5000
      858     then do:
      859       assign
      860         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      861       .
      862       return .
      863     end.
      864     assign
      865       v-value = date( v-month, v-day, v-year )
      866     no-error .
      867     if error-status :error
      868     then do:
      869       assign
      870         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      871       .
      872       return .
      873     end.
      874     assign
      875       p-value       = v-value
      876       p-data-valid  = true
      877     .
      878   end.
      879   end procedure.
      880   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      881   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
