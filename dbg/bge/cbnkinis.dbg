        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-format    as character no-undo .
        4   define input parameter p-bik       like ub.fin-bank.bik no-undo .
        5   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        6   define input parameter p-mode     as character no-undo .
        7   define output parameter out     as character no-undo .
        8   define output parameter in_     as character no-undo .
        9   define output parameter spl     as character no-undo .
       10   define output parameter sav     as character no-undo .
       11   define output parameter adresat as character no-undo .
       12   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   def var vss-author      as character no-undo init "$Author: expertek $":U .
       14   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   def var vss-workfile    as character no-undo init "$Workfile: cbnkinis.p $":U .
       16   def var vss-archive     as character no-undo init "$Archive: bge/cbnkinis.p $":U .
       17   def var vss-description as character no-undo init "Получение настроек для экспорта/импорта в систему КЛИЕНТ-БАНК из ini-файла".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   PROCEDURE verify-ini-entry:
       89   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       90   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       91   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       92   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       93   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       94   define variable v-mess as character no-undo .
       95   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       96   if ini-entry-value = ? and ini-key-name begins "spl"
       97   then
       98   get-key-value section ini-section-name key "splall" value ini-entry-value.
       99   if ini-entry-value = ? and ini-key-name begins "sav"
      100   then
      101   get-key-value section ini-section-name key "savall" value ini-entry-value.
      102   if ini-entry-value = ? then do:
      103     assign
      104     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      105                       , chr(10)
      106                       , ini-section-name
      107                       , ini-key-name
      108                       , error-msg-text).
      109       if not silence then do:
      110         message
      111         v-mess
      112         view-as alert-box ERROR  .
      113         return error.
      114       end.
      115       else do:
      116         return error v-mess.
      117       end.
      118   end.
      119   END PROCEDURE.
      120   PROCEDURE verify-file:
      121   DEFINE INPUT  PARAMETER filename       as character no-undo.
      122   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      123   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      124   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      125   file-info:file-name = filename.
      126   found = NOT (file-info:full-pathname = ?).
      127   if NOT found  then do:
      128     if not silence then do:
      129       message error-msg-text
      130       view-as alert-box ERROR.
      131       return error.
      132     end.
      133     else return error error-msg-text.
      134   end.
      135   END PROCEDURE.
      136   define variable v-format-prfx as character no-undo .
      137   define variable glog as logical no-undo .
      138   define variable BadFlag as logical no-undo .
      139   define variable fq as integer no-undo .
      140   define variable yestr as character no-undo .
      141   CASE p-format:
      142     when '1s':U then do:
      143       assign
      144       v-format-prfx = '1s':U
      145       .
      146     end.
      147   END CASE.
      148   CASE p-format:
      149     when '1s':U
      150     then do:
      151         run verify-ini-entry in this-procedure (
      152                                                   INPUT  p-bik + '_out'
      153                                                 ,INPUT  'client-bank-' + v-format-prfx
      154                                                 ,INPUT substitute("отсутствует путь к подкаталогу out для экспорта в систему КЛИЕНТ-БАНК по формату &1 для БИК &2", p-format, p-bik)
      155                                                 ,INPUT yes
      156                                                 ,output out) no-error .
      157         if error-status:error or out = ? then return error return-value .
      158         RUN verify-file in this-procedure
      159                                           ( out
      160                                           , substitute("Не найден каталог &1 параметр &2_out, секция [client-bank-&3] ini-файла"
      161                                                       , out
      162                                                       , p-bik
      163                                                       , v-format-prfx)
      164                                           , yes
      165                                           ,output glog) no-error.
      166         if error-status:error or not glog then return error return-value .
      167         run verify-ini-entry in this-procedure (
      168                                                  INPUT  (p-bik + '_in')
      169                                                 ,INPUT  ('client-bank-' + v-format-prfx)
      170                                                 ,INPUT substitute("отсутствует путь к подкаталогу in для импорта данных из системы КЛИЕНТ-БАНК по формату &1 для БИК &2"
      171                                                                 , p-format
      172                                                                 , p-bik)
      173                                                 ,INPUT yes
      174                                                 ,output in_) no-error .
      175         if error-status:error or in_ = ? then return error return-value .
      176         RUN verify-file in this-procedure
      177                                           ( in_
      178                                           , substitute("Не найден каталог &1 параметр &2_in, секция [client-bank-&3] ini-файла"
      179                                                        , in_
      180                                                        , p-bik
      181                                                        , v-format-prfx)
      182                                           ,yes
      183                                           ,output glog) no-error.
      184         if error-status:error or not glog then return error return-value .
      185         RUN verify-ini-entry(  input substitute("&1_spl&2":U,  p-bik, p-host-code)
      186                               ,input substitute("client-bank-&1":U, v-format-prfx)
      187                               ,input substitute("отсутствует путь к подкаталогу &1&2 в каталогах экспорта/импорта данных в систему КЛИЕНТ-БАНК по формату &3 для фирмы с кодом &4"
      188                                               , substitute("&1_spl&2":U,  p-bik, p-host-code)
      189                                               , chr(10)
      190                                               , v-format-prfx
      191                                               , p-host-code
      192                                               )
      193                               ,input yes
      194                               ,output spl) no-error.
      195        if spl = ? or error-status:error then return error return-value .
      196        RUN verify-file(  input out + spl
      197                         ,input substitute("Не найден подкаталог &1 в директории &2&3 параметр &4_spl&5, секция [client-bank-&6] ini-файла"
      198                                           , spl
      199                                           , out
      200                                           , chr(10)
      201                                           , p-bik
      202                                           , p-host-code
      203                                           , v-format-prfx)
      204                         ,input yes
      205                         ,output glog) no-error.
      206        if error-status:error or not glog then return error return-value .
      207        RUN verify-ini-entry(   input substitute("&1_sav&2":U, p-bik, p-host-code )
      208                               ,input substitute("client-bank-&1":U, v-format-prfx)
      209                               ,input substitute("отсутствует путь к подкаталогу &1_sav&2 в каталогах экспорта/импорта данных в систему КЛИЕНТ-БАНК&3" +
      210                                                 "по ФОРМАТУ &4 для БИК &1 фирма &2"
      211                                                 ,p-bik
      212                                                 ,p-host-code
      213                                                 ,chr(10)
      214                                                 ,v-format-prfx
      215                                                 )
      216                               ,input yes
      217                               ,output sav) no-error.
      218         if error-status:error or sav = ? then do:
      219             sav = spl.
      220         end.
      221         else do:
      222           RUN verify-file(  input (in_ + sav)
      223                             ,input substitute("Не найден подкаталог &1 в директории &2&3 параметр &4_sav&5, секция [client-bank-&6] ini-файла"
      224                                               , sav
      225                                               , in_
      226                                               , chr(10)
      227                                               , p-bik
      228                                               , p-host-code
      229                                               , v-format-prfx)
      230                             ,input yes
      231                             ,output glog) no-error.
      232           if error-status:error or not glog then return error return-value .
      233         end.
      234         run verify-ini-entry in this-procedure (
      235                                                   INPUT  p-bik + '_adresat'
      236                                                 ,INPUT  'client-bank-' + v-format-prfx
      237                                                 ,INPUT substitute("отсутствует имя системы КЛИЕНТ-БАНК (параметр &1) по формату &2 для БИК &3", (p-bik + '_adresat'),  p-format, p-bik)
      238                                                 ,INPUT yes
      239                                                 ,output adresat) no-error .
      240         if error-status:error or out = ? then return error return-value .
      241         if p-mode = "send":U then do:
      242           run str/fileqnty.p ( out, output BadFlag ) .
      243           if not g#news and BadFlag then do:
      244             return error substitute("!!!Количество неотправленных в систему КЛИЕНТ-СЕРВЕР файлов в каталоге &1 превышает 500 ! "
      245                                     ,out).
      246           end.
      247         end.
      248     end.
      249   END CASE.
