     2985   :
     2986       if tb-exp-ref = yes
     2987       then do:
     2988           assign
     2989               tb-exp-ref-ext :sensitive in frame Dialog-Frame = yes
     2990           .
     2991       end.
     2992       else do:
     2993           assign
     2994               tb-exp-ref-ext :sensitive in frame Dialog-Frame = no
     2995           .
     2996       end.
