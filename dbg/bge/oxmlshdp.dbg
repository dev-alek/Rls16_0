     2999   PROCEDURE manage-tb-exp-stk :
     3000   do
     3001   on error undo, return error
     3002   :
     3003       if tb-exp-stk = yes
     3004       then do:
     3005           assign
     3006               tb-exp-stk-supp :sensitive in frame Dialog-Frame = yes
     3007           .
     3008       end.
     3009       else do:
     3010           assign
     3011               tb-exp-stk-supp :sensitive in frame Dialog-Frame = no
     3012           .
     3013       end.
     3014   end.
     3015   END PROCEDURE.
     3016   PROCEDURE object-select :
     3017   do
     3018   on error undo, return error
     3019   :
     3020   define input parameter p-rs-1   as integer      no-undo.
     3021   case p-rs-1
     3022   :
     3023       when 1
     3024       then do:
     3025           assign
     3026               ed-object :screen-value in frame Dialog-frame = ""
     3027           .
     3028       end.
     3029       when 2
     3030       then do:
     3031           assign
     3032               ed-object :screen-value = v-host-name
     3033           .
     3034       end.
     3035       when 3
     3036       then do:
     3037           assign
     3038               ed-object :screen-value = ""
     3039           .
     3040           for each temp_obj-list
     3041           :
     3042               assign
     3043                   ed-object :screen-value = ed-object :screen-value
     3044                       + ( if ed-object :screen-value = "" then "" else ", " )
     3045                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code )
     3046               .
     3047           end.
     3048       end.
     3049   end case.
     3050   end.
     3051   END PROCEDURE.
     3052   PROCEDURE select-objects-only-this-db :
     3053   define output parameter p-only-this-db-obj-list as character    no-undo.
     3054   define output parameter p-exclude-obj-list      as character    no-undo.
     3055       define variable v-db-num                as integer       no-undo.
     3056       define variable v-obj-type              as character     no-undo.
     3057       define variable v-obj-code              as integer       no-undo.
     3058       define buffer buf_clients       for ub.clients.
     3059       define buffer buf_temp_obj-list for temp_obj-list.
     3060       define buffer buf_temp_db-num   for temp_db-num.
     3061       define buffer buf_schedule      for ub.schedule.
     3062   do
     3063   for buf_clients
     3064     , buf_temp_obj-list
     3065     , buf_temp_db-num
     3066     , buf_schedule
     3067   on error undo, return error
     3068   :
     3069       find first buf_schedule no-lock
     3070            where buf_schedule.cre-db-num  = p-cre-db-num
     3071              and buf_schedule.task-type   = p-task-type
     3072              and buf_schedule.task-num    = p-task-num
     3073       no-error.
     3074       if error-status :error
     3075       then do:
     3076           message
     3077                    vss-workfile vss-revision vss-description
     3078               skip(1)
     3079               skip "Не найдена строка расписания для определения параметров."
     3080               skip return-value
     3081               skip trim( error-status :get-message( 1 ) )
     3082                    trim( error-status :get-message( 2 ) )
     3083                    trim( error-status :get-message( 3 ) )
     3084           view-as alert-box error.
     3085           undo, return error.
     3086       end.
     3087       assign
     3088           p-only-this-db-obj-list = "":U
     3089           p-exclude-obj-list      = "":U
     3090       .
     3091       if buf_schedule.db-num-char <> "*":U
     3092       then do:
     3093           run gbl/prcs-lst.p (
     3094                 input buf_schedule.db-num-char
     3095               , input 0
     3096               , input 99999
     3097               , input no
     3098               , input ( buffer buf_temp_db-num :handle )
     3099               , input "db-num-key":U
     3100           ) no-error .
     3101           if error-status :error
     3102           then do:
     3103               message
     3104                       vss-workfile vss-revision vss-description
     3105                   skip(1)
     3106                   skip "Ошибка разбора списка баз данных."
     3107                   skip return-value
     3108                   skip trim( error-status :get-message( 1 ) )
     3109                       trim( error-status :get-message( 2 ) )
     3110                       trim( error-status :get-message( 3 ) )
     3111               view-as alert-box error.
     3112               undo, return error.
     3113           end.
     3114       end.
     3115       for each buf_temp_obj-list
     3116       :
     3117           find first buf_clients no-lock
     3118                where buf_clients.obj-type = buf_temp_obj-list.obj-type
     3119                  and buf_clients.obj-code = buf_temp_obj-list.obj-code
     3120           .
     3121           if buf_schedule.db-num-char = "*":U
     3122           then do:
     3123               assign
     3124                   p-only-this-db-obj-list = p-only-this-db-obj-list
     3125                                           + ( if p-only-this-db-obj-list <> "" then ", " else "" )
     3126                                           + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3127               .
     3128           end.
     3129           else do:
     3130               find first buf_temp_db-num
     3131                    where buf_temp_db-num.db-num-key = buf_clients.db-num
     3132               no-error.
     3133               if available buf_temp_db-num
     3134               then do:
     3135                   assign
     3136                       p-only-this-db-obj-list = p-only-this-db-obj-list
     3137                                               + ( if p-only-this-db-obj-list <> "" then ", " else "" )
     3138                                               + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3139                   .
     3140               end.
     3141               else do:
     3142                   assign
     3143                       p-exclude-obj-list = p-exclude-obj-list
     3144                                               + ( if p-exclude-obj-list <> "" then ", " else "" )
     3145                                               + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3146                   .
     3147                   delete buf_temp_obj-list.
     3148               end.
     3149           end.
     3150       end.
     3151   end.
     3152   END PROCEDURE.
