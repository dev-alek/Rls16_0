     1219        SIZE 26.88 BY .83 NO-UNDO.
     1220   DEFINE FRAME Dialog-Frame
     1221        Btn_OK AT ROW 1.25 COL 1.5
     1222        Btn_Cancel AT ROW 1.25 COL 11.5
     1223        tb-incr AT ROW 1.25 COL 23
     1224        b-help AT ROW 1.25 COL 71
     1225        tb-exp-doc AT ROW 3.5 COL 3.75
     1226        tb-exp-ref AT ROW 3.5 COL 30.25
     1227        tb-exp-fo AT ROW 3.5 COL 59.75
     1228        tb-exp-day AT ROW 4.29 COL 3.75
     1229        tb-exp-checks AT ROW 4.29 COL 6.75
     1230        tb-exp-ref-ext AT ROW 4.29 COL 33.25
     1231        tb-exp-fp AT ROW 4.5 COL 59.75
     1232        tb-exp-way AT ROW 5.08 COL 3.75
     1233        tb-exp-stk AT ROW 5.08 COL 30.25
     1234        tb-exp-stk-supp AT ROW 5.92 COL 33.25
     1235        fi-days-amount AT ROW 7.83 COL 41.75 COLON-ALIGNED
     1236        rs-date AT ROW 8.17 COL 3.5 NO-LABEL
     1237        fi-days-ago AT ROW 9.04 COL 41.75 COLON-ALIGNED
     1238        fi-date-from AT ROW 10.29 COL 30.63 COLON-ALIGNED
     1239        fi-date-to AT ROW 10.33 COL 47.38 COLON-ALIGNED
     1240        tb-supp AT ROW 11.33 COL 27.88
     1241        rs-1 AT ROW 12.5 COL 3.5 NO-LABEL
     1242        ed-object AT ROW 12.5 COL 20.88 NO-LABEL
     1243        bt-sel-obj AT ROW 14.79 COL 17.38
     1244        ed-doc-type AT ROW 16.71 COL 16.88 NO-LABEL
     1245        ed-doc-type-title AT ROW 16.79 COL 3 NO-LABEL
     1246        bt-sel-doc-type AT ROW 17.38 COL 58.13
     1247        tb-inkass-pay-code AT ROW 19.58 COL 3.13
     1248        tb-cst-code AT ROW 19.58 COL 33.13
     1249        tb-chk-pay-code AT ROW 20.42 COL 3.13
     1250        tb-parts AT ROW 20.42 COL 33.13
     1251        tb-pay-desk AT ROW 21.21 COL 6.13
     1252        tb-not-fact-docs AT ROW 21.21 COL 33.13
     1253        tb-pay-desk-cards AT ROW 22 COL 6.13
     1254        fi-dates-title AT ROW 7.08 COL 1 COLON-ALIGNED NO-LABEL
     1255        fi-doc-options AT ROW 18.79 COL 1 COLON-ALIGNED NO-LABEL
     1256        " Список выгрузки:" VIEW-AS TEXT
     1257             SIZE 18.88 BY .79 AT ROW 2.63 COL 4
     1258        rct-dates AT ROW 7.29 COL 2
     1259        rct-obj AT ROW 12 COL 2
     1260        rct-doc-type AT ROW 16.5 COL 2
     1261        rct-doc-options AT ROW 19 COL 2
     1262        RECT-5 AT ROW 3 COL 2.25
     1263        SPACE(0.37) SKIP(16.28)
     1264       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1265            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1266            TITLE "Параметры экспорта по расписанию"
     1267            CANCEL-BUTTON Btn_Cancel.
     1268   ASSIGN
     1269          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1270          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1271   ASSIGN
     1272          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1273   ASSIGN
     1274          tb-supp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1275   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1276   DO:
     1277     APPLY "END-ERROR":U TO SELF.
     1278   END.
     1279   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
     1280   DO:
     1281       define variable v-cancel     as logical           no-undo.
     1282       define variable v-oper-num   as integer           no-undo.
     1283       define variable v-doc-type-select as character no-undo .
     1284       assign
     1285       v-doc-type-select = (if input frame Dialog-Frame tb-exp-doc then "trn-doc":U else "":U)
     1286       v-doc-type-select = (if input frame Dialog-Frame tb-exp-fp
     1287                           then (v-doc-type-select + (if v-doc-type-select = "":U then "":U else chr(44)) + "fin-doc":U)
     1288                           else v-doc-type-select)
     1289       .
     1290       run bge/bgeseltp.w (
     1291             input v-doc-type-select
     1292           , input v-init-doc-type-list
     1293           , output v-doc-type-list
     1294           , output v-cancel
     1295       ) no-error.
     1296       if error-status :error
     1297       then do:
     1298           message
     1299             vss-workfile vss-revision vss-description
     1300             skip "Ошибка выбора типов операций."
     1301             skip return-value
     1302             skip trim(error-status :get-message(1))
     1303                  trim(error-status :get-message(2))
     1304                  trim(error-status :get-message(3))
     1305                  trim(error-status :get-message(4))
     1306                  trim(error-status :get-message(5))
     1307           view-as alert-box error.
     1308           undo, return no-apply .
     1309       end.
     1310       if v-cancel = yes
     1311       then do:
     1312           assign
     1313               v-doc-type-list = v-init-doc-type-list
     1314           .
     1315       end.
     1316       else do:
     1317           assign
     1318               v-init-doc-type-list    = v-doc-type-list
     1319           .
     1320           if v-doc-type-list = ''
     1321           then do:
     1322               assign
     1323                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
     1324               .
     1325           end.
     1326           else do:
     1327               assign
     1328                   ed-doc-type :screen-value in frame Dialog-Frame = ''
     1329               .
     1330               do v-oper-num = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1331               :
     1332                   if lookup( entry( v-oper-num, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), v-init-doc-type-list ) <> 0
     1333                   then do:
     1334                       assign
     1335                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1336                                                       + entry( v-oper-num, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) + chr(10)
     1337                       .
     1338                   end.
     1339               end.
     1340               do v-oper-num = 1 to num-entries( 'пко,рко,ппп,рпп,апп,апр,':U )
     1341               :
     1342                   if lookup( entry( v-oper-num, 'пко,рко,ппп,рпп,апп,апр,':U ), v-init-doc-type-list ) <> 0
     1343                   then do:
     1344                       assign
     1345                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1346                                                       + entry( v-oper-num, 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U ) + chr(10)
     1347                       .
     1348                   end.
     1349               end.
     1350           end.
     1351       end.
     1352   END.
     1353   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     1354   DO:
     1355       define variable v-obj-list           as character no-undo .
     1356       define variable v-exclude-obj-list   as character no-undo .
     1357       define variable v-object-available as logical   no-undo .
     1358       assign
     1359           rs-1 :screen-value  = "3"
     1360       .
     1361   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1362   run userobjs_clear in this-procedure  .
     1363   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1364   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1365     (input  v-cntxt-db-num
     1366     ,input  0
     1367     ,input  v-cntxt-userid
     1368     ,input  v-cntxt-obj-type
     1369     ,input  v-cntxt-obj-code
     1370     ,output v-object-available
     1371     ) no-error .
     1372       if error-status :error
     1373       then do:
     1374         message
     1375           vss-workfile vss-revision vss-description skip
     1376           "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1377           error-status :get-message(1) skip
     1378           return-value skip
     1379           view-as alert-box error .
     1380         undo, return no-apply .
     1381       end.
     1382       if v-object-available = true
     1383       then do:
     1384   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   run userobjs_append in this-procedure
     1386     (input  v-cntxt-obj-type
     1387     ,input  v-cntxt-obj-code
     1388     )  .
     1389       end.
     1390       define variable v-user-select as logical   no-undo .
     1391   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1392   run userobjs_select-many in this-procedure
     1393     (input  parparentproc
     1394     ,input  v-cntxt-db-num
     1395     ,input  v-cntxt-userid
     1396     ,input  v-cntxt-host-code-obj
     1397     ,input  v-cntxt-obj-type
     1398     ,input  v-cntxt-obj-code
     1399     ,output v-user-select
     1400     )  .
     1401       if v-user-select <> true
     1402       then do:
     1403         message
     1404           "Объект не выбран"
     1405           view-as alert-box information .
     1406         return no-apply .
     1407       end.
     1408       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1409       for each buf_userobjs_temp-user-obj
     1410       on error undo, return no-apply
     1411       :
     1412         create temp_obj-list .
     1413         assign
     1414           temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1415           temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     1416         .
     1417       end.
     1418       run select-objects-only-this-db in this-procedure
     1419         (output v-obj-list
     1420         ,output v-exclude-obj-list
     1421         ).
     1422       if v-exclude-obj-list <> ""
     1423       then do:
     1424           message
     1425               "Из списка выбранных объектов исключены"
     1426               skip "объекты, не принадлежащие БД, указанной в расписании:"
     1427               skip(1)
     1428               skip v-exclude-obj-list
     1429           view-as alert-box information.
     1430       end.
     1431       assign
     1432           ed-object :screen-value = v-obj-list
     1433       .
     1434   END.
     1435   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1436   DO:
     1437       assign
     1438           p-cancel = yes
     1439       .
     1440   END.
     1441   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1442   DO:
     1443       define variable v-obj-list as character     no-undo.
     1444       ASSIGN
     1445           rs-date
     1446           fi-days-amount
     1447           fi-days-ago
     1448           fi-date-from
     1449           fi-date-to
     1450           rs-1
     1451           tb-supp
     1452           tb-inkass-pay-code
     1453           tb-cst-code
     1454           tb-parts
     1455           tb-chk-pay-code
     1456           tb-pay-desk
     1457           tb-pay-desk-cards
     1458           tb-not-fact-docs
     1459           tb-exp-doc
     1460           tb-exp-ref
     1461           tb-exp-day
     1462           tb-exp-way
     1463           tb-exp-ref-ext
     1464           tb-exp-stk
     1465           tb-exp-stk-supp
     1466           tb-incr
     1467           tb-exp-checks
     1468           tb-exp-fo
     1469           tb-exp-fp
     1470       .
     1471       if tb-exp-doc  = no
     1472       and tb-exp-ref = no
     1473       and tb-exp-fo = no
     1474       and tb-exp-fp = no
     1475       and ( ( tb-exp-day = no
     1476               and tb-exp-way = no
     1477               and tb-exp-stk = no )
     1478          or ( tb-incr = yes ) )
     1479       then do:
     1480           message
     1481               skip "Выберите по крайней мере один тип выгрузки"
     1482               skip "или отмените ввод параметров выгрузки."
     1483           view-as alert-box warning
     1484           buttons ok
     1485           title "Не выбран тип выгрузки".
     1486           undo, return no-apply.
     1487       end.
     1488       case rs-1
     1489       :
     1490       when 1
     1491       then do:
     1492           assign
     1493               v-obj-list = ""
     1494           .
     1495       end.
     1496       when 2
     1497       then do:
     1498           assign
     1499               v-obj-list = ""
     1500           .
     1501       end.
     1502       when 3
     1503       then do:
     1504           assign
     1505               v-obj-list = ""
     1506           .
     1507           for each temp_obj-list
     1508           :
     1509               assign
     1510                   v-obj-list = v-obj-list
     1511                           + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     1512                           + "," + string( temp_obj-list.obj-code )
     1513               .
     1514           end.
     1515       end.
     1516       end case.
     1517       find first temp_obj-list no-error.
     1518       if not available temp_obj-list
     1519       and rs-1 = 3
     1520       then do:
     1521           message
     1522               "Не выбраны объекты для выгрузки."
     1523           view-as alert-box warning.
     1524           undo, return no-apply.
     1525       end.
