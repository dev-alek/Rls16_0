     2129   procedure minbtn-set :
     2130       do
     2131           on error undo, return error return-value
     2132           :
     2133           define variable ii              as integer       no-undo .
     2134           define variable fh              as widget-handle no-undo .
     2135           define variable hh              as widget-handle no-undo .
     2136           define variable v-h             as handle        extent 4 no-undo .
     2137           define variable v-name-button   as character     no-undo .
     2138           define variable v-help-old-x    as decimal       no-undo .
     2139           define variable v-help-old-y    as decimal       no-undo .
     2140           define variable v-help-old-size as decimal       no-undo .
     2141           define variable v-frame-width   as decimal       no-undo .
     2142           define variable jj              as integer       no-undo .
     2143           do
     2144               on error undo, return error
     2145               :
     2146               assign
     2147                   v-frame-width = frame Dialog-Frame:width - 0.3
     2148                   fh            = frame Dialog-Frame:first-child
     2149                   hh            = fh:first-child
     2150                   ii            = 1
     2151                   .
     2152               do while valid-handle(hh):
     2153                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2154                   do:
     2155                       case lc(hh:name) :
     2156                           when "b-help" then
     2157                               do:
     2158                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2159                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2160                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2161                                   hh:TOOLTIP = "Помощь" .
     2162                                   v-help-old-x = hh:column .
     2163                                   v-help-old-y = hh:row    .
     2164                                   v-help-old-size = hh:width .
     2165                                   hh:width-chars = 2.5 .
     2166                               end.
     2167                           when "b-print" then
     2168                               do:
     2169                                   hh:load-image("cmp/b-print.bmp":u) .
     2170                                   hh:TOOLTIP = "Печать" .
     2171                                   v-h[ii] = hh:handle .
     2172                                   ii = ii + 1 .
     2173                                   hh:width-chars = 3 .
     2174                               end.
     2175                           when "b-history" or
     2176                           when "b-hist" then
     2177                               do:
     2178                                   hh:load-image("cmp/b-hist.bmp":u) .
     2179                                   hh:TOOLTIP = "История" .
     2180                                   v-h[ii] = hh:handle .
     2181                                   ii = ii + 1 .
     2182                                   hh:width-chars = 3 .
     2183                               end.
     2184                           when "b-sch" then
     2185                               do:
     2186                                   hh:load-image("cmp/b-sch.bmp":u) .
     2187                                   hh:TOOLTIP = "Установка Фильтра" .
     2188                                   v-h[ii] = hh:handle .
     2189                                   ii = ii + 1 .
     2190                                   hh:width-chars = 3 .
     2191                               end.
     2192                           when "b-hist-user" then
     2193                               do:
     2194                                   hh:load-image("cmp/b-hist.bmp":u) .
     2195                                   hh:TOOLTIP = "История пользователя" .
     2196                                   ii = ii + 1 .
     2197                               end.
     2198                       end case.
     2199                   end.
     2200                   hh = hh:next-sibling.
     2201               end.
     2202               b-help:column = v-frame-width - b-help:width-chars.
     2203               jj = 0.
     2204               repeat ii = 4 to 1 by -1 :
     2205                   if valid-handle (v-h[ii] ) then
     2206                   do:
     2207                       jj  = jj + 1 .
     2208                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2209                       v-h[ii]:row    = v-help-old-y .
     2210                   end.
     2211               end.
     2212           end.
     2213       end.
     2214   end procedure.
     2215   MAIN-BLOCK:
     2216   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2217      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2218       define buffer buf_schedule      for ub.schedule.
     2219       assign
     2220           frame Dialog-Frame :title = frame Dialog-Frame :title
     2221                       + ". " + p-task-type + ": Задача номер " + string( p-task-num )
     2222       .
     2223   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2224     run mainmenu_getcntxt in parparentproc
     2225       (output v-cntxt-db-num
     2226       ,output v-cntxt-userid
     2227       ,output v-cntxt-level
     2228       ,output v-cntxt-host-code-obj
     2229       ,output v-cntxt-obj-type
     2230       ,output v-cntxt-obj-code
     2231       ,output v-cntxt-db-num-obj
     2232       ,output v-cntxt-is-admin
     2233       ) .
     2234       run get-host-name in this-procedure ( output v-host-name ) no-error .
     2235       if error-status :error
     2236       then do:
     2237           message
     2238             vss-workfile vss-revision vss-description
     2239             skip "Ошибка при определении имени фирмы"
     2240             skip "Код фирмы:" v-cntxt-host-code-obj
     2241             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     2242             skip return-value
     2243             skip trim(error-status :get-message(1))
     2244                  trim(error-status :get-message(2))
     2245                  trim(error-status :get-message(3))
     2246           view-as alert-box warning.
     2247           assign
     2248               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     2249           .
     2250       end.
     2251       run init-param-values in this-procedure (
     2252             input p-cre-db-num
     2253           , input p-task-type
     2254           , input p-task-num
     2255           , output fi-days-amount
     2256           , output rs-date
     2257           , output fi-days-ago
     2258           , output fi-date-from
     2259           , output fi-date-to
     2260           , output tb-supp
     2261           , output v-obj-list
     2262           , output rs-1
     2263           , output v-init-doc-type-list
     2264           , output tb-inkass-pay-code
     2265           , output tb-cst-code
     2266           , output tb-parts
     2267           , output tb-chk-pay-code
     2268           , output tb-pay-desk
     2269           , output tb-pay-desk-cards
     2270           , output tb-not-fact-docs
     2271           , output tb-exp-doc
     2272           , output tb-exp-ref
     2273           , output tb-exp-day
     2274           , output tb-exp-way
     2275           , output tb-exp-ref-ext
     2276           , output tb-exp-stk
     2277           , output tb-exp-stk-supp
     2278           , output tb-incr
     2279           , output tb-exp-checks
     2280           , output tb-exp-fo
     2281           , output tb-exp-fp
     2282       ).
     2283       find first buf_schedule no-lock
     2284            where buf_schedule.cre-db-num = p-cre-db-num
     2285              and buf_schedule.task-type  = p-task-type
     2286              and buf_schedule.task-num   = p-task-num
     2287       no-error.
     2288       if not available buf_schedule
     2289       and (  p-task-type   <> 'autoexp':U
     2290           or p-task-num    <> -1 )
     2291       then do:
     2292           message
     2293             vss-workfile vss-revision vss-description
     2294             skip "Не найдена строка расписания."
     2295             skip return-value
     2296             skip trim(error-status :get-message(1))
     2297                  trim(error-status :get-message(2))
     2298                  trim(error-status :get-message(3))
     2299           view-as alert-box error.
     2300           undo, return error .
     2301       end.
     2302       run enable_UI.
     2303       if available buf_schedule
     2304       and buf_schedule.db-num-char <> "*"
     2305       then do:
     2306           rs-1 :disable("глобально").
     2307           rs-1 :disable("по фирме").
     2308       end.
     2309       run date-select in this-procedure (
     2310           input rs-date
     2311       ).
     2312       run object-select in this-procedure (
     2313           input rs-1
     2314       ).
     2315       run init-fields in this-procedure .
     2316       WAIT-FOR GO OF FRAME Dialog-Frame.
     2317   END.
     2318   RUN disable_UI.
     2319   PROCEDURE attach-attr-to-schedule-line :
     2320   do
     2321   on error undo, return error
     2322   :
     2323       define input parameter p-rs-date            as integer      no-undo.
     2324       define input parameter p-days-amount        as integer      no-undo.
     2325       define input parameter p-days-ago           as integer      no-undo.
     2326       define input parameter p-date-from          as date         no-undo.
     2327       define input parameter p-date-to            as date         no-undo.
     2328       define input parameter p-rs-1               as integer      no-undo.
     2329       define input parameter p-object-list        as character    no-undo.
     2330       define input parameter p-doc-type-list      as character    no-undo.
     2331       define input parameter p-tb-supp            as logical      no-undo.
     2332       define input parameter p-tb-inkass-pay-code as logical      no-undo.
     2333       define input parameter p-tb-cst-code        as logical      no-undo.
     2334       define input parameter p-tb-parts           as logical      no-undo.
     2335       define input parameter p-tb-chk-pay-code    as logical      no-undo.
     2336       define input parameter p-tb-pay-desk        as logical      no-undo.
     2337       define input parameter p-tb-pay-desk-cards  as logical      no-undo.
     2338       define input parameter p-tb-not-fact-docs   as logical      no-undo.
     2339       define input parameter p-tb-exp-doc         as logical      no-undo.
     2340       define input parameter p-tb-exp-ref         as logical      no-undo.
     2341       define input parameter p-tb-exp-day         as logical      no-undo.
     2342       define input parameter p-tb-exp-way         as logical      no-undo.
     2343       define input parameter p-tb-exp-ref-ext     as logical      no-undo.
     2344       define input parameter p-tb-exp-stk         as logical      no-undo.
     2345       define input parameter p-tb-exp-stk-supp    as logical      no-undo.
     2346       define input parameter p-tb-incr            as logical      no-undo.
     2347       define input parameter p-tb-exp-checks      as logical      no-undo.
     2348       define input parameter p-tb-exp-fo          as logical      no-undo.
     2349       define input parameter p-tb-exp-fp          as logical      no-undo.
     2350       define variable v-attr-value as character     no-undo.
     2351       define buffer buf_schedule      for ub.schedule.
     2352       define buffer buf_schedule-attr for ub.schedule-attr.
     2353       find first buf_schedule no-lock
     2354            where buf_schedule.cre-db-num = p-cre-db-num
     2355              and buf_schedule.task-type  = p-task-type
     2356              and buf_schedule.task-num   = p-task-num
     2357       no-error.
     2358       if not available buf_schedule
     2359       and (  p-task-type   <> 'autoexp':U
     2360           or p-task-num    <> -1 )
     2361       then do:
     2362           message
     2363             vss-workfile vss-revision vss-description
     2364             skip "Не найдена строка расписания."
     2365             skip return-value
     2366             skip trim(error-status :get-message(1))
     2367                  trim(error-status :get-message(2))
     2368                  trim(error-status :get-message(3))
     2369           view-as alert-box error.
     2370           undo, return error .
     2371       end.
     2372       assign
     2373           v-attr-value = string( p-rs-1 )
     2374                           + "," + ( if p-tb-inkass-pay-code = yes then "yes" else "no" )
     2375                           + "," + ( if p-tb-cst-code        = yes then "yes" else "no" )
     2376                           + "," + ( if p-tb-not-fact-docs   = yes then "yes" else "no" )
     2377                           + "," + ( if p-tb-supp            = yes then "yes" else "no" )
     2378                           + "," + ( if p-tb-parts           = yes then "yes" else "no" )
     2379                           + "," + ( if p-tb-chk-pay-code    = yes then "yes" else "no" )
     2380                           + "," + ( if p-tb-exp-doc         = yes then "yes" else "no" )
     2381                           + "," + ( if p-tb-exp-ref         = yes then "yes" else "no" )
     2382                           + "," + ( if p-tb-exp-day         = yes then "yes" else "no" )
     2383                           + "," + ( if p-tb-exp-way         = yes then "yes" else "no" )
     2384                           + "," + ( if p-tb-exp-ref-ext     = yes then "yes" else "no" )
     2385                           + "," + ( if p-tb-exp-stk         = yes then "yes" else "no" )
     2386                           + "," + ( if p-tb-exp-stk-supp    = yes then "yes" else "no" )
     2387                           + "," + string( v-cntxt-host-code-obj )
     2388                           + "," + ( if tb-pay-desk          = yes then "yes" else "no" )
     2389                           + "," + ( if tb-incr              = yes then "yes" else "no" )
     2390                           + "," + ( if tb-exp-checks        = yes then "yes" else "no" )
     2391                           + "," + ( if tb-exp-fo            = yes then "yes" else "no" )
     2392                           + "," + ( if tb-exp-fp            = yes then "yes" else "no" )
     2393                           + "," + ( if tb-pay-desk-cards    = yes then "yes" else "no" )
     2394       .
     2395       run schedule-attr-write in this-procedure (
     2396             input p-cre-db-num
     2397           , input p-task-type
     2398           , input p-task-num
     2399           , input 'schedule-param-list':U
     2400           , input v-attr-value
     2401       ).
     2402       run schedule-attr-write in this-procedure (
     2403             input p-cre-db-num
     2404           , input p-task-type
     2405           , input p-task-num
     2406           , input 'schedule-obj-list':U
     2407           , input p-object-list
     2408       ).
     2409       run schedule-attr-write in this-procedure (
     2410             input p-cre-db-num
     2411           , input p-task-type
     2412           , input p-task-num
     2413           , input 'schedule-doc-type-list':U
     2414           , input p-doc-type-list
     2415       ).
     2416       assign
     2417           v-attr-value = string( p-rs-date )
     2418                           + "," + string( p-days-amount )
     2419                           + "," + string( p-days-ago    )
     2420                           + "," + string( p-date-from   )
     2421                           + "," + string( p-date-to     )
     2422       .
     2423       run schedule-attr-write in this-procedure (
     2424             input p-cre-db-num
     2425           , input p-task-type
     2426           , input p-task-num
     2427           , input 'schedule-date-list':U
     2428           , input v-attr-value
     2429       ).
     2430       for each buf_schedule-attr
     2431       on error undo, return error
     2432       :
     2433           if buf_schedule-attr.task-type  <> 'autoexp':U
     2434           or buf_schedule-attr.cre-db-num <> p-cre-db-num
     2435           or buf_schedule-attr.task-num   <> -1
     2436           or (
     2437                   buf_schedule-attr.attr-code <> 'schedule-date-list':U
     2438               and buf_schedule-attr.attr-code <> 'schedule-param-list':U
     2439               and buf_schedule-attr.attr-code <> 'schedule-obj-list':U
     2440               and buf_schedule-attr.attr-code <> 'schedule-doc-type-list':U
     2441           )
     2442           then do:
     2443               find first buf_schedule
     2444                    where buf_schedule.cre-db-num = buf_schedule-attr.cre-db-num
     2445                      and buf_schedule.task-type  = buf_schedule-attr.task-type
     2446                      and buf_schedule.task-num   = buf_schedule-attr.task-num
     2447               no-error.
     2448               if not available buf_schedule
     2449               then do:
     2450                   delete buf_schedule-attr.
     2451               end.
     2452           end.
     2453       end.
     2454   end.
     2455   END PROCEDURE.
     2456   PROCEDURE date-select :
     2457   do
     2458   on error undo, return error
     2459   :
     2460   define input parameter p-date-select-value as integer      no-undo.
     2461       case p-date-select-value
     2462       :
     2463           when 0
     2464           then do:
     2465               hide
     2466                   fi-date-from in frame Dialog-Frame
     2467                   fi-date-to
     2468               .
     2469               view
     2470                   fi-days-ago
     2471                   fi-days-amount
     2472               .
     2473           end.
     2474           when 1
     2475           then do:
     2476               hide
     2477                   fi-date-to
     2478                   fi-days-ago
     2479                   fi-days-amount
     2480               .
     2481               view
     2482                   fi-date-from
     2483               .
     2484           end.
     2485           when 2
     2486           then do:
     2487               hide
     2488                   fi-days-ago
     2489                   fi-days-amount
     2490               .
     2491               view
     2492                   fi-date-from
     2493                   fi-date-to
     2494               .
     2495           end.
     2496       end case.
     2497   end.
     2498   END PROCEDURE.
     2499   PROCEDURE disable_UI :
     2500     HIDE FRAME Dialog-Frame.
     2501   END PROCEDURE.
     2502   PROCEDURE enable_UI :
     2503     DISPLAY tb-incr tb-exp-doc tb-exp-ref tb-exp-fo tb-exp-day tb-exp-checks
     2504             tb-exp-ref-ext tb-exp-fp tb-exp-way tb-exp-stk tb-exp-stk-supp
     2505             fi-days-amount rs-date fi-days-ago fi-date-from fi-date-to rs-1
     2506             ed-object ed-doc-type ed-doc-type-title tb-inkass-pay-code tb-cst-code
     2507             tb-chk-pay-code tb-parts tb-pay-desk tb-not-fact-docs
     2508             tb-pay-desk-cards fi-dates-title fi-doc-options
     2509         WITH FRAME Dialog-Frame.
     2510     ENABLE rct-dates rct-obj rct-doc-type rct-doc-options RECT-5 Btn_OK
     2511            Btn_Cancel tb-incr b-help tb-exp-doc tb-exp-ref tb-exp-fo tb-exp-day
     2512            tb-exp-checks tb-exp-ref-ext tb-exp-fp tb-exp-way tb-exp-stk
     2513            tb-exp-stk-supp fi-days-amount rs-date fi-days-ago fi-date-from
     2514            fi-date-to rs-1 bt-sel-obj ed-doc-type bt-sel-doc-type
     2515            tb-inkass-pay-code tb-cst-code tb-chk-pay-code tb-parts tb-pay-desk
     2516            tb-not-fact-docs tb-pay-desk-cards
     2517         WITH FRAME Dialog-Frame.
     2518     VIEW FRAME Dialog-Frame.
     2519   END PROCEDURE.
     2520   PROCEDURE extract-parameter :
     2521   do
     2522   on error undo, return error
     2523   :
     2524   end.
     2525   END PROCEDURE.
     2526   PROCEDURE get-host-name :
     2527   do
     2528   on error undo, return error
     2529   :
     2530   define output parameter p-host-name as character    no-undo.
     2531   define buffer buf_clients   for ub.clients.
     2532       find first buf_clients no-lock
     2533            where buf_clients.obj-type = 'орг':U
     2534              and buf_clients.obj-code = v-cntxt-host-code-obj
     2535       no-error.
     2536       if not available buf_clients
     2537       then do:
     2538           message
     2539             vss-workfile vss-revision vss-description
     2540             skip "Не удалось найти текущую фирму"
     2541             skip return-value
     2542             skip trim(error-status :get-message(1))
     2543                  trim(error-status :get-message(2))
     2544                  trim(error-status :get-message(3))
     2545                  trim(error-status :get-message(4))
     2546                  trim(error-status :get-message(5))
     2547           view-as alert-box error.
     2548           undo, return error .
     2549       end.
     2550       else do:
     2551           assign
     2552               p-host-name = buf_clients.obj-name
     2553           .
     2554       end.
     2555   end.
     2556   END PROCEDURE.
     2557   PROCEDURE init-fields :
     2558   do
     2559   on error undo, return error
     2560   :
     2561       define variable v-oper-num     as integer           no-undo.
     2562       run manage-tb-exp-stk       in this-procedure.
     2563       run manage-tb-exp-ref       in this-procedure.
     2564       run manage-options          in this-procedure.
     2565       run manage-tb-chk-pay-code  in this-procedure.
     2566       assign
     2567           v-doc-type-list = v-init-doc-type-list
     2568       .
     2569       if v-init-doc-type-list <> ?
     2570       and v-init-doc-type-list <> ''
     2571       then do:
     2572           assign
     2573               ed-doc-type :screen-value in frame Dialog-Frame = ""
     2574           .
     2575           do v-oper-num = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2576           :
     2577               if lookup( entry( v-oper-num, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), v-init-doc-type-list ) <> 0
     2578               then do:
     2579                   assign
     2580                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     2581                                                   + entry( v-oper-num, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) + chr(10)
     2582                   .
     2583               end.
     2584           end.
     2585           do v-oper-num = 1 to num-entries( 'пко,рко,ппп,рпп,апп,апр,':U )
     2586           :
     2587               if lookup( entry( v-oper-num, 'пко,рко,ппп,рпп,апп,апр,':U ), v-init-doc-type-list ) <> 0
     2588               then do:
     2589                   assign
     2590                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     2591                                                   + entry( v-oper-num, 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U ) + chr(10)
     2592                   .
     2593               end.
     2594           end.
     2595       end.
     2596   end.
     2597   END PROCEDURE.
     2598   PROCEDURE init-param-values :
     2599   do
     2600   on error undo, return error
     2601   :
     2602   define input  parameter p-cre-db-num            as integer   no-undo .
     2603   define input  parameter p-task-type             as character no-undo .
     2604   define input  parameter p-task-num              as integer   no-undo .
     2605   define output parameter p-days-amount           as integer      no-undo.
     2606   define output parameter p-rs-date               as integer      no-undo.
     2607   define output parameter p-days-ago              as integer      no-undo.
     2608   define output parameter p-date-from             as date         no-undo.
     2609   define output parameter p-date-to               as date         no-undo.
     2610   define output parameter p-tb-supp               as logical      no-undo.
     2611   define output parameter p-obj-list              as character    no-undo.
     2612   define output parameter p-rs-1                  as integer      no-undo.
     2613   define output parameter p-doc-type-list         as character    no-undo.
     2614   define output parameter p-tb-inkass-pay-code    as logical      no-undo.
     2615   define output parameter p-tb-cst-code           as logical      no-undo.
     2616   define output parameter p-tb-parts              as logical      no-undo.
     2617   define output parameter p-tb-chk-pay-code       as logical      no-undo.
     2618   define output parameter p-tb-pay-desk           as logical      no-undo.
     2619   define output parameter p-tb-pay-desk-cards     as logical      no-undo.
     2620   define output parameter p-tb-not-fact-docs      as logical      no-undo.
     2621   define output parameter p-tb-exp-doc            as logical      no-undo.
     2622   define output parameter p-tb-exp-ref            as logical      no-undo.
     2623   define output parameter p-tb-exp-day            as logical      no-undo.
     2624   define output parameter p-tb-exp-way            as logical      no-undo.
     2625   define output parameter p-tb-exp-ref-ext        as logical      no-undo.
     2626   define output parameter p-tb-exp-stk            as logical      no-undo.
     2627   define output parameter p-tb-exp-stk-supp       as logical      no-undo.
     2628   define output parameter p-tb-incr               as logical      no-undo.
     2629   define output parameter p-tb-exp-checks         as logical      no-undo.
     2630   define output parameter p-tb-exp-fo             as logical      no-undo.
     2631   define output parameter p-tb-exp-fp             as logical      no-undo.
     2632       define variable v-counter       as integer       no-undo.
     2633       define variable v-param-list    as character     no-undo.
     2634       run schedule-attr-value in this-procedure (
     2635             input p-cre-db-num
     2636           , input p-task-type
     2637           , input p-task-num
     2638           , input 'schedule-doc-type-list':U
     2639           , output p-doc-type-list
     2640           , output v-param-type
     2641       ) .
     2642       run schedule-attr-value in this-procedure (
     2643             input p-cre-db-num
     2644           , input p-task-type
     2645           , input p-task-num
     2646           , input 'schedule-obj-list':U
     2647           , output p-obj-list
     2648           , output v-param-type
     2649       ) .
     2650       for each temp_obj-list
     2651       :
     2652           delete temp_obj-list.
     2653       end.
     2654       do v-counter = 1 to num-entries( p-obj-list ) / 2
     2655       :
     2656           create temp_obj-list.
     2657           assign
     2658               temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-obj-list )
     2659               temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-obj-list ) )
     2660           .
     2661       end.
     2662       run schedule-attr-value in this-procedure (
     2663             input p-cre-db-num
     2664           , input p-task-type
     2665           , input p-task-num
     2666           , input 'schedule-param-list':U
     2667           , output v-param-list
     2668           , output v-param-type
     2669       ) .
     2670       if v-param-list = ""
     2671       then do:
     2672           assign
     2673               p-rs-1                  = 0
     2674               p-tb-inkass-pay-code    = no
     2675               p-tb-cst-code           = no
     2676               p-tb-not-fact-docs      = no
     2677               p-tb-supp               = no
     2678               p-tb-parts              = no
     2679               p-tb-chk-pay-code       = no
     2680               p-tb-pay-desk           = no
     2681               p-tb-pay-desk-cards     = no
     2682               p-tb-exp-doc            = no
     2683               p-tb-exp-ref            = no
     2684               p-tb-exp-day            = no
     2685               p-tb-exp-way            = no
     2686               p-tb-exp-ref-ext        = no
     2687               p-tb-exp-stk            = no
     2688               p-tb-exp-stk-supp       = no
     2689               p-tb-incr               = no
     2690               p-tb-exp-checks         = no
     2691               p-tb-exp-fo             = no
     2692               p-tb-exp-fp             = no
     2693           .
     2694       end.
     2695       else do:
     2696           assign
     2697               p-rs-1 = integer( entry( 1, v-param-list ) )
     2698           .
     2699           run schedule-attr-extract-logical in this-procedure (
     2700                 input 2
     2701               , input v-param-list
     2702               , output p-tb-inkass-pay-code
     2703           ).
     2704           run schedule-attr-extract-logical in this-procedure (
     2705                 input 3
     2706               , input v-param-list
     2707               , output p-tb-cst-code
     2708           ).
     2709           run schedule-attr-extract-logical in this-procedure (
     2710                 input 4
     2711               , input v-param-list
     2712               , output p-tb-not-fact-docs
     2713           ).
     2714           run schedule-attr-extract-logical in this-procedure (
     2715                 input 5
     2716               , input v-param-list
     2717               , output p-tb-supp
     2718           ).
     2719           run schedule-attr-extract-logical in this-procedure (
     2720                 input 6
     2721               , input v-param-list
     2722               , output p-tb-parts
     2723           ).
     2724           run schedule-attr-extract-logical in this-procedure (
     2725                 input 7
     2726               , input v-param-list
     2727               , output p-tb-chk-pay-code
     2728           ).
     2729           run schedule-attr-extract-logical in this-procedure (
     2730                 input 8
     2731               , input v-param-list
     2732               , output p-tb-exp-doc
     2733           ).
     2734           run schedule-attr-extract-logical in this-procedure (
     2735                 input 9
     2736               , input v-param-list
     2737               , output p-tb-exp-ref
     2738           ).
     2739           run schedule-attr-extract-logical in this-procedure (
     2740                 input 10
     2741               , input v-param-list
     2742               , output p-tb-exp-day
     2743           ).
     2744           run schedule-attr-extract-logical in this-procedure (
     2745                 input 11
     2746               , input v-param-list
     2747               , output p-tb-exp-way
     2748           ).
     2749           run schedule-attr-extract-logical in this-procedure (
     2750                 input 12
     2751               , input v-param-list
     2752               , output p-tb-exp-ref-ext
     2753           ).
     2754           run schedule-attr-extract-logical in this-procedure (
     2755                 input 13
     2756               , input v-param-list
     2757               , output p-tb-exp-stk
     2758           ).
     2759           run schedule-attr-extract-logical in this-procedure (
     2760                 input 14
     2761               , input v-param-list
     2762               , output p-tb-exp-stk-supp
     2763           ).
     2764           run schedule-attr-extract-logical in this-procedure (
     2765                 input 16
     2766               , input v-param-list
     2767               , output p-tb-pay-desk
     2768           ).
     2769           run schedule-attr-extract-logical in this-procedure (
     2770                 input 17
     2771               , input v-param-list
     2772               , output p-tb-incr
     2773           ).
     2774           run schedule-attr-extract-logical in this-procedure (
     2775                 input 18
     2776               , input v-param-list
     2777               , output p-tb-exp-checks
     2778           ).
     2779           run schedule-attr-extract-logical in this-procedure (
     2780                 input 19
     2781               , input v-param-list
     2782               , output p-tb-exp-fo
     2783           ).
     2784           run schedule-attr-extract-logical in this-procedure (
     2785                 input 20
     2786               , input v-param-list
     2787               , output p-tb-exp-fp
     2788           ).
     2789           run schedule-attr-extract-logical in this-procedure (
     2790                 input 21
     2791               , input v-param-list
     2792               , output p-tb-pay-desk-cards
     2793           ).
     2794       end.
     2795       run schedule-attr-value in this-procedure (
     2796             input p-cre-db-num
     2797           , input p-task-type
     2798           , input p-task-num
     2799           , input 'schedule-date-list':U
     2800           , output v-param-list
     2801           , output v-param-type
     2802       ) .
     2803       if v-param-list = ""
     2804       then do:
     2805           define variable v-today as date      no-undo.
     2806           define variable v-time  as integer   no-undo.
     2807           run cur-time in this-procedure ( output v-today
     2808                                          , output v-time
     2809                                          ).
     2810           assign
     2811               p-rs-date       = 0
     2812               p-days-amount   = 1
     2813               p-days-ago      = 0
     2814               p-date-from     = v-today - 1
     2815               p-date-to       = v-today - 1
     2816           .
     2817       end.
     2818       else do:
     2819           assign
     2820               p-rs-date       = integer( entry( 1, v-param-list ) )
     2821               p-days-amount   = integer( entry( 2, v-param-list ) )
     2822               p-days-ago      = integer( entry( 3, v-param-list ) )
     2823               p-date-from     = date( entry( 4, v-param-list ) )
     2824               p-date-to       = date( entry( 5, v-param-list ) )
     2825           .
     2826       end.
     2827   end.
     2828   END PROCEDURE.
     2829   PROCEDURE manage-options :
     2830   do
     2831   on error undo, return error
     2832   :
     2833       assign
     2834           rct-doc-options     :visible in frame Dialog-Frame = no
     2835           fi-doc-options      :visible in frame Dialog-Frame = no
     2836           tb-inkass-pay-code  :visible in frame Dialog-Frame = no
     2837           tb-chk-pay-code     :visible in frame Dialog-Frame = no
     2838           tb-pay-desk         :visible in frame Dialog-Frame = no
     2839           tb-pay-desk-cards   :visible in frame Dialog-Frame = no
     2840           tb-cst-code         :visible in frame Dialog-Frame = no
     2841           tb-parts            :visible in frame Dialog-Frame = no
     2842           tb-not-fact-docs    :visible in frame Dialog-Frame = no
     2843           rct-doc-type        :visible in frame Dialog-Frame = no
     2844           ed-doc-type-title   :visible in frame Dialog-Frame = no
     2845           ed-doc-type         :visible in frame Dialog-Frame = no
     2846           bt-sel-doc-type     :visible in frame Dialog-Frame = no
     2847           rct-dates           :visible in frame Dialog-Frame = no
     2848           fi-dates-title      :visible in frame Dialog-Frame = no
     2849           rs-date             :visible in frame Dialog-Frame = no
     2850           fi-days-amount      :visible in frame Dialog-Frame = no
     2851           fi-days-ago         :visible in frame Dialog-Frame = no
     2852           fi-date-from        :visible in frame Dialog-Frame = no
     2853           fi-date-to          :visible in frame Dialog-Frame = no
     2854       .
     2855       if tb-incr = yes
     2856       then do:
     2857           assign
     2858               tb-exp-day          :visible in frame Dialog-Frame = no
     2859               tb-exp-way          :visible in frame Dialog-Frame = no
     2860               tb-exp-stk          :visible in frame Dialog-Frame = no
     2861               tb-exp-stk-supp     :visible in frame Dialog-Frame = no
     2862               tb-exp-ref-ext      :visible in frame Dialog-Frame = no
     2863               tb-exp-checks       :visible in frame Dialog-Frame = yes
     2864               rct-obj             :visible in frame Dialog-Frame = yes
     2865               rs-1                :visible in frame Dialog-Frame = yes
     2866               bt-sel-obj          :visible in frame Dialog-Frame = yes
     2867               ed-object           :visible in frame Dialog-Frame = yes
     2868           .
     2869           run object-select in this-procedure (
     2870               input rs-1
     2871           ).
     2872           if tb-exp-doc = yes
     2873           then do:
     2874               enable
     2875                   tb-exp-checks
     2876               with frame Dialog-Frame .
     2877           end.
     2878           else do:
     2879               disable
     2880                   tb-exp-checks
     2881               with frame Dialog-Frame .
     2882           end.
     2883       end.
     2884       else do:
     2885           assign
     2886               tb-exp-day          :visible in frame Dialog-Frame = yes
     2887               tb-exp-way          :visible in frame Dialog-Frame = yes
     2888               tb-exp-stk          :visible in frame Dialog-Frame = yes
     2889               tb-exp-stk-supp     :visible in frame Dialog-Frame = yes
     2890               tb-exp-ref-ext      :visible in frame Dialog-Frame = yes
     2891               tb-exp-checks       :visible in frame Dialog-Frame = no
     2892               rct-obj             :visible in frame Dialog-Frame = no
     2893               rs-1                :visible in frame Dialog-Frame = no
     2894               bt-sel-obj          :visible in frame Dialog-Frame = no
     2895               ed-object           :visible in frame Dialog-Frame = no
     2896           .
     2897           run object-select in this-procedure (
     2898               input rs-1
     2899           ).
     2900           if tb-exp-doc = yes
     2901           then do:
     2902               assign
     2903                   rct-doc-options     :visible in frame Dialog-Frame = yes
     2904                   fi-doc-options      :visible in frame Dialog-Frame = yes
     2905                   tb-inkass-pay-code  :visible in frame Dialog-Frame = yes
     2906                   tb-chk-pay-code     :visible in frame Dialog-Frame = yes
     2907                   tb-pay-desk         :visible in frame Dialog-Frame = yes
     2908                   tb-pay-desk-cards   :visible in frame Dialog-Frame = yes
     2909                   tb-cst-code         :visible in frame Dialog-Frame = yes
     2910                   tb-parts            :visible in frame Dialog-Frame = yes
     2911                   tb-not-fact-docs    :visible in frame Dialog-Frame = yes
     2912               .
     2913           end.
     2914           if tb-exp-doc = yes
     2915           or tb-exp-fp = yes
     2916           or tb-exp-fo = yes
     2917           then do:
     2918               assign
     2919                   rct-doc-type        :visible in frame Dialog-Frame = yes
     2920                   ed-doc-type-title   :visible in frame Dialog-Frame = yes
     2921                   ed-doc-type         :visible in frame Dialog-Frame = yes
     2922                   bt-sel-doc-type     :visible in frame Dialog-Frame = yes
     2923               .
     2924           end.
     2925           if tb-exp-doc = yes
     2926           or tb-exp-ref = yes
     2927           or tb-exp-day = yes
     2928           or tb-exp-way = yes
     2929           or tb-exp-stk = yes
     2930           or tb-exp-fo = yes
     2931           or tb-exp-fp = yes
     2932           then do:
     2933               assign
     2934                   rct-obj             :visible in frame Dialog-Frame = yes
     2935                   rs-1                :visible in frame Dialog-Frame = yes
     2936                   bt-sel-obj          :visible in frame Dialog-Frame = yes
     2937                   ed-object           :visible in frame Dialog-Frame = yes
     2938               .
     2939           end.
     2940           if tb-exp-doc = yes
     2941           or tb-exp-day = yes
     2942           or tb-exp-stk = yes
     2943           or tb-exp-ref = yes
     2944           or tb-exp-fo = yes
     2945           or tb-exp-fp = yes
     2946           then do:
     2947               assign
     2948                   rct-dates           :visible in frame Dialog-Frame = yes
     2949                   fi-dates-title      :visible in frame Dialog-Frame = yes
     2950                   rs-date             :visible in frame Dialog-Frame = yes
     2951                   fi-days-amount      :visible in frame Dialog-Frame = yes
     2952                   fi-days-ago         :visible in frame Dialog-Frame = yes
     2953                   fi-date-from        :visible in frame Dialog-Frame = yes
     2954                   fi-date-to          :visible in frame Dialog-Frame = yes
     2955               .
     2956               run date-select in this-procedure (
     2957                   input rs-date
     2958               ).
     2959           end.
     2960       end.
     2961   end.
     2962   END PROCEDURE.
     2963   PROCEDURE manage-tb-chk-pay-code :
     2964   do
     2965   on error undo, return error
     2966   :
     2967       if tb-chk-pay-code = yes
     2968       then do:
     2969           assign
     2970               tb-pay-desk :sensitive in frame Dialog-Frame = yes
     2971               tb-pay-desk-cards :sensitive in frame Dialog-Frame = yes
     2972           .
     2973       end.
     2974       else do:
     2975           assign
     2976               tb-pay-desk :sensitive in frame Dialog-Frame = no
     2977               tb-pay-desk-cards :sensitive in frame Dialog-Frame = no
     2978           .
     2979       end.
     2980   end.
     2981   END PROCEDURE.
     2982   PROCEDURE manage-tb-exp-ref :
