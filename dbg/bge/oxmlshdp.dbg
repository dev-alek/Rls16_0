      980     on error undo, return error return-value
      981     :
      982       run gbl/userobjs.w
      983         (input  parparentproc
      984         ,input  this-procedure :handle
      985         ,input  p-db-num
      986         ,input  p-user-id
      987         ,input  p-host-code-obj
      988         ,input  p-obj-type
      989         ,input  p-obj-code
      990         ,INPUT  "b-sel"
      991         ,output p-user-select
      992         ,output p-select-obj-type
      993         ,output p-select-obj-code
      994         ) .
