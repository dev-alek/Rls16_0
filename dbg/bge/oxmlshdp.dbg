      997   procedure userobjs_select-many :
      998     define input  parameter parparentproc   as widget-handle no-undo .
      999     define input  parameter p-db-num        as integer   no-undo .
     1000     define input  parameter p-user-id       as character no-undo .
     1001     define input  parameter p-host-code-obj as integer   no-undo .
     1002     define input  parameter p-obj-type      as character no-undo .
     1003     define input  parameter p-obj-code      as integer   no-undo .
     1004     define output parameter p-user-select   as logical   no-undo .
     1005     define variable v-select-obj-type as character no-undo .
     1006     define variable v-select-obj-code as integer   no-undo .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       run gbl/userobjs.w
     1011         (input  parparentproc
     1012         ,input  this-procedure :handle
     1013         ,input  p-db-num
     1014         ,input  p-user-id
     1015         ,input  p-host-code-obj
     1016         ,input  p-obj-type
     1017         ,input  p-obj-code
     1018         ,INPUT  "b-sel,b-mark"
