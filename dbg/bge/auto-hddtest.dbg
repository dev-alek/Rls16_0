      541   define variable v-cmd-file-name   as character  no-undo .
      542   define variable v-command         as character  no-undo .
      543   define variable v-out-str         as character  no-undo .
      544   define variable v-pid-list        as character  no-undo .
      545   define variable v-time-str        as character  no-undo .
      546   define variable v-del-file        as character  no-undo .
      547   define variable v-count-main-prc         as integer   no-undo .
      548   define variable v-pers-proc-name         as character no-undo .
      549   define variable v-part-rowid as rowid no-undo .
      550   define variable v-tbl-name as character no-undo .
      551   define buffer buf_code for ub.Code .
      552   define buffer buf_devisPC for ub.devisPC .
      553   define buffer buf_devisPC-attr for ub.devisPC-attr .
      554   define variable v-start-DT as datetime no-undo initial 1/1/1970 .
      555   define variable v-test-DT as datetime no-undo .
      556   define variable v-epoch-time as integer no-undo .
      557   define variable v-str-dt as character no-undo .
      558   define variable v-tms as integer no-undo .
      559   define variable hDoc              as handle     no-undo .
      560   define variable hRoot             as handle     no-undo .
      561   define variable good              as logical    no-undo .
      562   define variable ii as integer no-undo.
      563   do
      564   on error undo, return error
      565   :
      566     if transaction then do:
      567       message
      568         substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile )
      569         view-as alert-box error .
      570       return error .
      571     end.
      572     if valid-handle( session :first-procedure ) then do:
      573       assign
      574         v-main-proc-name = "gbl/mainproc.p":U
      575         v-proc-handle    = session :first-procedure
      576         v-count-main-prc = 0
      577         v-pers-proc-name = "":U
      578       .
      579       do while valid-handle( v-proc-handle )
      580       :
      581         if v-proc-handle :file-name = v-main-proc-name then do:
      582           assign
      583             v-count-main-prc = v-count-main-prc + 1
      584           .
      585         end.
      586         else do:
      587           assign
      588             v-pers-proc-name = v-pers-proc-name + chr(44) + v-proc-handle :file-name
      589           .
      590         end.
      591         assign
      592           v-proc-handle = v-proc-handle:next-sibling no-error
      593         .
      594       end.
      595       if v-count-main-prc > 1
      596         or v-pers-proc-name <> "":U
      597       then do:
      598         message
      599           substitute( "&1. Вызов данной процедуры невозможен при наличии определений persistent prosedures &2"
      600                       + "Список недопустимых процедур: &3&2"
      601                       + "Исключение - единственная процедура &4&2"
      602                       + "Определений данной процедуры &5&2"
      603                       , vss-workfile
      604                       , chr(10)
      605                       , v-pers-proc-name
      606                       , v-main-proc-name
      607                       , v-count-main-prc
      608                      )
      609           view-as alert-box error .
      610         return error .
      611       end.
      612     end.
      613     assign
      614       g#auto                = true
      615     .
      616     run gbl/set-gbl.p
      617       (input true
      618       ,input p-user-login
      619       ,input p-user-password
      620       ) no-error.
      621     if error-status :error
      622     then do:
      623       run write-to-log( substitute("&1. Ошибка при инициализации переменных g#... &2&3&4"
      624                                     ,vss-workfile
      625                                     ,error-status:get-message(error-status:num-messages)
      626                                     ,chr(10)
      627                                     ,return-value
      628                                   )
      629                       ) .
      630       return error.
      631     end.
      632     assign
      633       g#auto = true
      634     .
      635     assign
      636     curl-path = search("exe/curl.exe")
      637     .
      638     v-response-file-name = "hdd-test-result.xml" .
      639     run write-to-log( "Работа с БД " + string(p-db-num) ) .
      640     for each buf_code no-lock where buf_code.parent = "SpravDevice"
      641                                 and buf_code.status_ = 0 :
      642       if trim(buf_code.misc1) = ""
      643       then do :
      644         run write-to-log( "Для устройства " + string(buf_code.code) + " " + string(buf_code.CodeName) + " не указан IP" ) .
      645         next.
      646       end.
      647       v-tms = interval( now, v-start-DT , "seconds" ) .
      648       v-tms = v-tms - 604800 - (timezone * 60) .
      649       find last buf_devisPC no-lock where buf_devisPC.db-num = p-db-num
      650                                       and buf_devisPC.namepc = buf_code.CodeName
      651                                       no-error.
      652       if available buf_devisPC
      653       then do :
      654         find last buf_devisPC-attr exclusive-lock where buf_devisPC-attr.db-num = buf_devisPC.DB-num
      655                                                     and buf_devisPC-attr.id = buf_devisPC.id
      656                                                     no-error.
      657         if available buf_devisPC-attr
      658         then do :
      659           v-test-DT = dateTime(buf_devisPC-attr.date, (buf_devisPC-attr.time_ * 1000)) .
      660           v-tms = interval( v-test-DT, v-start-DT , "seconds" ) .
      661           v-tms = v-tms - 10000 - (timezone * 60) .
      662         end.
      663       end.
      664       v-post-file-name = "hdd-test-req.xml" .
      665       v-out-str = substitute ("<?xml version='1.0' encoding='windows-1251'?><data type='dsw'><HddTest ctrl='READ' tms = '&1'></HddTest><Count>500</Count></data>", string(v-tms)) .
      666       output to value (v-post-file-name) .
      667       put unformatted v-out-str skip .
      668       output close .
      669       v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
      670                               , curl-path
      671                               , v-post-file-name
      672                               , buf_code.misc1
      673                               , v-response-file-name) .
      674       os-command silent value (v-command) .
      675       file-info:file-name = v-response-file-name .
      676       if file-info:file-size = 0
      677       then do :
      678         run write-to-log( "Пустой ответ от устройства " + string(buf_code.CodeName) + ". IP: " +  trim(buf_code.misc1)) .
      679         next.
      680       end.
      681       empty temp-table HddTest .
      682       empty temp-table hddAttributes .
      683       run parse-xml (input v-response-file-name) no-error.
      684       if error-status:error
      685       then do :
      686         run write-to-log( "Не могу разобрать ответ от устройства " + string(buf_code.CodeName) + ". IP: " +  trim(buf_code.misc1)) .
      687         next.
      688       end.
      689       for each HddTest no-lock break by HddTest.dt :
      690         find first buf_devisPC no-lock where buf_devisPC.modeldevice = trim(HddTest.hddModule)
      691                                          and buf_devisPC.SerialNumber = trim(HddTest.hddSerial)
      692                                          and buf_devisPC.ModelPC = trim(HddTest.sysInfo)
      693                                          and buf_devisPC.DB-num = p-db-num
      694                                          no-error .
      695         if not available buf_devisPC
      696         then do :
      697           create buf_devisPC .
      698           assign
      699             buf_devisPC.id = next-value(s-devisPC-id)
      700             buf_devisPC.DB-num = p-db-num
      701             buf_devisPC.ModelPC = trim(HddTest.sysInfo)
      702             buf_devisPC.namepc = buf_code.CodeName
      703             buf_devisPC.modeldevice = trim(HddTest.hddModule)
      704             buf_devisPC.SerialNumber = trim(HddTest.hddSerial)
      705           .
      706         end.
      707         find last buf_devisPC-attr exclusive-lock where buf_devisPC-attr.db-num = buf_devisPC.DB-num
      708                                                     and buf_devisPC-attr.id = buf_devisPC.id
      709                                                     and buf_devisPC-attr.attr-code = "ProcDisk"
      710                                                     and buf_devisPC-attr.date = date(HddTest.dt)
      711                                                     and buf_devisPC-attr.time_ = integer( truncate( MTIME( HddTest.dt ) / 1000, 0 ) )
      712                                                     no-error.
      713         if not available buf_devisPC-attr
      714         then do :
      715           create buf_devisPC-attr .
      716           assign
      717             buf_devisPC-attr.db-num = buf_devisPC.DB-num
      718             buf_devisPC-attr.id = buf_devisPC.id
      719             buf_devisPC-attr.attr-code = "ProcDisk"
      720             buf_devisPC-attr.date = date(HddTest.dt)
      721             buf_devisPC-attr.time_ = integer( truncate( MTIME( HddTest.dt ) / 1000, 0 ) )
      722           .
      723         end.
      724         assign buf_devisPC-attr.attr-value = string(HddTest.hddFilling) .
      725         find last buf_devisPC-attr exclusive-lock where buf_devisPC-attr.db-num = buf_devisPC.DB-num
      726                                                     and buf_devisPC-attr.id = buf_devisPC.id
      727                                                     and buf_devisPC-attr.attr-code = "UserProc"
      728                                                     and buf_devisPC-attr.date = date(HddTest.dt)
      729                                                     and buf_devisPC-attr.time_ = integer( truncate( MTIME( HddTest.dt ) / 1000, 0 ) )
      730                                                     no-error.
      731         if not available buf_devisPC-attr
      732         then do :
      733           create buf_devisPC-attr .
      734           assign
      735             buf_devisPC-attr.db-num = buf_devisPC.DB-num
      736             buf_devisPC-attr.id = buf_devisPC.id
      737             buf_devisPC-attr.attr-code = "UserProc"
      738             buf_devisPC-attr.date = date(HddTest.dt)
      739             buf_devisPC-attr.time_ = integer( truncate( MTIME( HddTest.dt ) / 1000, 0 ) )
      740           .
      741         end.
      742         assign buf_devisPC-attr.attr-value = string(HddTest.hddSysFilling) .
      743         find last buf_devisPC-attr exclusive-lock where buf_devisPC-attr.db-num = buf_devisPC.DB-num
      744                                                     and buf_devisPC-attr.id = buf_devisPC.id
      745                                                     and buf_devisPC-attr.attr-code = "testStatus"
      746                                                     and buf_devisPC-attr.date = date(HddTest.dt)
      747                                                     and buf_devisPC-attr.time_ = integer( truncate( MTIME( HddTest.dt ) / 1000, 0 ) )
      748                                                     no-error.
      749         if not available buf_devisPC-attr
      750         then do :
      751           create buf_devisPC-attr .
      752           assign
      753             buf_devisPC-attr.db-num = buf_devisPC.DB-num
      754             buf_devisPC-attr.id = buf_devisPC.id
      755             buf_devisPC-attr.attr-code = "testStatus"
      756             buf_devisPC-attr.date = date(HddTest.dt)
      757             buf_devisPC-attr.time_ = integer( truncate( MTIME( HddTest.dt ) / 1000, 0 ) )
      758           .
      759         end.
      760         assign buf_devisPC-attr.attr-value = HddTest.testStatus .
      761         for each hddAttributes no-lock where hddAttributes.hddModule   = HddTest.hddModule
      762                                          and hddAttributes.hddSerial   = HddTest.hddSerial
      763                                          and hddAttributes.dt          = HddTest.dt :
      764           find last buf_devisPC-attr exclusive-lock where buf_devisPC-attr.db-num = buf_devisPC.DB-num
      765                                                       and buf_devisPC-attr.id = buf_devisPC.id
      766                                                       and buf_devisPC-attr.attr-code = hddAttributes.name_
      767                                                       and buf_devisPC-attr.date = date(hddAttributes.dt)
      768                                                       and buf_devisPC-attr.time_ = integer( truncate( MTIME( hddAttributes.dt ) / 1000, 0 ) )
      769                                                       no-error.
      770           if not available buf_devisPC-attr
      771           then do :
      772             create buf_devisPC-attr .
      773             assign
      774               buf_devisPC-attr.db-num = buf_devisPC.DB-num
      775               buf_devisPC-attr.id = buf_devisPC.id
      776               buf_devisPC-attr.attr-code = hddAttributes.name_
      777               buf_devisPC-attr.date = date(hddAttributes.dt)
      778               buf_devisPC-attr.time_ = integer( truncate( MTIME( hddAttributes.dt ) / 1000, 0 ) )
      779             .
      780           end.
      781           assign
      782             buf_devisPC-attr.attr-value = string(hddAttributes.value_)
      783             buf_devisPC-attr.attr-Raw-value = string(hddAttributes.raw_value)
      784             buf_devisPC-attr.tresh = string(hddAttributes.thresh)
      785             buf_devisPC-attr.type = hddAttributes.type_
      786           .
      787         end.
      788       end.
      789     end.
      790     run write-to-log( "Закончена работа с БД " + string(p-db-num) ) .
      791   end.
      792   procedure parse-xml :
      793     define input parameter p-file as character .
      794     CREATE X-DOCUMENT hDoc.
      795     CREATE X-NODEREF hRoot.
      796     hDoc:LOAD("file",p-file,FALSE) no-error.
      797     if error-status:error
      798     then do :
      799       DELETE OBJECT hDoc no-error.
      800       DELETE OBJECT hRoot no-error.
      801       return error .
      802     end .
      803     hDoc:GET-DOCUMENT-ELEMENT(hRoot) no-error.
      804     if error-status:error
      805     then do :
      806       DELETE OBJECT hDoc no-error.
      807       DELETE OBJECT hRoot no-error.
      808       return error .
      809     end .
      810     RUN GetChildren(hRoot, 1) no-error.
      811     if error-status:error
      812     then do :
      813       DELETE OBJECT hDoc no-error.
      814       DELETE OBJECT hRoot no-error.
      815       return error .
      816     end .
      817     DELETE OBJECT hDoc.
      818     DELETE OBJECT hRoot.
      819   end procedure .
      820   PROCEDURE GetChildren:
      821   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      822   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      823   DEFINE VARIABLE i AS INTEGER NO-UNDO.
      824   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      825   DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      826   define variable client as character no-undo.
      827   CREATE X-NODEREF hNoderef.
      828   CREATE X-NODEREF hText .
      829   i = hParent:num-children no-error .
      830   if error-status:error
      831   or i = ?
      832   then do :
      833     DELETE OBJECT hNoderef no-error .
      834     DELETE OBJECT hText no-error .
      835     return error .
      836   end .
      837   REPEAT i = 1 TO hParent:NUM-CHILDREN:
      838       good = hParent:GET-CHILD(hNoderef,i).
      839       IF NOT good THEN
      840           LEAVE.
      841       IF hNoderef:SUBTYPE <> "element" THEN
      842           NEXT.
      843       hNoderef:GET-CHILD(hText, 1) no-error .
      844       IF hNoderef:NAME = "HddTest"
      845       then do :
      846         create HddTest .
      847         assign v-str-dt = hNoderef:get-attribute("tstamp") .
      848         integer(v-str-dt) no-error .
      849         if error-status:error
      850         then do :
      851           assign HddTest.dt = my-date(v-str-dt).
      852         end.
      853         else do :
      854           assign v-epoch-time = integer(v-str-dt) .
      855           assign HddTest.dt = ADD-INTERVAL(v-start-DT, v-epoch-time, "SECONDS").
      856         end.
      857       end.
      858       IF hNoderef:NAME = "hddModule" then assign HddTest.hddModule = hText:node-value no-error .
      859       IF hNoderef:NAME = "testStatus"then assign HddTest.testStatus = hText:node-value no-error .
      860       IF hNoderef:NAME = "hddFilling" then assign HddTest.hddFilling = hText:node-value no-error .
      861       IF hNoderef:NAME = "hddSysFilling" then assign HddTest.hddSysFilling = hText:node-value no-error .
      862       IF hNoderef:NAME = "systemInfo" then assign HddTest.sysInfo = hText:node-value no-error .
      863       IF hNoderef:NAME = "hddName" then assign HddTest.hddName = hText:node-value no-error .
      864       IF hNoderef:NAME = "hddSerial"
      865       then do :
      866         assign HddTest.hddSerial = hText:node-value no-error .
      867       end.
      868       IF hNoderef:NAME = "hddAttributes"
      869       then do :
      870         create hddAttributes .
      871         assign
      872           hddAttributes.hddModule   = HddTest.hddModule
      873           hddAttributes.hddSerial   = HddTest.hddSerial
      874           hddAttributes.dt          = HddTest.dt
      875         .
      876       end.
      877       IF hNoderef:NAME = "name"
      878       then do :
      879         find first buf_hddAttributes where buf_hddAttributes.hddModule = hddAttributes.hddModule
      880                                        and buf_hddAttributes.hddSerial = hddAttributes.hddSerial
      881                                        and buf_hddAttributes.dt        = hddAttributes.dt
      882                                        and buf_hddAttributes.name_     = hText:node-value
      883                                        no-error .
      884         if available buf_hddAttributes
      885         then do :
      886           delete buf_hddAttributes .
      887         end.
      888         assign hddAttributes.name_ = hText:node-value no-error .
      889       end.
      890       IF hNoderef:NAME = "value" then assign hddAttributes.value_ = integer(hText:node-value) no-error .
      891       IF hNoderef:NAME = "thresh" then assign hddAttributes.thresh = integer(hText:node-value) no-error .
      892       IF hNoderef:NAME = "type" then assign hddAttributes.type_ = hText:node-value no-error .
      893       IF hNoderef:NAME = "raw_value" then assign hddAttributes.raw_value = hText:node-value no-error .
      894       RUN GetChildren(hNoderef, (level + 1)).
      895   END.
      896   DELETE OBJECT hNoderef.
      897   DELETE OBJECT hText.
      898   END PROCEDURE.
      899   function my-date returns datetime-tz (input v-str as character) :
      900     define variable v-year    as integer no-undo .
      901     define variable v-month   as integer no-undo .
      902     define variable v-day     as integer no-undo .
      903     define variable v-hour    as integer no-undo .
      904     define variable v-min     as integer no-undo .
      905     define variable v-sec     as integer no-undo .
      906     define variable v-tz-hour as integer no-undo .
      907     define variable v-tz-min  as integer no-undo .
      908     define variable v-sign    as character no-undo .
      909     define variable v-time-delta as integer no-undo .
      910     define variable v-dttz    as datetime-tz no-undo .
      911     assign
      912       v-year    = integer(substring(v-str, 1, 4))
      913       v-month   = integer(substring(v-str, 6, 2))
      914       v-day     = integer(substring(v-str, 9, 2))
      915       v-hour    = integer(substring(v-str, 12, 2))
      916       v-min     = integer(substring(v-str, 15, 2))
      917       v-sec     = integer(substring(v-str, 18, 2))
      918       v-tz-hour = integer(substring(v-str, 21, 2))
      919       v-tz-min  = integer(substring(v-str, 23, 2))
      920       v-sign    = substring(v-str, 20, 1)
      921       v-time-delta = (v-tz-hour) * 60 + v-tz-min
      922     .
      923     if v-sign = "-" then v-time-delta = v-time-delta * -1 .
      924     v-dttz = datetime-tz(v-month, v-day, v-year, v-hour, v-min, v-sec, 0, v-time-delta) .
      925     return v-dttz .
      926   end function.
