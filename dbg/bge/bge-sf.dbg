      650                       end.
      651                       when chr(10)
      652                       then do:
      653                           assign
      654                               p-out-string = p-out-string + " ":U
      655                           .
      656                       end.
      657                       when chr(13)
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + " ":U
      661                           .
      662                       end.
      663                       otherwise do:
      664                           assign
      665                               p-out-string = p-out-string + v-current-char
      666                           .
      667                       end.
      668                   end case.
      669               end.
      670           end.
      671       end case.
      672   end.
      673   end .
      674   procedure xmlchar-decode :
      675   define input parameter p-in-string      as character        no-undo.
      676   define output parameter p-out-string    as character        no-undo.
      677       define variable v-position      as integer      no-undo.
      678       define variable v-last-position as integer      no-undo.
      679       define variable v-temp-integer  as integer      no-undo.
      680       define variable v-current-char  as character    no-undo.
      681       define variable v-next-char     as character    no-undo.
      682       define variable v-success       as logical      no-undo.
      683   do
      684   on error undo, return error
      685   :
      686       assign
      687           p-out-string = "":U
      688           v-position   = 0
      689       .
      690       replace-cycle:
      691       do while yes
      692       on error undo, return error
      693       :
      694           assign
      695               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      696           .
      697           if v-last-position <= v-position
      698           then do:
      699               if v-position = 0
      700               then do:
      701                   assign
      702                       p-out-string = p-in-string
      703                   .
      704               end.
      705               else do:
      706                   assign
      707                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      708                   .
      709               end.
      710               leave replace-cycle.
      711           end.
      712           else do:
      713               assign
      714                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      715                   v-position      = v-last-position
      716                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      717               .
      718               if v-current-char = "#":U
      719               then do:
      720                   assign
      721                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      722                   .
      723                   if v-last-position > 0
      724                   then do:
      725                       run xmlchar-read-integer in this-procedure
      726                        (
      727                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      728                           , output v-temp-integer
      729                           , output v-success
      730                       ).
      731                       if v-success = yes
      732                       and v-temp-integer >= 1
      733                       and v-temp-integer <= 255
      734                       then do:
      735                           assign
      736                               p-out-string = p-out-string + chr( v-temp-integer )
      737                               v-position   = v-last-position + 1
      738                           .
      739                       end.
      740                       else do:
      741                           assign
      742                               p-out-string = p-out-string + "&":U
      743                               v-position   = v-position   + 1
      744                           .
      745                       end.
      746                   end.
      747                   else do:
      748                       assign
      749                           p-out-string = p-out-string + "&":U
      750                           v-position   = v-position   + 1
      751                       .
      752                   end.
      753               end.
      754               else do:
      755                   case substring( p-in-string, v-position + 1, 3 )
      756                   :
      757                       when "lt;":U
      758                       then do:
      759                           assign
      760                               p-out-string = p-out-string + "<":U
      761                               v-position   = v-position   + 3
      762                           .
      763                       end.
      764                       when "gt;":U
      765                       then do:
      766                           assign
      767                               p-out-string = p-out-string + ">":U
      768                               v-position   = v-position   + 3
      769                           .
      770                       end.
      771                       otherwise do:
      772                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      773                           then do:
      774                               assign
      775                                   p-out-string = p-out-string + "&":U
      776                                   v-position   = v-position   + 4
      777                               .
      778                           end.
      779                           else do:
      780                               case substring( p-in-string, v-position + 1, 5 )
      781                               :
      782                                   when "quot;":U
      783                                   then do:
      784                                       assign
      785                                           p-out-string = p-out-string + '"':U
      786                                           v-position   = v-position   + 5
      787                                       .
      788                                   end.
      789                                   when "apos;":U
      790                                   then do:
      791                                       assign
      792                                           p-out-string = p-out-string + "'":U
      793                                           v-position   = v-position   + 5
      794                                       .
      795                                   end.
      796                                   otherwise do:
      797                                       assign
      798                                           p-out-string = p-out-string + "&":U
      799                                       .
      800                                   end.
      801                               end case.
      802                           end.
      803                       end.
      804                   end case.
      805               end.
      806           end.
      807       end.
      808   end.
      809   end .
      810   procedure xmlchar-read-integer :
      811   define input parameter p-input-string      as character        no-undo.
      812   define output parameter p-output-integer   as integer          no-undo.
      813   define output parameter p-success       as logical          no-undo.
      814   do
      815   on error undo, return error
      816   :
      817       assign
      818           p-output-integer = integer( p-input-string )
      819       no-error.
      820       if error-status :error
      821       then do:
      822           assign
      823               p-success           = no
      824               p-output-integer    = 0
      825           .
      826       end.
      827       else do:
      828           assign
      829               p-success           = yes
      830           .
      831       end.
      832   end.
      833   end.
      834   define variable v-bgelib-bgeclall           as logical      no-undo.
      835   define variable v-bgelib-bgedict            as logical      no-undo.
      836   define temp-table temp_ext-doc-type no-undo
      837       field edt-key               as integer
      838       field ext-doc-type          as character
      839       field ext-doc-type-label    as character
      840       index pi is primary unique
      841           edt-key
      842   .
      843   define temp-table temp_bgelib_goods no-undo
      844       field gds-code as integer
      845       index pi is primary unique
      846           gds-code
      847   .
      848   define temp-table temp_bgelib_clients no-undo
      849       field obj-type as character
      850       field obj-code as integer
      851       index pi is primary unique
      852           obj-type
      853           obj-code
      854   .
      855   define temp-table temp_bgelib_dis-card no-undo
      856       field d-card as character
      857       index pi is primary unique
      858           d-card
      859   .
      860   define temp-table temp_bgelib_trn-doc no-undo
      861       field doc-code as integer
      862   .
      863   procedure bgelib-tag-open:
      864   do
      865   on error undo, return error
      866   :
      867   define input parameter v-tag-level  as integer      no-undo.
      868   define input parameter v-tag-name   as character    no-undo.
      869   define input parameter v-tag-value  as character    no-undo.
      870       put stream stmXMLOut unformatted
      871           chr(10)
      872           + fill(" ", 4 * v-tag-level)
      873           + "<" + v-tag-name
      874           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      875           + v-tag-value + ">"
      876       .
      877   end.
      878   end procedure.
      879   procedure bgelib-tag-put:
      880   do
      881   on error undo, return error
      882   :
      883   define input parameter v-tag-level      as integer      no-undo.
      884   define input parameter v-tag-name       as character    no-undo.
      885   define input parameter v-tag-value      as character    no-undo.
      886   define input parameter v-empty-mode     as integer      no-undo.
      887       v-tag-name = trim(v-tag-name).
      888       if  v-empty-mode = 1
      889       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      890       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      891       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      892       then do:
      893           run xmlchar-encode in this-procedure (
      894                 input v-tag-value
      895               , output v-tag-value
      896           ).
      897           put stream stmXMLOut unformatted
      898               chr(10) + fill(" ", 4 * v-tag-level)
      899                           + '<' + v-tag-name + '>'
      900                           + v-tag-value
      901                           + '</' + v-tag-name + '>'
      902           .
      903       end.
      904   end.
      905   end procedure.
      906   procedure bgelib-tag-close:
      907   do
      908   on error undo, return error
      909   :
      910   define input parameter v-tag-level as integer      no-undo.
      911   define input parameter v-tag-name  as character    no-undo.
      912       put stream stmXMLOut unformatted
      913           chr(10)
      914           + fill( " ", 4 * v-tag-level)
      915           + '</' + v-tag-name + '>'
      916       .
      917   end.
      918   end procedure.
      919   procedure bgelib-write-log:
      920   do
      921   on error undo, return error
      922   :
      923   define input parameter v-filename   as character    no-undo.
      924   define input parameter v-log-level  as integer      no-undo.
      925   define input parameter v-out-string as character    no-undo.
      926       output stream stmXMLLog to value( v-filename ) append.
      927       put stream stmXMLLog unformatted
      928           chr(10)
      929       .
      930       put stream stmXMLLog unformatted
      931           ( if v-log-level = 0
      932             or v-out-string = "&DLine"
      933             or v-out-string = "&Line"
      934             then ""
      935             else cur-time-string-sec() + " " )
      936       .
      937       put stream stmXMLLog unformatted
      938           ( if v-out-string = "&Line"
      939             then fill( "-", 80 )
      940             else if v-out-string = "&DLine"
      941                  then fill( "=", 80 )
      942                  else v-out-string )
      943       .
      944       output stream stmXMLLog close.
      945   end.
      946   end procedure.
      947   procedure bgelib-write-edt:
      948   do
      949   on error undo, return error
      950   :
      951   define input parameter v-editor-handle    as handle       no-undo.
      952   define input parameter v-log-level        as integer      no-undo.
      953   define input parameter v-out-string       as character    no-undo.
      954       if valid-handle ( v-editor-handle )
      955       then do:
      956           v-editor-handle :move-to-eof().
      957           v-editor-handle :insert-string( ( if v-log-level = 0
      958                                             or v-out-string = "&DLine"
      959                                             or v-out-string = "&Line"
      960                                             then ""
      961                                             else cur-time-string-sec() + " "
      962                                         ) ).
      963           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      964                                             then fill( "-", 80 )
      965                                             else if v-out-string = "&DLine" then fill("=", 80)
      966                                             else fill( " ", v-log-level) + v-out-string
      967                                         ) ).
      968           v-editor-handle :insert-string( chr(10) ).
      969       end.
      970       process events.
      971       output to 'bgescn.txt' append.
      972           put unformatted
      973               chr(10)
      974               string( ( if v-log-level = 0
      975                         or v-out-string = "&DLine"
      976                         or v-out-string = "&Line"
      977                         then ""
      978                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      979                     ) )
      980               string( ( if v-out-string = "&Line"
      981                         then fill( "-", 80 )
      982                         else if v-out-string = "&DLine"
      983                              then fill( "=", 80 )
      984                              else fill( " ", v-log-level ) + v-out-string
      985                     ) )
      986           .
      987       output close.
      988   end.
      989   end procedure.
      990   procedure bgelib-show-cnt:
      991   do
      992   on error undo, return error
      993   :
      994   define input parameter v-fillin-handle     as handle   no-undo.
      995       if valid-handle( v-fillin-handle )
      996       then do:
      997           assign
      998               v-fillin-handle :visible = true
      999           .
     1000       end.
     1001   end.
     1002   end procedure.
     1003   procedure bgelib-hide-cnt:
     1004   do
     1005   on error undo, return error
     1006   :
     1007   define input parameter v-fillin-handle     as handle   no-undo.
     1008       if valid-handle( v-fillin-handle )
     1009       then do:
     1010           assign v-fillin-handle :visible = false.
     1011       end.
     1012   end.
     1013   end procedure.
     1014   procedure bgelib-write-cnt:
     1015   do
     1016   on error undo, return error
     1017   :
     1018   define input parameter v-fillin-handle    as handle       no-undo.
     1019   define input parameter v-fillin-string    as character    no-undo.
     1020       if valid-handle( v-fillin-handle )
     1021       then do:
     1022           assign
     1023               v-fillin-handle :SCREEN-value = v-fillin-string
     1024           .
     1025       end.
     1026   end.
     1027   end procedure.
     1028   procedure bgelib-write-header:
     1029   do
     1030   on error undo, return error
     1031   :
     1032   define input parameter p-first-file     as logical      no-undo.
     1033   define input parameter p-xml-file-name  as character    no-undo.
     1034   define input parameter p-list-file-name as character    no-undo.
     1035   define input parameter p-file-number    as integer      no-undo.
     1036   define input parameter p-have-prev      as logical      no-undo.
     1037   define input parameter p-prev-filename  as character    no-undo.
     1038   define input parameter p-obj-list       as character    no-undo.
     1039   define input parameter p-doc-type-list  as character    no-undo.
     1040   define input parameter p-parameter-list as character    no-undo.
     1041       define variable v-counter    as integer        no-undo.
     1042       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1043       put stream stmXMLOut unformatted
     1044           "<?xml version='1.0' encoding='windows-1251'?>"
     1045       .
     1046       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1047       run bgelib-tag-open( input 0, input "header", input "" ).
     1048       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1049       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1050       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1051       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1052       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1053       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1054       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1055       :
     1056           run bgelib-tag-put(
     1057                 input 1
     1058               , input entry( 2 * v-counter, p-parameter-list )
     1059               , input entry( 2 * v-counter + 1, p-parameter-list )
     1060               , input 0
     1061           ).
     1062       end.
     1063       run bgelib-tag-close( input 0, input "header" ).
     1064       output stream stmXMLOut close.
     1065       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1066       if p-first-file = yes
     1067       then do:
     1068           put stream stmXMLOut unformatted
     1069               "<?xml version='1.0' encoding='windows-1251'?>"
     1070           .
     1071           run bgelib-tag-open( input 0, input "export", input "" ).
     1072       end.
     1073       run bgelib-tag-open( input 1, input "file", input "" ).
     1074       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1075       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1076       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1077       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1078       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1079       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1080       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1081       :
     1082           run bgelib-tag-put(
     1083                 input 2
     1084               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1085               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1086               , input 0
     1087           ).
     1088       end.
     1089       run bgelib-tag-close( input 1, input "file" ).
     1090       output stream stmXMLOut close.
     1091   end.
     1092   end procedure.
     1093   procedure bgelib-write-footer:
     1094   do
     1095   on error undo, return error
     1096   :
     1097   define input parameter p-last-file      as logical      no-undo.
     1098   define input parameter p-xml-file-name  as character    no-undo.
     1099   define input parameter p-list-file-name as character    no-undo.
     1100   define input parameter p-have-next      as logical      no-undo.
     1101   define input parameter p-next-file-name as character    no-undo.
     1102       define variable v-error-num     as integer           no-undo.
     1103       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1104       if p-have-next = yes
     1105       then do:
     1106           run bgelib-tag-open( input 0, input "footer", "" ).
     1107           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1108           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1109           run bgelib-tag-close( input 0, input "footer" ).
     1110       end.
     1111       run bgelib-tag-close( input 0, input "root" ).
     1112       output stream stmXMLOut close.
     1113       run bge/os_copy.p (
     1114             input "M"
     1115           , input p-xml-file-name + "tmp"
     1116           , input p-xml-file-name + "xml"
     1117           , output v-error-num
     1118       ).
     1119       if p-last-file = yes
     1120       then do:
     1121           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1122               run bgelib-tag-close( input 0, input "export" ).
     1123           output stream stmXMLOut close.
     1124           run bge/os_copy.p (
     1125                 input "M"
     1126               , input p-list-file-name + "tmp"
     1127               , input p-list-file-name + "xml"
     1128               , output v-error-num
     1129           ).
     1130       end.
     1131   end.
     1132   end procedure.
     1133   procedure bgelib-filename :
     1134   do
     1135   on error undo, return error
     1136   :
     1137   define input parameter p-prefix             as character    no-undo.
     1138   define output parameter p-xml-file-name     as character    no-undo.
     1139   define output parameter p-log-file-name     as character    no-undo.
     1140   define output parameter p-list-file-name    as character    no-undo.
     1141       define variable v-home-dir  as character    no-undo.
     1142       define variable v-error-num as integer      no-undo.
     1143       get-key-value section "BGE" key "outdir" value v-home-dir.
     1144       if v-home-dir = ?
     1145       then do:
     1146           message
     1147             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1148             skip(1)
     1149             skip "Обратитесь к администратору."
     1150           view-as alert-box error.
     1151           undo, return error .
     1152       end.
     1153       run gbl/dir-cre.p (
     1154           input v-home-dir
     1155       ) no-error.
     1156       if error-status :error
     1157       then do:
     1158           message
     1159             skip "Неверно задан каталог экспорта."
     1160             skip(1)
     1161             skip "Обратитесь к администратору."
     1162           view-as alert-box error.
     1163           undo, return error .
     1164       end.
     1165       run bge/genfname.p (
     1166             input v-home-dir
     1167           , input p-prefix
     1168           , input ""
     1169           , input "xml"
     1170           , input "tmp"
     1171           , output p-xml-file-name
     1172       ).
     1173       assign
     1174           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1175           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1176           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1177       .
     1178   end.
     1179   end procedure.
     1180   procedure bgelib-read-config :
     1181   do
     1182   on error undo, return error
     1183   :
     1184   define variable v-par-type as character     no-undo.
     1185     define variable v-param-type      as character  no-undo .
     1186     define variable v-value-character as character  no-undo .
     1187     define variable v-value-date      as date       no-undo .
     1188     define variable v-value-decimal   as decimal    no-undo .
     1189     define variable v-value-integer   as integer    no-undo .
     1190     define variable v-value-logical   as logical    no-undo .
     1191     define variable v-tth             as handle     no-undo .
     1192       assign
     1193           v-bgelib-bgeclall = no
     1194           v-bgelib-bgedict  = no
     1195       .
     1196       run adm/shattri.p ( input "get":U
     1197                         , input  '':u
     1198                         , input  0
     1199                         , input  'bge-export':U
     1200                         , input  'bgeclall':U
     1201                         , output v-value-character
     1202                         , output v-value-date
     1203                         , output v-value-decimal
     1204                         , output v-value-integer
     1205                         , output v-value-logical
     1206                         , output v-param-type
     1207                         , input-output table-handle v-tth
     1208                         ) no-error .
     1209       if error-status :error
     1210       then do:
     1211         assign
     1212           v-bgelib-bgeclall = no
     1213         .
     1214       end.
     1215       else do:
     1216         assign
     1217           v-bgelib-bgeclall = v-value-logical
     1218         .
     1219       end.
     1220       delete object v-tth.
     1221       run adm/shattri.p ( input "get":U
     1222                         , input  '':u
     1223                         , input  0
     1224                         , input  'bge-export':U
     1225                         , input  'bgedict':U
     1226                         , output v-value-character
     1227                         , output v-value-date
     1228                         , output v-value-decimal
     1229                         , output v-value-integer
     1230                         , output v-value-logical
     1231                         , output v-param-type
     1232                         , input-output table-handle v-tth
     1233                         ) no-error .
     1234       if error-status :error
     1235       then do:
     1236         assign
     1237           v-bgelib-bgedict = no
     1238         .
     1239       end.
     1240       else do:
     1241         assign
     1242           v-bgelib-bgedict = v-value-logical
     1243         .
     1244       end.
     1245       delete object v-tth.
     1246       run adm/shattri.p ( input "get":U
     1247                         , input  '':u
     1248                         , input  0
     1249                         , input  'bge-export':U
     1250                         , input  'bgefmt':U
     1251                         , output v-value-character
     1252                         , output v-value-date
     1253                         , output v-value-decimal
     1254                         , output v-value-integer
     1255                         , output v-value-logical
     1256                         , output v-param-type
     1257                         , input-output table-handle v-tth
     1258                         ) no-error .
     1259       if error-status :error
     1260       then do:
     1261         assign
     1262           v-bgelib-bgefmt  = "xml":U
     1263         .
     1264       end.
     1265       else do:
     1266         assign
     1267           v-bgelib-bgefmt  = v-value-character
     1268         .
     1269       end.
     1270       delete object v-tth.
     1271       run adm/shattri.p ( input "get":U
     1272                         , input  '':u
     1273                         , input  0
     1274                         , input  'bge-export':U
     1275                         , input  'bgeflold':U
     1276                         , output v-value-character
     1277                         , output v-value-date
     1278                         , output v-value-decimal
     1279                         , output v-value-integer
     1280                         , output v-value-logical
     1281                         , output v-param-type
     1282                         , input-output table-handle v-tth
     1283                         ) no-error .
     1284       if error-status :error
     1285       then do:
     1286         assign
     1287           v-bgelib-bgeflold  = "old":U
     1288         .
     1289       end.
     1290       else do:
     1291         assign
     1292           v-bgelib-bgeflold  = v-value-character
     1293         .
     1294       end.
     1295       delete object v-tth.
     1296   end.
     1297   end procedure.
     1298   procedure bgelib-check-file-size :
     1299   do
     1300   on error undo, return error
     1301   :
     1302   define input parameter p-out-filename   as character    no-undo.
     1303   define output parameter p-is-big        as logical      no-undo.
     1304       define variable v-current-position    as integer        no-undo.
     1305       assign
     1306           v-current-position = seek( stmXMLOut )
     1307       .
     1308       if v-current-position / 1024 / 1024  >= 100
     1309       then do:
     1310           assign
     1311               p-is-big = yes
     1312           .
     1313       end.
     1314   end.
     1315   end procedure.
     1316   procedure bgelib-init-ext-doc-type :
     1317       define variable v-counter    as integer      no-undo.
     1318       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1319   do
     1320   for buf_temp_ext-doc-type
     1321   on error undo, return error
     1322   :
     1323       empty temp-table buf_temp_ext-doc-type.
     1324       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1325       :
     1326           create buf_temp_ext-doc-type.
     1327           assign
     1328               buf_temp_ext-doc-type.edt-key               = v-counter
     1329               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1330               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1331           .
     1332       end.
     1333   end.
     1334   end procedure.
     1335   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   procedure factord :
     1337     define input  parameter p-fact-date            as date    no-undo .
     1338     define input  parameter p-fact-time            as integer no-undo .
     1339     define input  parameter p-fact-num             as integer no-undo .
     1340     define input  parameter p-shift-date           as date    no-undo .
     1341     define input  parameter p-shift-num            as integer no-undo .
     1342     define input  parameter p-shift-on             as logical no-undo .
     1343     define output parameter p-fact-order           as decimal no-undo .
     1344     define output parameter p-shift-end-fact-order as decimal no-undo .
     1345     define output parameter p-day-end-fact-order   as decimal no-undo .
     1346     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1347     if p-fact-date = ?
     1348     then do:
     1349       return error "Не указана фактическая дата" .
     1350     end.
     1351     define variable v-fact-date-num as integer no-undo .
     1352     assign
     1353       v-fact-date-num = integer(p-fact-date)
     1354     .
     1355     if p-fact-num = ?
     1356     or p-fact-num = 0
     1357     then do:
     1358       return error "Не задан p-fact-num " + string(p-fact-num) .
     1359     end.
     1360     if p-fact-num < 0
     1361     then do:
     1362       return error "Отрицательный fact-num " + string(p-fact-num) .
     1363     end.
     1364     if p-fact-num >= 100000000
     1365     then do:
     1366       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1367     end.
     1368     if p-shift-on = true
     1369     then do:
     1370       if p-shift-date = ?
     1371       then do:
     1372         return error "Не задана дата смены" .
     1373       end.
     1374       if p-shift-num = ?
     1375       or p-shift-num = 0
     1376       then do:
     1377         return error "Не задан номер смены" .
     1378       end.
     1379     end.
     1380     else do:
     1381       assign
     1382         p-shift-date = p-fact-date
     1383         p-shift-num  = 24
     1384       .
     1385     end.
     1386     define variable v-shift-offset as integer no-undo .
     1387     if p-shift-date = p-fact-date
     1388     then do:
     1389       assign
     1390         v-shift-offset = 1
     1391       .
     1392     end.
     1393     if p-shift-date < p-fact-date
     1394     then do:
     1395       assign
     1396         v-shift-offset = 0
     1397       .
     1398     end.
     1399     if p-shift-date > p-fact-date
     1400     then do:
     1401       message
     1402         vss-workfile vss-revision vss-description skip
     1403         "Неправильная дата закрытия смены" skip
     1404         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1405         view-as alert-box error .
     1406       undo, return error
     1407         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1408           ,string(p-fact-date, '99/99/9999':U)
     1409           ,string(p-shift-date, '99/99/9999':U)
     1410           )
     1411       .
     1412     end.
     1413     if p-shift-num < 1
     1414     or p-shift-num > 24
     1415     then do:
     1416       message
     1417         vss-workfile vss-revision vss-description skip
     1418         "Неправильный номер смены" skip
     1419         "p-shift-num" p-shift-num skip
     1420         view-as alert-box error .
     1421       undo, return error return-value .
     1422     end.
     1423     assign
     1424       p-fact-order           = v-fact-date-num
     1425                              + v-shift-offset * 0.5
     1426                              + p-shift-num    * 0.02 - 0.01
     1427                              + p-fact-num     * 0.0000000001
     1428       p-shift-end-fact-order = v-fact-date-num
     1429                              + v-shift-offset * 0.5
     1430                              + p-shift-num    * 0.02
     1431       p-day-end-fact-order   = v-fact-date-num
     1432                              + 0.99
     1433     .
     1434     if p-fact-order           <= v-fact-date-num
     1435     or p-shift-end-fact-order <= v-fact-date-num
     1436     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1437     or p-shift-end-fact-order >= p-day-end-fact-order
     1438     then do:
     1439       message
     1440         vss-workfile vss-revision vss-description skip
     1441         "Внутренняя ошибка при генерации фактического номера" skip
     1442         "p-fact-date"            p-fact-date            skip
     1443         "p-fact-time"            p-fact-time            skip
     1444         "p-fact-num"             p-fact-num             skip
     1445         "p-shift-date"           p-shift-date           skip
     1446         "p-shift-num"            p-shift-num            skip
     1447         "p-shift-on"             p-shift-on             skip
     1448         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1449         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1450         "v-fact-date-num"        v-fact-date-num        skip
     1451         view-as alert-box error .
     1452       undo, return error return-value .
     1453     end.
     1454   end procedure.
     1455   procedure day-begin-fact-order :
     1456     define input  parameter p-fact-date            as date    no-undo .
     1457     define output parameter p-day-begin-fact-order as decimal no-undo .
     1458     do
     1459     on error undo, return error return-value
     1460     :
     1461       if p-fact-date = ?
     1462       then do:
     1463         assign
     1464           p-day-begin-fact-order = 0
     1465         .
     1466       end.
     1467       else do:
     1468         assign
     1469           p-day-begin-fact-order = integer(p-fact-date)
     1470         .
     1471       end.
     1472     end.
     1473   end procedure.
     1474   procedure factord-max-fact-order :
     1475     define output parameter p-max-fact-order as decimal   no-undo .
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479       run day-begin-fact-order in this-procedure
     1480         (input  date(1, 1, 5000)
     1481         ,output p-max-fact-order
     1482         ) .
     1483     end.
     1484   end procedure.
     1485   procedure factord-cut-archive :
     1486     define input  parameter p-obj-type             as character no-undo .
     1487     define input  parameter p-obj-code             as integer   no-undo .
     1488     define input  parameter p-fact-date            as date      no-undo .
     1489     define output parameter p-shift-on             as logical   no-undo .
     1490     define output parameter p-shift-date           as date      no-undo .
     1491     define output parameter p-shift-num            as integer   no-undo .
     1492     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1493     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1494     define variable v-fact-order as decimal   no-undo .
     1495     define buffer buf_shift-obj for ub.shift-obj .
     1496     do
     1497     on error undo, return error return-value
     1498     :
     1499   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1501     (input  p-obj-type
     1502     ,input  p-obj-code
     1503     ,input  'shift-on=request'
     1504     ,output p-shift-on
     1505     ) no-error .
     1506       if error-status :error
     1507       then do:
     1508         message
     1509           vss-workfile vss-revision vss-description skip
     1510           "Ошибка при определении атрибута объекта" skip
     1511           "Объект" p-obj-type p-obj-code skip
     1512           error-status :get-message(1) skip
     1513           return-value skip
     1514           view-as alert-box error .
     1515         undo, return error return-value .
     1516       end.
     1517       if p-shift-on = false
     1518       then do:
     1519         assign
     1520           p-shift-date               = ?
     1521           p-shift-num                = 0
     1522         .
     1523       end.
     1524       else do:
     1525         find first buf_shift-obj share-lock
     1526           where buf_shift-obj.obj-type   = p-obj-type
     1527             and buf_shift-obj.obj-code   = p-obj-code
     1528             and buf_shift-obj.shift-date > p-fact-date
     1529           use-index pi
     1530           no-error .
     1531         if not available buf_shift-obj
     1532         or buf_shift-obj.status_ <> 'зкр':U
     1533         then do:
     1534           message
     1535             vss-workfile vss-revision vss-description skip
     1536             "Невозможно вычислить последнюю смену" skip
     1537             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1538             "Объект" p-obj-type p-obj-code skip
     1539             "Дата" p-fact-date skip
     1540             view-as alert-box error .
     1541           undo, return error return-value .
     1542         end.
     1543         find last buf_shift-obj share-lock
     1544           where buf_shift-obj.obj-type = p-obj-type
     1545             and buf_shift-obj.obj-code = p-obj-code
     1546             and buf_shift-obj.shift-date <= p-fact-date
     1547           use-index pi
     1548           no-error .
     1549         if available buf_shift-obj
     1550         then do:
     1551           if  buf_shift-obj.status_ = 'зкр':U
     1552           then do:
     1553             assign
     1554               p-shift-date = buf_shift-obj.shift-date
     1555               p-shift-num  = buf_shift-obj.shift-num
     1556             .
     1557           end.
     1558           else do:
     1559             message
     1560               vss-workfile vss-revision vss-description skip
     1561               "Невозможно вычислить последнюю смену" skip
     1562               "Статус смены отличен от статуса" 'зкр':U skip
     1563               "Объект" p-obj-type p-obj-code skip
     1564               "Дата" p-fact-date skip
     1565               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1566               view-as alert-box error .
     1567             undo, return error return-value .
     1568           end.
     1569         end.
     1570         else do:
     1571           assign
     1572             p-shift-date = p-fact-date - 1
     1573             p-shift-num  = 1
     1574           .
     1575         end.
     1576       end.
     1577       run factord in this-procedure
     1578         (input  p-fact-date
     1579         ,input  1
     1580         ,input  1
     1581         ,input  p-shift-date
     1582         ,input  p-shift-num
     1583         ,input  p-shift-on
     1584         ,output v-fact-order
     1585         ,output p-shift-end-fact-order
     1586         ,output p-day-end-fact-order
     1587         ) no-error .
     1588       if error-status :error
     1589       then do:
     1590         message
     1591           vss-workfile vss-revision vss-description skip
     1592           "Ошибка при вызове процедуры factord"
     1593           error-status :get-message(1) skip
     1594           return-value skip
     1595           view-as alert-box error .
     1596         undo, return error return-value .
     1597       end.
     1598     end.
     1599   end procedure.
     1600   procedure factord-lock-shift :
     1601     define input  parameter p-obj-type  as character no-undo .
     1602     define input  parameter p-obj-code  as integer   no-undo .
     1603     define input  parameter p-fact-date as date      no-undo .
     1604     define parameter buffer buf_shift-obj for ub.shift-obj .
     1605     define variable v-shift-on      as logical   no-undo .
     1606     define variable v-extra-message as character no-undo .
     1607     define variable v-error as character no-undo .
     1608     do
     1609     on error undo, return error return-value
     1610     :
     1611   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1613     (input  p-obj-type
     1614     ,input  p-obj-code
     1615     ,input  'shift-on=request'
     1616     ,output v-shift-on
     1617     ) no-error .
     1618       if error-status :error
     1619       then do:
     1620         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1621         undo, return error v-error .
     1622       end.
     1623       if v-shift-on = true
     1624       then do:
     1625         find first buf_shift-obj share-lock
     1626           where buf_shift-obj.obj-type   = p-obj-type
     1627             and buf_shift-obj.obj-code   = p-obj-code
     1628             and buf_shift-obj.shift-date > p-fact-date
     1629           use-index pi
     1630           no-error .
     1631         if not available buf_shift-obj
     1632         or buf_shift-obj.status_ <> 'зкр':U
     1633         then do:
     1634           find last buf_shift-obj
     1635             where buf_shift-obj.obj-type = p-obj-type
     1636               and buf_shift-obj.obj-code = p-obj-code
     1637               and buf_shift-obj.status_  = 'зкр':U
     1638             use-index stts
     1639             no-error .
     1640           if available buf_shift-obj
     1641           then do:
     1642             assign
     1643               v-extra-message =
     1644                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1645                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1646                               )
     1647             .
     1648           end.
     1649           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1650           undo, return error v-error .
     1651         end.
     1652       end.
     1653     end.
     1654   end procedure.
     1655   procedure factord-end-day :
     1656     define input  parameter p-fact-date            as date    no-undo .
     1657     define output parameter p-day-end-fact-order   as decimal no-undo .
     1658     do
     1659     on error undo, return error return-value
     1660     :
     1661       if p-fact-date = ?
     1662       then do:
     1663         return error "Не указана фактическая дата" .
     1664       end.
     1665       assign
     1666         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1667       .
     1668     end.
     1669   end procedure.
     1670   procedure factord-to-date :
     1671     define input  parameter p-fact-order as decimal no-undo .
     1672     define output parameter p-fact-date  as date    no-undo .
     1673     define variable v-ref-date  as date      no-undo .
     1674     define variable v-ref-delta as integer   no-undo .
     1675     do
     1676     on error undo, return error return-value
     1677     :
     1678       if p-fact-order = ?
     1679       or p-fact-order = 0
     1680       then do:
     1681         return error "Не указан fact-order" .
     1682       end.
     1683       assign
     1684         v-ref-date  = date(1, 1, 2000)
     1685       .
     1686       assign
     1687         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1688       .
     1689       assign
     1690         p-fact-date = v-ref-date + v-ref-delta
     1691       .
     1692     end.
     1693   end procedure.
     1694   procedure factord-to-fact-num :
     1695     define input  parameter p-fact-order as decimal no-undo .
     1696     define output parameter p-fact-num   as integer no-undo .
     1697     define variable v-fact-order-trunc as decimal no-undo .
     1698     do
     1699     on error undo, return error return-value
     1700     :
     1701       if p-fact-order = ?
     1702       or p-fact-order = 0
     1703       then do:
     1704         return error "Не указан fact-order" .
     1705       end.
     1706       assign
     1707        v-fact-order-trunc = truncate(p-fact-order, 2)
     1708       .
     1709       assign
     1710         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1711       .
     1712     end.
     1713   end procedure.
     1714   procedure factord-to-shift-num :
     1715     define input  parameter p-fact-order as decimal no-undo .
     1716     define output parameter p-shift-num   as integer no-undo .
     1717     define variable  p-shift-numd  as decimal   no-undo .
     1718     define variable v-fact-order-trunc as decimal no-undo .
     1719     do
     1720     on error undo, return error return-value
     1721     :
     1722       if p-fact-order = ?
     1723       or p-fact-order = 0
     1724       then do:
     1725         return error "Не указан fact-order" .
     1726       end.
     1727       assign
     1728        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1729       .
     1730       if v-fact-order-trunc < 0.5 then do:
     1731         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1732       end.
     1733       assign
     1734         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1735         .
     1736        assign
     1737         p-shift-num = truncate (p-shift-numd , 0)
     1738       .
     1739     end.
     1740   end procedure.
     1741   do
     1742   on error undo, return error
     1743   :
     1744     define variable g#db-num as integer   no-undo .
     1745     run get-db-num  in parParentProc ( output g#db-num ).
     1746       define variable v-xml-file-name     as character            no-undo.
     1747       define variable v-log-file-name     as character            no-undo.
     1748       define variable v-list-file-name    as character            no-undo.
     1749       define variable v-xml-file-number   as integer              no-undo.
     1750       define variable v-log-string        as character            no-undo.
     1751       define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     1752       define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     1753       define variable v-docs-exists       as logical              no-undo.
     1754       define variable v-obj-counter       as integer              no-undo.
     1755       define variable v-db-num            as integer              no-undo.
     1756       define variable v-cancel            as logical              no-undo.
     1757       define variable v-space-available   as logical              no-undo.
     1758       define variable v-parameter-list    as character            no-undo.
     1759       define variable v-obj-type as character no-undo .
     1760       define variable v-obj-code as integer   no-undo .
     1761       define variable v-host-code as integer   no-undo .
     1762       define variable v-host-str  as character no-undo init "" .
     1763       run init-temphost.
     1764       assign v-log-string = " по всем фирмам" .
     1765       case p-range:
     1766         when 2 then do:
     1767           for each temp-host :
     1768             delete temp-host.
     1769           end.
     1770           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2  :
     1771             create temp-host.
     1772             assign temp-host.host-code = integer( entry( v-obj-counter * 2, p-obj-list ) ) no-error .
     1773             if error-status :error then do:
     1774               message
     1775                 vss-workfile vss-revision vss-description skip "Ошибка чтения списка фирм" skip return-value
     1776                 skip trim(error-status :get-message(1)) trim(error-status :get-message(2)) trim(error-status :get-message(3))
     1777               view-as alert-box error.
     1778               undo, return error .
     1779             end.
     1780           end.
     1781           assign v-log-string = " по фирмам: " + p-obj-list .
     1782       end.
     1783       when 3 then do:
     1784         for each temp-host :
     1785           delete temp-host.
     1786         end.
     1787         do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2 :
     1788           v-obj-type = entry( (v-obj-counter * 2 ) - 1 , p-obj-list )     .
     1789           v-obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )  .
     1790   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1792     (input  v-obj-type
     1793     ,input  v-obj-code
     1794     ,output v-host-code
     1795     )  .
     1796           if not can-find ( first temp-host where temp-host.host-code = v-host-code) then do:
     1797             v-host-str = v-host-str + "," + string(v-host-code).
     1798             create temp-host.
     1799             assign temp-host.host-code = v-host-code no-error .
     1800             if error-status :error  then do:
     1801               message
     1802                 vss-workfile vss-revision vss-description skip "Ошибка чтения списка фирм" skip return-value
     1803                 skip trim(error-status :get-message(1)) trim(error-status :get-message(2)) trim(error-status :get-message(3))
     1804               view-as alert-box error.
     1805               undo, return error .
     1806             end.
     1807           end.
     1808         end.
     1809         assign v-log-string = " по фирмам: " + v-host-str .
     1810       end.
     1811     end case.
     1812     run bgelib-filename in this-procedure ( input "s-f", output v-xml-file-name, output v-log-file-name, output v-list-file-name ).
     1813     run gbl/waitfrsp.w ( input substring( v-xml-file-name, 1, 1 ), input 200, output v-cancel ) .
     1814     if v-cancel = yes then undo, return error .
     1815     run bgelib-write-log in this-procedure ( input v-log-file-name, input 1, input "&DLine" ).
     1816     run bgelib-write-log in this-procedure ( input v-log-file-name, input 1, input substitute( "Начало выгрузки в файл &1"
     1817                                   , replace( v-xml-file-name, "/", "\" ) + "tmp" ) ).
     1818     run bgelib-write-log in this-procedure ( input v-log-file-name, input 1,
     1819             input substitute( "................с параметрами: Дата с: &1, дата по: &2", p-date-from, p-date-to ) ).
     1820     run bgelib-write-log in this-procedure ( input v-log-file-name, input 1,
     1821             input substitute( "................с параметрами: ... &1: &2",v-log-string )).
     1822     assign
     1823       v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1824                                                  , 7
     1825                                                  , "docName"          , "schet-fact":U
     1826                                                  , "version"          , replace("15.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1827                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1828                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1829                                                 )
     1830                                     + substitute( ",&1,&2,&3,&4,&5,&6"
     1831                                                  , "baseNum"          , g#db-num
     1832                                                  , "dateFrom"         , string( p-date-from,    "99/99/9999" )
     1833                                                  , "dateto"           , string( p-date-to,      "99/99/9999" )
     1834                                                 ) .
     1835       run bgelib-write-header in this-procedure (
     1836             input yes
     1837           , input v-xml-file-name
     1838           , input v-list-file-name
     1839           , input 1
     1840           , input no
     1841           , input ""
     1842           , input p-obj-list
     1843           , input ""
     1844           , input v-parameter-list
     1845       ).
     1846   object-of-list:
     1847       for each temp-host :
     1848         run export-docs-by-host (input temp-host.host-code, input v-xml-file-name, input v-log-file-name, input v-list-file-name
     1849               , input v-xml-file-number, output v-xml-file-name, output v-xml-file-number ) no-error.
     1850         if error-status :error then do:
     1851           message
     1852             vss-workfile vss-revision vss-description skip "Ошибка экспорта счетов-фактур по фирме"
     1853             skip "Код фирмы:" temp-host.host-code  skip return-value
     1854             skip trim(error-status :get-message(1)) trim(error-status :get-message(2)) trim(error-status :get-message(3))
     1855           view-as alert-box error.
     1856           next object-of-list.
     1857         end.
     1858       end.
     1859       run bgelib-write-footer in this-procedure ( input yes, input v-xml-file-name, input v-list-file-name, input no, input "" ).
     1860       run bgelib-write-log in this-procedure ( input v-log-file-name, input 1
     1861           , input substitute( "Данные выгружены в файл &1", replace( v-xml-file-name, "/", "\" ) + "xml" ) ).
     1862       run bgelib-write-log in this-procedure ( input v-log-file-name, input 1, input "&DLine" ).
     1863   end.
     1864   procedure export-docs-by-host :
     1865     do on error undo, return error :
     1866       define input parameter p-host-code              as integer      no-undo.
     1867       define input parameter p-xml-file-name          as character    no-undo.
     1868       define input parameter p-log-file-name          as character    no-undo.
     1869       define input parameter p-list-file-name         as character    no-undo.
     1870       define input parameter p-xml-file-number        as integer      no-undo.
     1871       define output parameter p-new-xml-file-name     as character    no-undo.
     1872       define output parameter p-new-xml-file-number   as integer      no-undo.
     1873       define buffer buf_schet-fact-doc  for ub.schet-fact-doc.
     1874       define buffer buf_schet-fact-line for ub.schet-fact-line.
     1875       assign
     1876         p-new-xml-file-name     = p-xml-file-name
     1877         p-new-xml-file-number   = p-xml-file-number
     1878       .
     1879       run bgelib-write-edt( hEDT, 1, string("Фирма :") + string( p-host-code ) ).
     1880       run day-begin-fact-order in this-procedure ( input  p-date-from, output v-fact-order-from ) no-error .
     1881       run factord-end-day      in this-procedure ( input  p-date-to  ,output v-fact-order-to    ) no-error .
     1882       find first buf_schet-fact-doc no-lock
     1883         where buf_schet-fact-doc.host-code = p-host-code
     1884           AND buf_schet-fact-doc.fact-order >= v-fact-order-from
     1885           AND buf_schet-fact-doc.fact-order <= v-fact-order-to
     1886           AND buf_schet-fact-doc.status_ = 'факт':U
     1887       no-error .
     1888       if not available buf_schet-fact-doc then do:
     1889         run bgelib-write-edt( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     1890         return .
     1891       end.
     1892       run bgelib-show-cnt(hCNT).
     1893       run bge/sfdocop.p (
     1894                     input parparentproc
     1895                   , input p-host-code
     1896                   , input "Выгрузка счетов-фактур"
     1897                   , input v-fact-order-from
     1898                   , input v-fact-order-to
     1899                   , input p-obj-list
     1900                   , input v-parameter-list
     1901                   , input p-xml-file-name
     1902                   , input p-log-file-name
     1903                   , input p-list-file-name
     1904                   , input p-xml-file-number
     1905                   , input hEDT
     1906                   , input hCNT
     1907                   , output p-new-xml-file-name
     1908                   , output p-new-xml-file-number
     1909               ) no-error.
     1910       if error-status :error then run bgelib-write-edt( hEDT, 1, string(return-value)).
     1911       assign
     1912         p-xml-file-name     = p-new-xml-file-name
     1913         p-xml-file-number   = p-new-xml-file-number
     1914       .
     1915       run bgelib-show-cnt(hCNT).
     1916     end.
     1917   end procedure.
