      399   procedure xmlchar-test :
      400   define input parameter p-in-string          as character        no-undo.
      401   define output parameter p-out-string-enc    as character        no-undo.
      402   define output parameter p-out-string-dec    as character        no-undo.
      403   do
      404   on error undo, return error
      405   :
      406          run xmlchar-encode in this-procedure
      407       (
      408             input p-in-string
      409           , output p-out-string-enc
      410       ).
      411          run xmlchar-decode in this-procedure
      412       (
      413             input p-out-string-enc
      414           , output p-out-string-dec
      415       ).
      416   end.
      417   end .
      418   procedure xmlchar-encode :
      419   define input parameter p-in-string      as character        no-undo.
      420   define output parameter p-out-string    as character        no-undo.
      421       define variable v-position      as integer      no-undo.
      422       define variable v-current-char  as character    no-undo.
      423   do
      424   on error undo, return error
      425   :
      426       assign
      427           p-out-string = "":U
      428       .
      429       case p-in-string
      430       :
      431           when ?
      432           then do:
      433               assign
      434                   p-out-string = "?":U
      435               .
      436           end.
      437           when "?":U
      438           then do:
      439               assign
      440                   p-out-string = "&#63;":U
      441               .
      442           end.
      443           otherwise do:
      444               do v-position = 1 to length( p-in-string )
      445               :
      446                   assign
      447                       v-current-char = substring( p-in-string, v-position, 1 )
      448                   .
      449                   case v-current-char
      450                   :
      451                       when "&":U
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "&amp;":U
      455                           .
      456                       end.
      457                       when ">":U
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&gt;":U
      461                           .
      462                       end.
      463                       when "<":U
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "&lt;":U
      467                           .
      468                       end.
      469                       when "'":U
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "&apos;":U
      473                           .
      474                       end.
      475                       when '"':U
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "&quot;":U
      479                           .
      480                       end.
      481                       when chr(1)
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "":U
      485                           .
      486                       end.
      487                       when chr(2)
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "":U
      491                           .
      492                       end.
      493                       when chr(3)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(4)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(5)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(6)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(7)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(8)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "":U
      527                           .
      528                       end.
      529                       when chr(9)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "":U
      533                           .
      534                       end.
      535                       when chr(29)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + "":U
      539                           .
      540                       end.
      541                       when chr(10)
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + "&#10;":U
      545                           .
      546                       end.
      547                       when chr(13)
      548                       then do:
      549                           assign
      550                               p-out-string = p-out-string + "&#13;":U
      551                           .
      552                       end.
      553                       otherwise do:
      554                           assign
      555                               p-out-string = p-out-string + v-current-char
      556                           .
      557                       end.
      558                   end case.
      559               end.
      560           end.
      561       end case.
      562   end.
      563   end .
      564   procedure xmlchar-encode-1c :
      565   define input parameter p-in-string      as character        no-undo.
      566   define output parameter p-out-string    as character        no-undo.
      567       define variable v-position      as integer      no-undo.
