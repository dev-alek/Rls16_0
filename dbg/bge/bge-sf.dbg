      172   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   procedure cur-time :
      174      define output parameter p-today as date      no-undo .
      175      define output parameter p-time  as integer   no-undo .
      176     do
      177     on error undo, return error
      178     :
      179       define variable v-date1 as date      no-undo .
      180       define variable v-date2 as date      no-undo .
      181       define variable v-time  as integer   no-undo .
      182       assign
      183         v-date1 = today
      184         v-time  = time
      185         v-date2 = today
      186       .
      187       if v-date1 <> v-date2
      188       then do:
      189         assign
      190           v-date1 = today
      191           v-time  = v-time
      192         .
      193       end.
      194       assign
      195         p-today = v-date1
      196         p-time  = v-time
      197       .
      198     end.
      199   end.
      200   function cur-time-date returns character
      201   :
      202     return string(today, '99/99/9999':U) .
      203   end.
      204   function cur-time-mjd returns decimal
      205   :
      206     define variable v-date as date      no-undo .
      207     define variable v-time as integer   no-undo .
      208     run cur-time in this-procedure
      209       (output v-date
      210       ,output v-time
      211       ) .
      212     return integer(v-date) - 2400002 + (v-time / 86400) .
      213   end.
      214   function cur-time-get-ending-index returns integer
      215   (input p-number as integer
      216   )
      217   :
      218     if p-number < 0
      219     or p-number = ?
      220     then do:
      221       return 1 .
      222     end.
      223     define variable v-rest as integer   no-undo .
      224     assign
      225       p-number = p-number modulo 100
      226     .
      227     if p-number < 20
      228     then do:
      229       assign
      230         v-rest = p-number
      231       .
      232     end.
      233     else do:
      234       assign
      235         v-rest = p-number modulo 10
      236       .
      237     end.
      238     case v-rest :
      239       when 1
      240       then do:
      241         return 2 .
      242       end.
      243       when 2 or
      244       when 3 or
      245       when 4
      246       then do:
      247         return 3 .
      248       end.
      249       otherwise do:
      250         return 1 .
      251       end.
      252     end case .
      253   end.
      254   procedure cur-time-mjd-to-date :
      255      define input  parameter i-mjd-diff as decimal no-undo.
      256      define output parameter o-Date     as date    no-undo.
      257      define output parameter o-Time     as integer no-undo.
      258      define variable v-day-number as integer   no-undo .
      259      if    i-mjd-diff < 0
      260         or i-mjd-diff = ?
      261      then do:
      262         return "?" .
      263      end.
      264      assign
      265         v-day-number = truncate(i-mjd-diff,0).
      266         o-Date = date(v-day-number + 2400002).
      267         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      268     .
      269   end.
      270   function cur-time-mjd-to-string returns character
      271   (input p-mjd-diff as decimal
      272   )
      273   :
      274     define variable v-day-number as integer   no-undo .
      275     define variable v-seconds    as integer   no-undo .
      276     define variable v-hour       as integer   no-undo .
      277     define variable v-min        as integer   no-undo .
      278     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      279     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      280     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      281     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      282     if p-mjd-diff < 0
      283     or p-mjd-diff = ?
      284     then do:
      285       return "?" .
      286     end.
      287     assign
      288       v-day-number = integer(truncate(p-mjd-diff,0))
      289       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      290     .
      291     if v-seconds > 86400
      292     then do:
      293       assign
      294         v-seconds = 86400 - 1
      295       .
      296     end.
      297     if v-seconds < 0
      298     then do:
      299       assign
      300         v-seconds = 0
      301       .
      302     end.
      303     assign
      304       v-hour = truncate(v-seconds / 3600, 0)
      305     .
      306     assign
      307       v-seconds = v-seconds modulo 3600
      308     .
      309     assign
      310       v-min = truncate(v-seconds / 60, 0)
      311     .
      312     assign
      313       v-seconds = v-seconds modulo 60
      314     .
      315     return
      316         (if v-day-number <> 0
      317           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      318           else ""
      319         )
      320       + (if v-day-number <> 0 or v-hour <> 0
      321           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      322           else ""
      323         )
      324       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      325           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      326           else ""
      327         )
      328       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      329       .
      330   end.
      331   function cur-time-string returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-string-sec returns character
      342   :
      343     define variable v-date as date      no-undo .
      344     define variable v-time as integer   no-undo .
      345     run cur-time in this-procedure
      346       (output v-date
      347       ,output v-time
      348       ) .
      349     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      350   end.
      351   function cur-time-custom  returns character
      352   (input p-prefix as character
      353   ,input p-date-format as character
      354   ,input p-delimiter as character
      355   ,input p-time-format as character
      356   ,input p-suffix as character
      357   )
      358   :
      359     define variable v-date as date      no-undo .
      360     define variable v-time as integer   no-undo .
      361     run cur-time in this-procedure
      362       (output v-date
      363       ,output v-time
      364       ) .
      365     return
      366       p-prefix
      367       + string(v-date, p-date-format)
      368       + p-delimiter
      369       + string(v-time, p-time-format)
      370       + p-suffix
      371       .
      372   end.
      373   function cur-time-print  returns character
      374   :
      375     define variable v-date as date      no-undo .
      376     define variable v-time as integer   no-undo .
      377     run cur-time in this-procedure
      378       (output v-date
      379       ,output v-time
      380       ) .
      381     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      382   end.
      383   function cur-time-datetime returns datetime
      384   :
      385     define variable v-char as character no-undo .
      386     define variable v-datetime as datetime no-undo .
      387     v-char = cur-time-string().
      388     v-datetime = datetime(v-char).
      389     return  v-datetime.
      390   end.
      391   function cur-time-string-msec returns character
      392   :
      393     define variable v-date as datetime  no-undo .
      394     v-date = now.
      395     return string(v-date) .
      396   end.
