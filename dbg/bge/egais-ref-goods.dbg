     2803       do with frame Dialog-Frame
     2804       :
     2805         hide v-diasize-resize-button .
     2806         v-diasize-resize-button :row = 1.
     2807         v-diasize-resize-button :column = 1.
     2808       end.
     2809       if p-change-value > 0
     2810       then do:
     2811         if frame Dialog-Frame :scrollable = true
     2812         then do:
     2813           assign
     2814             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2815             no-error .
     2816           if error-status :error
     2817           or error-status :get-message(1) <> ""
     2818           then do:
     2819             undo move_block, retry move_block.
     2820           end.
     2821         end.
     2822         assign
     2823           frame Dialog-Frame :width = v-frame-width + p-change-value
     2824           no-error .
     2825         if error-status :error
     2826         or error-status :get-message(1) <> ""
     2827         then do:
     2828           undo move_block, retry move_block.
     2829         end.
     2830         assign
     2831           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2832         no-error .
     2833         if error-status :error
     2834         or error-status :get-message(1) <> ""
     2835         then do:
     2836           undo move_block, retry move_block.
     2837         end.
     2838         for each buf_temp-browse-handle
     2839           where buf_temp-browse-handle.browse-type = 'width':u
     2840         on error undo move_block, retry move_block
     2841         :
     2842           assign
     2843             buf_temp-browse-handle.browse-handle :width
     2844               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2845             no-error .
     2846           if error-status :error
     2847           or error-status :get-message(1) <> ""
     2848           then do:
     2849             undo move_block, retry move_block .
     2850           end.
     2851         end.
     2852         for each buf_temp-diasize-handle
     2853         on error undo move_block, retry move_block
     2854         :
     2855           assign
     2856             v-object-handle = buf_temp-diasize-handle.handle-value
     2857           .
     2858           if v-object-handle <> v-diasize-resize-button
     2859           then do:
     2860             assign
     2861               v-object-handle :col = v-object-handle :col + p-change-value
     2862               no-error .
     2863             if error-status :error
     2864             or error-status :get-message(1) <> ""
     2865             then do:
     2866               undo move_block, retry move_block .
     2867             end.
     2868           end.
     2869         end.
     2870       end.
     2871       else do:
     2872         for each buf_temp-diasize-handle
     2873         on error undo move_block, retry move_block
     2874         :
     2875           assign
     2876             v-object-handle = buf_temp-diasize-handle.handle-value
     2877           .
     2878           if v-object-handle <> v-diasize-resize-button
     2879           then do:
     2880             assign
     2881               v-object-handle :col = v-object-handle :col + p-change-value
     2882               no-error .
     2883             if error-status :error
     2884             or error-status :get-message(1) <> ""
     2885             then do:
     2886               undo move_block, retry move_block .
     2887             end.
     2888           end.
     2889         end.
     2890         for each buf_temp-browse-handle
     2891           where buf_temp-browse-handle.browse-type = 'width':u
     2892         on error undo move_block, retry move_block
     2893         :
     2894           assign
     2895             buf_temp-browse-handle.browse-handle :width
     2896               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2897             no-error .
     2898           if error-status :error
     2899           or error-status :get-message(1) <> ""
     2900           then do:
     2901             undo move_block, retry move_block .
     2902           end.
     2903         end.
     2904         assign
     2905           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2906           no-error .
     2907         if error-status :error
     2908         or error-status :get-message(1) <> ""
     2909         then do:
     2910           undo move_block, retry move_block.
     2911         end.
     2912         assign
     2913           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2914         no-error .
     2915         if error-status :error
     2916         or error-status :get-message(1) <> ""
     2917         then do:
     2918           undo move_block, retry move_block.
     2919         end.
     2920         if frame Dialog-Frame :scrollable = true
     2921         then do:
     2922           assign
     2923             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2924           no-error .
     2925           if error-status :error
     2926           or error-status :get-message(1) <> ""
     2927           then do:
     2928             undo move_block, retry move_block.
     2929           end.
     2930         end.
     2931       end.
     2932       if p-move-resize
     2933       then do:
     2934         run diasize_position-resize-button in this-procedure .
     2935       end.
     2936       if v-diasize-wndstore = true
     2937       then do:
     2938         if connected("ub") = true
     2939         then do:
     2940           define variable v-cntxt-db-num        as integer   no-undo .
     2941           define variable v-cntxt-userid        as character no-undo .
     2942           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2943                                             , OUTPUT v-cntxt-userid
     2944                                             ) .
     2945           run gbl/wndsizew.p
     2946             (input  v-cntxt-db-num
     2947             ,input  v-cntxt-userid
     2948             ,input  v-diasize-proc-name
     2949             ,input  'width':u
     2950             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2951             ) .
     2952         end.
     2953       end.
     2954     end.
     2955     assign
     2956       v-diasize-change-size = false
     2957     .
     2958   end procedure.
     2959   procedure diasize_set-width :
     2960     define input  parameter p-new-width  as decimal   no-undo .
     2961     define input  parameter p-move-resize as logical   no-undo .
     2962     do
     2963     on error undo, return error return-value
     2964     :
     2965       run diasize_change-width in this-procedure
     2966         (input  (p-new-width - frame Dialog-Frame :width)
     2967         ,input  p-move-resize
     2968         ) .
     2969     end.
     2970   end procedure.
     2971   procedure diasize_position-resize-button :
     2972     do with frame Dialog-Frame
     2973     :
     2974       hide v-diasize-resize-button .
     2975       assign
     2976         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2977                     - 1
     2978                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2979         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2980                     - 1
     2981                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2982       .
     2983       view v-diasize-resize-button .
     2984     end.
     2985   end procedure.
     2986   on alt-right anywhere
     2987   do:
     2988     run diasize_change-width in this-procedure
     2989       (input 1
     2990       ,input true
     2991       ) .
     2992     return no-apply .
     2993   end.
     2994   on alt-left anywhere
     2995   do:
     2996     run diasize_change-width in this-procedure
     2997       (input -1
     2998       ,input true
     2999       ) .
     3000     return no-apply .
     3001   end.
     3002   on alt-down anywhere
     3003   do:
     3004     run diasize_change-height in this-procedure
     3005       (input 1
     3006       ,input true
     3007       ) .
     3008     return no-apply .
     3009   end.
     3010   on alt-up anywhere
     3011   do:
     3012     run diasize_change-height in this-procedure
     3013       (input -1
     3014       ,input true
     3015       ) .
     3016     return no-apply .
     3017   end.
     3018   on alt-enter of frame Dialog-Frame
     3019   do:
     3020     run diasize_maximize in this-procedure
     3021       (input  ?
     3022       ).
     3023     return no-apply .
     3024   end.
     3025   procedure diasize_end-move :
     3026     do
     3027     on error undo, return error return-value
     3028     :
     3029       define variable v-row-delta as decimal   no-undo .
     3030       define variable v-col-delta as decimal   no-undo .
     3031       define variable v-new-row as decimal   no-undo .
     3032       define variable v-new-col as decimal   no-undo .
     3033       assign
     3034         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3035         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3036       .
     3037       assign
     3038         v-row-delta = v-new-row - frame Dialog-Frame :height
     3039         v-col-delta = v-new-col - frame Dialog-Frame :width
     3040       .
     3041       run diasize_change-height in this-procedure
     3042         (input v-row-delta
     3043         ,input true
     3044         ) .
     3045       run diasize_change-width in this-procedure
     3046         (input v-col-delta
     3047         ,input true
     3048         ) .
     3049     end.
     3050   end procedure.
     3051   procedure diasize_maximize :
     3052     define input  parameter p-action as logical   no-undo .
     3053     do
     3054     on error undo, return error return-value
     3055     :
     3056       if p-action = ?
     3057       then do:
     3058         if v-diasize-need-maximize = true
     3059         then do:
     3060           assign
     3061             p-action = true
     3062           .
     3063         end.
     3064         else do:
     3065           assign
     3066             p-action = false
     3067           .
     3068         end.
     3069       end.
     3070       if p-action = true
     3071       then do:
     3072         run diasize_change-height in this-procedure
     3073           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3074               - frame Dialog-Frame :height-chars
     3075           ,input true
     3076           ) .
     3077         run diasize_change-width in this-procedure
     3078           (input session :width-chars
     3079               - frame Dialog-Frame :width-chars
     3080           ,input true
     3081           ) .
     3082         assign
     3083           v-diasize-need-maximize = false
     3084         .
     3085       end.
     3086       else do:
     3087         run diasize_change-width in this-procedure
     3088           (input v-diasize-orig-frame-width
     3089               - frame Dialog-Frame :width-chars
     3090           ,input true
     3091           ) .
     3092         run diasize_change-height in this-procedure
     3093           (input v-diasize-orig-frame-height
     3094               - frame Dialog-Frame :height-chars
     3095           ,input true
     3096           ) .
     3097         assign
     3098           v-diasize-need-maximize = true
     3099         .
     3100       end.
     3101     end.
     3102   end procedure.
     3103   procedure diasize_restore-orig-size :
     3104     do
     3105     on error undo, return error return-value
     3106     :
     3107       assign
     3108         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3109         v-diasize-current-frame-height = frame Dialog-Frame :height
     3110       .
     3111       run diasize_set-height in this-procedure
     3112         (input  v-diasize-orig-frame-height
     3113         ,input  true
     3114         ) .
     3115       run diasize_set-width in this-procedure
     3116         (input  v-diasize-orig-frame-width
     3117         ,input  true
     3118         ) .
     3119     end.
     3120   end procedure.
     3121   procedure diasize_restore-current-size :
     3122     do
     3123     on error undo, return error return-value
     3124     :
     3125       run diasize_set-height in this-procedure
     3126         (input  v-diasize-current-frame-height
     3127         ,input  true
     3128         ) .
     3129       run diasize_set-width in this-procedure
     3130         (input  v-diasize-current-frame-width
     3131         ,input  true
     3132         ) .
     3133     end.
     3134   end procedure.
     3135   procedure diasize_set-browse-handle :
     3136     define input  parameter p-browse-handle as handle   no-undo .
     3137     define buffer buf_temp-browse-handle for temp-browse-handle .
     3138     do
     3139     on error undo, return error return-value
     3140     :
     3141       assign
     3142         v-diasize-browse-handle = p-browse-handle
     3143       .
     3144       for each buf_temp-browse-handle
     3145       on error undo, return error return-value
     3146       :
     3147         delete buf_temp-browse-handle .
     3148       end.
     3149     end.
     3150   end procedure.
     3151   procedure diasize_add_browse :
     3152     define input  parameter p-browse-type   as character no-undo .
     3153     define input  parameter p-browse-handle as handle    no-undo .
     3154     define buffer buf_temp-browse-handle for temp-browse-handle .
     3155     do
     3156     on error undo, return error return-value
     3157     :
     3158       assign
     3159         v-diasize-browse-number = v-diasize-browse-number + 1
     3160       .
     3161       create buf_temp-browse-handle .
     3162       assign
     3163         buf_temp-browse-handle.browse-type   = p-browse-type
     3164         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3165         buf_temp-browse-handle.browse-handle = p-browse-handle
     3166       .
     3167     end.
     3168   end procedure.
     3169   procedure diasize_init :
     3170     define variable v-default-value    as logical   no-undo .
     3171     define variable v-restore-saved    as logical   no-undo .
     3172     define variable v-resize-value-str as character no-undo .
     3173     do
     3174     on error undo, return error return-value
     3175     :
     3176       do with frame Dialog-Frame
     3177       :
     3178         assign
     3179           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3180           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3181           v-diasize-browse-handle     = browse-hdl-egais-goods
     3182         .
     3183         create button v-diasize-resize-button
     3184         assign
     3185           parent        = frame Dialog-Frame :first-child
     3186           label         = "s"
     3187           height-pixels = 16
     3188           width-pixels  = 16
     3189           visible       = true
     3190           sensitive     = true
     3191           movable       = true
     3192           triggers:
     3193             on end-move persistent run diasize_end-move in this-procedure .
     3194           end triggers.
     3195         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3196         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3197         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3198         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3199         assign
     3200           v-diasize-wndmax = false
     3201         .
     3202         if connected("ub") = true
     3203         then do:
     3204           define variable v-cntxt-db-num        as integer   no-undo .
     3205           define variable v-cntxt-userid        as character no-undo .
     3206           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3207                                             , OUTPUT v-cntxt-userid
     3208                                             ) .
     3209           run gbl/wndpar_r.p
     3210             (input  v-cntxt-db-num
     3211             ,input  v-cntxt-userid
     3212             ,input  'wndmax':U
     3213             ,output v-diasize-wndmax
     3214             ,output v-default-value
     3215             ) .
     3216         end.
     3217         assign
     3218           v-diasize-wndstore = false
     3219         .
     3220         if connected("ub") = true
     3221         then do:
     3222           run gbl/wndpar_r.p
     3223             (input  v-cntxt-db-num
     3224             ,input  v-cntxt-userid
     3225             ,input  'wndstore':U
     3226             ,output v-diasize-wndstore
     3227             ,output v-default-value
     3228             ) .
     3229         end.
     3230         assign
     3231           v-diasize-proc-name = entry(1, program-name(2), '.')
     3232         .
     3233         if v-diasize-wndstore = true
     3234         then do:
     3235           assign
     3236             v-restore-saved = false
     3237           .
     3238           if connected("ub") = true
     3239           then do:
     3240             run gbl/wndsizer.p
     3241               (input  v-cntxt-db-num
     3242               ,input  v-cntxt-userid
     3243               ,input  v-diasize-proc-name
     3244               ,input  'height':u
     3245               ,output v-resize-value-str
     3246               ) .
     3247             if v-resize-value-str <> '':U
     3248             then do:
     3249               run diasize_change-height in this-procedure
     3250                 (input  integer(v-resize-value-str)
     3251                 ,input  true
     3252                 ) .
     3253               assign
     3254                 v-restore-saved = true
     3255               .
     3256             end.
     3257           end.
     3258           if connected("ub") = true
     3259           then do:
     3260             run gbl/wndsizer.p
     3261               (input  v-cntxt-db-num
     3262               ,input  v-cntxt-userid
     3263               ,input  v-diasize-proc-name
     3264               ,input  'width':u
     3265               ,output v-resize-value-str
     3266               ) .
     3267             if v-resize-value-str <> '':U
     3268             then do:
     3269               run diasize_change-width in this-procedure
     3270                 (input  integer(v-resize-value-str)
     3271                 ,input  true
     3272                 ) .
     3273               assign
     3274                 v-restore-saved = true
     3275               .
     3276             end.
     3277           end.
     3278           if v-restore-saved <> true
     3279           then do:
     3280             if v-diasize-wndmax = true
     3281             then do:
     3282               run diasize_maximize in this-procedure
     3283                 (input  true
     3284                 ) .
     3285             end.
     3286           end.
     3287         end.
     3288         else do:
     3289           if v-diasize-wndmax = true
     3290           then do:
     3291             run diasize_maximize in this-procedure
     3292               (input  true
     3293               ) .
     3294           end.
     3295         end.
     3296       end.
     3297     end.
     3298   end procedure.
     3299   procedure diasize_need-full-display :
     3300     define output parameter p-need-full-display as logical   no-undo .
     3301     do
     3302     on error undo, return error return-value
     3303     :
     3304       assign
     3305         p-need-full-display = v-diasize-need-full-display
     3306       .
     3307       assign
     3308         v-diasize-need-full-display = false
     3309       .
     3310     end.
     3311   end procedure.
     3312   procedure get-context :
     3313      define output parameter p-db-num as integer          no-undo.
     3314      define output parameter p-user-id as character        no-undo.
     3315      define variable v-login               as character    no-undo.
     3316      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3317      define buffer buf_user-login  for ub.user-login .
     3318      do
     3319      on error undo, return error
     3320      :
     3321            FIND FIRST buf_sys-ctrl no-lock.
     3322            ASSIGN
     3323               v-login = USERID("ub")
     3324               p-db-num = buf_sys-ctrl.db-num
     3325            .
     3326            FIND FIRST buf_user-login
     3327                 WHERE buf_user-login.db-num = p-db-num
     3328                   AND buf_user-login.user-login = v-login
     3329                 no-lock
     3330                 no-error
     3331                 .
     3332            IF AVAILABLE buf_user-login
     3333            THEN DO:
     3334               assign
     3335                  p-user-id = buf_user-login.user-id
     3336               .
     3337            END.
     3338      end.
     3339   end procedure.
     3340     run diasize_init in this-procedure .
     3341     run enable_UI.
     3342     run refresh-view.
     3343     bh-egais-goods:find-first ("", no-lock) no-error.
     3344     ASSIGN
     3345          btn_del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3346     wait-for go of frame Dialog-Frame.
     3347   end.
     3348   if valid-object (extGdsObj)
     3349     then delete object extGdsObj.
     3350   run disable_UI.
     3351   PROCEDURE disable_UI :
     3352     HIDE FRAME Dialog-Frame.
     3353   END PROCEDURE.
     3354   PROCEDURE enable_UI :
     3355     DISPLAY t-incorr c_verxsd f-gds f-alcgds f-gdsname
     3356         WITH FRAME Dialog-Frame.
     3357     ENABLE Btn_Cancel Btn_mark Btn_markall Btn_desmark btn_look btn_refresh
     3358            btn_req btn_asw btn_del t-incorr c_verxsd f-gds f-alcgds f-gdsname
     3359         WITH FRAME Dialog-Frame.
     3360     VIEW FRAME Dialog-Frame.
     3361   END PROCEDURE.
     3362   PROCEDURE msdblcl :
     3363   define variable v-prod-full-name as character no-undo .
     3364     define variable v-import-full-name as character no-undo .
     3365     define variable v-gds-code as int no-undo .
     3366     define variable v-gds-name as character no-undo .
     3367     define variable v-alc-code as char no-undo.
     3368     v-gds-code = bh-egais-goods:buffer-field ("gdsCode"):buffer-value.
     3369     v-alc-code = bh-egais-goods:buffer-field ("alcCode"):buffer-value.
     3370     if not bh-egais-goods:available
     3371       then return no-apply.
     3372     run bge/egais-goods-mark.w (
     3373                                 input parparentproc,
     3374                                 input 'ПРОСМОТР':U,
     3375                                 input-output v-alc-code,
     3376                                 input-output v-gds-code,
     3377                                 output v-gds-name,
     3378                                 output v-prod-full-name,
     3379                                 output v-import-full-name )  .
     3380     if bh-egais-goods:available
     3381       then qh-egais-goods:reposition-to-rowid ( bh-egais-goods:rowid ).
     3382   end.
     3383   PROCEDURE proc-row-disp :
     3384   def var ii as int no-undo.
     3385     do ii = 1 to extent (bcol).
     3386       if valid-handle (bcol[ii])
     3387         then
     3388           assign
     3389             bcol[ii]:bgcolor = bh-egais-goods:buffer-field ("ColorNum"):buffer-value
     3390           .
     3391     end.
     3392   end.
     3393   PROCEDURE refresh-view :
     3394   def var v-proposition  as char no-undo.
     3395     assign input frame Dialog-Frame
     3396       f-gds
     3397       f-gdsname
     3398       f-alcgds
     3399       t-incorr
     3400       c_verxsd
     3401     .
     3402     if f-gds <> ""
     3403     then do:
     3404       v-proposition = substitute ("string(gdsCode) matches '*&1*' and ", f-gds).
     3405     end.
     3406     if f-alcgds <> ""
     3407     then do:
     3408       v-proposition = v-proposition + substitute ("alcCode matches '*&1*' and ", f-alcgds).
     3409     end.
     3410     if f-gdsname <> ""
     3411     then do:
     3412       v-proposition = v-proposition + substitute ("gdsName matches '*&1*' and ", f-gdsname).
     3413     end.
     3414     if t-incorr = true
     3415     then do:
     3416       v-proposition = v-proposition + substitute ("ColorNum = &1 and ", RED_COLOR).
     3417     end.
     3418     case c_verxsd:
     3419       when "V1" then do:
     3420         v-proposition = v-proposition + substitute ("verXSD = &1 and ", "1").
     3421       end.
     3422       when "V2" then do:
     3423         v-proposition = v-proposition + substitute ("verXSD = &1 and ", "2").
     3424       end.
     3425       when "V1&V2" then do:
     3426       end.
     3427     end case.
     3428     v-proposition = right-trim (v-proposition, " and ").
     3429     if v-proposition <> "" then v-proposition = "where " + v-proposition.
     3430     display Btn_Cancel with frame Dialog-Frame.
     3431     enable Btn_Cancel
     3432       with frame Dialog-Frame.
     3433     view frame Dialog-Frame.
     3434     qh-egais-goods:query-close.
     3435     qh-egais-goods:query-prepare ("for each tt-egaisgds-hndls " + v-proposition).
     3436     qh-egais-goods:query-open.
     3437     if qh-egais-goods:get-first ()
     3438       then browse-hdl-egais-goods:refresh ().
     3439     apply "choose" to Btn_desmark in frame Dialog-Frame.
     3440   end.
     3441   PROCEDURE reopen-browse :
     3442     define variable ii       as integer no-undo.
     3443     define variable v-width  as decimal no-undo.
     3444     define variable v-height as decimal no-undo.
     3445     if valid-handle (browse-hdl-egais-goods) then do:
     3446       v-width  = browse-hdl-egais-goods:width-chars.
     3447       v-height = browse-hdl-egais-goods:height-chars.
     3448     end.
     3449     delete object qh-egais-goods no-error.
     3450     delete object browse-hdl-egais-goods no-error.
     3451     extGdsObj:GetHndlTable(0, "", input-output bh-egais-goods).
     3452     create query qh-egais-goods.
     3453     qh-egais-goods:set-buffers (bh-egais-goods).
     3454     create browse browse-hdl-egais-goods
     3455       assign
     3456       title     = 'Товары'
     3457       frame     = frame Dialog-Frame:handle
     3458       query     = qh-egais-goods
     3459       x         = 10
     3460       y         = 70
     3461       width     = if v-width <> 0 then v-width else 107
     3462       height    = if v-height <> 0 then v-height else 21.5
     3463       visible   = true
     3464       read-only = true
     3465       sensitive = true
     3466       separators = true
     3467       column-resizable = true
     3468       triggers:
     3469         on mouse-move-dblclick persistent run msdblcl.
     3470         on row-display persistent run proc-row-disp.
     3471       end triggers
     3472       .
     3473     do ii = 1 to bh-egais-goods:num-fields:
     3474       bcol[ii] = browse-hdl-egais-goods:add-like-column('tt-egaisgds-hndls' + '.' + bh-egais-goods:buffer-field (ii):name, 0, 'FILL-IN').
     3475       if entry (ii, extGdsObj:SettingsTTList, ';') <> ""
     3476       then do:
     3477         v-windth = integer (entry (1, entry (ii, extGdsObj:SettingsTTList, ';'))).
     3478         v-isDisp = entry (2, entry (ii, extGdsObj:SettingsTTList, ';')).
     3479         assign
     3480           bcol[ii]:width = v-windth when v-windth > 0
     3481           bcol[ii]:visible = false when v-isDisp = "no"
     3482         .
     3483       end.
     3484     end.
     3485     v-diasize-browse-handle = browse-hdl-egais-goods.
     3486     run refresh-view.
     3487   end.
