     2617           p-change-value = v-diasize-orig-frame-width
     2618                          - frame Dialog-Frame :width
     2619         .
     2620         if p-change-value >= 0
     2621         then do:
     2622           run diasize_position-resize-button in this-procedure .
     2623           return .
     2624         end.
