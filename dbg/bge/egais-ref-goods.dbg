     1469   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1470   define variable v-waitfram-action01         as character   no-undo .
     1471   define variable v-waitfram-action02         as character   no-undo .
     1472   define variable v-waitfram-action03         as character   no-undo .
     1473   define variable mWaitFramTextBeg            as character   no-undo.
     1474   define variable mWaitFramTextEnd            as character   no-undo.
     1475   define variable mWaitFramView               as logical     no-undo.
     1476   define variable mWaitProcEvent              as logical     no-undo init yes.
     1477   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1478   define variable mWaitFramStop               as logical     no-undo.
     1479   define variable mWaitFramStopUser           as logical     no-undo.
     1480   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1481   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1482   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1483   define button B-WaitFramStop auto-end-key
     1484        label "Стоп"
     1485        size 10 by 1 tooltip "Остоновить процесс".
     1486   define button B-viewProcInfo
     1487        label "Информация"
     1488        size 15 by 1 tooltip "Информация о процесс".
     1489   define frame waitfram
     1490     v-waitfram-action01 format "x(72)" no-label skip
     1491     v-waitfram-action02 format "x(72)" no-label skip
     1492     v-waitfram-action03 format "x(72)" no-label skip
     1493     B-viewProcInfo
     1494     B-WaitFramStop at row 4 col 30
     1495     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1496     .
     1497   define new global shared variable mBatchMode as logical no-undo init ?.
     1498   define variable mFramBachModHandle as handle no-undo.
     1499   mFramBachModHandle = frame waitfram:handle.
     1500   define variable mFameOldVis as logical no-undo.
     1501   define variable mVisCUrentVin as logical no-undo.
     1502   if session:batch-mode
     1503   then
     1504      mBatchMode = yes.
     1505   if mBatchMode = ? then do:
     1506     mVisCUrentVin = current-window:visible.
     1507     mFameOldVis = mFramBachModHandle:visible.
     1508     mFramBachModHandle:visible  = yes.
     1509     mBatchMode = mFramBachModHandle:visible ne yes.
     1510     mFramBachModHandle:visible = mFameOldVis.
     1511     current-window:visible = mVisCUrentVin.
     1512   end.
     1513    if  log-manager:logfile-name ne ?
     1514     then DO:
     1515         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1516         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1517         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1518     end.
     1519   on choose of B-WaitFramStop in frame waitfram
     1520   do:
     1521     mWaitFramStop = yes.
     1522     mWaitFramStopUser = yes.
     1523   end.
     1524   function waitfram-check-timeout returns logical():
     1525      define variable vtime as int64 no-undo.
     1526      if mWaitFramStopTimeOut
     1527      then
     1528         return yes.
     1529      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1530      if     mWaitFramTimeOut ne ?
     1531         and mWaitFramTimeOut ne 0
     1532         and mWaitFramTimeOut lt vtime
     1533      then do:
     1534         mWaitFramStopTimeOut = yes.
     1535      end.
     1536      return mWaitFramStopTimeOut.
     1537   end.
     1538   procedure waitfram-hide :
     1539     if not session:batch-mode
     1540     then do
     1541     on error undo, return error return-value
     1542     :
     1543       pause 0 before-hide .
     1544       if not mBatchMode then
     1545         hide frame waitfram .
     1546     if     not mWaitFramView
     1547        and mWaitProcEvent
     1548     then
     1549       process events .
     1550     end.
     1551   end procedure.
     1552   procedure waitfram-show :
     1553     define input  parameter p-message as character no-undo .
     1554     define variable v-left-margin as integer   no-undo .
     1555     if not session:batch-mode
     1556     then do
     1557     on error undo, return error return-value
     1558     :
     1559       if length(p-message) <= 70 then do:
     1560         assign
     1561           v-left-margin = integer((70 - length(p-message)) / 2)
     1562         .
     1563         assign
     1564           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1565         .
     1566         assign
     1567           v-waitfram-action01 = " "
     1568           v-waitfram-action02 = " "
     1569                                    + fill(" ", v-left-margin)
     1570                                    + p-message
     1571           v-waitfram-action03 = " "
     1572         .
     1573       end.
     1574       else do:
     1575         define variable vRindex1 as integer no-undo.
     1576         define variable vRindex2 as integer no-undo.
     1577         vRindex1 = r-index(p-message," ",70).
     1578         if vRindex1 = 0
     1579         then
     1580            vRindex1 = 70.
     1581         if length(p-message)  <= vRindex1 + 70 then do:
     1582           assign
     1583             v-waitfram-action01 = " "
     1584             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1585             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1586           .
     1587         end.
     1588         else do:
     1589           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1590           if vRindex2 <= vRindex1
     1591           then
     1592              vRindex2 = vRindex1 + 70.
     1593           assign
     1594             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1595             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1596             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1597           .
     1598         end.
     1599       end.
     1600       B-viewProcInfo:visible   in frame waitfram = no.
     1601       B-viewProcInfo:sensitive in frame waitfram = no.
     1602       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1603       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1604       if  (   mWaitFramView
     1605          or  mWaitProcEvent)
     1606          and not mBatchMode
     1607       then
     1608          display
     1609             v-waitfram-action01 skip
     1610             v-waitfram-action02 skip
     1611             v-waitfram-action03 skip
     1612          with frame waitfram .
     1613       if     mWaitFramView
     1614          then do:
     1615             if     mWaitFramInterval ne ?
     1616                and not mBatchMode
     1617             then
     1618                wait-for go of frame waitfram pause mWaitFramInterval.
     1619          end.
     1620          else
     1621             if     mWaitProcEvent
     1622                and not mBatchMode
     1623             then
     1624                process events .
     1625     end.
     1626   end procedure.
     1627      procedure waitfram-show-this:
     1628         define input  parameter iInterval as int64 no-undo.
     1629         define variable vtime as int64 no-undo.
     1630         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1631         mWaitFramInterval = iInterval.
     1632         run waitfram-show (substitute("&1&2 &3&4" ,
     1633                                       mWaitFramTextBeg ,
     1634                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1635                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1636                                       mWaitFramTextEnd
     1637                                      )
     1638                           ).
     1639      end.
     1640      procedure WaitFramRunPause:
     1641         define input  parameter iInterval as dec no-undo.
     1642         define variable vStart  as datetime-tz no-undo.
     1643         define variable vend    as datetime-tz no-undo.
     1644         define variable vint as int64 no-undo.
     1645         define variable vOk as logical no-undo.
     1646         vStart = now.
     1647         vend   = vStart.
     1648         publish "WaitFramPause" (iInterval,output vOk).
     1649         vend   =  now.
     1650         vint = vend - vStart.
     1651         vint = iInterval - vint / 1000.
     1652         if     not mWaitFramStop
     1653            and (   vint > 0
     1654                 or (    not vOk
     1655                     and iInterval eq ?
     1656                     )
     1657                 )
     1658         then
     1659            run waitfram-show-this (iInterval).
     1660         vend   =  now.
     1661         vint = vend - vStart.
     1662         vint = iInterval - vint / 1000.
     1663         if     not mWaitFramStop
     1664            and vint > 0
     1665         then do:
     1666            run gbl/pause.p (vint * 1000).
     1667         end.
     1668         if iInterval ne ?
     1669         then
     1670            publish "WaitFramStop".
     1671         waitfram-check-timeout().
     1672      end.
     1673      procedure WaitFramWaitFor:
     1674         define input  parameter iInterval as dec no-undo.
     1675         assign
     1676            mWaitFramStartProc   = now
     1677            mWaitFramStopUser    = no
     1678            mWaitFramStopTimeOut = no
     1679         .
     1680         block-wait:
     1681         do while not mWaitFramStop:
     1682            run WaitFramRunPause (iInterval).
     1683            if  waitfram-check-timeout()
     1684            then do:
     1685               leave block-wait.
     1686            end.
     1687         end.
     1688         run waitfram-hide.
     1689      end.
     1690   procedure waitfram-join :
     1691     define input  parameter p-line-1  as character no-undo .
     1692     define input  parameter p-line-2  as character no-undo .
     1693     define input  parameter p-line-3  as character no-undo .
     1694     define output parameter p-message as character no-undo .
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698       assign
     1699         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1700                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1701                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1702       .
     1703     end.
     1704   end procedure.
     1705   function waitfram-join-function returns character
     1706     (input p-line-1 as character
     1707     ,input p-line-2 as character
     1708     ,input p-line-3 as character
     1709     ).
     1710     define variable v-message as character no-undo .
     1711     run waitfram-join in this-procedure
     1712       (input  p-line-1
     1713       ,input  p-line-2
     1714       ,input  p-line-3
     1715       ,output v-message
     1716       ) .
     1717     return v-message .
     1718   end function .
     1719   procedure proc-alt-shift-f2:
     1720     if not ibs.th.gbl.gbl-var:rcode
     1721   then
     1722     run gbl\inidebug.p .
     1723   end.
     1724   procedure proc-alt-shift-f3:
     1725     run gbl/prvssinf.p
     1726       ( input this-procedure
     1727       ) .
     1728   end.
     1729   define variable v-inform-launched as logical no-undo initial false .
     1730   procedure proc-alt-shift-f4:
     1731     define variable v-action as character no-undo .
     1732     if v-inform-launched = false then do:
     1733       assign
     1734         v-inform-launched = true
     1735       .
     1736       run gbl/d-inform.w
     1737         (  input self
     1738         ,  input this-procedure
     1739         , output v-action
     1740         ) no-error .
     1741       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1742       assign
     1743         v-inform-launched = false
     1744       .
     1745     end.
     1746   end.
     1747   procedure proc-alt-f1:
     1748     run gbl/corrhelp.p
     1749       (input this-procedure
     1750       ) .
     1751   end .
     1752   on alt-shift-f2 anywhere do:
     1753     run proc-alt-shift-f2.
     1754   end.
     1755   on alt-shift-f3 anywhere do:
     1756     run proc-alt-shift-f3 in this-procedure .
     1757   end.
     1758   on alt-shift-f4 anywhere do:
     1759     run proc-alt-shift-f4 in this-procedure.
     1760   end.
     1761   on alt-f1 anywhere do:
     1762     run proc-alt-f1 in this-procedure .
     1763   end.
     1764   DEFINE BUTTON btn_asw
     1765        LABEL "Получить ответ и сохр."
     1766        SIZE 22.5 BY 1.13.
     1767   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1768        LABEL "Выход"
     1769        SIZE 8.5 BY 1.13
     1770        BGCOLOR 8 .
     1771   DEFINE BUTTON btn_del
     1772        LABEL "Удалить"
     1773        SIZE 9 BY 1.13.
     1774   DEFINE BUTTON Btn_desmark
     1775        LABEL "-"
     1776        SIZE 3.5 BY 1.13.
     1777   DEFINE BUTTON btn_look
     1778        LABEL "Просмотр"
     1779        SIZE 9 BY 1.13.
     1780   DEFINE BUTTON Btn_mark
     1781        LABEL "*"
     1782        SIZE 3.5 BY 1.13.
     1783   DEFINE BUTTON Btn_markall
     1784        LABEL "+"
     1785        SIZE 3.5 BY 1.13.
     1786   DEFINE BUTTON btn_refresh
     1787        LABEL "Обновить"
     1788        SIZE 9 BY 1.13.
     1789   DEFINE BUTTON btn_req
     1790        LABEL "Запрос"
     1791        SIZE 9 BY 1.13.
     1792   DEFINE VARIABLE c_verxsd AS CHARACTER FORMAT "X(256)":U INITIAL "V1&V2"
     1793        VIEW-AS COMBO-BOX INNER-LINES 5
     1794        LIST-ITEMS "V1&V2","V1","V2"
     1795        DROP-DOWN-LIST
     1796        SIZE 9.75 BY 1 NO-UNDO.
     1797   DEFINE VARIABLE f-alcgds AS CHARACTER FORMAT "X(256)":U
     1798        LABEL "Алк. код товара"
     1799        VIEW-AS FILL-IN
     1800        SIZE 15 BY 1 NO-UNDO.
     1801   DEFINE VARIABLE f-gds AS CHARACTER FORMAT "X(256)":U
     1802        LABEL "Код товара"
     1803        VIEW-AS FILL-IN
     1804        SIZE 15.13 BY 1 NO-UNDO.
     1805   DEFINE VARIABLE f-gdsname AS CHARACTER FORMAT "X(256)":U
     1806        LABEL "Назв. товара"
     1807        VIEW-AS FILL-IN
     1808        SIZE 17.63 BY 1 NO-UNDO.
     1809   DEFINE VARIABLE t-incorr AS LOGICAL INITIAL no
     1810        LABEL "Некорр."
     1811        VIEW-AS TOGGLE-BOX
     1812        SIZE 11.13 BY 1.13 NO-UNDO.
     1813   DEFINE FRAME Dialog-Frame
     1814        Btn_Cancel AT ROW 1.25 COL 2
     1815        Btn_mark AT ROW 1.25 COL 12.5 WIDGET-ID 4
     1816        Btn_markall AT ROW 1.25 COL 16.75 WIDGET-ID 6
     1817        Btn_desmark AT ROW 1.25 COL 21 WIDGET-ID 8
     1818        btn_look AT ROW 1.25 COL 25.25 WIDGET-ID 14
     1819        btn_refresh AT ROW 1.25 COL 34.88 WIDGET-ID 18
     1820        btn_req AT ROW 1.25 COL 44.38 WIDGET-ID 36
     1821        btn_asw AT ROW 1.25 COL 54 WIDGET-ID 38
     1822        btn_del AT ROW 1.25 COL 77
     1823        t-incorr AT ROW 1.25 COL 86.5 WIDGET-ID 28
     1824        c_verxsd AT ROW 2.71 COL 93.63 COLON-ALIGNED NO-LABEL WIDGET-ID 40
     1825        f-gds AT ROW 2.75 COL 12.38 COLON-ALIGNED WIDGET-ID 20
     1826        f-alcgds AT ROW 2.75 COL 45.13 COLON-ALIGNED WIDGET-ID 22
     1827        f-gdsname AT ROW 2.75 COL 75.25 COLON-ALIGNED WIDGET-ID 24
     1828        SPACE(14.36) SKIP(21.99)
     1829       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1830            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1831            TITLE "Справочник товаров ЕГАИС"
     1832            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1833   ASSIGN
     1834          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1835          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1836   ASSIGN
     1837          btn_del:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1838   ON window-close OF FRAME Dialog-Frame
     1839   do:
     1840       apply "END-ERROR":U to self.
     1841     end.
     1842   ON CHOOSE OF btn_asw IN FRAME Dialog-Frame
     1843   DO:
     1844     def var egaisJournal        as class  Journal     no-undo.
     1845     def var extGdsValueObj      as class  ExtGdsValue no-undo.
     1846     def var extGdsValueObjDB    as class  ExtGdsValue no-undo.
     1847     def var egaisDictGds        as class  DictGds     no-undo.
     1848     def var bh-journal-egais    as handle no-undo.
     1849     def var qh-journal-egais    as handle no-undo.
     1850     def var bh-gds-egais-gotten as handle    no-undo.
     1851     def var msg                 as character no-undo.
     1852     def var ii                  as integer   no-undo.
     1853     def var isQHEmpty           as logical no-undo init true.
     1854     os-delete value (search ("logbund.txt")).
     1855     output stream str1 to "logbund.txt".
     1856     egaisJournal = new Journal ().
     1857     bh-journal-egais = egaisJournal:GetHndlTable().
     1858     create query qh-journal-egais.
     1859     qh-journal-egais:set-buffers (bh-journal-egais) .
     1860     qh-journal-egais:query-prepare ("for each tt_journal-egais where jou-param matches '*КОД*' and jou-status = 'Запрос отправлен' ").
     1861     qh-journal-egais:query-open.
     1862     run waitfram-show in this-procedure ("Ждите...") .
     1863     journal_:
     1864     do while qh-journal-egais:get-next ():
     1865       isQHEmpty = false.
     1866       egaisDictGds = new DictGds (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, "КОД", entry (3, bh-journal-egais:buffer-field ("jou-param"):buffer-value, '|')).
     1867       egaisDictGds:DbNum = v-db-num.
     1868       egaisDictGds:User_Id = v-user-id.
     1869       glog = egaisDictGds:StatusErr .
     1870       if glog then do :
     1871           msg = msg + chr(10) + egaisDictGds:Msg.
     1872       end.
     1873       else do:
     1874         extGdsValueObj = egaisDictGds:GetExtGdsObjValueFromUTM() .
     1875         if egaisDictGds:StatusErr = true
     1876         then do:
     1877           put stream str1 unformatted chr(10) + egaisDictGds:Msg.
     1878           delete object egaisDictGds.
     1879           next journal_.
     1880         end.
     1881         extGdsObj:OpenQueryExtGds (extGdsValueObj:AlcCode).
     1882         do ii = 1 to extGdsObj:NumBundles:
     1883           extGdsValueObjDB = extGdsObj:GetExtGdsValue(ii).
     1884           if extGdsValueObj:CliEgaisTypeProd = ""
     1885           then do:
     1886             assign
     1887               extGdsValueObjDB:CliRegIdImpor = extGdsValueObj:CliRegIdImpor
     1888               extGdsValueObjDB:CliRegIdProd = extGdsValueObj:CliRegIdProd
     1889               extGdsValueObjDB:CountryImpor = extGdsValueObj:CountryImpor
     1890               extGdsValueObjDB:CountryProd = extGdsValueObj:CountryProd
     1891               extGdsValueObjDB:DescrImpor = extGdsValueObj:DescrImpor
     1892               extGdsValueObjDB:DescrProd = extGdsValueObj:DescrProd
     1893               extGdsValueObjDB:FullNameGds = extGdsValueObj:FullNameGds
     1894               extGdsValueObjDB:Capacity = extGdsValueObj:Capacity
     1895               extGdsValueObjDB:FullNameImpor = extGdsValueObj:FullNameImpor
     1896               extGdsValueObjDB:FullNameProd = extGdsValueObj:FullNameProd
     1897               extGdsValueObjDB:INNImpor = extGdsValueObj:INNImpor
     1898               extGdsValueObjDB:INNProd = extGdsValueObj:INNProd
     1899               extGdsValueObjDB:KPPImpor = extGdsValueObj:KPPImpor
     1900               extGdsValueObjDB:KPPProd = extGdsValueObj:KPPProd
     1901             .
     1902           end.
     1903           else do:
     1904             assign
     1905               extGdsValueObjDB:CliRegIdProd = extGdsValueObj:CliRegIdProd
     1906               extGdsValueObjDB:CountryProd = extGdsValueObj:CountryProd
     1907               extGdsValueObjDB:DescrProd = extGdsValueObj:DescrProd
     1908               extGdsValueObjDB:FullNameGds = extGdsValueObj:FullNameGds
     1909               extGdsValueObjDB:Capacity = extGdsValueObj:Capacity
     1910               extGdsValueObjDB:FullNameProd = extGdsValueObj:FullNameProd
     1911               extGdsValueObjDB:INNProd = extGdsValueObj:INNProd
     1912               extGdsValueObjDB:KPPProd = extGdsValueObj:KPPProd
     1913               extGdsValueObjDB:CliEgaisTypeProd = extGdsValueObj:CliEgaisTypeProd
     1914               extGdsValueObjDB:RegionProd = extGdsValueObj:RegionProd
     1915             .
     1916           end.
     1917           extGdsObj:SaveEGAISInfo(extGdsValueObjDB).
     1918           bh-egais-goods:find-first (substitute ("where alcCode = '&1' and gdsCode = &2", extGdsValueObjDB:AlcCode, extGdsValueObjDB:GdsCode )).
     1919           bh-egais-goods:buffer-field ('ColorNum'):buffer-value () = YELLOW_COLOR .
     1920         end.
     1921       end.
     1922       delete object egaisDictGds.
     1923     end.
     1924     run waitfram-hide in this-procedure.
     1925     output stream str1 close.
     1926     file-info:file-name = search ("logbund.txt").
     1927     if search ("logbund.txt") <> ? and file-info:file-size > 0
     1928     then do:
     1929       run gbl/prnfilen.w
     1930       (input  "Отчёт о запросах"
     1931       ,input  0
     1932       ,input  search ("logbund.txt")
     1933       ,input  7
     1934       ,output v-user-action
     1935       ,output v-printed
     1936       ) .
     1937     end.
     1938     if isQHEmpty
     1939     then do:
     1940       delete object qh-journal-egais.
     1941       delete object egaisJournal.
     1942       message "Нет открытых запросов." view-as alert-box information title "Информация".
     1943       return.
     1944     end.
     1945     else message "Завершено. Сохраненные записи подсвечены желтым." view-as alert-box information title "Сообщение".
     1946     delete object qh-journal-egais.
     1947     delete object egaisJournal.
     1948     run refresh-view.
     1949   END.
     1950   ON choose OF btn_del IN FRAME Dialog-Frame
     1951   do:
     1952     def var cmd as char no-undo.
     1953     def var qh-del as handle no-undo.
     1954     run refresh-view.
     1955   end.
     1956   ON choose OF Btn_desmark IN FRAME Dialog-Frame
     1957   do:
     1958     if not qh-egais-goods:is-open
     1959       then return no-apply.
     1960     if qh-egais-goods:get-first ()
     1961       then bh-egais-goods:buffer-field (1):buffer-value () = "".
     1962     do while qh-egais-goods:get-next ():
     1963       bh-egais-goods:buffer-field (1):buffer-value () = "".
     1964     end.
     1965     if qh-egais-goods:get-first ()
     1966       then browse-hdl-egais-goods:refresh ().
     1967   end.
     1968   ON choose OF btn_look IN FRAME Dialog-Frame
     1969   do:
     1970     run msdblcl.
     1971   end.
     1972   ON choose OF Btn_mark IN FRAME Dialog-Frame
     1973   do:
     1974     if bh-egais-goods:available
     1975     then do:
     1976       if bcol[1]:screen-value = "*"
     1977         then do:
     1978           assign
     1979             bh-egais-goods:buffer-field (1):buffer-value () = ""
     1980             bcol[1]:screen-value = ""
     1981             .
     1982         end.
     1983         else do:
     1984           assign
     1985             bh-egais-goods:buffer-field (1):buffer-value () = "*"
     1986             bcol[1]:screen-value = "*"
     1987             .
     1988        end.
     1989        browse-hdl-egais-goods:select-next-row( ).
     1990     end.
     1991   end.
     1992   ON choose OF Btn_markall IN FRAME Dialog-Frame
     1993   do:
     1994     if qh-egais-goods:get-first ()
     1995       then bh-egais-goods:buffer-field (1):buffer-value () = "*".
     1996     do while qh-egais-goods:get-next ():
     1997       bh-egais-goods:buffer-field (1):buffer-value () = "*".
     1998     end.
     1999     if qh-egais-goods:get-first ()
     2000       then browse-hdl-egais-goods:refresh ().
     2001   end.
     2002   ON CHOOSE OF btn_refresh IN FRAME Dialog-Frame
     2003   DO:
     2004     run reopen-browse.
     2005   END.
     2006   ON CHOOSE OF btn_req IN FRAME Dialog-Frame
     2007   DO:
     2008     def var egaisDictGds as class DictGds no-undo.
     2009     def var qh-egais-goods-mark as handle no-undo.
     2010     def var isQHEmpty as logical no-undo init true.
     2011     create query qh-egais-goods-mark.
     2012     qh-egais-goods-mark:set-buffers (bh-egais-goods).
     2013     qh-egais-goods-mark:query-prepare ("for each tt-egaisgds-hndls where mark = '*' ").
     2014     qh-egais-goods-mark:query-open.
     2015     run waitfram-show in this-procedure ("Ждите...") .
     2016     do while qh-egais-goods-mark:get-next ():
     2017       isQHEmpty = false.
     2018       egaisDictGds = new DictGds (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, "КОД", bh-egais-goods:buffer-field ("alcCode"):buffer-value).
     2019       egaisDictGds:DbNum = v-db-num.
     2020       egaisDictGds:User_Id = v-user-id.
     2021       egaisDictGds:SendRequestUTM() .
     2022       glog = egaisDictGds:StatusErr .
     2023       if glog then do :
     2024           message egaisDictGds:Msg view-as alert-box.
     2025           run waitfram-hide in this-procedure.
     2026           return no-apply.
     2027       end.
     2028       delete object egaisDictGds.
     2029     end.
     2030     delete object qh-egais-goods-mark.
     2031     run waitfram-hide in this-procedure .
     2032     if isQHEmpty
     2033     then do:
     2034       message "Для отправки запросов отметьте товары." view-as alert-box information title "Информация".
     2035       return.
     2036     end.
     2037     apply "choose" to Btn_desmark in frame Dialog-Frame.
     2038   END.
     2039   ON leave OF f-alcgds IN FRAME Dialog-Frame
     2040   do:
     2041     if f-alcgds:screen-value = f-alcgds
     2042       then return.
     2043     run refresh-view.
     2044   end.
     2045   ON return OF f-alcgds IN FRAME Dialog-Frame
     2046   do:
     2047     run refresh-view.
     2048   end.
     2049   ON leave OF f-gds IN FRAME Dialog-Frame
     2050   do:
     2051     if f-gds:screen-value = f-gds
     2052       then return.
     2053     run refresh-view.
     2054   end.
     2055   ON return OF f-gds IN FRAME Dialog-Frame
     2056   do:
     2057     run refresh-view.
     2058   end.
     2059   ON leave OF f-gdsname IN FRAME Dialog-Frame
     2060   do:
     2061     if f-gdsname:screen-value = f-gdsname
     2062       then return.
     2063     run refresh-view.
     2064   end.
     2065   ON return OF f-gdsname IN FRAME Dialog-Frame
     2066   do:
     2067     run refresh-view.
     2068   end.
     2069   ON VALUE-CHANGED OF t-incorr IN FRAME Dialog-Frame
     2070   DO:
     2071     run refresh-view.
     2072   END.
     2073   ON VALUE-CHANGED OF c_verxsd IN FRAME Dialog-Frame
     2074   DO:
     2075     run refresh-view.
     2076   END.
     2077   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     2078     then frame Dialog-Frame:PARENT = active-window.
     2079   MAIN-BLOCK:
     2080   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2081     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2082     def var ii as int no-undo.
     2083   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2084   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     2085     (output v-db-num
     2086     ,output v-user-id
     2087     ) no-error .
     2088   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2089     run mainmenu_getcntxt in parparentproc
     2090       (output v-cntxt-db-num
     2091       ,output v-cntxt-userid
     2092       ,output v-cntxt-level
     2093       ,output v-cntxt-host-code-obj
     2094       ,output v-cntxt-obj-type
     2095       ,output v-cntxt-obj-code
     2096       ,output v-cntxt-db-num-obj
     2097       ,output v-cntxt-is-admin
     2098       ) .
     2099     empty temp-table thbjattr_thbj-attr .
     2100     run adm/shattri.p (
     2101          input "get":U
     2102         ,input v-cntxt-obj-type
     2103         ,input v-cntxt-obj-code
     2104         ,input 'egais':U
     2105         ,input 'egais-fsrar':U
     2106         ,output v-value-character
     2107         ,output v-value-date
     2108         ,output v-value-decimal
     2109         ,output v-value-integer
     2110         ,output v-value-logical
     2111         ,output v-value-type
     2112         ,input-output TABLE thbjattr_thbj-attr
     2113         ) no-error .
     2114     assign
     2115       v-fs-rar = v-value-character
     2116     .
     2117     run adm/shattri.p (
     2118          input "get":U
     2119         ,input '':U
     2120         ,input 0
     2121         ,input 'egais':U
     2122         ,input 'egais-exsys':U
     2123         ,output v-value-character
     2124         ,output v-value-date
     2125         ,output v-value-decimal
     2126         ,output v-value-integer
     2127         ,output v-value-logical
     2128         ,output v-value-type
     2129         ,input-output TABLE thbjattr_thbj-attr
     2130         ) no-error .
     2131     assign v-ext-sys = v-value-integer.
     2132     create browse browse-hdl-egais-goods
     2133       assign
     2134       title     = 'Товары'
     2135       frame     = frame Dialog-Frame:handle
     2136       query     = qh-egais-goods
     2137       x         = 10
     2138       y         = 70
     2139       width     = 107
     2140       height    = 21.5
     2141       visible   = true
     2142       read-only = true
     2143       sensitive = true
     2144       separators = true
     2145       column-resizable = true
     2146       triggers:
     2147         on mouse-move-dblclick persistent run msdblcl.
     2148         on row-display persistent run proc-row-disp.
     2149       end triggers
     2150       .
     2151     extGdsObj = new ExtGds (yes).
     2152     extGdsObj:DbNum = v-db-num.
     2153     extGdsObj:GetHndlTable(0, "", input-output bh-egais-goods).
     2154     create query qh-egais-goods.
     2155     qh-egais-goods:set-buffers (bh-egais-goods).
     2156     browse-hdl-egais-goods:query = qh-egais-goods.
     2157     extent (bcol) = bh-egais-goods:num-fields.
     2158     do ii = 1 to bh-egais-goods:num-fields:
     2159       bcol[ii] = browse-hdl-egais-goods:add-like-column('tt-egaisgds-hndls' + '.' + bh-egais-goods:buffer-field (ii):name, 0, 'FILL-IN').
     2160       if entry (ii, extGdsObj:SettingsTTList, ';') <> ""
     2161       then do:
     2162         v-windth = integer (entry (1, entry (ii, extGdsObj:SettingsTTList, ';'))).
     2163         v-isDisp = entry (2, entry (ii, extGdsObj:SettingsTTList, ';')).
     2164         assign
     2165           bcol[ii]:width = v-windth when v-windth > 0
     2166           bcol[ii]:visible = false when v-isDisp = "no"
     2167         .
     2168       end.
     2169     end.
     2170   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2171   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2172   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2173   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2174   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2175   define variable v-diasize-current-frame-height as decimal   no-undo .
     2176   define variable v-diasize-change-size          as logical   no-undo .
     2177   define variable v-diasize-resize-button        as handle    no-undo .
     2178   define variable v-diasize-wndmax               as logical   no-undo .
     2179   define variable v-diasize-wndstore             as logical   no-undo .
     2180   define variable v-diasize-proc-name            as character no-undo .
     2181   define variable v-diasize-browse-handle        as handle    no-undo .
     2182   define variable v-diasize-browse-number        as integer   no-undo .
     2183   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2184   define temp-table temp-diasize-handle no-undo
     2185     field handle-value  as handle
     2186     field save-position as decimal
     2187     index xpk is primary unique handle-value
     2188     .
     2189   define temp-table temp-browse-handle no-undo
     2190     field browse-type   as character
     2191     field browse-number as integer
     2192     field browse-handle as handle
     2193     field original-size as decimal
     2194     index xpk is primary unique browse-type browse-number
     2195     index xie browse-type browse-handle
     2196   .
     2197   procedure diasize_change-height :
     2198     define input  parameter p-change-value  as decimal   no-undo .
     2199     define input  parameter p-move-resize   as logical   no-undo .
     2200     define variable v-field-group-handle    as handle    no-undo .
     2201     define variable v-object-handle         as handle    no-undo .
     2202     define variable v-frame-height          as decimal   no-undo .
     2203     define variable v-frame-virtual-height  as decimal   no-undo .
     2204     define variable v-browse-height         as decimal   no-undo .
     2205     define variable v-window-height         as decimal   no-undo .
     2206     define variable v-window-virtual-height as decimal   no-undo .
     2207     define variable v-change-sign           as integer   no-undo .
     2208     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2209     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2210     if p-change-value > 0
     2211     then do:
     2212       if frame Dialog-Frame :height + p-change-value
     2213           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2214       then do:
     2215         assign
     2216           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2217                           - (frame Dialog-Frame :height-chars)
     2218         .
     2219         if p-change-value <= 0
     2220         then do:
     2221           run diasize_position-resize-button in this-procedure .
     2222           return .
     2223         end.
     2224       end.
     2225     end.
     2226     if p-change-value < 0
     2227     then do:
     2228       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2229       then do:
     2230         assign
     2231           p-change-value = v-diasize-orig-frame-height
     2232                          - (frame Dialog-Frame :height-chars)
     2233         .
     2234         if p-change-value >= 0
     2235         then do:
     2236           run diasize_position-resize-button in this-procedure .
     2237           return .
     2238         end.
     2239       end.
     2240     end.
     2241     if p-change-value >= 0
     2242     then do:
     2243       assign
     2244         v-change-sign = 1
     2245       .
     2246     end.
     2247     else do:
     2248       assign
     2249         v-change-sign = -1
     2250       .
     2251     end.
     2252     assign
     2253       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2254     .
     2255     if p-change-value = 0
     2256     then do:
     2257       run diasize_position-resize-button in this-procedure .
     2258       return .
     2259     end.
     2260     move_block:
     2261     do
     2262     on error undo move_block, retry move_block
     2263     :
     2264       if retry
     2265       then do:
     2266         do
     2267         on error undo move_block, leave move_block
     2268         :
     2269           if p-change-value > 0
     2270           then do:
     2271             for each buf_temp-diasize-handle
     2272             on error undo, next
     2273             :
     2274               assign
     2275                 v-object-handle = buf_temp-diasize-handle.handle-value
     2276               .
     2277               if v-object-handle <> v-diasize-resize-button
     2278               then do:
     2279                 assign
     2280                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2281                 .
     2282               end.
     2283             end.
     2284             assign
     2285               v-diasize-browse-handle :height = v-browse-height
     2286             .
     2287             for each buf_temp-browse-handle
     2288               where buf_temp-browse-handle.browse-type = 'height':u
     2289             on error undo, next
     2290             :
     2291               assign
     2292                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2293               .
     2294             end.
     2295             assign
     2296               frame Dialog-Frame :height = v-frame-height
     2297             .
     2298             if frame Dialog-Frame :scrollable = true
     2299             then do:
     2300               assign
     2301                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2302               .
     2303             end.
     2304             run diasize_position-resize-button in this-procedure .
     2305           end.
     2306           else do:
     2307             if frame Dialog-Frame :scrollable = true
     2308             then do:
     2309               assign
     2310                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2311               .
     2312             end.
     2313             assign
     2314               frame Dialog-Frame :height = v-frame-height
     2315             .
     2316             assign
     2317               v-diasize-browse-handle :height = v-browse-height
     2318             .
     2319             for each buf_temp-browse-handle
     2320               where buf_temp-browse-handle.browse-type = 'height':u
     2321             on error undo, next
     2322             :
     2323               assign
     2324                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2325               .
     2326             end.
     2327             for each buf_temp-diasize-handle
     2328             on error undo, next
     2329             :
     2330               assign
     2331                 v-object-handle = buf_temp-diasize-handle.handle-value
     2332               .
     2333               if v-object-handle <> v-diasize-resize-button
     2334               then do:
     2335                 assign
     2336                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2337                 .
     2338               end.
     2339             end.
     2340             run diasize_position-resize-button in this-procedure .
     2341           end.
     2342           assign
     2343             v-diasize-change-size = false
     2344           .
     2345           leave move_block .
     2346         end.
     2347       end.
     2348       assign
     2349         v-diasize-need-full-display = true
     2350       .
     2351       if v-diasize-change-size = false
     2352       then do:
     2353         assign
     2354           v-diasize-change-size = true
     2355         .
     2356       end.
     2357       else do:
     2358         return .
     2359       end.
     2360       assign
     2361         v-frame-height = frame Dialog-Frame :height
     2362         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2363         v-browse-height = v-diasize-browse-handle :height
     2364       .
     2365       for each buf_temp-browse-handle
     2366         where buf_temp-browse-handle.browse-type = 'height':u
     2367       :
     2368         assign
     2369           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2370         .
     2371       end.
     2372       for each buf_temp-diasize-handle
     2373       :
     2374         delete buf_temp-diasize-handle .
     2375       end.
     2376       assign
     2377         v-field-group-handle = frame Dialog-Frame :first-child
     2378       .
     2379       do while valid-handle(v-field-group-handle)
     2380       :
