     2781               where buf_temp-browse-handle.browse-type   = 'width':u
     2782                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2783               no-error .
     2784             if available buf_temp-browse-handle
     2785             then do:
     2786             end.
