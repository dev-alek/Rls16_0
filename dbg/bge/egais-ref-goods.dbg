     2513         on error undo move_block, retry move_block
     2514         :
     2515           assign
     2516             buf_temp-browse-handle.browse-handle :height
     2517               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2518             no-error .
     2519           if error-status :error
     2520           or error-status :get-message(1) <> ""
     2521           then do:
