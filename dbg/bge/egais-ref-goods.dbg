     2447         or error-status :get-message(1) <> ""
     2448         then do:
     2449           undo move_block, retry move_block .
     2450         end.
     2451         for each buf_temp-browse-handle
     2452           where buf_temp-browse-handle.browse-type = 'height':u
     2453         on error undo move_block, retry move_block
     2454         :
     2455           assign
