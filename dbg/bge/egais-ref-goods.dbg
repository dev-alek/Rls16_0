     2383         .
     2384         do while valid-handle(v-object-handle)
     2385         :
     2386           if  v-object-handle <> v-diasize-browse-handle :handle
     2387           and can-query(v-object-handle, "row")
     2388           and can-query(v-object-handle, "height")
     2389           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2390           then do:
     2391             find first buf_temp-browse-handle
     2392               where buf_temp-browse-handle.browse-type   = 'height':u
     2393                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2394               no-error .
     2395             if available buf_temp-browse-handle
     2396             then do:
     2397             end.
     2398             else do:
     2399               create buf_temp-diasize-handle .
     2400               assign
     2401                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2402                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2403               .
     2404             end.
     2405           end.
     2406           assign
     2407             v-object-handle = v-object-handle :next-sibling
     2408           .
     2409         end.
     2410         assign
     2411           v-field-group-handle = v-field-group-handle :next-sibling
     2412         .
     2413       end.
     2414       do with frame Dialog-Frame
     2415       :
     2416         hide v-diasize-resize-button .
     2417         assign
     2418           v-diasize-resize-button :row    = 1
     2419           v-diasize-resize-button :column = 1
     2420         .
     2421       end.
     2422       if p-change-value > 0
     2423       then do:
     2424         if frame Dialog-Frame :scrollable = true
     2425         then do:
     2426           assign
     2427             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2428             no-error .
     2429           if error-status :error
     2430           or error-status :get-message(1) <> ""
     2431           then do:
     2432             undo move_block, retry move_block .
     2433           end.
     2434         end.
     2435         assign
     2436           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2437           no-error .
     2438         if error-status :error
     2439         or error-status :get-message(1) <> ""
     2440         then do:
     2441           undo move_block, retry move_block .
     2442         end.
     2443         assign
     2444           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2445           no-error .
