      899   define variable v-bge-xml-shift-mode    as logical           no-undo.
      900   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      901   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      902   define variable v-bge-xml-log-file-name as character    no-undo.
      903   define variable v-bge-xml-dbf-file-name as character    no-undo.
      904   define variable v-bge-xml-db-num-str    as character    no-undo .
      905   define variable v-bge-xml-static-log-file-name as character    no-undo.
