      597   procedure xmlchar-decode :
      598   define input parameter p-in-string      as character        no-undo.
      599   define output parameter p-out-string    as character        no-undo.
      600       define variable v-position      as integer      no-undo.
      601       define variable v-last-position as integer      no-undo.
      602       define variable v-temp-integer  as integer      no-undo.
      603       define variable v-current-char  as character    no-undo.
      604       define variable v-next-char     as character    no-undo.
      605       define variable v-success       as logical      no-undo.
      606   do
      607   on error undo, return error
      608   :
      609       assign
      610           p-out-string = "":U
      611           v-position   = 0
      612       .
      613       replace-cycle:
      614       do while yes
      615       on error undo, return error
      616       :
      617           assign
      618               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      619           .
      620           if v-last-position <= v-position
      621           then do:
      622               if v-position = 0
      623               then do:
      624                   assign
      625                       p-out-string = p-in-string
      626                   .
      627               end.
      628               else do:
      629                   assign
      630                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      631                   .
      632               end.
      633               leave replace-cycle.
      634           end.
      635           else do:
      636               assign
      637                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      638                   v-position      = v-last-position
      639                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      640               .
      641               if v-current-char = "#":U
      642               then do:
      643                   assign
      644                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      645                   .
      646                   if v-last-position > 0
      647                   then do:
      648                       run xmlchar-read-integer in this-procedure
      649                        (
      650                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      651                           , output v-temp-integer
      652                           , output v-success
      653                       ).
      654                       if v-success = yes
      655                       and v-temp-integer >= 1
      656                       and v-temp-integer <= 255
      657                       then do:
      658                           assign
      659                               p-out-string = p-out-string + chr( v-temp-integer )
      660                               v-position   = v-last-position + 1
      661                           .
      662                       end.
      663                       else do:
      664                           assign
      665                               p-out-string = p-out-string + "&":U
      666                               v-position   = v-position   + 1
      667                           .
      668                       end.
      669                   end.
      670                   else do:
      671                       assign
      672                           p-out-string = p-out-string + "&":U
      673                           v-position   = v-position   + 1
      674                       .
      675                   end.
      676               end.
      677               else do:
      678                   case substring( p-in-string, v-position + 1, 3 )
      679                   :
      680                       when "lt;":U
      681                       then do:
      682                           assign
      683                               p-out-string = p-out-string + "<":U
      684                               v-position   = v-position   + 3
      685                           .
      686                       end.
      687                       when "gt;":U
      688                       then do:
      689                           assign
      690                               p-out-string = p-out-string + ">":U
      691                               v-position   = v-position   + 3
      692                           .
      693                       end.
      694                       otherwise do:
      695                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      696                           then do:
      697                               assign
      698                                   p-out-string = p-out-string + "&":U
      699                                   v-position   = v-position   + 4
      700                               .
      701                           end.
      702                           else do:
      703                               case substring( p-in-string, v-position + 1, 5 )
      704                               :
      705                                   when "quot;":U
      706                                   then do:
      707                                       assign
      708                                           p-out-string = p-out-string + '"':U
      709                                           v-position   = v-position   + 5
      710                                       .
      711                                   end.
      712                                   when "apos;":U
      713                                   then do:
      714                                       assign
      715                                           p-out-string = p-out-string + "'":U
      716                                           v-position   = v-position   + 5
      717                                       .
      718                                   end.
      719                                   otherwise do:
      720                                       assign
      721                                           p-out-string = p-out-string + "&":U
      722                                       .
      723                                   end.
      724                               end case.
      725                           end.
      726                       end.
      727                   end case.
      728               end.
      729           end.
      730       end.
      731   end.
      732   end .
      733   procedure xmlchar-read-integer :
      734   define input parameter p-input-string      as character        no-undo.
      735   define output parameter p-output-integer   as integer          no-undo.
      736   define output parameter p-success       as logical          no-undo.
      737   do
      738   on error undo, return error
      739   :
      740       assign
      741           p-output-integer = integer( p-input-string )
      742       no-error.
      743       if error-status :error
      744       then do:
      745           assign
      746               p-success           = no
      747               p-output-integer    = 0
      748           .
      749       end.
      750       else do:
      751           assign
      752               p-success           = yes
      753           .
      754       end.
      755   end.
      756   end.
      757   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   procedure strtdate :
      759     define input  parameter p-str         as character no-undo .
      760     define output parameter p-value       as date      no-undo .
      761     define output parameter p-data-valid  as logical   no-undo .
      762     define output parameter p-message     as character no-undo .
      763   do
      764   on error undo, return error return-value
      765   :
      766     define variable v-value       as date      no-undo .
      767     define variable v-i           as integer   no-undo .
      768     define variable v-num         as integer   no-undo .
      769     define variable v-delim       as character no-undo .
      770     define variable v-delim-list  as character no-undo .
      771     define variable v-day         as integer   no-undo .
      772     define variable v-month       as integer   no-undo .
      773     define variable v-year        as integer   no-undo .
      774     define variable v-day-str     as character no-undo .
      775     define variable v-month-str   as character no-undo .
      776     define variable v-year-str    as character no-undo .
      777     assign
      778       p-value       = ?
      779       p-data-valid  = false
      780     .
      781     if p-str = ?
      782     then do:
      783       assign
      784         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      785       .
      786       return .
      787     end.
      788     if p-str = ""
      789     then do:
      790       assign
      791         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      792       .
      793       return .
      794     end.
      795     if length(p-str)  > 10
      796     then do:
      797       assign
      798         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      799       .
      800       return .
      801     end.
      802     assign
      803       v-delim-list = '/,-,.':U
      804     .
      805     _delim:
      806     do v-i = 1 to num-entries( v-delim-list )
      807     :
      808       assign
      809         v-delim = entry( v-i , v-delim-list )
      810         v-num   = num-entries( p-str , v-delim )
      811       .
      812       if v-num <> 3
      813       then do:
      814         assign
      815           v-delim = ''
      816         .
      817       end.
      818       else do:
      819         leave _delim.
      820       end.
      821     end.
      822     if v-delim = ''
      823     then do:
      824       assign
      825         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      826       .
      827       return .
      828     end.
      829     assign
      830       v-day-str   = entry( 1, p-str , v-delim)
      831       v-month-str = entry( 2, p-str , v-delim)
      832       v-year-str  = entry( 3, p-str , v-delim)
      833     .
      834     if  length(v-day-str) > 2   or
      835         length(v-day-str) < 1   or
      836         length(v-month-str) > 2 or
      837         length(v-month-str) < 1 or
      838         (
      839           length(v-year-str) <> 2 and
      840           length(v-year-str) <> 4
      841         )
      842     then do:
      843       assign
      844         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      845       .
      846       return .
      847     end.
      848     if length( v-year-str ) = 2
      849     then do:
      850       assign
      851         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      852       .
      853     end.
      854     assign
      855       v-day   = integer( v-day-str )
      856       v-month = integer( v-month-str)
      857       v-year  = integer( v-year-str)
      858     no-error .
      859     if error-status :error
      860     then do:
      861       assign
      862         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      863       .
      864       return .
      865     end.
      866     if v-day < 1  or
      867        v-day > 31 or
      868        v-month < 1 or
      869        v-month > 12 or
      870        v-year < 0   or
      871        v-year > 5000
      872     then do:
      873       assign
      874         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      875       .
      876       return .
      877     end.
      878     assign
      879       v-value = date( v-month, v-day, v-year )
      880     no-error .
      881     if error-status :error
      882     then do:
      883       assign
      884         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      885       .
      886       return .
      887     end.
      888     assign
      889       p-value       = v-value
      890       p-data-valid  = true
      891     .
      892   end.
      893   end procedure.
      894   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      895   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
