       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   procedure cur-time :
       97      define output parameter p-today as date      no-undo .
       98      define output parameter p-time  as integer   no-undo .
       99     do
      100     on error undo, return error
      101     :
      102       define variable v-date1 as date      no-undo .
      103       define variable v-date2 as date      no-undo .
      104       define variable v-time  as integer   no-undo .
      105       assign
      106         v-date1 = today
      107         v-time  = time
      108         v-date2 = today
      109       .
      110       if v-date1 <> v-date2
      111       then do:
      112         assign
      113           v-date1 = today
      114           v-time  = v-time
      115         .
      116       end.
      117       assign
      118         p-today = v-date1
      119         p-time  = v-time
      120       .
      121     end.
      122   end.
      123   function cur-time-date returns character
      124   :
      125     return string(today, '99/99/9999':U) .
      126   end.
      127   function cur-time-mjd returns decimal
      128   :
      129     define variable v-date as date      no-undo .
      130     define variable v-time as integer   no-undo .
      131     run cur-time in this-procedure
      132       (output v-date
      133       ,output v-time
      134       ) .
      135     return integer(v-date) - 2400002 + (v-time / 86400) .
      136   end.
      137   function cur-time-get-ending-index returns integer
      138   (input p-number as integer
      139   )
      140   :
      141     if p-number < 0
      142     or p-number = ?
      143     then do:
      144       return 1 .
      145     end.
      146     define variable v-rest as integer   no-undo .
      147     assign
      148       p-number = p-number modulo 100
      149     .
      150     if p-number < 20
      151     then do:
      152       assign
      153         v-rest = p-number
      154       .
      155     end.
      156     else do:
      157       assign
      158         v-rest = p-number modulo 10
      159       .
      160     end.
      161     case v-rest :
      162       when 1
      163       then do:
      164         return 2 .
      165       end.
      166       when 2 or
      167       when 3 or
      168       when 4
      169       then do:
      170         return 3 .
      171       end.
      172       otherwise do:
      173         return 1 .
      174       end.
      175     end case .
      176   end.
      177   procedure cur-time-mjd-to-date :
      178      define input  parameter i-mjd-diff as decimal no-undo.
      179      define output parameter o-Date     as date    no-undo.
      180      define output parameter o-Time     as integer no-undo.
      181      define variable v-day-number as integer   no-undo .
      182      if    i-mjd-diff < 0
      183         or i-mjd-diff = ?
      184      then do:
      185         return "?" .
      186      end.
      187      assign
      188         v-day-number = truncate(i-mjd-diff,0).
      189         o-Date = date(v-day-number + 2400002).
      190         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192   end.
      193   function cur-time-mjd-to-string returns character
      194   (input p-mjd-diff as decimal
      195   )
      196   :
      197     define variable v-day-number as integer   no-undo .
      198     define variable v-seconds    as integer   no-undo .
      199     define variable v-hour       as integer   no-undo .
      200     define variable v-min        as integer   no-undo .
      201     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      202     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      203     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      204     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      205     if p-mjd-diff < 0
      206     or p-mjd-diff = ?
      207     then do:
      208       return "?" .
      209     end.
      210     assign
      211       v-day-number = integer(truncate(p-mjd-diff,0))
      212       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      213     .
      214     if v-seconds > 86400
      215     then do:
      216       assign
      217         v-seconds = 86400 - 1
      218       .
      219     end.
      220     if v-seconds < 0
      221     then do:
      222       assign
      223         v-seconds = 0
      224       .
      225     end.
      226     assign
      227       v-hour = truncate(v-seconds / 3600, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 3600
      231     .
      232     assign
      233       v-min = truncate(v-seconds / 60, 0)
      234     .
      235     assign
      236       v-seconds = v-seconds modulo 60
      237     .
      238     return
      239         (if v-day-number <> 0
      240           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0
      244           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      245           else ""
      246         )
      247       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      248           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      249           else ""
      250         )
      251       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      252       .
      253   end.
      254   function cur-time-string returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      263   end.
      264   function cur-time-string-sec returns character
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      273   end.
      274   function cur-time-custom  returns character
      275   (input p-prefix as character
      276   ,input p-date-format as character
      277   ,input p-delimiter as character
      278   ,input p-time-format as character
      279   ,input p-suffix as character
      280   )
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return
      289       p-prefix
      290       + string(v-date, p-date-format)
      291       + p-delimiter
      292       + string(v-time, p-time-format)
      293       + p-suffix
      294       .
      295   end.
      296   function cur-time-print  returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      305   end.
      306   function cur-time-datetime returns datetime
      307   :
      308     define variable v-char as character no-undo .
      309     define variable v-datetime as datetime no-undo .
      310     v-char = cur-time-string().
      311     v-datetime = datetime(v-char).
      312     return  v-datetime.
      313   end.
      314   function cur-time-string-msec returns character
      315   :
      316     define variable v-date as datetime  no-undo .
      317     v-date = now.
      318     return string(v-date) .
      319   end.
      320   define variable vss-include-info2 as character format "X(65)" no-undo
      321   initial "@(#)$Workfile$ $Revision$".
      322   procedure xmlchar-test :
      323   define input parameter p-in-string          as character        no-undo.
      324   define output parameter p-out-string-enc    as character        no-undo.
      325   define output parameter p-out-string-dec    as character        no-undo.
      326   do
      327   on error undo, return error
      328   :
      329          run xmlchar-encode in this-procedure
      330       (
      331             input p-in-string
      332           , output p-out-string-enc
      333       ).
      334          run xmlchar-decode in this-procedure
      335       (
      336             input p-out-string-enc
      337           , output p-out-string-dec
      338       ).
      339   end.
      340   end .
      341   procedure xmlchar-encode :
      342   define input parameter p-in-string      as character        no-undo.
      343   define output parameter p-out-string    as character        no-undo.
      344       define variable v-position      as integer      no-undo.
      345       define variable v-current-char  as character    no-undo.
      346   do
      347   on error undo, return error
      348   :
      349       assign
      350           p-out-string = "":U
      351       .
      352       case p-in-string
      353       :
      354           when ?
      355           then do:
      356               assign
      357                   p-out-string = "?":U
      358               .
      359           end.
      360           when "?":U
      361           then do:
      362               assign
      363                   p-out-string = "&#63;":U
      364               .
      365           end.
      366           otherwise do:
      367               do v-position = 1 to length( p-in-string )
      368               :
      369                   assign
      370                       v-current-char = substring( p-in-string, v-position, 1 )
      371                   .
      372                   case v-current-char
      373                   :
      374                       when "&":U
      375                       then do:
      376                           assign
      377                               p-out-string = p-out-string + "&amp;":U
      378                           .
      379                       end.
      380                       when ">":U
      381                       then do:
      382                           assign
      383                               p-out-string = p-out-string + "&gt;":U
      384                           .
      385                       end.
      386                       when "<":U
      387                       then do:
      388                           assign
      389                               p-out-string = p-out-string + "&lt;":U
      390                           .
      391                       end.
      392                       when "'":U
      393                       then do:
      394                           assign
      395                               p-out-string = p-out-string + "&apos;":U
      396                           .
      397                       end.
      398                       when '"':U
      399                       then do:
      400                           assign
      401                               p-out-string = p-out-string + "&quot;":U
      402                           .
      403                       end.
      404                       when chr(1)
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + "":U
      408                           .
      409                       end.
      410                       when chr(2)
      411                       then do:
      412                           assign
      413                               p-out-string = p-out-string + "":U
      414                           .
      415                       end.
      416                       when chr(3)
      417                       then do:
      418                           assign
      419                               p-out-string = p-out-string + "":U
      420                           .
      421                       end.
      422                       when chr(4)
      423                       then do:
      424                           assign
      425                               p-out-string = p-out-string + "":U
      426                           .
      427                       end.
      428                       when chr(5)
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "":U
      432                           .
      433                       end.
      434                       when chr(6)
      435                       then do:
      436                           assign
      437                               p-out-string = p-out-string + "":U
      438                           .
      439                       end.
      440                       when chr(7)
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "":U
      444                           .
      445                       end.
      446                       when chr(8)
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "":U
      450                           .
      451                       end.
      452                       when chr(9)
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "":U
      456                           .
      457                       end.
      458                       when chr(29)
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "":U
      462                           .
      463                       end.
      464                       when chr(10)
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "&#10;":U
      468                           .
      469                       end.
      470                       when chr(13)
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "&#13;":U
      474                           .
      475                       end.
      476                       otherwise do:
      477                           assign
      478                               p-out-string = p-out-string + v-current-char
      479                           .
      480                       end.
      481                   end case.
      482               end.
      483           end.
      484       end case.
      485   end.
      486   end .
