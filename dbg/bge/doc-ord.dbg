      994   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      995                                             INPUT iFlagEmpty AS INTEGER).
      996       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      997       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      998           DO:
      999               IF iFlagEmpty = 0                           THEN RETURN "".
     1000               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1001               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1002               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1003               ELSE RETURN "".
     1004           END.
     1005       ELSE DO:
     1006           run xmlchar-encode in this-procedure (
     1007                 input sToPlace
     1008               , output sToPlace
     1009           ).
     1010           ASSIGN
     1011               sToPlace = sParName + '="' + sToPlace + '"'
     1012           .
     1013           RETURN sToPlace.
     1014       END.
     1015   END FUNCTION.
     1016   function bge-xml-date returns character
     1017   ( input p-date as date )
     1018   :
     1019     define variable v-date-str as character no-undo .
     1020     run bge-xml-date-to-str in this-procedure ( input   p-date
     1021                                               , output  v-date-str
     1022                                               ) .
     1023     return v-date-str.
     1024   end function.
     1025   function bge-xml-str-date returns character
     1026   ( input p-date-str as character )
     1027   :
     1028     define variable v-date-str as character no-undo .
     1029     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1030                                                   , output  v-date-str
     1031                                                   ) .
     1032     return v-date-str.
     1033   end function.
     1034   function bge-xml-normalize-dec returns decimal
     1035   ( input p-val as decimal )
     1036   :
     1037     return (if p-val = ? then 0 else p-val) .
     1038   end function.
     1039   PROCEDURE wp-XMLTagOpen:
     1040   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1041   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1042   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1043       define variable v-out-string    as character    no-undo.
     1044   do
     1045   on error undo, return error
     1046   :
     1047       if v-bge-xml-bgefmt = "dbf":U
     1048       then do:
     1049       end.
     1050       else do:
     1051           assign
     1052               v-out-string = substitute( "&1&2<&3&4>"
     1053                                       , chr(10)
     1054                                       , fill( " ":U, 4 * iTagLevel)
     1055                                       , sTagName
     1056                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1057                               )
     1058           .
     1059           put stream stmXMLOut unformatted
     1060               v-out-string
     1061           .
     1062       end.
     1063   end.
     1064   END PROCEDURE.
     1065   PROCEDURE wp-XMLTagPut:
     1066     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1067     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1068     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1069     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1070       define variable v-out-string    as character    no-undo.
     1071   do
     1072   on error undo, return error
     1073   :
     1074       if v-bge-xml-bgefmt = "dbf":U
     1075       then do:
     1076           if v-bge-xml-dbf-file-name <> "":U
     1077           then do:
     1078               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1079               export stream stmXMLOut
     1080                   sTagName
     1081                   sParValue
     1082               .
     1083               output stream stmXMLOut close.
     1084           end.
     1085       end.
     1086       else do:
     1087           IF  iFlagEmpty = 1
     1088           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1089           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1090           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1091           THEN DO:
     1092               run xmlchar-encode in this-procedure (
     1093                   input sParValue
     1094                   , output sParValue
     1095               ).
     1096               assign
     1097                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1098                                               , chr(10)
     1099                                               , FILL(" ", 4 * iTagLevel)
     1100                                               , sTagName
     1101                                               , sParValue
     1102                               )
     1103               .
     1104               PUT STREAM stmXMLOut UNFORMATTED
     1105                   v-out-string
     1106               .
     1107           END.
     1108       end.
     1109   end.
     1110   END PROCEDURE.
     1111   PROCEDURE wp-XMLTagClose:
     1112   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1113   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1114       define variable v-out-string    as character    no-undo.
     1115   do
     1116   on error undo, return error
     1117   :
     1118       if v-bge-xml-bgefmt = "dbf":U
     1119       then do:
     1120       end.
     1121       else do:
     1122           assign
     1123               v-out-string = substitute( "&1&2</&3>"
     1124                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1125                                   , fill( " ", 4 * iTagLevel )
     1126                                   , sTagName
     1127                           )
     1128           .
     1129           PUT STREAM stmXMLOut UNFORMATTED
     1130               v-out-string
     1131           .
     1132       end.
     1133   end.
     1134   END PROCEDURE.
     1135   PROCEDURE wp-XMLWriteLog:
     1136     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1137     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1138     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1139   define variable v-str              as character no-undo .
     1140   define variable v-error-append     as logical   no-undo .
     1141   define variable v-error-append-msg as character no-undo .
     1142   assign
     1143     v-str = chr(10)
     1144             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1145             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1146     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1147     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1148     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1149   .
     1150   run bge/bge-log.p (input v-str) no-error .
     1151   if error-status:error then do:
     1152     assign
     1153       v-error-append     = yes
     1154       v-error-append-msg = return-value
     1155     .
     1156   end.
     1157   run gbl/fileapnd.p
     1158     ( input sFileName
     1159     , input v-str
     1160     , input 10
     1161     ) no-error .
     1162   if error-status:error then do:
     1163     assign
     1164       v-error-append     = yes
     1165       v-error-append-msg = substitute( "&1&2&3"
     1166                                       , v-error-append-msg
     1167                                       , chr(10)
     1168                                       , return-value
     1169                                       )
     1170     .
     1171   end.
     1172   if v-error-append
     1173   then do:
     1174     return error substitute( "&1" , v-error-append-msg ) .
     1175   end.
     1176   END PROCEDURE.
     1177   PROCEDURE wp-XMLWriteEDT:
     1178     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1179     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1180     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1181       if valid-handle ( hEDT )
     1182       then do:
     1183           hEDT :move-to-eof().
     1184           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1185                                           OR sToWrite = "&Line") THEN "" ELSE
     1186                                           cur-time-string-sec() + " ").
     1187           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1188                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1189                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1190           hEDT :insert-string(chr(10)).
     1191       end.
     1192       process events.
     1193       output to 'bgescn.txt' append.
     1194           put unformatted
     1195               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1196                                           OR sToWrite = "&Line") THEN "" ELSE
     1197                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1198               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1199                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1200                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1201           .
     1202       output close.
     1203   END PROCEDURE.
     1204   PROCEDURE wp-XMLShowCNT:
     1205     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1206       if valid-handle( hCNT )
     1207       then do:
     1208           ASSIGN hCNT :VISIBLE = TRUE.
     1209       end.
     1210   END PROCEDURE.
     1211   PROCEDURE wp-XMLHideCNT:
     1212     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1213       if valid-handle( hCNT )
     1214       then do:
     1215           ASSIGN hCNT :VISIBLE = FALSE.
     1216       end.
     1217   END PROCEDURE.
     1218   PROCEDURE wp-XMLWriteCNT:
     1219     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1220     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1221       if valid-handle( hCNT )
     1222       then do:
     1223           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1224       end.
     1225   END PROCEDURE.
     1226   procedure bge-xml-write-header:
     1227   do
     1228   on error undo, return error
     1229   :
     1230   define input parameter p-xml-file-name  as character        no-undo.
     1231   define input parameter p-doc-name       as character        no-undo.
     1232   define input parameter p-version        as character        no-undo.
     1233   define input parameter p-db-num         as integer          no-undo.
     1234   define input parameter p-date-from      as date             no-undo.
     1235   define input parameter p-shift-num-from as integer          no-undo.
     1236   define input parameter p-date-to        as date             no-undo.
     1237   define input parameter p-shift-num-to   as integer          no-undo.
     1238   define input parameter p-obj-list       as character        no-undo.
     1239   define input parameter p-doc-type-list  as character        no-undo.
     1240   define input parameter p-pay-code       as logical          no-undo.
     1241   define input parameter p-cst            as logical          no-undo.
     1242   define input parameter p-parts          as logical          no-undo.
     1243   define input parameter p-chk-pay-code   as logical          no-undo.
     1244   define input parameter p-pay-desk       as logical          no-undo.
     1245   define input parameter p-pay-desk-cards as logical          no-undo.
     1246   define input parameter p-deleted        as logical          no-undo.
     1247   define input parameter p-opened-docs    as logical          no-undo.
     1248   define variable v-out-string    as character    no-undo.
     1249   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1250   assign
     1251       v-out-string = substitute( "&1&2&3"
     1252                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1253                           , chr(10)
     1254                           , "<IBS_Trade_House>":U )
     1255   .
     1256   put stream stmXMLOut unformatted
     1257       v-out-string
     1258   .
     1259   run wp-XMLTagOpen(1, "header","").
     1260   if v-bge-xml-bgeflold = "oracle":u
     1261   then do:
     1262     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1263     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1264     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1265     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1266     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1267   end.
     1268   run wp-XMLTagOpen( 2, "manifest", "").
     1269   run wp-XMLTagOpen( 3, "document", "").
     1270   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1271   run wp-XMLTagput( 4, "description", "", 0).
     1272   run wp-XMLTagput( 4, "version", p-version, 0).
     1273   run wp-XMLTagclose( 3, "document" ).
     1274   run wp-XMLTagclose( 2, "manifest" ).
     1275   run wp-XMLTagclose( 1, "header" ).
     1276   run wp-XMLTagOpen(1, "options","").
     1277   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1278   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1279   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1280   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1281   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1282   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1283   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1284   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1285   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1286   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1287   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1288   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1289   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1290   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1291   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1292   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1293   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1294   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1295   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1296   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1297   run wp-XMLTagClose(1, "options").
     1298   run wp-XMLTagOpen( 1, "body", "" ).
     1299   output stream stmXMLOut close.
     1300   end.
     1301   end procedure.
     1302   procedure xml-bge-write-footer:
     1303   do
     1304   on error undo, return error return-value
     1305   :
     1306   define input parameter p-xml-file-name as character    no-undo.
     1307   define variable v-error-num     as integer           no-undo.
     1308   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1309   run wp-XMLTagClose( 1, "body" ).
     1310   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1311   output stream stmXMLOut close.
     1312   if v-bge-xml-bgeflold = "oracle":u
     1313   then do:
     1314     define variable v-tmp-file-name         as character no-undo .
     1315     define variable v-zip-file-name         as character no-undo .
     1316     define variable v-exch-file-name        as character no-undo .
     1317     define variable v-heap-file-name        as character no-undo .
     1318     define variable v-i                     as integer   no-undo .
     1319     define variable v-file-name             as character no-undo .
     1320     define variable v-arc                   as character no-undo .
     1321     define variable v-str                   as character no-undo .
     1322     define variable v-exch-tmp-file-name    as character no-undo .
     1323     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1324     define variable v-bge-xml-exch-dir      as character no-undo .
     1325     define variable v-bge-xml-heap-dir      as character no-undo .
     1326     define variable v-bge-xml-compress-heap as logical   no-undo .
     1327     define variable v-home-dir              as character no-undo .
     1328     define variable v-os-command            as character no-undo .
     1329     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1330     if v-home-dir = ?
     1331     then do:
     1332       undo, return error substitute( "&1&2&3"
     1333                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1334                                     , chr(10)
     1335                                     , "Обратитесь к администратору.":u
     1336                                     ).
     1337     end.
     1338     assign
     1339       v-home-dir = v-home-dir
     1340     .
     1341     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1342     if error-status :error
     1343     then do:
     1344       undo, return error substitute( "&1&2&3"
     1345                                     , "Неверно задан каталог экспорта.":u
     1346                                     , chr(10)
     1347                                     , "Обратитесь к администратору.":u
     1348                                     ).
     1349     end.
     1350     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1351     if v-bge-xml-exch-dir = ?
     1352     then do:
     1353       undo, return error substitute( "&1&2&3"
     1354                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1355                                     , chr(10)
     1356                                     , "Обратитесь к администратору.":u
     1357                                     ).
     1358     end.
     1359     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1360     if error-status :error
     1361     then do:
     1362       undo, return error substitute( "&1&2&3"
     1363                                     , "Неверно задан каталог экспорта (exch).":u
     1364                                     , chr(10)
     1365                                     , "Обратитесь к администратору.":u
     1366                                     ).
     1367     end.
     1368     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1369     if v-bge-xml-heap-dir = ?
     1370     then do:
     1371       undo, return error substitute( "&1&2&3"
     1372                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1373                                     , chr(10)
     1374                                     , "Обратитесь к администратору.":u
     1375                                     ).
     1376     end.
     1377     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1378     if error-status :error
     1379     then do:
     1380       undo, return error substitute( "&1&2&3"
     1381                                     , "Неверно задан каталог экспорта (heap).":u
     1382                                     , chr(10)
     1383                                     , "Обратитесь к администратору.":u
     1384                                     ).
     1385     end.
     1386     get-key-value section "BGE" key "heap-compress" value v-str.
     1387     assign
     1388       v-i = int(v-str)
     1389     no-error .
     1390     if v-i = ? or v-i = 0
     1391     then do:
     1392       assign
     1393         v-bge-xml-compress-heap = no
     1394       .
     1395     end.
     1396     else do:
     1397       assign
     1398         v-bge-xml-compress-heap = yes
     1399       .
     1400     end.
     1401     assign
     1402       v-arc = search( "exe/7za.exe":u )
     1403     .
     1404     if v-arc = ? or v-arc = ""
     1405     then do:
     1406       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1407     end.
     1408     assign
     1409       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1410       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1411       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1412       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1413       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1414       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1415       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1416     .
     1417     run gbl/del-file.p (input v-tmp-file-name) .
     1418     run gbl/del-file.p (input v-zip-file-name) .
     1419     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1420     if v-error-num > 0
     1421     then do:
     1422         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1423                                      , p-xml-file-name + "xm1":u
     1424                                      , v-tmp-file-name
     1425                                      , v-error-num
     1426                                      ).
     1427     end.
     1428     assign
     1429       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1430                                    , v-arc
     1431                                    , v-zip-file-name
     1432                                    , v-tmp-file-name
     1433                                    )
     1434     .
     1435     os-command silent value ( v-os-command ) .
     1436     run gbl/del-file.p (input v-heap-file-name) .
     1437     if v-bge-xml-compress-heap = no
     1438     then do:
     1439       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1440       if v-error-num > 0
     1441       then do:
     1442           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1443                                        , v-tmp-file-name
     1444                                        , v-heap-file-name
     1445                                        , v-error-num
     1446                                        ) .
     1447       end.
     1448     end.
     1449     else do:
     1450       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1451       if v-error-num > 0
     1452       then do:
     1453           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1454                                        , v-zip-file-name
     1455                                        , v-heap-file-name
     1456                                        , v-error-num
     1457                                        ) .
     1458       end.
     1459     end.
     1460     run gbl/del-file.p (input v-tmp-file-name) .
     1461     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1462     if error-status :error then do:
     1463       undo, return error substitute( "&1&2&3"
     1464                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1465                                     , chr(10)
     1466                                     , "Обратитесь к администратору."
     1467                                     ).
     1468     end.
     1469     run gbl/del-file.p (input v-exch-file-name) .
     1470     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1471     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1472     if v-error-num > 0
     1473     then do:
     1474       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1475                                     , v-zip-file-name
     1476                                     , v-exch-tmp-file-name
     1477                                     , v-error-num
     1478                                     ) .
     1479     end.
     1480     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1481     if v-error-num > 0
     1482     then do:
     1483       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1484                                     , v-exch-tmp-file-name
     1485                                     , v-exch-file-name
     1486                                     , v-error-num
     1487                                     ) .
     1488     end.
     1489     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1490   end.
     1491   else do:
     1492     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1493     if v-error-num > 0
     1494     then do:
     1495       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1496                                     , p-xml-file-name + "xm1"
     1497                                     , p-xml-file-name + "xml"
     1498                                     , v-error-num
     1499                                     ) .
     1500     end.
     1501   end.
     1502   if opsys = "unix"
     1503   then do:
     1504       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1505   end.
     1506   end.
     1507   end procedure.
     1508   procedure xml-bge-filename0:
     1509   define input parameter p-prefix   as character no-undo .
     1510   define input parameter p-name     as character no-undo .
     1511   define input parameter p-shared-process as logical no-undo .
     1512   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1513   define output parameter p-xml-file-name  as character no-undo .
     1514   // define output parameter p-fullfnamenoext as character no-undo .
     1515   define output parameter p-locked         as logical      no-undo.
     1516   define variable v-fullfnamenoext as character no-undo .
     1517   define variable v-fileext        as character no-undo .
     1518   define variable v-fullfname      as character no-undo .
     1519   define variable v-error-num      as integer   no-undo .
     1520   do
     1521   on error undo, return error
     1522   :
     1523     case v-bge-xml-bgeflold :
     1524       when "old" then do:
     1525         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1526         v-fileext       = ".xml":U .
     1527         v-fullfname     = v-fullfnamenoext + v-fileext .
     1528         p-xml-file-name = v-fullfname .
     1529         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1530         if v-error-num > 0 then do:
     1531           return error.
     1532         end.
     1533       end.
     1534       when "var" then do:
     1535         case p-prefix :
     1536           when "doc" then do:
     1537             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1538             v-fileext       = ".xml":U .
     1539             v-fullfname     = v-fullfnamenoext + v-fileext .
     1540             p-xml-file-name = v-fullfname .
     1541           end.
     1542           when "day" then do:
     1543             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1544             v-fileext       = ".xml":U .
     1545             v-fullfname     = v-fullfnamenoext + v-fileext .
     1546             p-xml-file-name = v-fullfname .
     1547           end.
     1548           otherwise do:
     1549             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1550             v-fileext       = ".xml":U .
     1551             v-fullfname     = v-fullfnamenoext + v-fileext .
     1552             p-xml-file-name = v-fullfname .
     1553           end.
     1554         end case.
     1555         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1556         if v-error-num > 0 then do:
     1557           return error.
     1558         end.
     1559       end.
     1560       when "new" then do:
     1561                   run bge/genfname.p (
     1562                       input p-home-dir
     1563                       , input p-prefix
     1564                       , input ""
     1565                       , input "xml"
     1566                       , input ""
     1567                       , output p-xml-file-name
     1568                   ).
     1569       end.
     1570       when "no-parameter" then do:
     1571         if p-shared-process then do:
     1572                       run bge/genfname.p (
     1573                           input p-home-dir
     1574                           , input "d"
     1575                           , input ""
     1576                           , input "xml"
     1577                           , input ""
     1578                           , output p-xml-file-name
     1579                       ).
     1580         end.
     1581         else do:
     1582           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1583           v-fileext       = ".xml":U .
     1584           v-fullfname     = v-fullfnamenoext + v-fileext .
     1585           p-xml-file-name = v-fullfname .
     1586           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1587           if v-error-num > 0 then do:
     1588             return error.
     1589           end.
     1590         end.
     1591       end.
     1592     end case.
     1593     assign
     1594       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1595       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1596     .
     1597   end .
     1598   end procedure .
     1599   procedure xml-bge-filename :
     1600   do
     1601   on error undo, return error
     1602   :
     1603   define input parameter p-prefix             as character    no-undo.
     1604   define input parameter p-name               as character    no-undo.
     1605   define input parameter p-shared-process     as logical      no-undo.
     1606   define output parameter p-xml-file-name     as character    no-undo.
     1607   define output parameter p-log-file-name     as character    no-undo.
     1608   define output parameter p-locked            as logical      no-undo.
     1609   define variable v-home-dir          as character no-undo .
     1610   define variable v-error-num         as integer   no-undo .
     1611   define variable v-bge-xml-heap-dir  as character no-undo .
     1612       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1613       if v-home-dir = ?
     1614       then do:
     1615           message
     1616             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1617             skip(1)
     1618             skip "Обратитесь к администратору."
     1619           view-as alert-box error.
     1620           undo, return error .
     1621       end.
     1622       if v-bge-xml-bgeflold <> "oracle"
     1623       then do:
     1624         assign
     1625             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1626         .
     1627       end.
     1628       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1629       if error-status :error
     1630       then do:
     1631           message
     1632             skip "Неверно задан каталог экспорта."
     1633             skip(1)
     1634             skip "Обратитесь к администратору."
     1635           view-as alert-box error.
     1636           undo, return error .
     1637       end.
     1638       if v-bge-xml-bgefmt = "dbf":U
     1639       then do:
     1640           assign
     1641               p-xml-file-name = v-home-dir
     1642               p-locked        = no
     1643           .
     1644       end.
     1645       else do:
     1646           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1647             output p-xml-file-name, output p-locked) .
     1648       end.
     1649       if v-bge-xml-bgeflold = "oracle"
     1650       then do:
     1651         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1652         if v-bge-xml-heap-dir = ?
     1653         then do:
     1654           undo, return error substitute( "&1&2&3"
     1655                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1656                                         , chr(10)
     1657                                         , "Обратитесь к администратору.":u
     1658                                         ).
     1659         end.
     1660         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1661         if error-status :error
     1662         then do:
     1663           undo, return error substitute( "&1&2&3"
     1664                                         , "Неверно задан каталог экспорта (heap).":u
     1665                                         , chr(10)
     1666                                         , "Обратитесь к администратору.":u
     1667                                         ).
     1668         end.
     1669         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1670           assign
     1671             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1672           .
     1673         end.
     1674         else do:
     1675           assign
     1676             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1677           .
     1678         end.
     1679       end.
     1680       else do:
     1681         assign
     1682             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1683         .
     1684       end.
     1685       assign
     1686          v-bge-xml-static-log-file-name = p-log-file-name
     1687       .
     1688   end.
     1689   end procedure.
     1690   procedure bge-xml-read-config :
     1691   do
     1692   on error undo, return error return-value
     1693   :
     1694   define input  parameter p-last-date as date      no-undo .
     1695   define input  parameter p-db-num    as integer   no-undo .
     1696       define variable v-bgeclall      as character     no-undo.
     1697       define variable v-bgedict       as character     no-undo.
     1698       define variable v-bgeshift      as character     no-undo.
     1699       define variable v-par-type      as character     no-undo.
     1700       define variable v-bgeflnm       as character     no-undo.
     1701       define variable v-bgecliiv      as character     no-undo .
     1702       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1703       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1704       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1705       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1706       define variable v-db-num-str    as character     no-undo .
     1707       define variable v-param-type      as character  no-undo .
     1708       define variable v-value-character as character  no-undo .
     1709       define variable v-value-date      as date       no-undo .
     1710       define variable v-value-decimal   as decimal    no-undo .
     1711       define variable v-value-integer   as integer    no-undo .
     1712       define variable v-value-logical   as logical    no-undo .
     1713       define variable v-tth             as handle      no-undo .
     1714       run adm/shattri.p ( input "get":U
     1715                         , input  '':u
     1716                         , input  0
     1717                         , input  'bge-export':U
     1718                         , input  'bgeclall':U
     1719                         , output v-bgecliiv
     1720                         , output v-value-date
     1721                         , output v-value-decimal
     1722                         , output v-value-integer
     1723                         , output v-value-logical
     1724                         , output v-param-type
     1725                         , input-output table-handle v-tth
     1726                         ) no-error .
     1727       if error-status :error
     1728       then do:
     1729         assign
     1730           v-bge-xml-bgecliiv = no
     1731         .
     1732       end.
     1733       else do:
     1734         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1735       end.
     1736       delete object v-tth.
     1737       assign
     1738           v-bge-xml-bgeclall = no
     1739           v-bge-xml-bgedict  = no
     1740       .
     1741       run adm/shattri.p ( input "get":U
     1742                         , input  '':u
     1743                         , input  0
     1744                         , input  'bge-export':U
     1745                         , input  'bgeclall':U
     1746                         , output v-value-character
     1747                         , output v-value-date
     1748                         , output v-value-decimal
     1749                         , output v-value-integer
     1750                         , output v-value-logical
     1751                         , output v-param-type
     1752                         , input-output table-handle v-tth
     1753                         ) no-error .
     1754       if error-status :error
     1755       then do:
     1756         assign
     1757           v-bge-xml-bgeclall = no
     1758         .
     1759       end.
     1760       else do:
     1761         assign
     1762           v-bge-xml-bgeclall = v-value-logical
     1763         .
     1764       end.
     1765       delete object v-tth.
     1766       run adm/shattri.p ( input "get":U
     1767                         , input  '':u
     1768                         , input  0
     1769                         , input  'bge-export':U
     1770                         , input  'bgedict':U
     1771                         , output v-value-character
     1772                         , output v-value-date
     1773                         , output v-value-decimal
     1774                         , output v-value-integer
     1775                         , output v-value-logical
     1776                         , output v-param-type
     1777                         , input-output table-handle v-tth
     1778                         ) no-error .
     1779       if error-status :error
     1780       then do:
     1781         assign
     1782           v-bge-xml-bgedict = no
     1783         .
     1784       end.
     1785       else do:
     1786         assign
     1787           v-bge-xml-bgedict = v-value-logical
     1788         .
     1789       end.
     1790       delete object v-tth.
     1791       run adm/shattri.p ( input "get":U
     1792                         , input  '':u
     1793                         , input  0
     1794                         , input  'bge-export':U
     1795                         , input  'bgefmt':U
     1796                         , output v-value-character
     1797                         , output v-value-date
     1798                         , output v-value-decimal
     1799                         , output v-value-integer
     1800                         , output v-value-logical
     1801                         , output v-param-type
     1802                         , input-output table-handle v-tth
     1803                         ) no-error .
     1804       if error-status :error
     1805       then do:
     1806         assign
     1807           v-bge-xml-bgefmt  = "xml":U
     1808         .
     1809       end.
     1810       else do:
     1811         assign
     1812           v-bge-xml-bgefmt  = v-value-character
     1813         .
     1814       end.
     1815       delete object v-tth.
     1816       run adm/shattri.p ( input "get":U
     1817                         , input  '':u
     1818                         , input  0
     1819                         , input  'bge-export':U
     1820                         , input  'bgeshift':U
     1821                         , output v-value-character
     1822                         , output v-value-date
     1823                         , output v-value-decimal
     1824                         , output v-value-integer
     1825                         , output v-value-logical
     1826                         , output v-param-type
     1827                         , input-output table-handle v-tth
     1828                         ) no-error .
     1829       if error-status :error
     1830       then do:
     1831         assign
     1832             v-bge-xml-shift-mode = no
     1833         .
     1834       end.
     1835       else do:
     1836         assign
     1837             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1838         .
     1839       end.
     1840       delete object v-tth.
     1841       run adm/shattri.p ( input "get":U
     1842                         , input  '':u
     1843                         , input  0
     1844                         , input  'bge-export':U
     1845                         , input  'bgeflold':U
     1846                         , output v-value-character
     1847                         , output v-value-date
     1848                         , output v-value-decimal
     1849                         , output v-value-integer
     1850                         , output v-value-logical
     1851                         , output v-param-type
     1852                         , input-output table-handle v-tth
     1853                         ) no-error .
     1854       if error-status :error
     1855       then do:
     1856         assign
     1857           v-bge-xml-bgeflold = "no-parameter":U
     1858         .
     1859       end.
     1860       else do:
     1861         assign
     1862           v-bge-xml-bgeflold  = v-value-character
     1863         .
     1864       end.
     1865       delete object v-tth.
     1866       assign
     1867         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1868         v-bge-xml-db-num-str  = v-db-num-str
     1869       .
     1870       if p-last-date <> ?
     1871       then do:
     1872           run adm/shattri.p ( input "get":U
     1873                             , input  '':u
     1874                             , input  0
     1875                             , input  'bge-export':U
     1876                             , input  'bgeflnm':U
     1877                             , output v-value-character
     1878                             , output v-value-date
     1879                             , output v-value-decimal
     1880                             , output v-value-integer
     1881                             , output v-value-logical
     1882                             , output v-param-type
     1883                             , input-output table-handle v-tth
     1884                             ) no-error .
     1885           if error-status :error
     1886           then do:
     1887             assign
     1888               v-bgeflnm = '':U
     1889             .
     1890           end.
     1891           else do:
     1892             assign
     1893               v-bgeflnm = v-value-character
     1894             .
     1895           end.
     1896           delete object v-tth.
     1897           if v-bge-xml-bgeflold = "var"
     1898           then do:
     1899               if v-bgeflnm = ?
     1900               or num-entries( v-bgeflnm ) < 2
     1901               then do:
     1902                   assign
     1903                       v-bge-xml-bgeflold = "new"
     1904                   .
     1905               end.
     1906               else do:
     1907                   assign
     1908                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1909                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1910                   .
     1911                   assign
     1912                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1913                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1914                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1915                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1916                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1917                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1918                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1919                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1920                   .
     1921               end.
     1922           end.
     1923       end.
     1924   end.
     1925   end procedure.
     1926   procedure bge-xml-get-ref-filename :
     1927   define input parameter p-in-file-name       as character        no-undo.
     1928   define output parameter p-home-dir          as character        no-undo.
     1929   define output parameter p-out-file-name     as character        no-undo.
     1930   define output parameter p-locked            as logical          no-undo.
     1931       define variable v-counter       as integer      no-undo.
     1932       define variable v-error-level   as integer      no-undo.
     1933   do
     1934   on error undo, return error
     1935   :
     1936       run bge/bge-ini.p (
     1937             input "bge"
     1938           , output p-home-dir
     1939       ).
     1940       if return-value <> "OK"
     1941       then do:
     1942           undo, return error.
     1943       end.
     1944       assign
     1945           p-home-dir = p-home-dir + "\dict":U
     1946       .
     1947       run bge/dir_cd.p (
     1948           input p-home-dir
     1949           , input "CA"
     1950       ).
     1951       if return-value = "ERROR"
     1952       then do:
     1953           undo, return error.
     1954       end.
     1955       assign
     1956           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1957       .
     1958       assign
     1959           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1960       .
     1961       wait-lock:
     1962       do v-counter = 1 TO 3
     1963       :
     1964           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1965           if p-locked = no
     1966           then do:
     1967               leave wait-lock.
     1968           end.
     1969           else do:
     1970               readkey pause 1.
     1971           end.
     1972       END.
     1973       if p-locked = yes
     1974       then do:
     1975           undo, return error.
     1976       end.
     1977       run bge/os_copy.p (
     1978             input "D":U
     1979           , input p-out-file-name + "xml":U
     1980           , input "":U
     1981           , output v-error-level
     1982       ).
     1983       if v-error-level > 0
     1984       then do:
     1985           undo, return error.
     1986       end.
     1987   end.
     1988   end procedure.
     1989   procedure bge-xml-write-ref-header :
     1990   define input parameter p-bge-name as character        no-undo.
     1991   define input parameter p-file-name as character        no-undo.
     1992       define variable v-out-string    as character    no-undo.
     1993   do
     1994   on error undo, return error
     1995   :
     1996       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1997       put stream stmXMLOut unformatted
     1998           "<?xml version='1.0' encoding='windows-1251'?>":U
     1999       .
     2000       assign
     2001           v-out-string = substitute( "&1&2"
     2002                               , chr(10)
     2003                               , "<IBS_Trade_House>":U )
     2004       .
     2005       put stream stmXMLOut unformatted
     2006           v-out-string
     2007       .
     2008       run wp-XMLTagOpen( 1, "header", "" ).
     2009       if v-bge-xml-bgeflold = "oracle":u
     2010       then do:
     2011         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2012         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2013         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2014         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2015         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2016       end.
     2017       else do:
     2018         run wp-XMLTagOpen( 2, "delivery", "" ).
     2019         run wp-XMLTagOpen( 3, "to", "" ).
     2020         run wp-XMLTagClose( 3, "to" ).
     2021         run wp-XMLTagOpen( 3, "from", "" ).
     2022         run wp-XMLTagClose( 3, "from" ).
     2023         run wp-XMLTagClose( 2, "delivery" ).
     2024       end.
     2025       run wp-XMLTagOpen( 2, "manifest", "" ).
     2026       run wp-XMLTagOpen( 3, "document", "" ).
     2027       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2028       run wp-XMLTagPut( 4, "description", "", 0 ).
     2029       run wp-XMLTagClose( 3, "document" ).
     2030       run wp-XMLTagClose( 2, "manifest" ).
     2031       run wp-XMLTagClose( 1, "header" ).
     2032       run wp-XMLTagOpen( 1, "body", "" ).
     2033   end.
     2034   end procedure.
     2035   procedure bge-xml-write-ref-footer :
     2036   define input parameter p-file-name as character        no-undo.
     2037       define variable v-error-level   as integer      no-undo.
     2038   do
     2039   on error undo, return error
     2040   :
     2041       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2042       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2043       output stream stmXMLOut close.
     2044       run bge/os_copy.p (
     2045             input "M":U
     2046           , input p-file-name + "xm1":U
     2047           , input p-file-name + "xml":U
     2048           , output v-error-level
     2049       ).
     2050       if v-error-level > 0
     2051       then do:
     2052           undo, return error.
     2053       end.
     2054   end.
     2055   end procedure.
     2056   procedure bge-xml-out-dir :
     2057   define output parameter p-out-dir       as character    no-undo.
     2058   define output parameter p-log-file-name as character    no-undo.
     2059   do
     2060   on error undo, return error
     2061   :
     2062       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2063       if p-out-dir = ?
     2064       then do:
     2065           message
     2066             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2067                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2068             skip(1)
     2069             skip "Обратитесь к администратору."
     2070           view-as alert-box error.
     2071           undo, return error .
     2072       end.
     2073       if v-bge-xml-bgeflold <> "oracle" then assign
     2074         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2075       .
     2076       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2077       if error-status :error  then do:
     2078           run wp-XMLWriteLog in this-procedure (
     2079                 input p-log-file-name
     2080               , input 0
     2081               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2082                                   , p-out-dir
     2083                                   , return-value
     2084                                   , trim( error-status :get-message( 1 ) )
     2085                                   )
     2086           ).
     2087           undo, return error.
     2088       end.
     2089       assign
     2090           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2091           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2092       .
     2093   end.
     2094   end procedure.
     2095   procedure bge-xml-out-dir2 :
     2096   define output parameter p-out-dir       as character    no-undo.
     2097   define output parameter p-out-dirR      as character    no-undo.
     2098   define output parameter p-log-file-name as character    no-undo.
     2099   do
     2100   on error undo, return error
     2101   :
     2102       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2103       if p-out-dir = ?
     2104       then do:
     2105           message
     2106             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2107                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2108             skip(1)
     2109             skip "Обратитесь к администратору."
     2110           view-as alert-box error.
     2111           undo, return error .
     2112       end.
     2113       if v-bge-xml-bgeflold <> "oracle" then assign
     2114             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2115             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2116         .
     2117       else p-out-dirR = p-out-dir .
     2118       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2119       if error-status :error  then do:
     2120           run wp-XMLWriteLog in this-procedure (
     2121                 input p-log-file-name
     2122               , input 0
     2123               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2124                                   , p-out-dir
     2125                                   , return-value
     2126                                   , error-status :get-message( 1 )
     2127                                   )
     2128           ).
     2129           undo, return error.
     2130       end.
     2131       if p-out-dirR <> p-out-dir then do:
     2132         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2133         if error-status :error then do:
     2134           run wp-XMLWriteLog in this-procedure (
     2135                 input p-log-file-name
     2136               , input 0
     2137               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2138                                   , p-out-dirR
     2139                                   , return-value
     2140                                   , error-status :get-message( 1 )
     2141                                   )
     2142           ).
     2143           p-out-dirR = p-out-dir .
     2144         end.
     2145       end .
     2146       assign
     2147         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2148         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2149       .
     2150   end.
     2151   end procedure.
     2152   procedure bge-xml-out-file :
     2153   do
     2154   on error undo, return error
     2155   :
     2156   define input parameter p-out-dir            as character        no-undo.
     2157   define input parameter p-prefix             as character        no-undo.
     2158   define input parameter p-sheduled           as logical          no-undo.
     2159   define output parameter p-xml-file-name     as character        no-undo.
     2160   define output parameter p-locked            as logical          no-undo.
     2161   define variable v-home-dir      as character     no-undo.
     2162   define variable v-error-num     as integer       no-undo.
     2163   define variable v-today             as date         no-undo.
     2164   define variable v-time              as integer      no-undo.
     2165       if v-bge-xml-bgefmt = "dbf":U
     2166       then do:
     2167           assign
     2168               p-xml-file-name = p-out-dir
     2169               p-locked        = no
     2170           .
     2171       end.
     2172       else do:
     2173           if v-bge-xml-bgeflold = "firm":U
     2174           then do:
     2175               run bge/genfname.p (
     2176                     input p-out-dir
     2177                   , input p-prefix
     2178                   , input "":U
     2179                   , input "arj":U
     2180                   , input "":U
     2181                   , output p-xml-file-name
     2182               ).
     2183           end.
     2184           else do:
     2185               run bge/genfname.p (
     2186                     input p-out-dir
     2187                   , input p-prefix
     2188                   , input "":U
     2189                   , input "xml":U
     2190                   , input "":U
     2191                   , output p-xml-file-name
     2192               ).
     2193           end.
     2194           assign
     2195               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2196               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2197           .
     2198       end.
     2199   end.
     2200   end procedure.
     2201   procedure bge-xml-init-ext-doc-type :
     2202       define variable v-counter    as integer      no-undo.
     2203       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2204   do
     2205   for buf_temp_ext-doc-type
     2206   on error undo, return error
     2207   :
     2208       empty temp-table buf_temp_ext-doc-type.
     2209       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2210       :
     2211           create buf_temp_ext-doc-type.
     2212           assign
     2213               buf_temp_ext-doc-type.edt-key               = v-counter
     2214               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2215               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2216           .
     2217       end.
     2218   end.
     2219   end procedure.
     2220   procedure bge-xml-get-decimal-shift-num :
     2221   define input parameter p-shift-date     as date             no-undo.
     2222   define input parameter p-shift-num      as integer          no-undo.
     2223   define output parameter p-shift-decimal as decimal          no-undo.
     2224   do
     2225   on error undo, return error
     2226   :
     2227       assign
     2228           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2229       .
     2230   end.
     2231   end procedure.
     2232   procedure bge-xml-ora-exp-filename :
     2233     define input  parameter p-table-name  as character no-undo .
     2234     define input  parameter p-doc-code    as character no-undo .
     2235     define input  parameter p-obj-code    as integer   no-undo .
     2236     define output parameter p-filename    as character no-undo .
     2237     define output parameter p-seq-num     as integer   no-undo .
     2238     define variable v-ora-exp-seq     as integer   no-undo .
     2239     define variable v-ora-exp-seq-str as character no-undo .
     2240     define variable v-home-dir        as character no-undo.
     2241   do
     2242   on error undo, return error return-value
     2243   :
     2244     if v-bge-xml-bgeflold = "oracle":u
     2245     then do:
     2246       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2247       if v-home-dir = ?
     2248       then do:
     2249         undo, return error substitute( "&1&2&3":U
     2250                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2251                                       , chr(10)
     2252                                       , "Обратитесь к администратору.":U
     2253                                       ).
     2254       end.
     2255       assign
     2256           v-home-dir = v-home-dir
     2257       .
     2258       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2259       if error-status :error
     2260       then do:
     2261         undo, return error substitute( "&1&2&3":U
     2262                                       , "Неверно задан каталог экспорта.":U
     2263                                       , chr(10)
     2264                                       , "Обратитесь к администратору.":U
     2265                                       ).
     2266       end.
     2267       assign
     2268         v-ora-exp-seq = ?
     2269       .
     2270       if  p-table-name <> ? and
     2271           p-doc-code <> ?
     2272       then do:
     2273         run bge/get-oesq.p ( input p-table-name
     2274                            , input p-doc-code
     2275                            , output v-ora-exp-seq
     2276                            ) no-error .
     2277         if error-status :error = yes
     2278         then do:
     2279           undo, return error return-value .
     2280         end.
     2281       end.
     2282       if v-ora-exp-seq = ?
     2283       then do:
     2284         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2285         if error-status :error
     2286         then do:
     2287           undo, return error return-value .
     2288         end.
     2289       end.
     2290       if p-table-name <> ? and
     2291          p-doc-code   <> ?
     2292       then do:
     2293         run bge/oesqdoc.p ( input p-table-name
     2294                           , input p-doc-code
     2295                           , input v-ora-exp-seq
     2296                           ) no-error .
     2297         if error-status :error = yes
     2298         then do:
     2299           undo, return error return-value .
     2300         end.
     2301       end.
     2302       assign
     2303         p-seq-num  = v-ora-exp-seq
     2304         p-filename = substitute("&1/&2-000_&3."
     2305                                , v-home-dir
     2306                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2307                                , string(v-ora-exp-seq , "999999999")
     2308                                )
     2309       .
     2310     end.
     2311   end.
     2312   end procedure.
     2313   procedure bge-xml-date-to-str :
     2314     define input  parameter p-date  as date      no-undo .
     2315     define output parameter p-str   as character no-undo .
     2316   do
     2317   on error undo, return error return-value
     2318   :
     2319     if p-date <> ?
     2320     then do:
     2321       assign
     2322         p-str = substitute( "&1-&2-&3"
     2323                           , string( year(p-date)  , "9999")
     2324                           , string( month(p-date) , "99"  )
     2325                           , string( day(p-date)   , "99"  )
     2326                           )
     2327       .
     2328     end.
     2329     else do:
     2330       assign
     2331         p-str = ?
     2332       .
     2333     end.
     2334   end.
     2335   end procedure.
     2336   procedure bge-xml-date-str-to-str :
     2337     define input  parameter p-date-str  as character no-undo .
     2338     define output parameter p-str       as character no-undo .
     2339     define variable v-date          as date      no-undo .
     2340     define variable v-date-valid    as logical   no-undo .
     2341     define variable v-error-message as character no-undo .
     2342   do
     2343   on error undo, return error return-value
     2344   :
     2345     assign
     2346       p-str = ?
     2347     .
     2348     if p-date-str = ? or p-date-str = ""
     2349     then do:
     2350       return .
     2351     end.
     2352     run strtdate in this-procedure ( input  p-date-str
     2353                                    , output v-date
     2354                                    , output v-date-valid
     2355                                    , output v-error-message
     2356                                    ).
     2357     if v-date-valid <> true
     2358     then do:
     2359       return .
     2360     end.
     2361     assign
     2362       p-str = substitute( "&1-&2-&3"
     2363                         , string( year(v-date)  , "9999")
     2364                         , string( month(v-date) , "99"  )
     2365                         , string( day(v-date)   , "99"  )
     2366                         )
     2367     .
     2368   end.
     2369   end procedure.
     2370   procedure bge-xml-fill-tt-bgecliiv :
     2371     define input  parameter p-str as character no-undo .
     2372     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2373     define buffer buf_clients             for ub.clients.
     2374     define variable v-i         as integer   no-undo .
     2375     define variable v-count     as integer   no-undo .
     2376     define variable v-cli-count as integer   no-undo .
     2377     define variable v-client    as character no-undo .
     2378     define variable v-obj-type  as character no-undo .
     2379     define variable v-obj-code  as integer   no-undo .
     2380   do
     2381   on error undo, return error return-value
     2382   :
     2383     empty temp-table buf_tt-bge-xml-bgecliiv.
     2384     assign
     2385       v-bge-xml-bgecliiv = no
     2386       v-cli-count        = num-entries(p-str,';')
     2387     .
     2388     if v-cli-count > 0
     2389     then do:
     2390       _cli-cycle:
     2391       do v-i = 1 to v-cli-count
     2392       :
     2393         assign
     2394           v-client = entry(v-i , p-str, ';')
     2395         .
     2396         if num-entries(v-client) <> 2
     2397         then do:
     2398           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2399         end.
     2400         assign
     2401           v-obj-type = entry(1, v-client)
     2402         .
     2403         assign
     2404           v-obj-code = integer(entry(2, v-client))
     2405         no-error .
     2406         if error-status :error
     2407         then do:
     2408           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2409         end.
     2410         find first buf_clients no-lock
     2411           where buf_clients.obj-type = v-obj-type
     2412             and buf_clients.obj-code = v-obj-code
     2413         no-error.
     2414         if not available buf_clients
     2415         then do:
     2416           next _cli-cycle.
     2417         end.
     2418         find first buf_tt-bge-xml-bgecliiv no-lock
     2419           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2420             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2421         no-error .
     2422         if available buf_tt-bge-xml-bgecliiv
     2423         then do:
     2424           next _cli-cycle.
     2425         end.
     2426         create buf_tt-bge-xml-bgecliiv.
     2427         assign
     2428           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2429           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2430         .
     2431       end.
     2432     end.
     2433     else do:
     2434       assign
     2435         v-bge-xml-bgecliiv = no
     2436       .
     2437       return .
     2438     end.
     2439     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2440     if available buf_tt-bge-xml-bgecliiv
     2441     then do:
     2442       assign
     2443         v-bge-xml-bgecliiv = yes
     2444       .
     2445     end.
     2446   end.
     2447   end procedure.
     2448   procedure bge-xml-resolve-ext-doc-type :
     2449     define input  parameter p-ext-doc-type      as character no-undo .
     2450     define input  parameter p-obj-type          as character no-undo .
     2451     define input  parameter p-obj-code          as integer   no-undo .
     2452     define output parameter p-out-ext-doc-type  as character no-undo .
     2453     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2454   do
     2455   on error undo, return error return-value
     2456   :
     2457     assign
     2458       p-out-ext-doc-type = p-ext-doc-type
     2459     .
     2460     if p-ext-doc-type <> 'ie':U
     2461     then do:
     2462       return .
     2463     end.
     2464     if v-bge-xml-bgecliiv = yes
     2465     then do:
     2466       find first buf_tt-bge-xml-bgecliiv no-lock
     2467         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2468           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2469       no-error .
     2470       if available buf_tt-bge-xml-bgecliiv
     2471       then do:
     2472         assign
     2473           p-out-ext-doc-type = 'iv':U
     2474         .
     2475       end.
     2476     end.
     2477   end.
     2478   end procedure.
     2479   procedure safe-wp-xmltagput :
     2480     define input  parameter pTagLevel   as integer   no-undo .
     2481     define input  parameter pTagName    as character no-undo .
     2482     define input  parameter pParValue   as character no-undo .
     2483     define input  parameter pFlagEmpty  as integer   no-undo .
     2484   do
     2485   on error undo, return error return-value
     2486   :
     2487     if v-bge-xml-bgeflold = "oracle":u
     2488     then do:
     2489       return .
     2490     end.
     2491     run wp-xmltagput in this-procedure ( input pTagLevel
     2492                                        , input pTagName
     2493                                        , input pParValue
     2494                                        , input pFlagEmpty
     2495                                        ).
     2496   end.
     2497   end procedure.
     2498   define new global shared variable g#lib-trn  as handle no-undo .
     2499   define new global shared variable g#lib-trn2 as handle no-undo .
     2500   define new global shared variable g#lib-trn3 as handle no-undo .
     2501   define new global shared variable g#lib-trn4 as handle no-undo .
     2502   define variable v-host-code         as integer   no-undo.
     2503   define variable v-base-code         as integer   no-undo.
     2504   define variable v-base-code-okv     as integer   no-undo.
     2505   define variable v-ora-exp-seq-num   as integer   no-undo.
     2506   main-block:
     2507   do
     2508   on error undo, return error return-value
     2509   :
     2510   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2512     (input  p-obj-type
     2513     ,input  p-obj-code
     2514     ,output v-host-code
     2515     )  .
     2516   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2517   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2518     (input  v-host-code
     2519     ,output v-base-code
     2520     )  .
     2521     run get-base-code-okv in this-procedure ( input v-base-code
     2522                                             , output v-base-code-okv
     2523                                             ).
     2524     assign
     2525       v-bge-xml-log-file-name = sLogFile
     2526     .
     2527     run bge-xml-read-config in this-procedure ( input ?
     2528                                               , input ?
     2529                                               ).
     2530     run wp-XMLWriteCNT in this-procedure ( hCNT, "" ).
     2531     if v-bge-xml-bgeflold = "oracle":u
     2532     then do:
     2533       run export-documents in this-procedure .
     2534     end.
     2535   end.
     2536   procedure export-documents :
     2537     define variable v-status            as character no-undo .
     2538     define variable v-num-status        as integer   no-undo .
     2539     define variable v-i                 as integer   no-undo .
     2540     define buffer buf_ord-doc for ub.ord-doc.
     2541     define buffer sch_ord-doc for ub.ord-doc.
     2542   do for buf_ord-doc
     2543   on error undo, return error return-value
     2544   :
     2545     run wp-XMLWriteLog in this-procedure ( input sLogFile
     2546                                          , input 1
     2547                                          , input 'Выгрузка заказов...':u
     2548                                          ).
     2549     run wp-XMLWriteEDT in this-procedure ( hEDT, 8, "Операция заказы Объект-Поставщик" ).
     2550     if p-doc-code <> ?
     2551     then do:
     2552       find first buf_ord-doc no-lock
     2553         where buf_ord-doc.doc-code = p-doc-code
     2554       no-error .
     2555       if available buf_ord-doc
     2556       then do:
     2557         if v-bge-xml-bgeflold = "oracle":u
     2558         then do:
     2559           if not ( buf_ord-doc.cons-code = ? or buf_ord-doc.cons-code = '' )
     2560           then do:
     2561             return .
     2562           end.
     2563         end.
     2564         run export-document in this-procedure ( input buf_ord-doc.doc-code , output v-ora-exp-seq-num ) no-error .
     2565         if error-status :error
     2566         then do:
     2567           run wp-XMLWriteLog in this-procedure ( input sLogFile
     2568                                                 , input 1
     2569                                                 , input substitute( "Ошибка экспорта документа заказа. Номер документа: &1. &2. &3 &4 "
     2570                                                                   , buf_ord-doc.doc-code
     2571                                                                   , return-value
     2572                                                                   , trim(error-status :get-message(1))
     2573                                                                   , trim(error-status :get-message(2))
     2574                                                                   )
     2575                                                 ).
     2576           undo, return error return-value.
     2577         end.
     2578         if v-bge-xml-bgeflold = "oracle":u
     2579         then do:
     2580           run bge/setbgedt.p ( input 'ord-doc':U
     2581                             , input buf_ord-doc.doc-code
     2582                             , input today
     2583                             ).
     2584         end.
     2585         else do:
     2586           run run-callback-write-doc-code in this-procedure ( input p-parent-handle
     2587                                                             , input 'ord-doc':U
     2588                                                             , input buf_ord-doc.doc-code
     2589                                                             , input sLogFile
     2590                                                             ).
     2591         end.
     2592       end.
     2593       return .
     2594     end.
     2595     assign
     2596       v-num-status = num-entries(p-status-list)
     2597     .
     2598     _status-list:
     2599     do v-i = 1 to v-num-status
     2600     :
     2601       assign
     2602         v-status = entry( v-i , p-status-list )
     2603       .
     2604       if p-inc-export = yes
     2605       then do:
     2606         _export-ord-doc-incr:
     2607         for each buf_ord-doc no-lock
     2608           where buf_ord-doc.obj-type    = p-obj-type
     2609             and buf_ord-doc.obj-code    = p-obj-code
     2610             and buf_ord-doc.doc-type    = p-doc-type
     2611             and buf_ord-doc.status_     = v-status
     2612             and buf_ord-doc.ord-date1   = ?
     2613         on error undo, return error
     2614         :
     2615           find first sch_ord-doc share-lock
     2616             where sch_ord-doc.doc-code = buf_ord-doc.doc-code
     2617           no-wait
     2618           no-error.
     2619           if not available sch_ord-doc
     2620           then do:
     2621             next _export-ord-doc-incr.
     2622           end.
     2623           if v-bge-xml-bgeflold = "oracle":u
     2624           then do:
     2625             if not ( sch_ord-doc.cons-code = ? or sch_ord-doc.cons-code = '' )
     2626             then do:
     2627               next _export-ord-doc-incr.
     2628             end.
     2629           end.
     2630           run export-document in this-procedure ( input sch_ord-doc.doc-code , output v-ora-exp-seq-num ) no-error .
     2631           if error-status :error
     2632           then do:
     2633             run wp-XMLWriteLog in this-procedure ( input sLogFile
     2634                                                  , input 1
     2635                                                  , input substitute( "Ошибка экспорта документа заказа. Номер документа: &1. &2. &3 &4 "
     2636                                                                    , buf_ord-doc.doc-code
     2637                                                                    , return-value
     2638                                                                    , trim(error-status :get-message(1))
     2639                                                                    , trim(error-status :get-message(2))
     2640                                                                    )
     2641                                                  ).
     2642             if v-bge-xml-bgeflold = "oracle":u
     2643             then do:
     2644               undo _export-ord-doc-incr, return .
     2645             end.
     2646             else do:
     2647               undo _export-ord-doc-incr, next _export-ord-doc-incr.
     2648             end.
     2649           end.
     2650           if v-bge-xml-bgeflold = "oracle":u
     2651           then do:
     2652             run bge/setbgedt.p ( input 'ord-doc':U
     2653                                , input buf_ord-doc.doc-code
     2654                                , input today
     2655                                ).
     2656           end.
     2657           else do:
     2658             run run-callback-write-doc-code in this-procedure ( input p-parent-handle
     2659                                                               , input 'ord-doc':U
     2660                                                               , input buf_ord-doc.doc-code
     2661                                                               , input sLogFile
     2662                                                               ).
     2663           end.
     2664         end.
     2665       end.
     2666       else do:
     2667         _export-ord-doc:
     2668         for each buf_ord-doc no-lock
     2669           where buf_ord-doc.obj-type   = p-obj-type
     2670             and buf_ord-doc.obj-code   = p-obj-code
     2671             and buf_ord-doc.doc-type   = p-doc-type
     2672             and buf_ord-doc.status_    = v-status
     2673             and buf_ord-doc.fact-date >= p-date-from
     2674             and buf_ord-doc.fact-date <= p-date-to
     2675         on error undo, return error
     2676         :
     2677           if v-bge-xml-bgeflold = "oracle":u
     2678           then do:
     2679             if not ( buf_ord-doc.cons-code = ? or buf_ord-doc.cons-code = '' )
     2680             then do:
     2681               next _export-ord-doc.
     2682             end.
     2683             _export-block:
     2684             do transaction
     2685             on error undo _export-block, return error return-value
     2686             :
     2687               run export-document in this-procedure ( input buf_ord-doc.doc-code , output v-ora-exp-seq-num ) no-error .
     2688               if error-status :error
     2689               then do:
     2690                 run wp-XMLWriteLog in this-procedure ( input sLogFile
     2691                                                     , input 1
     2692                                                     , input substitute( "Ошибка экспорта документа заказа. Номер документа: &1. &2. &3 &4 "
     2693                                                                       , buf_ord-doc.doc-code
     2694                                                                       , return-value
     2695                                                                       , trim(error-status :get-message(1))
     2696                                                                       , trim(error-status :get-message(2))
     2697                                                                       )
     2698                                                     ).
     2699                 undo _export-block, leave _export-ord-doc.
     2700               end.
     2701             end.
     2702           end.
     2703           else do:
     2704             run export-document in this-procedure ( input buf_ord-doc.doc-code , output v-ora-exp-seq-num ) no-error .
     2705             if error-status :error
     2706             then do:
     2707               run wp-XMLWriteLog in this-procedure ( input sLogFile
     2708                                                   , input 1
     2709                                                   , input substitute( "Ошибка экспорта документа заказа. Номер документа: &1. &2. &3 &4 "
     2710                                                                     , buf_ord-doc.doc-code
     2711                                                                     , return-value
     2712                                                                     , trim(error-status :get-message(1))
     2713                                                                     , trim(error-status :get-message(2))
     2714                                                                     )
     2715                                                   ).
     2716               undo _export-ord-doc, next _export-ord-doc.
     2717             end.
     2718           end.
     2719         end.
     2720       end.
     2721     end.
     2722   end.
     2723   end procedure.
     2724   procedure export-document :
     2725     define input  parameter p-doc-code        as character no-undo .
     2726     define output parameter p-ora-exp-seq-num as integer   no-undo .
     2727     define buffer buf_ord-doc   for ub.ord-doc.
     2728     define buffer buf_ord-line  for ub.ord-line.
     2729     define variable v-obj-list         as character   no-undo .
     2730     define variable v-doc-type         as character   no-undo .
     2731     define variable v-exp-ora-filename as character   no-undo .
     2732     define variable v-fact-date        as date        no-undo .
     2733     define variable v-fact-order       as decimal     no-undo .
     2734   do for  buf_ord-doc
     2735         , buf_ord-line
     2736   on error undo, return error return-value
     2737   :
     2738     find first buf_ord-doc no-lock
     2739       where buf_ord-doc.doc-code = p-doc-code
     2740     no-error .
     2741     if not available buf_ord-doc
     2742     then do:
     2743       undo, return error substitute( "Не найден заказ с кодом &1" , p-doc-code ).
     2744     end.
     2745     assign
     2746       v-fact-date = buf_ord-doc.fact-date
     2747     .
     2748     run wp-XMLWriteCnt( hcnt, "   " + string( p-doc-code ) + " от " + string( v-fact-date ) ) .
     2749     assign
     2750       v-obj-list = substitute( "&1,&2" , p-obj-type , p-obj-code )
     2751     .
     2752     run bge-xml-ora-exp-filename in this-procedure ( input 'ord-doc':U
     2753                                                    , input p-doc-code
     2754                                                    , input p-obj-code
     2755                                                    , output v-exp-ora-filename
     2756                                                    , output p-ora-exp-seq-num
     2757                                                    ) .
     2758     run convert-doc-type in this-procedure ( input p-doc-type
     2759                                            , output v-doc-type
     2760                                            ).
     2761     run bge-xml-write-header in this-procedure (
     2762           input v-exp-ora-filename
     2763         , input v-exp-ora-filename + "xml"
     2764         , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     2765         , input 0
     2766         , input p-date-from
     2767         , input 0
     2768         , input p-date-to
     2769         , input 0
     2770         , input v-obj-list
     2771         , input v-doc-type
     2772         , input no
     2773         , input no
     2774         , input no
     2775         , input no
     2776         , input no
     2777         , input no
     2778         , input no
     2779         , input no
     2780     ).
     2781     output stream stmxmlout to value( v-exp-ora-filename + "xm1" ) convert target "1251" append.
     2782     run wp-XMLWriteLog in this-procedure ( input sLogFile
     2783                                          , input 1
     2784                                          , input substitute( "Выгрузка документа &1 в пакет &2."
     2785                                                            , buf_ord-doc.doc-code
     2786                                                            , v-exp-ora-filename + "xml"
     2787                                                            )
     2788                                          ).
     2789     run export-header in this-procedure ( p-doc-code ) .
     2790     run export-doc-lines in this-procedure (p-doc-code) .
     2791     run wp-xmltagclose in this-procedure ( 2, "operation" ).
     2792     output stream stmxmlout close.
     2793     run xml-bge-write-footer in this-procedure ( input v-exp-ora-filename ).
     2794     run wp-XMLWriteLog in this-procedure ( input sLogFile
     2795                                          , input 1
     2796                                          , input substitute( "Выгрузка документа &1 в пакет &2 завершена."
     2797                                                            , buf_ord-doc.doc-code
     2798                                                            , v-exp-ora-filename + "xml"
     2799                                                            )
     2800                                          ).
     2801   end.
     2802   end procedure.
     2803   procedure export-header :
     2804     define input parameter p-doc-code as character        no-undo.
     2805     define buffer buf_ord-doc for ub.ord-doc.
     2806     define variable v-doc-type        as character no-undo.
     2807     define variable v-fact-date       as date      no-undo.
     2808     define variable v-fact-time       as integer   no-undo.
     2809     define variable v-fact-order      as decimal   no-undo.
     2810     define variable v-sys-date        as date      no-undo.
     2811     define variable v-sys-time        as character no-undo.
     2812     define variable v-doc-date        as date      no-undo.
     2813     define variable v-shift-date      as date      no-undo.
     2814     define variable v-shift-num       as integer   no-undo.
     2815     define variable v-shift-name      as character no-undo.
     2816     define variable v-temp-char       as character no-undo.
     2817     define variable v-reason-code     as integer   no-undo.
     2818     define variable v-doc-exch-code   as integer   no-undo.
     2819     define variable v-doc-exch-rate   as decimal   no-undo.
     2820     define variable v-doc-exch-scale  as integer   no-undo.
     2821   do for buf_ord-doc
     2822   on error undo, return error return-value
     2823   :
     2824     find first buf_ord-doc share-lock
     2825       where buf_ord-doc.doc-code = p-doc-code
     2826     no-error .
     2827     if not available buf_ord-doc
     2828     then do:
     2829       undo, return error substitute( "Не найден заказ с кодом &1" , p-doc-code ).
     2830     end.
     2831     run fill_bge-xml_clients in this-procedure ( input p-parent-handle
     2832                                                , input buf_ord-doc.cli-type
     2833                                                , input buf_ord-doc.cli-code
     2834                                                ).
     2835     run convert-doc-type in this-procedure ( input p-doc-type
     2836                                            , output v-doc-type
     2837                                            ).
     2838     assign
     2839       v-fact-order      = buf_ord-doc.fact-order
     2840       v-sys-date        = buf_ord-doc.sys-date
     2841       v-sys-time        = buf_ord-doc.sys-time
     2842       v-doc-date        = buf_ord-doc.doc-date
     2843       v-fact-date       = buf_ord-doc.fact-date
     2844       v-fact-time       = buf_ord-doc.fact-time
     2845       v-doc-exch-code   = buf_ord-doc.exch-code
     2846       v-doc-exch-rate   = buf_ord-doc.exch-rate
     2847       v-doc-exch-scale  = buf_ord-doc.exch-scale
     2848     .
     2849   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     2850     (
     2851        input buf_ord-doc.obj-type
     2852     ,  input buf_ord-doc.obj-code
     2853     ,  input v-shift-date
     2854     ,  input v-shift-num
     2855     , output v-shift-name
     2856     , output v-temp-char
     2857     )        no-error .
     2858     run wp-xmltagopen in this-procedure ( 2, "operation","" ).
     2859     run wp-xmltagput in this-procedure ( 3, "referenceNo",        string( p-doc-code                   ), 1 ).
     2860     run wp-xmltagput in this-procedure ( 3, "codeOperation",      string( v-doc-type                   ), 1 ).
     2861     run wp-xmltagput in this-procedure ( 3, "host",               string( p-host-code                  ), 1 ).
     2862     run wp-xmltagput in this-procedure ( 3, "store",              p-obj-type + string( p-obj-code )     , 1 ).
     2863     run wp-xmltagput in this-procedure ( 3, "factOrder",          string( v-fact-order )                , 1 ).
     2864     run wp-xmltagput in this-procedure ( 3, "sysDate",            string(v-sys-date , "99.99.9999")     , 0 ).
     2865     run wp-xmltagput in this-procedure ( 3, "sysDateXml",         bge-xml-date( v-sys-date )            , 0 ).
     2866     run wp-xmltagput in this-procedure ( 3, "sysTime",            string( v-sys-time )                  , 1 ).
     2867     run wp-xmltagput in this-procedure ( 3, "dateDoc",            string( v-doc-date , "99.99.9999" )   , 1 ).
     2868     run wp-xmltagput in this-procedure ( 3, "dateDocXml",         bge-xml-date( v-doc-date )            , 1 ).
     2869     run wp-xmltagput in this-procedure ( 3, "dateFact",           string( v-doc-date , "99.99.9999")    , 1 ).
     2870     run wp-xmltagput in this-procedure ( 3, "dateFactXml",        bge-xml-date( v-doc-date )            , 1 ).
     2871     run wp-xmltagput in this-procedure ( 3, "timeFact",           string( v-fact-time, "hh:mm:ss"      ), 1 ).
     2872     run wp-xmltagput in this-procedure ( 3, "shiftDate",          string( v-shift-date , "99.99.9999")  , 0 ).
     2873     run wp-xmltagput in this-procedure ( 3, "shiftDateXml",       bge-xml-date( v-shift-date )          , 0 ).
     2874     run wp-xmltagput in this-procedure ( 3, "shiftNum",           string( v-shift-num                  ), 0 ).
     2875     run wp-xmltagput in this-procedure ( 3, "shiftName",          string( v-shift-name                 ), 0 ).
     2876     run wp-xmltagput in this-procedure ( 3, "valutCode",          string( v-base-code                  ), 1 ).
     2877     run wp-xmltagput in this-procedure ( 3, "valutCodeOKV",       string( v-base-code-okv              ), 1 ).
     2878     run wp-xmltagput in this-procedure ( input 3, input "exchCode" , input string( v-doc-exch-code                     ), input 1 ).
     2879     run wp-xmltagput in this-procedure ( input 3, input "exchRate" , input string( v-doc-exch-rate                     ), input 1 ).
     2880     run wp-xmltagput in this-procedure ( input 3, input "exchScale", input string( v-doc-exch-scale                    ), input 1 ).
     2881     run wp-xmltagput in this-procedure ( 3, "firm",                 buf_ord-doc.cli-type + string( buf_ord-doc.cli-code ), 1 ).
     2882     run wp-xmltagput in this-procedure ( 3, "outDate",              string( buf_ord-doc.ship-date , "99.99.9999")    , 0 ).
     2883     run wp-xmltagput in this-procedure ( 3, "outDateXml",           bge-xml-date( buf_ord-doc.ship-date )            , 0 ).
     2884     run wp-xmltagput in this-procedure ( 3, "paymentCode",          string( buf_ord-doc.pay-code                    ), 0 ).
     2885     run wp-xmltagput in this-procedure ( input 3, input "reasonCode"   , input string( v-reason-code )  , input 0 ).
     2886     run wp-xmltagput in this-procedure ( input 3, input "outCode"      , input buf_ord-doc.out-code     , input 0 ).
     2887     run wp-xmltagput in this-procedure ( input 3, input "comment"      , input buf_ord-doc.PS           , input 1 ).
     2888     run wp-xmltagput in this-procedure ( input 3, input "ordOutDocCode", input buf_ord-doc.cons-code    , input 1 ).
     2889     run wp-xmltagopen in this-procedure ( 3, "docSum","" ).
     2890     run wp-xmltagput in this-procedure ( 4, "sumr"      , string( buf_ord-doc.sum-rubl ), 1 ).
     2891     run wp-xmltagput in this-procedure ( 4, "sumb"      , string( buf_ord-doc.sum-base ), 1 ).
     2892     run wp-xmltagclose in this-procedure ( 3, "docSum" ).
     2893   end.
     2894   end procedure.
     2895   procedure export-doc-lines :
     2896     define input  parameter p-doc-code as character no-undo .
     2897     define buffer buf_ord-line for ub.ord-line.
     2898   do for buf_ord-line
     2899   on error undo, return error return-value
     2900   :
     2901     for each buf_ord-line no-lock
     2902       where buf_ord-line.doc-code = p-doc-code
     2903     on error undo, return error return-value
     2904     :
     2905       run wp-xmltagopen( 3, "linedoc", "" ).
     2906       run export-doc-line in this-procedure ( input buf_ord-line.doc-code
     2907                                             , input buf_ord-line.artic
     2908                                             , input buf_ord-line.prod-type
     2909                                             , input buf_ord-line.prod-code
     2910                                             ) .
     2911       run wp-xmltagclose( 3, "linedoc" ).
     2912     end.
     2913   end.
     2914   end procedure.
     2915   procedure export-doc-line :
     2916     define input  parameter p-doc-code  as character no-undo .
     2917     define input  parameter p-artic     as character no-undo .
     2918     define input  parameter p-prod-type as character no-undo .
     2919     define input  parameter p-prod-code as integer   no-undo .
     2920     define buffer buf_ord-doc  for ub.ord-doc .
     2921     define buffer buf_ord-line for ub.ord-line.
     2922     define buffer buf_goods    for ub.goods.
     2923     define buffer buf_units    for ub.units.
     2924     define variable v-is-envd  as logical   no-undo.
     2925     define variable v-r-b      as character no-undo .
     2926     define variable v-rate     as decimal   no-undo .
     2927     define variable v-VATr     as decimal   no-undo .
     2928     define variable v-SLTr     as decimal   no-undo .
     2929     define variable v-roadTaxr as decimal   no-undo .
     2930     define variable v-VATb     as decimal   no-undo .
     2931     define variable v-SLTb     as decimal   no-undo .
     2932     define variable v-roadTaxb as decimal   no-undo .
     2933   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2935     (output v-r-b
     2936     )  .
     2937   do for  buf_ord-doc
     2938         , buf_ord-line
     2939         , buf_goods
     2940         , buf_units
     2941   on error undo, return error return-value
     2942   :
     2943     find first buf_ord-doc no-lock
     2944       where buf_ord-doc.doc-code   = p-doc-code
     2945     no-error .
     2946     if available buf_ord-doc
     2947     then do:
     2948       find first buf_ord-line no-lock
     2949         where buf_ord-line.doc-code   = p-doc-code
     2950           and buf_ord-line.artic      = p-artic
     2951           and buf_ord-line.prod-type  = p-prod-type
     2952           and buf_ord-line.prod-code  = p-prod-code
     2953       no-error .
     2954       if available buf_ord-line
     2955       then do:
     2956         find first buf_goods no-lock
     2957           where buf_goods.artic     = p-artic
     2958             and buf_goods.prod-type = p-prod-type
     2959             and buf_goods.prod-code = p-prod-code
     2960         no-error .
     2961         if available buf_goods
     2962         then do:
     2963           run wp-xmltagput in this-procedure ( 4, "good",      string( buf_goods.gds-code ), 1 ).
     2964           run wp-xmltagput in this-procedure ( 4, "artic",     string( buf_goods.artic    ), 1 ).
     2965           run wp-xmltagput in this-procedure ( 4, "prodtype",  string( buf_goods.prod-type), 1 ).
     2966           run wp-xmltagput in this-procedure ( 4, "prodcode",  string( buf_goods.prod-code), 1 ).
     2967           run wp-xmltagput in this-procedure ( 4, "type",      string( buf_goods.gds-type ), 1 ).
     2968           run fill_bge-xml_goods in this-procedure ( input p-parent-handle
     2969                                                   , input buf_goods.gds-code
     2970                                                   ).
     2971         end.
     2972         else do:
     2973             run wp-xmltagput in this-procedure ( 4, "good",      "", 1 ).
     2974             run wp-xmltagput in this-procedure ( 4, "artic",     "", 1 ).
     2975             run wp-xmltagput in this-procedure ( 4, "prodtype",  "", 1 ).
     2976             run wp-xmltagput in this-procedure ( 4, "prodcode",  "", 1 ).
     2977             run wp-xmltagput in this-procedure ( 4, "type",      "", 1 ).
     2978         end.
     2979         find first buf_units no-lock
     2980           where buf_units.unit-name  = buf_goods.unit-base
     2981         no-error.
     2982         if available buf_units
     2983         then do:
     2984           run wp-xmltagput in this-procedure ( 4, "unitType",    string( buf_units.type ), 1 ).
     2985         end.
     2986         else do:
     2987           run wp-xmltagput in this-procedure ( 4, "unitType",   "",   1 ).
     2988         end.
     2989         run wp-xmltagput( 4, "priceCli"     , string( buf_ord-line.price-cli        ), 1 ).
     2990         run wp-xmltagput( 4, "cliBaseRate"  , string( buf_ord-line.cli-base-rate    ), 1 ).
     2991         run wp-xmltagput in this-procedure ( 4, "quantity" , string( buf_ord-line.qnty ), 1 ).
     2992         run wp-xmltagput in this-procedure ( 4, "comment"  , string( buf_goods.ps )     , 1 ).
     2993         assign
     2994           v-rate = buf_ord-doc.base-rate / buf_ord-doc.base-scale
     2995         .
     2996         if v-r-b = 'rubl':U then do:
     2997           assign
     2998             v-VATr     = buf_ord-line.sum-vat      * buf_ord-line.qnty
     2999             v-SLTr     = buf_ord-line.sum-slt      * buf_ord-line.qnty
     3000             v-roadTaxr = buf_ord-line.sum-road-tax * buf_ord-line.qnty
     3001             v-VATb     = v-VATr     / v-rate
     3002             v-SLTb     = v-SLTr     / v-rate
     3003             v-roadTaxb = v-roadTaxr / v-rate
     3004           .
     3005         end.
     3006         else do:
     3007           assign
     3008             v-VATb     = buf_ord-line.sum-vat      * buf_ord-line.qnty
     3009             v-SLTb     = buf_ord-line.sum-slt      * buf_ord-line.qnty
     3010             v-roadTaxb = buf_ord-line.sum-road-tax * buf_ord-line.qnty
     3011             v-VATr     = v-VATb     * v-rate
     3012             v-SLTr     = v-SLTb     * v-rate
     3013             v-roadTaxr = v-roadTaxb * v-rate
     3014           .
     3015         end.
     3016         run wp-xmltagopen in this-procedure ( 4, "docSum", "" ).
     3017         run wp-xmltagput in this-procedure ( 5, "rateVAT",    trim( string( buf_ord-line.vat-pc , ">99" )), 1 ).
     3018         run wp-xmltagput in this-procedure ( 5, "rateSLT",    trim( string( buf_ord-line.slt-pc , ">99" )), 1 ).
     3019         run wp-xmltagput in this-procedure ( 5, "sumr",       string( buf_ord-line.sum-rubl             ) , 1 ).
     3020         run wp-xmltagput in this-procedure ( 5, "VATr",       string( v-VATr     )                        , 1 ).
     3021         run wp-xmltagput in this-procedure ( 5, "SLTr",       string( v-SLTr     )                        , 1 ).
     3022         run wp-xmltagput in this-procedure ( 5, "roadTaxr",   string( v-roadTaxr )                        , 1 ).
     3023         run wp-xmltagput in this-procedure ( 5, "transportr", string( (buf_ord-line.sum-transport-rubl * buf_ord-line.qnty  ) ), 1 ).
     3024         run wp-xmltagput in this-procedure ( 5, "otherr",     string( (buf_ord-line.sum-other-rubl     * buf_ord-line.qnty  ) ), 1 ).
     3025         run wp-xmltagput in this-procedure ( 5, "exciser",    string( buf_ord-line.sum-excise           ) , 1 ).
     3026         run wp-xmltagput in this-procedure ( 5, "sumb",       string( buf_ord-line.sum-base             ) , 1 ).
     3027         run wp-xmltagput in this-procedure ( 5, "VATb",       string( v-VATb     ) , 1 ).
     3028         run wp-xmltagput in this-procedure ( 5, "SLTb",       string( v-SLTb     ) , 1 ).
     3029         run wp-xmltagput in this-procedure ( 5, "roadTaxb",   string( v-roadTaxb ) , 1 ).
     3030         run wp-xmltagput in this-procedure ( 5, "transportb", string( (buf_ord-line.sum-transport-base * buf_ord-line.qnty ) ) , 1 ).
     3031         run wp-xmltagput in this-procedure ( 5, "otherb",     string( (buf_ord-line.sum-other-base     * buf_ord-line.qnty ) ) , 1 ).
     3032         run wp-xmltagclose in this-procedure ( 4, "docSum" ).
     3033       end.
     3034       else do:
     3035         undo, return error substitute( "*** ERR *** Не найдена строка документа &1. Товар &2 &3 &4."
     3036                                     , p-doc-code
     3037                                     , p-artic
     3038                                     , p-prod-type
     3039                                     , p-prod-code
     3040                                     ) .
     3041       end.
     3042     end.
     3043     else do:
     3044       undo, return error substitute( "*** ERR *** Не найден документ &1."
     3045                                   , p-doc-code
     3046                                   ) .
     3047     end.
     3048   end.
     3049   end procedure.
     3050   procedure convert-doc-type :
     3051     define input  parameter p-input-doc-type  as character no-undo .
     3052     define output parameter p-output-doc-type as character no-undo .
     3053     define variable v-doc-type  as character no-undo .
     3054   do
     3055   on error undo, return error return-value
     3056   :
     3057     assign
     3058       p-output-doc-type = ?
     3059     .
     3060     if v-bge-xml-bgeflold = "oracle":u
     3061     then do:
     3062       case p-input-doc-type :
     3063         when 'ОП':U
     3064         then do:
     3065           assign
     3066             v-doc-type = "op"
     3067           .
     3068         end.
     3069         otherwise do:
     3070           assign
     3071             v-doc-type = ?
     3072           .
     3073         end.
     3074       end case.
     3075       assign
     3076         p-output-doc-type = v-doc-type
     3077       .
     3078     end.
     3079   end.
     3080   end procedure.
     3081   procedure get-base-code-okv :
     3082   define input parameter p-base-code          as integer          no-undo.
     3083   define output parameter p-base-code-okv     as integer          no-undo.
     3084       define buffer buf_currency      for ub.currency.
     3085   do
     3086   for buf_currency
     3087   on error undo, return error
     3088   :
     3089       find first buf_currency no-lock
     3090            where buf_currency.curr-code = p-base-code
     3091       .
     3092       assign
     3093           p-base-code-okv = buf_currency.okv-code
     3094       .
     3095   end.
     3096   end procedure.
     3097   procedure fill_bge-xml_goods :
     3098   define input parameter p-parent-handle  as handle           no-undo.
     3099   define input parameter p-gds-code       as integer          no-undo.
     3100   do
     3101   on error undo, return error
     3102   :
     3103     if p-parent-handle :get-signature( "cb-fill_bge-xml_goods" ) <> "":U
     3104     then do:
     3105       run cb-fill_bge-xml_goods in p-parent-handle ( input p-gds-code ).
     3106     end.
     3107   end.
     3108   end procedure.
     3109   procedure fill_bge-xml_clients :
     3110   define input parameter p-parent-handle  as handle           no-undo.
     3111   define input parameter p-obj-type       as character        no-undo.
     3112   define input parameter p-obj-code       as integer          no-undo.
     3113   do
     3114   on error undo, return error
     3115   :
     3116     if p-parent-handle :get-signature( "cb-fill_bge-xml_clients" ) <> "":U
     3117     then do:
     3118       run cb-fill_bge-xml_clients in p-parent-handle ( input p-obj-type
     3119                                                      , input p-obj-code
     3120                                                      ).
     3121     end.
     3122   end.
     3123   end procedure.
     3124   procedure run-callback-write-doc-code :
     3125     define input parameter p-handle         as handle       no-undo.
     3126     define input parameter p-type           as character    no-undo.
     3127     define input parameter p-doc-code       as character    no-undo.
     3128     define input parameter p-log-file       as character    no-undo.
     3129     define variable v-procedure-name    as char no-undo.
     3130   do
     3131   on error undo, return error
     3132   :
     3133     case p-type
     3134     :
     3135       when 'ord-doc':U
     3136       then do:
     3137         assign
     3138           v-procedure-name = "fill-temp-ord-doc-code":U
     3139         .
     3140       end.
     3141     end case.
     3142     if lookup( v-procedure-name, p-handle :internal-entries ) > 0
     3143     then do:
     3144       run value( v-procedure-name ) in p-handle ( input p-doc-code ) no-error.
     3145       if error-status :error
     3146       then do:
     3147         run wp-XMLWriteLog in this-procedure ( input p-log-file
     3148                                              , input 1
     3149                                              , input substitute( "Ошибка при вызове callback - процедуры &1.", v-procedure-name )
     3150                                              ).
     3151       end.
     3152     end.
     3153     else do:
     3154       run wp-XMLWriteLog in this-procedure ( input p-log-file
     3155                                            , input 1
     3156                                            , input substitute( "Не найдена callback - процедура &1.", v-procedure-name )
     3157                                            ).
     3158     end.
     3159   end.
     3160   end procedure.
