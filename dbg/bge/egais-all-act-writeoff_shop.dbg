      190   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      191   procedure thbjattr_code :
      192      define input  parameter p-upper-code     as character no-undo .
      193      define input  parameter p-code           as character no-undo .
      194      define output parameter p-label          as character no-undo .
      195      define output parameter p-user-can-edit  as logical   no-undo .
      196      define output parameter p-output-display as logical   no-undo .
      197      define output parameter p-other          as character no-undo .
      198      define output parameter p-prop-list      as character no-undo .
      199      define output parameter p-prop-type-list as character no-undo .
      200      define output parameter p-prop-label-list as character no-undo .
      201      define output parameter p-global          as logical no-undo .
      202      define output parameter p-host           as logical no-undo .
      203      define output parameter p-shop           as logical no-undo .
      204      define output parameter p-store          as logical no-undo .
      205      define output parameter p-db             as logical no-undo .
      206      define variable p-region as logical no-undo.
      207      run thbjattr_code_reg in this-procedure (
      208                                               p-upper-code,
      209                                               p-code,
      210                                               output p-label,
      211                                               output p-user-can-edit,
      212                                               output p-output-display,
      213                                               output p-other,
      214                                               output p-prop-list,
      215                                               output p-prop-type-list,
      216                                               output p-prop-label-list,
      217                                               output p-global,
      218                                               output p-host,
      219                                               output p-shop,
      220                                               output p-store,
      221                                               output p-db,
      222                                               output p-region
      223                                               ).
      224   end procedure.
      225   procedure thbjattr_code_reg :
      226   define input  parameter p-upper-code     as character no-undo .
      227   define input  parameter p-code           as character no-undo .
      228   define output parameter p-label          as character no-undo .
      229   define output parameter p-user-can-edit  as logical   no-undo .
      230   define output parameter p-output-display as logical   no-undo .
      231   define output parameter p-other          as character no-undo .
      232   define output parameter p-prop-list      as character no-undo .
      233   define output parameter p-prop-type-list as character no-undo .
      234   define output parameter p-prop-label-list as character no-undo .
      235   define output parameter p-global          as logical no-undo .
      236   define output parameter p-host           as logical no-undo .
      237   define output parameter p-shop           as logical no-undo .
      238   define output parameter p-store          as logical no-undo .
      239   define output parameter p-db             as logical no-undo .
      240   define output parameter p-region         as logical no-undo .
      241   do
      242   on error undo, return error return-value
      243   :
      244       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      245       (input  p-upper-code
      246       ,input  p-code
      247       ,output p-label
      248       ,output p-user-can-edit
      249       ,output p-output-display
      250       ,output p-other
      251       ,output p-prop-list
      252       ,output p-prop-type-list
      253       ,output p-prop-label-list
      254       ,output p-global
      255       ,output p-host
      256       ,output p-shop
      257       ,output p-store
      258       ,output p-db
      259       ,output p-region
      260       ) no-error .
      261     if error-status :error
      262     then do:
      263       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      264     end.
      265   end.
      266   end procedure.
