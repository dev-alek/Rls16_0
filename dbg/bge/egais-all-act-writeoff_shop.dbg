      439   end.
      440   end procedure.
      441   procedure thbjattr_delete-section :
      442   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      443   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      444   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      445   do
      446   on error undo, return error return-value
      447   :
      448       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      449       (input  p-obj-type
      450       ,input  p-obj-code
      451       ,input  p-upper-code
      452       ) no-error .
      453     if error-status :error
      454     then do:
      455       undo, return error return-value .
      456     end.
      457   end.
      458   end procedure.
      459   procedure thbjattr_manual-edit :
      460   define input  parameter p-ucode          as character no-undo .
      461   define input  parameter p-code           as character no-undo .
      462   define output parameter p-section-num    as integer no-undo .
      463   do
      464   on error undo, return error return-value
      465   :
      466       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      467       (input  p-ucode
      468       ,input  p-code
      469       ,output  p-section-num
      470       ) no-error .
      471     if error-status :error
      472     then do:
      473       undo, return error return-value .
      474     end.
      475   end.
      476   end procedure.
      477   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   define temp-table tt-act-header
      479       field num           as character        label "№ акта"      format "X(30)"
      480       field date_         as date             label "Дата акта"
      481       field type_         as character        label "Основание списания" format "X(18)"
      482       field is-sent       as logical
      483       field answer_       as character        label "Ответ"       format "X(1500)"
      484       field RegID         as character        label "Рег. номер"  format "X(50)"
      485       index pi as primary unique
      486           num
      487   .
      488   define temp-table tt-gds-act
      489       field num           as character                label "№ акта"
      490       field position_     as integer                  label "№ пп"                    format ">>>9"
      491       field gds-code      like ub.goods.gds-code      label "Код товара   "
      492       field alc-code      as character                label "Алкогольный код"         format "X(21)"
      493       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
      494       field qnty          as decimal                  label "Количество"
      495       field marks-qnty    as integer                  label "Кол-во марок"
      496       field egais-name    as character
      497       index pi as primary unique
      498           position_
      499       index code
      500           gds-code
      501   .
      502   define new shared temp-table tt-marks
      503       field num                 as character            label "№ акта"
      504       field gds-part-position_  as integer
      505       field mark                as character            label "Марка"          format "X(100)"
      506       field new_                as logical
      507       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
      508       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
      509       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
      510       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
      511       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
      512       field flag                as logical              label "T"
      513       index pi as primary unique
      514           mark
      515   .
      516   define variable sw as handle no-undo .
      517   define variable v-file              as character no-undo initial "ActWriteOff_Shop1.xml".
      518   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
      519   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
      520   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
      521   procedure makeXML :
      522       create sax-writer sw .
      523       sw:formatted = true.
      524       sw:set-output-destination ("file", v-file).
      525       sw:encoding = "UTF-8".
      526       sw:start-document () .
      527       sw:start-element ("ns:Documents") .
      528       sw:insert-attribute ("Version", "1.0") .
      529       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      530       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      531       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
      532       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
      533           sw:start-element ("ns:Owner") .
      534               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      535           sw:end-element ("ns:Owner") .
      536           sw:start-element ("ns:Document") .
      537               sw:start-element ("ns:ActWriteOff") .
      538                   sw:write-data-element ("awr:Identity", tt-act-header.num) no-error .
      539                   sw:start-element ("awr:Header") .
      540                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) no-error .
      541                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      542                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) no-error .
      543                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
      544                   sw:end-element ("awr:Header") .
      545                   sw:start-element ("awr:Content") .
      546       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      547                       sw:start-element ("awr:Position") .
      548                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) no-error .
      549                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) no-error .
      550                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
      551                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
      552                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
      553                           sw:start-element ("awr:MarkCodeInfo") .
      554               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      555                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
      556               end.
      557                           sw:end-element ("awr:MarkCodeInfo") .
      558                       sw:end-element ("awr:Position") .
      559       end.
      560                   sw:end-element ("awr:Content") .
      561               sw:end-element ("ns:ActWriteOff") .
      562           sw:end-element ("ns:Document") .
      563       sw:end-element ("ns:Documents") .
      564       sw:end-document () .
      565       delete object sw.
      566   end procedure .
      567   procedure makeXMLegais_v2 :
      568       create sax-writer sw .
      569       sw:formatted = true.
      570       sw:set-output-destination ("file", v-file).
      571       sw:encoding = "UTF-8".
      572       sw:start-document () .
      573       sw:start-element ("ns:Documents") .
      574       sw:insert-attribute ("Version", "1.0") .
      575       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      576       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      577       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef_v2") .
      578       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      579       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOffShop_v2") .
      580       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
      581           sw:start-element ("ns:Owner") .
      582               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      583           sw:end-element ("ns:Owner") .
      584           sw:start-element ("ns:Document") .
      585               sw:start-element ("ns:ActWriteOffShop_v2") .
      586                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
      587                   sw:start-element ("awr:Header") .
      588                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
      589                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
      590                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
      591                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
      592                   sw:end-element ("awr:Header") .
      593                   sw:start-element ("awr:Content") .
      594       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      595           if tt-gds-act.qnty <= 0 then next.
      596                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
      597                       if not available buf_goods and (tt-gds-act.gds-code = 0 or tt-gds-act.gds-code =?)
      598                       then do :
      599                           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
      600                                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
      601                                                                  and X_ext-classif.db-num = 0
      602                                                                  and X_ext-classif.Key#_two = v-ext-sys
      603                                                                  and X_ext-classif.Key#_three = 0
      604                                                                  and X_ext-classif.CharKey_One = tt-gds-act.alc-code
      605                                                                  and X_ext-classif.CharKey_two = ""
      606                                                                  and X_ext-classif.CharKey_three = ""
      607                                                                  and X_ext-classif.nonunique = 0
      608                                                                  no-error .
      609                           if available X_ext-classif
      610                           then do :
      611                               tt-gds-act.gds-code = X_ext-classif.Key#_One .
      612                               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
      613                           end.
      614                       end.
      615                       sw:start-element ("awr:Position") .
      616                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
      617                           sw:start-element ("awr:Product") .
      618                               sw:write-data-element ("pref:UnitType", (if buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1 then "Unpacked" else "Packed")) .
      619                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
      620                               sw:write-data-element ("pref:ShortName", "") .
      621                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
      622                               if not (buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1)
      623                               then sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
      624                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
      625                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
      626                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
      627                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
      628                           end.
      629                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
      630                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
      631                                                                  and X_ext-classif-attr.db-num = 0
      632                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
      633                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
      634                                                                  and X_ext-classif-attr.Key#_three = 0
      635                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
      636                                                                  and X_ext-classif-attr.CharKey_two = ""
      637                                                                  and X_ext-classif-attr.CharKey_three = ""
      638                                                                  and X_ext-classif-attr.nonunique = 0
      639                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
      640                                                                  no-error .
      641                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
      642                             def var v-prod as char no-undo.
      643                             def var v-impor as char no-undo.
      644                             def var v-msg as char no-undo.
      645                             def var v-err as logical no-undo.
      646                             def var v-err-impor as logical no-undo.
      647                             v-err = false .
      648                             v-prod = ''.
      649                             v-impor = ''.
      650                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
      651                             if v-prod = ?
      652                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
      653                             or v-prod = ""
      654                             or num-entries (v-prod, chr (5)) < 8
      655                             or entry (7, v-prod, chr(5)) = ""
      656                             then do:
      657                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
      658                               v-err = true .
      659                             end.
      660                             if not v-err then do :
      661                               sw:start-element ("pref:Producer") .
      662                                sw:start-element ("oref:" + entry (7, v-prod, chr(5))) .
      663                                 if entry (7, v-prod, chr(5)) <> "TS" then do :
      664                                     if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
      665                                     if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
      666                                 end.
      667                                 else if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:TSNUM", entry (2, v-prod, chr(5)) ).
      668                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
      669                                 sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
      670                                 sw:start-element ("oref:address").
      671                                   sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
      672                                   if entry (8, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:RegionCode", entry (8, v-prod, chr(5)) ).
      673                                   sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
      674                                 sw:end-element ("oref:address").
      675                                sw:end-element ("oref:" + entry (7, v-prod, chr(5))) .
      676                               sw:end-element ("pref:Producer") .
      677                             end.
      678                           end.
      679                           else do:
      680                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
      681                           end.
      682                           sw:end-element ("awr:Product") .
      683                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
      684           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
      685           if available tt-marks and (tt-act-header.type_ = "Проверки" or tt-act-header.type_ = "Арест") then do :
      686                           sw:start-element ("awr:MarkCodeInfo") .
      687               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
      688                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
      689               end.
      690                           sw:end-element ("awr:MarkCodeInfo") .
      691           end.
      692                       sw:end-element ("awr:Position") .
      693       end.
      694                   sw:end-element ("awr:Content") .
      695               sw:end-element ("ns:ActWriteOffShop_v2") .
      696           sw:end-element ("ns:Document") .
      697       sw:end-element ("ns:Documents") .
      698       sw:end-document () .
      699       delete object sw.
      700   end procedure .
      701   procedure parseXML :
      702       define input parameter inFile as character no-undo .
      703       empty temp-table tt-act-header .
      704       empty temp-table tt-gds-act .
      705       CREATE X-DOCUMENT hDoc.
      706       CREATE X-NODEREF hRoot.
      707       hDoc:encoding = 'utf-8'.
      708       hDoc:LOAD("file", search(inFile),FALSE).
      709       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
      710       RUN GetChildren(hRoot, 1).
      711       DELETE OBJECT hDoc.
      712       DELETE OBJECT hRoot.
      713   end procedure .
      714   procedure GetChildren :
      715       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      716       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      717       DEFINE VARIABLE i AS INTEGER NO-UNDO.
      718       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      719       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      720       CREATE X-NODEREF hNoderef.
      721       CREATE X-NODEREF hText .
      722       REPEAT i = 1 TO hParent:NUM-CHILDREN:
      723           good = hParent:GET-CHILD(hNoderef,i).
      724           IF NOT good THEN
      725               LEAVE.
      726           IF hNoderef:SUBTYPE <> "element" THEN
      727               NEXT.
      728           hNoderef:GET-CHILD(hText, 1) no-error .
      729           IF hNoderef:NAME = "awr:Header" THEN do :
      730               create tt-act-header .
      731               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
      732           end .
      733           .
      734           IF hNoderef:NAME = "awr:ActNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
      735           IF hNoderef:NAME = "awr:ActDate" THEN
      736               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      737           IF hNoderef:NAME = "awr:TypeWriteOff" THEN assign tt-act-header.type_    = hText:node-value no-error .
      738           IF hNoderef:NAME = "awr:Position" THEN do :
      739               assign ii = 0 .
      740               create tt-gds-act .
      741               assign tt-gds-act.num = tt-act-header.num .
      742           end.
      743           IF hNoderef:NAME = "awr:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
      744           IF hNoderef:NAME = "awr:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
      745           IF hNoderef:NAME = "gds-code"     THEN do :
      746               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
      747               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
      748               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
      749           end.
      750           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
      751           IF hNoderef:NAME = "alc-code"     THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
      752           IF hNoderef:NAME = "awr:MarkCode" THEN do :
      753               create tt-marks.
      754               assign
      755                   tt-marks.num                    = tt-gds-act.num
      756                   tt-marks.gds-part-position_     = tt-gds-act.position_
      757                   tt-marks.mark                   = hText:node-value
      758                   tt-marks.gds-code               = tt-gds-act.gds-code
      759                   tt-marks.gds-name               = tt-gds-act.gds-name
      760                   tt-marks.alc-code               = tt-gds-act.alc-code
      761                   ii = ii + 1.
      762               .
      763               assign tt-gds-act.marks-qnty = ii .
      764           end.
      765           run GetChildren (hNoderef, (level + 1)).
      766       END.
      767       DELETE OBJECT hNoderef.
      768       DELETE OBJECT hText.
      769   END procedure.
      770   DEFINE BUTTON Btn_lkp
      771        LABEL "Просмотр"
      772        SIZE 15 BY 1.13.
      773   DEFINE BUTTON Btn_create
      774        LABEL "Создать"
      775        SIZE 15 BY 1.13.
      776   DEFINE BUTTON Btn_chg
      777        LABEL "Изменить"
      778        SIZE 15 BY 1.13.
      779   DEFINE BUTTON Btn_del
      780        LABEL "Удалить"
      781        SIZE 15 BY 1.13.
      782   DEFINE BUTTON Btn_send
      783        LABEL "Отправить"
      784        SIZE 15 BY 1.13.
      785   DEFINE BUTTON Btn_OK AUTO-GO
      786        LABEL "Выход"
      787        SIZE 15 BY 1.13
      788        BGCOLOR 8 .
      789   DEFINE BUTTON Btn_Ans
      790        LABEL "Посмотреть ответ"
      791        SIZE 20 BY 1.13
      792        BGCOLOR 8 .
      793   DEFINE BUTTON Btn_Sel AUTO-GO
      794        LABEL "Выбор"
      795        SIZE 15 BY 1.13
      796        BGCOLOR 8 .
      797   DEFINE BUTTON Btn_Edit
      798        LABEL "Редактировать"
      799        SIZE 15 BY 1.13 tooltip "Вернуть в 'Новые' для редактирования"
      800        BGCOLOR 8 .
      801   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
      802        LABEL "Дата с"
      803        VIEW-AS FILL-IN
      804        SIZE 9.5 BY 1 NO-UNDO.
      805   DEFINE VARIABLE f-date-2 AS DATE FORMAT "99/99/99":U
      806        LABEL "по"
      807        VIEW-AS FILL-IN
      808        SIZE 9.5 BY 1 NO-UNDO.
      809   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      810        VIEW-AS RADIO-SET HORIZONTAL
      811        RADIO-BUTTONS
      812             "Новые", 1,
      813             "Отправленные", 2
      814        SIZE 27 BY 1.25 NO-UNDO.
      815   DEFINE FRAME Dialog-Frame
      816        Btn_OK AT ROW 1.2 COL 2
      817        Btn_create at row 1.2 col 17
      818        Btn_chg at row 1.2 col 32
      819        Btn_del at row 1.2 col 47
      820        Btn_send at row 1.2 col 62
      821        Btn_Ans AT ROW 1.2 COL 32 WIDGET-ID 10
      822        Btn_lkp AT ROW 1.2 COL 17 WIDGET-ID 12
      823        Btn_Sel AT ROW 1.2 COL 17
      824        Btn_Edit AT ROW 1.2 COL 52
      825        RADIO-SET-1 AT ROW 1.2 COL 80 NO-LABEL WIDGET-ID 2
      826        f-date AT ROW 2.5 COL 8.63 COLON-ALIGNED WIDGET-ID 22
      827        f-date-2 AT ROW 2.5 COL 22.75 COLON-ALIGNED WIDGET-ID 26
      828        SPACE(2) SKIP(22.2)
      829       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      830            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      831            TITLE "Акты о списании товаров из торгового зала ЕГАИС"
      832            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      833   ASSIGN
      834          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      835          FRAME Dialog-Frame:HIDDEN           = TRUE.
      836   ON window-close OF FRAME Dialog-Frame
      837   do:
      838       delete object egais no-error .
      839     apply "END-ERROR":U to self.
      840   end.
      841   ON CHOOSE OF Btn_lkp IN FRAME Dialog-Frame
      842   DO:
      843       if not bh-act-header:available then return no-apply .
      844       run bge/egais-act-writeOff_shop.w (parparentproc, 'ПРОСМОТР':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      845   END.
      846   ON CHOOSE OF Btn_Edit IN FRAME Dialog-Frame
      847   DO:
      848       if not bh-act-header:available then return no-apply .
      849       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo_shop':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      850       entry(4, buf_clob-bind.descr, chr(4)) = string(no) no-error .
      851       entry(5, buf_clob-bind.descr, chr(4)) = "" no-error .
      852       entry(6, buf_clob-bind.descr, chr(4)) = "" no-error .
      853       bh-act-header:buffer-field ("is-sent"):buffer-value = string(no) no-error .
      854       bh-act-header:buffer-field ("answer_"):buffer-value = "" no-error .
      855       bh-act-header:buffer-field ("RegID"):buffer-value = "" no-error .
      856       find first ub.esys-all-attr
      857                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      858                   and ub.esys-all-attr.attr-code = "egais"
      859                   and ub.esys-all-attr.key2       = 4
      860                   and ub.esys-all-attr.attr-value = buf_clob-bind.uniq-key-rec
      861                   no-error.
      862       if available (ub.esys-all-attr )
      863       then do:
      864         delete ub.esys-all-attr .
      865       end.
      866       run refresh-query .
      867   END.
      868   ON CHOOSE OF Btn_Sel IN FRAME Dialog-Frame
      869   DO:
      870       if not bh-act-header:available then return no-apply .
      871       assign p-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
      872       if p-RegID = "" or p-RegID = ? or num-entries(p-RegID, CHR(5)) <> 2 then do :
      873           message "Данный акт либо относится к старой версии ЕГАИС, либо по нему ещё не получен ответ (в этом случае нажмите кнопку 'Посмотреть ответ')." view-as alert-box .
      874           p-RegID = "" .
      875           return no-apply .
      876       end.
      877       if entry(2, p-RegID, CHR(5)) = "R" then do :
      878           message "Данный акт о списании был отклонён ЕГАИС. Чтобы узнать причину нажмите кнопку 'Посмотреть ответ'" view-as alert-box .
      879           p-RegID = "" .
      880           return no-apply .
      881       end.
      882       assign p-RegID = entry(1, p-RegID, CHR(5)) .
      883   END.
      884   ON CHOOSE OF Btn_create IN FRAME Dialog-Frame
      885   DO:
      886       run bge/egais-act-writeOff_shop.w (parparentproc, 'ДОБАВЛЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      887       bh-act-header = egais:GetHndlTable(3, "").
      888       run refresh-query.
      889   END.
      890   ON CHOOSE OF Btn_chg IN FRAME Dialog-Frame
      891   DO:
      892       if not bh-act-header:available then return no-apply .
      893       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      894       run bge/egais-act-writeOff_shop.w (parparentproc, 'ИЗМЕНЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      895       bh-act-header = egais:GetHndlTable(3, "").
      896       run refresh-query.
      897   END.
      898   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
      899   DO:
      900       if not bh-act-header:available then return no-apply .
      901       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo_shop':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      902       delete buf_clob-bind .
      903       bh-act-header:buffer-delete () .
      904       run refresh-query.
      905   END.
      906   ON CHOOSE OF Btn_send IN FRAME Dialog-Frame
      907   DO:
      908       if not bh-act-header:available then return no-apply .
      909       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-awo_shop':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      910       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      911       os-delete "temp-ActWriteOff_shop.xml".
      912       copy-lob
      913       from  object buf_clob-data.cdata
      914       to  file 'temp-ActWriteOff_shop.xml'
      915       no-convert
      916       no-error .
      917       run parseXML in this-procedure (input "temp-ActWriteOff_shop.xml") .
      918       find first tt-act-header .
      919       v-file = 'ActWriteOff_Shop.xml' .
      920       os-delete "ActWriteOff_Shop.xml" .
      921       run makeXMLegais_v2 .
      922       egais:inNum = tt-act-header.num .
      923       egais:SendRequestUTM() .
      924       glog = egais:IsSent .
      925       glog = egais:StatusErr .
      926       if glog then do :
      927           message egais:Msg view-as alert-box.
      928           return no-apply.
      929       end.
      930       else do :
      931           entry (4, buf_clob-bind.descr, chr(4)) = "yes".
      932           bh-act-header:buffer-field ("is-sent"):buffer-value = true.
      933       end.
      934       run refresh-query.
      935       message "Акт " egais:inNum " отправлен" view-as alert-box .
      936   END.
      937   ON CHOOSE OF Btn_Ans IN FRAME Dialog-Frame
      938   DO:
      939     if not bh-act-header:available
      940       then return no-apply.
      941       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      942         egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
      943         egais:GetHndlTable(2, bh-act-header:buffer-field ("num"):buffer-value) .
      944         glog = egais:StatusErr .
      945         if glog
      946         and (bh-act-header:buffer-field ("answer_"):buffer-value = ""
      947           or bh-act-header:buffer-field ("answer_"):buffer-value = ? )
      948         then do :
      949               message egais:Msg view-as alert-box.
      950               return no-apply.
      951         end.
      952         else message (bh-act-header:buffer-field ("answer_"):buffer-value) view-as alert-box information .
      953     run refresh-query.
      954   END.
      955   ON value-changed OF RADIO-SET-1 IN FRAME Dialog-Frame
      956   do:
      957     assign RADIO-SET-1 .
      958     if RADIO-SET-1 = 1
      959     then do :
      960       ENABLE Btn_create Btn_chg Btn_del Btn_send
      961         WITH FRAME Dialog-Frame.
      962       HIDE Btn_Ans Btn_lkp Btn_Edit in FRAME Dialog-Frame.
      963     end.
      964     else do :
      965       ENABLE Btn_Ans Btn_lkp Btn_Edit
      966         WITH FRAME Dialog-Frame.
      967       HIDE Btn_create Btn_chg Btn_del Btn_send in FRAME Dialog-Frame.
      968     end.
      969     run refresh-query.
      970   end.
      971   ON leave OF f-date IN FRAME Dialog-Frame
      972   do:
      973     run refresh-query.
      974   end.
      975   ON return OF f-date IN FRAME Dialog-Frame
      976   do:
      977     run refresh-query.
      978   end.
      979   ON leave OF f-date-2 IN FRAME Dialog-Frame
      980   do:
      981     run refresh-query.
      982   end.
      983   ON return OF f-date-2 IN FRAME Dialog-Frame
      984   do:
      985     run refresh-query.
      986   end.
      987   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      988   then frame Dialog-Frame:PARENT = active-window.
      989   MAIN-BLOCK:
      990   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      991      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      992   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      994     (output v-db-num
      995     ,output v-user-id
      996     ) no-error .
      997     empty temp-table thbjattr_thbj-attr .
      998     run adm/shattri.p (
      999          input "get":U
     1000         ,input v-cntxt-obj-type
     1001         ,input v-cntxt-obj-code
     1002         ,input 'egais':U
     1003         ,input 'egais-fsrar':U
     1004         ,output v-value-character
     1005         ,output v-value-date
     1006         ,output v-value-decimal
     1007         ,output v-value-integer
     1008         ,output v-value-logical
     1009         ,output v-value-type
     1010         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1011         ) no-error .
     1012     assign
     1013       v-fs-rar = v-value-character
     1014     .
     1015     run adm/shattri.p (
     1016          input "get":U
     1017         ,input '':U
     1018         ,input 0
     1019         ,input 'egais':U
     1020         ,input 'egais-exsys':U
     1021         ,output v-value-character
     1022         ,output v-value-date
     1023         ,output v-value-decimal
     1024         ,output v-value-integer
     1025         ,output v-value-logical
     1026         ,output v-value-type
     1027         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1028         ) no-error .
     1029     assign v-ext-sys = v-value-integer .
     1030     egais = new ActWriteOff_Shop (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
     1031     egais:DbNum = v-db-num .
     1032     egais:User_Id = v-user-id .
     1033     bh-act-header = egais:GetHndlTable(3, "").
     1034     create query qh-act-header.
     1035     f-date = date (now) - 31.
     1036     f-date-2 = ?.
     1037     run refresh-query.
     1038     create browse browse-hdl-act-header
     1039       assign
     1040         title     = 'Акты о списании товара из торгового зала ЕГАИС'
     1041         frame     = frame Dialog-Frame:handle
     1042         query     = qh-act-header
     1043         x         = 10
     1044         y         = 60
     1045         width     = 104
     1046         height    = 22
     1047         visible   = true
     1048         read-only = true
     1049         sensitive = true
     1050         separators = true
     1051         column-resizable = true
     1052         column-scrolling = true
     1053         triggers:
     1054         end triggers
     1055     .
     1056     on row-display of browse-hdl-act-header do :
     1057         if valid-handle (calc-col-hndl) then do :
     1058             if RADIO-SET-1 = 1 then calc-col-hndl:SCREEN-VALUE = "Новый" .
     1059             else do :
     1060               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
     1061               if v-RegID = "" or v-RegID = ? or num-entries(v-RegID, CHR(5)) <> 2 then calc-col-hndl:SCREEN-VALUE = "Отправлен" .
     1062               if num-entries(v-RegID, CHR(5)) = 2 then do :
     1063                   if entry(2, v-RegID, CHR(5)) = "R" then do :
     1064                       calc-col-hndl:SCREEN-VALUE = "Отклонен" .
     1065                       calc-col-hndl:bgcolor = red_color .
     1066                   end.
     1067                   if entry(2, v-RegID, CHR(5)) = "A" then do :
     1068                       calc-col-hndl:SCREEN-VALUE = "Принят" .
     1069                       calc-col-hndl:bgcolor = green_color .
     1070                   end.
     1071               end.
     1072             end.
     1073         end.
     1074         if valid-handle (calc-col-hndl2) then do :
     1075             if RADIO-SET-1 = 1 then calc-col-hndl2:SCREEN-VALUE = " - " .
     1076             else do :
     1077               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
     1078               calc-col-hndl2:SCREEN-VALUE = entry(1, v-RegID, CHR(5)) .
     1079             end.
     1080         end.
     1081     end.
     1082     ON value-changed OF browse-hdl-act-header
     1083     do:
     1084         if calc-col-hndl:SCREEN-VALUE = "Отклонен" then enable Btn_Edit with FRAME Dialog-Frame .
     1085                                                    else disable Btn_Edit with FRAME Dialog-Frame .
     1086     end.
     1087     if not bh-act-header = ?
     1088     then do:
     1089       do ii = 1 to bh-act-header:num-fields - 3:
     1090         bcol[ii] = browse-hdl-act-header:add-like-column('tt-act-header' + '.' + bh-act-header:buffer-field (ii):name, 0, 'FILL-IN').
     1091       end.
     1092       calc-col-hndl = browse-hdl-act-header:add-calc-column("char", "X(10)", "", "Статус") .
     1093       calc-col-hndl2 = browse-hdl-act-header:add-calc-column("char", "X(20)", "", "RegID") .
     1094       browse-hdl-act-header:get-browse-column (1):width-chars = 30.
     1095       browse-hdl-act-header:get-browse-column (2):width-chars = 17.
     1096       browse-hdl-act-header:get-browse-column (3):width-chars = 20.
     1097       browse-hdl-act-header:get-browse-column (4):width-chars = 10.
     1098       browse-hdl-act-header:get-browse-column (5):width-chars = 20.
     1099     end.
     1100     run enable_UI.
     1101     apply "value-changed" to RADIO-SET-1 in frame Dialog-Frame.
     1102     if not p-select then hide Btn_sel in FRAME Dialog-Frame.
     1103     else do :
     1104         hide Btn_create Btn_chg Btn_del Btn_send RADIO-SET-1 Btn_Edit in FRAME Dialog-Frame.
     1105         assign
     1106           Btn_lkp:x = Btn_lkp:x + 120
     1107           Btn_Ans:x = Btn_Ans:x + 120
     1108         .
     1109         ENABLE Btn_Ans Btn_lkp Btn_sel WITH FRAME Dialog-Frame.
     1110     end.
     1111     wait-for go of frame Dialog-Frame.
     1112   end.
     1113   run disable_UI.
     1114   PROCEDURE disable_UI :
     1115     HIDE FRAME Dialog-Frame.
     1116   END PROCEDURE.
     1117   PROCEDURE enable_UI :
     1118     DISPLAY RADIO-SET-1 f-date f-date-2
     1119         WITH FRAME Dialog-Frame.
     1120     ENABLE Btn_OK RADIO-SET-1 f-date f-date-2
     1121         WITH FRAME Dialog-Frame.
     1122     VIEW FRAME Dialog-Frame.
     1123   END PROCEDURE.
     1124   PROCEDURE refresh-query :
     1125   def var v-proposition  as char no-undo.
     1126   if bh-act-header = ?
     1127     then return .
     1128     assign input frame Dialog-Frame
     1129       f-date
     1130       f-date-2
     1131     .
     1132     v-proposition =
     1133       (if f-date <> ? then " and tt-act-header.date_ >= " + string (f-date) else "") +
     1134       (if f-date-2 <> ? then " and tt-act-header.date_ <= " + string (f-date-2) else "")
     1135       .
     1136   if p-select then do :
     1137       qh-act-header:query-close.
     1138       qh-act-header:set-buffers (bh-act-header).
     1139       qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent and tt-act-header.type_ = 'Пересортица' &1 by tt-act-header.date_ descending", v-proposition) ).
     1140       qh-act-header:query-open.
     1141   end.
     1142   else do :
     1143     case RADIO-SET-1 :
     1144       when 1  then
     1145       do:
     1146         qh-act-header:query-close.
     1147         qh-act-header:set-buffers (bh-act-header).
     1148         qh-act-header:query-prepare ( substitute ("for each tt-act-header where not tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1149         qh-act-header:query-open.
     1150         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition) no-error .
     1151       end.
     1152       when 2  then
     1153       do:
     1154         qh-act-header:query-close.
     1155         qh-act-header:set-buffers (bh-act-header).
     1156         qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1157         qh-act-header:query-open.
     1158         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition ) no-error .
     1159       end.
     1160     end case.
     1161   end.
     1162   if bh-act-header:available
     1163     then qh-act-header:reposition-to-rowid ( bh-act-header:rowid ) no-error.
     1164   if valid-handle (browse-hdl-act-header) then apply "value-changed" to browse-hdl-act-header.
     1165   end.
     1166   PROCEDURE proc-row-leave :
     1167     if false then do:
     1168       do ii = 1 to extent (bcol).
     1169         bcol[ii]:bgcolor = RED_COLOR.
     1170       end.
     1171     end.
     1172   end.
