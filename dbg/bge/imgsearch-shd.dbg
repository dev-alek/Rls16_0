        1   block-level on error undo, throw.
        2   define variable vss-revision as character no-undo init "$Revision: $":U.
        3   define variable vss-author as character no-undo init "$Author: EShklyar $":U.
        4   define variable vss-date as character no-undo init "$Date: $":U.
        5   define variable vss-workfile as character no-undo init "$Workfile: imgsearch-shd.p $":U.
        6   define variable vss-archive as character no-undo init "$Archive: bge/imgsearch-shd.p $":U.
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input parameter parparentproc as widget-handle no-undo.
       67   define input parameter p_parent-handle as widget-handle no-undo.
       68   define input parameter p_log-handle as handle no-undo.
       69   define input parameter p_db-num-char as character no-undo.
       70   define input parameter p_task-type as character no-undo.
       71   define input parameter p_task-num as integer no-undo.
       72   define input parameter p_db-num as integer no-undo.
       73   define variable v-param-list as character no-undo.
       74   define variable v-param-type as character no-undo.
       75   define variable v-obj-list as character no-undo.
       76   define variable v-company as integer no-undo.
       77   define variable v-directory as character no-undo.
       78   define variable v-prefix as CHARACTER no-undo.
       79   define variable v-grp-fuel as char no-undo.
       80   define variable v-grp-spec as char no-undo.
       81   define variable ii as integer no-undo.
       82   define variable c_entry as character no-undo.
       83   define buffer buf_clients for ub.clients.
       84   define temp-table tt_obj-list no-undo
       85   field obj-type like ub.clients.obj-type
       86   field obj-code like ub.clients.obj-code.
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define temp-table temp-schedule-free no-undo
       89   field free-id as character
       90   field free-task-name as character
       91   field proc-run-name as character
       92   field proc-param-edit-name as character
       93   field conf-param as character
       94   field is-gbd as logical
       95   field is-ubd as logical
       96   field enable-concurrent-0 as logical
       97   field enable-concurrent-db as logical
       98   field other-info as character
       99   field enc-key as character
      100   field is-rum as logical
      101   index pi is unique primary
      102   free-id.
      103   procedure schedule-attr-name :
      104   do
      105     on error undo, return error
      106     :
      107     define input  parameter p-code           as character no-undo .
      108     define output parameter p-type           as character no-undo .
      109     define output parameter p-format         as character no-undo .
      110     define output parameter p-label          as character no-undo .
      111     define output parameter p-user-can-edit  as logical   no-undo .
      112     define output parameter p-output-display as logical   no-undo .
      113     define output parameter p-other          as character no-undo .
      114       if index(p-code, chr(4)) > 0 then do:
      115         p-code = entry(1, p-code, chr(4)).
      116       end.
      117       case p-code :
      118               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      119               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      120               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      121               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      122               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      123               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      124               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      125               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      126               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      127         otherwise do:
      128           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      129         end.
      130       end.
      131     end.
      132   end procedure.
      133   procedure schedule-attr-tooltip :
      134   do
      135     on error undo, return error
      136     :
      137       define input  parameter p-code    as character no-undo .
      138       define output parameter p-tooltip as character no-undo .
      139       define output parameter p-label   as character no-undo .
      140       if index(p-code, chr(4)) > 0 then do:
      141         p-code = entry(1, p-code, chr(4)).
      142       end.
      143       case p-code :
      144               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      145               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      146               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      147               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      148               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      149               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      150               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      151               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      152               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      153         otherwise do:
      154               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      155         end.
      156       end.
      157     end.
      158   end procedure.
      159   procedure schedule-attr-value :
      160   do
      161   on error undo, return error return-value
      162   :
      163   define input parameter  p-cre-db-num as integer    no-undo.
      164   define input parameter  p-task-type  as character  no-undo.
      165   define input parameter  p-task-num   as integer    no-undo.
      166   define input parameter  p-code       as character  no-undo.
      167   define output parameter p-value      as character  no-undo.
      168   define output parameter p-type       as character  no-undo.
      169       define variable v-format         as character no-undo .
      170       define variable v-label          as character no-undo .
      171       define variable v-user-can-edit  as logical   no-undo .
      172       define variable v-output-display as logical   no-undo .
      173       define variable v-other          as character no-undo .
      174       define buffer buf_schedule-attr for ub.schedule-attr.
      175       run schedule-attr-name in this-procedure (
      176             input  p-code
      177           , output p-type
      178           , output v-format
      179           , output v-label
      180           , output v-user-can-edit
      181           , output v-output-display
      182           , output v-other
      183       ) no-error .
      184       if error-status :error
      185       then do:
      186           undo, return error return-value .
      187       end.
      188       if p-code begins ('schd-free-id':U + chr(4))
      189       and entry(2, p-code, chr(4)) = '':U then do:
      190         find first buf_schedule-attr no-lock
      191             where buf_schedule-attr.cre-db-num = p-cre-db-num
      192               and buf_schedule-attr.task-type  = p-task-type
      193               and buf_schedule-attr.task-num   = p-task-num
      194               and buf_schedule-attr.attr-code  begins p-code
      195         no-error .
      196       end.
      197       else do:
      198         find first buf_schedule-attr no-lock
      199             where buf_schedule-attr.cre-db-num = p-cre-db-num
      200               and buf_schedule-attr.task-type  = p-task-type
      201               and buf_schedule-attr.task-num   = p-task-num
      202               and buf_schedule-attr.attr-code  = p-code
      203         no-error .
      204       end.
      205       if available buf_schedule-attr
      206       then do:
      207           assign
      208               p-value = buf_schedule-attr.attr-value
      209           .
      210       end.
      211       else do:
      212         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      213            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      214         end.
      215         else do:
      216           assign
      217               p-value = if p-type = 'L':U then "no":U else ""
      218           .
      219         end.
      220       end.
      221   end.
      222   end procedure.
      223   procedure schedule-attr-write :
      224   do
      225   on error undo, return error
      226   :
      227   define input parameter p-cre-db-num  as integer   no-undo.
      228   define input parameter p-task-type   as character no-undo.
      229   define input parameter p-task-num    as integer   no-undo.
      230   define input parameter p-code        as character no-undo.
      231   define input parameter p-value       as character no-undo.
      232       define variable v-type              as character                no-undo.
      233       define variable v-format            as character                no-undo.
      234       define variable v-label             as character                no-undo.
      235       define variable v-user-can-edit     as logical                  no-undo.
      236       define variable v-output-display    as logical                  no-undo.
      237       define variable v-other             as character                no-undo.
      238       define buffer buf_schedule-attr for ub.schedule-attr .
      239       run schedule-attr-name in this-procedure (
      240             input  p-code
      241           , output v-type
      242           , output v-format
      243           , output v-label
      244           , output v-user-can-edit
      245           , output v-output-display
      246           , output v-other
      247       ) no-error.
      248       if error-status :error
      249       then do:
      250           undo, return error return-value.
      251       end.
      252       find first buf_schedule-attr exclusive-lock
      253            where buf_schedule-attr.cre-db-num = p-cre-db-num
      254              and buf_schedule-attr.task-type  = p-task-type
      255              and buf_schedule-attr.task-num   = p-task-num
      256              and buf_schedule-attr.attr-code  = p-code
      257       no-error.
      258       if not available buf_schedule-attr
      259       then do:
      260           create buf_schedule-attr.
      261           assign
      262             buf_schedule-attr.cre-db-num = p-cre-db-num
      263             buf_schedule-attr.task-type  = p-task-type
      264             buf_schedule-attr.task-num   = p-task-num
      265             buf_schedule-attr.attr-code  = p-code
      266             buf_schedule-attr.attr-value = p-value
      267           .
      268       end.
      269       else do:
      270           assign
      271               buf_schedule-attr.attr-value = p-value
      272           .
      273       end.
      274   end.
      275   end procedure.
      276   procedure schedule-attr-delete :
      277   do
      278   on error undo, return error
      279   :
      280   define input  parameter p-cre-db-num  as integer   no-undo.
      281   define input  parameter p-task-type   as character no-undo.
      282   define input  parameter p-task-num    as integer   no-undo.
      283   define input  parameter p-code        as character no-undo.
      284   define output parameter p-deleted     as logical   no-undo.
      285       define buffer buf_schedule-attr for ub.schedule-attr .
      286       define variable v-type              as character                no-undo.
      287       define variable v-format            as character                no-undo.
      288       define variable v-label             as character                no-undo.
      289       define variable v-user-can-edit     as logical                  no-undo.
      290       define variable v-output-display    as logical                  no-undo.
      291       define variable v-other             as character                no-undo.
      292       run schedule-attr-name in this-procedure (
      293             input p-code
      294           , output v-type
      295           , output v-format
      296           , output v-label
      297           , output v-user-can-edit
      298           , output v-output-display
      299           , output v-other
      300       ) no-error .
      301       if error-status :error
      302       then do:
      303           undo, return error return-value .
      304       end.
      305       find first buf_schedule-attr exclusive-lock
      306            where buf_schedule-attr.cre-db-num = p-cre-db-num
      307              and buf_schedule-attr.task-type  = p-task-type
      308              and buf_schedule-attr.task-num   = p-task-num
      309              and buf_schedule-attr.attr-code  = p-code
      310       no-error.
      311       if not available buf_schedule-attr
      312       then do:
      313           assign
      314               p-deleted = no
      315           .
      316       end.
      317       else do:
      318           delete buf_schedule-attr.
      319           assign
      320               p-deleted = yes
      321           .
      322       end.
      323   end.
      324   end procedure.
      325   procedure schedule-attr-news :
      326   do
      327   on error undo, return error
      328   :
      329       define input  parameter p-code           as character no-undo .
      330       define output parameter p-news           as logical   no-undo .
      331       if index(p-code, chr(4)) > 0 then do:
      332         p-code = entry(1, p-code, chr(4)).
      333       end.
      334       case p-code :
      335               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      336               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      337               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      338               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      339               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      340               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      341               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      342               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      343               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      344         otherwise do:
      345           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      346         end.
      347       end.
      348   end.
      349   end procedure.
      350   procedure schedule-attr-extract-logical :
      351   do
      352   on error undo, return error
      353   :
      354   define input  parameter p-parameter-number   as integer      no-undo.
      355   define input  parameter p-parameter-list     as character    no-undo.
      356   define output parameter p-parameter-value   as logical      no-undo.
      357       if num-entries( p-parameter-list ) > p-parameter-number - 1
      358       then do:
      359           assign
      360               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      361           .
      362       end.
      363       else do:
      364           assign
      365               p-parameter-value   = no
      366           .
      367       end.
      368   end.
      369   end procedure.
      370   procedure schedule-attr-get-free-id :
      371   do
      372   on error undo, return error return-value
      373   :
      374     define input  parameter p-cre-db-num  as integer   no-undo.
      375     define input  parameter p-task-type   as character no-undo.
      376     define input  parameter p-task-num    as integer   no-undo.
      377     define output parameter p-free-id     as character no-undo.
      378     define buffer buf_schedule-attr for ub.schedule-attr.
      379     find first buf_schedule-attr no-lock
      380         where buf_schedule-attr.cre-db-num = p-cre-db-num
      381           and buf_schedule-attr.task-type  = p-task-type
      382           and buf_schedule-attr.task-num   = p-task-num
      383           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      384     no-error .
      385     if available buf_schedule-attr then
      386     assign
      387     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      388     no-error
      389     .
      390   end.
      391   end procedure.
      392   procedure schedule-attr-get-free-props :
      393     define input parameter p-free-id as character no-undo .
      394     define output parameter p-value as character no-undo .
      395     define buffer buf_temp-schedule-free for temp-schedule-free.
      396     do
      397     on error undo, return error return-value
      398     :
      399       find first buf_temp-schedule-free no-lock no-error .
      400       if not available buf_temp-schedule-free then do:
      401         run schedule-attr-fill-free-props in this-procedure .
      402       end.
      403       find first buf_temp-schedule-free where
      404               buf_temp-schedule-free.free-id = p-free-id no-error.
      405       if available buf_temp-schedule-free then do:
      406         assign
      407         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      408                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      409                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      410                   buf_temp-schedule-free.conf-param           + chr(4) +
      411                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      412                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      413                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      414                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      415                   buf_temp-schedule-free.other-info
      416         .
      417       end.
      418       else do:
      419        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      420                              "id произвольной задачи - &5"
      421                              ,vss-workfile
      422                              ,vss-revision
      423                              ,vss-description
      424                              ,chr(10)
      425                              ,p-free-id).
      426       end.
      427     end.
      428   end procedure.
      429   procedure schedule-attr-is-rum-free-id :
      430   define input parameter p-free-id as character no-undo .
      431   define output parameter p-is-rum as logical no-undo .
      432   define buffer buf_temp-schedule-free for temp-schedule-free.
      433   do
      434   on error undo, return error
      435   :
      436       find first buf_temp-schedule-free no-lock no-error .
      437       if not available buf_temp-schedule-free then do:
      438         run schedule-attr-fill-free-props in this-procedure .
      439       end.
      440       find first buf_temp-schedule-free where
      441               buf_temp-schedule-free.free-id = p-free-id no-error.
      442       if available buf_temp-schedule-free
      443       and buf_temp-schedule-free.is-rum
      444       then do:
      445         p-is-rum = yes.
      446       end.
      447   end.
      448   end procedure.
      449   procedure schedule-attr-fill-free-props :
      450   define variable v-path                    as character                no-undo .
      451   DEFINE VARIABLE v-full-path               as character                no-undo .
      452   DEFINE VARIABLE v-file-name               as character                no-undo .
      453   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      454   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      455   define buffer buf_temp-schedule-free for temp-schedule-free.
      456   define variable v-answer as logical no-undo .
      457     do
      458     on error undo, return error substitute("&1 &2 &3&4&5&4"
      459                                           ,vss-workfile
      460                                           ,vss-revision
      461                                           ,vss-description
      462                                           ,chr(10)
      463                                           ,error-status:get-message(1) )
      464     :
      465       run gbl/filename.p (
      466                       input 'cmp/shd-free.d'
      467                     ,output v-full-path
      468                     ,output v-path
      469                     ,output v-file-name
      470                     ,output v-file-name-no-ext
      471                     ,output v-file-name-ext
      472                     ) .
      473       input from value(v-full-path).
      474       repeat :
      475         create buf_temp-schedule-free.
      476         import buf_temp-schedule-free.
      477       END.
      478       input close.
      479       _ff:
      480       for each buf_temp-schedule-free :
      481         if buf_temp-schedule-free.free-id = '':U then do:
      482            delete buf_temp-schedule-free.
      483            next _ff.
      484          end.
      485          run schedule-attr-check-enc in this-procedure (
      486                                                       input  buf_temp-schedule-free.free-id
      487                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      488                                                               buf_temp-schedule-free.proc-param-edit-name +
      489                                                               buf_temp-schedule-free.conf-param +
      490                                                               string(buf_temp-schedule-free.is-gbd) +
      491                                                               string(buf_temp-schedule-free.is-ubd) +
      492                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      493                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      494                                                               string(buf_temp-schedule-free.other-info)
      495                                                               )
      496                                                       ,input  buf_temp-schedule-free.enc-key
      497                                                       ,output v-answer    ) no-error .
      498          if error-status:error
      499          or not v-answer then delete buf_temp-schedule-free.
      500        end.
      501     end.
      502   end procedure.
      503   Function schedule-attr-reverse returns character (str as character).
      504      define variable rev_incl_s as character init "" no-undo .
      505      define variable rev_incl_i as integer no-undo .
      506      define variable rev_incl_l as integer no-undo .
      507      rev_incl_l = length(str).
      508      do rev_incl_i = 1 to rev_incl_l:
      509         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      510      end.
      511      return rev_incl_s.
      512   end.
      513   procedure schedule-attr-check-enc.
      514     define input  parameter p-free-id   as character no-undo .
      515     define input  parameter p-value     as character no-undo .
      516     define input  parameter p-enc-value as character no-undo .
      517     define output parameter p-answer    as logical   no-undo .
      518     define variable tmp         as character no-undo .
      519     define variable v-enc-value as character no-undo .
      520     assign
      521     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      522     .
      523     run schedule-attr-pswd-enc in this-procedure
      524       ( input tmp
      525        ,output v-enc-value
      526       ) no-error .
      527     if error-status:error then do:
      528       message
      529         vss-workfile vss-revision vss-description skip
      530         "Ошибка при вызове процедуры pswd-enc" skip
      531         return-value skip
      532         error-status :get-message(1) skip
      533         view-as alert-box error .
      534       undo, return error .
      535     end.
      536     if v-enc-value = p-enc-value then do:
      537       assign
      538         p-answer = true
      539       .
      540     end.
      541     else do:
      542       assign
      543         p-answer = false
      544       .
      545     end.
      546   end.
      547   procedure schedule-attr-conf-enc.
      548     define input  parameter p-free-id   as character no-undo .
      549     define input  parameter p-value     as character no-undo .
      550     define output parameter p-enc-value as character no-undo .
      551     define variable tmp         as character no-undo .
      552     assign
      553       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      554     .
      555     run schedule-attr-pswd-enc in this-procedure
      556       ( input tmp
      557        ,output p-enc-value
      558       ) no-error .
      559     if error-status:error then do:
      560       message
      561         vss-workfile vss-revision vss-description skip
      562         "Ошибка при вызове процедуры pswd-enc" skip
      563         return-value skip
      564         error-status :get-message(1) skip
      565         view-as alert-box error .
      566       undo, return error .
      567     end.
      568   end procedure.
      569   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure schedule-attr-pswd-enc :
      571     define input parameter  pswd     as character no-undo .
      572     define output parameter enc-pswd as character no-undo .
      573     do
      574     on error undo, return error return-value
      575     :
      576       assign
      577         enc-pswd = encode(pswd + string(index(pswd, "k")))
      578       .
      579     end.
      580   end procedure.
      581   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      582                                              input p_task-type,
      583                                              input p_task-num,
      584                                              input 'schedule-param-list':U,
      585                                              output v-param-list,
      586                                              output v-param-type).
      587   assign
      588       v-company = integer(entry(1,v-param-list,chr(4)))
      589       v-directory = entry(2,v-param-list,chr(4))
      590       v-prefix = entry(3,v-param-list,chr(4))
      591       v-grp-fuel = entry(4,v-param-list,chr(4))
      592       v-grp-spec = entry(5,v-param-list,chr(4))
      593       NO-ERROR.
      594                              run utl\imgsearch.p (parparentproc
      595                                                  ) .
