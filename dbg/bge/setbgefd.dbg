        1   block-level on error undo, throw.
        2   define input parameter p-table-name        as character    no-undo.
        3   define input parameter p-host-code         as integer   no-undo.
        4   define input parameter p-fin-doc-code      as integer    no-undo.
        5   define input parameter p-corr-user-db-num  as integer no-undo .
        6   define input parameter p-chip-num          as integer no-undo .
        7   define input parameter p-cur-date          as date       no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       10   define variable vss-date        as character no-undo init "$Date: Tue Apr 10 12:04:11 2018 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: setbgefd.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/setbgefd.p $":U .
       13   define variable vss-description as character no-undo init "Устанавливает дату выгрузки в атрибут платежа".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6':u, p-table-name, p-host-code, p-fin-doc-code, p-corr-user-db-num, p-chip-num, p-cur-date)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   do
       87   on error undo, return error
       88   :
       89   define buffer buf_fin-doc  for ub.fin-doc.
       90   define buffer buf_c-fin-doc     for ub.c-fin-doc.
       91   case p-table-name:
       92     when "fin-doc":U  then do:
       93       find first buf_fin-doc exclusive-lock where
       94                buf_fin-doc.host-code = p-host-code
       95           AND  buf_fin-doc.fin-doc-code = p-fin-doc-code no-error .
       96         if available buf_fin-doc then assign
       97             buf_fin-doc.bge-date = p-cur-date
       98         .
       99      end.
      100      when "c-fin-doc":U then do:
      101       find first buf_c-fin-doc exclusive-lock where
      102                buf_c-fin-doc.host-code = p-host-code
      103           AND  buf_c-fin-doc.fin-doc-code = p-fin-doc-code
      104           AND  buf_c-fin-doc.corr-user-db-num = p-corr-user-db-num
      105           AND  buf_c-fin-doc.chip-num       = p-chip-num no-error.
      106         if available buf_c-fin-doc then assign
      107             buf_c-fin-doc.bge-date = p-cur-date
      108         .
      109      end.
      110     end case.
      111     if error-status:error then do:
      112       return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description + chr(32)  +  return-value ).
      113     end.
      114   end.
