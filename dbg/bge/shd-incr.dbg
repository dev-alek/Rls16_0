     3078                           , input buf_temp_ord-doc-code.doc-code
     3079                           , input v-today
     3080                           ) .
     3081       end.
     3082       run wp-XMLWriteLog in this-procedure (
     3083             input v-log-file-name
     3084           , input 1
     3085           , input substitute( "Данные выгружены в файл &1 " , replace( v-xml-file-name, "/", "\" ) + "xml" )
     3086       ).
     3087   end.
     3088   procedure export-docs-by-object :
     3089   do
     3090   on error undo, return error
     3091   :
     3092   define input parameter p-host-code  as integer      no-undo.
     3093   define input parameter p-obj-type   as character    no-undo.
     3094   define input parameter p-obj-code   as integer      no-undo.
     3095       define variable v-start-date        as date         no-undo.
     3096       define variable v-not-exists        as logical      no-undo.
     3097       define variable v-archive-ok        as logical      no-undo.
     3098       define variable v-comment           as character    no-undo.
     3099       run wp-XMLWriteLog in this-procedure (
     3100             input v-log-file-name
     3101           , input 1
     3102           , input " > Экспорт документов по объекту " + p-obj-type + string( p-obj-code )
     3103       ).
     3104       run wp-XMLWriteLog in this-procedure (
     3105             input v-log-file-name
     3106           , input 2
     3107           , input "Расчет архивов"
     3108       ).
     3109       run bge/bge-ahzs.p (
     3110             input p-obj-type
     3111           , input p-obj-code
     3112           , input yes
     3113           , input yes
     3114           , input no
     3115           , input v-today
     3116           , input v-today
     3117           , output v-archive-ok
     3118           , output v-comment
     3119       ) no-error.
     3120       if error-status :error
     3121       then do:
     3122           message
     3123           vss-workfile vss-revision vss-description
     3124           skip "Ошибка проверки архивов на объекте."
     3125           skip "Тип объекта:" p-obj-type
     3126           skip "Код объекта:" p-obj-code
     3127           skip return-value
     3128           skip trim(error-status :get-message(1))
     3129               trim(error-status :get-message(2))
     3130               trim(error-status :get-message(3))
     3131           view-as alert-box error.
     3132           undo, return error .
     3133       end.
     3134       if v-archive-ok = no
     3135       then do:
     3136           run wp-XMLWriteLog in this-procedure (
     3137                 input v-log-file-name
     3138               , input 1
     3139               , input substitute( "*** Документы по объекту &1 &2 на дату &3 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &4."
     3140                                       , p-obj-type
     3141                                       , p-obj-code
     3142                                       , v-today
     3143                                       , v-comment       )
     3144           ).
     3145           undo, return error .
     3146       end.
     3147       run get-start-date in this-procedure (
     3148             input p-obj-type
     3149           , input p-obj-code
     3150           , output v-start-date
     3151           , output v-not-exists
     3152       ).
     3153       if v-not-exists = yes
     3154       then do:
     3155           run wp-XMLWriteLog in this-procedure (
     3156                 input v-log-file-name
     3157               , input 2
     3158               , input "Нет архивов или документов для выгрузки. Невозможно выгрузить данные по документам."
     3159           ).
     3160           undo, return error .
     3161       end.
     3162       assign
     3163         v-obj-str = substitute( "Инкрементальная выгрузка по объекту &1 &2"
     3164                               , p-obj-type
     3165                               , p-obj-code
     3166                               )
     3167       .
     3168       run waitfram-show in this-procedure ( input v-obj-str ) .
     3169       run bge/doc-incr.p (
     3170             input p-host-code
     3171           , input v-today
     3172           , input v-start-date
     3173           , input p-obj-type
     3174           , input p-obj-code
     3175           , input yes
     3176           , input yes
     3177           , input yes
     3178           , input yes
     3179           , input yes
     3180           , input yes
     3181           , input p-need-checks
     3182           , input p-doc-rvs
     3183           , input v-xml-file-name
     3184           , input v-log-file-name
     3185           , input this-procedure :handle
     3186           , input ?
     3187           , input ?
     3188           , input ?
     3189           , input ?
     3190       ) no-error.
     3191       if error-status :error
     3192       then do:
     3193           run wp-XMLWriteLog in this-procedure (
     3194                 input v-log-file-name
     3195               , input 1
     3196               , input substitute( "*** Ошибка экспорта документов. &1. &2", return-value, trim(error-status :get-message(1)) )
     3197           ).
     3198       end.
     3199       run wp-XMLWriteLog in this-procedure (
     3200             input v-log-file-name
     3201           , input 1
     3202           , input substitute( " < Экспорт документов по объекту &1 &2 завершен.", p-obj-type, p-obj-code )
     3203       ).
     3204       run waitfram-hide in this-procedure .
     3205   end.
     3206   end procedure.
     3207   procedure get-start-date :
     3208   do
     3209   on error undo, return error
     3210   :
     3211   define input parameter p-obj-type       as character    no-undo.
     3212   define input parameter p-obj-code       as integer      no-undo.
     3213   define output parameter p-start-date    as date         no-undo.
     3214   define output parameter p-not-exist     as logical      no-undo.
     3215       define buffer buf_trn-doc       for ub.trn-doc.
     3216       define buffer buf_price-doc     for ub.price-doc.
     3217       define buffer buf_ot-tot        for ub.ot-tot.
     3218       find-first-ot-tot:
     3219       for each buf_ot-tot no-lock
     3220          where buf_ot-tot.obj-type = p-obj-type
     3221            and buf_ot-tot.obj-code = p-obj-code
     3222       use-index obj-ot
     3223       :
     3224           find first buf_trn-doc no-lock
     3225                where buf_trn-doc.doc-code = buf_ot-tot.doc-code
     3226           no-error.
     3227           if available buf_trn-doc
     3228           and buf_trn-doc.fact-date <> ?
     3229           then do:
     3230               assign
     3231                   p-not-exist     = no
     3232                   p-start-date    = buf_trn-doc.fact-date
     3233               .
     3234               leave find-first-ot-tot.
     3235           end.
     3236           else do:
     3237               find first buf_price-doc no-lock
     3238                    where buf_price-doc.doc-num = buf_ot-tot.doc-code
     3239               no-error.
     3240               if available buf_price-doc
     3241               and buf_price-doc.fact-date <> ?
     3242               then do:
     3243                   assign
     3244                       p-not-exist     = no
     3245                       p-start-date    = buf_price-doc.fact-date
     3246                   .
     3247                   leave find-first-ot-tot.
     3248               end.
     3249           end.
     3250       end.
     3251   end.
     3252   end procedure.
     3253   procedure fill-temp-doc-code :
     3254   do
     3255   on error undo, return error
     3256   :
     3257   define input parameter p-doc-code   as character    no-undo.
     3258       define buffer buf_temp_doc-code     for temp_doc-code.
     3259       create buf_temp_doc-code.
     3260       assign
     3261           buf_temp_doc-code.doc-code = p-doc-code
     3262       .
     3263   end.
     3264   end procedure.
     3265   procedure fill-temp-del-doc-code :
     3266   do
     3267   on error undo, return error
     3268   :
