      644                       when chr(9)
      645                       then do:
      646                           assign
      647                               p-out-string = p-out-string + " ":U
      648                           .
      649                       end.
      650                       when chr(29)
      651                       then do:
      652                           assign
      653                               p-out-string = p-out-string + " ":U
      654                           .
      655                       end.
      656                       when chr(10)
      657                       then do:
      658                           assign
      659                               p-out-string = p-out-string + " ":U
      660                           .
      661                       end.
      662                       when chr(13)
      663                       then do:
      664                           assign
      665                               p-out-string = p-out-string + " ":U
      666                           .
      667                       end.
      668                       otherwise do:
      669                           assign
      670                               p-out-string = p-out-string + v-current-char
      671                           .
      672                       end.
      673                   end case.
      674               end.
      675           end.
      676       end case.
      677   end.
      678   end .
      679   procedure xmlchar-decode :
      680   define input parameter p-in-string      as character        no-undo.
      681   define output parameter p-out-string    as character        no-undo.
      682       define variable v-position      as integer      no-undo.
      683       define variable v-last-position as integer      no-undo.
      684       define variable v-temp-integer  as integer      no-undo.
      685       define variable v-current-char  as character    no-undo.
      686       define variable v-next-char     as character    no-undo.
      687       define variable v-success       as logical      no-undo.
      688   do
      689   on error undo, return error
      690   :
      691       assign
      692           p-out-string = "":U
      693           v-position   = 0
      694       .
      695       replace-cycle:
      696       do while yes
      697       on error undo, return error
      698       :
      699           assign
      700               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      701           .
      702           if v-last-position <= v-position
      703           then do:
      704               if v-position = 0
      705               then do:
      706                   assign
      707                       p-out-string = p-in-string
      708                   .
      709               end.
      710               else do:
      711                   assign
      712                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      713                   .
      714               end.
      715               leave replace-cycle.
      716           end.
      717           else do:
      718               assign
      719                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      720                   v-position      = v-last-position
      721                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      722               .
      723               if v-current-char = "#":U
      724               then do:
      725                   assign
      726                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      727                   .
      728                   if v-last-position > 0
      729                   then do:
      730                       run xmlchar-read-integer in this-procedure
      731                        (
      732                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      733                           , output v-temp-integer
      734                           , output v-success
      735                       ).
      736                       if v-success = yes
      737                       and v-temp-integer >= 1
      738                       and v-temp-integer <= 255
      739                       then do:
      740                           assign
      741                               p-out-string = p-out-string + chr( v-temp-integer )
      742                               v-position   = v-last-position + 1
      743                           .
      744                       end.
      745                       else do:
      746                           assign
      747                               p-out-string = p-out-string + "&":U
      748                               v-position   = v-position   + 1
      749                           .
      750                       end.
      751                   end.
      752                   else do:
      753                       assign
      754                           p-out-string = p-out-string + "&":U
      755                           v-position   = v-position   + 1
      756                       .
      757                   end.
      758               end.
      759               else do:
      760                   case substring( p-in-string, v-position + 1, 3 )
      761                   :
      762                       when "lt;":U
      763                       then do:
      764                           assign
      765                               p-out-string = p-out-string + "<":U
      766                               v-position   = v-position   + 3
      767                           .
      768                       end.
      769                       when "gt;":U
      770                       then do:
      771                           assign
      772                               p-out-string = p-out-string + ">":U
      773                               v-position   = v-position   + 3
      774                           .
      775                       end.
      776                       otherwise do:
      777                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      778                           then do:
      779                               assign
      780                                   p-out-string = p-out-string + "&":U
      781                                   v-position   = v-position   + 4
      782                               .
      783                           end.
      784                           else do:
      785                               case substring( p-in-string, v-position + 1, 5 )
      786                               :
      787                                   when "quot;":U
      788                                   then do:
      789                                       assign
      790                                           p-out-string = p-out-string + '"':U
      791                                           v-position   = v-position   + 5
      792                                       .
      793                                   end.
      794                                   when "apos;":U
      795                                   then do:
      796                                       assign
      797                                           p-out-string = p-out-string + "'":U
      798                                           v-position   = v-position   + 5
      799                                       .
      800                                   end.
      801                                   otherwise do:
      802                                       assign
      803                                           p-out-string = p-out-string + "&":U
      804                                       .
      805                                   end.
      806                               end case.
      807                           end.
      808                       end.
      809                   end case.
      810               end.
      811           end.
      812       end.
      813   end.
      814   end .
      815   procedure xmlchar-read-integer :
      816   define input parameter p-input-string      as character        no-undo.
      817   define output parameter p-output-integer   as integer          no-undo.
      818   define output parameter p-success       as logical          no-undo.
      819   do
      820   on error undo, return error
      821   :
      822       assign
      823           p-output-integer = integer( p-input-string )
      824       no-error.
      825       if error-status :error
      826       then do:
      827           assign
      828               p-success           = no
      829               p-output-integer    = 0
      830           .
      831       end.
      832       else do:
      833           assign
      834               p-success           = yes
      835           .
      836       end.
      837   end.
      838   end.
      839   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      840   procedure strtdate :
      841     define input  parameter p-str         as character no-undo .
      842     define output parameter p-value       as date      no-undo .
      843     define output parameter p-data-valid  as logical   no-undo .
      844     define output parameter p-message     as character no-undo .
      845   do
      846   on error undo, return error return-value
      847   :
      848     define variable v-value       as date      no-undo .
      849     define variable v-i           as integer   no-undo .
      850     define variable v-num         as integer   no-undo .
      851     define variable v-delim       as character no-undo .
      852     define variable v-delim-list  as character no-undo .
      853     define variable v-day         as integer   no-undo .
      854     define variable v-month       as integer   no-undo .
      855     define variable v-year        as integer   no-undo .
      856     define variable v-day-str     as character no-undo .
      857     define variable v-month-str   as character no-undo .
      858     define variable v-year-str    as character no-undo .
      859     assign
      860       p-value       = ?
      861       p-data-valid  = false
      862     .
      863     if p-str = ?
      864     then do:
      865       assign
      866         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      867       .
      868       return .
      869     end.
      870     if p-str = ""
      871     then do:
      872       assign
      873         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      874       .
      875       return .
      876     end.
      877     if length(p-str)  > 10
      878     then do:
      879       assign
      880         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      881       .
      882       return .
      883     end.
      884     assign
      885       v-delim-list = '/,-,.':U
      886     .
      887     _delim:
      888     do v-i = 1 to num-entries( v-delim-list )
      889     :
      890       assign
      891         v-delim = entry( v-i , v-delim-list )
      892         v-num   = num-entries( p-str , v-delim )
      893       .
      894       if v-num <> 3
      895       then do:
      896         assign
      897           v-delim = ''
      898         .
      899       end.
      900       else do:
      901         leave _delim.
      902       end.
      903     end.
      904     if v-delim = ''
      905     then do:
      906       assign
      907         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      908       .
      909       return .
      910     end.
      911     assign
      912       v-day-str   = entry( 1, p-str , v-delim)
      913       v-month-str = entry( 2, p-str , v-delim)
      914       v-year-str  = entry( 3, p-str , v-delim)
      915     .
      916     if  length(v-day-str) > 2   or
      917         length(v-day-str) < 1   or
      918         length(v-month-str) > 2 or
      919         length(v-month-str) < 1 or
      920         (
      921           length(v-year-str) <> 2 and
      922           length(v-year-str) <> 4
      923         )
      924     then do:
      925       assign
      926         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      927       .
      928       return .
      929     end.
      930     if length( v-year-str ) = 2
      931     then do:
      932       assign
      933         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      934       .
      935     end.
      936     assign
      937       v-day   = integer( v-day-str )
      938       v-month = integer( v-month-str)
      939       v-year  = integer( v-year-str)
      940     no-error .
      941     if error-status :error
      942     then do:
      943       assign
      944         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      945       .
      946       return .
      947     end.
      948     if v-day < 1  or
      949        v-day > 31 or
      950        v-month < 1 or
      951        v-month > 12 or
      952        v-year < 0   or
      953        v-year > 5000
      954     then do:
      955       assign
      956         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      957       .
      958       return .
      959     end.
      960     assign
      961       v-value = date( v-month, v-day, v-year )
      962     no-error .
      963     if error-status :error
      964     then do:
      965       assign
      966         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      967       .
      968       return .
      969     end.
      970     assign
      971       p-value       = v-value
      972       p-data-valid  = true
      973     .
      974   end.
      975   end procedure.
      976   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      977   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
