     1076   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1077                                             INPUT iFlagEmpty AS INTEGER).
     1078       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1079       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1080           DO:
     1081               IF iFlagEmpty = 0                           THEN RETURN "".
     1082               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1083               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1084               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1085               ELSE RETURN "".
     1086           END.
     1087       ELSE DO:
     1088           run xmlchar-encode in this-procedure (
     1089                 input sToPlace
     1090               , output sToPlace
     1091           ).
     1092           ASSIGN
     1093               sToPlace = sParName + '="' + sToPlace + '"'
     1094           .
     1095           RETURN sToPlace.
     1096       END.
     1097   END FUNCTION.
     1098   function bge-xml-date returns character
     1099   ( input p-date as date )
     1100   :
     1101     define variable v-date-str as character no-undo .
     1102     run bge-xml-date-to-str in this-procedure ( input   p-date
     1103                                               , output  v-date-str
     1104                                               ) .
     1105     return v-date-str.
     1106   end function.
     1107   function bge-xml-str-date returns character
     1108   ( input p-date-str as character )
     1109   :
     1110     define variable v-date-str as character no-undo .
     1111     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1112                                                   , output  v-date-str
     1113                                                   ) .
     1114     return v-date-str.
     1115   end function.
     1116   function bge-xml-normalize-dec returns decimal
     1117   ( input p-val as decimal )
     1118   :
     1119     return (if p-val = ? then 0 else p-val) .
     1120   end function.
     1121   PROCEDURE wp-XMLTagOpen:
     1122   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1123   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1124   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1125       define variable v-out-string    as character    no-undo.
     1126   do
     1127   on error undo, return error
     1128   :
     1129       if v-bge-xml-bgefmt = "dbf":U
     1130       then do:
     1131       end.
     1132       else do:
     1133           assign
     1134               v-out-string = substitute( "&1&2<&3&4>"
     1135                                       , chr(10)
     1136                                       , fill( " ":U, 4 * iTagLevel)
     1137                                       , sTagName
     1138                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1139                               )
     1140           .
     1141           put stream stmXMLOut unformatted
     1142               v-out-string
     1143           .
     1144       end.
     1145   end.
     1146   END PROCEDURE.
     1147   PROCEDURE wp-XMLTagPut:
     1148     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1149     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1150     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1151     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1152       define variable v-out-string    as character    no-undo.
     1153   do
     1154   on error undo, return error
     1155   :
     1156       if v-bge-xml-bgefmt = "dbf":U
     1157       then do:
     1158           if v-bge-xml-dbf-file-name <> "":U
     1159           then do:
     1160               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1161               export stream stmXMLOut
     1162                   sTagName
     1163                   sParValue
     1164               .
     1165               output stream stmXMLOut close.
     1166           end.
     1167       end.
     1168       else do:
     1169           IF  iFlagEmpty = 1
     1170           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1171           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1172           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1173           THEN DO:
     1174               run xmlchar-encode in this-procedure (
     1175                   input sParValue
     1176                   , output sParValue
     1177               ).
     1178               assign
     1179                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1180                                               , chr(10)
     1181                                               , FILL(" ", 4 * iTagLevel)
     1182                                               , sTagName
     1183                                               , sParValue
     1184                               )
     1185               .
     1186               PUT STREAM stmXMLOut UNFORMATTED
     1187                   v-out-string
     1188               .
     1189           END.
     1190       end.
     1191   end.
     1192   END PROCEDURE.
     1193   PROCEDURE wp-XMLTagClose:
     1194   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1195   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1196       define variable v-out-string    as character    no-undo.
     1197   do
     1198   on error undo, return error
     1199   :
     1200       if v-bge-xml-bgefmt = "dbf":U
     1201       then do:
     1202       end.
     1203       else do:
     1204           assign
     1205               v-out-string = substitute( "&1&2</&3>"
     1206                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1207                                   , fill( " ", 4 * iTagLevel )
     1208                                   , sTagName
     1209                           )
     1210           .
     1211           PUT STREAM stmXMLOut UNFORMATTED
     1212               v-out-string
     1213           .
     1214       end.
     1215   end.
     1216   END PROCEDURE.
     1217   PROCEDURE wp-XMLWriteLog:
     1218     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1219     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1220     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1221   define variable v-str              as character no-undo .
     1222   define variable v-error-append     as logical   no-undo .
     1223   define variable v-error-append-msg as character no-undo .
     1224   assign
     1225     v-str = chr(10)
     1226             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1227             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1228     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1229     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1230     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1231   .
     1232   run bge/bge-log.p (input v-str) no-error .
     1233   if error-status:error then do:
     1234     assign
     1235       v-error-append     = yes
     1236       v-error-append-msg = return-value
     1237     .
     1238   end.
     1239   run gbl/fileapnd.p
     1240     ( input sFileName
     1241     , input v-str
     1242     , input 10
     1243     ) no-error .
     1244   if error-status:error then do:
     1245     assign
     1246       v-error-append     = yes
     1247       v-error-append-msg = substitute( "&1&2&3"
     1248                                       , v-error-append-msg
     1249                                       , chr(10)
     1250                                       , return-value
     1251                                       )
     1252     .
     1253   end.
     1254   if v-error-append
     1255   then do:
     1256     return error substitute( "&1" , v-error-append-msg ) .
     1257   end.
     1258   END PROCEDURE.
     1259   PROCEDURE wp-XMLWriteEDT:
     1260     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1261     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1262     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1263       if valid-handle ( hEDT )
     1264       then do:
     1265           hEDT :move-to-eof().
     1266           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1267                                           OR sToWrite = "&Line") THEN "" ELSE
     1268                                           cur-time-string-sec() + " ").
     1269           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1270                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1271                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1272           hEDT :insert-string(chr(10)).
     1273       end.
     1274       process events.
     1275       output to 'bgescn.txt' append.
     1276           put unformatted
     1277               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1278                                           OR sToWrite = "&Line") THEN "" ELSE
     1279                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1280               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1281                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1282                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1283           .
     1284       output close.
     1285   END PROCEDURE.
     1286   PROCEDURE wp-XMLShowCNT:
     1287     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1288       if valid-handle( hCNT )
     1289       then do:
     1290           ASSIGN hCNT :VISIBLE = TRUE.
     1291       end.
     1292   END PROCEDURE.
     1293   PROCEDURE wp-XMLHideCNT:
     1294     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1295       if valid-handle( hCNT )
     1296       then do:
     1297           ASSIGN hCNT :VISIBLE = FALSE.
     1298       end.
     1299   END PROCEDURE.
     1300   PROCEDURE wp-XMLWriteCNT:
     1301     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1302     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1303       if valid-handle( hCNT )
     1304       then do:
     1305           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1306       end.
     1307   END PROCEDURE.
     1308   procedure bge-xml-write-header:
     1309   do
     1310   on error undo, return error
     1311   :
     1312   define input parameter p-xml-file-name  as character        no-undo.
     1313   define input parameter p-doc-name       as character        no-undo.
     1314   define input parameter p-version        as character        no-undo.
     1315   define input parameter p-db-num         as integer          no-undo.
     1316   define input parameter p-date-from      as date             no-undo.
     1317   define input parameter p-shift-num-from as integer          no-undo.
     1318   define input parameter p-date-to        as date             no-undo.
     1319   define input parameter p-shift-num-to   as integer          no-undo.
     1320   define input parameter p-obj-list       as character        no-undo.
     1321   define input parameter p-doc-type-list  as character        no-undo.
     1322   define input parameter p-pay-code       as logical          no-undo.
     1323   define input parameter p-cst            as logical          no-undo.
     1324   define input parameter p-parts          as logical          no-undo.
     1325   define input parameter p-chk-pay-code   as logical          no-undo.
     1326   define input parameter p-pay-desk       as logical          no-undo.
     1327   define input parameter p-pay-desk-cards as logical          no-undo.
     1328   define input parameter p-deleted        as logical          no-undo.
     1329   define input parameter p-opened-docs    as logical          no-undo.
     1330   define variable v-out-string    as character    no-undo.
     1331   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1332   assign
     1333       v-out-string = substitute( "&1&2&3"
     1334                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1335                           , chr(10)
     1336                           , "<IBS_Trade_House>":U )
     1337   .
     1338   put stream stmXMLOut unformatted
     1339       v-out-string
     1340   .
     1341   run wp-XMLTagOpen(1, "header","").
     1342   if v-bge-xml-bgeflold = "oracle":u
     1343   then do:
     1344     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1345     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1346     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1347     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1348     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1349   end.
     1350   run wp-XMLTagOpen( 2, "manifest", "").
     1351   run wp-XMLTagOpen( 3, "document", "").
     1352   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1353   run wp-XMLTagput( 4, "description", "", 0).
     1354   run wp-XMLTagput( 4, "version", p-version, 0).
     1355   run wp-XMLTagclose( 3, "document" ).
     1356   run wp-XMLTagclose( 2, "manifest" ).
     1357   run wp-XMLTagclose( 1, "header" ).
     1358   run wp-XMLTagOpen(1, "options","").
     1359   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1360   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1361   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1362   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1363   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1364   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1365   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1366   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1367   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1368   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1369   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1370   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1371   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1372   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1373   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1374   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1375   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1376   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1377   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1378   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1379   run wp-XMLTagClose(1, "options").
     1380   run wp-XMLTagOpen( 1, "body", "" ).
     1381   output stream stmXMLOut close.
     1382   end.
     1383   end procedure.
     1384   procedure xml-bge-write-footer:
     1385   do
     1386   on error undo, return error return-value
     1387   :
     1388   define input parameter p-xml-file-name as character    no-undo.
     1389   define variable v-error-num     as integer           no-undo.
     1390   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1391   run wp-XMLTagClose( 1, "body" ).
     1392   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1393   output stream stmXMLOut close.
     1394   if v-bge-xml-bgeflold = "oracle":u
     1395   then do:
     1396     define variable v-tmp-file-name         as character no-undo .
     1397     define variable v-zip-file-name         as character no-undo .
     1398     define variable v-exch-file-name        as character no-undo .
     1399     define variable v-heap-file-name        as character no-undo .
     1400     define variable v-i                     as integer   no-undo .
     1401     define variable v-file-name             as character no-undo .
     1402     define variable v-arc                   as character no-undo .
     1403     define variable v-str                   as character no-undo .
     1404     define variable v-exch-tmp-file-name    as character no-undo .
     1405     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1406     define variable v-bge-xml-exch-dir      as character no-undo .
     1407     define variable v-bge-xml-heap-dir      as character no-undo .
     1408     define variable v-bge-xml-compress-heap as logical   no-undo .
     1409     define variable v-home-dir              as character no-undo .
     1410     define variable v-os-command            as character no-undo .
     1411     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1412     if v-home-dir = ?
     1413     then do:
     1414       undo, return error substitute( "&1&2&3"
     1415                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1416                                     , chr(10)
     1417                                     , "Обратитесь к администратору.":u
     1418                                     ).
     1419     end.
     1420     assign
     1421       v-home-dir = v-home-dir
     1422     .
     1423     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1424     if error-status :error
     1425     then do:
     1426       undo, return error substitute( "&1&2&3"
     1427                                     , "Неверно задан каталог экспорта.":u
     1428                                     , chr(10)
     1429                                     , "Обратитесь к администратору.":u
     1430                                     ).
     1431     end.
     1432     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1433     if v-bge-xml-exch-dir = ?
     1434     then do:
     1435       undo, return error substitute( "&1&2&3"
     1436                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1437                                     , chr(10)
     1438                                     , "Обратитесь к администратору.":u
     1439                                     ).
     1440     end.
     1441     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1442     if error-status :error
     1443     then do:
     1444       undo, return error substitute( "&1&2&3"
     1445                                     , "Неверно задан каталог экспорта (exch).":u
     1446                                     , chr(10)
     1447                                     , "Обратитесь к администратору.":u
     1448                                     ).
     1449     end.
     1450     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1451     if v-bge-xml-heap-dir = ?
     1452     then do:
     1453       undo, return error substitute( "&1&2&3"
     1454                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1455                                     , chr(10)
     1456                                     , "Обратитесь к администратору.":u
     1457                                     ).
     1458     end.
     1459     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1460     if error-status :error
     1461     then do:
     1462       undo, return error substitute( "&1&2&3"
     1463                                     , "Неверно задан каталог экспорта (heap).":u
     1464                                     , chr(10)
     1465                                     , "Обратитесь к администратору.":u
     1466                                     ).
     1467     end.
     1468     get-key-value section "BGE" key "heap-compress" value v-str.
     1469     assign
     1470       v-i = int(v-str)
     1471     no-error .
     1472     if v-i = ? or v-i = 0
     1473     then do:
     1474       assign
     1475         v-bge-xml-compress-heap = no
     1476       .
     1477     end.
     1478     else do:
     1479       assign
     1480         v-bge-xml-compress-heap = yes
     1481       .
     1482     end.
     1483     assign
     1484       v-arc = search( "exe/7za.exe":u )
     1485     .
     1486     if v-arc = ? or v-arc = ""
     1487     then do:
     1488       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1489     end.
     1490     assign
     1491       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1492       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1493       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1494       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1495       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1496       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1497       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1498     .
     1499     run gbl/del-file.p (input v-tmp-file-name) .
     1500     run gbl/del-file.p (input v-zip-file-name) .
     1501     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1502     if v-error-num > 0
     1503     then do:
     1504         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1505                                      , p-xml-file-name + "xm1":u
     1506                                      , v-tmp-file-name
     1507                                      , v-error-num
     1508                                      ).
     1509     end.
     1510     assign
     1511       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1512                                    , v-arc
     1513                                    , v-zip-file-name
     1514                                    , v-tmp-file-name
     1515                                    )
     1516     .
     1517     os-command silent value ( v-os-command ) .
     1518     run gbl/del-file.p (input v-heap-file-name) .
     1519     if v-bge-xml-compress-heap = no
     1520     then do:
     1521       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1522       if v-error-num > 0
     1523       then do:
     1524           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1525                                        , v-tmp-file-name
     1526                                        , v-heap-file-name
     1527                                        , v-error-num
     1528                                        ) .
     1529       end.
     1530     end.
     1531     else do:
     1532       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1533       if v-error-num > 0
     1534       then do:
     1535           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1536                                        , v-zip-file-name
     1537                                        , v-heap-file-name
     1538                                        , v-error-num
     1539                                        ) .
     1540       end.
     1541     end.
     1542     run gbl/del-file.p (input v-tmp-file-name) .
     1543     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1544     if error-status :error then do:
     1545       undo, return error substitute( "&1&2&3"
     1546                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1547                                     , chr(10)
     1548                                     , "Обратитесь к администратору."
     1549                                     ).
     1550     end.
     1551     run gbl/del-file.p (input v-exch-file-name) .
     1552     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1553     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1554     if v-error-num > 0
     1555     then do:
     1556       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1557                                     , v-zip-file-name
     1558                                     , v-exch-tmp-file-name
     1559                                     , v-error-num
     1560                                     ) .
     1561     end.
     1562     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1563     if v-error-num > 0
     1564     then do:
     1565       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1566                                     , v-exch-tmp-file-name
     1567                                     , v-exch-file-name
     1568                                     , v-error-num
     1569                                     ) .
     1570     end.
     1571     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1572   end.
     1573   else do:
     1574     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1575     if v-error-num > 0
     1576     then do:
     1577       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1578                                     , p-xml-file-name + "xm1"
     1579                                     , p-xml-file-name + "xml"
     1580                                     , v-error-num
     1581                                     ) .
     1582     end.
     1583   end.
     1584   if opsys = "unix"
     1585   then do:
     1586       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1587   end.
     1588   end.
     1589   end procedure.
     1590   procedure xml-bge-filename0:
     1591   define input parameter p-prefix   as character no-undo .
     1592   define input parameter p-name     as character no-undo .
     1593   define input parameter p-shared-process as logical no-undo .
     1594   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1595   define output parameter p-xml-file-name  as character no-undo .
     1596   // define output parameter p-fullfnamenoext as character no-undo .
     1597   define output parameter p-locked         as logical      no-undo.
     1598   define variable v-fullfnamenoext as character no-undo .
     1599   define variable v-fileext        as character no-undo .
     1600   define variable v-fullfname      as character no-undo .
     1601   define variable v-error-num      as integer   no-undo .
     1602   do
     1603   on error undo, return error
     1604   :
     1605     case v-bge-xml-bgeflold :
     1606       when "old" then do:
     1607         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1608         v-fileext       = ".xml":U .
     1609         v-fullfname     = v-fullfnamenoext + v-fileext .
     1610         p-xml-file-name = v-fullfname .
     1611         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1612         if v-error-num > 0 then do:
     1613           return error.
     1614         end.
     1615       end.
     1616       when "var" then do:
     1617         case p-prefix :
     1618           when "doc" then do:
     1619             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1620             v-fileext       = ".xml":U .
     1621             v-fullfname     = v-fullfnamenoext + v-fileext .
     1622             p-xml-file-name = v-fullfname .
     1623           end.
     1624           when "day" then do:
     1625             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1626             v-fileext       = ".xml":U .
     1627             v-fullfname     = v-fullfnamenoext + v-fileext .
     1628             p-xml-file-name = v-fullfname .
     1629           end.
     1630           otherwise do:
     1631             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1632             v-fileext       = ".xml":U .
     1633             v-fullfname     = v-fullfnamenoext + v-fileext .
     1634             p-xml-file-name = v-fullfname .
     1635           end.
     1636         end case.
     1637         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1638         if v-error-num > 0 then do:
     1639           return error.
     1640         end.
     1641       end.
     1642       when "new" then do:
     1643                   run bge/genfname.p (
     1644                       input p-home-dir
     1645                       , input p-prefix
     1646                       , input ""
     1647                       , input "xml"
     1648                       , input ""
     1649                       , output p-xml-file-name
     1650                   ).
     1651       end.
     1652       when "no-parameter" then do:
     1653         if p-shared-process then do:
     1654                       run bge/genfname.p (
     1655                           input p-home-dir
     1656                           , input "d"
     1657                           , input ""
     1658                           , input "xml"
     1659                           , input ""
     1660                           , output p-xml-file-name
     1661                       ).
     1662         end.
     1663         else do:
     1664           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1665           v-fileext       = ".xml":U .
     1666           v-fullfname     = v-fullfnamenoext + v-fileext .
     1667           p-xml-file-name = v-fullfname .
     1668           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1669           if v-error-num > 0 then do:
     1670             return error.
     1671           end.
     1672         end.
     1673       end.
     1674     end case.
     1675     assign
     1676       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1677       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1678     .
     1679   end .
     1680   end procedure .
     1681   procedure xml-bge-filename :
     1682   do
     1683   on error undo, return error
     1684   :
     1685   define input parameter p-prefix             as character    no-undo.
     1686   define input parameter p-name               as character    no-undo.
     1687   define input parameter p-shared-process     as logical      no-undo.
     1688   define output parameter p-xml-file-name     as character    no-undo.
     1689   define output parameter p-log-file-name     as character    no-undo.
     1690   define output parameter p-locked            as logical      no-undo.
     1691   define variable v-home-dir          as character no-undo .
     1692   define variable v-error-num         as integer   no-undo .
     1693   define variable v-bge-xml-heap-dir  as character no-undo .
     1694       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1695       if v-home-dir = ?
     1696       then do:
     1697           message
     1698             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1699             skip(1)
     1700             skip "Обратитесь к администратору."
     1701           view-as alert-box error.
     1702           undo, return error .
     1703       end.
     1704       if v-bge-xml-bgeflold <> "oracle"
     1705       then do:
     1706         assign
     1707             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1708         .
     1709       end.
     1710       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1711       if error-status :error
     1712       then do:
     1713           message
     1714             skip "Неверно задан каталог экспорта."
     1715             skip(1)
     1716             skip "Обратитесь к администратору."
     1717           view-as alert-box error.
     1718           undo, return error .
     1719       end.
     1720       if v-bge-xml-bgefmt = "dbf":U
     1721       then do:
     1722           assign
     1723               p-xml-file-name = v-home-dir
     1724               p-locked        = no
     1725           .
     1726       end.
     1727       else do:
     1728           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1729             output p-xml-file-name, output p-locked) .
     1730       end.
     1731       if v-bge-xml-bgeflold = "oracle"
     1732       then do:
     1733         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1734         if v-bge-xml-heap-dir = ?
     1735         then do:
     1736           undo, return error substitute( "&1&2&3"
     1737                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1738                                         , chr(10)
     1739                                         , "Обратитесь к администратору.":u
     1740                                         ).
     1741         end.
     1742         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1743         if error-status :error
     1744         then do:
     1745           undo, return error substitute( "&1&2&3"
     1746                                         , "Неверно задан каталог экспорта (heap).":u
     1747                                         , chr(10)
     1748                                         , "Обратитесь к администратору.":u
     1749                                         ).
     1750         end.
     1751         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1752           assign
     1753             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1754           .
     1755         end.
     1756         else do:
     1757           assign
     1758             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1759           .
     1760         end.
     1761       end.
     1762       else do:
     1763         assign
     1764             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1765         .
     1766       end.
     1767       assign
     1768          v-bge-xml-static-log-file-name = p-log-file-name
     1769       .
     1770   end.
     1771   end procedure.
     1772   procedure bge-xml-read-config :
     1773   do
     1774   on error undo, return error return-value
     1775   :
     1776   define input  parameter p-last-date as date      no-undo .
     1777   define input  parameter p-db-num    as integer   no-undo .
     1778       define variable v-bgeclall      as character     no-undo.
     1779       define variable v-bgedict       as character     no-undo.
     1780       define variable v-bgeshift      as character     no-undo.
     1781       define variable v-par-type      as character     no-undo.
     1782       define variable v-bgeflnm       as character     no-undo.
     1783       define variable v-bgecliiv      as character     no-undo .
     1784       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1785       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1786       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1787       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1788       define variable v-db-num-str    as character     no-undo .
     1789       define variable v-param-type      as character  no-undo .
     1790       define variable v-value-character as character  no-undo .
     1791       define variable v-value-date      as date       no-undo .
     1792       define variable v-value-decimal   as decimal    no-undo .
     1793       define variable v-value-integer   as integer    no-undo .
     1794       define variable v-value-logical   as logical    no-undo .
     1795       define variable v-tth             as handle      no-undo .
     1796       run adm/shattri.p ( input "get":U
     1797                         , input  '':u
     1798                         , input  0
     1799                         , input  'bge-export':U
     1800                         , input  'bgeclall':U
     1801                         , output v-bgecliiv
     1802                         , output v-value-date
     1803                         , output v-value-decimal
     1804                         , output v-value-integer
     1805                         , output v-value-logical
     1806                         , output v-param-type
     1807                         , input-output table-handle v-tth
     1808                         ) no-error .
     1809       if error-status :error
     1810       then do:
     1811         assign
     1812           v-bge-xml-bgecliiv = no
     1813         .
     1814       end.
     1815       else do:
     1816         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1817       end.
     1818       delete object v-tth.
     1819       assign
     1820           v-bge-xml-bgeclall = no
     1821           v-bge-xml-bgedict  = no
     1822       .
     1823       run adm/shattri.p ( input "get":U
     1824                         , input  '':u
     1825                         , input  0
     1826                         , input  'bge-export':U
     1827                         , input  'bgeclall':U
     1828                         , output v-value-character
     1829                         , output v-value-date
     1830                         , output v-value-decimal
     1831                         , output v-value-integer
     1832                         , output v-value-logical
     1833                         , output v-param-type
     1834                         , input-output table-handle v-tth
     1835                         ) no-error .
     1836       if error-status :error
     1837       then do:
     1838         assign
     1839           v-bge-xml-bgeclall = no
     1840         .
     1841       end.
     1842       else do:
     1843         assign
     1844           v-bge-xml-bgeclall = v-value-logical
     1845         .
     1846       end.
     1847       delete object v-tth.
     1848       run adm/shattri.p ( input "get":U
     1849                         , input  '':u
     1850                         , input  0
     1851                         , input  'bge-export':U
     1852                         , input  'bgedict':U
     1853                         , output v-value-character
     1854                         , output v-value-date
     1855                         , output v-value-decimal
     1856                         , output v-value-integer
     1857                         , output v-value-logical
     1858                         , output v-param-type
     1859                         , input-output table-handle v-tth
     1860                         ) no-error .
     1861       if error-status :error
     1862       then do:
     1863         assign
     1864           v-bge-xml-bgedict = no
     1865         .
     1866       end.
     1867       else do:
     1868         assign
     1869           v-bge-xml-bgedict = v-value-logical
     1870         .
     1871       end.
     1872       delete object v-tth.
     1873       run adm/shattri.p ( input "get":U
     1874                         , input  '':u
     1875                         , input  0
     1876                         , input  'bge-export':U
     1877                         , input  'bgefmt':U
     1878                         , output v-value-character
     1879                         , output v-value-date
     1880                         , output v-value-decimal
     1881                         , output v-value-integer
     1882                         , output v-value-logical
     1883                         , output v-param-type
     1884                         , input-output table-handle v-tth
     1885                         ) no-error .
     1886       if error-status :error
     1887       then do:
     1888         assign
     1889           v-bge-xml-bgefmt  = "xml":U
     1890         .
     1891       end.
     1892       else do:
     1893         assign
     1894           v-bge-xml-bgefmt  = v-value-character
     1895         .
     1896       end.
     1897       delete object v-tth.
     1898       run adm/shattri.p ( input "get":U
     1899                         , input  '':u
     1900                         , input  0
     1901                         , input  'bge-export':U
     1902                         , input  'bgeshift':U
     1903                         , output v-value-character
     1904                         , output v-value-date
     1905                         , output v-value-decimal
     1906                         , output v-value-integer
     1907                         , output v-value-logical
     1908                         , output v-param-type
     1909                         , input-output table-handle v-tth
     1910                         ) no-error .
     1911       if error-status :error
     1912       then do:
     1913         assign
     1914             v-bge-xml-shift-mode = no
     1915         .
     1916       end.
     1917       else do:
     1918         assign
     1919             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1920         .
     1921       end.
     1922       delete object v-tth.
     1923       run adm/shattri.p ( input "get":U
     1924                         , input  '':u
     1925                         , input  0
     1926                         , input  'bge-export':U
     1927                         , input  'bgeflold':U
     1928                         , output v-value-character
     1929                         , output v-value-date
     1930                         , output v-value-decimal
     1931                         , output v-value-integer
     1932                         , output v-value-logical
     1933                         , output v-param-type
     1934                         , input-output table-handle v-tth
     1935                         ) no-error .
     1936       if error-status :error
     1937       then do:
     1938         assign
     1939           v-bge-xml-bgeflold = "no-parameter":U
     1940         .
     1941       end.
     1942       else do:
     1943         assign
     1944           v-bge-xml-bgeflold  = v-value-character
     1945         .
     1946       end.
     1947       delete object v-tth.
     1948       assign
     1949         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1950         v-bge-xml-db-num-str  = v-db-num-str
     1951       .
     1952       if p-last-date <> ?
     1953       then do:
     1954           run adm/shattri.p ( input "get":U
     1955                             , input  '':u
     1956                             , input  0
     1957                             , input  'bge-export':U
     1958                             , input  'bgeflnm':U
     1959                             , output v-value-character
     1960                             , output v-value-date
     1961                             , output v-value-decimal
     1962                             , output v-value-integer
     1963                             , output v-value-logical
     1964                             , output v-param-type
     1965                             , input-output table-handle v-tth
     1966                             ) no-error .
     1967           if error-status :error
     1968           then do:
     1969             assign
     1970               v-bgeflnm = '':U
     1971             .
     1972           end.
     1973           else do:
     1974             assign
     1975               v-bgeflnm = v-value-character
     1976             .
     1977           end.
     1978           delete object v-tth.
     1979           if v-bge-xml-bgeflold = "var"
     1980           then do:
     1981               if v-bgeflnm = ?
     1982               or num-entries( v-bgeflnm ) < 2
     1983               then do:
     1984                   assign
     1985                       v-bge-xml-bgeflold = "new"
     1986                   .
     1987               end.
     1988               else do:
     1989                   assign
     1990                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1991                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1992                   .
     1993                   assign
     1994                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1995                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1996                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1997                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1998                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1999                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2000                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2001                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2002                   .
     2003               end.
     2004           end.
     2005       end.
     2006   end.
     2007   end procedure.
     2008   procedure bge-xml-get-ref-filename :
     2009   define input parameter p-in-file-name       as character        no-undo.
     2010   define output parameter p-home-dir          as character        no-undo.
     2011   define output parameter p-out-file-name     as character        no-undo.
     2012   define output parameter p-locked            as logical          no-undo.
     2013       define variable v-counter       as integer      no-undo.
     2014       define variable v-error-level   as integer      no-undo.
     2015   do
     2016   on error undo, return error
     2017   :
     2018       run bge/bge-ini.p (
     2019             input "bge"
     2020           , output p-home-dir
     2021       ).
     2022       if return-value <> "OK"
     2023       then do:
     2024           undo, return error.
     2025       end.
     2026       assign
     2027           p-home-dir = p-home-dir + "\dict":U
     2028       .
     2029       run bge/dir_cd.p (
     2030           input p-home-dir
     2031           , input "CA"
     2032       ).
     2033       if return-value = "ERROR"
     2034       then do:
     2035           undo, return error.
     2036       end.
     2037       assign
     2038           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2039       .
     2040       assign
     2041           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2042       .
     2043       wait-lock:
     2044       do v-counter = 1 TO 3
     2045       :
     2046           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2047           if p-locked = no
     2048           then do:
     2049               leave wait-lock.
     2050           end.
     2051           else do:
     2052               readkey pause 1.
     2053           end.
     2054       END.
     2055       if p-locked = yes
     2056       then do:
     2057           undo, return error.
     2058       end.
     2059       run bge/os_copy.p (
     2060             input "D":U
     2061           , input p-out-file-name + "xml":U
     2062           , input "":U
     2063           , output v-error-level
     2064       ).
     2065       if v-error-level > 0
     2066       then do:
     2067           undo, return error.
     2068       end.
     2069   end.
     2070   end procedure.
     2071   procedure bge-xml-write-ref-header :
     2072   define input parameter p-bge-name as character        no-undo.
     2073   define input parameter p-file-name as character        no-undo.
     2074       define variable v-out-string    as character    no-undo.
     2075   do
     2076   on error undo, return error
     2077   :
     2078       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2079       put stream stmXMLOut unformatted
     2080           "<?xml version='1.0' encoding='windows-1251'?>":U
     2081       .
     2082       assign
     2083           v-out-string = substitute( "&1&2"
     2084                               , chr(10)
     2085                               , "<IBS_Trade_House>":U )
     2086       .
     2087       put stream stmXMLOut unformatted
     2088           v-out-string
     2089       .
     2090       run wp-XMLTagOpen( 1, "header", "" ).
     2091       if v-bge-xml-bgeflold = "oracle":u
     2092       then do:
     2093         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2094         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2095         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2096         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2097         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2098       end.
     2099       else do:
     2100         run wp-XMLTagOpen( 2, "delivery", "" ).
     2101         run wp-XMLTagOpen( 3, "to", "" ).
     2102         run wp-XMLTagClose( 3, "to" ).
     2103         run wp-XMLTagOpen( 3, "from", "" ).
     2104         run wp-XMLTagClose( 3, "from" ).
     2105         run wp-XMLTagClose( 2, "delivery" ).
     2106       end.
     2107       run wp-XMLTagOpen( 2, "manifest", "" ).
     2108       run wp-XMLTagOpen( 3, "document", "" ).
     2109       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2110       run wp-XMLTagPut( 4, "description", "", 0 ).
     2111       run wp-XMLTagClose( 3, "document" ).
     2112       run wp-XMLTagClose( 2, "manifest" ).
     2113       run wp-XMLTagClose( 1, "header" ).
     2114       run wp-XMLTagOpen( 1, "body", "" ).
     2115   end.
     2116   end procedure.
     2117   procedure bge-xml-write-ref-footer :
     2118   define input parameter p-file-name as character        no-undo.
     2119       define variable v-error-level   as integer      no-undo.
     2120   do
     2121   on error undo, return error
     2122   :
     2123       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2124       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2125       output stream stmXMLOut close.
     2126       run bge/os_copy.p (
     2127             input "M":U
     2128           , input p-file-name + "xm1":U
     2129           , input p-file-name + "xml":U
     2130           , output v-error-level
     2131       ).
     2132       if v-error-level > 0
     2133       then do:
     2134           undo, return error.
     2135       end.
     2136   end.
     2137   end procedure.
     2138   procedure bge-xml-out-dir :
     2139   define output parameter p-out-dir       as character    no-undo.
     2140   define output parameter p-log-file-name as character    no-undo.
     2141   do
     2142   on error undo, return error
     2143   :
     2144       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2145       if p-out-dir = ?
     2146       then do:
     2147           message
     2148             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2149                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2150             skip(1)
     2151             skip "Обратитесь к администратору."
     2152           view-as alert-box error.
     2153           undo, return error .
     2154       end.
     2155       if v-bge-xml-bgeflold <> "oracle" then assign
     2156         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2157       .
     2158       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2159       if error-status :error  then do:
     2160           run wp-XMLWriteLog in this-procedure (
     2161                 input p-log-file-name
     2162               , input 0
     2163               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2164                                   , p-out-dir
     2165                                   , return-value
     2166                                   , trim( error-status :get-message( 1 ) )
     2167                                   )
     2168           ).
     2169           undo, return error.
     2170       end.
     2171       assign
     2172           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2173           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2174       .
     2175   end.
     2176   end procedure.
     2177   procedure bge-xml-out-dir2 :
     2178   define output parameter p-out-dir       as character    no-undo.
     2179   define output parameter p-out-dirR      as character    no-undo.
     2180   define output parameter p-log-file-name as character    no-undo.
     2181   do
     2182   on error undo, return error
     2183   :
     2184       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2185       if p-out-dir = ?
     2186       then do:
     2187           message
     2188             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2189                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2190             skip(1)
     2191             skip "Обратитесь к администратору."
     2192           view-as alert-box error.
     2193           undo, return error .
     2194       end.
     2195       if v-bge-xml-bgeflold <> "oracle" then assign
     2196             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2197             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2198         .
     2199       else p-out-dirR = p-out-dir .
     2200       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2201       if error-status :error  then do:
     2202           run wp-XMLWriteLog in this-procedure (
     2203                 input p-log-file-name
     2204               , input 0
     2205               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2206                                   , p-out-dir
     2207                                   , return-value
     2208                                   , error-status :get-message( 1 )
     2209                                   )
     2210           ).
     2211           undo, return error.
     2212       end.
     2213       if p-out-dirR <> p-out-dir then do:
     2214         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2215         if error-status :error then do:
     2216           run wp-XMLWriteLog in this-procedure (
     2217                 input p-log-file-name
     2218               , input 0
     2219               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2220                                   , p-out-dirR
     2221                                   , return-value
     2222                                   , error-status :get-message( 1 )
     2223                                   )
     2224           ).
     2225           p-out-dirR = p-out-dir .
     2226         end.
     2227       end .
     2228       assign
     2229         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2230         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2231       .
     2232   end.
     2233   end procedure.
     2234   procedure bge-xml-out-file :
     2235   do
     2236   on error undo, return error
     2237   :
     2238   define input parameter p-out-dir            as character        no-undo.
     2239   define input parameter p-prefix             as character        no-undo.
     2240   define input parameter p-sheduled           as logical          no-undo.
     2241   define output parameter p-xml-file-name     as character        no-undo.
     2242   define output parameter p-locked            as logical          no-undo.
     2243   define variable v-home-dir      as character     no-undo.
     2244   define variable v-error-num     as integer       no-undo.
     2245   define variable v-today             as date         no-undo.
     2246   define variable v-time              as integer      no-undo.
     2247       if v-bge-xml-bgefmt = "dbf":U
     2248       then do:
     2249           assign
     2250               p-xml-file-name = p-out-dir
     2251               p-locked        = no
     2252           .
     2253       end.
     2254       else do:
     2255           if v-bge-xml-bgeflold = "firm":U
     2256           then do:
     2257               run bge/genfname.p (
     2258                     input p-out-dir
     2259                   , input p-prefix
     2260                   , input "":U
     2261                   , input "arj":U
     2262                   , input "":U
     2263                   , output p-xml-file-name
     2264               ).
     2265           end.
     2266           else do:
     2267               run bge/genfname.p (
     2268                     input p-out-dir
     2269                   , input p-prefix
     2270                   , input "":U
     2271                   , input "xml":U
     2272                   , input "":U
     2273                   , output p-xml-file-name
     2274               ).
     2275           end.
     2276           assign
     2277               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2278               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2279           .
     2280       end.
     2281   end.
     2282   end procedure.
     2283   procedure bge-xml-init-ext-doc-type :
     2284       define variable v-counter    as integer      no-undo.
     2285       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2286   do
     2287   for buf_temp_ext-doc-type
     2288   on error undo, return error
     2289   :
     2290       empty temp-table buf_temp_ext-doc-type.
     2291       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2292       :
     2293           create buf_temp_ext-doc-type.
     2294           assign
     2295               buf_temp_ext-doc-type.edt-key               = v-counter
     2296               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2297               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2298           .
     2299       end.
     2300   end.
     2301   end procedure.
     2302   procedure bge-xml-get-decimal-shift-num :
     2303   define input parameter p-shift-date     as date             no-undo.
     2304   define input parameter p-shift-num      as integer          no-undo.
     2305   define output parameter p-shift-decimal as decimal          no-undo.
     2306   do
     2307   on error undo, return error
     2308   :
     2309       assign
     2310           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2311       .
     2312   end.
     2313   end procedure.
     2314   procedure bge-xml-ora-exp-filename :
     2315     define input  parameter p-table-name  as character no-undo .
     2316     define input  parameter p-doc-code    as character no-undo .
     2317     define input  parameter p-obj-code    as integer   no-undo .
     2318     define output parameter p-filename    as character no-undo .
     2319     define output parameter p-seq-num     as integer   no-undo .
     2320     define variable v-ora-exp-seq     as integer   no-undo .
     2321     define variable v-ora-exp-seq-str as character no-undo .
     2322     define variable v-home-dir        as character no-undo.
     2323   do
     2324   on error undo, return error return-value
     2325   :
     2326     if v-bge-xml-bgeflold = "oracle":u
     2327     then do:
     2328       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2329       if v-home-dir = ?
     2330       then do:
     2331         undo, return error substitute( "&1&2&3":U
     2332                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2333                                       , chr(10)
     2334                                       , "Обратитесь к администратору.":U
     2335                                       ).
     2336       end.
     2337       assign
     2338           v-home-dir = v-home-dir
     2339       .
     2340       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2341       if error-status :error
     2342       then do:
     2343         undo, return error substitute( "&1&2&3":U
     2344                                       , "Неверно задан каталог экспорта.":U
     2345                                       , chr(10)
     2346                                       , "Обратитесь к администратору.":U
     2347                                       ).
     2348       end.
     2349       assign
     2350         v-ora-exp-seq = ?
     2351       .
     2352       if  p-table-name <> ? and
     2353           p-doc-code <> ?
     2354       then do:
     2355         run bge/get-oesq.p ( input p-table-name
     2356                            , input p-doc-code
     2357                            , output v-ora-exp-seq
     2358                            ) no-error .
     2359         if error-status :error = yes
     2360         then do:
     2361           undo, return error return-value .
     2362         end.
     2363       end.
     2364       if v-ora-exp-seq = ?
     2365       then do:
     2366         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2367         if error-status :error
     2368         then do:
     2369           undo, return error return-value .
     2370         end.
     2371       end.
     2372       if p-table-name <> ? and
     2373          p-doc-code   <> ?
     2374       then do:
     2375         run bge/oesqdoc.p ( input p-table-name
     2376                           , input p-doc-code
     2377                           , input v-ora-exp-seq
     2378                           ) no-error .
     2379         if error-status :error = yes
     2380         then do:
     2381           undo, return error return-value .
     2382         end.
     2383       end.
     2384       assign
     2385         p-seq-num  = v-ora-exp-seq
     2386         p-filename = substitute("&1/&2-000_&3."
     2387                                , v-home-dir
     2388                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2389                                , string(v-ora-exp-seq , "999999999")
     2390                                )
     2391       .
     2392     end.
     2393   end.
     2394   end procedure.
     2395   procedure bge-xml-date-to-str :
     2396     define input  parameter p-date  as date      no-undo .
     2397     define output parameter p-str   as character no-undo .
     2398   do
     2399   on error undo, return error return-value
     2400   :
     2401     if p-date <> ?
     2402     then do:
     2403       assign
     2404         p-str = substitute( "&1-&2-&3"
     2405                           , string( year(p-date)  , "9999")
     2406                           , string( month(p-date) , "99"  )
     2407                           , string( day(p-date)   , "99"  )
     2408                           )
     2409       .
     2410     end.
     2411     else do:
     2412       assign
     2413         p-str = ?
     2414       .
     2415     end.
     2416   end.
     2417   end procedure.
     2418   procedure bge-xml-date-str-to-str :
     2419     define input  parameter p-date-str  as character no-undo .
     2420     define output parameter p-str       as character no-undo .
     2421     define variable v-date          as date      no-undo .
     2422     define variable v-date-valid    as logical   no-undo .
     2423     define variable v-error-message as character no-undo .
     2424   do
     2425   on error undo, return error return-value
     2426   :
     2427     assign
     2428       p-str = ?
     2429     .
     2430     if p-date-str = ? or p-date-str = ""
     2431     then do:
     2432       return .
     2433     end.
     2434     run strtdate in this-procedure ( input  p-date-str
     2435                                    , output v-date
     2436                                    , output v-date-valid
     2437                                    , output v-error-message
     2438                                    ).
     2439     if v-date-valid <> true
     2440     then do:
     2441       return .
     2442     end.
     2443     assign
     2444       p-str = substitute( "&1-&2-&3"
     2445                         , string( year(v-date)  , "9999")
     2446                         , string( month(v-date) , "99"  )
     2447                         , string( day(v-date)   , "99"  )
     2448                         )
     2449     .
     2450   end.
     2451   end procedure.
     2452   procedure bge-xml-fill-tt-bgecliiv :
     2453     define input  parameter p-str as character no-undo .
     2454     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2455     define buffer buf_clients             for ub.clients.
     2456     define variable v-i         as integer   no-undo .
     2457     define variable v-count     as integer   no-undo .
     2458     define variable v-cli-count as integer   no-undo .
     2459     define variable v-client    as character no-undo .
     2460     define variable v-obj-type  as character no-undo .
     2461     define variable v-obj-code  as integer   no-undo .
     2462   do
     2463   on error undo, return error return-value
     2464   :
     2465     empty temp-table buf_tt-bge-xml-bgecliiv.
     2466     assign
     2467       v-bge-xml-bgecliiv = no
     2468       v-cli-count        = num-entries(p-str,';')
     2469     .
     2470     if v-cli-count > 0
     2471     then do:
     2472       _cli-cycle:
     2473       do v-i = 1 to v-cli-count
     2474       :
     2475         assign
     2476           v-client = entry(v-i , p-str, ';')
     2477         .
     2478         if num-entries(v-client) <> 2
     2479         then do:
     2480           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2481         end.
     2482         assign
     2483           v-obj-type = entry(1, v-client)
     2484         .
     2485         assign
     2486           v-obj-code = integer(entry(2, v-client))
     2487         no-error .
     2488         if error-status :error
     2489         then do:
     2490           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2491         end.
     2492         find first buf_clients no-lock
     2493           where buf_clients.obj-type = v-obj-type
     2494             and buf_clients.obj-code = v-obj-code
     2495         no-error.
     2496         if not available buf_clients
     2497         then do:
     2498           next _cli-cycle.
     2499         end.
     2500         find first buf_tt-bge-xml-bgecliiv no-lock
     2501           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2502             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2503         no-error .
     2504         if available buf_tt-bge-xml-bgecliiv
     2505         then do:
     2506           next _cli-cycle.
     2507         end.
     2508         create buf_tt-bge-xml-bgecliiv.
     2509         assign
     2510           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2511           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2512         .
     2513       end.
     2514     end.
     2515     else do:
     2516       assign
     2517         v-bge-xml-bgecliiv = no
     2518       .
     2519       return .
     2520     end.
     2521     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2522     if available buf_tt-bge-xml-bgecliiv
     2523     then do:
     2524       assign
     2525         v-bge-xml-bgecliiv = yes
     2526       .
     2527     end.
     2528   end.
     2529   end procedure.
     2530   procedure bge-xml-resolve-ext-doc-type :
     2531     define input  parameter p-ext-doc-type      as character no-undo .
     2532     define input  parameter p-obj-type          as character no-undo .
     2533     define input  parameter p-obj-code          as integer   no-undo .
     2534     define output parameter p-out-ext-doc-type  as character no-undo .
     2535     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2536   do
     2537   on error undo, return error return-value
     2538   :
     2539     assign
     2540       p-out-ext-doc-type = p-ext-doc-type
     2541     .
     2542     if p-ext-doc-type <> 'ie':U
     2543     then do:
     2544       return .
     2545     end.
     2546     if v-bge-xml-bgecliiv = yes
     2547     then do:
     2548       find first buf_tt-bge-xml-bgecliiv no-lock
     2549         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2550           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2551       no-error .
     2552       if available buf_tt-bge-xml-bgecliiv
     2553       then do:
     2554         assign
     2555           p-out-ext-doc-type = 'iv':U
     2556         .
     2557       end.
     2558     end.
     2559   end.
     2560   end procedure.
     2561   procedure safe-wp-xmltagput :
     2562     define input  parameter pTagLevel   as integer   no-undo .
     2563     define input  parameter pTagName    as character no-undo .
     2564     define input  parameter pParValue   as character no-undo .
     2565     define input  parameter pFlagEmpty  as integer   no-undo .
     2566   do
     2567   on error undo, return error return-value
     2568   :
     2569     if v-bge-xml-bgeflold = "oracle":u
     2570     then do:
     2571       return .
     2572     end.
     2573     run wp-xmltagput in this-procedure ( input pTagLevel
     2574                                        , input pTagName
     2575                                        , input pParValue
     2576                                        , input pFlagEmpty
     2577                                        ).
     2578   end.
     2579   end procedure.
     2580   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2581   define variable v-waitfram-action01         as character   no-undo .
     2582   define variable v-waitfram-action02         as character   no-undo .
     2583   define variable v-waitfram-action03         as character   no-undo .
     2584   define variable mWaitFramTextBeg            as character   no-undo.
     2585   define variable mWaitFramTextEnd            as character   no-undo.
     2586   define variable mWaitFramView               as logical     no-undo.
     2587   define variable mWaitProcEvent              as logical     no-undo init yes.
     2588   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2589   define variable mWaitFramStop               as logical     no-undo.
     2590   define variable mWaitFramStopUser           as logical     no-undo.
     2591   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2592   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2593   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2594   define button B-WaitFramStop auto-end-key
     2595        label "Стоп"
     2596        size 10 by 1 tooltip "Остоновить процесс".
     2597   define button B-viewProcInfo
     2598        label "Информация"
     2599        size 15 by 1 tooltip "Информация о процесс".
     2600   define frame waitfram
     2601     v-waitfram-action01 format "x(72)" no-label skip
     2602     v-waitfram-action02 format "x(72)" no-label skip
     2603     v-waitfram-action03 format "x(72)" no-label skip
     2604     B-viewProcInfo
     2605     B-WaitFramStop at row 4 col 30
     2606     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2607     .
     2608   define new global shared variable mBatchMode as logical no-undo init ?.
     2609   define variable mFramBachModHandle as handle no-undo.
     2610   mFramBachModHandle = frame waitfram:handle.
     2611   define variable mFameOldVis as logical no-undo.
     2612   define variable mVisCUrentVin as logical no-undo.
     2613   if session:batch-mode
     2614   then
     2615      mBatchMode = yes.
     2616   if mBatchMode = ? then do:
     2617     mVisCUrentVin = current-window:visible.
     2618     mFameOldVis = mFramBachModHandle:visible.
     2619     mFramBachModHandle:visible  = yes.
     2620     mBatchMode = mFramBachModHandle:visible ne yes.
     2621     mFramBachModHandle:visible = mFameOldVis.
     2622     current-window:visible = mVisCUrentVin.
     2623   end.
     2624    if  log-manager:logfile-name ne ?
     2625     then DO:
     2626         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2627         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2628         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2629     end.
     2630   on choose of B-WaitFramStop in frame waitfram
     2631   do:
     2632     mWaitFramStop = yes.
     2633     mWaitFramStopUser = yes.
     2634   end.
     2635   function waitfram-check-timeout returns logical():
     2636      define variable vtime as int64 no-undo.
     2637      if mWaitFramStopTimeOut
     2638      then
     2639         return yes.
     2640      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2641      if     mWaitFramTimeOut ne ?
     2642         and mWaitFramTimeOut ne 0
     2643         and mWaitFramTimeOut lt vtime
     2644      then do:
     2645         mWaitFramStopTimeOut = yes.
     2646      end.
     2647      return mWaitFramStopTimeOut.
     2648   end.
     2649   procedure waitfram-hide :
     2650     if not session:batch-mode
     2651     then do
     2652     on error undo, return error return-value
     2653     :
     2654       pause 0 before-hide .
     2655       if not mBatchMode then
     2656         hide frame waitfram .
     2657     if     not mWaitFramView
     2658        and mWaitProcEvent
     2659     then
     2660       process events .
     2661     end.
     2662   end procedure.
     2663   procedure waitfram-show :
     2664     define input  parameter p-message as character no-undo .
     2665     define variable v-left-margin as integer   no-undo .
     2666     if not session:batch-mode
     2667     then do
     2668     on error undo, return error return-value
     2669     :
     2670       if length(p-message) <= 70 then do:
     2671         assign
     2672           v-left-margin = integer((70 - length(p-message)) / 2)
     2673         .
     2674         assign
     2675           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2676         .
     2677         assign
     2678           v-waitfram-action01 = " "
     2679           v-waitfram-action02 = " "
     2680                                    + fill(" ", v-left-margin)
     2681                                    + p-message
     2682           v-waitfram-action03 = " "
     2683         .
     2684       end.
     2685       else do:
     2686         define variable vRindex1 as integer no-undo.
     2687         define variable vRindex2 as integer no-undo.
     2688         vRindex1 = r-index(p-message," ",70).
     2689         if vRindex1 = 0
     2690         then
     2691            vRindex1 = 70.
     2692         if length(p-message)  <= vRindex1 + 70 then do:
     2693           assign
     2694             v-waitfram-action01 = " "
     2695             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2696             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2697           .
     2698         end.
     2699         else do:
     2700           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2701           if vRindex2 <= vRindex1
     2702           then
     2703              vRindex2 = vRindex1 + 70.
     2704           assign
     2705             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2706             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2707             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2708           .
     2709         end.
     2710       end.
     2711       B-viewProcInfo:visible   in frame waitfram = no.
     2712       B-viewProcInfo:sensitive in frame waitfram = no.
     2713       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2714       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2715       if  (   mWaitFramView
     2716          or  mWaitProcEvent)
     2717          and not mBatchMode
     2718       then
     2719          display
     2720             v-waitfram-action01 skip
     2721             v-waitfram-action02 skip
     2722             v-waitfram-action03 skip
     2723          with frame waitfram .
     2724       if     mWaitFramView
     2725          then do:
     2726             if     mWaitFramInterval ne ?
     2727                and not mBatchMode
     2728             then
     2729                wait-for go of frame waitfram pause mWaitFramInterval.
     2730          end.
     2731          else
     2732             if     mWaitProcEvent
     2733                and not mBatchMode
     2734             then
     2735                process events .
     2736     end.
     2737   end procedure.
     2738      procedure waitfram-show-this:
     2739         define input  parameter iInterval as int64 no-undo.
     2740         define variable vtime as int64 no-undo.
     2741         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2742         mWaitFramInterval = iInterval.
     2743         run waitfram-show (substitute("&1&2 &3&4" ,
     2744                                       mWaitFramTextBeg ,
     2745                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2746                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2747                                       mWaitFramTextEnd
     2748                                      )
     2749                           ).
     2750      end.
     2751      procedure WaitFramRunPause:
     2752         define input  parameter iInterval as dec no-undo.
     2753         define variable vStart  as datetime-tz no-undo.
     2754         define variable vend    as datetime-tz no-undo.
     2755         define variable vint as int64 no-undo.
     2756         define variable vOk as logical no-undo.
     2757         vStart = now.
     2758         vend   = vStart.
     2759         publish "WaitFramPause" (iInterval,output vOk).
     2760         vend   =  now.
     2761         vint = vend - vStart.
     2762         vint = iInterval - vint / 1000.
     2763         if     not mWaitFramStop
     2764            and (   vint > 0
     2765                 or (    not vOk
     2766                     and iInterval eq ?
     2767                     )
     2768                 )
     2769         then
     2770            run waitfram-show-this (iInterval).
     2771         vend   =  now.
     2772         vint = vend - vStart.
     2773         vint = iInterval - vint / 1000.
     2774         if     not mWaitFramStop
     2775            and vint > 0
     2776         then do:
     2777            run gbl/pause.p (vint * 1000).
     2778         end.
     2779         if iInterval ne ?
     2780         then
     2781            publish "WaitFramStop".
     2782         waitfram-check-timeout().
     2783      end.
     2784      procedure WaitFramWaitFor:
     2785         define input  parameter iInterval as dec no-undo.
     2786         assign
     2787            mWaitFramStartProc   = now
     2788            mWaitFramStopUser    = no
     2789            mWaitFramStopTimeOut = no
     2790         .
     2791         block-wait:
     2792         do while not mWaitFramStop:
     2793            run WaitFramRunPause (iInterval).
     2794            if  waitfram-check-timeout()
     2795            then do:
     2796               leave block-wait.
     2797            end.
     2798         end.
     2799         run waitfram-hide.
     2800      end.
     2801   procedure waitfram-join :
     2802     define input  parameter p-line-1  as character no-undo .
     2803     define input  parameter p-line-2  as character no-undo .
     2804     define input  parameter p-line-3  as character no-undo .
     2805     define output parameter p-message as character no-undo .
     2806     do
     2807     on error undo, return error return-value
     2808     :
     2809       assign
     2810         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2811                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2812                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2813       .
     2814     end.
     2815   end procedure.
     2816   function waitfram-join-function returns character
     2817     (input p-line-1 as character
     2818     ,input p-line-2 as character
     2819     ,input p-line-3 as character
     2820     ).
     2821     define variable v-message as character no-undo .
     2822     run waitfram-join in this-procedure
     2823       (input  p-line-1
     2824       ,input  p-line-2
     2825       ,input  p-line-3
     2826       ,output v-message
     2827       ) .
     2828     return v-message .
     2829   end function .
     2830       define variable v-xml-file-name     as character            no-undo.
     2831       define variable v-log-file-name     as character            no-undo.
     2832       define variable v-xml-f-nam-short   as character no-undo.
