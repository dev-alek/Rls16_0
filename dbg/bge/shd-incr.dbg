     2963             end.
     2964         end.
     2965         assign
     2966             v-log-string = ", по объектам: " + p-obj-list
     2967         .
     2968         run bge-xml-write-header in this-procedure (
     2969               input v-xml-file-name
     2970             , input v-xml-file-name + "xml"
     2971             , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     2972             , input p-db-num
     2973             , input ?
     2974             , input 0
     2975             , input ?
     2976             , input 0
     2977             , input p-obj-list
     2978             , input ""
     2979             , input yes
     2980             , input yes
     2981             , input yes
     2982             , input yes
     2983             , input yes
     2984             , input yes
     2985             , input yes
     2986             , input no
     2987         ).
     2988         object-of-list:
     2989         for each temp-obj
     2990         :
     2991             run bge/lock-bge-incr.p (input temp-obj.obj-type, input temp-obj.obj-code, buffer buf_clients-attr) no-error.
     2992             if error-status:error then do:
     2993               run wp-XMLWriteLog in this-procedure (
     2994                      input v-log-file-name
     2995                     ,input 1
     2996                     ,input "Ошибка экспорта документов по объекту " + temp-obj.obj-type + string( temp-obj.obj-code ) + ". " + error-status:get-message(1)
     2997                 ).
     2998                 next object-of-list.
     2999             end.
     3000             run export-docs-by-object in this-procedure (
     3001                   input temp-obj.host-code
     3002                 , input temp-obj.obj-type
     3003                 , input temp-obj.obj-code
     3004             ) no-error.
     3005             if error-status :error
     3006             then do:
     3007                 run wp-XMLWriteLog in this-procedure (
     3008                       input v-log-file-name
     3009                     , input 1
     3010                     , input "Ошибка экспорта документов по объекту " + temp-obj.obj-type + string( temp-obj.obj-code )
     3011                 ).
     3012                 find current buf_clients-attr no-lock.
     3013                 next object-of-list.
     3014             end.
     3015             run cb-fill_bge-xml_clients in this-procedure (
     3016                   input temp-obj.obj-type
     3017                 , input temp-obj.obj-code
     3018             ).
     3019             find current buf_clients-attr no-lock.
     3020         end.
     3021         if v-bge-xml-bgeflold <> "oracle"
     3022         then do:
     3023           run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     3024         end.
     3025       if v-bge-xml-bgeflold <> "oracle"
     3026       then do:
     3027         v-xml-f-nam-short = replace(v-xml-file-name, "/", "\").
     3028         v-xml-f-nam-short = entry(num-entries(v-xml-f-nam-short, "\"), v-xml-f-nam-short, "\").
     3029         v-xml-f-nam-short = right-trim(v-xml-f-nam-short, ".").
     3030         v-xml-f-nam-short = "_" + v-xml-f-nam-short.
     3031         run bge/cat-firm.p (
