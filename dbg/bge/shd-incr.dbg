     2852   for buf_temp_doc-code
     2853     , buf_temp_del-doc-code
     2854     , buf_temp_pr-doc-num
     2855     , buf_temp_ord-doc-code
     2856   on error undo, return error
     2857   :
     2858       run cur-time in this-procedure ( output v-today , output v-time ).
     2859       run bge-xml-out-dir in this-procedure ( output v-out-dir
     2860                                             , output v-log-file-name
     2861                                             ).
     2862       run bge-xml-read-config in this-procedure ( input v-today
     2863                                                 , input p-db-num
     2864                                                 ) no-error.
     2865       if error-status :error
     2866       then do:
     2867           run wp-XMLWriteLog in this-procedure (
     2868                 input v-log-file-name
     2869               , input 1
     2870               , input substitute( "Ошибка чтения параметров экспорта. &1. &2. Для экспорта данных будут приняты параметры по умолчанию."
     2871                                   , return-value, trim( error-status :get-message( 1 ) ) )
     2872           ).
     2873       end.
     2874         run xml-bge-filename in this-procedure (
     2875               input "doc"
     2876             , input "document"
     2877             , input yes
     2878             , output v-xml-file-name
     2879             , output v-log-file-name
     2880             , output v-locked
     2881         ).
     2882         if v-locked = yes
     2883         then do:
     2884             run wp-XMLWriteLog in this-procedure (
     2885                 input v-log-file-name
     2886                 , input 1
     2887                 , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2888             ).
     2889             undo, return error .
     2890         end.
     2891         run wp-XMLWriteLog in this-procedure (
     2892                 input v-log-file-name
     2893             , input 1
     2894             , input substitute( "Начало выгрузки в файл &1", replace( v-xml-file-name, "/", "\" ) + "xm1" )
     2895         ).
     2896         run wp-XMLWriteLog in this-procedure (
     2897                 input v-log-file-name
     2898             , input 1
     2899             , input substitute( "................с параметрами: Номер базы: &1.", p-db-num )
     2900         ).
     2901         run wp-XMLWriteLog in this-procedure (
     2902             input v-log-file-name
     2903             , input 1
     2904             , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     2905         ).
     2906         run wp-XMLWriteLog in this-procedure (
     2907             input v-log-file-name
     2908             , input 1
     2909             , input substitute( "................с параметрами: ... надо ли выгружать чеки: &1", p-need-checks )
     2910         ).
     2911         run wp-XMLWriteLog in this-procedure (
     2912             input v-log-file-name
     2913             , input 1
     2914             , input substitute( "................с параметрами: ... надо ли выгружать сверки до/после слива: &1", p-doc-rvs )
     2915         ).
     2916         RUN init-temphost.
     2917         assign
     2918             v-log-string = ", по всем фирмам"
     2919         .
     2920         if p-range <> 3
     2921         then do:
     2922             run wp-XMLWriteLog in this-procedure (
     2923                 input v-log-file-name
     2924                 , input 1
     2925                 , input "Неверно заданы объекты для выгрузки."
     2926             ).
     2927             undo, return error .
     2928         end.
     2929         for each temp-obj
     2930         :
     2931             delete temp-obj.
     2932         end.
     2933         do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     2934         :
     2935             create temp-obj.
     2936             assign
     2937                 temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     2938                 temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     2939             no-error .
     2940             if error-status :error
     2941             then do:
     2942                 run wp-XMLWriteLog in this-procedure (
     2943                     input v-log-file-name
     2944                     , input 1
     2945                     , input "Ошибка чтения списка объектов."
     2946                 ).
     2947                 undo, return error .
     2948             end.
     2949   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2951     (input  temp-obj.obj-type
     2952     ,input  temp-obj.obj-code
     2953     ,output temp-obj.host-code
     2954     ) no-error .
     2955             if error-status :error
