       83   define  temp-table temp-host no-undo
       84     field host-code like ub.store.host-code
       85     index xpk host-code
       86   .
       87   define  temp-table temp-obj no-undo
       88     field obj-type  like ub.clients.obj-type
       89     field obj-code  like ub.clients.obj-code
       90     field host-code like ub.store.host-code
       91     field db-num    like ub.clients.db-num
       92     index xpk  obj-type obj-code
       93     index xie1 host-code
       94     index xie2 db-num host-code
       95   .
       96   procedure init-temphost:
       97     define buffer buf_store   for ub.store .
       98     define buffer buf_shop    for ub.shop .
       99     define buffer buf_clients for ub.clients .
      100     define buffer buf_db for ub.db .
      101     define buffer buf_temp-host for temp-host .
      102     define buffer buf_temp-obj for temp-obj .
      103     do
      104     on error undo, return error return-value
      105     :
      106       for each buf_store
      107       on error undo, return error
      108       :
      109         find first buf_temp-host
      110           where buf_temp-host.host-code = buf_store.host-code
      111           no-error .
      112         if not available buf_temp-host
      113         then do:
      114           create buf_temp-host .
      115           assign
      116             buf_temp-host.host-code = buf_store.host-code
      117           .
      118         end.
      119         find first buf_clients no-lock
      120           where buf_clients.obj-type = 'скл':U
      121             and buf_clients.obj-code = buf_store.obj-code
      122           no-error .
      123         if not available buf_clients
      124         then do:
      125           message
      126             "Ошибка при поиске клиента" skip
      127             "Клиент" 'скл':U buf_store.obj-code skip
      128             view-as alert-box error .
      129           undo, return error .
      130         end.
      131         create buf_temp-obj .
      132         assign
      133           buf_temp-obj.obj-type  = 'скл':U
      134           buf_temp-obj.obj-code  = buf_store.obj-code
      135           buf_temp-obj.host-code = buf_store.host-code
      136           buf_temp-obj.db-num    = buf_clients.db-num
      137         .
      138       end.
      139       for each buf_shop
      140       on error undo, return error
      141       :
      142         find first buf_temp-host
      143           where buf_temp-host.host-code = buf_shop.host-code
      144           no-error .
      145         if not available buf_temp-host
      146         then do:
      147           create buf_temp-host .
      148           assign
      149             buf_temp-host.host-code = buf_shop.host-code
      150           .
      151         end.
      152         find first buf_clients no-lock
      153           where buf_clients.obj-type = 'маг':U
      154             and buf_clients.obj-code = buf_shop.obj-code
      155           no-error .
      156         if not available buf_clients then do:
      157           message
      158             "Ошибка при поиске клиента" skip
      159             "Клиент" 'маг':U buf_shop.obj-code skip
      160             view-as alert-box error .
      161           undo, return error .
      162         end.
      163         create buf_temp-obj .
      164         assign
      165           buf_temp-obj.obj-type  = 'маг':U
      166           buf_temp-obj.obj-code  = buf_shop.obj-code
      167           buf_temp-obj.host-code = buf_shop.host-code
      168           buf_temp-obj.db-num    = buf_clients.db-num
      169         .
      170       end.
      171     end.
      172   end.
      173   define variable vss-include-info1 as character format "X(65)" no-undo
      174   initial "@(#)$Workfile$ $Revision$".
      175   DEF STREAM stmXMLOut.
      176   DEF STREAM stmXMLLog.
      177   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   procedure cur-time :
      179      define output parameter p-today as date      no-undo .
      180      define output parameter p-time  as integer   no-undo .
      181     do
      182     on error undo, return error
      183     :
      184       define variable v-date1 as date      no-undo .
      185       define variable v-date2 as date      no-undo .
      186       define variable v-time  as integer   no-undo .
      187       assign
      188         v-date1 = today
      189         v-time  = time
      190         v-date2 = today
      191       .
      192       if v-date1 <> v-date2
      193       then do:
      194         assign
      195           v-date1 = today
      196           v-time  = v-time
      197         .
      198       end.
      199       assign
      200         p-today = v-date1
      201         p-time  = v-time
      202       .
      203     end.
      204   end.
      205   function cur-time-date returns character
      206   :
      207     return string(today, '99/99/9999':U) .
      208   end.
      209   function cur-time-mjd returns decimal
      210   :
      211     define variable v-date as date      no-undo .
      212     define variable v-time as integer   no-undo .
      213     run cur-time in this-procedure
      214       (output v-date
      215       ,output v-time
      216       ) .
      217     return integer(v-date) - 2400002 + (v-time / 86400) .
      218   end.
      219   function cur-time-get-ending-index returns integer
      220   (input p-number as integer
      221   )
      222   :
      223     if p-number < 0
      224     or p-number = ?
      225     then do:
      226       return 1 .
      227     end.
      228     define variable v-rest as integer   no-undo .
      229     assign
      230       p-number = p-number modulo 100
      231     .
      232     if p-number < 20
      233     then do:
      234       assign
      235         v-rest = p-number
      236       .
      237     end.
      238     else do:
      239       assign
      240         v-rest = p-number modulo 10
      241       .
      242     end.
      243     case v-rest :
      244       when 1
      245       then do:
      246         return 2 .
      247       end.
      248       when 2 or
      249       when 3 or
      250       when 4
      251       then do:
      252         return 3 .
      253       end.
      254       otherwise do:
      255         return 1 .
      256       end.
      257     end case .
      258   end.
      259   procedure cur-time-mjd-to-date :
      260      define input  parameter i-mjd-diff as decimal no-undo.
      261      define output parameter o-Date     as date    no-undo.
      262      define output parameter o-Time     as integer no-undo.
      263      define variable v-day-number as integer   no-undo .
      264      if    i-mjd-diff < 0
      265         or i-mjd-diff = ?
      266      then do:
      267         return "?" .
      268      end.
      269      assign
      270         v-day-number = truncate(i-mjd-diff,0).
      271         o-Date = date(v-day-number + 2400002).
      272         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      273     .
      274   end.
      275   function cur-time-mjd-to-string returns character
      276   (input p-mjd-diff as decimal
      277   )
      278   :
      279     define variable v-day-number as integer   no-undo .
      280     define variable v-seconds    as integer   no-undo .
      281     define variable v-hour       as integer   no-undo .
      282     define variable v-min        as integer   no-undo .
      283     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      284     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      285     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      286     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      287     if p-mjd-diff < 0
      288     or p-mjd-diff = ?
      289     then do:
      290       return "?" .
      291     end.
      292     assign
      293       v-day-number = integer(truncate(p-mjd-diff,0))
      294       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      295     .
      296     if v-seconds > 86400
      297     then do:
      298       assign
      299         v-seconds = 86400 - 1
      300       .
      301     end.
      302     if v-seconds < 0
      303     then do:
      304       assign
      305         v-seconds = 0
      306       .
      307     end.
      308     assign
      309       v-hour = truncate(v-seconds / 3600, 0)
      310     .
      311     assign
      312       v-seconds = v-seconds modulo 3600
      313     .
      314     assign
      315       v-min = truncate(v-seconds / 60, 0)
      316     .
      317     assign
      318       v-seconds = v-seconds modulo 60
      319     .
      320     return
      321         (if v-day-number <> 0
      322           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      323           else ""
      324         )
      325       + (if v-day-number <> 0 or v-hour <> 0
      326           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      327           else ""
      328         )
      329       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      330           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      331           else ""
      332         )
      333       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      334       .
      335   end.
      336   function cur-time-string returns character
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      345   end.
      346   function cur-time-string-sec returns character
      347   :
      348     define variable v-date as date      no-undo .
      349     define variable v-time as integer   no-undo .
      350     run cur-time in this-procedure
      351       (output v-date
      352       ,output v-time
      353       ) .
      354     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      355   end.
      356   function cur-time-custom  returns character
      357   (input p-prefix as character
      358   ,input p-date-format as character
      359   ,input p-delimiter as character
      360   ,input p-time-format as character
      361   ,input p-suffix as character
      362   )
      363   :
      364     define variable v-date as date      no-undo .
      365     define variable v-time as integer   no-undo .
      366     run cur-time in this-procedure
      367       (output v-date
      368       ,output v-time
      369       ) .
      370     return
      371       p-prefix
      372       + string(v-date, p-date-format)
      373       + p-delimiter
      374       + string(v-time, p-time-format)
      375       + p-suffix
      376       .
      377   end.
      378   function cur-time-print  returns character
      379   :
      380     define variable v-date as date      no-undo .
      381     define variable v-time as integer   no-undo .
      382     run cur-time in this-procedure
      383       (output v-date
      384       ,output v-time
      385       ) .
      386     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      387   end.
      388   function cur-time-datetime returns datetime
      389   :
      390     define variable v-char as character no-undo .
      391     define variable v-datetime as datetime no-undo .
      392     v-char = cur-time-string().
      393     v-datetime = datetime(v-char).
      394     return  v-datetime.
      395   end.
      396   function cur-time-string-msec returns character
      397   :
      398     define variable v-date as datetime  no-undo .
      399     v-date = now.
      400     return string(v-date) .
      401   end.
      402   define variable vss-include-info3 as character format "X(65)" no-undo
      403   initial "@(#)$Workfile$ $Revision$".
      404   procedure xmlchar-test :
      405   define input parameter p-in-string          as character        no-undo.
      406   define output parameter p-out-string-enc    as character        no-undo.
      407   define output parameter p-out-string-dec    as character        no-undo.
      408   do
      409   on error undo, return error
      410   :
      411          run xmlchar-encode in this-procedure
      412       (
      413             input p-in-string
      414           , output p-out-string-enc
      415       ).
      416          run xmlchar-decode in this-procedure
      417       (
      418             input p-out-string-enc
      419           , output p-out-string-dec
      420       ).
      421   end.
      422   end .
      423   procedure xmlchar-encode :
      424   define input parameter p-in-string      as character        no-undo.
      425   define output parameter p-out-string    as character        no-undo.
      426       define variable v-position      as integer      no-undo.
      427       define variable v-current-char  as character    no-undo.
      428   do
      429   on error undo, return error
      430   :
      431       assign
      432           p-out-string = "":U
      433       .
      434       case p-in-string
      435       :
      436           when ?
      437           then do:
      438               assign
      439                   p-out-string = "?":U
      440               .
      441           end.
      442           when "?":U
      443           then do:
      444               assign
      445                   p-out-string = "&#63;":U
      446               .
      447           end.
      448           otherwise do:
      449               do v-position = 1 to length( p-in-string )
      450               :
      451                   assign
      452                       v-current-char = substring( p-in-string, v-position, 1 )
      453                   .
      454                   case v-current-char
      455                   :
      456                       when "&":U
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "&amp;":U
      460                           .
      461                       end.
      462                       when ">":U
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "&gt;":U
      466                           .
      467                       end.
      468                       when "<":U
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "&lt;":U
      472                           .
      473                       end.
      474                       when "'":U
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "&apos;":U
      478                           .
      479                       end.
      480                       when '"':U
      481                       then do:
      482                           assign
      483                               p-out-string = p-out-string + "&quot;":U
      484                           .
      485                       end.
      486                       when chr(1)
      487                       then do:
      488                           assign
      489                               p-out-string = p-out-string + "":U
      490                           .
      491                       end.
      492                       when chr(2)
      493                       then do:
      494                           assign
      495                               p-out-string = p-out-string + "":U
      496                           .
      497                       end.
      498                       when chr(3)
      499                       then do:
      500                           assign
      501                               p-out-string = p-out-string + "":U
      502                           .
      503                       end.
      504                       when chr(4)
      505                       then do:
      506                           assign
      507                               p-out-string = p-out-string + "":U
      508                           .
      509                       end.
      510                       when chr(5)
      511                       then do:
      512                           assign
      513                               p-out-string = p-out-string + "":U
      514                           .
      515                       end.
      516                       when chr(6)
      517                       then do:
      518                           assign
      519                               p-out-string = p-out-string + "":U
      520                           .
      521                       end.
      522                       when chr(7)
      523                       then do:
      524                           assign
      525                               p-out-string = p-out-string + "":U
      526                           .
      527                       end.
      528                       when chr(8)
      529                       then do:
      530                           assign
      531                               p-out-string = p-out-string + "":U
      532                           .
      533                       end.
      534                       when chr(9)
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + "":U
      538                           .
      539                       end.
      540                       when chr(29)
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + "":U
      544                           .
      545                       end.
      546                       when chr(10)
      547                       then do:
      548                           assign
      549                               p-out-string = p-out-string + "&#10;":U
      550                           .
      551                       end.
      552                       when chr(13)
      553                       then do:
      554                           assign
      555                               p-out-string = p-out-string + "&#13;":U
      556                           .
      557                       end.
      558                       otherwise do:
      559                           assign
      560                               p-out-string = p-out-string + v-current-char
      561                           .
      562                       end.
      563                   end case.
      564               end.
      565           end.
      566       end case.
      567   end.
      568   end .
      569   procedure xmlchar-encode-1c :
      570   define input parameter p-in-string      as character        no-undo.
      571   define output parameter p-out-string    as character        no-undo.
      572       define variable v-position      as integer      no-undo.
      573       define variable v-current-char  as character    no-undo.
      574   do
      575   on error undo, return error
      576   :
      577       assign
      578           p-out-string = "":U
      579       .
      580       case p-in-string
      581       :
      582           when ?
      583           then do:
      584               assign
      585                   p-out-string = "?":U
      586               .
      587           end.
      588           otherwise do:
      589               do v-position = 1 to length( p-in-string )
      590               :
      591                   assign
      592                       v-current-char = substring( p-in-string, v-position, 1 )
      593                   .
      594                   case v-current-char
      595                   :
      596                       when chr(1)
      597                       then do:
      598                           assign
      599                               p-out-string = p-out-string + " ":U
      600                           .
      601                       end.
      602                       when chr(2)
      603                       then do:
      604                           assign
      605                               p-out-string = p-out-string + " ":U
      606                           .
      607                       end.
      608                       when chr(3)
      609                       then do:
      610                           assign
      611                               p-out-string = p-out-string + " ":U
      612                           .
      613                       end.
      614                       when chr(4)
      615                       then do:
      616                           assign
      617                               p-out-string = p-out-string + " ":U
      618                           .
      619                       end.
      620                       when chr(5)
      621                       then do:
      622                           assign
      623                               p-out-string = p-out-string + " ":U
      624                           .
      625                       end.
      626                       when chr(6)
      627                       then do:
      628                           assign
      629                               p-out-string = p-out-string + " ":U
      630                           .
      631                       end.
      632                       when chr(7)
      633                       then do:
      634                           assign
      635                               p-out-string = p-out-string + " ":U
      636                           .
      637                       end.
      638                       when chr(8)
      639                       then do:
      640                           assign
      641                               p-out-string = p-out-string + " ":U
