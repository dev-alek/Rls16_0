      979   define variable v-bge-xml-bgeflold      as character         no-undo.
      980   define variable v-bge-xml-bgefmt        as character         no-undo.
      981   define variable v-bge-xml-shift-mode    as logical           no-undo.
      982   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      983   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      984   define variable v-bge-xml-log-file-name as character    no-undo.
      985   define variable v-bge-xml-dbf-file-name as character    no-undo.
      986   define variable v-bge-xml-db-num-str    as character    no-undo .
      987   define variable v-bge-xml-static-log-file-name as character    no-undo.
