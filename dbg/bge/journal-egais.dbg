        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Журнал запросов ЕГАИС".
        9   define variable th-journal-egais     as handle  no-undo.
       10   define variable bh-journal-egais     as handle  no-undo.
       11   define variable gh-journal-egais     as handle  no-undo.
       12   define variable browse-hdl-journal-egais as handle no-undo.
       13   define variable bcol                  as handle no-undo.
       14   define variable bcol1                 as handle no-undo.
       15   define variable bcol2                 as handle no-undo.
       16   define variable bcol3                 as handle no-undo.
       17   define variable bcol4                 as handle no-undo.
       18   define variable bcol5                 as handle no-undo.
       19   define variable egais                as class EGAIS   no-undo.
       20   define variable journal              as class Journal no-undo.
       21   define variable v-db-num             as integer   no-undo .
       22   define variable v-user-id            as character no-undo .
       23   define variable glog                 as logical   no-undo .
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89     define variable v-cntxt-db-num        as integer   no-undo .
       90     define variable v-cntxt-userid        as character no-undo .
       91     define variable v-cntxt-level         as character no-undo .
       92     define variable v-cntxt-host-code-obj as integer   no-undo .
       93     define variable v-cntxt-obj-type      as character no-undo .
       94     define variable v-cntxt-obj-code      as integer   no-undo .
       95     define variable v-cntxt-db-num-obj    as integer   no-undo .
       96     define variable v-cntxt-is-admin      as logical   no-undo .
       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98     run mainmenu_getcntxt in parparentproc
       99       (output v-cntxt-db-num
      100       ,output v-cntxt-userid
      101       ,output v-cntxt-level
      102       ,output v-cntxt-host-code-obj
      103       ,output v-cntxt-obj-type
      104       ,output v-cntxt-obj-code
      105       ,output v-cntxt-db-num-obj
      106       ,output v-cntxt-is-admin
      107       ) .
      108   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      109        LABEL "Выход"
      110        SIZE 15 BY 1.13
      111        BGCOLOR 8 .
      112   DEFINE BUTTON Btn_del
      113        LABEL "Удалить"
      114        tooltip "Удалить из журнала. Дает возможность отправить повторно запрос."
      115        SIZE 15 BY 1.13.
      116   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      117        VIEW-AS RADIO-SET HORIZONTAL
      118        RADIO-BUTTONS
      119             "Все", 1,
      120   "Новые", 2,
      121   "Закрытые", 3
      122        SIZE 50 BY 1.25 NO-UNDO.
      123   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      125   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      126   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      127   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      128   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      129   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      130   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      131   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      132   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      133   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      134   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      135   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      136   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      137   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      138   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      139   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      140   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      141   DEFINE BROWSE BROWSE-Journal-egais
      142       WITH NO-ROW-MARKERS SEPARATORS SIZE 135 BY 25.
      143   DEFINE FRAME Dialog-Frame
      144        Btn_Cancel AT ROW 1 COL 1
      145        Btn_del AT ROW 1 COL 16.63 WIDGET-ID 6
      146        RADIO-SET-1 AT ROW 1.04 COL 32.88 NO-LABEL WIDGET-ID 2
      147        BROWSE-Journal-egais AT ROW 3 COL 1 WIDGET-ID 200
      148        SPACE(0.50) SKIP(0.24)
      149       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      150            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      151            TITLE "Журнал запросов ЕГАИС"
      152            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      153   ASSIGN
      154          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      155          FRAME Dialog-Frame:HIDDEN           = TRUE.
      156   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
      157   DO:
      158     assign RADIO-SET-1 .
      159      RUN enable_UI.
      160   END.
      161   ON choose OF Btn_del IN FRAME Dialog-Frame
      162   DO:
      163     find first ub.esys-all-attr where (table-name + string (key1) + string (key2) + string (key3) + string (key4) + string (key5) + string (key6) +
      164           string (key7) + string (key8) + attr-code) = bh-journal-egais:buffer-field ('piIndex'):buffer-value () no-error.
      165     if available (ub.esys-all-attr)
      166       then delete ub.esys-all-attr.
      167     if bh-journal-egais:available
      168       then bh-journal-egais:buffer-delete ().
      169     BROWSE-Journal-egais:refresh ().
      170   END.
      171   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      172   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      173   MAIN-BLOCK:
      174   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      175      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      176          def var ii as int no-undo.
      177   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      179     (output v-db-num
      180     ,output v-user-id
      181     ) no-error .
      182   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   do:
      184     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      185       (input  v-cntxt-db-num
      186       ,input  v-cntxt-userid
      187       ,input  0
      188       ,input  'actn_egais-adm':U
      189       ,input  'object':U
      190       ,input  v-cntxt-host-code-obj
      191       ,input  v-cntxt-obj-type
      192       ,input  v-cntxt-obj-code
      193       ,input  0
      194       ,input  0
      195       ,input  0
      196       ,input  true
      197       ,output glog
      198       )  .
      199   end.
      200     if not glog then  return .
      201     egais = new EGAIS(v-db-num, v-user-id).
      202     journal = new Journal().
      203     egais:EGAISImpl = journal.
      204     bh-journal-egais = egais:GetHndlTable().
      205       create query gh-journal-egais.
      206       gh-journal-egais:SET-BUFFERS (bh-journal-egais ).
      207       gh-journal-egais:query-prepare ("for each tt_journal-egais").
      208       gh-journal-egais:QUERY-OPEN.
      209       BROWSE-Journal-egais:QUERY = gh-journal-egais.
      210     do ii = 1 to bh-journal-egais:num-fields - 1:
      211        bcol = browse-journal-egais:add-like-column('tt_journal-egais' + '.' + bh-journal-egais:buffer-field (ii):name, 0, 'FILL-IN').
      212     end.
      213             bcol1 = browse-journal-egais:get-browse-column(1).
      214             bcol2 = browse-journal-egais:get-browse-column(2).
      215             bcol3 = browse-journal-egais:get-browse-column(3).
      216             bcol4 = browse-journal-egais:get-browse-column(4).
      217             bcol5 = browse-journal-egais:get-browse-column(5).
      218   on row-display of browse-journal-egais IN FRAME Dialog-Frame
      219   DO:
      220       if bh-journal-egais:buffer-field ("jou-status"):buffer-value  = "Запрос отправлен" then do:
      221           bcol1:bgcolor = YELLOW_COLOR.
      222           bcol2:bgcolor = YELLOW_COLOR.
      223           bcol3:bgcolor = YELLOW_COLOR.
      224           bcol4:bgcolor = YELLOW_COLOR.
      225           bcol:bgcolor  = YELLOW_COLOR .
      226           bcol5:bgcolor = YELLOW_COLOR .
      227       end.
      228   end.
      229     RUN enable_UI.
      230     WAIT-FOR GO OF FRAME Dialog-Frame.
      231   END.
      232   RUN disable_UI.
      233   PROCEDURE disable_UI :
      234     HIDE FRAME Dialog-Frame.
      235   END PROCEDURE.
      236   PROCEDURE enable_UI :
      237     DISPLAY RADIO-SET-1
      238         WITH FRAME Dialog-Frame.
      239     ENABLE Btn_Cancel Btn_del RADIO-SET-1
      240         WITH FRAME Dialog-Frame.
      241     VIEW FRAME Dialog-Frame.
      242     ENABLE BROWSE-journal-egais
      243         WITH FRAME Dialog-Frame.
      244     VIEW FRAME Dialog-Frame.
      245      case RADIO-SET-1 :
      246         when 1  then do:
      247               gh-journal-egais:SET-BUFFERS (bh-journal-egais).
      248               gh-journal-egais:query-prepare ("for each tt_journal-egais by tt_journal-egais.jou-time desc").
      249               gh-journal-egais:QUERY-OPEN.
      250         end.
      251         when 2  then do:
      252               gh-journal-egais:SET-BUFFERS (bh-journal-egais).
      253               gh-journal-egais:query-prepare ("for each tt_journal-egais where tt_journal-egais.jou-status = 'Запрос отправлен'  by tt_journal-egais.jou-time desc").
      254               gh-journal-egais:QUERY-OPEN.
      255         end.
      256         when 3 then do:
      257               gh-journal-egais:SET-BUFFERS (bh-journal-egais).
      258               gh-journal-egais:query-prepare ("for each tt_journal-egais where tt_journal-egais.jou-status = 'Ответ получен'  by tt_journal-egais.jou-time desc").
      259               gh-journal-egais:QUERY-OPEN.
      260         end.
      261       end.
      262   END PROCEDURE.
