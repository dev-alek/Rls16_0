        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 461ee4ccdf1b, 1897, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Fri Jun 07 16:26:46 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: egais-marks-find.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/egais-marks-find.p $":U .
        7   define variable vss-description as character no-undo init "Библиотека для работы с марками".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   procedure gen-key-rec :
       14     define input  parameter p-tbl-name    as character no-undo.
       15     define input  parameter p-bh_tbl-name as handle    no-undo.
       16     define output parameter p-key-rec     as character no-undo.
       17     do
       18     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       19     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       20     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       21     :
       22       define variable fh               as handle    no-undo .
       23       define variable v-ok             as logical   no-undo .
       24       define variable v-inform         as character no-undo .
       25       define variable v-ind            as integer   no-undo .
       26       define variable v-idx-field-qnty as integer   no-undo .
       27       if p-tbl-name = ?
       28         or p-tbl-name = "":U
       29       then do:
       30         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       31       end.
       32       if not p-bh_tbl-name:available then do:
       33         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       34       end.
       35       assign
       36         p-key-rec = p-tbl-name
       37         v-inform  = p-bh_tbl-name:index-information(1)
       38         v-ind     = 2
       39       .
       40       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       41       on error undo, return error
       42       :
       43         assign
       44           v-inform = p-bh_tbl-name:index-information( v-ind )
       45           v-ind    = v-ind + 1
       46         .
       47       end.
       48       if v-inform = ?
       49         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
       50         or entry( 3, v-inform, ",":U ) <> "1":U
       51       then do:
       52         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
       53       end.
       54       else do:
       55         assign
       56           v-idx-field-qnty = num-entries( v-inform ) - 4
       57         .
       58         if v-idx-field-qnty < 2 then do:
       59           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
       60         end.
       61         do v-ind = 1 to v-idx-field-qnty by 2
       62         on error undo, return error
       63         :
       64           assign
       65             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
       66             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
       67           .
       68         end.
       69       end.
       70       if p-key-rec = ? then do:
       71         assign
       72           p-key-rec = "":U
       73         .
       74         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
       75       end.
       76     end.
       77     return.
       78   end procedure.
       79   procedure gen-where-keyr-tab :
       80     define input  parameter i-tableSerach as character no-undo.
       81     define input  parameter i-tablekey   as character  no-undo.
       82     define input  parameter p-key-rec    as character  no-undo.
       83     define input  parameter p-key-handle as handle     no-undo .
       84     define input  parameter p-db-name    as character  no-undo .
       85     define input  parameter p-tt-handle  as handle     no-undo .
       86     define output parameter o-Where      as character  no-undo.
       87     do
       88     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       89     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
       90     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
       91     :
       92       define variable v-full-tbl-name  as character no-undo .
       93       define variable bh_tbl-name      as handle    no-undo .
       94       define variable fh_key           as handle    no-undo .
       95       define variable fh_search        as handle    no-undo .
       96       define variable v-field-num      as integer   no-undo .
       97       define variable v-count-fld      as integer   no-undo .
       98       define variable v-inform         as character no-undo .
       99       define variable v-ind            as integer   no-undo .
      100       define variable v-idx-field-qnty as integer   no-undo .
      101       define variable v-field-name     as character no-undo .
      102       define variable v-field-val      as character no-undo .
      103       define variable v-word-link      as character no-undo .
      104       define variable vTable           as character no-undo.
      105       define variable bh_tbl-key       as handle    no-undo .
      106       assign
      107         p-key-rec = trim( p-key-rec )
      108       .
      109       if p-key-handle <> ? then do:
      110         if not valid-handle(p-key-handle)
      111            or p-key-handle:type <> "buffer"
      112         then do:
      113           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      114         end.
      115         if num-entries( p-key-rec, chr(3) ) > 1
      116           or p-key-rec = ?
      117           or p-key-rec = "":U
      118         then do:
      119           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      120         end.
      121       end.
      122       else do:
      123         if p-key-rec = ?
      124           or p-key-rec = "":U
      125         then do:
      126           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      127         end.
      128       end.
      129       assign
      130         vTable = entry( 1 , p-key-rec, chr(3) )
      131       .
      132       if p-tt-handle <> ?
      133         and ( not valid-handle(p-tt-handle)
      134               or p-tt-handle:type <> "buffer"
      135             )
      136       then do:
      137         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      138       end.
      139       if p-tt-handle = ? then do:
      140         assign
      141           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      142         .
      143         create buffer bh_tbl-name for table v-full-tbl-name .
      144       end.
      145       else do:
      146         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      147       end.
      148       assign
      149         v-inform = bh_tbl-name:index-information(1)
      150         v-ind    = 2
      151       .
      152       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      153       on error undo, return error
      154       :
      155         assign
      156           v-inform = bh_tbl-name:index-information( v-ind )
      157           v-ind    = v-ind + 1
      158         .
      159       end.
      160       if v-inform = ?
      161         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      162         or entry( 3, v-inform, ",":U ) <> "1":U
      163       then do:
      164         delete object bh_tbl-name no-error.
      165         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      166       end.
      167       assign
      168         v-idx-field-qnty = num-entries( v-inform ) - 4
      169       .
      170       if v-idx-field-qnty < 2 then do:
      171         delete object bh_tbl-name no-error.
      172         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      173       end.
      174       assign
      175         o-where     = "where":U
      176         v-word-link = "":U
      177         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      178         v-count-fld = 0
      179       .
      180       if i-tablekey ne "" and i-tablekey ne ?
      181       then do:
      182         assign
      183           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      184         .
      185         create buffer bh_tbl-key for table v-full-tbl-name .
      186       end.
      187       if i-tableSerach ne "" and i-tableSerach ne ?
      188       then do:
      189         delete object bh_tbl-name no-error.
      190         assign
      191           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      192         .
      193         create buffer bh_tbl-name for table v-full-tbl-name .
      194       end.
      195       block_where:
      196       do v-ind = 1 to v-idx-field-qnty by 2
      197       on error undo, return error
      198       :
      199         assign
      200           v-count-fld = v-count-fld + 1
      201         .
      202         if p-key-handle = ?
      203           and v-count-fld > v-field-num
      204         then do:
      205           leave block_where.
      206         end.
      207         define variable VfieldKeyTable as handle no-undo.
      208         assign
      209           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      210           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      211         .
      212         if     bh_tbl-key ne ?
      213         then do:
      214            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      215            if VfieldKeyTable eq ?
      216            then next block_where.
      217         end.
      218         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      219         then
      220            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      221         else
      222            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      223         if p-key-handle = ? then do:
      224           assign
      225             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      226           .
      227         end.
      228         else do:
      229           assign
      230             fh_key = p-key-handle:buffer-field( v-field-name )
      231           .
      232           if fh_key = ?
      233             or not valid-handle( fh_key )
      234           then do:
      235             delete object bh_tbl-name.
      236             if     bh_tbl-key ne ?
      237             then
      238                delete object bh_tbl-key.
      239             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      240           end.
      241           assign
      242             v-field-val = fh_key:buffer-value
      243           .
      244         end.
      245         if fh_search:data-type ="character":U then do:
      246           assign
      247             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      248             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      249             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      250             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      251             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      252             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      253             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      254             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      255             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      256             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      257             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      258             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      259             v-field-val = substitute( '"&1"', v-field-val )
      260           .
      261         end.
      262         assign
      263           o-where = substitute( "&1 &2", o-where, v-field-val )
      264         .
      265         if v-word-link = "":U then do:
      266           assign
      267             v-word-link = "and":U
      268           .
      269         end.
      270       end.
      271       delete object bh_tbl-name.
      272       if     bh_tbl-key ne ?
      273       then
      274          delete object bh_tbl-key.
      275       if p-key-handle = ?
      276         and v-count-fld <> v-field-num
      277       then do:
      278         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      279       end.
      280     end.
      281   end procedure.
      282   procedure gen-hn-keyr-tab :
      283     define input  parameter i-tableSerach as character no-undo.
      284     define input  parameter i-tablekey   as character no-undo.
      285     define input  parameter p-key-rec    as character no-undo.
      286     define input  parameter p-key-handle as handle    no-undo .
      287     define input  parameter p-db-name    as character no-undo .
      288     define input  parameter p-tt-handle  as handle    no-undo .
      289     define input  parameter p-stts-lock  as integer   no-undo .
      290     define output parameter o-hn         as handle    no-undo.
      291     define variable v-full-tbl-name as character no-undo.
      292     define variable v-where         as character no-undo.
      293     define variable bh_tbl-name     as handle    no-undo.
      294     define variable vTable          as character no-undo.
      295     do
      296     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      297     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      298     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      299         run gen-where-keyr-tab(i-tableSerach,
      300                                i-tablekey,
      301                                p-key-rec,
      302                                p-key-handle,
      303                                p-db-name,
      304                                p-tt-handle,
      305                                output v-where).
      306         if i-tableSerach ne "" and i-tableSerach ne ?
      307         then do:
      308            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      309            create buffer bh_tbl-name for table v-full-tbl-name .
      310         end.
      311         else do:
      312            if p-tt-handle = ? then do:
      313               assign
      314                  vTable = entry( 1 , p-key-rec, chr(3) )
      315               .
      316               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      317               create buffer bh_tbl-name for table v-full-tbl-name .
      318            end.
      319            else do:
      320               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      321            end.
      322         end.
      323         if p-tt-handle = ? then do:
      324            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      325         end.
      326         else do:
      327            bh_tbl-name:find-first( v-where ) no-error .
      328         end.
      329         o-hn = bh_tbl-name.
      330      end.
      331   end procedure.
      332   procedure gen-hn-keyr :
      333     define input  parameter p-key-rec    as character no-undo.
      334     define input  parameter p-key-handle as handle    no-undo .
      335     define input  parameter p-db-name    as character no-undo .
      336     define input  parameter p-tt-handle  as handle    no-undo .
      337     define input  parameter p-stts-lock  as integer   no-undo .
      338     define output parameter o-hn         as handle    no-undo.
      339     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      340   end.
      341   procedure gen-row-keyr :
      342     define input  parameter p-key-rec    as character no-undo.
      343     define input  parameter p-key-handle as handle    no-undo .
      344     define input  parameter p-db-name    as character no-undo .
      345     define input  parameter p-tt-handle  as handle    no-undo .
      346     define input  parameter p-stts-lock  as integer   no-undo .
      347     define output parameter p-tbl-row    as rowid     no-undo.
      348     define output parameter p-tbl-name   as character no-undo.
      349     define variable vHn as handle no-undo.
      350       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      351       p-tbl-row = if vHn:available then vHn:rowid else ?.
      352       p-tbl-name =  vHn:table.
      353       delete object vHn no-error.
      354     if p-tbl-row = ? then do:
      355       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      356     end.
      357     else do:
      358       return.
      359     end.
      360   end procedure.
      361   procedure gen-key-fv :
      362     define input  parameter p-key-rec    as character no-undo .
      363     define output parameter p-field-list as character no-undo .
      364     define output parameter p-value-list as character no-undo.
      365     do
      366     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      367     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      368     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      369     :
      370       define variable v-full-tbl-name  as character no-undo .
      371       define variable bh_tbl-name      as handle    no-undo .
      372       define variable v-tbl-name       as character no-undo .
      373       define variable v-field-num      as integer   no-undo .
      374       define variable v-count-fld      as integer   no-undo .
      375       define variable v-inform         as character no-undo .
      376       define variable v-ind            as integer   no-undo .
      377       define variable v-idx-field-qnty as integer   no-undo .
      378       define variable v-delim-key      as character no-undo .
      379       if p-key-rec = ?
      380         or p-key-rec = "":U
      381       then do:
      382         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      383       end.
      384       assign
      385         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      386         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      387       .
      388       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      389       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      390       assign
      391         v-inform = bh_tbl-name:index-information(1)
      392         v-ind    = 2
      393       .
      394       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      395       on error undo, return error
      396       :
      397         assign
      398           v-inform = bh_tbl-name:index-information( v-ind )
      399           v-ind    = v-ind + 1
      400         .
      401       end.
      402       if v-inform = ?
      403         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      404         or entry( 3, v-inform, ",":U ) <> "1":U
      405       then do:
      406         delete object bh_tbl-name no-error.
      407         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      408       end.
      409       assign
      410         v-idx-field-qnty = num-entries( v-inform ) - 4
      411       .
      412       if v-idx-field-qnty < 2 then do:
      413         delete object bh_tbl-name no-error.
      414         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      415       end.
      416       assign
      417         p-field-list = "":U
      418         p-value-list = "":U
      419         v-delim-key  = "":U
      420         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      421         v-count-fld  = 0
      422       .
      423       block_where:
      424       do v-ind = 1 to v-idx-field-qnty by 2
      425       on error undo, return error
      426       :
      427         assign
      428           v-count-fld = v-count-fld + 1
      429         .
      430         if v-count-fld > v-field-num then do:
      431           leave block_where.
      432         end.
      433         assign
      434           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      435           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      436         .
      437         if v-ind = 1 then do:
      438           assign
      439             v-delim-key = chr(3)
      440           .
      441         end.
      442       end.
      443       delete object bh_tbl-name.
      444       if v-count-fld <> v-field-num then do:
      445         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      446       end.
      447     end.
      448   end procedure.
      449   procedure gen-key-field :
      450     define input  parameter p-table      as character no-undo .
      451     define output parameter p-field-list as character no-undo .
      452     do
      453     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      454     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      455     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      456     :
      457       define variable v-full-tbl-name  as character no-undo .
      458       define variable bh_tbl-name      as handle    no-undo .
      459       define variable v-tbl-name       as character no-undo .
      460       define variable v-field-num      as integer   no-undo .
      461       define variable v-count-fld      as integer   no-undo .
      462       define variable v-inform         as character no-undo .
      463       define variable v-ind            as integer   no-undo .
      464       define variable v-idx-field-qnty as integer   no-undo .
      465       define variable v-delim-key      as character no-undo .
      466       if p-table = ?
      467         or p-table = "":U
      468       then do:
      469         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      470       end.
      471       assign
      472         v-tbl-name      = p-table
      473         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      474       .
      475       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      476       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      477       assign
      478         v-inform = bh_tbl-name:index-information(1)
      479         v-ind    = 2
      480       .
      481       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      482       on error undo, return error
      483       :
      484         assign
      485           v-inform = bh_tbl-name:index-information( v-ind )
      486           v-ind    = v-ind + 1
      487         .
      488       end.
      489       if v-inform = ?
      490         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      491         or entry( 3, v-inform, ",":U ) <> "1":U
      492       then do:
      493         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      494       end.
      495       assign
      496         v-idx-field-qnty = num-entries( v-inform ) - 4
      497       .
      498       if v-idx-field-qnty < 2 then do:
      499         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      500       end.
      501       assign
      502         p-field-list = "":U
      503         v-delim-key  = "":U
      504         v-count-fld  = 0
      505       .
      506       block_where:
      507       do v-ind = 1 to v-idx-field-qnty by 2
      508       on error undo, return error
      509       :
      510         assign
      511           v-count-fld = v-count-fld + 1
      512         .
      513         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      514         if v-ind = 1 then do:
      515           assign
      516             v-delim-key = chr(3)
      517           .
      518         end.
      519       end.
      520       delete object bh_tbl-name.
      521     end.
      522   end procedure.
      523   define output parameter this-proc-hndl as handle no-undo.
      524   do:
      525     this-proc-hndl = this-procedure.
      526   end.
      527   procedure find-mark :
      528       define input parameter p-mark as character no-undo .
      529       define output parameter p-parts-key-rec as character no-undo .
      530       define output parameter p-rezerv as integer no-undo .
      531       define buffer buf_gen-attr for ub.gen-attr.
      532       find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
      533                                         and buf_gen-attr.attr-code  = p-mark no-error.
      534       if not available buf_gen-attr
      535       then do :
      536           p-parts-key-rec = ? .
      537           p-rezerv = ? .
      538       end.
      539       else do :
      540           p-parts-key-rec = buf_gen-attr.p-key .
      541           p-rezerv        = buf_gen-attr.whole-send-news .
      542       end.
      543   end procedure.
      544   procedure find-marks-part :
      545       define input  parameter p-parts-key-rec as character no-undo .
      546       define output parameter p-mark as character no-undo .
      547       define output parameter p-rezerv as integer no-undo .
      548       define buffer buf_gen-attr for ub.gen-attr.
      549       for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
      550                                         and buf_gen-attr.p-key  = p-parts-key-rec :
      551           p-mark = p-mark + "," + buf_gen-attr.attr-code .
      552           p-rezerv        = buf_gen-attr.whole-send-news .
      553       end.
      554       p-mark = TRIM (p-mark, ",") .
      555   end procedure.
      556   procedure create-mark :
      557       define input parameter p-mark as character no-undo .
      558       define parameter buffer buf_parts for ub.parts .
      559       define output parameter p-ok as logical no-undo .
      560       define output parameter p-mes as character no-undo .
      561       define variable v-parts-uniq-key-rec as character no-undo .
      562       define buffer cr_gen-attr for ub.gen-attr.
      563       run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
      564                                           ,input (buffer buf_parts:handle)
      565                                           ,output v-parts-uniq-key-rec).
      566       find first cr_gen-attr no-lock where cr_gen-attr.table-name = 'excise-mark':U
      567                                        and cr_gen-attr.p-key begins "parts"
      568                                        and num-entries (cr_gen-attr.p-key, chr(3)) >= 8
      569                                        and entry(8, cr_gen-attr.p-key, chr(3)) <> 'free-zone':U
      570                                        and cr_gen-attr.attr-code = p-mark no-error .
      571       if available cr_gen-attr
      572       then do :
      573           p-ok = false .
      574           p-mes = substitute ("Уже есть запись с маркой &1&2&3", p-mark, chr(10), cr_gen-attr.p-key)  .
      575           return .
      576       end.
      577       else do :
      578           find first cr_gen-attr no-lock where cr_gen-attr.table-name = 'excise-mark':U
      579                                            and cr_gen-attr.p-key begins "parts"
      580                                            and num-entries (cr_gen-attr.p-key, chr(3)) >= 8
      581                                            and entry(8, cr_gen-attr.p-key, chr(3)) = 'free-zone':U
      582                                            and cr_gen-attr.attr-code = p-mark no-error .
      583           if available cr_gen-attr
      584           then do :
      585               p-ok = false .
      586               p-mes = substitute ("Уже есть запись с маркой &1&2&3", p-mark, chr(10), cr_gen-attr.p-key).
      587               return .
      588           end.
      589           else do :
      590               create cr_gen-attr .
      591               assign
      592                   cr_gen-attr.table-name = 'excise-mark':U
      593                   cr_gen-attr.p-key = v-parts-uniq-key-rec
      594                   cr_gen-attr.attr-code = p-mark
      595                   cr_gen-attr.whole-send-news = 0
      596               no-error.
      597               if error-status:error
      598               then do :
      599                   p-ok = false .
      600                   p-mes = "Ошибка! " + chr(10) + error-status:get-message (1)  .
      601                   return .
      602               end.
      603               else do :
      604                   p-ok = true .
      605               end.
      606           end.
      607       end.
      608   end procedure.
