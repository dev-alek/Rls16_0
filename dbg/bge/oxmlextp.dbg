        1   define input parameter p-mainmenu-handle    as widget-handle    no-undo.
        2   define input parameter p-mode               as integer          no-undo.
        3   define input parameter p-impexp-type        as character        no-undo.
        4   define input parameter p-esys-id            as integer          no-undo.
        5   define input parameter p-db-num             as integer          no-undo.
        6   define input parameter p-id                 as integer          no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "OpenXML. Просмотр и редактирование типа данных внешней подсистемы".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE BUTTON b-exit AUTO-GO
      117        LABEL "&Ввод"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON b-help
      121        LABEL "Помо&щь"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON b-quit AUTO-END-KEY
      125        LABEL "&Отмена"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE VARIABLE ed-des AS CHARACTER
      129        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      130        SIZE 62 BY 4.25 NO-UNDO.
      131   DEFINE VARIABLE fi-esys-name AS CHARACTER FORMAT "X(256)":U
      132        LABEL "Внешняя подсистема"
      133        VIEW-AS FILL-IN
      134        SIZE 40 BY 1 NO-UNDO.
      135   DEFINE VARIABLE fi-status AS INTEGER FORMAT "->>9" INITIAL 0
      136        LABEL "Статус"
      137        VIEW-AS FILL-IN
      138        SIZE 6 BY 1.
      139   DEFINE VARIABLE fi-type-name AS CHARACTER FORMAT "X(256)":U
      140        LABEL "Тип данных"
      141        VIEW-AS FILL-IN
      142        SIZE 40 BY 1 NO-UNDO.
      143   DEFINE VARIABLE tg-confirmation AS LOGICAL INITIAL no
      144        LABEL "Подтверждение"
      145        VIEW-AS TOGGLE-BOX
      146        SIZE 23 BY .83 NO-UNDO.
      147   DEFINE FRAME Dialog-Frame
      148        b-exit AT ROW 1 COL 1
      149        b-quit AT ROW 1 COL 11
      150        b-help AT ROW 1 COL 55
      151        fi-esys-name AT ROW 2.25 COL 22 COLON-ALIGNED
      152        fi-type-name AT ROW 3.5 COL 22 COLON-ALIGNED
      153        tg-confirmation AT ROW 5 COL 23.5
      154        fi-status AT ROW 6 COL 21.5 COLON-ALIGNED
      155        ed-des AT ROW 7.5 COL 2 NO-LABEL
      156        SPACE(1.13) SKIP(0.53)
      157       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      158            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      159            TITLE "Тип данных для внешней системы"
      160            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      161   ASSIGN
      162          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      163          FRAME Dialog-Frame:HIDDEN           = TRUE.
      164   ASSIGN
      165          fi-esys-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      166   ASSIGN
      167          fi-type-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      168   ON GO OF FRAME Dialog-Frame
      169   DO:
      170       run check-data in this-procedure.
      171       assign
      172           tg-confirmation
      173           fi-status
      174           ed-des
      175       .
      176       run assign-data in this-procedure.
      177   END.
      178   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      179   DO:
      180     APPLY "END-ERROR":U TO SELF.
      181   END.
      182   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      183   DO:
      184   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   if lookup(self :type
      186            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      187            ) = 0
      188   then do:
      189     message
      190       "$Workfile$"
      191       "Указанному интерфейсному элементу фокус не может быть передан" skip
      192       "Интерфейсный элемент" self :name  skip
      193       "Тип" self :type  skip
      194       "Процедура" this-procedure :file-name skip
      195       view-as alert-box .
      196   end.
      197   else do:
      198     apply "entry":u to self  .
      199     if focus :handle <> self :handle  then do:
      200       return no-apply .
      201     end.
      202   end.
      203   END.
      204   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      205   DO:
      206   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      207   if lookup(self :type
      208            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      209            ) = 0
      210   then do:
      211     message
      212       "$Workfile$"
      213       "Указанному интерфейсному элементу фокус не может быть передан" skip
      214       "Интерфейсный элемент" self :name  skip
      215       "Тип" self :type  skip
      216       "Процедура" this-procedure :file-name skip
      217       view-as alert-box .
      218   end.
      219   else do:
      220     apply "entry":u to self  .
      221     if focus :handle <> self :handle  then do:
      222       return no-apply .
      223     end.
      224   end.
      225   END.
      226   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   on F2 of frame Dialog-Frame anywhere do:
      228     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
      229     return no-apply.
      230   end.
      231   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      232   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      233   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      234   on help of frame Dialog-Frame
      235   do:
      236     run gbl/app_help.p
      237       (input this-procedure :file-name
      238       ,input ''
      239       ,input ?
      240       ) no-error.
      241     if error-status :error then do:
      242       message
      243         "Ошибка при вызове помощи"
      244         error-status :get-message(1)
      245         view-as alert-box .
      246     end.
      247   end.
      248   run minbtn-set in this-procedure .
      249   on choose of b-help in frame Dialog-Frame
      250   do:
      251     apply "help":u to frame Dialog-Frame .
      252   end.
      253   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   procedure minbtn-set :
      255       do
      256           on error undo, return error return-value
      257           :
      258           define variable ii              as integer       no-undo .
      259           define variable fh              as widget-handle no-undo .
      260           define variable hh              as widget-handle no-undo .
      261           define variable v-h             as handle        extent 4 no-undo .
      262           define variable v-name-button   as character     no-undo .
      263           define variable v-help-old-x    as decimal       no-undo .
      264           define variable v-help-old-y    as decimal       no-undo .
      265           define variable v-help-old-size as decimal       no-undo .
      266           define variable v-frame-width   as decimal       no-undo .
      267           define variable jj              as integer       no-undo .
      268           do
      269               on error undo, return error
      270               :
      271               assign
      272                   v-frame-width = frame Dialog-Frame:width - 0.3
      273                   fh            = frame Dialog-Frame:first-child
      274                   hh            = fh:first-child
      275                   ii            = 1
      276                   .
      277               do while valid-handle(hh):
      278                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      279                   do:
      280                       case lc(hh:name) :
      281                           when "b-help" then
      282                               do:
      283                                   hh:load-image-up("cmp/b-help.bmp":u) .
      284                                   hh:load-image-down("cmp/b-help.bmp":u) .
      285                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      286                                   hh:TOOLTIP = "Помощь" .
      287                                   v-help-old-x = hh:column .
      288                                   v-help-old-y = hh:row    .
      289                                   v-help-old-size = hh:width .
      290                                   hh:width-chars = 2.5 .
      291                               end.
      292                           when "b-print" then
      293                               do:
      294                                   hh:load-image("cmp/b-print.bmp":u) .
      295                                   hh:TOOLTIP = "Печать" .
      296                                   v-h[ii] = hh:handle .
      297                                   ii = ii + 1 .
      298                                   hh:width-chars = 3 .
      299                               end.
      300                           when "b-history" or
      301                           when "b-hist" then
      302                               do:
      303                                   hh:load-image("cmp/b-hist.bmp":u) .
      304                                   hh:TOOLTIP = "История" .
      305                                   v-h[ii] = hh:handle .
      306                                   ii = ii + 1 .
      307                                   hh:width-chars = 3 .
      308                               end.
      309                           when "b-sch" then
      310                               do:
      311                                   hh:load-image("cmp/b-sch.bmp":u) .
      312                                   hh:TOOLTIP = "Установка Фильтра" .
      313                                   v-h[ii] = hh:handle .
      314                                   ii = ii + 1 .
      315                                   hh:width-chars = 3 .
      316                               end.
      317                           when "b-hist-user" then
      318                               do:
      319                                   hh:load-image("cmp/b-hist.bmp":u) .
      320                                   hh:TOOLTIP = "История пользователя" .
      321                                   ii = ii + 1 .
      322                               end.
      323                       end case.
      324                   end.
      325                   hh = hh:next-sibling.
      326               end.
      327               b-help:column = v-frame-width - b-help:width-chars.
      328               jj = 0.
      329               repeat ii = 4 to 1 by -1 :
      330                   if valid-handle (v-h[ii] ) then
      331                   do:
      332                       jj  = jj + 1 .
      333                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      334                       v-h[ii]:row    = v-help-old-y .
      335                   end.
      336               end.
      337           end.
      338       end.
      339   end procedure.
      340   MAIN-BLOCK:
      341   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      342      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      343       run init-fields in this-procedure.
      344       RUN enable_UI.
      345       run ui-disable-all in this-procedure.
      346       run ui-enable in this-procedure.
      347       WAIT-FOR GO OF FRAME Dialog-Frame.
      348   END.
      349   RUN disable_UI.
      350   PROCEDURE assign-data :
      351       define buffer buf_esys-datatype-exp     for ub.esys-datatype-exp.
      352       define buffer buf_esys-datatype-imp     for ub.esys-datatype-imp.
      353   do
      354   for buf_esys-datatype-exp
      355     , buf_esys-datatype-imp
      356   on error undo, return error
      357   :
      358       case p-impexp-type
      359       :
      360           when 'импорт':U
      361           then do:
      362               find first buf_esys-datatype-imp exclusive-lock
      363                    where buf_esys-datatype-imp.esys-id = p-esys-id
      364                      and buf_esys-datatype-imp.db-num  = p-db-num
      365                      and buf_esys-datatype-imp.tdi-id  = p-id
      366               no-error.
      367               if not available buf_esys-datatype-imp
      368               then do:
      369                   message
      370                            vss-workfile vss-revision vss-description
      371                       skip(1)
      372                       skip "Не найден тип данных внешней системы для редактирования."
      373                   view-as alert-box error.
      374                   undo, return error .
      375               end.
      376               assign
      377                   buf_esys-datatype-imp.edi-confirmation = tg-confirmation
      378                   buf_esys-datatype-imp.edi-status       = fi-status
      379                   buf_esys-datatype-imp.edi-des          = ed-des
      380               .
      381           end.
      382           when 'экспорт':U
      383           then do:
      384               find first buf_esys-datatype-exp exclusive-lock
      385                    where buf_esys-datatype-exp.esys-id = p-esys-id
      386                      and buf_esys-datatype-exp.db-num  = p-db-num
      387                      and buf_esys-datatype-exp.dte-id  = p-id
      388               no-error.
      389               if not available buf_esys-datatype-exp
      390               then do:
      391                   message
      392                            vss-workfile vss-revision vss-description
      393                       skip(1)
      394                       skip "Не найден тип данных внешней системы для редактирования."
      395                   view-as alert-box error.
      396                   undo, return error .
      397               end.
      398               assign
      399                   buf_esys-datatype-exp.ede-confirmation  = tg-confirmation
      400                   buf_esys-datatype-exp.ede-status        = fi-status
      401                   buf_esys-datatype-exp.ede-des           = ed-des
      402               .
      403           end.
      404       end case.
      405   end.
      406   END PROCEDURE.
      407   PROCEDURE check-data :
      408   do
      409   on error undo, return error
      410   :
      411   end.
      412   END PROCEDURE.
      413   PROCEDURE disable_UI :
      414     HIDE FRAME Dialog-Frame.
      415   END PROCEDURE.
      416   PROCEDURE enable_UI :
      417     DISPLAY fi-esys-name fi-type-name tg-confirmation fi-status ed-des
      418         WITH FRAME Dialog-Frame.
      419     ENABLE b-exit b-quit b-help fi-esys-name fi-type-name tg-confirmation
      420            fi-status ed-des
      421         WITH FRAME Dialog-Frame.
      422     VIEW FRAME Dialog-Frame.
      423   END PROCEDURE.
      424   PROCEDURE init-fields :
      425       define buffer buf_esys-datatype-exp     for ub.esys-datatype-exp.
      426       define buffer buf_esys-datatype-imp     for ub.esys-datatype-imp.
      427       define buffer buf_ext-system            for ub.ext-system.
      428       define buffer buf_datatype-exp          for ub.datatype-exp.
      429       define buffer buf_datatype-imp          for ub.datatype-imp.
      430   do
      431   for buf_esys-datatype-exp
      432     , buf_esys-datatype-imp
      433     , buf_ext-system
      434     , buf_datatype-exp
      435     , buf_datatype-imp
      436   with frame Dialog-Frame
      437   on error undo, return error
      438   :
      439       find first buf_ext-system no-lock
      440            where buf_ext-system.esys-id = p-esys-id
      441              and buf_ext-system.db-num  = p-db-num
      442       .
      443       case p-impexp-type
      444       :
      445           when 'импорт':U
      446           then do:
      447               assign
      448                   frame Dialog-Frame :title = frame Dialog-Frame :title + " (импорт)"
      449               .
      450               find first buf_esys-datatype-imp exclusive-lock
      451                    where buf_esys-datatype-imp.esys-id = p-esys-id
      452                      and buf_esys-datatype-imp.db-num  = p-db-num
      453                      and buf_esys-datatype-imp.tdi-id  = p-id
      454               no-error.
      455               if not available buf_esys-datatype-imp
      456               then do:
      457                   message
      458                            vss-workfile vss-revision vss-description
      459                       skip(1)
      460                       skip "Не найден тип данных внешней системы для редактирования."
      461                   view-as alert-box error.
      462                   undo, return error .
      463               end.
      464               find first buf_datatype-imp no-lock
      465                    where buf_datatype-imp.dti-id = p-id
      466               .
      467               assign
      468                   fi-esys-name    = buf_ext-system.esys-name
      469                   fi-type-name    = buf_datatype-imp.dti-name
      470                   tg-confirmation = buf_esys-datatype-imp.edi-confirmation
      471                   fi-status       = buf_esys-datatype-imp.edi-status
      472                   ed-des          = buf_esys-datatype-imp.edi-des
      473               .
      474           end.
      475           when 'экспорт':U
      476           then do:
      477               assign
      478                   frame Dialog-Frame :title = frame Dialog-Frame :title + " (экспорт)"
      479               .
      480               find first buf_esys-datatype-exp exclusive-lock
      481                    where buf_esys-datatype-exp.esys-id = p-esys-id
      482                      and buf_esys-datatype-exp.db-num  = p-db-num
      483                      and buf_esys-datatype-exp.dte-id  = p-id
      484               no-error.
      485               if not available buf_esys-datatype-exp
      486               then do:
      487                   message
      488                            vss-workfile vss-revision vss-description
      489                       skip(1)
      490                       skip "Не найден тип данных внешней системы для редактирования."
      491                   view-as alert-box error.
      492                   undo, return error .
      493               end.
      494               find first buf_datatype-exp no-lock
      495                    where buf_datatype-exp.dte-id = p-id
      496               .
      497               assign
      498                   fi-esys-name    = buf_ext-system.esys-name
      499                   fi-type-name    = buf_datatype-exp.dte-name
      500                   tg-confirmation = buf_esys-datatype-exp.ede-confirmation
      501                   fi-status       = buf_esys-datatype-exp.ede-status
      502                   ed-des          = buf_esys-datatype-exp.ede-des
      503               .
      504           end.
      505           otherwise do:
      506               message
      507                        vss-workfile vss-revision vss-description
      508                   skip(1)
      509                   skip "Неверно задан тип (может быть только импорт или экспорт)."
      510                   skip return-value
      511                   skip trim(error-status :get-message(1))
      512                        trim(error-status :get-message(2))
      513                        trim(error-status :get-message(3))
      514               view-as alert-box error.
      515               undo, return error .
      516           end.
      517       end case.
      518   end.
      519   END PROCEDURE.
      520   PROCEDURE ui-disable-all :
      521   do
      522   with frame Dialog-Frame
      523   on error undo, return error
      524   :
      525       disable
      526           all
      527           except
      528               b-exit
      529               b-quit
      530               b-help
      531       .
      532   end.
      533   END PROCEDURE.
      534   PROCEDURE ui-enable :
      535   do
      536   with frame Dialog-Frame
      537   on error undo, return error
      538   :
      539       if p-mode = 1
      540       then do:
      541           enable
      542               tg-confirmation
      543               fi-status
      544               ed-des
      545           .
      546       end.
      547       if p-mode = 0
      548       then do:
      549           hide
      550               b-quit
      551           .
      552           assign
      553               b-exit :label = "В&ыход"
      554           .
      555       end.
      556   end.
      557   END PROCEDURE.
