     1067   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1068                                             INPUT iFlagEmpty AS INTEGER).
     1069       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1070       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1071           DO:
     1072               IF iFlagEmpty = 0                           THEN RETURN "".
     1073               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1074               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1075               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1076               ELSE RETURN "".
     1077           END.
     1078       ELSE DO:
     1079           run xmlchar-encode in this-procedure (
     1080                 input sToPlace
     1081               , output sToPlace
     1082           ).
     1083           ASSIGN
     1084               sToPlace = sParName + '="' + sToPlace + '"'
     1085           .
     1086           RETURN sToPlace.
     1087       END.
     1088   END FUNCTION.
     1089   function bge-xml-date returns character
     1090   ( input p-date as date )
     1091   :
     1092     define variable v-date-str as character no-undo .
     1093     run bge-xml-date-to-str in this-procedure ( input   p-date
     1094                                               , output  v-date-str
     1095                                               ) .
     1096     return v-date-str.
     1097   end function.
     1098   function bge-xml-str-date returns character
     1099   ( input p-date-str as character )
     1100   :
     1101     define variable v-date-str as character no-undo .
     1102     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1103                                                   , output  v-date-str
     1104                                                   ) .
     1105     return v-date-str.
     1106   end function.
     1107   function bge-xml-normalize-dec returns decimal
     1108   ( input p-val as decimal )
     1109   :
     1110     return (if p-val = ? then 0 else p-val) .
     1111   end function.
     1112   PROCEDURE wp-XMLTagOpen:
     1113   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1114   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1115   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1116       define variable v-out-string    as character    no-undo.
     1117   do
     1118   on error undo, return error
     1119   :
     1120       if v-bge-xml-bgefmt = "dbf":U
     1121       then do:
     1122       end.
     1123       else do:
     1124           assign
     1125               v-out-string = substitute( "&1&2<&3&4>"
     1126                                       , chr(10)
     1127                                       , fill( " ":U, 4 * iTagLevel)
     1128                                       , sTagName
     1129                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1130                               )
     1131           .
     1132           put stream stmXMLOut unformatted
     1133               v-out-string
     1134           .
     1135       end.
     1136   end.
     1137   END PROCEDURE.
     1138   PROCEDURE wp-XMLTagPut:
     1139     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1140     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1141     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1142     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1143       define variable v-out-string    as character    no-undo.
     1144   do
     1145   on error undo, return error
     1146   :
     1147       if v-bge-xml-bgefmt = "dbf":U
     1148       then do:
     1149           if v-bge-xml-dbf-file-name <> "":U
     1150           then do:
     1151               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1152               export stream stmXMLOut
     1153                   sTagName
     1154                   sParValue
     1155               .
     1156               output stream stmXMLOut close.
     1157           end.
     1158       end.
     1159       else do:
     1160           IF  iFlagEmpty = 1
     1161           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1162           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1163           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1164           THEN DO:
     1165               run xmlchar-encode in this-procedure (
     1166                   input sParValue
     1167                   , output sParValue
     1168               ).
     1169               assign
     1170                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1171                                               , chr(10)
     1172                                               , FILL(" ", 4 * iTagLevel)
     1173                                               , sTagName
     1174                                               , sParValue
     1175                               )
     1176               .
     1177               PUT STREAM stmXMLOut UNFORMATTED
     1178                   v-out-string
     1179               .
     1180           END.
     1181       end.
     1182   end.
     1183   END PROCEDURE.
     1184   PROCEDURE wp-XMLTagClose:
     1185   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1186   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1187       define variable v-out-string    as character    no-undo.
     1188   do
     1189   on error undo, return error
     1190   :
     1191       if v-bge-xml-bgefmt = "dbf":U
     1192       then do:
     1193       end.
     1194       else do:
     1195           assign
     1196               v-out-string = substitute( "&1&2</&3>"
     1197                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1198                                   , fill( " ", 4 * iTagLevel )
     1199                                   , sTagName
     1200                           )
     1201           .
     1202           PUT STREAM stmXMLOut UNFORMATTED
     1203               v-out-string
     1204           .
     1205       end.
     1206   end.
     1207   END PROCEDURE.
     1208   PROCEDURE wp-XMLWriteLog:
     1209     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1210     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1211     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1212   define variable v-str              as character no-undo .
     1213   define variable v-error-append     as logical   no-undo .
     1214   define variable v-error-append-msg as character no-undo .
     1215   assign
     1216     v-str = chr(10)
     1217             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1218             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1219     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1220     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1221     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1222   .
     1223   run bge/bge-log.p (input v-str) no-error .
     1224   if error-status:error then do:
     1225     assign
     1226       v-error-append     = yes
     1227       v-error-append-msg = return-value
     1228     .
     1229   end.
     1230   run gbl/fileapnd.p
     1231     ( input sFileName
     1232     , input v-str
     1233     , input 10
     1234     ) no-error .
     1235   if error-status:error then do:
     1236     assign
     1237       v-error-append     = yes
     1238       v-error-append-msg = substitute( "&1&2&3"
     1239                                       , v-error-append-msg
     1240                                       , chr(10)
     1241                                       , return-value
     1242                                       )
     1243     .
     1244   end.
     1245   if v-error-append
     1246   then do:
     1247     return error substitute( "&1" , v-error-append-msg ) .
     1248   end.
     1249   END PROCEDURE.
     1250   PROCEDURE wp-XMLWriteEDT:
     1251     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1252     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1253     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1254       if valid-handle ( hEDT )
     1255       then do:
     1256           hEDT :move-to-eof().
     1257           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1258                                           OR sToWrite = "&Line") THEN "" ELSE
     1259                                           cur-time-string-sec() + " ").
     1260           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1261                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1262                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1263           hEDT :insert-string(chr(10)).
     1264       end.
     1265       process events.
     1266       output to 'bgescn.txt' append.
     1267           put unformatted
     1268               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1269                                           OR sToWrite = "&Line") THEN "" ELSE
     1270                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1271               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1272                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1273                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1274           .
     1275       output close.
     1276   END PROCEDURE.
     1277   PROCEDURE wp-XMLShowCNT:
     1278     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1279       if valid-handle( hCNT )
     1280       then do:
     1281           ASSIGN hCNT :VISIBLE = TRUE.
     1282       end.
     1283   END PROCEDURE.
     1284   PROCEDURE wp-XMLHideCNT:
     1285     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1286       if valid-handle( hCNT )
     1287       then do:
     1288           ASSIGN hCNT :VISIBLE = FALSE.
     1289       end.
     1290   END PROCEDURE.
     1291   PROCEDURE wp-XMLWriteCNT:
     1292     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1293     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1294       if valid-handle( hCNT )
     1295       then do:
     1296           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1297       end.
     1298   END PROCEDURE.
     1299   procedure bge-xml-write-header:
     1300   do
     1301   on error undo, return error
     1302   :
     1303   define input parameter p-xml-file-name  as character        no-undo.
     1304   define input parameter p-doc-name       as character        no-undo.
     1305   define input parameter p-version        as character        no-undo.
     1306   define input parameter p-db-num         as integer          no-undo.
     1307   define input parameter p-date-from      as date             no-undo.
     1308   define input parameter p-shift-num-from as integer          no-undo.
     1309   define input parameter p-date-to        as date             no-undo.
     1310   define input parameter p-shift-num-to   as integer          no-undo.
     1311   define input parameter p-obj-list       as character        no-undo.
     1312   define input parameter p-doc-type-list  as character        no-undo.
     1313   define input parameter p-pay-code       as logical          no-undo.
     1314   define input parameter p-cst            as logical          no-undo.
     1315   define input parameter p-parts          as logical          no-undo.
     1316   define input parameter p-chk-pay-code   as logical          no-undo.
     1317   define input parameter p-pay-desk       as logical          no-undo.
     1318   define input parameter p-pay-desk-cards as logical          no-undo.
     1319   define input parameter p-deleted        as logical          no-undo.
     1320   define input parameter p-opened-docs    as logical          no-undo.
     1321   define variable v-out-string    as character    no-undo.
     1322   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1323   assign
     1324       v-out-string = substitute( "&1&2&3"
     1325                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1326                           , chr(10)
     1327                           , "<IBS_Trade_House>":U )
     1328   .
     1329   put stream stmXMLOut unformatted
     1330       v-out-string
     1331   .
     1332   run wp-XMLTagOpen(1, "header","").
     1333   if v-bge-xml-bgeflold = "oracle":u
     1334   then do:
     1335     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1336     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1337     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1338     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1339     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1340   end.
     1341   run wp-XMLTagOpen( 2, "manifest", "").
     1342   run wp-XMLTagOpen( 3, "document", "").
     1343   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1344   run wp-XMLTagput( 4, "description", "", 0).
     1345   run wp-XMLTagput( 4, "version", p-version, 0).
     1346   run wp-XMLTagclose( 3, "document" ).
     1347   run wp-XMLTagclose( 2, "manifest" ).
     1348   run wp-XMLTagclose( 1, "header" ).
     1349   run wp-XMLTagOpen(1, "options","").
     1350   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1351   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1352   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1353   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1354   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1355   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1356   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1357   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1358   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1359   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1360   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1361   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1362   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1363   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1364   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1365   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1366   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1367   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1368   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1369   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1370   run wp-XMLTagClose(1, "options").
     1371   run wp-XMLTagOpen( 1, "body", "" ).
     1372   output stream stmXMLOut close.
     1373   end.
     1374   end procedure.
     1375   procedure xml-bge-write-footer:
     1376   do
     1377   on error undo, return error return-value
     1378   :
     1379   define input parameter p-xml-file-name as character    no-undo.
     1380   define variable v-error-num     as integer           no-undo.
     1381   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1382   run wp-XMLTagClose( 1, "body" ).
     1383   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1384   output stream stmXMLOut close.
     1385   if v-bge-xml-bgeflold = "oracle":u
     1386   then do:
     1387     define variable v-tmp-file-name         as character no-undo .
     1388     define variable v-zip-file-name         as character no-undo .
     1389     define variable v-exch-file-name        as character no-undo .
     1390     define variable v-heap-file-name        as character no-undo .
     1391     define variable v-i                     as integer   no-undo .
     1392     define variable v-file-name             as character no-undo .
     1393     define variable v-arc                   as character no-undo .
     1394     define variable v-str                   as character no-undo .
     1395     define variable v-exch-tmp-file-name    as character no-undo .
     1396     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1397     define variable v-bge-xml-exch-dir      as character no-undo .
     1398     define variable v-bge-xml-heap-dir      as character no-undo .
     1399     define variable v-bge-xml-compress-heap as logical   no-undo .
     1400     define variable v-home-dir              as character no-undo .
     1401     define variable v-os-command            as character no-undo .
     1402     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1403     if v-home-dir = ?
     1404     then do:
     1405       undo, return error substitute( "&1&2&3"
     1406                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1407                                     , chr(10)
     1408                                     , "Обратитесь к администратору.":u
     1409                                     ).
     1410     end.
     1411     assign
     1412       v-home-dir = v-home-dir
     1413     .
     1414     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1415     if error-status :error
     1416     then do:
     1417       undo, return error substitute( "&1&2&3"
     1418                                     , "Неверно задан каталог экспорта.":u
     1419                                     , chr(10)
     1420                                     , "Обратитесь к администратору.":u
     1421                                     ).
     1422     end.
     1423     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1424     if v-bge-xml-exch-dir = ?
     1425     then do:
     1426       undo, return error substitute( "&1&2&3"
     1427                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1428                                     , chr(10)
     1429                                     , "Обратитесь к администратору.":u
     1430                                     ).
     1431     end.
     1432     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1433     if error-status :error
     1434     then do:
     1435       undo, return error substitute( "&1&2&3"
     1436                                     , "Неверно задан каталог экспорта (exch).":u
     1437                                     , chr(10)
     1438                                     , "Обратитесь к администратору.":u
     1439                                     ).
     1440     end.
     1441     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1442     if v-bge-xml-heap-dir = ?
     1443     then do:
     1444       undo, return error substitute( "&1&2&3"
     1445                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1446                                     , chr(10)
     1447                                     , "Обратитесь к администратору.":u
     1448                                     ).
     1449     end.
     1450     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1451     if error-status :error
     1452     then do:
     1453       undo, return error substitute( "&1&2&3"
     1454                                     , "Неверно задан каталог экспорта (heap).":u
     1455                                     , chr(10)
     1456                                     , "Обратитесь к администратору.":u
     1457                                     ).
     1458     end.
     1459     get-key-value section "BGE" key "heap-compress" value v-str.
     1460     assign
     1461       v-i = int(v-str)
     1462     no-error .
     1463     if v-i = ? or v-i = 0
     1464     then do:
     1465       assign
     1466         v-bge-xml-compress-heap = no
     1467       .
     1468     end.
     1469     else do:
     1470       assign
     1471         v-bge-xml-compress-heap = yes
     1472       .
     1473     end.
     1474     assign
     1475       v-arc = search( "exe/7za.exe":u )
     1476     .
     1477     if v-arc = ? or v-arc = ""
     1478     then do:
     1479       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1480     end.
     1481     assign
     1482       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1483       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1484       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1485       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1486       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1487       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1488       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1489     .
     1490     run gbl/del-file.p (input v-tmp-file-name) .
     1491     run gbl/del-file.p (input v-zip-file-name) .
     1492     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1493     if v-error-num > 0
     1494     then do:
     1495         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1496                                      , p-xml-file-name + "xm1":u
     1497                                      , v-tmp-file-name
     1498                                      , v-error-num
     1499                                      ).
     1500     end.
     1501     assign
     1502       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1503                                    , v-arc
     1504                                    , v-zip-file-name
     1505                                    , v-tmp-file-name
     1506                                    )
     1507     .
     1508     os-command silent value ( v-os-command ) .
     1509     run gbl/del-file.p (input v-heap-file-name) .
     1510     if v-bge-xml-compress-heap = no
     1511     then do:
     1512       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1513       if v-error-num > 0
     1514       then do:
     1515           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1516                                        , v-tmp-file-name
     1517                                        , v-heap-file-name
     1518                                        , v-error-num
     1519                                        ) .
     1520       end.
     1521     end.
     1522     else do:
     1523       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1524       if v-error-num > 0
     1525       then do:
     1526           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1527                                        , v-zip-file-name
     1528                                        , v-heap-file-name
     1529                                        , v-error-num
     1530                                        ) .
     1531       end.
     1532     end.
     1533     run gbl/del-file.p (input v-tmp-file-name) .
     1534     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1535     if error-status :error then do:
     1536       undo, return error substitute( "&1&2&3"
     1537                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1538                                     , chr(10)
     1539                                     , "Обратитесь к администратору."
     1540                                     ).
     1541     end.
     1542     run gbl/del-file.p (input v-exch-file-name) .
     1543     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1544     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1545     if v-error-num > 0
     1546     then do:
     1547       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1548                                     , v-zip-file-name
     1549                                     , v-exch-tmp-file-name
     1550                                     , v-error-num
     1551                                     ) .
     1552     end.
     1553     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1554     if v-error-num > 0
     1555     then do:
     1556       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1557                                     , v-exch-tmp-file-name
     1558                                     , v-exch-file-name
     1559                                     , v-error-num
     1560                                     ) .
     1561     end.
     1562     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1563   end.
     1564   else do:
     1565     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1566     if v-error-num > 0
     1567     then do:
     1568       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1569                                     , p-xml-file-name + "xm1"
     1570                                     , p-xml-file-name + "xml"
     1571                                     , v-error-num
     1572                                     ) .
     1573     end.
     1574   end.
     1575   if opsys = "unix"
     1576   then do:
     1577       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1578   end.
     1579   end.
     1580   end procedure.
     1581   procedure xml-bge-filename0:
     1582   define input parameter p-prefix   as character no-undo .
     1583   define input parameter p-name     as character no-undo .
     1584   define input parameter p-shared-process as logical no-undo .
     1585   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1586   define output parameter p-xml-file-name  as character no-undo .
     1587   // define output parameter p-fullfnamenoext as character no-undo .
     1588   define output parameter p-locked         as logical      no-undo.
     1589   define variable v-fullfnamenoext as character no-undo .
     1590   define variable v-fileext        as character no-undo .
     1591   define variable v-fullfname      as character no-undo .
     1592   define variable v-error-num      as integer   no-undo .
     1593   do
     1594   on error undo, return error
     1595   :
     1596     case v-bge-xml-bgeflold :
     1597       when "old" then do:
     1598         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1599         v-fileext       = ".xml":U .
     1600         v-fullfname     = v-fullfnamenoext + v-fileext .
     1601         p-xml-file-name = v-fullfname .
     1602         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1603         if v-error-num > 0 then do:
     1604           return error.
     1605         end.
     1606       end.
     1607       when "var" then do:
     1608         case p-prefix :
     1609           when "doc" then do:
     1610             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1611             v-fileext       = ".xml":U .
     1612             v-fullfname     = v-fullfnamenoext + v-fileext .
     1613             p-xml-file-name = v-fullfname .
     1614           end.
     1615           when "day" then do:
     1616             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1617             v-fileext       = ".xml":U .
     1618             v-fullfname     = v-fullfnamenoext + v-fileext .
     1619             p-xml-file-name = v-fullfname .
     1620           end.
     1621           otherwise do:
     1622             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1623             v-fileext       = ".xml":U .
     1624             v-fullfname     = v-fullfnamenoext + v-fileext .
     1625             p-xml-file-name = v-fullfname .
     1626           end.
     1627         end case.
     1628         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1629         if v-error-num > 0 then do:
     1630           return error.
     1631         end.
     1632       end.
     1633       when "new" then do:
     1634                   run bge/genfname.p (
     1635                       input p-home-dir
     1636                       , input p-prefix
     1637                       , input ""
     1638                       , input "xml"
     1639                       , input ""
     1640                       , output p-xml-file-name
     1641                   ).
     1642       end.
     1643       when "no-parameter" then do:
     1644         if p-shared-process then do:
     1645                       run bge/genfname.p (
     1646                           input p-home-dir
     1647                           , input "d"
     1648                           , input ""
     1649                           , input "xml"
     1650                           , input ""
     1651                           , output p-xml-file-name
     1652                       ).
     1653         end.
     1654         else do:
     1655           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1656           v-fileext       = ".xml":U .
     1657           v-fullfname     = v-fullfnamenoext + v-fileext .
     1658           p-xml-file-name = v-fullfname .
     1659           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1660           if v-error-num > 0 then do:
     1661             return error.
     1662           end.
     1663         end.
     1664       end.
     1665     end case.
     1666     assign
     1667       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1668       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1669     .
     1670   end .
     1671   end procedure .
     1672   procedure xml-bge-filename :
     1673   do
     1674   on error undo, return error
     1675   :
     1676   define input parameter p-prefix             as character    no-undo.
     1677   define input parameter p-name               as character    no-undo.
     1678   define input parameter p-shared-process     as logical      no-undo.
     1679   define output parameter p-xml-file-name     as character    no-undo.
     1680   define output parameter p-log-file-name     as character    no-undo.
     1681   define output parameter p-locked            as logical      no-undo.
     1682   define variable v-home-dir          as character no-undo .
     1683   define variable v-error-num         as integer   no-undo .
     1684   define variable v-bge-xml-heap-dir  as character no-undo .
     1685       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1686       if v-home-dir = ?
     1687       then do:
     1688           message
     1689             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1690             skip(1)
     1691             skip "Обратитесь к администратору."
     1692           view-as alert-box error.
     1693           undo, return error .
     1694       end.
     1695       if v-bge-xml-bgeflold <> "oracle"
     1696       then do:
     1697         assign
     1698             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1699         .
     1700       end.
     1701       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1702       if error-status :error
     1703       then do:
     1704           message
     1705             skip "Неверно задан каталог экспорта."
     1706             skip(1)
     1707             skip "Обратитесь к администратору."
     1708           view-as alert-box error.
     1709           undo, return error .
     1710       end.
     1711       if v-bge-xml-bgefmt = "dbf":U
     1712       then do:
     1713           assign
     1714               p-xml-file-name = v-home-dir
     1715               p-locked        = no
     1716           .
     1717       end.
     1718       else do:
     1719           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1720             output p-xml-file-name, output p-locked) .
     1721       end.
     1722       if v-bge-xml-bgeflold = "oracle"
     1723       then do:
     1724         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1725         if v-bge-xml-heap-dir = ?
     1726         then do:
     1727           undo, return error substitute( "&1&2&3"
     1728                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1729                                         , chr(10)
     1730                                         , "Обратитесь к администратору.":u
     1731                                         ).
     1732         end.
     1733         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1734         if error-status :error
     1735         then do:
     1736           undo, return error substitute( "&1&2&3"
     1737                                         , "Неверно задан каталог экспорта (heap).":u
     1738                                         , chr(10)
     1739                                         , "Обратитесь к администратору.":u
     1740                                         ).
     1741         end.
     1742         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1743           assign
     1744             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1745           .
     1746         end.
     1747         else do:
     1748           assign
     1749             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1750           .
     1751         end.
     1752       end.
     1753       else do:
     1754         assign
     1755             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1756         .
     1757       end.
     1758       assign
     1759          v-bge-xml-static-log-file-name = p-log-file-name
     1760       .
     1761   end.
     1762   end procedure.
     1763   procedure bge-xml-read-config :
     1764   do
     1765   on error undo, return error return-value
     1766   :
     1767   define input  parameter p-last-date as date      no-undo .
     1768   define input  parameter p-db-num    as integer   no-undo .
     1769       define variable v-bgeclall      as character     no-undo.
     1770       define variable v-bgedict       as character     no-undo.
     1771       define variable v-bgeshift      as character     no-undo.
     1772       define variable v-par-type      as character     no-undo.
     1773       define variable v-bgeflnm       as character     no-undo.
     1774       define variable v-bgecliiv      as character     no-undo .
     1775       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1776       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1777       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1778       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1779       define variable v-db-num-str    as character     no-undo .
     1780       define variable v-param-type      as character  no-undo .
     1781       define variable v-value-character as character  no-undo .
     1782       define variable v-value-date      as date       no-undo .
     1783       define variable v-value-decimal   as decimal    no-undo .
     1784       define variable v-value-integer   as integer    no-undo .
     1785       define variable v-value-logical   as logical    no-undo .
     1786       define variable v-tth             as handle      no-undo .
     1787       run adm/shattri.p ( input "get":U
     1788                         , input  '':u
     1789                         , input  0
     1790                         , input  'bge-export':U
     1791                         , input  'bgeclall':U
     1792                         , output v-bgecliiv
     1793                         , output v-value-date
     1794                         , output v-value-decimal
     1795                         , output v-value-integer
     1796                         , output v-value-logical
     1797                         , output v-param-type
     1798                         , input-output table-handle v-tth
     1799                         ) no-error .
     1800       if error-status :error
     1801       then do:
     1802         assign
     1803           v-bge-xml-bgecliiv = no
     1804         .
     1805       end.
     1806       else do:
     1807         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1808       end.
     1809       delete object v-tth.
     1810       assign
     1811           v-bge-xml-bgeclall = no
     1812           v-bge-xml-bgedict  = no
     1813       .
     1814       run adm/shattri.p ( input "get":U
     1815                         , input  '':u
     1816                         , input  0
     1817                         , input  'bge-export':U
     1818                         , input  'bgeclall':U
     1819                         , output v-value-character
     1820                         , output v-value-date
     1821                         , output v-value-decimal
     1822                         , output v-value-integer
     1823                         , output v-value-logical
     1824                         , output v-param-type
     1825                         , input-output table-handle v-tth
     1826                         ) no-error .
     1827       if error-status :error
     1828       then do:
     1829         assign
     1830           v-bge-xml-bgeclall = no
     1831         .
     1832       end.
     1833       else do:
     1834         assign
     1835           v-bge-xml-bgeclall = v-value-logical
     1836         .
     1837       end.
     1838       delete object v-tth.
     1839       run adm/shattri.p ( input "get":U
     1840                         , input  '':u
     1841                         , input  0
     1842                         , input  'bge-export':U
     1843                         , input  'bgedict':U
     1844                         , output v-value-character
     1845                         , output v-value-date
     1846                         , output v-value-decimal
     1847                         , output v-value-integer
     1848                         , output v-value-logical
     1849                         , output v-param-type
     1850                         , input-output table-handle v-tth
     1851                         ) no-error .
     1852       if error-status :error
     1853       then do:
     1854         assign
     1855           v-bge-xml-bgedict = no
     1856         .
     1857       end.
     1858       else do:
     1859         assign
     1860           v-bge-xml-bgedict = v-value-logical
     1861         .
     1862       end.
     1863       delete object v-tth.
     1864       run adm/shattri.p ( input "get":U
     1865                         , input  '':u
     1866                         , input  0
     1867                         , input  'bge-export':U
     1868                         , input  'bgefmt':U
     1869                         , output v-value-character
     1870                         , output v-value-date
     1871                         , output v-value-decimal
     1872                         , output v-value-integer
     1873                         , output v-value-logical
     1874                         , output v-param-type
     1875                         , input-output table-handle v-tth
     1876                         ) no-error .
     1877       if error-status :error
     1878       then do:
     1879         assign
     1880           v-bge-xml-bgefmt  = "xml":U
     1881         .
     1882       end.
     1883       else do:
     1884         assign
     1885           v-bge-xml-bgefmt  = v-value-character
     1886         .
     1887       end.
     1888       delete object v-tth.
     1889       run adm/shattri.p ( input "get":U
     1890                         , input  '':u
     1891                         , input  0
     1892                         , input  'bge-export':U
     1893                         , input  'bgeshift':U
     1894                         , output v-value-character
     1895                         , output v-value-date
     1896                         , output v-value-decimal
     1897                         , output v-value-integer
     1898                         , output v-value-logical
     1899                         , output v-param-type
     1900                         , input-output table-handle v-tth
     1901                         ) no-error .
     1902       if error-status :error
     1903       then do:
     1904         assign
     1905             v-bge-xml-shift-mode = no
     1906         .
     1907       end.
     1908       else do:
     1909         assign
     1910             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1911         .
     1912       end.
     1913       delete object v-tth.
     1914       run adm/shattri.p ( input "get":U
     1915                         , input  '':u
     1916                         , input  0
     1917                         , input  'bge-export':U
     1918                         , input  'bgeflold':U
     1919                         , output v-value-character
     1920                         , output v-value-date
     1921                         , output v-value-decimal
     1922                         , output v-value-integer
     1923                         , output v-value-logical
     1924                         , output v-param-type
     1925                         , input-output table-handle v-tth
     1926                         ) no-error .
     1927       if error-status :error
     1928       then do:
     1929         assign
     1930           v-bge-xml-bgeflold = "no-parameter":U
     1931         .
     1932       end.
     1933       else do:
     1934         assign
     1935           v-bge-xml-bgeflold  = v-value-character
     1936         .
     1937       end.
     1938       delete object v-tth.
     1939       assign
     1940         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1941         v-bge-xml-db-num-str  = v-db-num-str
     1942       .
     1943       if p-last-date <> ?
     1944       then do:
     1945           run adm/shattri.p ( input "get":U
     1946                             , input  '':u
     1947                             , input  0
     1948                             , input  'bge-export':U
     1949                             , input  'bgeflnm':U
     1950                             , output v-value-character
     1951                             , output v-value-date
     1952                             , output v-value-decimal
     1953                             , output v-value-integer
     1954                             , output v-value-logical
     1955                             , output v-param-type
     1956                             , input-output table-handle v-tth
     1957                             ) no-error .
     1958           if error-status :error
     1959           then do:
     1960             assign
     1961               v-bgeflnm = '':U
     1962             .
     1963           end.
     1964           else do:
     1965             assign
     1966               v-bgeflnm = v-value-character
     1967             .
     1968           end.
     1969           delete object v-tth.
     1970           if v-bge-xml-bgeflold = "var"
     1971           then do:
     1972               if v-bgeflnm = ?
     1973               or num-entries( v-bgeflnm ) < 2
     1974               then do:
     1975                   assign
     1976                       v-bge-xml-bgeflold = "new"
     1977                   .
     1978               end.
     1979               else do:
     1980                   assign
     1981                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1982                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1983                   .
     1984                   assign
     1985                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1986                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1987                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1988                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1989                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1990                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1991                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1992                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1993                   .
     1994               end.
     1995           end.
     1996       end.
     1997   end.
     1998   end procedure.
     1999   procedure bge-xml-get-ref-filename :
     2000   define input parameter p-in-file-name       as character        no-undo.
     2001   define output parameter p-home-dir          as character        no-undo.
     2002   define output parameter p-out-file-name     as character        no-undo.
     2003   define output parameter p-locked            as logical          no-undo.
     2004       define variable v-counter       as integer      no-undo.
     2005       define variable v-error-level   as integer      no-undo.
     2006   do
     2007   on error undo, return error
     2008   :
     2009       run bge/bge-ini.p (
     2010             input "bge"
     2011           , output p-home-dir
     2012       ).
     2013       if return-value <> "OK"
     2014       then do:
     2015           undo, return error.
     2016       end.
     2017       assign
     2018           p-home-dir = p-home-dir + "\dict":U
     2019       .
     2020       run bge/dir_cd.p (
     2021           input p-home-dir
     2022           , input "CA"
     2023       ).
     2024       if return-value = "ERROR"
     2025       then do:
     2026           undo, return error.
     2027       end.
     2028       assign
     2029           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2030       .
     2031       assign
     2032           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2033       .
     2034       wait-lock:
     2035       do v-counter = 1 TO 3
     2036       :
     2037           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2038           if p-locked = no
     2039           then do:
     2040               leave wait-lock.
     2041           end.
     2042           else do:
     2043               readkey pause 1.
     2044           end.
     2045       END.
     2046       if p-locked = yes
     2047       then do:
     2048           undo, return error.
     2049       end.
     2050       run bge/os_copy.p (
     2051             input "D":U
     2052           , input p-out-file-name + "xml":U
     2053           , input "":U
     2054           , output v-error-level
     2055       ).
     2056       if v-error-level > 0
     2057       then do:
     2058           undo, return error.
     2059       end.
     2060   end.
     2061   end procedure.
     2062   procedure bge-xml-write-ref-header :
     2063   define input parameter p-bge-name as character        no-undo.
     2064   define input parameter p-file-name as character        no-undo.
     2065       define variable v-out-string    as character    no-undo.
     2066   do
     2067   on error undo, return error
     2068   :
     2069       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2070       put stream stmXMLOut unformatted
     2071           "<?xml version='1.0' encoding='windows-1251'?>":U
     2072       .
     2073       assign
     2074           v-out-string = substitute( "&1&2"
     2075                               , chr(10)
     2076                               , "<IBS_Trade_House>":U )
     2077       .
     2078       put stream stmXMLOut unformatted
     2079           v-out-string
     2080       .
     2081       run wp-XMLTagOpen( 1, "header", "" ).
     2082       if v-bge-xml-bgeflold = "oracle":u
     2083       then do:
     2084         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2085         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2086         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2087         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2088         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2089       end.
     2090       else do:
     2091         run wp-XMLTagOpen( 2, "delivery", "" ).
     2092         run wp-XMLTagOpen( 3, "to", "" ).
     2093         run wp-XMLTagClose( 3, "to" ).
     2094         run wp-XMLTagOpen( 3, "from", "" ).
     2095         run wp-XMLTagClose( 3, "from" ).
     2096         run wp-XMLTagClose( 2, "delivery" ).
     2097       end.
     2098       run wp-XMLTagOpen( 2, "manifest", "" ).
     2099       run wp-XMLTagOpen( 3, "document", "" ).
     2100       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2101       run wp-XMLTagPut( 4, "description", "", 0 ).
     2102       run wp-XMLTagClose( 3, "document" ).
     2103       run wp-XMLTagClose( 2, "manifest" ).
     2104       run wp-XMLTagClose( 1, "header" ).
     2105       run wp-XMLTagOpen( 1, "body", "" ).
     2106   end.
     2107   end procedure.
     2108   procedure bge-xml-write-ref-footer :
     2109   define input parameter p-file-name as character        no-undo.
     2110       define variable v-error-level   as integer      no-undo.
     2111   do
     2112   on error undo, return error
     2113   :
     2114       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2115       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2116       output stream stmXMLOut close.
     2117       run bge/os_copy.p (
     2118             input "M":U
     2119           , input p-file-name + "xm1":U
     2120           , input p-file-name + "xml":U
     2121           , output v-error-level
     2122       ).
     2123       if v-error-level > 0
     2124       then do:
     2125           undo, return error.
     2126       end.
     2127   end.
     2128   end procedure.
     2129   procedure bge-xml-out-dir :
     2130   define output parameter p-out-dir       as character    no-undo.
     2131   define output parameter p-log-file-name as character    no-undo.
     2132   do
     2133   on error undo, return error
     2134   :
     2135       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2136       if p-out-dir = ?
     2137       then do:
     2138           message
     2139             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2140                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2141             skip(1)
     2142             skip "Обратитесь к администратору."
     2143           view-as alert-box error.
     2144           undo, return error .
     2145       end.
     2146       if v-bge-xml-bgeflold <> "oracle" then assign
     2147         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2148       .
     2149       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2150       if error-status :error  then do:
     2151           run wp-XMLWriteLog in this-procedure (
     2152                 input p-log-file-name
     2153               , input 0
     2154               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2155                                   , p-out-dir
     2156                                   , return-value
     2157                                   , trim( error-status :get-message( 1 ) )
     2158                                   )
     2159           ).
     2160           undo, return error.
     2161       end.
     2162       assign
     2163           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2164           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2165       .
     2166   end.
     2167   end procedure.
     2168   procedure bge-xml-out-dir2 :
     2169   define output parameter p-out-dir       as character    no-undo.
     2170   define output parameter p-out-dirR      as character    no-undo.
     2171   define output parameter p-log-file-name as character    no-undo.
     2172   do
     2173   on error undo, return error
     2174   :
     2175       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2176       if p-out-dir = ?
     2177       then do:
     2178           message
     2179             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2180                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2181             skip(1)
     2182             skip "Обратитесь к администратору."
     2183           view-as alert-box error.
     2184           undo, return error .
     2185       end.
     2186       if v-bge-xml-bgeflold <> "oracle" then assign
     2187             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2188             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2189         .
     2190       else p-out-dirR = p-out-dir .
     2191       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2192       if error-status :error  then do:
     2193           run wp-XMLWriteLog in this-procedure (
     2194                 input p-log-file-name
     2195               , input 0
     2196               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2197                                   , p-out-dir
     2198                                   , return-value
     2199                                   , error-status :get-message( 1 )
     2200                                   )
     2201           ).
     2202           undo, return error.
     2203       end.
     2204       if p-out-dirR <> p-out-dir then do:
     2205         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2206         if error-status :error then do:
     2207           run wp-XMLWriteLog in this-procedure (
     2208                 input p-log-file-name
     2209               , input 0
     2210               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2211                                   , p-out-dirR
     2212                                   , return-value
     2213                                   , error-status :get-message( 1 )
     2214                                   )
     2215           ).
     2216           p-out-dirR = p-out-dir .
     2217         end.
     2218       end .
     2219       assign
     2220         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2221         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2222       .
     2223   end.
     2224   end procedure.
     2225   procedure bge-xml-out-file :
     2226   do
     2227   on error undo, return error
     2228   :
     2229   define input parameter p-out-dir            as character        no-undo.
     2230   define input parameter p-prefix             as character        no-undo.
     2231   define input parameter p-sheduled           as logical          no-undo.
     2232   define output parameter p-xml-file-name     as character        no-undo.
     2233   define output parameter p-locked            as logical          no-undo.
     2234   define variable v-home-dir      as character     no-undo.
     2235   define variable v-error-num     as integer       no-undo.
     2236   define variable v-today             as date         no-undo.
     2237   define variable v-time              as integer      no-undo.
     2238       if v-bge-xml-bgefmt = "dbf":U
     2239       then do:
     2240           assign
     2241               p-xml-file-name = p-out-dir
     2242               p-locked        = no
     2243           .
     2244       end.
     2245       else do:
     2246           if v-bge-xml-bgeflold = "firm":U
     2247           then do:
     2248               run bge/genfname.p (
     2249                     input p-out-dir
     2250                   , input p-prefix
     2251                   , input "":U
     2252                   , input "arj":U
     2253                   , input "":U
     2254                   , output p-xml-file-name
     2255               ).
     2256           end.
     2257           else do:
     2258               run bge/genfname.p (
     2259                     input p-out-dir
     2260                   , input p-prefix
     2261                   , input "":U
     2262                   , input "xml":U
     2263                   , input "":U
     2264                   , output p-xml-file-name
     2265               ).
     2266           end.
     2267           assign
     2268               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2269               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2270           .
     2271       end.
     2272   end.
     2273   end procedure.
     2274   procedure bge-xml-init-ext-doc-type :
     2275       define variable v-counter    as integer      no-undo.
     2276       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2277   do
     2278   for buf_temp_ext-doc-type
     2279   on error undo, return error
     2280   :
     2281       empty temp-table buf_temp_ext-doc-type.
     2282       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2283       :
     2284           create buf_temp_ext-doc-type.
     2285           assign
     2286               buf_temp_ext-doc-type.edt-key               = v-counter
     2287               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2288               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2289           .
     2290       end.
     2291   end.
     2292   end procedure.
     2293   procedure bge-xml-get-decimal-shift-num :
     2294   define input parameter p-shift-date     as date             no-undo.
     2295   define input parameter p-shift-num      as integer          no-undo.
     2296   define output parameter p-shift-decimal as decimal          no-undo.
     2297   do
     2298   on error undo, return error
     2299   :
     2300       assign
     2301           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2302       .
     2303   end.
     2304   end procedure.
     2305   procedure bge-xml-ora-exp-filename :
     2306     define input  parameter p-table-name  as character no-undo .
     2307     define input  parameter p-doc-code    as character no-undo .
     2308     define input  parameter p-obj-code    as integer   no-undo .
     2309     define output parameter p-filename    as character no-undo .
     2310     define output parameter p-seq-num     as integer   no-undo .
     2311     define variable v-ora-exp-seq     as integer   no-undo .
     2312     define variable v-ora-exp-seq-str as character no-undo .
     2313     define variable v-home-dir        as character no-undo.
     2314   do
     2315   on error undo, return error return-value
     2316   :
     2317     if v-bge-xml-bgeflold = "oracle":u
     2318     then do:
     2319       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2320       if v-home-dir = ?
     2321       then do:
     2322         undo, return error substitute( "&1&2&3":U
     2323                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2324                                       , chr(10)
     2325                                       , "Обратитесь к администратору.":U
     2326                                       ).
     2327       end.
     2328       assign
     2329           v-home-dir = v-home-dir
     2330       .
     2331       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2332       if error-status :error
     2333       then do:
     2334         undo, return error substitute( "&1&2&3":U
     2335                                       , "Неверно задан каталог экспорта.":U
     2336                                       , chr(10)
     2337                                       , "Обратитесь к администратору.":U
     2338                                       ).
     2339       end.
     2340       assign
     2341         v-ora-exp-seq = ?
     2342       .
     2343       if  p-table-name <> ? and
     2344           p-doc-code <> ?
     2345       then do:
     2346         run bge/get-oesq.p ( input p-table-name
     2347                            , input p-doc-code
     2348                            , output v-ora-exp-seq
     2349                            ) no-error .
     2350         if error-status :error = yes
     2351         then do:
     2352           undo, return error return-value .
     2353         end.
     2354       end.
     2355       if v-ora-exp-seq = ?
     2356       then do:
     2357         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2358         if error-status :error
     2359         then do:
     2360           undo, return error return-value .
     2361         end.
     2362       end.
     2363       if p-table-name <> ? and
     2364          p-doc-code   <> ?
     2365       then do:
     2366         run bge/oesqdoc.p ( input p-table-name
     2367                           , input p-doc-code
     2368                           , input v-ora-exp-seq
     2369                           ) no-error .
     2370         if error-status :error = yes
     2371         then do:
     2372           undo, return error return-value .
     2373         end.
     2374       end.
     2375       assign
     2376         p-seq-num  = v-ora-exp-seq
     2377         p-filename = substitute("&1/&2-000_&3."
     2378                                , v-home-dir
     2379                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2380                                , string(v-ora-exp-seq , "999999999")
     2381                                )
     2382       .
     2383     end.
     2384   end.
     2385   end procedure.
     2386   procedure bge-xml-date-to-str :
     2387     define input  parameter p-date  as date      no-undo .
     2388     define output parameter p-str   as character no-undo .
     2389   do
     2390   on error undo, return error return-value
     2391   :
     2392     if p-date <> ?
     2393     then do:
     2394       assign
     2395         p-str = substitute( "&1-&2-&3"
     2396                           , string( year(p-date)  , "9999")
     2397                           , string( month(p-date) , "99"  )
     2398                           , string( day(p-date)   , "99"  )
     2399                           )
     2400       .
     2401     end.
     2402     else do:
     2403       assign
     2404         p-str = ?
     2405       .
     2406     end.
     2407   end.
     2408   end procedure.
     2409   procedure bge-xml-date-str-to-str :
     2410     define input  parameter p-date-str  as character no-undo .
     2411     define output parameter p-str       as character no-undo .
     2412     define variable v-date          as date      no-undo .
     2413     define variable v-date-valid    as logical   no-undo .
     2414     define variable v-error-message as character no-undo .
     2415   do
     2416   on error undo, return error return-value
     2417   :
     2418     assign
     2419       p-str = ?
     2420     .
     2421     if p-date-str = ? or p-date-str = ""
     2422     then do:
     2423       return .
     2424     end.
     2425     run strtdate in this-procedure ( input  p-date-str
     2426                                    , output v-date
     2427                                    , output v-date-valid
     2428                                    , output v-error-message
     2429                                    ).
     2430     if v-date-valid <> true
     2431     then do:
     2432       return .
     2433     end.
     2434     assign
     2435       p-str = substitute( "&1-&2-&3"
     2436                         , string( year(v-date)  , "9999")
     2437                         , string( month(v-date) , "99"  )
     2438                         , string( day(v-date)   , "99"  )
     2439                         )
     2440     .
     2441   end.
     2442   end procedure.
     2443   procedure bge-xml-fill-tt-bgecliiv :
     2444     define input  parameter p-str as character no-undo .
     2445     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2446     define buffer buf_clients             for ub.clients.
     2447     define variable v-i         as integer   no-undo .
     2448     define variable v-count     as integer   no-undo .
     2449     define variable v-cli-count as integer   no-undo .
     2450     define variable v-client    as character no-undo .
     2451     define variable v-obj-type  as character no-undo .
     2452     define variable v-obj-code  as integer   no-undo .
     2453   do
     2454   on error undo, return error return-value
     2455   :
     2456     empty temp-table buf_tt-bge-xml-bgecliiv.
     2457     assign
     2458       v-bge-xml-bgecliiv = no
     2459       v-cli-count        = num-entries(p-str,';')
     2460     .
     2461     if v-cli-count > 0
     2462     then do:
     2463       _cli-cycle:
     2464       do v-i = 1 to v-cli-count
     2465       :
     2466         assign
     2467           v-client = entry(v-i , p-str, ';')
     2468         .
     2469         if num-entries(v-client) <> 2
     2470         then do:
     2471           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2472         end.
     2473         assign
     2474           v-obj-type = entry(1, v-client)
     2475         .
     2476         assign
     2477           v-obj-code = integer(entry(2, v-client))
     2478         no-error .
     2479         if error-status :error
     2480         then do:
     2481           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2482         end.
     2483         find first buf_clients no-lock
     2484           where buf_clients.obj-type = v-obj-type
     2485             and buf_clients.obj-code = v-obj-code
     2486         no-error.
     2487         if not available buf_clients
     2488         then do:
     2489           next _cli-cycle.
     2490         end.
     2491         find first buf_tt-bge-xml-bgecliiv no-lock
     2492           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2493             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2494         no-error .
     2495         if available buf_tt-bge-xml-bgecliiv
     2496         then do:
     2497           next _cli-cycle.
     2498         end.
     2499         create buf_tt-bge-xml-bgecliiv.
     2500         assign
     2501           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2502           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2503         .
     2504       end.
     2505     end.
     2506     else do:
     2507       assign
     2508         v-bge-xml-bgecliiv = no
     2509       .
     2510       return .
     2511     end.
     2512     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2513     if available buf_tt-bge-xml-bgecliiv
     2514     then do:
     2515       assign
     2516         v-bge-xml-bgecliiv = yes
     2517       .
     2518     end.
     2519   end.
     2520   end procedure.
     2521   procedure bge-xml-resolve-ext-doc-type :
     2522     define input  parameter p-ext-doc-type      as character no-undo .
     2523     define input  parameter p-obj-type          as character no-undo .
     2524     define input  parameter p-obj-code          as integer   no-undo .
     2525     define output parameter p-out-ext-doc-type  as character no-undo .
     2526     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2527   do
     2528   on error undo, return error return-value
     2529   :
     2530     assign
     2531       p-out-ext-doc-type = p-ext-doc-type
     2532     .
     2533     if p-ext-doc-type <> 'ie':U
     2534     then do:
     2535       return .
     2536     end.
     2537     if v-bge-xml-bgecliiv = yes
     2538     then do:
     2539       find first buf_tt-bge-xml-bgecliiv no-lock
     2540         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2541           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2542       no-error .
     2543       if available buf_tt-bge-xml-bgecliiv
     2544       then do:
     2545         assign
     2546           p-out-ext-doc-type = 'iv':U
     2547         .
     2548       end.
     2549     end.
     2550   end.
     2551   end procedure.
     2552   procedure safe-wp-xmltagput :
     2553     define input  parameter pTagLevel   as integer   no-undo .
     2554     define input  parameter pTagName    as character no-undo .
     2555     define input  parameter pParValue   as character no-undo .
     2556     define input  parameter pFlagEmpty  as integer   no-undo .
     2557   do
     2558   on error undo, return error return-value
     2559   :
     2560     if v-bge-xml-bgeflold = "oracle":u
     2561     then do:
     2562       return .
     2563     end.
     2564     run wp-xmltagput in this-procedure ( input pTagLevel
     2565                                        , input pTagName
     2566                                        , input pParValue
     2567                                        , input pFlagEmpty
     2568                                        ).
     2569   end.
     2570   end procedure.
     2571   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2572     define variable v-cntxt-db-num        as integer   no-undo .
     2573     define variable v-cntxt-userid        as character no-undo .
     2574     define variable v-cntxt-level         as character no-undo .
     2575     define variable v-cntxt-host-code-obj as integer   no-undo .
     2576     define variable v-cntxt-obj-type      as character no-undo .
     2577     define variable v-cntxt-obj-code      as integer   no-undo .
     2578     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2579     define variable v-cntxt-is-admin      as logical   no-undo .
     2580   DEF VAR gen-mode   AS CHAR NO-UNDO.
     2581   DEF VAR sHomeDir   AS CHAR                 NO-UNDO.
     2582   DEF VAR sOutFile   AS CHAR                 NO-UNDO.
     2583   DEF VAR sLogFile   AS CHAR                 NO-UNDO.
     2584   DEF VAR bLocked    AS LOGICAL  INIT NO     NO-UNDO.
     2585   DEF VAR iRep       AS INTEGER  INIT 0      NO-UNDO.
     2586   DEF VAR ErrorLevel AS INTEGER              NO-UNDO.
     2587   DEF VAR iOperNum   AS INTEGER              NO-UNDO.
     2588   DEF VAR dTemp      AS DATE                 NO-UNDO.
     2589   define variable v-success    as logical      no-undo.
     2590   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2591     run mainmenu_getcntxt in p-mainmenu-handle
     2592       (output v-cntxt-db-num
     2593       ,output v-cntxt-userid
     2594       ,output v-cntxt-level
     2595       ,output v-cntxt-host-code-obj
     2596       ,output v-cntxt-obj-type
     2597       ,output v-cntxt-obj-code
     2598       ,output v-cntxt-db-num-obj
     2599       ,output v-cntxt-is-admin
     2600       ) .
     2601   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602   do:
     2603     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2604       (input  v-cntxt-db-num
     2605       ,input  v-cntxt-userid
     2606       ,input  0
     2607       ,input  'actn_documents_export':U
     2608       ,input  'firm':U
     2609       ,input  v-cntxt-host-code-obj
     2610       ,input  '':U
     2611       ,input  0
     2612       ,input  0
     2613       ,input  0
     2614       ,input  0
     2615       ,input  yes
     2616       ,output v-success
     2617       )  .
     2618   end.
     2619   IF v-success = no THEN RETURN ERROR.
     2620   run bge/bge-ini.p ("bge", OUTPUT sHomeDir).
     2621   IF RETURN-VALUE <> "OK" THEN RETURN "ERROR".
     2622   sHomeDir = sHomeDir + "\exp-acc".
     2623   run bge/dir_cd.p (sHomeDir, "CA").
     2624   IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
     2625   sOutFile = sHomeDir + "\kass.".
     2626   bLocked = (SEARCH (sOutFile + "xml") <> ?).
     2627   DO iRep = 1 TO 3 WHILE bLocked:
     2628      bLocked = (SEARCH (sOutFile + "lk") <> ?).
     2629      IF bLocked THEN READKEY PAUSE 1.
     2630   END.
     2631   IF bLocked THEN RETURN "LOCKED".
     2632   run bge/os_copy.p ("D", sOutFile + "xml", "", OUTPUT ErrorLevel).
     2633   IF ErrorLevel > 0 THEN RETURN "ERROR".
     2634   ASSIGN sLogFile = sHomeDir + "\" + "Actions.log".
     2635   OUTPUT STREAM stmXMLOut TO VALUE(sOutFile + "xm1") CONVERT TARGET "1251" APPEND.
     2636   RUN wp-XMLWriteLog(sLogFile, 0, "&DLine").
     2637   RUN wp-XMLWriteLog(sLogFile, 1, "XML - Вывод ДОКУМЕНТОВ").
     2638   RUN XMLWriteHeaderCat.
     2639   OUTPUT STREAM stmXMLOut CLOSE.
     2640   RUN init-temphost.
     2641   RUN wp-XMLShowCNT(hCNT).
     2642   FOR EACH temp-obj
     2643      WHERE temp-obj.host-code = v-cntxt-host-code-obj
     2644   :
     2645     IF temp-obj.obj-type = 'маг':U
     2646     THEN DO:
     2647       RUN wp-XMLWriteEDT( hEDT, 10, "*** " + STRING(temp-obj.obj-type) + " " + STRING(temp-obj.obj-code) + " ***").
     2648       PROCESS EVENTS.
     2649       DO dTemp = dFrom TO dTo:
     2650           run bge/doc-kass.p (INPUT temp-obj.obj-type,
     2651                           INPUT temp-obj.obj-code,
     2652                           INPUT dTemp,
     2653                           INPUT sOutFile,
     2654                           INPUT sLogFile,
     2655                           INPUT hEDT,
     2656                           INPUT hCNT).
     2657       END.
     2658     END.
     2659   END.
     2660   RUN wp-XMLHideCNT(hCNT).
     2661   OUTPUT STREAM stmXMLOut TO VALUE(sOutFile + "xm1") CONVERT TARGET "1251" APPEND.
     2662   RUN wp-XMLTagClose(1, "body").
     2663   RUN wp-XMLTagClose(0, "IBS_Trade_House").
     2664   OUTPUT STREAM stmXMLOut CLOSE.
     2665   run bge/os_copy.p ("M", sOutFile + "xm1", sOutFile + "xml", OUTPUT ErrorLevel).
     2666   IF ErrorLevel > 0 THEN RETURN "ERROR".
     2667   IF OPSYS = "UNIX" THEN OS-COMMAND SILENT
     2668    chmod 666 value (sOutFile + "xml") 2>/dev/null.
     2669   RETURN.
     2670   PROCEDURE XMLWriteHeaderCat:
     2671   PUT STREAM stmXMLOut UNFORMATTED "<?xml version='1.0' encoding='windows-1251'?>".
     2672   PUT STREAM stmXMLOut UNFORMATTED chr(10) +
     2673                     '<IBS_Trade_House>'.
     2674   RUN wp-XMLTagOpen(1, "header","").
     2675   RUN wp-XMLTagOpen(2, "delivery","").
     2676   RUN wp-XMLTagOpen(3, "message","").
     2677   RUN wp-XMLTagPut(4, "messageID","", 0).
     2678   RUN wp-XMLTagPut(4, "sent","", 0).
     2679   RUN wp-XMLTagClose(3, "message").
     2680   RUN wp-XMLTagOpen(3, "to","").
     2681   RUN wp-XMLTagClose(3, "to").
     2682   RUN wp-XMLTagOpen(3, "from","").
     2683   RUN wp-XMLTagClose(3, "from").
     2684   RUN wp-XMLTagClose(2, "delivery").
     2685   RUN wp-XMLTagOpen(2, "manifest","").
     2686   RUN wp-XMLTagOpen(3, "document","").
     2687   RUN wp-XMLTagPut(4, "name","kass", 0).
     2688   RUN wp-XMLTagPut(4, "description","", 0).
     2689   RUN wp-XMLTagClose(3, "document").
     2690   RUN wp-XMLTagClose(2, "manifest").
     2691   RUN wp-XMLTagClose(1, "header").
     2692   RUN wp-XMLTagOpen(1, "body","").
     2693   END PROCEDURE.
