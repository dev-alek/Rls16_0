        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter dFrom                as date             no-undo.
        4   define input parameter dTo                  as date             no-undo.
        5   define input parameter hEDT                 as handle           no-undo.
        6   define input parameter hCNT                 as handle           no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: bge-kass.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: bge/bge-kass.p $":U .
       12   define variable vss-description as character no-undo init "Экспорт во Внешнюю Бухгалтерию суммарного расхода по чекам".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define  temp-table temp-host no-undo
       75     field host-code like ub.store.host-code
       76     index xpk host-code
       77   .
       78   define  temp-table temp-obj no-undo
       79     field obj-type  like ub.clients.obj-type
       80     field obj-code  like ub.clients.obj-code
       81     field host-code like ub.store.host-code
       82     field db-num    like ub.clients.db-num
       83     index xpk  obj-type obj-code
       84     index xie1 host-code
       85     index xie2 db-num host-code
       86   .
       87   procedure init-temphost:
       88     define buffer buf_store   for ub.store .
       89     define buffer buf_shop    for ub.shop .
       90     define buffer buf_clients for ub.clients .
       91     define buffer buf_db for ub.db .
       92     define buffer buf_temp-host for temp-host .
       93     define buffer buf_temp-obj for temp-obj .
       94     do
       95     on error undo, return error return-value
       96     :
       97       for each buf_store
       98       on error undo, return error
       99       :
      100         find first buf_temp-host
      101           where buf_temp-host.host-code = buf_store.host-code
      102           no-error .
      103         if not available buf_temp-host
      104         then do:
      105           create buf_temp-host .
      106           assign
      107             buf_temp-host.host-code = buf_store.host-code
      108           .
      109         end.
      110         find first buf_clients no-lock
      111           where buf_clients.obj-type = 'скл':U
      112             and buf_clients.obj-code = buf_store.obj-code
      113           no-error .
      114         if not available buf_clients
      115         then do:
      116           message
      117             "Ошибка при поиске клиента" skip
      118             "Клиент" 'скл':U buf_store.obj-code skip
      119             view-as alert-box error .
      120           undo, return error .
      121         end.
      122         create buf_temp-obj .
      123         assign
      124           buf_temp-obj.obj-type  = 'скл':U
      125           buf_temp-obj.obj-code  = buf_store.obj-code
      126           buf_temp-obj.host-code = buf_store.host-code
      127           buf_temp-obj.db-num    = buf_clients.db-num
      128         .
      129       end.
      130       for each buf_shop
      131       on error undo, return error
      132       :
      133         find first buf_temp-host
      134           where buf_temp-host.host-code = buf_shop.host-code
      135           no-error .
      136         if not available buf_temp-host
      137         then do:
      138           create buf_temp-host .
      139           assign
      140             buf_temp-host.host-code = buf_shop.host-code
      141           .
      142         end.
      143         find first buf_clients no-lock
      144           where buf_clients.obj-type = 'маг':U
      145             and buf_clients.obj-code = buf_shop.obj-code
      146           no-error .
      147         if not available buf_clients then do:
      148           message
      149             "Ошибка при поиске клиента" skip
      150             "Клиент" 'маг':U buf_shop.obj-code skip
      151             view-as alert-box error .
      152           undo, return error .
      153         end.
      154         create buf_temp-obj .
      155         assign
      156           buf_temp-obj.obj-type  = 'маг':U
      157           buf_temp-obj.obj-code  = buf_shop.obj-code
      158           buf_temp-obj.host-code = buf_shop.host-code
      159           buf_temp-obj.db-num    = buf_clients.db-num
      160         .
      161       end.
      162     end.
      163   end.
      164   define variable vss-include-info1 as character format "X(65)" no-undo
      165   initial "@(#)$Workfile$ $Revision$".
      166   DEF STREAM stmXMLOut.
      167   DEF STREAM stmXMLLog.
      168   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   procedure cur-time :
      170      define output parameter p-today as date      no-undo .
      171      define output parameter p-time  as integer   no-undo .
      172     do
      173     on error undo, return error
      174     :
      175       define variable v-date1 as date      no-undo .
      176       define variable v-date2 as date      no-undo .
      177       define variable v-time  as integer   no-undo .
      178       assign
      179         v-date1 = today
      180         v-time  = time
      181         v-date2 = today
      182       .
      183       if v-date1 <> v-date2
      184       then do:
      185         assign
      186           v-date1 = today
      187           v-time  = v-time
      188         .
      189       end.
      190       assign
      191         p-today = v-date1
      192         p-time  = v-time
      193       .
      194     end.
      195   end.
      196   function cur-time-date returns character
      197   :
      198     return string(today, '99/99/9999':U) .
      199   end.
      200   function cur-time-mjd returns decimal
      201   :
      202     define variable v-date as date      no-undo .
      203     define variable v-time as integer   no-undo .
      204     run cur-time in this-procedure
      205       (output v-date
      206       ,output v-time
      207       ) .
      208     return integer(v-date) - 2400002 + (v-time / 86400) .
      209   end.
      210   function cur-time-get-ending-index returns integer
      211   (input p-number as integer
      212   )
      213   :
      214     if p-number < 0
      215     or p-number = ?
      216     then do:
      217       return 1 .
      218     end.
      219     define variable v-rest as integer   no-undo .
      220     assign
      221       p-number = p-number modulo 100
      222     .
      223     if p-number < 20
      224     then do:
      225       assign
      226         v-rest = p-number
      227       .
      228     end.
      229     else do:
      230       assign
      231         v-rest = p-number modulo 10
      232       .
      233     end.
      234     case v-rest :
      235       when 1
      236       then do:
      237         return 2 .
      238       end.
      239       when 2 or
      240       when 3 or
      241       when 4
      242       then do:
      243         return 3 .
      244       end.
      245       otherwise do:
      246         return 1 .
      247       end.
      248     end case .
      249   end.
      250   procedure cur-time-mjd-to-date :
      251      define input  parameter i-mjd-diff as decimal no-undo.
      252      define output parameter o-Date     as date    no-undo.
      253      define output parameter o-Time     as integer no-undo.
      254      define variable v-day-number as integer   no-undo .
      255      if    i-mjd-diff < 0
      256         or i-mjd-diff = ?
      257      then do:
      258         return "?" .
      259      end.
      260      assign
      261         v-day-number = truncate(i-mjd-diff,0).
      262         o-Date = date(v-day-number + 2400002).
      263         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      264     .
      265   end.
      266   function cur-time-mjd-to-string returns character
      267   (input p-mjd-diff as decimal
      268   )
      269   :
      270     define variable v-day-number as integer   no-undo .
      271     define variable v-seconds    as integer   no-undo .
      272     define variable v-hour       as integer   no-undo .
      273     define variable v-min        as integer   no-undo .
      274     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      275     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      276     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      277     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      278     if p-mjd-diff < 0
      279     or p-mjd-diff = ?
      280     then do:
      281       return "?" .
      282     end.
      283     assign
      284       v-day-number = integer(truncate(p-mjd-diff,0))
      285       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      286     .
      287     if v-seconds > 86400
      288     then do:
      289       assign
      290         v-seconds = 86400 - 1
      291       .
      292     end.
      293     if v-seconds < 0
      294     then do:
      295       assign
      296         v-seconds = 0
      297       .
      298     end.
      299     assign
      300       v-hour = truncate(v-seconds / 3600, 0)
      301     .
      302     assign
      303       v-seconds = v-seconds modulo 3600
      304     .
      305     assign
      306       v-min = truncate(v-seconds / 60, 0)
      307     .
      308     assign
      309       v-seconds = v-seconds modulo 60
      310     .
      311     return
      312         (if v-day-number <> 0
      313           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      314           else ""
      315         )
      316       + (if v-day-number <> 0 or v-hour <> 0
      317           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      318           else ""
      319         )
      320       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      321           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      322           else ""
      323         )
      324       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      325       .
      326   end.
      327   function cur-time-string returns character
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      336   end.
      337   function cur-time-string-sec returns character
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      346   end.
      347   function cur-time-custom  returns character
      348   (input p-prefix as character
      349   ,input p-date-format as character
      350   ,input p-delimiter as character
      351   ,input p-time-format as character
      352   ,input p-suffix as character
      353   )
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return
      362       p-prefix
      363       + string(v-date, p-date-format)
      364       + p-delimiter
      365       + string(v-time, p-time-format)
      366       + p-suffix
      367       .
      368   end.
      369   function cur-time-print  returns character
      370   :
      371     define variable v-date as date      no-undo .
      372     define variable v-time as integer   no-undo .
      373     run cur-time in this-procedure
      374       (output v-date
      375       ,output v-time
      376       ) .
      377     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      378   end.
      379   function cur-time-datetime returns datetime
      380   :
      381     define variable v-char as character no-undo .
      382     define variable v-datetime as datetime no-undo .
      383     v-char = cur-time-string().
      384     v-datetime = datetime(v-char).
      385     return  v-datetime.
      386   end.
      387   function cur-time-string-msec returns character
      388   :
      389     define variable v-date as datetime  no-undo .
      390     v-date = now.
      391     return string(v-date) .
      392   end.
      393   define variable vss-include-info3 as character format "X(65)" no-undo
      394   initial "@(#)$Workfile$ $Revision$".
      395   procedure xmlchar-test :
      396   define input parameter p-in-string          as character        no-undo.
      397   define output parameter p-out-string-enc    as character        no-undo.
      398   define output parameter p-out-string-dec    as character        no-undo.
      399   do
      400   on error undo, return error
      401   :
      402          run xmlchar-encode in this-procedure
      403       (
      404             input p-in-string
      405           , output p-out-string-enc
      406       ).
      407          run xmlchar-decode in this-procedure
      408       (
      409             input p-out-string-enc
      410           , output p-out-string-dec
      411       ).
      412   end.
      413   end .
      414   procedure xmlchar-encode :
      415   define input parameter p-in-string      as character        no-undo.
      416   define output parameter p-out-string    as character        no-undo.
      417       define variable v-position      as integer      no-undo.
      418       define variable v-current-char  as character    no-undo.
      419   do
      420   on error undo, return error
      421   :
      422       assign
      423           p-out-string = "":U
      424       .
      425       case p-in-string
      426       :
      427           when ?
      428           then do:
      429               assign
      430                   p-out-string = "?":U
      431               .
      432           end.
      433           when "?":U
      434           then do:
      435               assign
      436                   p-out-string = "&#63;":U
      437               .
      438           end.
      439           otherwise do:
      440               do v-position = 1 to length( p-in-string )
      441               :
      442                   assign
      443                       v-current-char = substring( p-in-string, v-position, 1 )
      444                   .
      445                   case v-current-char
      446                   :
      447                       when "&":U
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "&amp;":U
      451                           .
      452                       end.
      453                       when ">":U
      454                       then do:
      455                           assign
      456                               p-out-string = p-out-string + "&gt;":U
      457                           .
      458                       end.
      459                       when "<":U
      460                       then do:
      461                           assign
      462                               p-out-string = p-out-string + "&lt;":U
      463                           .
      464                       end.
      465                       when "'":U
      466                       then do:
      467                           assign
      468                               p-out-string = p-out-string + "&apos;":U
      469                           .
      470                       end.
      471                       when '"':U
      472                       then do:
      473                           assign
      474                               p-out-string = p-out-string + "&quot;":U
      475                           .
      476                       end.
      477                       when chr(1)
      478                       then do:
      479                           assign
      480                               p-out-string = p-out-string + "":U
      481                           .
      482                       end.
      483                       when chr(2)
      484                       then do:
      485                           assign
      486                               p-out-string = p-out-string + "":U
      487                           .
      488                       end.
      489                       when chr(3)
      490                       then do:
      491                           assign
      492                               p-out-string = p-out-string + "":U
      493                           .
      494                       end.
      495                       when chr(4)
      496                       then do:
      497                           assign
      498                               p-out-string = p-out-string + "":U
      499                           .
      500                       end.
      501                       when chr(5)
      502                       then do:
      503                           assign
      504                               p-out-string = p-out-string + "":U
      505                           .
      506                       end.
      507                       when chr(6)
      508                       then do:
      509                           assign
      510                               p-out-string = p-out-string + "":U
      511                           .
      512                       end.
      513                       when chr(7)
      514                       then do:
      515                           assign
      516                               p-out-string = p-out-string + "":U
      517                           .
      518                       end.
      519                       when chr(8)
      520                       then do:
      521                           assign
      522                               p-out-string = p-out-string + "":U
      523                           .
      524                       end.
      525                       when chr(9)
      526                       then do:
      527                           assign
      528                               p-out-string = p-out-string + "":U
      529                           .
      530                       end.
      531                       when chr(29)
      532                       then do:
      533                           assign
      534                               p-out-string = p-out-string + "":U
      535                           .
      536                       end.
      537                       when chr(10)
      538                       then do:
      539                           assign
      540                               p-out-string = p-out-string + "&#10;":U
      541                           .
      542                       end.
      543                       when chr(13)
      544                       then do:
      545                           assign
      546                               p-out-string = p-out-string + "&#13;":U
      547                           .
      548                       end.
      549                       otherwise do:
      550                           assign
      551                               p-out-string = p-out-string + v-current-char
      552                           .
      553                       end.
      554                   end case.
      555               end.
      556           end.
      557       end case.
      558   end.
      559   end .
      560   procedure xmlchar-encode-1c :
