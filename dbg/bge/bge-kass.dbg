      655                           assign
      656                               p-out-string = p-out-string + " ":U
      657                           .
      658                       end.
      659                       otherwise do:
      660                           assign
      661                               p-out-string = p-out-string + v-current-char
      662                           .
      663                       end.
      664                   end case.
      665               end.
      666           end.
      667       end case.
      668   end.
      669   end .
      670   procedure xmlchar-decode :
      671   define input parameter p-in-string      as character        no-undo.
      672   define output parameter p-out-string    as character        no-undo.
      673       define variable v-position      as integer      no-undo.
      674       define variable v-last-position as integer      no-undo.
      675       define variable v-temp-integer  as integer      no-undo.
      676       define variable v-current-char  as character    no-undo.
      677       define variable v-next-char     as character    no-undo.
      678       define variable v-success       as logical      no-undo.
      679   do
      680   on error undo, return error
      681   :
      682       assign
      683           p-out-string = "":U
      684           v-position   = 0
      685       .
      686       replace-cycle:
      687       do while yes
      688       on error undo, return error
      689       :
      690           assign
      691               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      692           .
      693           if v-last-position <= v-position
      694           then do:
      695               if v-position = 0
      696               then do:
      697                   assign
      698                       p-out-string = p-in-string
      699                   .
      700               end.
      701               else do:
      702                   assign
      703                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      704                   .
      705               end.
      706               leave replace-cycle.
      707           end.
      708           else do:
      709               assign
      710                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      711                   v-position      = v-last-position
      712                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      713               .
      714               if v-current-char = "#":U
      715               then do:
      716                   assign
      717                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      718                   .
      719                   if v-last-position > 0
      720                   then do:
      721                       run xmlchar-read-integer in this-procedure
      722                        (
      723                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      724                           , output v-temp-integer
      725                           , output v-success
      726                       ).
      727                       if v-success = yes
      728                       and v-temp-integer >= 1
      729                       and v-temp-integer <= 255
      730                       then do:
      731                           assign
      732                               p-out-string = p-out-string + chr( v-temp-integer )
      733                               v-position   = v-last-position + 1
      734                           .
      735                       end.
      736                       else do:
      737                           assign
      738                               p-out-string = p-out-string + "&":U
      739                               v-position   = v-position   + 1
      740                           .
      741                       end.
      742                   end.
      743                   else do:
      744                       assign
      745                           p-out-string = p-out-string + "&":U
      746                           v-position   = v-position   + 1
      747                       .
      748                   end.
      749               end.
      750               else do:
      751                   case substring( p-in-string, v-position + 1, 3 )
      752                   :
      753                       when "lt;":U
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + "<":U
      757                               v-position   = v-position   + 3
      758                           .
      759                       end.
      760                       when "gt;":U
      761                       then do:
      762                           assign
      763                               p-out-string = p-out-string + ">":U
      764                               v-position   = v-position   + 3
      765                           .
      766                       end.
      767                       otherwise do:
      768                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      769                           then do:
      770                               assign
      771                                   p-out-string = p-out-string + "&":U
      772                                   v-position   = v-position   + 4
      773                               .
      774                           end.
      775                           else do:
      776                               case substring( p-in-string, v-position + 1, 5 )
      777                               :
      778                                   when "quot;":U
      779                                   then do:
      780                                       assign
      781                                           p-out-string = p-out-string + '"':U
      782                                           v-position   = v-position   + 5
      783                                       .
      784                                   end.
      785                                   when "apos;":U
      786                                   then do:
      787                                       assign
      788                                           p-out-string = p-out-string + "'":U
      789                                           v-position   = v-position   + 5
      790                                       .
      791                                   end.
      792                                   otherwise do:
      793                                       assign
      794                                           p-out-string = p-out-string + "&":U
      795                                       .
      796                                   end.
      797                               end case.
      798                           end.
      799                       end.
      800                   end case.
      801               end.
      802           end.
      803       end.
      804   end.
      805   end .
      806   procedure xmlchar-read-integer :
      807   define input parameter p-input-string      as character        no-undo.
      808   define output parameter p-output-integer   as integer          no-undo.
      809   define output parameter p-success       as logical          no-undo.
      810   do
      811   on error undo, return error
      812   :
      813       assign
      814           p-output-integer = integer( p-input-string )
      815       no-error.
      816       if error-status :error
      817       then do:
      818           assign
      819               p-success           = no
      820               p-output-integer    = 0
      821           .
      822       end.
      823       else do:
      824           assign
      825               p-success           = yes
      826           .
      827       end.
      828   end.
      829   end.
      830   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   procedure strtdate :
      832     define input  parameter p-str         as character no-undo .
      833     define output parameter p-value       as date      no-undo .
      834     define output parameter p-data-valid  as logical   no-undo .
      835     define output parameter p-message     as character no-undo .
      836   do
      837   on error undo, return error return-value
      838   :
      839     define variable v-value       as date      no-undo .
      840     define variable v-i           as integer   no-undo .
      841     define variable v-num         as integer   no-undo .
      842     define variable v-delim       as character no-undo .
      843     define variable v-delim-list  as character no-undo .
      844     define variable v-day         as integer   no-undo .
      845     define variable v-month       as integer   no-undo .
      846     define variable v-year        as integer   no-undo .
      847     define variable v-day-str     as character no-undo .
      848     define variable v-month-str   as character no-undo .
      849     define variable v-year-str    as character no-undo .
      850     assign
      851       p-value       = ?
      852       p-data-valid  = false
      853     .
      854     if p-str = ?
      855     then do:
      856       assign
      857         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      858       .
      859       return .
      860     end.
      861     if p-str = ""
      862     then do:
      863       assign
      864         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      865       .
      866       return .
      867     end.
      868     if length(p-str)  > 10
      869     then do:
      870       assign
      871         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      872       .
      873       return .
      874     end.
      875     assign
      876       v-delim-list = '/,-,.':U
      877     .
      878     _delim:
      879     do v-i = 1 to num-entries( v-delim-list )
      880     :
      881       assign
      882         v-delim = entry( v-i , v-delim-list )
      883         v-num   = num-entries( p-str , v-delim )
      884       .
      885       if v-num <> 3
      886       then do:
      887         assign
      888           v-delim = ''
      889         .
      890       end.
      891       else do:
      892         leave _delim.
      893       end.
      894     end.
      895     if v-delim = ''
      896     then do:
      897       assign
      898         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      899       .
      900       return .
      901     end.
      902     assign
      903       v-day-str   = entry( 1, p-str , v-delim)
      904       v-month-str = entry( 2, p-str , v-delim)
      905       v-year-str  = entry( 3, p-str , v-delim)
      906     .
      907     if  length(v-day-str) > 2   or
      908         length(v-day-str) < 1   or
      909         length(v-month-str) > 2 or
      910         length(v-month-str) < 1 or
      911         (
      912           length(v-year-str) <> 2 and
      913           length(v-year-str) <> 4
      914         )
      915     then do:
      916       assign
      917         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      918       .
      919       return .
      920     end.
      921     if length( v-year-str ) = 2
      922     then do:
      923       assign
      924         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      925       .
      926     end.
      927     assign
      928       v-day   = integer( v-day-str )
      929       v-month = integer( v-month-str)
      930       v-year  = integer( v-year-str)
      931     no-error .
      932     if error-status :error
      933     then do:
      934       assign
      935         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      936       .
      937       return .
      938     end.
      939     if v-day < 1  or
      940        v-day > 31 or
      941        v-month < 1 or
      942        v-month > 12 or
      943        v-year < 0   or
      944        v-year > 5000
      945     then do:
      946       assign
      947         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      948       .
      949       return .
      950     end.
      951     assign
      952       v-value = date( v-month, v-day, v-year )
      953     no-error .
      954     if error-status :error
      955     then do:
      956       assign
      957         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      958       .
      959       return .
      960     end.
      961     assign
      962       p-value       = v-value
      963       p-data-valid  = true
      964     .
      965   end.
      966   end procedure.
      967   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      968   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      969   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
      970   define variable v-bge-xml-bgeflold      as character         no-undo.
      971   define variable v-bge-xml-bgefmt        as character         no-undo.
      972   define variable v-bge-xml-shift-mode    as logical           no-undo.
      973   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      974   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      975   define variable v-bge-xml-log-file-name as character    no-undo.
      976   define variable v-bge-xml-dbf-file-name as character    no-undo.
      977   define variable v-bge-xml-db-num-str    as character    no-undo .
      978   define variable v-bge-xml-static-log-file-name as character    no-undo.
      979   define temp-table temp_ext-doc-type no-undo
