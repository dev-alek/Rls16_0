        1   DEF INPUT  PARAM strB AS CHAR.
        2   DEF OUTPUT PARAM strQuest   AS CHAR INIT "CANCEL".
        3   DEF OUTPUT PARAM strDIR     AS CHAR INIT "".
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Инициализация каталога BGE 2".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   def var dir-type as char no-undo.
       65   def var can-write as logical no-undo.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   DEF VAR strParentDir    AS CHARACTER NO-UNDO.
      127   DEF VAR OKpressed       AS LOGICAL INITIAL TRUE NO-UNDO.
      128   DEF VAR intCount        AS INT NO-UNDO.
      129   DEF VAR strForEd2  AS CHAR NO-UNDO.
      130   DEFINE BUTTON b-help
      131        LABEL "Помо&щь"
      132        SIZE 10 BY 1.
      133   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      134        LABEL "&Отмена"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON Btn_OK AUTO-GO
      138        LABEL "OK"
      139        SIZE 10 BY 1 TOOLTIP "Подтверждение выбора каталога"
      140        BGCOLOR 8 .
      141   DEFINE BUTTON bt_DIR
      142        LABEL "Каталог"
      143        SIZE 10 BY 1 TOOLTIP "Выбрать каталог".
      144   DEFINE VARIABLE EDITOR-2 AS CHARACTER
      145        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      146        SIZE 34.75 BY 8.5
      147        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
      148   DEFINE IMAGE IMAGE-1
      149        FILENAME "wizdone":U
      150        SIZE 25.5 BY 8.
      151   DEFINE FRAME Dialog-Frame
      152        Btn_OK AT ROW 1.25 COL 1.5
      153        Btn_Cancel AT ROW 1.25 COL 11.5
      154        bt_DIR AT ROW 1.25 COL 21.5
      155        b-help AT ROW 1.25 COL 54
      156        EDITOR-2 AT ROW 3 COL 29.5 NO-LABEL
      157        IMAGE-1 AT ROW 3 COL 1
      158        SPACE(38.62) SKIP(0.95)
      159       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      160            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      161            TITLE "Установка каталога для внешней бухгалтерии"
      162            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      163   ASSIGN
      164          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      165          FRAME Dialog-Frame:HIDDEN           = TRUE.
      166   ASSIGN
      167          EDITOR-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      173   DO:
      174     RUN existDIR (strDir, "frg-acc", OUTPUT okPressed).
      175     IF NOT okPressed THEN DO.
      176       DISABLE EDITOR-2 WITH FRAME DIALOG-FRAME.
      177     END.
      178     RUN existDIR (strDir + "\frg-acc", "dict", OUTPUT okPressed).
      179     IF NOT okPressed THEN DO.
      180       DISABLE EDITOR-2 WITH FRAME DIALOG-FRAME.
      181     END.
      182     RUN existDIR (strDir + "\frg-acc", "exp-acc", OUTPUT okPressed).
      183     IF NOT okPressed THEN DO.
      184       DISABLE EDITOR-2 WITH FRAME DIALOG-FRAME.
      185     END.
      186     RUN existDIR (strDir + "\frg-acc", "global", OUTPUT okPressed).
      187     IF NOT okPressed THEN DO.
      188       DISABLE EDITOR-2 WITH FRAME DIALOG-FRAME.
      189     END.
      190     ASSIGN
      191       strQuest = "OK".
      192   END.
      193   ON CHOOSE OF bt_DIR IN FRAME Dialog-Frame
      194   DO:
      195       IF SESSION:DISPLAY-TYPE = "GUI":U
      196       THEN do:
      197           run gbl/dir-sel.p (
      198                           output strParentDir
      199                         , output dir-type
      200                         , output can-write
      201                               )
      202           .
      203           if can-write then OKpressed = true. else OKpressed = false.
      204       end.
      205       else do:
      206           update
      207               SKIP(2)
      208               SPACE(2) "Имя родительского каталога =" strParentDir SPACE(2)
      209               SKIP(2)
      210           with frame tty-frame
      211               view-as dialog-box no-labels
      212               title "Введите имя и нажмите <ENTER>"
      213           .
      214           message "Подтверждаете имя родительского каталога?" SKIP
      215               strParentDir
      216           view-as alert-box buttons ok-cancel update OKpressed.
      217       end.
      218       IF OKpressed = TRUE THEN DO.
      219               strDIR = strParentDir.
      220               IF strB = "bge" THEN
      221               EDITOR-2 = strForEd2 + chr(10) + chr(10) +
      222                       " Экспорт будет вестись в" + chr(10) +
      223                       " каталог " + strDIR + "\frg-acc"+ chr(10) +
      224                       " Подтверждение - кнопка <OK>," + chr(10) +
      225                       " отказ - кнопка <Отмена>".
      226               ELSE
      227               EDITOR-2 = strForEd2 + chr(10) + chr(10) +
      228                       " Фильтр будет храниться в" + chr(10) +
      229                       " каталоге " + strDIR + "\frg-acc" + chr(10) +
      230                       " Подтверждение - кнопка <OK>," + chr(10) +
      231                       " отказ - кнопка <Отмена>".
      232               DISPLAY EDITOR-2 WITH FRAME Dialog-Frame.
      233               ENABLE  btn_OK   WITH FRAME Dialog-Frame.
      234       END.
      235       ELSE DO.
      236           ASSIGN
      237               EDITOR-2 = strForEd2
      238               strDIR   = "".
      239           DISPLAY EDITOR-2 WITH FRAME Dialog-Frame.
      240           DISABLE btn_OK   WITH FRAME Dialog-Frame.
      241       END.
      242   END.
      243   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      244   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      245   ASSIGN
      246     strForEd2 = IF strB = "bge" THEN
      247       " Кнопкой <Каталог> выберите" + chr(10) +
      248       " родительский каталог," + chr(10) +
      249       " в котором следует создать" + chr(10) +
      250       " каталог хранения экспортных" + chr(10) +
      251       " сумм и справочников (frg-acc)."
      252                 ELSE
      253       " Кнопкой <Каталог> выберите" + chr(10) +
      254       " родительский каталог," + chr(10) +
      255       " в котором следует создать" + chr(10) +
      256       " каталог хранения фильтра для" + chr(10) +
      257       " документов IBS Trade (frg-acc)."
      258     FRAME Dialog-Frame:TITLE =  IF strB = "bge" THEN
      259       "Установка каталога для внешней бухгалтерии"
      260                 ELSE
      261       "Установка каталога для хранения фильтра"
      262     EDITOR-2 = strForEd2
      263   .
      264   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   on help of frame Dialog-Frame
      266   do:
      267     run gbl/app_help.p
      268       (input this-procedure :file-name
      269       ,input ''
      270       ,input ?
      271       ) no-error.
      272     if error-status :error then do:
      273       message
      274         "Ошибка при вызове помощи"
      275         error-status :get-message(1)
      276         view-as alert-box .
      277     end.
      278   end.
      279   run minbtn-set in this-procedure .
      280   on choose of b-help in frame Dialog-Frame
      281   do:
      282     apply "help":u to frame Dialog-Frame .
      283   end.
      284   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      285   procedure minbtn-set :
      286       do
      287           on error undo, return error return-value
      288           :
      289           define variable ii              as integer       no-undo .
      290           define variable fh              as widget-handle no-undo .
      291           define variable hh              as widget-handle no-undo .
      292           define variable v-h             as handle        extent 4 no-undo .
      293           define variable v-name-button   as character     no-undo .
      294           define variable v-help-old-x    as decimal       no-undo .
      295           define variable v-help-old-y    as decimal       no-undo .
      296           define variable v-help-old-size as decimal       no-undo .
      297           define variable v-frame-width   as decimal       no-undo .
      298           define variable jj              as integer       no-undo .
      299           do
      300               on error undo, return error
      301               :
      302               assign
      303                   v-frame-width = frame Dialog-Frame:width - 0.3
      304                   fh            = frame Dialog-Frame:first-child
      305                   hh            = fh:first-child
      306                   ii            = 1
      307                   .
      308               do while valid-handle(hh):
      309                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      310                   do:
      311                       case lc(hh:name) :
      312                           when "b-help" then
      313                               do:
      314                                   hh:load-image-up("cmp/b-help.bmp":u) .
      315                                   hh:load-image-down("cmp/b-help.bmp":u) .
      316                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      317                                   hh:TOOLTIP = "Помощь" .
      318                                   v-help-old-x = hh:column .
      319                                   v-help-old-y = hh:row    .
      320                                   v-help-old-size = hh:width .
      321                                   hh:width-chars = 2.5 .
      322                               end.
      323                           when "b-print" then
      324                               do:
      325                                   hh:load-image("cmp/b-print.bmp":u) .
      326                                   hh:TOOLTIP = "Печать" .
      327                                   v-h[ii] = hh:handle .
      328                                   ii = ii + 1 .
      329                                   hh:width-chars = 3 .
      330                               end.
      331                           when "b-history" or
      332                           when "b-hist" then
      333                               do:
      334                                   hh:load-image("cmp/b-hist.bmp":u) .
      335                                   hh:TOOLTIP = "История" .
      336                                   v-h[ii] = hh:handle .
      337                                   ii = ii + 1 .
      338                                   hh:width-chars = 3 .
      339                               end.
      340                           when "b-sch" then
      341                               do:
      342                                   hh:load-image("cmp/b-sch.bmp":u) .
      343                                   hh:TOOLTIP = "Установка Фильтра" .
      344                                   v-h[ii] = hh:handle .
      345                                   ii = ii + 1 .
      346                                   hh:width-chars = 3 .
      347                               end.
      348                           when "b-hist-user" then
      349                               do:
      350                                   hh:load-image("cmp/b-hist.bmp":u) .
      351                                   hh:TOOLTIP = "История пользователя" .
      352                                   ii = ii + 1 .
      353                               end.
      354                       end case.
      355                   end.
      356                   hh = hh:next-sibling.
      357               end.
      358               b-help:column = v-frame-width - b-help:width-chars.
      359               jj = 0.
      360               repeat ii = 4 to 1 by -1 :
      361                   if valid-handle (v-h[ii] ) then
      362                   do:
      363                       jj  = jj + 1 .
      364                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      365                       v-h[ii]:row    = v-help-old-y .
      366                   end.
      367               end.
      368           end.
      369       end.
      370   end procedure.
      371   MAIN-BLOCK:
      372   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      373      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      374     RUN enable_UI.
      375     WAIT-FOR GO OF FRAME Dialog-Frame.
      376   END.
      377   RUN disable_UI.
      378   PROCEDURE disable_UI :
      379     HIDE FRAME Dialog-Frame.
      380   END PROCEDURE.
      381   PROCEDURE enable_UI :
      382     DISPLAY EDITOR-2
      383         WITH FRAME Dialog-Frame.
      384     ENABLE Btn_Cancel bt_DIR b-help EDITOR-2
      385         WITH FRAME Dialog-Frame.
      386     VIEW FRAME Dialog-Frame.
      387   END PROCEDURE.
      388   PROCEDURE existDIR :
      389   DEF INPUT  PARAM strParentDir AS CHAR.
      390   DEF INPUT  PARAM strNameDir   AS CHAR.
      391   DEF OUTPUT PARAM bolDirExist  AS LOG INIT NO NO-UNDO.
      392   DEF VAR strDirMembShortName  AS CHAR NO-UNDO.
      393   DEF VAR strDirMembFullName   AS CHAR NO-UNDO.
      394   DEF VAR strDirMembFlag       AS CHAR NO-UNDO.
      395   DEF VAR intErrorStatus       AS INT INIT 0  NO-UNDO.
      396   DEF VAR bolDirCreated        AS LOG INIT NO NO-UNDO.
      397   DEF VAR strErrorStatus AS CHAR EXTENT 18 INIT [
      398       "Not owner",
      399       "No such file or directory",
      400       "Interrupted system call",
      401       "I/O error",
      402       "Bad file number",
      403       "No more processes",
      404       "Not enough core memory",
      405       "Permission denied",
      406       "Bad address",
      407       "File exists",
      408       "No such device",
      409       "Not a directory",
      410       "Is a directory",
      411       "File table overflow",
      412       "Too many open files",
      413       "File too large",
      414       "No space left on device",
      415       "Directory not empty"
      416   ] NO-UNDO.
      417       INPUT FROM OS-DIR (strParentDir).
      418       REPEAT.
      419           IMPORT strDirMembShortName strDirMembFullName strDirMembFLag.
      420           IF  CAPS(strDirMembShortName) = CAPS(strNameDir) AND
      421               CAPS(strDirMembFLag) = "D"
      422           THEN DO. bolDirExist = YES. LEAVE. END.
      423           ELSE NEXT.
      424       END.
      425       INPUT CLOSE.
      426       IF bolDirExist THEN RETURN.
      427       OS-CREATE-DIR value(strParentDir + "\" + strNameDir).
      428       if OS-ERROR > 0 then do:
      429               MESSAGE " Не могу создать каталог " +
      430                        strParentDir + "\" + strNameDir
      431               view-as alert-box title " Ошибка ".
      432           IF OS-ERROR <> 999 THEN DO.
      433               ASSIGN
      434                   intErrorStatus = OS-ERROR
      435                   EDITOR-2 = strForEd2 + "~012~012" +
      436                              " Ошибка создания каталога" + "~012 " +
      437                              strParentDir + "\" + strNameDir + "~012 " +
      438                              STRING(intErrorStatus, ">9") + " " +
      439                              strErrorStatus[intErrorStatus].
      440               DISPLAY EDITOR-2 WITH FRAME Dialog-Frame.
      441           END.
      442           return "ERROR".
      443       end.
      444   END PROCEDURE.
