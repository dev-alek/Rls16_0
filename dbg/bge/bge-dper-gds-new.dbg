     1219       field corr-user-db-num as integer
     1220       field chip-num as integer
     1221       index pi is primary unique
     1222           host-code
     1223           fin-doc-code
     1224           corr-user-db-num
     1225           chip-num
     1226   .
     1227   define temp-table temp_fin-ob no-undo
     1228       field host-code as integer
     1229       field fin-doc-code as character
     1230       index pi is primary unique
     1231           host-code
     1232           fin-doc-code
     1233   .
     1234   define temp-table temp_del-fin-ob no-undo
     1235       field host-code as integer
     1236       field fin-doc-code as character
     1237       field corr-user-db-num as integer
     1238       field chip-num as integer
     1239       index pi is primary unique
     1240           host-code
     1241           fin-doc-code
     1242           corr-user-db-num
     1243           chip-num
     1244   .
     1245   define temp-table temp_ord-doc-code no-undo
     1246     field doc-code as character
     1247   index pi is primary unique
     1248     doc-code
     1249   .
     1250   define temp-table tt-bge-xml-bgecliiv no-undo
     1251     field obj-type  like ub.clients.obj-type
     1252     field obj-code  like ub.clients.obj-code
     1253   index pi is primary unique
     1254     obj-type
     1255     obj-code
     1256   .
     1257   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1258                                             INPUT iFlagEmpty AS INTEGER).
     1259       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1260       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1261           DO:
     1262               IF iFlagEmpty = 0                           THEN RETURN "".
     1263               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1264               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1265               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1266               ELSE RETURN "".
     1267           END.
     1268       ELSE DO:
     1269           run xmlchar-encode in this-procedure (
     1270                 input sToPlace
     1271               , output sToPlace
     1272           ).
     1273           ASSIGN
     1274               sToPlace = sParName + '="' + sToPlace + '"'
     1275           .
     1276           RETURN sToPlace.
     1277       END.
     1278   END FUNCTION.
     1279   function bge-xml-date returns character
     1280   ( input p-date as date )
     1281   :
     1282     define variable v-date-str as character no-undo .
     1283     run bge-xml-date-to-str in this-procedure ( input   p-date
     1284                                               , output  v-date-str
     1285                                               ) .
     1286     return v-date-str.
     1287   end function.
     1288   function bge-xml-str-date returns character
     1289   ( input p-date-str as character )
     1290   :
     1291     define variable v-date-str as character no-undo .
     1292     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1293                                                   , output  v-date-str
     1294                                                   ) .
     1295     return v-date-str.
     1296   end function.
     1297   function bge-xml-normalize-dec returns decimal
     1298   ( input p-val as decimal )
     1299   :
     1300     return (if p-val = ? then 0 else p-val) .
     1301   end function.
     1302   PROCEDURE wp-XMLTagOpen:
     1303   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1304   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1305   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1306       define variable v-out-string    as character    no-undo.
     1307   do
     1308   on error undo, return error
     1309   :
     1310       if v-bge-xml-bgefmt = "dbf":U
     1311       then do:
     1312       end.
     1313       else do:
     1314           assign
     1315               v-out-string = substitute( "&1&2<&3&4>"
     1316                                       , chr(10)
     1317                                       , fill( " ":U, 4 * iTagLevel)
     1318                                       , sTagName
     1319                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1320                               )
     1321           .
     1322           put stream stmXMLOut unformatted
     1323               v-out-string
     1324           .
     1325       end.
     1326   end.
     1327   END PROCEDURE.
     1328   PROCEDURE wp-XMLTagPut:
     1329     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1330     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1331     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1332     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1333       define variable v-out-string    as character    no-undo.
     1334   do
     1335   on error undo, return error
     1336   :
     1337       if v-bge-xml-bgefmt = "dbf":U
     1338       then do:
     1339           if v-bge-xml-dbf-file-name <> "":U
     1340           then do:
     1341               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1342               export stream stmXMLOut
     1343                   sTagName
     1344                   sParValue
     1345               .
     1346               output stream stmXMLOut close.
     1347           end.
     1348       end.
     1349       else do:
     1350           IF  iFlagEmpty = 1
     1351           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1352           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1353           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1354           THEN DO:
     1355               run xmlchar-encode in this-procedure (
     1356                   input sParValue
     1357                   , output sParValue
     1358               ).
     1359               assign
     1360                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1361                                               , chr(10)
     1362                                               , FILL(" ", 4 * iTagLevel)
     1363                                               , sTagName
     1364                                               , sParValue
     1365                               )
     1366               .
     1367               PUT STREAM stmXMLOut UNFORMATTED
     1368                   v-out-string
     1369               .
     1370           END.
     1371       end.
     1372   end.
     1373   END PROCEDURE.
     1374   PROCEDURE wp-XMLTagClose:
     1375   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1376   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1377       define variable v-out-string    as character    no-undo.
     1378   do
     1379   on error undo, return error
     1380   :
     1381       if v-bge-xml-bgefmt = "dbf":U
     1382       then do:
     1383       end.
     1384       else do:
     1385           assign
     1386               v-out-string = substitute( "&1&2</&3>"
     1387                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1388                                   , fill( " ", 4 * iTagLevel )
     1389                                   , sTagName
     1390                           )
     1391           .
     1392           PUT STREAM stmXMLOut UNFORMATTED
     1393               v-out-string
     1394           .
     1395       end.
     1396   end.
     1397   END PROCEDURE.
     1398   PROCEDURE wp-XMLWriteLog:
     1399     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1400     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1401     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1402   define variable v-str              as character no-undo .
     1403   define variable v-error-append     as logical   no-undo .
     1404   define variable v-error-append-msg as character no-undo .
     1405   assign
     1406     v-str = chr(10)
     1407             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1408             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1409     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1410     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1411     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1412   .
     1413   run bge/bge-log.p (input v-str) no-error .
     1414   if error-status:error then do:
     1415     assign
     1416       v-error-append     = yes
     1417       v-error-append-msg = return-value
     1418     .
     1419   end.
     1420   run gbl/fileapnd.p
     1421     ( input sFileName
     1422     , input v-str
     1423     , input 10
     1424     ) no-error .
     1425   if error-status:error then do:
     1426     assign
     1427       v-error-append     = yes
     1428       v-error-append-msg = substitute( "&1&2&3"
     1429                                       , v-error-append-msg
     1430                                       , chr(10)
     1431                                       , return-value
     1432                                       )
     1433     .
     1434   end.
     1435   if v-error-append
     1436   then do:
     1437     return error substitute( "&1" , v-error-append-msg ) .
     1438   end.
     1439   END PROCEDURE.
     1440   PROCEDURE wp-XMLWriteEDT:
     1441     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1442     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1443     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1444       if valid-handle ( hEDT )
     1445       then do:
     1446           hEDT :move-to-eof().
     1447           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1448                                           OR sToWrite = "&Line") THEN "" ELSE
     1449                                           cur-time-string-sec() + " ").
     1450           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1451                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1452                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1453           hEDT :insert-string(chr(10)).
     1454       end.
     1455       process events.
     1456       output to 'bgescn.txt' append.
     1457           put unformatted
     1458               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1459                                           OR sToWrite = "&Line") THEN "" ELSE
     1460                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1461               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1462                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1463                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1464           .
     1465       output close.
     1466   END PROCEDURE.
     1467   PROCEDURE wp-XMLShowCNT:
     1468     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1469       if valid-handle( hCNT )
     1470       then do:
     1471           ASSIGN hCNT :VISIBLE = TRUE.
     1472       end.
     1473   END PROCEDURE.
     1474   PROCEDURE wp-XMLHideCNT:
     1475     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1476       if valid-handle( hCNT )
     1477       then do:
     1478           ASSIGN hCNT :VISIBLE = FALSE.
     1479       end.
     1480   END PROCEDURE.
     1481   PROCEDURE wp-XMLWriteCNT:
     1482     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1483     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1484       if valid-handle( hCNT )
     1485       then do:
     1486           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1487       end.
     1488   END PROCEDURE.
     1489   procedure bge-xml-write-header:
     1490   do
     1491   on error undo, return error
     1492   :
     1493   define input parameter p-xml-file-name  as character        no-undo.
     1494   define input parameter p-doc-name       as character        no-undo.
     1495   define input parameter p-version        as character        no-undo.
     1496   define input parameter p-db-num         as integer          no-undo.
     1497   define input parameter p-date-from      as date             no-undo.
     1498   define input parameter p-shift-num-from as integer          no-undo.
     1499   define input parameter p-date-to        as date             no-undo.
     1500   define input parameter p-shift-num-to   as integer          no-undo.
     1501   define input parameter p-obj-list       as character        no-undo.
     1502   define input parameter p-doc-type-list  as character        no-undo.
     1503   define input parameter p-pay-code       as logical          no-undo.
     1504   define input parameter p-cst            as logical          no-undo.
     1505   define input parameter p-parts          as logical          no-undo.
     1506   define input parameter p-chk-pay-code   as logical          no-undo.
     1507   define input parameter p-pay-desk       as logical          no-undo.
     1508   define input parameter p-pay-desk-cards as logical          no-undo.
     1509   define input parameter p-deleted        as logical          no-undo.
     1510   define input parameter p-opened-docs    as logical          no-undo.
     1511   define variable v-out-string    as character    no-undo.
     1512   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1513   assign
     1514       v-out-string = substitute( "&1&2&3"
     1515                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1516                           , chr(10)
     1517                           , "<IBS_Trade_House>":U )
     1518   .
     1519   put stream stmXMLOut unformatted
     1520       v-out-string
     1521   .
     1522   run wp-XMLTagOpen(1, "header","").
     1523   if v-bge-xml-bgeflold = "oracle":u
     1524   then do:
     1525     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1526     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1527     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1528     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1529     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1530   end.
     1531   run wp-XMLTagOpen( 2, "manifest", "").
     1532   run wp-XMLTagOpen( 3, "document", "").
     1533   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1534   run wp-XMLTagput( 4, "description", "", 0).
     1535   run wp-XMLTagput( 4, "version", p-version, 0).
     1536   run wp-XMLTagclose( 3, "document" ).
     1537   run wp-XMLTagclose( 2, "manifest" ).
     1538   run wp-XMLTagclose( 1, "header" ).
     1539   run wp-XMLTagOpen(1, "options","").
     1540   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1541   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1542   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1543   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1544   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1545   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1546   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1547   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1548   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1549   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1550   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1551   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1552   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1553   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1554   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1555   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1556   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1557   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1558   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1559   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1560   run wp-XMLTagClose(1, "options").
     1561   run wp-XMLTagOpen( 1, "body", "" ).
     1562   output stream stmXMLOut close.
     1563   end.
     1564   end procedure.
     1565   procedure xml-bge-write-footer:
     1566   do
     1567   on error undo, return error return-value
     1568   :
     1569   define input parameter p-xml-file-name as character    no-undo.
     1570   define variable v-error-num     as integer           no-undo.
     1571   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1572   run wp-XMLTagClose( 1, "body" ).
     1573   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1574   output stream stmXMLOut close.
     1575   if v-bge-xml-bgeflold = "oracle":u
     1576   then do:
     1577     define variable v-tmp-file-name         as character no-undo .
     1578     define variable v-zip-file-name         as character no-undo .
     1579     define variable v-exch-file-name        as character no-undo .
     1580     define variable v-heap-file-name        as character no-undo .
     1581     define variable v-i                     as integer   no-undo .
     1582     define variable v-file-name             as character no-undo .
     1583     define variable v-arc                   as character no-undo .
     1584     define variable v-str                   as character no-undo .
     1585     define variable v-exch-tmp-file-name    as character no-undo .
     1586     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1587     define variable v-bge-xml-exch-dir      as character no-undo .
     1588     define variable v-bge-xml-heap-dir      as character no-undo .
     1589     define variable v-bge-xml-compress-heap as logical   no-undo .
     1590     define variable v-home-dir              as character no-undo .
     1591     define variable v-os-command            as character no-undo .
     1592     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1593     if v-home-dir = ?
     1594     then do:
     1595       undo, return error substitute( "&1&2&3"
     1596                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1597                                     , chr(10)
     1598                                     , "Обратитесь к администратору.":u
     1599                                     ).
     1600     end.
     1601     assign
     1602       v-home-dir = v-home-dir
     1603     .
     1604     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1605     if error-status :error
     1606     then do:
     1607       undo, return error substitute( "&1&2&3"
     1608                                     , "Неверно задан каталог экспорта.":u
     1609                                     , chr(10)
     1610                                     , "Обратитесь к администратору.":u
     1611                                     ).
     1612     end.
     1613     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1614     if v-bge-xml-exch-dir = ?
     1615     then do:
     1616       undo, return error substitute( "&1&2&3"
     1617                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1618                                     , chr(10)
     1619                                     , "Обратитесь к администратору.":u
     1620                                     ).
     1621     end.
     1622     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1623     if error-status :error
     1624     then do:
     1625       undo, return error substitute( "&1&2&3"
     1626                                     , "Неверно задан каталог экспорта (exch).":u
     1627                                     , chr(10)
     1628                                     , "Обратитесь к администратору.":u
     1629                                     ).
     1630     end.
     1631     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1632     if v-bge-xml-heap-dir = ?
     1633     then do:
     1634       undo, return error substitute( "&1&2&3"
     1635                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1636                                     , chr(10)
     1637                                     , "Обратитесь к администратору.":u
     1638                                     ).
     1639     end.
     1640     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1641     if error-status :error
     1642     then do:
     1643       undo, return error substitute( "&1&2&3"
     1644                                     , "Неверно задан каталог экспорта (heap).":u
     1645                                     , chr(10)
     1646                                     , "Обратитесь к администратору.":u
     1647                                     ).
     1648     end.
     1649     get-key-value section "BGE" key "heap-compress" value v-str.
     1650     assign
     1651       v-i = int(v-str)
     1652     no-error .
     1653     if v-i = ? or v-i = 0
     1654     then do:
     1655       assign
     1656         v-bge-xml-compress-heap = no
     1657       .
     1658     end.
     1659     else do:
     1660       assign
     1661         v-bge-xml-compress-heap = yes
     1662       .
     1663     end.
     1664     assign
     1665       v-arc = search( "exe/7za.exe":u )
     1666     .
     1667     if v-arc = ? or v-arc = ""
     1668     then do:
     1669       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1670     end.
     1671     assign
     1672       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1673       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1674       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1675       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1676       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1677       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1678       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1679     .
     1680     run gbl/del-file.p (input v-tmp-file-name) .
     1681     run gbl/del-file.p (input v-zip-file-name) .
     1682     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1683     if v-error-num > 0
     1684     then do:
     1685         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1686                                      , p-xml-file-name + "xm1":u
     1687                                      , v-tmp-file-name
     1688                                      , v-error-num
     1689                                      ).
     1690     end.
     1691     assign
     1692       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1693                                    , v-arc
     1694                                    , v-zip-file-name
     1695                                    , v-tmp-file-name
     1696                                    )
     1697     .
     1698     os-command silent value ( v-os-command ) .
     1699     run gbl/del-file.p (input v-heap-file-name) .
     1700     if v-bge-xml-compress-heap = no
     1701     then do:
     1702       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1703       if v-error-num > 0
     1704       then do:
     1705           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1706                                        , v-tmp-file-name
     1707                                        , v-heap-file-name
     1708                                        , v-error-num
     1709                                        ) .
     1710       end.
     1711     end.
     1712     else do:
     1713       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1714       if v-error-num > 0
     1715       then do:
     1716           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1717                                        , v-zip-file-name
     1718                                        , v-heap-file-name
     1719                                        , v-error-num
     1720                                        ) .
     1721       end.
     1722     end.
     1723     run gbl/del-file.p (input v-tmp-file-name) .
     1724     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1725     if error-status :error then do:
     1726       undo, return error substitute( "&1&2&3"
     1727                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1728                                     , chr(10)
     1729                                     , "Обратитесь к администратору."
     1730                                     ).
     1731     end.
     1732     run gbl/del-file.p (input v-exch-file-name) .
     1733     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1734     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1735     if v-error-num > 0
     1736     then do:
     1737       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1738                                     , v-zip-file-name
     1739                                     , v-exch-tmp-file-name
     1740                                     , v-error-num
     1741                                     ) .
     1742     end.
     1743     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1744     if v-error-num > 0
     1745     then do:
     1746       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1747                                     , v-exch-tmp-file-name
     1748                                     , v-exch-file-name
     1749                                     , v-error-num
     1750                                     ) .
     1751     end.
     1752     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1753   end.
     1754   else do:
     1755     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1756     if v-error-num > 0
     1757     then do:
     1758       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1759                                     , p-xml-file-name + "xm1"
     1760                                     , p-xml-file-name + "xml"
     1761                                     , v-error-num
     1762                                     ) .
     1763     end.
     1764   end.
     1765   if opsys = "unix"
     1766   then do:
     1767       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1768   end.
     1769   end.
     1770   end procedure.
     1771   procedure xml-bge-filename0:
     1772   define input parameter p-prefix   as character no-undo .
     1773   define input parameter p-name     as character no-undo .
     1774   define input parameter p-shared-process as logical no-undo .
     1775   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1776   define output parameter p-xml-file-name  as character no-undo .
     1777   // define output parameter p-fullfnamenoext as character no-undo .
     1778   define output parameter p-locked         as logical      no-undo.
     1779   define variable v-fullfnamenoext as character no-undo .
     1780   define variable v-fileext        as character no-undo .
     1781   define variable v-fullfname      as character no-undo .
     1782   define variable v-error-num      as integer   no-undo .
     1783   do
     1784   on error undo, return error
     1785   :
     1786     case v-bge-xml-bgeflold :
     1787       when "old" then do:
     1788         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1789         v-fileext       = ".xml":U .
     1790         v-fullfname     = v-fullfnamenoext + v-fileext .
     1791         p-xml-file-name = v-fullfname .
     1792         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1793         if v-error-num > 0 then do:
     1794           return error.
     1795         end.
     1796       end.
     1797       when "var" then do:
     1798         case p-prefix :
     1799           when "doc" then do:
     1800             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1801             v-fileext       = ".xml":U .
     1802             v-fullfname     = v-fullfnamenoext + v-fileext .
     1803             p-xml-file-name = v-fullfname .
     1804           end.
     1805           when "day" then do:
     1806             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1807             v-fileext       = ".xml":U .
     1808             v-fullfname     = v-fullfnamenoext + v-fileext .
     1809             p-xml-file-name = v-fullfname .
     1810           end.
     1811           otherwise do:
     1812             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1813             v-fileext       = ".xml":U .
     1814             v-fullfname     = v-fullfnamenoext + v-fileext .
     1815             p-xml-file-name = v-fullfname .
     1816           end.
     1817         end case.
     1818         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1819         if v-error-num > 0 then do:
     1820           return error.
     1821         end.
     1822       end.
     1823       when "new" then do:
     1824                   run bge/genfname.p (
     1825                       input p-home-dir
     1826                       , input p-prefix
     1827                       , input ""
     1828                       , input "xml"
     1829                       , input ""
     1830                       , output p-xml-file-name
     1831                   ).
     1832       end.
     1833       when "no-parameter" then do:
     1834         if p-shared-process then do:
     1835                       run bge/genfname.p (
     1836                           input p-home-dir
     1837                           , input "d"
     1838                           , input ""
     1839                           , input "xml"
     1840                           , input ""
     1841                           , output p-xml-file-name
     1842                       ).
     1843         end.
     1844         else do:
     1845           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1846           v-fileext       = ".xml":U .
     1847           v-fullfname     = v-fullfnamenoext + v-fileext .
     1848           p-xml-file-name = v-fullfname .
     1849           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1850           if v-error-num > 0 then do:
     1851             return error.
     1852           end.
     1853         end.
     1854       end.
     1855     end case.
     1856     assign
     1857       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1858       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1859     .
     1860   end .
     1861   end procedure .
     1862   procedure xml-bge-filename :
     1863   do
     1864   on error undo, return error
     1865   :
     1866   define input parameter p-prefix             as character    no-undo.
     1867   define input parameter p-name               as character    no-undo.
     1868   define input parameter p-shared-process     as logical      no-undo.
     1869   define output parameter p-xml-file-name     as character    no-undo.
     1870   define output parameter p-log-file-name     as character    no-undo.
     1871   define output parameter p-locked            as logical      no-undo.
     1872   define variable v-home-dir          as character no-undo .
     1873   define variable v-error-num         as integer   no-undo .
     1874   define variable v-bge-xml-heap-dir  as character no-undo .
     1875       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1876       if v-home-dir = ?
     1877       then do:
     1878           message
     1879             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1880             skip(1)
     1881             skip "Обратитесь к администратору."
     1882           view-as alert-box error.
     1883           undo, return error .
     1884       end.
     1885       if v-bge-xml-bgeflold <> "oracle"
     1886       then do:
     1887         assign
     1888             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1889         .
     1890       end.
     1891       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1892       if error-status :error
     1893       then do:
     1894           message
     1895             skip "Неверно задан каталог экспорта."
     1896             skip(1)
     1897             skip "Обратитесь к администратору."
     1898           view-as alert-box error.
     1899           undo, return error .
     1900       end.
     1901       if v-bge-xml-bgefmt = "dbf":U
     1902       then do:
     1903           assign
     1904               p-xml-file-name = v-home-dir
     1905               p-locked        = no
     1906           .
     1907       end.
     1908       else do:
     1909           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1910             output p-xml-file-name, output p-locked) .
     1911       end.
     1912       if v-bge-xml-bgeflold = "oracle"
     1913       then do:
     1914         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1915         if v-bge-xml-heap-dir = ?
     1916         then do:
     1917           undo, return error substitute( "&1&2&3"
     1918                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1919                                         , chr(10)
     1920                                         , "Обратитесь к администратору.":u
     1921                                         ).
     1922         end.
     1923         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1924         if error-status :error
     1925         then do:
     1926           undo, return error substitute( "&1&2&3"
     1927                                         , "Неверно задан каталог экспорта (heap).":u
     1928                                         , chr(10)
     1929                                         , "Обратитесь к администратору.":u
     1930                                         ).
     1931         end.
     1932         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1933           assign
     1934             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1935           .
     1936         end.
     1937         else do:
     1938           assign
     1939             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1940           .
     1941         end.
     1942       end.
     1943       else do:
     1944         assign
     1945             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1946         .
     1947       end.
     1948       assign
     1949          v-bge-xml-static-log-file-name = p-log-file-name
     1950       .
     1951   end.
     1952   end procedure.
     1953   procedure bge-xml-read-config :
     1954   do
     1955   on error undo, return error return-value
     1956   :
     1957   define input  parameter p-last-date as date      no-undo .
     1958   define input  parameter p-db-num    as integer   no-undo .
     1959       define variable v-bgeclall      as character     no-undo.
     1960       define variable v-bgedict       as character     no-undo.
     1961       define variable v-bgeshift      as character     no-undo.
     1962       define variable v-par-type      as character     no-undo.
     1963       define variable v-bgeflnm       as character     no-undo.
     1964       define variable v-bgecliiv      as character     no-undo .
     1965       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1966       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1967       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1968       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1969       define variable v-db-num-str    as character     no-undo .
     1970       define variable v-param-type      as character  no-undo .
     1971       define variable v-value-character as character  no-undo .
     1972       define variable v-value-date      as date       no-undo .
     1973       define variable v-value-decimal   as decimal    no-undo .
     1974       define variable v-value-integer   as integer    no-undo .
     1975       define variable v-value-logical   as logical    no-undo .
     1976       define variable v-tth             as handle      no-undo .
     1977       run adm/shattri.p ( input "get":U
     1978                         , input  '':u
     1979                         , input  0
     1980                         , input  'bge-export':U
     1981                         , input  'bgeclall':U
     1982                         , output v-bgecliiv
     1983                         , output v-value-date
     1984                         , output v-value-decimal
     1985                         , output v-value-integer
     1986                         , output v-value-logical
     1987                         , output v-param-type
     1988                         , input-output table-handle v-tth
     1989                         ) no-error .
     1990       if error-status :error
     1991       then do:
     1992         assign
     1993           v-bge-xml-bgecliiv = no
     1994         .
     1995       end.
     1996       else do:
     1997         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1998       end.
     1999       delete object v-tth.
     2000       assign
     2001           v-bge-xml-bgeclall = no
     2002           v-bge-xml-bgedict  = no
     2003       .
     2004       run adm/shattri.p ( input "get":U
     2005                         , input  '':u
     2006                         , input  0
     2007                         , input  'bge-export':U
     2008                         , input  'bgeclall':U
     2009                         , output v-value-character
     2010                         , output v-value-date
     2011                         , output v-value-decimal
     2012                         , output v-value-integer
     2013                         , output v-value-logical
     2014                         , output v-param-type
     2015                         , input-output table-handle v-tth
     2016                         ) no-error .
     2017       if error-status :error
     2018       then do:
     2019         assign
     2020           v-bge-xml-bgeclall = no
     2021         .
     2022       end.
     2023       else do:
     2024         assign
     2025           v-bge-xml-bgeclall = v-value-logical
     2026         .
     2027       end.
     2028       delete object v-tth.
     2029       run adm/shattri.p ( input "get":U
     2030                         , input  '':u
     2031                         , input  0
     2032                         , input  'bge-export':U
     2033                         , input  'bgedict':U
     2034                         , output v-value-character
     2035                         , output v-value-date
     2036                         , output v-value-decimal
     2037                         , output v-value-integer
     2038                         , output v-value-logical
     2039                         , output v-param-type
     2040                         , input-output table-handle v-tth
     2041                         ) no-error .
     2042       if error-status :error
     2043       then do:
     2044         assign
     2045           v-bge-xml-bgedict = no
     2046         .
     2047       end.
     2048       else do:
     2049         assign
     2050           v-bge-xml-bgedict = v-value-logical
     2051         .
     2052       end.
     2053       delete object v-tth.
     2054       run adm/shattri.p ( input "get":U
     2055                         , input  '':u
     2056                         , input  0
     2057                         , input  'bge-export':U
     2058                         , input  'bgefmt':U
     2059                         , output v-value-character
     2060                         , output v-value-date
     2061                         , output v-value-decimal
     2062                         , output v-value-integer
     2063                         , output v-value-logical
     2064                         , output v-param-type
     2065                         , input-output table-handle v-tth
     2066                         ) no-error .
     2067       if error-status :error
     2068       then do:
     2069         assign
     2070           v-bge-xml-bgefmt  = "xml":U
     2071         .
     2072       end.
     2073       else do:
     2074         assign
     2075           v-bge-xml-bgefmt  = v-value-character
     2076         .
     2077       end.
     2078       delete object v-tth.
     2079       run adm/shattri.p ( input "get":U
     2080                         , input  '':u
     2081                         , input  0
     2082                         , input  'bge-export':U
     2083                         , input  'bgeshift':U
     2084                         , output v-value-character
     2085                         , output v-value-date
     2086                         , output v-value-decimal
     2087                         , output v-value-integer
     2088                         , output v-value-logical
     2089                         , output v-param-type
     2090                         , input-output table-handle v-tth
     2091                         ) no-error .
     2092       if error-status :error
     2093       then do:
     2094         assign
     2095             v-bge-xml-shift-mode = no
     2096         .
     2097       end.
     2098       else do:
     2099         assign
     2100             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2101         .
     2102       end.
     2103       delete object v-tth.
     2104       run adm/shattri.p ( input "get":U
     2105                         , input  '':u
     2106                         , input  0
     2107                         , input  'bge-export':U
     2108                         , input  'bgeflold':U
     2109                         , output v-value-character
     2110                         , output v-value-date
     2111                         , output v-value-decimal
     2112                         , output v-value-integer
     2113                         , output v-value-logical
     2114                         , output v-param-type
     2115                         , input-output table-handle v-tth
     2116                         ) no-error .
     2117       if error-status :error
     2118       then do:
     2119         assign
     2120           v-bge-xml-bgeflold = "no-parameter":U
     2121         .
     2122       end.
     2123       else do:
     2124         assign
     2125           v-bge-xml-bgeflold  = v-value-character
     2126         .
     2127       end.
     2128       delete object v-tth.
     2129       assign
     2130         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2131         v-bge-xml-db-num-str  = v-db-num-str
     2132       .
     2133       if p-last-date <> ?
     2134       then do:
     2135           run adm/shattri.p ( input "get":U
     2136                             , input  '':u
     2137                             , input  0
     2138                             , input  'bge-export':U
     2139                             , input  'bgeflnm':U
     2140                             , output v-value-character
     2141                             , output v-value-date
     2142                             , output v-value-decimal
     2143                             , output v-value-integer
     2144                             , output v-value-logical
     2145                             , output v-param-type
     2146                             , input-output table-handle v-tth
     2147                             ) no-error .
     2148           if error-status :error
     2149           then do:
     2150             assign
     2151               v-bgeflnm = '':U
     2152             .
     2153           end.
     2154           else do:
     2155             assign
     2156               v-bgeflnm = v-value-character
     2157             .
     2158           end.
     2159           delete object v-tth.
     2160           if v-bge-xml-bgeflold = "var"
     2161           then do:
     2162               if v-bgeflnm = ?
     2163               or num-entries( v-bgeflnm ) < 2
     2164               then do:
     2165                   assign
     2166                       v-bge-xml-bgeflold = "new"
     2167                   .
     2168               end.
     2169               else do:
     2170                   assign
     2171                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2172                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2173                   .
     2174                   assign
     2175                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2176                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2177                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2178                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2179                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2180                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2181                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2182                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2183                   .
     2184               end.
     2185           end.
     2186       end.
     2187   end.
     2188   end procedure.
     2189   procedure bge-xml-get-ref-filename :
     2190   define input parameter p-in-file-name       as character        no-undo.
     2191   define output parameter p-home-dir          as character        no-undo.
     2192   define output parameter p-out-file-name     as character        no-undo.
     2193   define output parameter p-locked            as logical          no-undo.
     2194       define variable v-counter       as integer      no-undo.
     2195       define variable v-error-level   as integer      no-undo.
     2196   do
     2197   on error undo, return error
     2198   :
     2199       run bge/bge-ini.p (
     2200             input "bge"
     2201           , output p-home-dir
     2202       ).
     2203       if return-value <> "OK"
     2204       then do:
     2205           undo, return error.
     2206       end.
     2207       assign
     2208           p-home-dir = p-home-dir + "\dict":U
     2209       .
     2210       run bge/dir_cd.p (
     2211           input p-home-dir
     2212           , input "CA"
     2213       ).
     2214       if return-value = "ERROR"
     2215       then do:
     2216           undo, return error.
     2217       end.
     2218       assign
     2219           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2220       .
     2221       assign
     2222           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2223       .
     2224       wait-lock:
     2225       do v-counter = 1 TO 3
     2226       :
     2227           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2228           if p-locked = no
     2229           then do:
     2230               leave wait-lock.
     2231           end.
     2232           else do:
     2233               readkey pause 1.
     2234           end.
     2235       END.
     2236       if p-locked = yes
     2237       then do:
     2238           undo, return error.
     2239       end.
     2240       run bge/os_copy.p (
     2241             input "D":U
     2242           , input p-out-file-name + "xml":U
     2243           , input "":U
     2244           , output v-error-level
     2245       ).
     2246       if v-error-level > 0
     2247       then do:
     2248           undo, return error.
     2249       end.
     2250   end.
     2251   end procedure.
     2252   procedure bge-xml-write-ref-header :
     2253   define input parameter p-bge-name as character        no-undo.
     2254   define input parameter p-file-name as character        no-undo.
     2255       define variable v-out-string    as character    no-undo.
     2256   do
     2257   on error undo, return error
     2258   :
     2259       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2260       put stream stmXMLOut unformatted
     2261           "<?xml version='1.0' encoding='windows-1251'?>":U
     2262       .
     2263       assign
     2264           v-out-string = substitute( "&1&2"
     2265                               , chr(10)
     2266                               , "<IBS_Trade_House>":U )
     2267       .
     2268       put stream stmXMLOut unformatted
     2269           v-out-string
     2270       .
     2271       run wp-XMLTagOpen( 1, "header", "" ).
     2272       if v-bge-xml-bgeflold = "oracle":u
     2273       then do:
     2274         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2275         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2276         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2277         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2278         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2279       end.
     2280       else do:
     2281         run wp-XMLTagOpen( 2, "delivery", "" ).
     2282         run wp-XMLTagOpen( 3, "to", "" ).
     2283         run wp-XMLTagClose( 3, "to" ).
     2284         run wp-XMLTagOpen( 3, "from", "" ).
     2285         run wp-XMLTagClose( 3, "from" ).
     2286         run wp-XMLTagClose( 2, "delivery" ).
     2287       end.
     2288       run wp-XMLTagOpen( 2, "manifest", "" ).
     2289       run wp-XMLTagOpen( 3, "document", "" ).
     2290       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2291       run wp-XMLTagPut( 4, "description", "", 0 ).
     2292       run wp-XMLTagClose( 3, "document" ).
     2293       run wp-XMLTagClose( 2, "manifest" ).
     2294       run wp-XMLTagClose( 1, "header" ).
     2295       run wp-XMLTagOpen( 1, "body", "" ).
     2296   end.
     2297   end procedure.
     2298   procedure bge-xml-write-ref-footer :
     2299   define input parameter p-file-name as character        no-undo.
     2300       define variable v-error-level   as integer      no-undo.
     2301   do
     2302   on error undo, return error
     2303   :
     2304       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2305       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2306       output stream stmXMLOut close.
     2307       run bge/os_copy.p (
     2308             input "M":U
     2309           , input p-file-name + "xm1":U
     2310           , input p-file-name + "xml":U
     2311           , output v-error-level
     2312       ).
     2313       if v-error-level > 0
     2314       then do:
     2315           undo, return error.
     2316       end.
     2317   end.
     2318   end procedure.
     2319   procedure bge-xml-out-dir :
     2320   define output parameter p-out-dir       as character    no-undo.
     2321   define output parameter p-log-file-name as character    no-undo.
     2322   do
     2323   on error undo, return error
     2324   :
     2325       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2326       if p-out-dir = ?
     2327       then do:
     2328           message
     2329             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2330                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2331             skip(1)
     2332             skip "Обратитесь к администратору."
     2333           view-as alert-box error.
     2334           undo, return error .
     2335       end.
     2336       if v-bge-xml-bgeflold <> "oracle" then assign
     2337         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2338       .
     2339       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2340       if error-status :error  then do:
     2341           run wp-XMLWriteLog in this-procedure (
     2342                 input p-log-file-name
     2343               , input 0
     2344               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2345                                   , p-out-dir
     2346                                   , return-value
     2347                                   , trim( error-status :get-message( 1 ) )
     2348                                   )
     2349           ).
     2350           undo, return error.
     2351       end.
     2352       assign
     2353           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2354           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2355       .
     2356   end.
     2357   end procedure.
     2358   procedure bge-xml-out-dir2 :
     2359   define output parameter p-out-dir       as character    no-undo.
     2360   define output parameter p-out-dirR      as character    no-undo.
     2361   define output parameter p-log-file-name as character    no-undo.
     2362   do
     2363   on error undo, return error
     2364   :
     2365       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2366       if p-out-dir = ?
     2367       then do:
     2368           message
     2369             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2370                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2371             skip(1)
     2372             skip "Обратитесь к администратору."
     2373           view-as alert-box error.
     2374           undo, return error .
     2375       end.
     2376       if v-bge-xml-bgeflold <> "oracle" then assign
     2377             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2378             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2379         .
     2380       else p-out-dirR = p-out-dir .
     2381       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2382       if error-status :error  then do:
     2383           run wp-XMLWriteLog in this-procedure (
     2384                 input p-log-file-name
     2385               , input 0
     2386               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2387                                   , p-out-dir
     2388                                   , return-value
     2389                                   , error-status :get-message( 1 )
     2390                                   )
     2391           ).
     2392           undo, return error.
     2393       end.
     2394       if p-out-dirR <> p-out-dir then do:
     2395         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2396         if error-status :error then do:
     2397           run wp-XMLWriteLog in this-procedure (
     2398                 input p-log-file-name
     2399               , input 0
     2400               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2401                                   , p-out-dirR
     2402                                   , return-value
     2403                                   , error-status :get-message( 1 )
     2404                                   )
     2405           ).
     2406           p-out-dirR = p-out-dir .
     2407         end.
     2408       end .
     2409       assign
     2410         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2411         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2412       .
     2413   end.
     2414   end procedure.
     2415   procedure bge-xml-out-file :
     2416   do
     2417   on error undo, return error
     2418   :
     2419   define input parameter p-out-dir            as character        no-undo.
     2420   define input parameter p-prefix             as character        no-undo.
     2421   define input parameter p-sheduled           as logical          no-undo.
     2422   define output parameter p-xml-file-name     as character        no-undo.
     2423   define output parameter p-locked            as logical          no-undo.
     2424   define variable v-home-dir      as character     no-undo.
     2425   define variable v-error-num     as integer       no-undo.
     2426   define variable v-today             as date         no-undo.
     2427   define variable v-time              as integer      no-undo.
     2428       if v-bge-xml-bgefmt = "dbf":U
     2429       then do:
     2430           assign
     2431               p-xml-file-name = p-out-dir
     2432               p-locked        = no
     2433           .
     2434       end.
     2435       else do:
     2436           if v-bge-xml-bgeflold = "firm":U
     2437           then do:
     2438               run bge/genfname.p (
     2439                     input p-out-dir
     2440                   , input p-prefix
     2441                   , input "":U
     2442                   , input "arj":U
     2443                   , input "":U
     2444                   , output p-xml-file-name
     2445               ).
     2446           end.
     2447           else do:
     2448               run bge/genfname.p (
     2449                     input p-out-dir
     2450                   , input p-prefix
     2451                   , input "":U
     2452                   , input "xml":U
     2453                   , input "":U
     2454                   , output p-xml-file-name
     2455               ).
     2456           end.
     2457           assign
     2458               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2459               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2460           .
     2461       end.
     2462   end.
     2463   end procedure.
     2464   procedure bge-xml-init-ext-doc-type :
     2465       define variable v-counter    as integer      no-undo.
     2466       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2467   do
     2468   for buf_temp_ext-doc-type
     2469   on error undo, return error
     2470   :
     2471       empty temp-table buf_temp_ext-doc-type.
     2472       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2473       :
     2474           create buf_temp_ext-doc-type.
     2475           assign
     2476               buf_temp_ext-doc-type.edt-key               = v-counter
     2477               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2478               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2479           .
     2480       end.
     2481   end.
     2482   end procedure.
     2483   procedure bge-xml-get-decimal-shift-num :
     2484   define input parameter p-shift-date     as date             no-undo.
     2485   define input parameter p-shift-num      as integer          no-undo.
     2486   define output parameter p-shift-decimal as decimal          no-undo.
     2487   do
     2488   on error undo, return error
     2489   :
     2490       assign
     2491           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2492       .
     2493   end.
     2494   end procedure.
     2495   procedure bge-xml-ora-exp-filename :
     2496     define input  parameter p-table-name  as character no-undo .
     2497     define input  parameter p-doc-code    as character no-undo .
     2498     define input  parameter p-obj-code    as integer   no-undo .
     2499     define output parameter p-filename    as character no-undo .
     2500     define output parameter p-seq-num     as integer   no-undo .
     2501     define variable v-ora-exp-seq     as integer   no-undo .
     2502     define variable v-ora-exp-seq-str as character no-undo .
     2503     define variable v-home-dir        as character no-undo.
     2504   do
     2505   on error undo, return error return-value
     2506   :
     2507     if v-bge-xml-bgeflold = "oracle":u
     2508     then do:
     2509       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2510       if v-home-dir = ?
     2511       then do:
     2512         undo, return error substitute( "&1&2&3":U
     2513                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2514                                       , chr(10)
     2515                                       , "Обратитесь к администратору.":U
     2516                                       ).
     2517       end.
     2518       assign
     2519           v-home-dir = v-home-dir
     2520       .
     2521       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2522       if error-status :error
     2523       then do:
     2524         undo, return error substitute( "&1&2&3":U
     2525                                       , "Неверно задан каталог экспорта.":U
     2526                                       , chr(10)
     2527                                       , "Обратитесь к администратору.":U
     2528                                       ).
     2529       end.
     2530       assign
     2531         v-ora-exp-seq = ?
     2532       .
     2533       if  p-table-name <> ? and
     2534           p-doc-code <> ?
     2535       then do:
     2536         run bge/get-oesq.p ( input p-table-name
     2537                            , input p-doc-code
     2538                            , output v-ora-exp-seq
     2539                            ) no-error .
     2540         if error-status :error = yes
     2541         then do:
     2542           undo, return error return-value .
     2543         end.
     2544       end.
     2545       if v-ora-exp-seq = ?
     2546       then do:
     2547         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2548         if error-status :error
     2549         then do:
     2550           undo, return error return-value .
     2551         end.
     2552       end.
     2553       if p-table-name <> ? and
     2554          p-doc-code   <> ?
     2555       then do:
     2556         run bge/oesqdoc.p ( input p-table-name
     2557                           , input p-doc-code
     2558                           , input v-ora-exp-seq
     2559                           ) no-error .
     2560         if error-status :error = yes
     2561         then do:
     2562           undo, return error return-value .
     2563         end.
     2564       end.
     2565       assign
     2566         p-seq-num  = v-ora-exp-seq
     2567         p-filename = substitute("&1/&2-000_&3."
     2568                                , v-home-dir
     2569                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2570                                , string(v-ora-exp-seq , "999999999")
     2571                                )
     2572       .
     2573     end.
     2574   end.
     2575   end procedure.
     2576   procedure bge-xml-date-to-str :
     2577     define input  parameter p-date  as date      no-undo .
     2578     define output parameter p-str   as character no-undo .
     2579   do
     2580   on error undo, return error return-value
     2581   :
     2582     if p-date <> ?
     2583     then do:
     2584       assign
     2585         p-str = substitute( "&1-&2-&3"
     2586                           , string( year(p-date)  , "9999")
     2587                           , string( month(p-date) , "99"  )
     2588                           , string( day(p-date)   , "99"  )
     2589                           )
     2590       .
     2591     end.
     2592     else do:
     2593       assign
     2594         p-str = ?
     2595       .
     2596     end.
     2597   end.
     2598   end procedure.
     2599   procedure bge-xml-date-str-to-str :
     2600     define input  parameter p-date-str  as character no-undo .
     2601     define output parameter p-str       as character no-undo .
     2602     define variable v-date          as date      no-undo .
     2603     define variable v-date-valid    as logical   no-undo .
     2604     define variable v-error-message as character no-undo .
     2605   do
     2606   on error undo, return error return-value
     2607   :
     2608     assign
     2609       p-str = ?
     2610     .
     2611     if p-date-str = ? or p-date-str = ""
     2612     then do:
     2613       return .
     2614     end.
     2615     run strtdate in this-procedure ( input  p-date-str
     2616                                    , output v-date
     2617                                    , output v-date-valid
     2618                                    , output v-error-message
     2619                                    ).
     2620     if v-date-valid <> true
     2621     then do:
     2622       return .
     2623     end.
     2624     assign
     2625       p-str = substitute( "&1-&2-&3"
     2626                         , string( year(v-date)  , "9999")
     2627                         , string( month(v-date) , "99"  )
     2628                         , string( day(v-date)   , "99"  )
     2629                         )
     2630     .
     2631   end.
     2632   end procedure.
     2633   procedure bge-xml-fill-tt-bgecliiv :
     2634     define input  parameter p-str as character no-undo .
     2635     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2636     define buffer buf_clients             for ub.clients.
     2637     define variable v-i         as integer   no-undo .
     2638     define variable v-count     as integer   no-undo .
     2639     define variable v-cli-count as integer   no-undo .
     2640     define variable v-client    as character no-undo .
     2641     define variable v-obj-type  as character no-undo .
     2642     define variable v-obj-code  as integer   no-undo .
     2643   do
     2644   on error undo, return error return-value
     2645   :
     2646     empty temp-table buf_tt-bge-xml-bgecliiv.
     2647     assign
     2648       v-bge-xml-bgecliiv = no
     2649       v-cli-count        = num-entries(p-str,';')
     2650     .
     2651     if v-cli-count > 0
     2652     then do:
     2653       _cli-cycle:
     2654       do v-i = 1 to v-cli-count
     2655       :
     2656         assign
     2657           v-client = entry(v-i , p-str, ';')
     2658         .
     2659         if num-entries(v-client) <> 2
     2660         then do:
     2661           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2662         end.
     2663         assign
     2664           v-obj-type = entry(1, v-client)
     2665         .
     2666         assign
     2667           v-obj-code = integer(entry(2, v-client))
     2668         no-error .
     2669         if error-status :error
     2670         then do:
     2671           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2672         end.
     2673         find first buf_clients no-lock
     2674           where buf_clients.obj-type = v-obj-type
     2675             and buf_clients.obj-code = v-obj-code
     2676         no-error.
     2677         if not available buf_clients
     2678         then do:
     2679           next _cli-cycle.
     2680         end.
     2681         find first buf_tt-bge-xml-bgecliiv no-lock
     2682           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2683             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2684         no-error .
     2685         if available buf_tt-bge-xml-bgecliiv
     2686         then do:
     2687           next _cli-cycle.
     2688         end.
     2689         create buf_tt-bge-xml-bgecliiv.
     2690         assign
     2691           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2692           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2693         .
     2694       end.
     2695     end.
     2696     else do:
     2697       assign
     2698         v-bge-xml-bgecliiv = no
     2699       .
     2700       return .
     2701     end.
     2702     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2703     if available buf_tt-bge-xml-bgecliiv
     2704     then do:
     2705       assign
     2706         v-bge-xml-bgecliiv = yes
     2707       .
     2708     end.
     2709   end.
     2710   end procedure.
     2711   procedure bge-xml-resolve-ext-doc-type :
     2712     define input  parameter p-ext-doc-type      as character no-undo .
     2713     define input  parameter p-obj-type          as character no-undo .
     2714     define input  parameter p-obj-code          as integer   no-undo .
     2715     define output parameter p-out-ext-doc-type  as character no-undo .
     2716     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2717   do
     2718   on error undo, return error return-value
     2719   :
     2720     assign
     2721       p-out-ext-doc-type = p-ext-doc-type
     2722     .
     2723     if p-ext-doc-type <> 'ie':U
     2724     then do:
     2725       return .
     2726     end.
     2727     if v-bge-xml-bgecliiv = yes
     2728     then do:
     2729       find first buf_tt-bge-xml-bgecliiv no-lock
     2730         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2731           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2732       no-error .
     2733       if available buf_tt-bge-xml-bgecliiv
     2734       then do:
     2735         assign
     2736           p-out-ext-doc-type = 'iv':U
     2737         .
     2738       end.
     2739     end.
     2740   end.
     2741   end procedure.
     2742   procedure safe-wp-xmltagput :
     2743     define input  parameter pTagLevel   as integer   no-undo .
     2744     define input  parameter pTagName    as character no-undo .
     2745     define input  parameter pParValue   as character no-undo .
     2746     define input  parameter pFlagEmpty  as integer   no-undo .
     2747   do
     2748   on error undo, return error return-value
     2749   :
     2750     if v-bge-xml-bgeflold = "oracle":u
     2751     then do:
     2752       return .
     2753     end.
     2754     run wp-xmltagput in this-procedure ( input pTagLevel
     2755                                        , input pTagName
     2756                                        , input pParValue
     2757                                        , input pFlagEmpty
     2758                                        ).
     2759   end.
     2760   end procedure.
     2761   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
