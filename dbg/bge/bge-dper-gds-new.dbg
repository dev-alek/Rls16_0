      791                           assign
      792                               p-out-string = p-out-string + " ":U
      793                           .
      794                       end.
      795                       when chr(4)
      796                       then do:
      797                           assign
      798                               p-out-string = p-out-string + " ":U
      799                           .
      800                       end.
      801                       when chr(5)
      802                       then do:
      803                           assign
      804                               p-out-string = p-out-string + " ":U
      805                           .
      806                       end.
      807                       when chr(6)
      808                       then do:
      809                           assign
      810                               p-out-string = p-out-string + " ":U
      811                           .
      812                       end.
      813                       when chr(7)
      814                       then do:
      815                           assign
      816                               p-out-string = p-out-string + " ":U
      817                           .
      818                       end.
      819                       when chr(8)
      820                       then do:
      821                           assign
      822                               p-out-string = p-out-string + " ":U
      823                           .
      824                       end.
      825                       when chr(9)
      826                       then do:
      827                           assign
      828                               p-out-string = p-out-string + " ":U
      829                           .
      830                       end.
      831                       when chr(29)
      832                       then do:
      833                           assign
      834                               p-out-string = p-out-string + " ":U
      835                           .
      836                       end.
