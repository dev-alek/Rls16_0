       41   procedure vss-get-info :
       42     define output parameter p-vss-revision    like vss-revision    no-undo .
       43     define output parameter p-vss-author      like vss-author      no-undo .
       44     define output parameter p-vss-date        like vss-date        no-undo .
       45     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       46     define output parameter p-vss-archive     like vss-archive     no-undo .
       47     define output parameter p-vss-description like vss-description no-undo .
