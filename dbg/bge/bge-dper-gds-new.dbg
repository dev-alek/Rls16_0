     4846     then do:
     4847       ASSIGN
     4848         date_from :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date18 :HANDLE
     4849         date_from :MENU-MOUSE in frame Dialog-Frame = 3
     4850       .
     4851     end.
     4852     define variable v-label-handle18 as handle no-undo .
     4853     assign
     4854       v-label-handle18 = date_from :side-label-handle in frame Dialog-Frame
     4855     .
     4856     if valid-handle (v-label-handle18)
     4857     then do:
     4858       if v-label-handle18 :tooltip = ""
     4859       or v-label-handle18 :tooltip = ?
     4860       then do:
     4861         assign
     4862           v-label-handle18 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     4863         .
     4864       end.
     4865     end.
     4866     ON CHOOSE OF MENU-ITEM m-ed-date18-1 in menu m-ed-date18 DO:
     4867       apply "ctrl-b":U to date_from in frame Dialog-Frame .
     4868     END.
     4869     ON CHOOSE OF MENU-ITEM m-ed-date18-2 in menu m-ed-date18 DO:
     4870       apply "ctrl-d":U to date_from in frame Dialog-Frame .
     4871     END.
     4872     ON CHOOSE OF MENU-ITEM m-ed-date18-3 in menu m-ed-date18 DO:
