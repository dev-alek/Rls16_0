     3072               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3073               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3074               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3075               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3076               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3077               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3078               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3079               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
     3080               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
     3081         otherwise do:
     3082               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
     3083         end.
     3084       end.
     3085     end.
     3086   end procedure.
     3087   procedure schedule-attr-value :
     3088   do
     3089   on error undo, return error return-value
     3090   :
     3091   define input parameter  p-cre-db-num as integer    no-undo.
     3092   define input parameter  p-task-type  as character  no-undo.
     3093   define input parameter  p-task-num   as integer    no-undo.
     3094   define input parameter  p-code       as character  no-undo.
     3095   define output parameter p-value      as character  no-undo.
     3096   define output parameter p-type       as character  no-undo.
     3097       define variable v-format         as character no-undo .
     3098       define variable v-label          as character no-undo .
     3099       define variable v-user-can-edit  as logical   no-undo .
     3100       define variable v-output-display as logical   no-undo .
     3101       define variable v-other          as character no-undo .
     3102       define buffer buf_schedule-attr for ub.schedule-attr.
     3103       run schedule-attr-name in this-procedure (
     3104             input  p-code
     3105           , output p-type
     3106           , output v-format
     3107           , output v-label
     3108           , output v-user-can-edit
     3109           , output v-output-display
     3110           , output v-other
     3111       ) no-error .
     3112       if error-status :error
     3113       then do:
     3114           undo, return error return-value .
     3115       end.
     3116       if p-code begins ('schd-free-id':U + chr(4))
     3117       and entry(2, p-code, chr(4)) = '':U then do:
     3118         find first buf_schedule-attr no-lock
     3119             where buf_schedule-attr.cre-db-num = p-cre-db-num
     3120               and buf_schedule-attr.task-type  = p-task-type
     3121               and buf_schedule-attr.task-num   = p-task-num
     3122               and buf_schedule-attr.attr-code  begins p-code
     3123         no-error .
     3124       end.
     3125       else do:
     3126         find first buf_schedule-attr no-lock
     3127             where buf_schedule-attr.cre-db-num = p-cre-db-num
     3128               and buf_schedule-attr.task-type  = p-task-type
     3129               and buf_schedule-attr.task-num   = p-task-num
     3130               and buf_schedule-attr.attr-code  = p-code
     3131         no-error .
     3132       end.
     3133       if available buf_schedule-attr
     3134       then do:
     3135           assign
     3136               p-value = buf_schedule-attr.attr-value
     3137           .
     3138       end.
     3139       else do:
     3140         if p-code begins ('schd-free-id':U + chr(4) ) then do:
     3141            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
     3142         end.
     3143         else do:
     3144           assign
     3145               p-value = if p-type = 'L':U then "no":U else ""
     3146           .
     3147         end.
     3148       end.
     3149   end.
     3150   end procedure.
     3151   procedure schedule-attr-write :
     3152   do
     3153   on error undo, return error
     3154   :
     3155   define input parameter p-cre-db-num  as integer   no-undo.
     3156   define input parameter p-task-type   as character no-undo.
     3157   define input parameter p-task-num    as integer   no-undo.
     3158   define input parameter p-code        as character no-undo.
     3159   define input parameter p-value       as character no-undo.
     3160       define variable v-type              as character                no-undo.
     3161       define variable v-format            as character                no-undo.
     3162       define variable v-label             as character                no-undo.
     3163       define variable v-user-can-edit     as logical                  no-undo.
     3164       define variable v-output-display    as logical                  no-undo.
     3165       define variable v-other             as character                no-undo.
     3166       define buffer buf_schedule-attr for ub.schedule-attr .
     3167       run schedule-attr-name in this-procedure (
     3168             input  p-code
     3169           , output v-type
     3170           , output v-format
     3171           , output v-label
     3172           , output v-user-can-edit
     3173           , output v-output-display
     3174           , output v-other
     3175       ) no-error.
     3176       if error-status :error
     3177       then do:
     3178           undo, return error return-value.
     3179       end.
     3180       find first buf_schedule-attr exclusive-lock
     3181            where buf_schedule-attr.cre-db-num = p-cre-db-num
     3182              and buf_schedule-attr.task-type  = p-task-type
     3183              and buf_schedule-attr.task-num   = p-task-num
     3184              and buf_schedule-attr.attr-code  = p-code
     3185       no-error.
     3186       if not available buf_schedule-attr
     3187       then do:
     3188           create buf_schedule-attr.
     3189           assign
     3190             buf_schedule-attr.cre-db-num = p-cre-db-num
     3191             buf_schedule-attr.task-type  = p-task-type
     3192             buf_schedule-attr.task-num   = p-task-num
     3193             buf_schedule-attr.attr-code  = p-code
     3194             buf_schedule-attr.attr-value = p-value
     3195           .
     3196       end.
     3197       else do:
     3198           assign
     3199               buf_schedule-attr.attr-value = p-value
     3200           .
     3201       end.
     3202   end.
     3203   end procedure.
     3204   procedure schedule-attr-delete :
     3205   do
     3206   on error undo, return error
     3207   :
     3208   define input  parameter p-cre-db-num  as integer   no-undo.
     3209   define input  parameter p-task-type   as character no-undo.
     3210   define input  parameter p-task-num    as integer   no-undo.
     3211   define input  parameter p-code        as character no-undo.
     3212   define output parameter p-deleted     as logical   no-undo.
     3213       define buffer buf_schedule-attr for ub.schedule-attr .
     3214       define variable v-type              as character                no-undo.
     3215       define variable v-format            as character                no-undo.
     3216       define variable v-label             as character                no-undo.
     3217       define variable v-user-can-edit     as logical                  no-undo.
     3218       define variable v-output-display    as logical                  no-undo.
     3219       define variable v-other             as character                no-undo.
     3220       run schedule-attr-name in this-procedure (
     3221             input p-code
     3222           , output v-type
     3223           , output v-format
     3224           , output v-label
     3225           , output v-user-can-edit
     3226           , output v-output-display
     3227           , output v-other
     3228       ) no-error .
     3229       if error-status :error
     3230       then do:
     3231           undo, return error return-value .
     3232       end.
     3233       find first buf_schedule-attr exclusive-lock
     3234            where buf_schedule-attr.cre-db-num = p-cre-db-num
     3235              and buf_schedule-attr.task-type  = p-task-type
     3236              and buf_schedule-attr.task-num   = p-task-num
     3237              and buf_schedule-attr.attr-code  = p-code
     3238       no-error.
     3239       if not available buf_schedule-attr
     3240       then do:
     3241           assign
     3242               p-deleted = no
     3243           .
     3244       end.
     3245       else do:
     3246           delete buf_schedule-attr.
     3247           assign
     3248               p-deleted = yes
     3249           .
     3250       end.
     3251   end.
     3252   end procedure.
     3253   procedure schedule-attr-news :
     3254   do
     3255   on error undo, return error
     3256   :
     3257       define input  parameter p-code           as character no-undo .
     3258       define output parameter p-news           as logical   no-undo .
     3259       if index(p-code, chr(4)) > 0 then do:
     3260         p-code = entry(1, p-code, chr(4)).
     3261       end.
     3262       case p-code :
     3263               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
     3264               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
     3265               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
     3266               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
     3267               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
     3268               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
     3269               when 'schedule-filter':U then do:     assign     p-news = false.   end.
     3270               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
     3271               when 'schd-free-id':U then do:     assign     p-news = false.   end.
     3272         otherwise do:
     3273           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
     3274         end.
     3275       end.
     3276   end.
     3277   end procedure.
     3278   procedure schedule-attr-extract-logical :
     3279   do
     3280   on error undo, return error
     3281   :
     3282   define input  parameter p-parameter-number   as integer      no-undo.
     3283   define input  parameter p-parameter-list     as character    no-undo.
     3284   define output parameter p-parameter-value   as logical      no-undo.
     3285       if num-entries( p-parameter-list ) > p-parameter-number - 1
     3286       then do:
     3287           assign
     3288               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     3289           .
     3290       end.
     3291       else do:
     3292           assign
     3293               p-parameter-value   = no
     3294           .
     3295       end.
     3296   end.
     3297   end procedure.
     3298   procedure schedule-attr-get-free-id :
     3299   do
     3300   on error undo, return error return-value
     3301   :
     3302     define input  parameter p-cre-db-num  as integer   no-undo.
     3303     define input  parameter p-task-type   as character no-undo.
     3304     define input  parameter p-task-num    as integer   no-undo.
     3305     define output parameter p-free-id     as character no-undo.
     3306     define buffer buf_schedule-attr for ub.schedule-attr.
     3307     find first buf_schedule-attr no-lock
     3308         where buf_schedule-attr.cre-db-num = p-cre-db-num
     3309           and buf_schedule-attr.task-type  = p-task-type
     3310           and buf_schedule-attr.task-num   = p-task-num
     3311           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     3312     no-error .
     3313     if available buf_schedule-attr then
     3314     assign
     3315     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     3316     no-error
     3317     .
     3318   end.
     3319   end procedure.
     3320   procedure schedule-attr-get-free-props :
     3321     define input parameter p-free-id as character no-undo .
     3322     define output parameter p-value as character no-undo .
     3323     define buffer buf_temp-schedule-free for temp-schedule-free.
     3324     do
     3325     on error undo, return error return-value
     3326     :
     3327       find first buf_temp-schedule-free no-lock no-error .
     3328       if not available buf_temp-schedule-free then do:
     3329         run schedule-attr-fill-free-props in this-procedure .
     3330       end.
     3331       find first buf_temp-schedule-free where
     3332               buf_temp-schedule-free.free-id = p-free-id no-error.
     3333       if available buf_temp-schedule-free then do:
     3334         assign
     3335         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     3336                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     3337                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     3338                   buf_temp-schedule-free.conf-param           + chr(4) +
     3339                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     3340                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     3341                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     3342                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     3343                   buf_temp-schedule-free.other-info
     3344         .
     3345       end.
     3346       else do:
     3347        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     3348                              "id произвольной задачи - &5"
     3349                              ,vss-workfile
     3350                              ,vss-revision
     3351                              ,vss-description
     3352                              ,chr(10)
     3353                              ,p-free-id).
     3354       end.
     3355     end.
     3356   end procedure.
     3357   procedure schedule-attr-is-rum-free-id :
     3358   define input parameter p-free-id as character no-undo .
     3359   define output parameter p-is-rum as logical no-undo .
     3360   define buffer buf_temp-schedule-free for temp-schedule-free.
     3361   do
     3362   on error undo, return error
     3363   :
     3364       find first buf_temp-schedule-free no-lock no-error .
     3365       if not available buf_temp-schedule-free then do:
     3366         run schedule-attr-fill-free-props in this-procedure .
     3367       end.
     3368       find first buf_temp-schedule-free where
     3369               buf_temp-schedule-free.free-id = p-free-id no-error.
     3370       if available buf_temp-schedule-free
     3371       and buf_temp-schedule-free.is-rum
     3372       then do:
     3373         p-is-rum = yes.
     3374       end.
     3375   end.
     3376   end procedure.
     3377   procedure schedule-attr-fill-free-props :
     3378   define variable v-path                    as character                no-undo .
     3379   DEFINE VARIABLE v-full-path               as character                no-undo .
     3380   DEFINE VARIABLE v-file-name               as character                no-undo .
     3381   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     3382   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     3383   define buffer buf_temp-schedule-free for temp-schedule-free.
     3384   define variable v-answer as logical no-undo .
     3385     do
     3386     on error undo, return error substitute("&1 &2 &3&4&5&4"
     3387                                           ,vss-workfile
     3388                                           ,vss-revision
     3389                                           ,vss-description
     3390                                           ,chr(10)
     3391                                           ,error-status:get-message(1) )
     3392     :
     3393       run gbl/filename.p (
     3394                       input 'cmp/shd-free.d'
     3395                     ,output v-full-path
     3396                     ,output v-path
     3397                     ,output v-file-name
     3398                     ,output v-file-name-no-ext
     3399                     ,output v-file-name-ext
     3400                     ) .
     3401       input from value(v-full-path).
     3402       repeat :
     3403         create buf_temp-schedule-free.
     3404         import buf_temp-schedule-free.
     3405       END.
     3406       input close.
     3407       _ff:
     3408       for each buf_temp-schedule-free :
     3409         if buf_temp-schedule-free.free-id = '':U then do:
     3410            delete buf_temp-schedule-free.
     3411            next _ff.
     3412          end.
     3413          run schedule-attr-check-enc in this-procedure (
     3414                                                       input  buf_temp-schedule-free.free-id
     3415                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     3416                                                               buf_temp-schedule-free.proc-param-edit-name +
     3417                                                               buf_temp-schedule-free.conf-param +
     3418                                                               string(buf_temp-schedule-free.is-gbd) +
     3419                                                               string(buf_temp-schedule-free.is-ubd) +
     3420                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     3421                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     3422                                                               string(buf_temp-schedule-free.other-info)
     3423                                                               )
     3424                                                       ,input  buf_temp-schedule-free.enc-key
     3425                                                       ,output v-answer    ) no-error .
     3426          if error-status:error
     3427          or not v-answer then delete buf_temp-schedule-free.
     3428        end.
     3429     end.
     3430   end procedure.
     3431   Function schedule-attr-reverse returns character (str as character).
     3432      define variable rev_incl_s as character init "" no-undo .
     3433      define variable rev_incl_i as integer no-undo .
     3434      define variable rev_incl_l as integer no-undo .
     3435      rev_incl_l = length(str).
     3436      do rev_incl_i = 1 to rev_incl_l:
     3437         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     3438      end.
     3439      return rev_incl_s.
     3440   end.
     3441   procedure schedule-attr-check-enc.
     3442     define input  parameter p-free-id   as character no-undo .
     3443     define input  parameter p-value     as character no-undo .
     3444     define input  parameter p-enc-value as character no-undo .
     3445     define output parameter p-answer    as logical   no-undo .
     3446     define variable tmp         as character no-undo .
     3447     define variable v-enc-value as character no-undo .
     3448     assign
     3449     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     3450     .
     3451     run schedule-attr-pswd-enc in this-procedure
     3452       ( input tmp
     3453        ,output v-enc-value
     3454       ) no-error .
     3455     if error-status:error then do:
     3456       message
     3457         vss-workfile vss-revision vss-description skip
     3458         "Ошибка при вызове процедуры pswd-enc" skip
     3459         return-value skip
     3460         error-status :get-message(1) skip
     3461         view-as alert-box error .
     3462       undo, return error .
     3463     end.
     3464     if v-enc-value = p-enc-value then do:
     3465       assign
     3466         p-answer = true
     3467       .
     3468     end.
     3469     else do:
     3470       assign
     3471         p-answer = false
     3472       .
     3473     end.
     3474   end.
     3475   procedure schedule-attr-conf-enc.
     3476     define input  parameter p-free-id   as character no-undo .
     3477     define input  parameter p-value     as character no-undo .
     3478     define output parameter p-enc-value as character no-undo .
     3479     define variable tmp         as character no-undo .
     3480     assign
     3481       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     3482     .
     3483     run schedule-attr-pswd-enc in this-procedure
     3484       ( input tmp
     3485        ,output p-enc-value
     3486       ) no-error .
     3487     if error-status:error then do:
     3488       message
     3489         vss-workfile vss-revision vss-description skip
     3490         "Ошибка при вызове процедуры pswd-enc" skip
     3491         return-value skip
     3492         error-status :get-message(1) skip
     3493         view-as alert-box error .
     3494       undo, return error .
     3495     end.
     3496   end procedure.
     3497   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3498   procedure schedule-attr-pswd-enc :
     3499     define input parameter  pswd     as character no-undo .
     3500     define output parameter enc-pswd as character no-undo .
     3501     do
     3502     on error undo, return error return-value
     3503     :
     3504       assign
     3505         enc-pswd = encode(pswd + string(index(pswd, "k")))
     3506       .
     3507     end.
     3508   end procedure.
     3509   define variable vss-include-info10 as character format "X(65)" no-undo
     3510   initial "@(#)$Workfile$ $Revision$".
