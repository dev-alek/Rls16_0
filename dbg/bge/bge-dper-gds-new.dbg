     3768        SIZE 41 BY .83 NO-UNDO.
     3769   DEFINE FRAME Dialog-Frame
     3770        btn_save AT ROW 1.25 COL 1.5
     3771        Btn_start AT ROW 1.25 COL 1.63
     3772        Btn_Cancel AT ROW 1.25 COL 11.63
     3773        b-help AT ROW 1.5 COL 86
     3774        v-per AT ROW 3 COL 15 COLON-ALIGNED WIDGET-ID 20
     3775        code_pool AT ROW 3 COL 62 COLON-ALIGNED WIDGET-ID 28
     3776        date_from AT ROW 3.14 COL 8.2 COLON-ALIGNED
     3777        date_to AT ROW 3.14 COL 25.2 COLON-ALIGNED
     3778        time-days AT ROW 3.14 COL 28 NO-LABEL WIDGET-ID 52
     3779        tb-supp AT ROW 4.52 COL 10.4
     3780        bt-dc-card AT ROW 4.76 COL 77.6 WIDGET-ID 42
     3781        ed-object AT ROW 4.95 COL 20.8 NO-LABEL
     3782        rs-1 AT ROW 5.05 COL 3 NO-LABEL
     3783        v-dc-card AT ROW 6.24 COL 58.6 NO-LABEL WIDGET-ID 40
     3784        bt-sel-obj AT ROW 7.19 COL 17
     3785        ed-doc-type AT ROW 9.19 COL 16.8 NO-LABEL
     3786        bt-sel-doc-type AT ROW 9.19 COL 53.2
     3787        ed-doc-type-label AT ROW 9.24 COL 3 NO-LABEL
     3788        tb-inkass-pay-code AT ROW 11.52 COL 2.6
     3789        tb-deleted AT ROW 11.52 COL 36.6
     3790        v-place AT ROW 11.76 COL 59.6 NO-LABEL WIDGET-ID 22
     3791        tb-cst-code AT ROW 12.24 COL 2.6
     3792        tb-exp-checks AT ROW 12.24 COL 36.6 WIDGET-ID 2
     3793        tb-parts AT ROW 13 COL 2.6
     3794        tb-chk-pay-code AT ROW 13.76 COL 2.6
     3795        rs-cash-pay AT ROW 13.81 COL 40.7 NO-LABEL
     3796        v-directory AT ROW 14 COL 69 COLON-ALIGNED WIDGET-ID 54
     3797        tb-pay-desk AT ROW 14.67 COL 5.63
     3798        bt-cash-pay AT ROW 14.71 COL 48
     3799        v-ftp-address AT ROW 15.25 COL 69 COLON-ALIGNED WIDGET-ID 14
     3800        tb-pay-desk-cards AT ROW 15.5 COL 5.63
     3801        v-inf-bonus AT ROW 16.5 COL 2.5 WIDGET-ID 26
     3802        v-login AT ROW 16.5 COL 69 COLON-ALIGNED WIDGET-ID 16
     3803        v-password AT ROW 17.75 COL 69 COLON-ALIGNED WIDGET-ID 18
     3804        ed-doc-type-label-2 AT ROW 18.5 COL 3 NO-LABEL WIDGET-ID 12
     3805        rs-2 AT ROW 19.5 COL 3 NO-LABEL WIDGET-ID 6
     3806        list-chk-type AT ROW 22.25 COL 3 NO-LABEL WIDGET-ID 64
     3807        b-chk-type AT ROW 22.25 COL 27.5 WIDGET-ID 60
     3808        "Типы чеков:" VIEW-AS TEXT
     3809             SIZE 23.5 BY .92 AT ROW 21.25 COL 3 WIDGET-ID 62
     3810        "Дисконтные карты" VIEW-AS TEXT
     3811             SIZE 18.5 BY .75 AT ROW 5 COL 59 WIDGET-ID 44
     3812        RECT-2 AT ROW 9.04 COL 2
     3813        RECT-1 AT ROW 4.42 COL 1.75
     3814        RECT-3 AT ROW 11.42 COL 2
     3815        RECT-5 AT ROW 18.25 COL 2 WIDGET-ID 4
     3816        RECT-6 AT ROW 11.5 COL 58 WIDGET-ID 46
     3817        RECT-7 AT ROW 4.5 COL 57.5 WIDGET-ID 48
     3818        RECT-8 AT ROW 21 COL 2 WIDGET-ID 66
     3819        SPACE(60.37) SKIP(3.62)
     3820       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3821            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3822            TITLE "Диапазон дат для экспорта".
     3823   ASSIGN
     3824          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3825          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3826   ASSIGN
     3827          bt-cash-pay:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3828   ASSIGN
     3829          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3830   ASSIGN
     3831          ed-doc-type-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3832   ASSIGN
     3833          ed-doc-type-label-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3834   ASSIGN
     3835          rs-cash-pay:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3836   ASSIGN
     3837          tb-supp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3838   ASSIGN
     3839          time-days:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3840   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3841   DO:
     3842           APPLY "END-ERROR":U TO SELF.
     3843       END.
     3844   ON CHOOSE OF b-chk-type IN FRAME Dialog-Frame
     3845   DO:
     3846           run chk-type-choose in this-procedure.
     3847   END.
     3848   ON CHOOSE OF bt-cash-pay IN FRAME Dialog-Frame
     3849   DO:
     3850           run ref/cashpays.w (
     3851               INPUT parparentproc
     3852               ,INPUT "b-sel,b-mark":U
     3853               ,input 'все':U
     3854               ,input v-bge-dper-host-code
     3855               ,input v-bge-dper-store-type
     3856               ,input v-bge-dper-store-code
     3857               ,OUTPUT p-pay-type-list
     3858               ).
     3859       END.
     3860   ON CHOOSE OF bt-dc-card IN FRAME Dialog-Frame
     3861   DO:
     3862           define variable i        as integer   init 1 no-undo.
     3863           define variable p-num    as integer   no-undo.
     3864           define variable v-dc-num as char      init "" no-undo.
     3865           define variable v-rid    as character no-undo.
     3866           define buffer buf_dis-card for ub.dis-card .
     3867           run ref/discards.w
     3868               ( parParentProc
     3869               ,input "b-sel,b-mark":U
     3870               , 'все':U
     3871               , v-cntxt-host-code-obj
     3872               , v-cntxt-obj-type
     3873               , v-cntxt-obj-code
     3874               , ?
     3875               , ?
     3876               , output v-rid
     3877               ) .
     3878           p-num = num-entries(v-rid).
     3879           if v-rid = ""
     3880               then
     3881           do:
     3882               RETURN.
     3883           end.
     3884           v-dc-num-full = " ".
     3885           v-dc-card:SCREEN-VALUE  =  " ".
     3886           do while i <> p-num + 1 :
     3887               find first  buf_dis-card where  recid( buf_dis-card ) = INTEGER(ENTRY(i, v-rid))  no-lock no-error.
     3888               assign
     3889                   v-dc-num                = STRING(buf_dis-card.d-card)
     3890                   v-dc-num-full           = STRING(buf_dis-card.d-card) + ',' + v-dc-num-full
     3891                   v-dc-card :SCREEN-VALUE = v-dc-num +  chr(10) + v-dc-card :SCREEN-VALUE.
     3892               .
     3893               i = i + 1.
     3894           end.
     3895           i = 1.
     3896       end.
     3897   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
     3898   DO:
     3899           define variable v-cancel as logical no-undo.
     3900           run bge/bgeseltp.w (
     3901               input "trn-doc":U
     3902               , input p-init-doc-type-list
     3903               , output p-doc-type-list
     3904               , output v-cancel
     3905               ) no-error.
     3906           if error-status :error
     3907               then
     3908           do:
     3909               message
     3910                   vss-workfile vss-revision vss-description
     3911                   skip
     3912                   "Ошибка выбора типов операций."
     3913                   skip return-value
     3914                   skip trim(error-status :get-message(1))
     3915                   trim(error-status :get-message(2))
     3916                   trim(error-status :get-message(3))
     3917                   trim(error-status :get-message(4))
     3918                   trim(error-status :get-message(5))
     3919                   view-as alert-box error.
     3920               undo, return no-apply .
     3921           end.
     3922           if v-cancel = yes
     3923               then
     3924           do:
     3925               assign
     3926                   p-doc-type-list = p-init-doc-type-list
     3927                   .
     3928           end.
     3929           else
     3930           do:
     3931               assign
     3932                   p-init-doc-type-list = p-doc-type-list
     3933                   .
     3934               if p-doc-type-list = ''
     3935                   then
     3936               do:
     3937                   assign
     3938                       ed-doc-type :screen-value in frame Dialog-Frame = "Все"
     3939                       .
     3940               end.
     3941               else
     3942               do:
     3943                   assign
     3944                       ed-doc-type :screen-value in frame Dialog-Frame = ''
     3945                       .
     3946                   for each temp_ext-doc-type
     3947                       :
     3948                       if lookup( temp_ext-doc-type.ext-doc-type, p-init-doc-type-list ) <> 0
     3949                           then
     3950                       do:
     3951                           assign
     3952                               ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     3953                                                       + temp_ext-doc-type.ext-doc-type-label + chr(10)
     3954                               .
     3955                       end.
     3956                   end.
     3957               end.
     3958           end.
     3959       END.
     3960   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     3961   DO:
     3962           define variable v-host-code like ub.sysconf.host-code no-undo .
     3963           assign
     3964               rs-1 :screen-value = "3"
     3965               .
     3966           define variable v-object-available as logical no-undo .
     3967   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3968   run userobjs_clear in this-procedure  .
     3969   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3970   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     3971     (input  v-cntxt-db-num
     3972     ,input  0
     3973     ,input  v-cntxt-userid
     3974     ,input  v-bge-dper-store-type
     3975     ,input  v-bge-dper-store-code
     3976     ,output v-object-available
     3977     ) no-error .
     3978           if error-status :error
     3979               then
     3980           do:
     3981               message
     3982                   vss-workfile vss-revision vss-description skip
     3983                   "Ошибка при вызове процедуры gbl/usobjava.i" skip
     3984                   error-status :get-message(1) skip
     3985                   return-value skip
     3986                   view-as alert-box error .
     3987               undo, return no-apply .
     3988           end.
     3989           if v-object-available = true
     3990               then
     3991           do:
     3992   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3993   run userobjs_append in this-procedure
     3994     (input  v-bge-dper-store-type
     3995     ,input  v-bge-dper-store-code
     3996     )  .
     3997           end.
     3998           define variable v-user-select as logical no-undo .
     3999   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4000   run userobjs_select-many in this-procedure
     4001     (input  parparentproc
     4002     ,input  v-cntxt-db-num
     4003     ,input  v-cntxt-userid
     4004     ,input  v-cntxt-host-code-obj
     4005     ,input  v-cntxt-obj-type
     4006     ,input  v-cntxt-obj-code
     4007     ,output v-user-select
     4008     )  .
     4009           if v-user-select <> true
     4010               then
     4011           do:
     4012               message
     4013                   "Объект не выбран"
     4014                   view-as alert-box information .
     4015               return no-apply .
     4016           end.
     4017           define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4018           for each temp_obj-list:
     4019               delete temp_obj-list.
     4020           end.
     4021           for each buf_userobjs_temp-user-obj
     4022               on error undo, return no-apply
     4023               :
     4024               create temp_obj-list.
     4025               assign
     4026                   temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     4027                   temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     4028                   .
     4029           end.
     4030           assign
     4031               v-obj-list = ""
     4032               .
     4033           for each temp_obj-list
     4034               :
     4035               assign
     4036                   v-obj-list = v-obj-list + (if v-obj-list <> "" then ", " else "" )
     4037                                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code ).
     4038           end.
     4039           assign
     4040               ed-object :screen-value = v-obj-list
     4041               .
     4042       END.
     4043   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     4044   DO:
     4045           assign
     4046               p-cancel = yes
     4047               .
     4048           apply "window-close" to frame Dialog-Frame.
     4049       END.
     4050   ON CHOOSE OF btn_save IN FRAME Dialog-Frame
     4051   DO:
     4052           DEFINE VARIABLE l-dircrt AS LOGICAL.
     4053           ASSIGN
     4054               v-directory
     4055               v-ftp-address
     4056               v-login
     4057               v-password
     4058               v-place
     4059               fi-pack-lim = 90
     4060               date_from
     4061               date_to
     4062               tb-inkass-pay-code
     4063               tb-cst-code
     4064               tb-parts
     4065               tb-deleted
     4066               tb-supp
     4067               tb-exp-checks
     4068               rs-1
     4069               rs-2
     4070               tb-chk-pay-code
     4071               tb-pay-desk
     4072               tb-pay-desk-cards
     4073               v-per
     4074               code_pool
     4075               v-inf-bonus.
     4076           date_exp_from = date_from.
     4077           date_exp_to   = date_to.
     4078           .
     4079           assign
     4080               p-chk      = tb-exp-checks
     4081               p-gds-type = rs-2
     4082               .
     4083           if date_from > date_to
     4084               and p-output-type <> 4
     4085               and p-output-type <> 5
     4086               then
     4087           do:
     4088               message
     4089                   "Даты интервала заданы неверно. "
     4090                   skip
     4091                   " Нижняя дата интервала должна быть меньше верхней."
     4092                   skip(1) "Задайте интервал дат правильно или отмените экспорт."
     4093                   view-as alert-box information.
     4094               apply "entry" to date_from.
     4095               undo, return no-apply.
     4096           end.
     4097           if p-output-type = 0
     4098               then
     4099           do:
     4100               case rs-1 :screen-value
     4101                   :
     4102                   when "1"
     4103                   then
     4104                       do:
     4105                           assign
     4106                               p-range    = 1
     4107                               p-obj-list = ""
     4108                               .
     4109                       end.
     4110                   when "2"
     4111                   then
     4112                       do:
     4113                           assign
     4114                               p-range    = 2
     4115                               p-obj-list = ""
     4116                               .
     4117                       end.
     4118                   when "3"
     4119                   then
     4120                       do:
     4121                           assign
     4122                               p-range    = 3
     4123                               p-obj-list = ""
     4124                               .
     4125                           for each temp_obj-list
     4126                               :
     4127                               assign
     4128                                   p-obj-list = p-obj-list
     4129                             + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     4130                             + "," + string( temp_obj-list.obj-code )
     4131                                   .
     4132                           end.
     4133                       end.
     4134               end case.
     4135           end.
     4136           if p-output-type = 2
     4137               then
     4138           do:
     4139               assign
     4140                   p-cst       = tb-supp
     4141                   p-range     = 2
     4142                   p-host-code = v-bge-dper-host-code
     4143                   p-obj-list  = ""
     4144                   .
     4145           end.
     4146           if p-output-type = 1
     4147               or p-output-type = 3
     4148               or p-output-type = 4
     4149               or p-output-type = 5
     4150               or p-output-type = 6
     4151               then
     4152           do:
     4153               if p-output-type = 1
     4154                   then
     4155               do:
     4156                   assign
     4157                       p-pay-code       = tb-inkass-pay-code
     4158                       p-cst            = tb-cst-code
     4159                       p-parts          = tb-parts
     4160                       p-deleted        = tb-deleted
     4161                       p-chk-pay-code   = tb-chk-pay-code
     4162                       p-pay-desk       = tb-pay-desk
     4163                       p-pay-desk-cards = tb-pay-desk-cards
     4164                       .
     4165               end.
     4166               case rs-1 :screen-value
     4167                   :
     4168                   when "1"
     4169                   then
     4170                       do:
     4171                           assign
     4172                               p-range    = 1
     4173                               p-obj-list = ""
     4174                               .
     4175                       end.
     4176                   when "2"
     4177                   then
     4178                       do:
     4179                           assign
     4180                               p-range     = 2
     4181                               p-host-code = v-bge-dper-host-code
     4182                               p-obj-list  = ""
     4183                               .
     4184                       end.
     4185                   when "3"
     4186                   then
     4187                       do:
     4188                           assign
     4189                               p-range    = 3
     4190                               p-obj-list = ""
     4191                               .
     4192                           for each temp_obj-list
     4193                               :
     4194                               assign
     4195                                   p-obj-list = p-obj-list
     4196                               + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     4197                               + "," + string( temp_obj-list.obj-code )
     4198                                   .
     4199                           end.
     4200                       end.
     4201               end case.
     4202           end.
     4203           if v-place = 2 then
     4204           do:
     4205               IF trim(v-ftp-address) = '':U
     4206                   THEN
     4207               DO:
     4208                   message
     4209                       "Не задано FTP адрес"
     4210                       view-as alert-box error .
     4211                   return no-apply.
     4212               END.
     4213           end.
     4214           v-directory = right-trim(v-directory,'/\') + '\'.
     4215           if v-place = 1 then
     4216           do:
     4217               file-info:file-name = v-directory.
     4218               if file-info:file-type = ? then
     4219               do:
     4220                   message substitute("Директории &1 не существует.",v-directory) skip
     4221                       "Создать?" view-as alert-box warning buttons yes-no update l-dircrt.
     4222                   if l-dircrt then
     4223                   do:
     4224                       os-create-dir value(v-directory).
     4225                       if os-error <> 0 then
     4226                       do:
     4227                           message substitute("Невозможно создать директорию &1",v-directory) view-as alert-box error.
     4228                           leave.
     4229                       end.
     4230                   end.
     4231                   else leave.
     4232               end.
     4233               else
     4234               do:
     4235                   if not (file-info:file-type begins "D":U) then
     4236                   do:
     4237                       message substitute("&1 не является директорией.",v-directory) view-as alert-box error.
     4238                       leave.
     4239                   end.
     4240               end.
     4241           end.
     4242           if v-place = 1 then   v-param-list =   string(v-place) + chr(4) + v-directory + chr(4) + string(v-per) +  chr(4) + string(p-range)
     4243                   +  chr(4) + string(p-host-code) +  chr(4) + p-obj-list
     4244                   + chr(4) + p-pay-type-list +  chr(4) + p-gds-type +  chr(4) + p-doc-type-list  +
     4245                   chr(4) + v-dc-num-full +
     4246                   chr(4) + string(v-inf-bonus) + chr(4) + code_pool + chr(4)  +  string(tb-pay-desk-cards)  + chr(4) +  string(tb-pay-desk)  + chr(4) +  string(tb-parts) +
     4247                   chr(4) + string(tb-inkass-pay-code) + chr(4) + string(tb-deleted) + chr(4) + string(tb-chk-pay-code) + chr(4) +  string(tb-cst-code) + chr(4) + string(tb-exp-checks) + chr(4) + rs-2 + chr(4) + chr-list-chk-type
     4248                   .
     4249           if v-place = 2 then
     4250           do:
     4251               v-ftp-address = trim(trim(replace(v-ftp-address,'ftp:',""),chr(47)),chr(92)).
     4252               v-param-list = string(v-place) + chr(4) +   v-ftp-address + chr(4)  + string(v-per) +  chr(4) + v-login   + chr(4) + v-password  + chr(4) + string(p-range)
     4253                   +  chr(4) + string(p-host-code) +  chr(4) + p-obj-list
     4254                   + chr(4) + p-pay-type-list +  chr(4) + p-gds-type +  chr(4) + p-doc-type-list  +
     4255                   chr(4) + v-dc-num-full +
     4256                   chr(4) + string(v-inf-bonus) + chr(4) + code_pool + chr(4) +  string(tb-pay-desk-cards)  + chr(4) +  string(tb-pay-desk)  + chr(4) +  string(tb-parts) +
     4257                   chr(4) + string(tb-inkass-pay-code) + chr(4) + string(tb-deleted)  + chr(4) + string(tb-chk-pay-code) + chr(4) +  string(tb-cst-code) + chr(4) + string(tb-exp-checks)
     4258                   + chr(4) + rs-2 +  chr(4) + chr-list-chk-type
     4259                   .
     4260           end.
     4261           run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     4262           run schedule-attr-write in this-procedure (input p-db-num-char,
     4263               input p-task-type,
     4264               input p-task-num,
     4265               input 'schedule-obj-list':U,
     4266               input v-obj-list).
     4267           message "Параметры сохранены!" view-as alert-box information.
     4268           apply "go".
     4269       END.
     4270   ON CHOOSE OF Btn_start IN FRAME Dialog-Frame
     4271   DO:
     4272           DEFINE VARIABLE l-dircrt  AS LOGICAL       NO-UNDO.
     4273           define variable h-par     as widget-handle no-undo.
     4274           DEFINE variable loghandle AS HANDLE        no-undo.
     4275           DEFINE VARIABLE v-objects AS CHARACTER     NO-UNDO.
     4276           ASSIGN
     4277               v-directory
     4278               v-place
     4279               fi-pack-lim = 90
     4280               date_from
     4281               date_to
     4282               tb-inkass-pay-code
     4283               tb-cst-code
     4284               tb-parts
     4285               tb-deleted
     4286               v-ftp-address
     4287               v-login
     4288               v-password
     4289               tb-supp
     4290               tb-exp-checks
     4291               rs-1
     4292               rs-2
     4293               tb-chk-pay-code
     4294               tb-pay-desk
     4295               tb-pay-desk-cards
     4296               v-per
     4297               code_pool
     4298               v-inf-bonus
     4299           .
     4300           assign
     4301           date_exp_from = date_from
     4302           date_exp_to   = date_to
     4303           .
     4304           case v-place:
     4305               WHEN 2 then do:
     4306                       IF trim(v-ftp-address) > '':U THEN .
     4307                       ELSE DO:
     4308                           message "Не задан FTP адрес" view-as alert-box error .
     4309                           return no-apply.
     4310                       END.
     4311                   end.
     4312               OTHERWISE do:
     4313                   v-directory = right-trim(v-directory,'/\').
     4314                   file-info:file-name = v-directory.
     4315                   if file-info:file-name = " " then do:
     4316                       MESSAGE "Укажите директорию для выгрузки" VIEW-AS ALERT-BOX ERROR.
     4317                       leave.
     4318                   end.
     4319                   IF FILE-INFO:FILE-type = ? THEN DO:
     4320                       MESSAGE SUBSTITUTE("Директории &1 не существует.",v-directory) SKIP
     4321                           "Создать?" VIEW-AS ALERT-BOX WARNING BUTTONS YES-NO UPDATE l-dircrt.
     4322                       IF l-dircrt THEN DO:
     4323                           OS-CREATE-DIR VALUE(v-directory).
     4324                           IF OS-ERROR <> 0 THEN DO:
     4325                               MESSAGE SUBSTITUTE("Невозможно создать директорию &1",v-directory) VIEW-AS ALERT-BOX ERROR.
     4326                               leave.
     4327                           END.
     4328                       END.
     4329                       Else leave .
     4330                   END.
     4331                   ELSE DO:
     4332                       IF NOT (FILE-INFO:file-type BEGINS "D":U) THEN DO:
     4333                           MESSAGE SUBSTITUTE("&1 не является директорией.",v-directory) VIEW-AS ALERT-BOX ERROR.
     4334                           leave.
     4335                       END.
     4336                   END.
     4337                   ASSIGN
     4338                       v-ftp-address = "":U
     4339                   .
     4340               end.
     4341           END CASE.
     4342           FILE-INFO:FILE-NAME = v-directory.
     4343           assign
     4344               p-chk      = tb-exp-checks
     4345               p-gds-type = rs-2
     4346               .
     4347           if date_from > date_to
     4348               and p-output-type <> 4
     4349               and p-output-type <> 5
     4350               then
     4351           do:
     4352               message
     4353                   "Даты интервала заданы неверно. "
     4354                   skip
     4355                   " Нижняя дата интервала должна быть меньше верхней."
     4356                   skip(1) "Задайте интервал дат правильно или отмените экспорт."
     4357                   view-as alert-box information.
     4358               apply "entry" to date_from.
     4359               undo, return no-apply.
     4360           end.
     4361           if p-output-type = 0 then do:
     4362               case rs-1 :screen-value :
     4363                   when "1" then assign
     4364                               p-range    = 1
     4365                               p-obj-list = ""
     4366                               .
     4367                   when "2" then assign
     4368                               p-range    = 2
     4369                               p-obj-list = ""
     4370                               .
     4371                   when "3" then do:
     4372                           assign
     4373                               p-range    = 3
     4374                               p-obj-list = ""
     4375                               .
     4376                     for each temp_obj-list :
     4377                       p-obj-list = p-obj-list + substitute(",&1,&2", temp_obj-list.obj-type, temp_obj-list.obj-code) .
     4378                     end.
     4379                     p-obj-list = substring(p-obj-list, 2) .
     4380                   end.
     4381               end case.
     4382           end.
     4383           if p-output-type = 2 then
     4384           do:
     4385               assign
     4386                   p-cst       = tb-supp
     4387                   p-range     = 2
     4388                   p-host-code = v-bge-dper-host-code
     4389                   p-obj-list  = ""
     4390                   .
     4391           end.
     4392           if p-output-type = 1
     4393               or p-output-type = 3
     4394               or p-output-type = 4
     4395               or p-output-type = 5
     4396               or p-output-type = 6
     4397               then
     4398           do:
     4399               if p-output-type = 1
     4400                   then
     4401               do:
     4402                   assign
     4403                       p-pay-code       = tb-inkass-pay-code
     4404                       p-cst            = tb-cst-code
     4405                       p-parts          = tb-parts
     4406                       p-deleted        = tb-deleted
     4407                       p-chk-pay-code   = tb-chk-pay-code
     4408                       p-pay-desk       = tb-pay-desk
     4409                       p-pay-desk-cards = tb-pay-desk-cards
     4410                       .
     4411               end.
     4412               case rs-1 :screen-value :
     4413                   when "1" then assign
     4414                               p-range    = 1
     4415                               p-obj-list = ""
     4416                               .
     4417                   when "2" then assign
     4418                               p-range     = 2
     4419                               p-host-code = v-bge-dper-host-code
     4420                               p-obj-list  = ""
     4421                               .
     4422                   when "3" then do:
     4423                           assign
     4424                               p-range    = 3
     4425                               p-obj-list = ""
     4426                               .
     4427                     for each temp_obj-list :
     4428                       p-obj-list = p-obj-list + substitute(",&1,&2", temp_obj-list.obj-type, temp_obj-list.obj-code) .
     4429                     end.
     4430                     p-obj-list = substring(p-obj-list, 2) .
     4431                   end.
     4432               end case.
     4433           end.
     4434           if v-dc-card:screen-value = "" then v-dc-num-full = "".
     4435           if v-place = 1  then
     4436               run bge\bgecheck-new.p ( this-procedure:handle
     4437                   , v-directory
     4438                   , v-place
     4439                   , ""
     4440                   , ""
     4441                   , fi-pack-lim
     4442                   , date_exp_from
     4443                   , date_exp_to
     4444               , p-range
     4445               , p-host-code
     4446               , p-obj-list
     4447               , p-pay-type-list
     4448               , p-gds-type
     4449               , p-doc-type-list
     4450               ,  v-dc-num-full
     4451               , v-per
     4452               , v-inf-bonus
     4453               , code_pool,
     4454               chr-list-chk-type                ) .
     4455           if v-place = 2  then
     4456               run bge\bgecheck-new.p ( this-procedure:handle
     4457                   , v-ftp-address
     4458                   , v-place
     4459                   , v-login
     4460                   , v-password
     4461                   , fi-pack-lim
     4462                   , date_exp_from
     4463                   , date_exp_to
     4464                   , p-range
     4465                   , p-host-code
     4466                   , p-obj-list
     4467                   , p-pay-type-list
     4468                   , p-gds-type
     4469                   , p-doc-type-list
     4470                   ,  v-dc-num-full
     4471                   , v-per
     4472                   , v-inf-bonus
     4473                   , code_pool,
     4474                   chr-list-chk-type
     4475                   ) .
     4476           run flt-save in this-procedure .
     4477           APPLY "GO" TO FRAME Dialog-Frame.
     4478       END.
     4479   ON RETURN OF date_from IN FRAME Dialog-Frame
     4480   DO:
     4481           APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
     4482           RETURN NO-APPLY.
     4483       END.
     4484   ON RETURN OF date_to IN FRAME Dialog-Frame
     4485   DO:
     4486           APPLY "ENTRY" TO btn_start IN FRAME Dialog-Frame.
     4487           RETURN NO-APPLY.
     4488       END.
     4489   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
     4490   DO:
     4491           run object-select in this-procedure no-error .
     4492           if error-status :error
     4493               then
     4494           do:
     4495               undo, return no-apply.
     4496           end.
     4497           assign
     4498               rs-1
     4499               .
     4500       END.
     4501   ON VALUE-CHANGED OF rs-cash-pay IN FRAME Dialog-Frame
     4502   DO:
     4503           bt-cash-pay :SENSITIVE IN FRAME Dialog-Frame = LOGICAL(rs-cash-pay:SCREEN-VALUE IN FRAME Dialog-Frame).
     4504       END.
     4505   ON VALUE-CHANGED OF tb-chk-pay-code IN FRAME Dialog-Frame
     4506   DO:
     4507           assign
     4508               tb-chk-pay-code
     4509               .
     4510           rs-cash-pay :SENSITIVE IN FRAME Dialog-Frame = tb-chk-pay-code.
     4511           run manage-tb-chk-pay-code in this-procedure.
     4512       END.
     4513   ON VALUE-CHANGED OF v-place IN FRAME Dialog-Frame
     4514   DO:
     4515           ASSIGN
     4516               v-place
     4517               .
     4518           CASE v-place:
     4519               WHEN 2
     4520               THEN
     4521                   DO:
     4522                       DISABLE v-directory WITH FRAME Dialog-Frame.
     4523                       ENABLE
     4524                           v-ftp-address
     4525                           v-login
     4526                           v-password
     4527                           WITH FRAME Dialog-Frame.
     4528                       DISPLAY
     4529                           v-ftp-address
     4530                           v-login
     4531                           v-password
     4532                           WITH FRAME Dialog-Frame.
     4533                   END.
     4534               OTHERWISE
     4535               DO:
     4536                   DISABLE
     4537                       v-ftp-address
     4538                       v-login
     4539                       v-password
     4540                       WITH FRAME Dialog-Frame.
     4541                   enable v-directory WITH FRAME Dialog-Frame.
     4542                   display v-directory WITH FRAME Dialog-Frame.
     4543               END.
     4544           END CASE.
     4545       END.
     4546   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4547       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4548   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4549   on help of frame Dialog-Frame
     4550   do:
     4551     run gbl/app_help.p
     4552       (input this-procedure :file-name
     4553       ,input ''
     4554       ,input ?
     4555       ) no-error.
     4556     if error-status :error then do:
     4557       message
     4558         "Ошибка при вызове помощи"
     4559         error-status :get-message(1)
     4560         view-as alert-box .
     4561     end.
     4562   end.
     4563   run minbtn-set in this-procedure .
     4564   on choose of b-help in frame Dialog-Frame
     4565   do:
     4566     apply "help":u to frame Dialog-Frame .
     4567   end.
     4568   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4569   procedure minbtn-set :
     4570       do
     4571           on error undo, return error return-value
     4572           :
     4573           define variable ii              as integer       no-undo .
     4574           define variable fh              as widget-handle no-undo .
     4575           define variable hh              as widget-handle no-undo .
     4576           define variable v-h             as handle        extent 4 no-undo .
     4577           define variable v-name-button   as character     no-undo .
     4578           define variable v-help-old-x    as decimal       no-undo .
     4579           define variable v-help-old-y    as decimal       no-undo .
     4580           define variable v-help-old-size as decimal       no-undo .
     4581           define variable v-frame-width   as decimal       no-undo .
     4582           define variable jj              as integer       no-undo .
     4583           do
     4584               on error undo, return error
     4585               :
     4586               assign
     4587                   v-frame-width = frame Dialog-Frame:width - 0.3
     4588                   fh            = frame Dialog-Frame:first-child
     4589                   hh            = fh:first-child
     4590                   ii            = 1
     4591                   .
     4592               do while valid-handle(hh):
     4593                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4594                   do:
     4595                       case lc(hh:name) :
     4596                           when "b-help" then
     4597                               do:
     4598                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4599                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4600                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4601                                   hh:TOOLTIP = "Помощь" .
     4602                                   v-help-old-x = hh:column .
     4603                                   v-help-old-y = hh:row    .
     4604                                   v-help-old-size = hh:width .
     4605                                   hh:width-chars = 2.5 .
     4606                               end.
     4607                           when "b-print" then
     4608                               do:
     4609                                   hh:load-image("cmp/b-print.bmp":u) .
     4610                                   hh:TOOLTIP = "Печать" .
     4611                                   v-h[ii] = hh:handle .
     4612                                   ii = ii + 1 .
     4613                                   hh:width-chars = 3 .
     4614                               end.
     4615                           when "b-history" or
     4616                           when "b-hist" then
     4617                               do:
     4618                                   hh:load-image("cmp/b-hist.bmp":u) .
     4619                                   hh:TOOLTIP = "История" .
     4620                                   v-h[ii] = hh:handle .
     4621                                   ii = ii + 1 .
     4622                                   hh:width-chars = 3 .
     4623                               end.
     4624                           when "b-sch" then
     4625                               do:
     4626                                   hh:load-image("cmp/b-sch.bmp":u) .
     4627                                   hh:TOOLTIP = "Установка Фильтра" .
     4628                                   v-h[ii] = hh:handle .
     4629                                   ii = ii + 1 .
     4630                                   hh:width-chars = 3 .
     4631                               end.
     4632                           when "b-hist-user" then
     4633                               do:
     4634                                   hh:load-image("cmp/b-hist.bmp":u) .
     4635                                   hh:TOOLTIP = "История пользователя" .
     4636                                   ii = ii + 1 .
     4637                               end.
     4638                       end case.
     4639                   end.
     4640                   hh = hh:next-sibling.
     4641               end.
     4642               b-help:column = v-frame-width - b-help:width-chars.
     4643               jj = 0.
     4644               repeat ii = 4 to 1 by -1 :
     4645                   if valid-handle (v-h[ii] ) then
     4646                   do:
     4647                       jj  = jj + 1 .
     4648                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4649                       v-h[ii]:row    = v-help-old-y .
     4650                   end.
     4651               end.
     4652           end.
     4653       end.
     4654   end procedure.
     4655   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4656   on ' ' of date_from in frame Dialog-Frame
     4657   do:
     4658     if (can-query (self, "sensitive")
     4659        and
     4660        self :sensitive = true
     4661        )
     4662     or (can-query (self, "read-only")
     4663        and
     4664        self :read-only = false
     4665        )
     4666     then do:
     4667       assign
     4668         self :screen-value = ?
     4669       .
     4670     end.
     4671     return no-apply.
     4672   end.
     4673   on delete-character of date_from in frame Dialog-Frame
     4674   do:
     4675     if (can-query (self, "sensitive")
     4676        and
     4677        self :sensitive = true
     4678        )
     4679     or (can-query (self, "read-only")
     4680        and
     4681        self :read-only = false
     4682        )
     4683     then do:
     4684       assign
     4685         self :screen-value = ?
     4686       .
     4687     end.
     4688     return no-apply.
     4689   end.
     4690   on ctrl-d of date_from in frame Dialog-Frame
     4691   do:
     4692     define variable v-curr-sv-date as date no-undo .
     4693     if (can-query (self, "sensitive")
     4694        and
     4695        self :sensitive = true
     4696        )
     4697     or (can-query (self, "read-only")
     4698        and
     4699        self :read-only = false
     4700        )
     4701     then do:
     4702       if self :handle <> focus :handle
     4703       then do:
     4704         apply "entry":u to self .
     4705       end.
     4706       run gbl/getcurdt.p
     4707         (output v-curr-sv-date
     4708         ) .
     4709       assign
     4710         self :screen-value = string(v-curr-sv-date) .
     4711       .
     4712     end.
     4713     return no-apply.
     4714   end.
     4715   on ctrl-b of date_from in frame Dialog-Frame
     4716   do:
     4717     if (can-query (self, "sensitive")
     4718        and
     4719        self :sensitive = true
     4720        )
     4721     or (can-query (self, "read-only")
     4722        and
     4723        self :read-only = false
     4724        )
     4725     then do:
     4726       if self :handle <> focus :handle
     4727       then do:
     4728         apply "entry":u to self .
     4729       end.
     4730       define variable v-curr-sv-date as date no-undo .
     4731       define variable v-new-sv-date  as date no-undo .
     4732       assign
     4733         v-curr-sv-date = date(self :screen-value) no-error
     4734       .
     4735       if v-curr-sv-date = ?
     4736       then do:
     4737         run gbl/getcurdt.p
     4738           (output v-curr-sv-date
     4739           ) .
     4740       end.
     4741       if v-curr-sv-date <> ?
     4742       then do:
     4743         assign
     4744           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     4745         .
     4746         assign
     4747           self :screen-value = string(v-new-sv-date) .
     4748         .
     4749       end.
     4750     end.
     4751     return no-apply .
     4752   end.
     4753   on ctrl-e of date_from in frame Dialog-Frame
     4754   do:
     4755     if (can-query (self, "sensitive")
     4756        and
     4757        self :sensitive = true
     4758        )
     4759     or (can-query (self, "read-only")
     4760        and
     4761        self :read-only = false
     4762        )
     4763     then do:
     4764       if self :handle <> focus :handle
     4765       then do:
     4766         apply "entry":u to self .
     4767       end.
     4768       define variable v-curr-sv-date as date no-undo .
     4769       define variable v-new-sv-date  as date no-undo .
     4770       assign
     4771         v-curr-sv-date = date(self :screen-value) no-error
     4772       .
     4773       if v-curr-sv-date = ?
     4774       then do:
     4775         run gbl/getcurdt.p
     4776           (output v-curr-sv-date
     4777           ) .
     4778       end.
     4779       if v-curr-sv-date <> ?
     4780       then do:
     4781         run gbl/lastdate.p
     4782           (input  v-curr-sv-date
     4783           ,output v-new-sv-date
     4784           ).
     4785         assign
     4786           self :screen-value = string(v-new-sv-date) .
     4787         .
     4788       end.
     4789     end.
     4790     return no-apply .
     4791   end.
     4792   on ctrl-f of date_from in frame Dialog-Frame
     4793   do:
     4794     if (can-query (self, "sensitive")
     4795        and
     4796        self :sensitive = true
     4797        )
     4798     or (can-query (self, "read-only")
     4799        and
     4800        self :read-only = false
     4801        )
     4802     then do:
     4803       if self :handle <> focus :handle
     4804       then do:
     4805         apply "entry":u to self .
     4806       end.
     4807       define variable v-ok            as logical   no-undo .
     4808       define variable v-curr-sv-date  as date      no-undo .
     4809       define variable v-description   as character no-undo .
     4810       assign
     4811         v-curr-sv-date = date(self :screen-value) no-error
     4812       .
     4813       if v-curr-sv-date = ?
     4814       then do:
     4815         run gbl/getcurdt.p
     4816           (output v-curr-sv-date
     4817           ) .
     4818       end.
     4819       if v-curr-sv-date <> ?
     4820       then do:
     4821         run gbl/d-inpday.w
     4822           (input ?
     4823           ,input "Выбор даты"
     4824           ,input v-description
     4825           ,input ""
     4826           ,input-output v-curr-sv-date
     4827           ,output v-ok
     4828           ).
     4829         if v-ok = true
     4830         then do:
     4831           assign
     4832             self :screen-value = string(v-curr-sv-date) .
     4833           .
     4834         end.
     4835       end.
     4836     end.
     4837     return no-apply .
     4838   end.
     4839     define MENU m-ed-date18
     4840       MENU-ITEM m-ed-date18-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     4841       MENU-ITEM m-ed-date18-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     4842       MENU-ITEM m-ed-date18-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     4843       MENU-ITEM m-ed-date18-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     4844       .
