     2866   procedure uf-get :
     2867     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2868     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2869     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2870     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2871     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2872     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2873     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2874     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2875     do
     2876     on error undo, return error
     2877     :
     2878       define buffer buf_usr-flt for ubflt.usr-flt .
     2879       define variable v-use-List_     as logical   no-undo .
     2880       define variable v-type-List_     as character no-undo .
     2881       define variable v-format-List_   as character no-undo .
     2882       define variable v-use-Naim      as logical   no-undo .
     2883       define variable v-type-Naim      as character no-undo .
     2884       define variable v-format-Naim    as character no-undo .
     2885       define variable v-use-print-graft as logical   no-undo .
     2886       define variable v-use-sort-gr     as logical   no-undo .
     2887       define variable v-use-type-price  as logical   no-undo .
     2888       define variable v-use-type-val    as logical   no-undo .
     2889       define variable v-label          as character no-undo .
     2890       define variable v-tooltip        as character no-undo .
     2891       define variable v-user-can-edit  as logical   no-undo .
     2892       define variable v-output-display as logical   no-undo .
     2893       define variable v-other          as character no-undo .
     2894       run uf-name in this-procedure
     2895          (input  entry(1, p-code, chr(4))
     2896         ,output v-use-List_
     2897         ,output v-type-List_
     2898         ,output v-format-List_
     2899         ,output v-use-Naim
     2900         ,output v-type-Naim
     2901         ,output v-format-Naim
     2902         ,output v-use-print-graft
     2903         ,output v-use-sort-gr
     2904         ,output v-use-type-price
     2905         ,output v-use-type-val
     2906         ,output v-label
     2907         ,output v-tooltip
     2908         ,output v-user-can-edit
     2909         ,output v-output-display
     2910         ,output v-other
     2911         ) no-error .
     2912       if error-status :error then do:
     2913         undo, return error return-value .
     2914       end.
     2915       find first buf_usr-flt no-lock where
     2916                  buf_usr-flt.Call-point     = p-code AND
     2917                  buf_usr-flt.user-name       = p-user-name
     2918         no-error .
     2919       if avail buf_usr-flt then do:
     2920         assign
     2921         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2922         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2923         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2924         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2925         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2926         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2927         .
     2928       end.
     2929       else do:
     2930         assign
     2931         p-List_        = (if v-use-List_       then "":U                    else ?)
     2932         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2933         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2934         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2935         p-type-price   = (if v-use-type-price  then no                      else ?)
     2936         p-type-val     = (if v-use-List_       then no                      else ?)
     2937         .
     2938       end.
     2939     end.
     2940   end procedure.
     2941   procedure uf-set :
     2942     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2943     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2944     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2945     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2946     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2947     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2948     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2949     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2950     do
     2951     on error undo, return error
     2952     :
     2953       define buffer buf_usr-flt for ubflt.usr-flt .
     2954       define variable v-use-List_     as logical   no-undo .
     2955       define variable v-type-List_     as character no-undo .
     2956       define variable v-format-List_   as character no-undo .
     2957       define variable v-use-Naim      as logical   no-undo .
     2958       define variable v-type-Naim      as character no-undo .
     2959       define variable v-format-Naim    as character no-undo .
     2960       define variable v-use-print-graft as logical   no-undo .
     2961       define variable v-use-sort-gr   as logical   no-undo .
     2962       define variable v-use-type-price as logical   no-undo .
     2963       define variable v-use-type-val  as logical   no-undo .
     2964       define variable v-tooltip        as character no-undo .
     2965       define variable v-label          as character no-undo .
     2966       define variable v-user-can-edit  as logical   no-undo .
     2967       define variable v-output-display as logical   no-undo .
     2968       define variable v-other          as character no-undo .
     2969       run uf-name in this-procedure
     2970         (input  entry(1, p-code, chr(4))
     2971         ,output v-use-List_
     2972         ,output v-type-List_
     2973         ,output v-format-List_
     2974         ,output v-use-Naim
     2975         ,output v-type-Naim
     2976         ,output v-format-Naim
     2977         ,output v-use-print-graft
     2978         ,output v-use-sort-gr
     2979         ,output v-use-type-price
     2980         ,output v-use-type-val
     2981         ,output v-label
     2982         ,output v-tooltip
     2983         ,output v-user-can-edit
     2984         ,output v-output-display
     2985         ,output v-other
     2986         ) no-error .
     2987       if error-status :error then do:
     2988         undo, return error return-value .
     2989       end.
     2990       find first buf_usr-flt where
     2991                  buf_usr-flt.Call-point     = p-code AND
     2992                  buf_usr-flt.user-name       = p-user-name
     2993         no-error .
     2994       if not avail buf_usr-flt then do:
     2995           create buf_usr-flt .
     2996           assign
     2997           buf_usr-flt.call-point = p-code
     2998           buf_usr-flt.user-name  = p-user-name
     2999           .
     3000       end.
     3001       if avail buf_usr-flt then do:
     3002        assign
     3003        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     3004        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     3005        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     3006        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     3007        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     3008        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     3009       .
     3010       release buf_usr-flt.
     3011       end.
     3012       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     3013     end.
     3014   end procedure.
     3015   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3016   define temp-table temp-schedule-free no-undo
     3017   field free-id as character
     3018   field free-task-name as character
     3019   field proc-run-name as character
     3020   field proc-param-edit-name as character
     3021   field conf-param as character
     3022   field is-gbd as logical
     3023   field is-ubd as logical
     3024   field enable-concurrent-0 as logical
     3025   field enable-concurrent-db as logical
     3026   field other-info as character
     3027   field enc-key as character
     3028   field is-rum as logical
     3029   index pi is unique primary
     3030   free-id.
     3031   procedure schedule-attr-name :
     3032   do
     3033     on error undo, return error
     3034     :
     3035     define input  parameter p-code           as character no-undo .
     3036     define output parameter p-type           as character no-undo .
     3037     define output parameter p-format         as character no-undo .
     3038     define output parameter p-label          as character no-undo .
     3039     define output parameter p-user-can-edit  as logical   no-undo .
     3040     define output parameter p-output-display as logical   no-undo .
     3041     define output parameter p-other          as character no-undo .
     3042       if index(p-code, chr(4)) > 0 then do:
     3043         p-code = entry(1, p-code, chr(4)).
     3044       end.
     3045       case p-code :
     3046               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3047               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3048               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3049               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3050               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3051               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3052               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3053               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3054               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     3055         otherwise do:
     3056           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
     3057         end.
     3058       end.
     3059     end.
     3060   end procedure.
     3061   procedure schedule-attr-tooltip :
     3062   do
     3063     on error undo, return error
     3064     :
     3065       define input  parameter p-code    as character no-undo .
     3066       define output parameter p-tooltip as character no-undo .
     3067       define output parameter p-label   as character no-undo .
     3068       if index(p-code, chr(4)) > 0 then do:
     3069         p-code = entry(1, p-code, chr(4)).
