     5274   PROCEDURE attach-attr-to-schedule-line :
     5275       DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     5276       define buffer buf_schedule      for schedule.
     5277       define buffer buf_schedule-attr for schedule-attr.
     5278       define buffer lock-batchprocess for ub.batchprocess.
     5279       run gbl/lock-prc.p
     5280           (input 'schd':U
     5281           ,input 'exp-bgecheck':U
     5282           ,input 0
     5283           ,input 0
     5284           ,input '':U
     5285           ,input ""
     5286           ,input ""
     5287           ,input (
     5288           "Сохранение параметров выгрузки чеков "
     5289           )
     5290           ,input yes
     5291           ,buffer lock-batchprocess
     5292           ) no-error .
     5293       find first buf_schedule no-lock
     5294           where buf_schedule.task-type   = p-task-type
     5295           and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     5296           and buf_schedule.task-num    = p-task-num
     5297           no-error.
     5298       if not available buf_schedule
     5299           and (  p-task-type   <> 'autofree':U
     5300           or p-db-num-char <> p-db-num-char
     5301           or p-task-num    <> -1 )
     5302           then
     5303       do:
     5304           message
     5305               vss-workfile vss-revision vss-description
     5306               skip
     5307               "Не найдена строка расписания."
     5308               skip return-value
     5309               skip trim(error-status :get-message(1))
     5310               trim(error-status :get-message(2))
     5311               trim(error-status :get-message(3))
     5312               view-as alert-box error.
     5313           undo, return error .
     5314       end.
     5315       run schedule-attr-write in this-procedure (
     5316           input INTEGER(p-db-num-char)
     5317           , input p-task-type
     5318           , input p-task-num
     5319           , input 'schedule-param-list':U
     5320           , input p-param-list
     5321           ).
     5322   END PROCEDURE.
