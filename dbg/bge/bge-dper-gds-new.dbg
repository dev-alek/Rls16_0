       10   DEFINE OUTPUT PARAMETER p-cancel        AS LOGICAL      NO-UNDO.
       11   DEFINE OUTPUT PARAMETER p-params        AS CHARACTER    NO-UNDO.
       12   define variable v-dc-num-full    as char      init "" no-undo.
       13   define variable chr-list-chk-type as char no-undo.
