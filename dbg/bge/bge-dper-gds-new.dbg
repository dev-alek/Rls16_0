       57   procedure vss-get-parameters :
       58     define output parameter p-vss-parameters as character no-undo .
       59   end procedure.
       60   define new global shared variable g#vssrevis-logger as handle    no-undo .
       61   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       62   define variable v-vssrevis-logger                   as handle    no-undo .
       63   procedure vss-logevent :
       64     define input  parameter p-extra-paramters as character no-undo .
       65     define variable v-vssrevis-parameters as character no-undo .
       66     do
       67     on error undo, return error return-value
       68     :
       69       if  valid-handle(v-vssrevis-logger)
       70       and v-vssrevis-logger :get-signature("logevent") <> ""
       71       then do:
       72         run vss-get-parameters in this-procedure
       73           (output v-vssrevis-parameters
       74           ).
       75         run logevent in v-vssrevis-logger
       76           (input vss-workfile
       77           ,input vss-revision
       78           ,input v-vssrevis-parameters
       79           ,input p-extra-paramters
       80           ).
       81       end.
       82     end.
       83   end procedure.
       84   assign
       85     v-vssrevis-logger = g#vssrevis-logger
       86   .
       87   if  valid-handle(v-vssrevis-logger)
       88   and v-vssrevis-logger :get-signature("logevent") <> ""
       89   then do:
       90     assign
       91       v-vssrevis-logevent = true
       92     .
       93     run vss-logevent in this-procedure (input vss-description) .
       94   end.
       95   define new global shared variable g#language as character no-undo .
       96   if g#language <> '' and g#language <> 'rus':U then do:
       97     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       98   end.
       99   define new global shared variable g#library  as handle no-undo .
      100   define new global shared variable g#library2 as handle no-undo .
      101   define   shared variable g#auto as logical no-undo.
      102   define   shared variable g#news as logical no-undo.
      103   define   shared variable g#oxml as logical no-undo.
      104   define   shared variable g#esys as logical no-undo.
      105   define   shared variable g#news-source-db as integer no-undo.
      106   define   shared variable g#esys-source-esys as integer no-undo.
      107   define   shared variable g#db-num as integer   no-undo .
      108   define   shared variable g#userid as character no-undo .
      109   define   shared variable g#passwd as character no-undo .
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure cur-time :
      112      define output parameter p-today as date      no-undo .
      113      define output parameter p-time  as integer   no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       define variable v-date1 as date      no-undo .
      118       define variable v-date2 as date      no-undo .
      119       define variable v-time  as integer   no-undo .
      120       assign
      121         v-date1 = today
      122         v-time  = time
      123         v-date2 = today
      124       .
      125       if v-date1 <> v-date2
      126       then do:
      127         assign
      128           v-date1 = today
      129           v-time  = v-time
      130         .
      131       end.
      132       assign
      133         p-today = v-date1
      134         p-time  = v-time
      135       .
      136     end.
      137   end.
      138   function cur-time-date returns character
      139   :
      140     return string(today, '99/99/9999':U) .
      141   end.
      142   function cur-time-mjd returns decimal
      143   :
      144     define variable v-date as date      no-undo .
      145     define variable v-time as integer   no-undo .
      146     run cur-time in this-procedure
      147       (output v-date
      148       ,output v-time
      149       ) .
      150     return integer(v-date) - 2400002 + (v-time / 86400) .
      151   end.
      152   function cur-time-get-ending-index returns integer
      153   (input p-number as integer
      154   )
      155   :
      156     if p-number < 0
      157     or p-number = ?
      158     then do:
      159       return 1 .
      160     end.
      161     define variable v-rest as integer   no-undo .
      162     assign
      163       p-number = p-number modulo 100
      164     .
      165     if p-number < 20
      166     then do:
      167       assign
      168         v-rest = p-number
      169       .
      170     end.
      171     else do:
      172       assign
      173         v-rest = p-number modulo 10
      174       .
      175     end.
      176     case v-rest :
      177       when 1
      178       then do:
      179         return 2 .
      180       end.
      181       when 2 or
      182       when 3 or
      183       when 4
      184       then do:
      185         return 3 .
      186       end.
      187       otherwise do:
      188         return 1 .
      189       end.
      190     end case .
      191   end.
      192   procedure cur-time-mjd-to-date :
      193      define input  parameter i-mjd-diff as decimal no-undo.
      194      define output parameter o-Date     as date    no-undo.
      195      define output parameter o-Time     as integer no-undo.
      196      define variable v-day-number as integer   no-undo .
      197      if    i-mjd-diff < 0
      198         or i-mjd-diff = ?
      199      then do:
      200         return "?" .
      201      end.
      202      assign
      203         v-day-number = truncate(i-mjd-diff,0).
      204         o-Date = date(v-day-number + 2400002).
      205         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207   end.
      208   function cur-time-mjd-to-string returns character
      209   (input p-mjd-diff as decimal
      210   )
      211   :
      212     define variable v-day-number as integer   no-undo .
      213     define variable v-seconds    as integer   no-undo .
      214     define variable v-hour       as integer   no-undo .
      215     define variable v-min        as integer   no-undo .
      216     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      217     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      218     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      219     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      220     if p-mjd-diff < 0
      221     or p-mjd-diff = ?
      222     then do:
      223       return "?" .
      224     end.
      225     assign
      226       v-day-number = integer(truncate(p-mjd-diff,0))
      227       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229     if v-seconds > 86400
      230     then do:
      231       assign
      232         v-seconds = 86400 - 1
      233       .
      234     end.
      235     if v-seconds < 0
      236     then do:
      237       assign
      238         v-seconds = 0
      239       .
      240     end.
      241     assign
      242       v-hour = truncate(v-seconds / 3600, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 3600
      246     .
      247     assign
      248       v-min = truncate(v-seconds / 60, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 60
      252     .
      253     return
      254         (if v-day-number <> 0
      255           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0
      259           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      263           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      264           else ""
      265         )
      266       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      267       .
      268   end.
      269   function cur-time-string returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-string-sec returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      288   end.
      289   function cur-time-custom  returns character
      290   (input p-prefix as character
      291   ,input p-date-format as character
      292   ,input p-delimiter as character
      293   ,input p-time-format as character
      294   ,input p-suffix as character
      295   )
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return
      304       p-prefix
      305       + string(v-date, p-date-format)
      306       + p-delimiter
      307       + string(v-time, p-time-format)
      308       + p-suffix
      309       .
      310   end.
      311   function cur-time-print  returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-datetime returns datetime
      322   :
      323     define variable v-char as character no-undo .
      324     define variable v-datetime as datetime no-undo .
      325     v-char = cur-time-string().
      326     v-datetime = datetime(v-char).
      327     return  v-datetime.
      328   end.
      329   function cur-time-string-msec returns character
      330   :
      331     define variable v-date as datetime  no-undo .
      332     v-date = now.
      333     return string(v-date) .
      334   end.
      335   procedure proc-alt-shift-f2:
      336     if not ibs.th.gbl.gbl-var:rcode
      337   then
      338     run gbl\inidebug.p .
      339   end.
      340   procedure proc-alt-shift-f3:
      341     run gbl/prvssinf.p
      342       ( input this-procedure
      343       ) .
      344   end.
      345   define variable v-inform-launched as logical no-undo initial false .
      346   procedure proc-alt-shift-f4:
      347     define variable v-action as character no-undo .
      348     if v-inform-launched = false then do:
      349       assign
      350         v-inform-launched = true
      351       .
      352       run gbl/d-inform.w
      353         (  input self
      354         ,  input this-procedure
      355         , output v-action
      356         ) no-error .
      357       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      358       assign
      359         v-inform-launched = false
      360       .
      361     end.
      362   end.
      363   procedure proc-alt-f1:
      364     run gbl/corrhelp.p
      365       (input this-procedure
      366       ) .
      367   end .
      368   on alt-shift-f2 anywhere do:
      369     run proc-alt-shift-f2.
      370   end.
      371   on alt-shift-f3 anywhere do:
      372     run proc-alt-shift-f3 in this-procedure .
      373   end.
      374   on alt-shift-f4 anywhere do:
      375     run proc-alt-shift-f4 in this-procedure.
      376   end.
      377   on alt-f1 anywhere do:
      378     run proc-alt-f1 in this-procedure .
      379   end.
      380   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381     define variable v-cntxt-db-num        as integer   no-undo .
      382     define variable v-cntxt-userid        as character no-undo .
      383     define variable v-cntxt-level         as character no-undo .
      384     define variable v-cntxt-host-code-obj as integer   no-undo .
      385     define variable v-cntxt-obj-type      as character no-undo .
      386     define variable v-cntxt-obj-code      as integer   no-undo .
      387     define variable v-cntxt-db-num-obj    as integer   no-undo .
      388     define variable v-cntxt-is-admin      as logical   no-undo .
      389   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   define temp-table userobjs_temp-user-obj no-undo
      391     field obj-type as character
      392     field obj-code as integer
      393     index xpk is primary unique obj-type obj-code
      394     .
      395   procedure userobjs_clear :
      396     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      397     do
      398     on error undo, return error return-value
      399     :
      400       for each buf_userobjs_temp-user-obj
      401       on error undo, return error return-value
      402       :
      403         delete buf_userobjs_temp-user-obj .
      404       end.
      405     end.
      406   end .
      407   procedure userobjs_object-count :
      408     define output parameter p-total-count as integer   no-undo .
      409     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      410     do
      411     on error undo, return error return-value
      412     :
      413       assign
      414         p-total-count = 0
      415       .
      416       for each buf_userobjs_temp-user-obj
      417       on error undo, return error return-value
      418       :
      419         assign
      420           p-total-count = p-total-count + 1
      421         .
      422       end.
      423     end.
      424   end.
      425   procedure userobjs_append :
      426      define input  parameter p-obj-type as character no-undo .
      427      define input  parameter p-obj-code as integer   no-undo .
      428     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      429     do
      430     on error undo, return error return-value
      431     :
      432       find first buf_userobjs_temp-user-obj
      433         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      434           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      435         no-error .
      436       if not available buf_userobjs_temp-user-obj
      437       then do:
      438         create buf_userobjs_temp-user-obj .
      439         assign
      440           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      441           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      442         .
      443       end.
      444     end.
      445   end.
      446   procedure userobjs_object-exist :
      447     define output parameter p-object-exist as logical   no-undo .
      448     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      449     do
      450     on error undo, return error return-value
      451     :
      452       find first buf_userobjs_temp-user-obj
      453         no-error .
      454       if not available buf_userobjs_temp-user-obj
      455       then do:
      456         assign
      457           p-object-exist = false
      458         .
      459       end.
      460       else do:
      461         assign
      462           p-object-exist = true
      463         .
      464       end.
      465     end.
      466   end.
      467   procedure userobjs_transfer :
      468     define input  parameter p-callback-handle as handle no-undo .
      469     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      470     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      471     do
      472     on error undo, return error return-value
      473     :
      474       if valid-handle(p-callback-handle) <> true
      475       then do:
      476         message
      477           vss-workfile vss-revision vss-description skip
      478           "Ошибка задания входных параметров" skip
      479           "Неизвестный указатель на процедуру" skip
      480           view-as alert-box error .
      481         undo, return error return-value .
      482       end.
      483       if p-callback-handle :get-signature("userobjs_append") = ""
      484       then do:
      485         message
      486           vss-workfile vss-revision vss-description skip
      487           "Ошибка задания входных параметров" skip
      488           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      489                     ,p-callback-handle :file-name
      490                     ) skip
      491           view-as alert-box error .
      492         undo, return error return-value .
      493       end.
      494       for each buf_userobjs_temp-user-obj
      495       on error undo, return error return-value
      496       :
      497         run userobjs_append in p-callback-handle
      498           (input  buf_userobjs_temp-user-obj.obj-type
      499           ,input  buf_userobjs_temp-user-obj.obj-code
      500           ) .
      501       end.
      502     end.
      503   end procedure.
      504   procedure userobjs_select-one :
      505      define input  parameter parparentproc     as widget-handle no-undo .
      506      define input  parameter p-db-num          as integer   no-undo .
      507      define input  parameter p-user-id         as character no-undo .
      508      define input  parameter p-host-code-obj   as integer   no-undo .
      509      define input  parameter p-obj-type        as character no-undo .
      510      define input  parameter p-obj-code        as integer   no-undo .
      511      define output parameter p-user-select     as logical   no-undo .
      512      define output parameter p-select-obj-type as character no-undo .
      513      define output parameter p-select-obj-code as character no-undo .
      514     do
      515     on error undo, return error return-value
      516     :
      517       run gbl/userobjs.w
      518         (input  parparentproc
      519         ,input  this-procedure :handle
      520         ,input  p-db-num
      521         ,input  p-user-id
      522         ,input  p-host-code-obj
      523         ,input  p-obj-type
      524         ,input  p-obj-code
      525         ,INPUT  "b-sel"
      526         ,output p-user-select
      527         ,output p-select-obj-type
      528         ,output p-select-obj-code
      529         ) .
      530     end.
      531   end.
      532   procedure userobjs_select-many :
      533     define input  parameter parparentproc   as widget-handle no-undo .
      534     define input  parameter p-db-num        as integer   no-undo .
      535     define input  parameter p-user-id       as character no-undo .
      536     define input  parameter p-host-code-obj as integer   no-undo .
      537     define input  parameter p-obj-type      as character no-undo .
      538     define input  parameter p-obj-code      as integer   no-undo .
      539     define output parameter p-user-select   as logical   no-undo .
      540     define variable v-select-obj-type as character no-undo .
      541     define variable v-select-obj-code as integer   no-undo .
      542     do
      543     on error undo, return error return-value
      544     :
      545       run gbl/userobjs.w
      546         (input  parparentproc
      547         ,input  this-procedure :handle
      548         ,input  p-db-num
      549         ,input  p-user-id
      550         ,input  p-host-code-obj
      551         ,input  p-obj-type
      552         ,input  p-obj-code
      553         ,INPUT  "b-sel,b-mark"
      554         ,output p-user-select
      555         ,output v-select-obj-type
      556         ,output v-select-obj-code
      557         ) .
      558     end.
      559   end.
      560   procedure thobjs :
      561      define input        parameter parparentproc     as widget-handle no-undo .
      562      define input        parameter i-bttns           as character     no-undo .
      563      define input        parameter i-list-mode       as character     no-undo.
