     5343   PROCEDURE flt-load :
     5344       define variable v-obj-range   as integer   no-undo .
     5345       define variable v-obj-list    as character no-undo .
     5346       define variable v-doc-range   as integer   no-undo .
     5347       define variable v-doc-list    as character no-undo .
     5348       define variable v-userid      as character no-undo .
     5349       define variable v-naim        as character no-undo .
     5350       define variable v-list        as character no-undo .
     5351       define variable v-print-graft as logical   no-undo .
     5352       define variable v-sort-gr     as logical   no-undo .
     5353       define variable v-type-price  as logical   no-undo .
     5354       define variable v-type-val    as logical   no-undo .
     5355       define variable v-found       as logical   no-undo .
     5356       define variable v-str         as character no-undo .
     5357       define variable v-obj-tot     as integer   no-undo .
     5358       define variable v-i           as integer   no-undo .
     5359       define variable v-obj-type    as character no-undo .
     5360       define variable v-obj-code    as integer   no-undo .
     5361       define variable i             as integer   no-undo .
     5362       define variable v-dc-help     as char      no-undo .
     5363       define variable n-i           as integer   no-undo .
     5364       do
     5365           on error undo, return error return-value
     5366           :
     5367           run uf-get (
     5368               input   'bge-dper-new':U
     5369               , input   v-cntxt-userid
     5370               , output  v-list
     5371               , output  v-naim
     5372               , output  v-print-graft
     5373               , output  v-sort-gr
     5374               , output  v-type-price
     5375               , output  v-type-val
     5376               ) .
     5377           if num-entries(v-naim) >= 18 then
     5378           do:
     5379               assign
     5380                   date_from = date(    entry( 1, v-naim ) ).
     5381               date_to            = date(    entry( 2, v-naim ) ).
     5382               tb-chk-pay-code    = logical( entry( 3, v-naim ) ).
     5383               tb-cst-code        = logical( entry( 4, v-naim ) ).
     5384               tb-deleted         = logical( entry( 5, v-naim ) ).
     5385               tb-exp-checks      = logical( entry( 6, v-naim ) ).
     5386               tb-inkass-pay-code = logical( entry( 7, v-naim ) ).
     5387               tb-parts           = logical( entry( 8, v-naim ) ).
     5388               tb-pay-desk        = logical( entry( 9, v-naim ) ).
     5389               tb-pay-desk-cards  = logical( entry(10, v-naim ) ).
     5390               tb-supp            = logical( entry(11, v-naim ) ).
     5391               v-directory =  entry(12,v-naim ).
     5392               v-ftp-address = entry(13,v-naim ).
     5393               v-login = entry(14,v-naim ).
     5394               v-password = entry(15,v-naim ).
     5395               code_pool  = entry(16,v-naim ).
     5396               v-inf-bonus =logical(entry(17,v-naim )).
     5397               do while  i <> (num-entries(v-naim) - 18)  :
     5398                   v-dc-help =  entry (18 + i, v-naim ).
     5399                   v-dc-num-full = entry (18 + i, v-naim ) + ","  +  v-dc-num-full    .
     5400                   v-dc-card:SCREEN-VALUE in frame Dialog-Frame = v-dc-help +  chr(10) +  v-dc-card :SCREEN-VALUE in frame Dialog-Frame .
     5401                   i = i + 1
     5402                       .
     5403               end.
     5404               i = 0.
     5405               v-dc-help = "".
     5406               if tb-chk-pay-code = yes
     5407                   then
     5408               do:
     5409                   enable
     5410                       tb-pay-desk
     5411                       tb-pay-desk-cards
     5412                       with frame Dialog-Frame.
     5413               end.
     5414           end.
     5415           display
     5416               v-directory
     5417               date_from
     5418               date_to
     5419               tb-chk-pay-code
     5420               tb-cst-code
     5421               tb-deleted
     5422               tb-exp-checks
     5423               tb-inkass-pay-code
     5424               tb-parts
     5425               tb-pay-desk
     5426               tb-pay-desk-cards
     5427               v-ftp-address
     5428               v-login
     5429               v-password
     5430               code_pool
     5431               v-inf-bonus
     5432               v-dc-card
     5433               when p-output-type = 2
     5434               with frame Dialog-Frame.
     5435           if num-entries(v-list,';') = 2
     5436               then
     5437           do:
     5438               assign
     5439                   v-str = entry( 1 , v-list, ';')
     5440                   .
     5441               if num-entries(v-str,':') = 2
     5442                   then
     5443               do:
     5444                   assign
     5445                       rs-1       = integer(entry(1, v-str, ':'))
     5446                       v-obj-list = entry(2, v-str, ':')
     5447                       v-obj-tot  = num-entries(v-obj-list)
     5448                       .
     5449                   if rs-1 = 3 and v-obj-tot < 2
     5450                       then
     5451                   do:
     5452                       assign
     5453                           rs-1 = 1
     5454                           .
     5455                   end.
     5456                   run object-select in this-procedure .
     5457                   display
     5458                       rs-1
     5459                       with frame Dialog-Frame.
     5460                   if rs-1 = 3
     5461                       then
     5462                   do:
     5463                       if v-obj-tot modulo 2 = 0
     5464                           then
     5465                       do:
     5466                           for each temp_obj-list
     5467                               :
     5468                               delete temp_obj-list.
     5469                           end.
     5470                           do v-i = 1 to v-obj-tot / 2
     5471                               :
     5472                               assign
     5473                                   v-obj-type = entry( v-i * 2 - 1, v-obj-list )
     5474                                   v-obj-code = integer( entry( v-i * 2, v-obj-list ) )
     5475                                   .
     5476                               find first temp_obj-list no-lock
     5477                                   where temp_obj-list.obj-type = v-obj-type
     5478                                   and temp_obj-list.obj-code = v-obj-code
     5479                                   no-error .
     5480                               if not available temp_obj-list
     5481                                   then
     5482                               do:
     5483                                   create temp_obj-list.
     5484                                   assign
     5485                                       temp_obj-list.obj-type = v-obj-type
     5486                                       temp_obj-list.obj-code = v-obj-code
     5487                                       .
     5488                               end.
     5489                           end.
     5490                           assign
     5491                               ed-object :screen-value in frame Dialog-Frame = v-obj-list
     5492                               .
     5493                       end.
     5494                   end.
     5495               end.
     5496               assign
     5497                   v-str = entry( 2 , v-list, ';')
     5498                   .
     5499               if v-str = ''
     5500                   then
     5501               do:
     5502                   assign
     5503                       ed-doc-type = "Все":u
     5504                       .
     5505               end.
     5506               else
     5507               do:
     5508                   assign
     5509                       ed-doc-type = ''
     5510                       .
     5511                   for each temp_ext-doc-type
     5512                       :
     5513                       if lookup( temp_ext-doc-type.ext-doc-type, v-str ) <> 0
     5514                           then
     5515                       do:
     5516                           assign
     5517                               ed-doc-type     = ed-doc-type + temp_ext-doc-type.ext-doc-type-label + chr(10)
     5518                               p-doc-type-list = p-doc-type-list + temp_ext-doc-type.ext-doc-type + ','
     5519                               .
     5520                       end.
     5521                   end.
     5522                   assign
     5523                       p-doc-type-list = trim(p-doc-type-list , ',')
     5524                       .
     5525               end.
     5526               display
     5527                   ed-doc-type
     5528                   with frame Dialog-Frame.
     5529           end.
     5530       end.
     5531   END PROCEDURE.
     5532   PROCEDURE flt-save :
     5533       define variable v-obj-range   as integer   no-undo .
     5534       define variable v-obj-list    as character no-undo .
     5535       define variable v-doc-range   as integer   no-undo .
     5536       define variable v-doc-list    as character no-undo .
     5537       define variable v-userid      as character no-undo .
     5538       define variable v-naim        as character no-undo .
     5539       define variable v-list        as character no-undo .
     5540       define variable v-print-graft as logical   no-undo .
     5541       define variable v-sort-gr     as logical   no-undo .
     5542       define variable v-type-price  as logical   no-undo .
     5543       define variable v-type-val    as logical   no-undo .
     5544       v-naim ="".
     5545       do
     5546           on error undo, return error return-value
     5547           :
     5548           assign frame Dialog-Frame
     5549               date_from
     5550               date_to
     5551               tb-chk-pay-code
     5552               tb-cst-code
     5553               tb-deleted
     5554               tb-exp-checks
     5555               tb-inkass-pay-code
     5556               tb-parts
     5557               tb-pay-desk
     5558               tb-pay-desk-cards
     5559               code_pool
     5560               rs-1
     5561               rs-2
     5562               v-ftp-address
     5563               v-login
     5564               v-password
     5565               code_pool
     5566               v-inf-bonus
     5567               v-dc-card
     5568               v-directory
     5569               fi-pack-lim = 90
     5570               .
     5571           case rs-1 :screen-value
     5572               :
     5573               when "1"
     5574               then
     5575                   do:
     5576                       assign
     5577                           v-obj-range = 1
     5578                           v-obj-list  = ""
     5579                           .
     5580                   end.
     5581               when "2"
     5582               then
     5583                   do:
     5584                       assign
     5585                           v-obj-range = 2
     5586                           v-obj-list  = ""
     5587                           .
     5588                   end.
     5589               when "3"
     5590               then
     5591                   do:
     5592                       assign
     5593                           v-obj-range = 3
     5594                           v-obj-list  = ""
     5595                           .
     5596                       for each temp_obj-list
     5597                           :
     5598                           assign
     5599                               v-obj-list = v-obj-list
     5600                         + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     5601                         + "," + string( temp_obj-list.obj-code )
     5602                               .
     5603                       end.
     5604                   end.
     5605           end case.
     5606           assign
     5607               v-naim = string(date_from         ) + "," +
     5608                      string(date_to           ) + "," +
     5609                      string(tb-chk-pay-code   ) + "," +
     5610                      string(tb-cst-code       ) + "," +
     5611                      string(tb-deleted        ) + "," +
     5612                      string(tb-exp-checks     ) + "," +
     5613                      string(tb-inkass-pay-code) + "," +
     5614                      string(tb-parts          ) + "," +
     5615                      string(tb-pay-desk       ) + "," +
     5616                      string(tb-pay-desk-cards ) + "," +
     5617                      string(tb-supp           ) + "," +
     5618                      v-directory + "," +
     5619                      v-ftp-address + "," +
     5620                      v-login + "," +
     5621                      v-password + "," +
     5622                      code_pool  + "," +
     5623                      string( v-inf-bonus ) + "," +
     5624                      v-dc-num-full .
     5625           v-list = substitute( "&1:&2;&3"
     5626               , v-obj-range
     5627               , v-obj-list
     5628               , p-doc-type-list
     5629               )
     5630               .
     5631           run uf-set ( input 'bge-dper-new':U
     5632               , input v-cntxt-userid
     5633               , input v-list
     5634               , input v-naim
     5635               , input v-print-graft
     5636               , input v-sort-gr
     5637               , input v-type-price
     5638               , input v-type-val
     5639               ) .
     5640       end.
     5641   END PROCEDURE.
     5642   PROCEDURE get-host-name :
     5643       do
     5644           on error undo, return error
     5645           :
     5646           define output parameter p-host-name as character    no-undo.
     5647           define buffer buf_clients for ub.clients.
     5648           find first buf_clients no-lock
     5649               where buf_clients.obj-type = 'орг':U
     5650               and buf_clients.obj-code = v-bge-dper-host-code
     5651               no-error.
     5652           if not available buf_clients
     5653               then
     5654           do:
     5655               message
     5656                   vss-workfile vss-revision vss-description
     5657                   skip
     5658                   "Не удалось найти текущую фирму"
     5659                   skip return-value
     5660                   skip trim(error-status :get-message(1))
     5661                   trim(error-status :get-message(2))
     5662                   trim(error-status :get-message(3))
     5663                   trim(error-status :get-message(4))
     5664                   trim(error-status :get-message(5))
     5665                   view-as alert-box error.
     5666               undo, return error .
     5667           end.
     5668           else
     5669           do:
     5670               assign
     5671                   p-host-name = buf_clients.obj-name
     5672                   .
     5673           end.
     5674       end.
     5675   END PROCEDURE.
     5676   PROCEDURE init-fields :
     5677       do
     5678           on error undo, return error
     5679           :
     5680           define variable v-oper-num as integer no-undo.
     5681           run manage-tb-chk-pay-code in this-procedure.
     5682           assign
     5683               p-doc-type-list = p-init-doc-type-list
     5684               .
     5685           assign
     5686               rs-1 :screen-value in frame dialog-frame      = "2"
     5687               ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-bge-dper-host-code ) + " " + v-host-name
     5688               .
     5689           assign
     5690               rs-1
     5691               .
     5692           if p-init-doc-type-list <> ?
     5693               and p-init-doc-type-list <> ''
     5694               then
     5695           do:
     5696               for each temp_ext-doc-type
     5697                   :
     5698                   if lookup( temp_ext-doc-type.ext-doc-type, p-init-doc-type-list ) <> 0
     5699                       then
     5700                   do:
     5701                       assign
     5702                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     5703                                                   + temp_ext-doc-type.ext-doc-type-label + chr(10)
     5704                           .
     5705                   end.
     5706               end.
     5707           end.
     5708           assign
     5709               date_to = today
     5710               .
     5711           display
     5712               date_to
     5713               with frame Dialog-Frame.
     5714           if p-mode <> "shd" then
     5715           do:
     5716               run flt-load in this-procedure .
     5717           end.
     5718       end.
     5719   END PROCEDURE.
     5720   PROCEDURE manage-tb-chk-pay-code :
     5721       do
     5722           on error undo, return error
     5723           :
     5724           if tb-chk-pay-code = yes
     5725               then
     5726           do:
     5727               assign
     5728                   tb-pay-desk :sensitive in frame Dialog-Frame       = yes
     5729                   tb-pay-desk-cards :sensitive in frame Dialog-Frame = yes
     5730                   .
     5731           end.
     5732           else
     5733           do:
     5734               assign
     5735                   tb-pay-desk :sensitive in frame Dialog-Frame       = no
     5736                   tb-pay-desk-cards :sensitive in frame Dialog-Frame = no
     5737                   .
     5738           end.
     5739       end.
     5740   END PROCEDURE.
     5741   PROCEDURE object-select :
     5742       do
     5743           on error undo, return error
     5744           :
     5745           case rs-1 :screen-value in frame Dialog-frame
     5746               :
     5747               when "1"
     5748               then
     5749                   do:
     5750                       assign
     5751                           ed-object :screen-value = ""
     5752                           .
     5753                   end.
     5754               when "2"
     5755               then
     5756                   do:
     5757                       assign
     5758                           ed-object :screen-value = v-host-name
     5759                           .
     5760                   end.
     5761               when "3"
     5762               then
     5763                   do:
     5764                       for each temp_obj-list
     5765                           :
     5766                           delete temp_obj-list.
     5767                       end.
     5768                       create temp_obj-list.
     5769                       assign
     5770                           temp_obj-list.obj-type  = v-bge-dper-store-type
     5771                           temp_obj-list.obj-code  = v-bge-dper-store-code
     5772                           ed-object :screen-value = v-bge-dper-store-type + string( v-bge-dper-store-code )
     5773                           .
     5774                   end.
     5775           end case.
     5776       end.
     5777   END PROCEDURE.
     5778   PROCEDURE myenable :
     5779       case p-mode:
     5780           when "run" then
     5781               do:
     5782                   hide btn_save in frame Dialog-Frame.
     5783                   hide  v-per in frame Dialog-Frame.
     5784                   hide time-days in frame  Dialog-Frame.
     5785               end.
     5786           when "shd" then
     5787               do:
     5788                   hide date_from in frame  Dialog-Frame.
     5789                   hide date_to in frame Dialog-Frame.
     5790                   hide btn_start in frame Dialog-Frame.
     5791                   disable  date_to  date_from with  frame  Dialog-Frame.
     5792                   run schedule-attr-value in this-procedure (input p-db-num-char
     5793                       , input p-task-type
     5794                       , input p-task-num
     5795                       , input 'schedule-param-list':U
     5796                       ,output v-param-list
     5797                       ,output v-param-type).
     5798                   if v-param-list <> ""  then
     5799                   do:
     5800                       v-place = integer(ENTRY(1, v-param-list, chr(4))) no-error.
     5801                       if v-place = 2 then
     5802                       do:
     5803                           assign
     5804                               v-ftp-address      = entry (2, v-param-list, chr(4))
     5805                               v-per              = integer(ENTRY(3, v-param-list, chr(4)))
     5806                               v-login            = ENTRY(4, v-param-list, chr(4))
     5807                               v-password         = ENTRY(5, v-param-list, chr(4))
     5808                               p-range            = integer(entry(6,v-param-list,chr(4)))
     5809                               p-host-code        = integer(entry(7,v-param-list,chr(4)))
     5810                               p-obj-list         = (entry(8,v-param-list,chr(4)))
     5811                               p-pay-type-list    = (entry(9,v-param-list,chr(4)))
     5812                               p-gds-type         = (entry(10,v-param-list,chr(4)))
     5813                               p-doc-type-list    = (entry(11,v-param-list,chr(4)))
     5814                               v-dc-num-full      = (entry(12,v-param-list,chr(4)))
     5815                               v-inf-bonus        = logical(entry(13,v-param-list,chr(4)))
     5816                               code_pool          = (entry(14,v-param-list,chr(4)))
     5817                               tb-pay-desk-cards  = logical (entry(15,v-param-list,chr(4)))
     5818                               tb-pay-desk        = logical(entry(16,v-param-list,chr(4)))
     5819                               tb-parts           = logical(entry(17,v-param-list,chr(4)))
     5820                               tb-inkass-pay-code = logical(entry(18,v-param-list,chr(4)))
     5821                               tb-deleted         = logical(entry(19,v-param-list,chr(4)))
     5822                                      tb-chk-pay-code = logical (entry(20,v-param-list,chr(4)))
     5823                               tb-cst-code = logical (entry(21,v-param-list,chr(4)))
     5824                                 tb-exp-checks  =  logical (entry(22,v-param-list,chr(4)))
     5825                                                  p-rs-2 = entry(23,v-param-list,chr(4))
     5826                                                  chr-list-chk-type = entry(24,v-param-list,chr(4))
     5827                              NO-ERROR.
     5828                           disable v-directory with frame Dialog-Frame.
     5829                       end.
     5830                       if v-place = 1 then
     5831                       do :
     5832                           assign
     5833                           v-directory        = entry (2, v-param-list, chr(4))
     5834                           v-per              = integer(ENTRY(3, v-param-list, chr(4)))
     5835                               p-range            = integer(entry(4,v-param-list,chr(4)))
     5836                               p-host-code        = integer(entry(5,v-param-list,chr(4)))
     5837                               p-obj-list         = (entry(6,v-param-list,chr(4)))
     5838                               p-pay-type-list    = (entry(7,v-param-list,chr(4)))
     5839                               p-gds-type         = (entry(8,v-param-list,chr(4)))
     5840                               p-doc-type-list    = (entry(9,v-param-list,chr(4)))
     5841                               v-dc-num-full      = (entry(10,v-param-list,chr(4)))
     5842                               v-inf-bonus        = logical(entry(11,v-param-list,chr(4)))
     5843                               code_pool          = (entry(12,v-param-list,chr(4)))
     5844                               tb-pay-desk-cards  = logical (entry(13,v-param-list,chr(4)))
     5845                               tb-pay-desk        = logical(entry(14,v-param-list,chr(4)))
     5846                               tb-parts           = logical(entry(15,v-param-list,chr(4)))
     5847                               tb-inkass-pay-code = logical(entry(16,v-param-list,chr(4)))
     5848                               tb-deleted         = logical(entry(17,v-param-list,chr(4)))
     5849                               tb-chk-pay-code = logical (entry(18,v-param-list,chr(4)))
     5850                               tb-cst-code = logical (entry(19,v-param-list,chr(4)))
     5851                               tb-exp-checks = logical (entry(20,v-param-list,chr(4)))
     5852                               p-rs-2 = entry(21,v-param-list,chr(4))
     5853                               chr-list-chk-type =  entry(22,v-param-list,chr(4))
     5854                                  NO-ERROR.
     5855                           disable v-ftp-address v-login v-password with frame Dialog-Frame.
     5856                       end.
     5857                   end.
     5858                                           display code_pool v-directory v-inf-bonus  v-place v-per   tb-exp-checks  tb-deleted tb-cst-code tb-chk-pay-code  tb-inkass-pay-code  tb-parts   tb-pay-desk   tb-pay-desk-cards with frame Dialog-Frame no-error.
     5859                                           rs-1 :screen-value = string(p-range) no-error.
     5860                                           v-dc-card :SCREEN-VALUE = v-dc-num-full .
     5861                                            rs-2 :screen-value =  p-rs-2 no-error.
     5862                define variable i as integer no-undo.
     5863                do i = 1 to num-entries(chr-list-chk-type) :
     5864               if entry(i,chr-list-chk-type  ) = "1"   then v-list-chk-type = "Продажа,"   no-error.
     5865              if entry(i,chr-list-chk-type  )  = "6"   then v-list-chk-type = v-list-chk-type + "Возврат,"   no-error.
     5866           if entry(i,chr-list-chk-type  )   = "8"  then v-list-chk-type = v-list-chk-type + "Аннуляция,"   no-error.
     5867           if entry(i,chr-list-chk-type  )   = "17"  then v-list-chk-type = v-list-chk-type + "ТехПролив"  no-error.
     5868            end.
     5869                                            list-chk-type :list-items  =  v-list-chk-type.
     5870               end.
     5871       end case.
     5872   end procedure.
     5873   procedure chk-type-choose:
     5874       define variable v-counter       as integer   no-undo.
     5875       define variable v-label         as character no-undo.
     5876       define variable v-value         as character no-undo.
     5877       define variable v-list          as character no-undo.
     5878       define variable v-changed       as logical   no-undo.
     5879       define variable v-accepted      as logical   no-undo.
     5880       define variable v-list-edt      as character no-undo.
     5881       define variable v-list-edt-full as character no-undo.
     5882       do
     5883           with frame Dialog-Frame
     5884           on error undo, return error
     5885           :
     5886           v-uf-Naim = "".
     5887           assign
     5888               v-list-edt = "Продажа" +
     5889           "," + "Возврат" +
     5890           "," + "Аннуляция" +
     5891           "," + "ТехПролив" +
     5892           "," + "Коррекции"
     5893           .
     5894           assign
     5895               v-list-edt-full = "Продажа" +
     5896           "," + "Возврат" +
     5897           "," + "Аннуляция" +
     5898           "," + "ТехПролив" +
     5899           "," + "Коррекции"
     5900           .
     5901           run twowin_clear in this-procedure.
     5902           do v-counter = 1 to num-entries( v-list-edt-full )
     5903               on error undo, return error
     5904               :
     5905               assign
     5906                   v-label = entry( v-counter, v-list-edt-full )
     5907                   v-value = entry( v-counter, v-list-edt )
     5908                   .
     5909               run twowin_add-item in this-procedure (
     5910                   input v-value
     5911                   , input v-label
     5912                   , input substitute( "Тип чеков: &1", v-value )
     5913                   , input ( list-chk-type :lookup( v-value ) <> 0  )
     5914                   ).
     5915           end.
     5916           run gbl/twowin.w (
     5917               input ?
     5918               , input 1
     5919               , input "Выбор типа чека":U
     5920               , input "":U
     5921               , input "&Тест"
     5922               , input table temp_twowin_items
     5923               , output table temp_twowin_itemsSelected
     5924               , output v-changed
     5925               , output v-accepted
     5926               ).
     5927           if
     5928               v-changed = yes
     5929               then
     5930           do:
     5931               assign
     5932                  list-chk-type :list-items = "":U
     5933                   v-list                  = "":U
     5934                   v-counter               = 0
     5935                   .
     5936               for each temp_twowin_itemsSelected
     5937                   by temp_twowin_itemsSelected.itm-key
     5938                   :
     5939                   assign
     5940                       v-counter = v-counter + 1
     5941                       v-list    = substitute( "&1&2&3"
     5942                                   , v-list
     5943                                   , ( if v-list = "":U then "":U else ",":U )
     5944                                   , temp_twowin_itemsSelected.itmExtKey
     5945                                   )
     5946                       .
     5947                   list-chk-type :add-last (
     5948                       entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full )
     5949                       , temp_twowin_itemsSelected.itmExtKey
     5950                       ) no-error.
     5951               end.
     5952           end.
     5953       end.
     5954          chr-list-chk-type = "".
     5955       v-list-chk-type = "".
     5956       do v-counter = 1 to list-chk-type :num-items in frame Dialog-Frame
     5957           on error undo, return error
     5958           :
     5959           assign
     5960               v-list-chk-type = substitute( "&1&2&3"
     5961                                           , v-list-chk-type
     5962                                           , ( if v-list-chk-type = "":U then "":U else ",":U )
     5963                                           , entry( v-counter , list-chk-type :list-items )
     5964                                           )  no-error
     5965               .
     5966          end.
     5967         do v-counter = 1 to list-chk-type :num-items in frame Dialog-Frame
     5968           on error undo, return error
     5969           :
     5970             if entry(v-counter,v-list-chk-type  ) = "Продажа"   then chr-list-chk-type = "1,"   no-error.
     5971             if entry(v-counter,v-list-chk-type  )  = "Возврат"   then chr-list-chk-type = chr-list-chk-type + "6,"   no-error.
     5972             if entry(v-counter,v-list-chk-type  )   = "Аннуляция"  then chr-list-chk-type = chr-list-chk-type + "8,"   no-error.
     5973             if entry(v-counter,v-list-chk-type  )   = "ТехПролив"  then chr-list-chk-type = chr-list-chk-type + "17,"  no-error.
     5974             if entry(v-counter,v-list-chk-type  )   = "Коррекции"  then chr-list-chk-type = chr-list-chk-type + "43,44"  no-error.
     5975         end.
     5976   end.
     5977   PROCEDURE write-log-and-file :
     5978       define input parameter p-tab-position   as integer    no-undo.
     5979       define input parameter p-file-name      as char       no-undo.
     5980       define input parameter p-log-level      as integer    no-undo.
     5981       define input parameter p-log-string     as char       no-undo.
     5982       output stream StreamLog to value(p-file-name) append.
     5983       put stream StreamLog unformatted chr(10).
     5984       put stream StreamLog unformatted cur-time-string-sec() " " p-log-string.
     5985       output stream StreamLog close.
     5986   END PROCEDURE.
