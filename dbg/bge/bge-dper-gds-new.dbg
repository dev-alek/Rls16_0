      857       end case.
      858   end.
      859   end .
      860   procedure xmlchar-decode :
      861   define input parameter p-in-string      as character        no-undo.
      862   define output parameter p-out-string    as character        no-undo.
      863       define variable v-position      as integer      no-undo.
      864       define variable v-last-position as integer      no-undo.
      865       define variable v-temp-integer  as integer      no-undo.
      866       define variable v-current-char  as character    no-undo.
      867       define variable v-next-char     as character    no-undo.
      868       define variable v-success       as logical      no-undo.
      869   do
      870   on error undo, return error
      871   :
      872       assign
      873           p-out-string = "":U
      874           v-position   = 0
      875       .
      876       replace-cycle:
      877       do while yes
      878       on error undo, return error
      879       :
      880           assign
      881               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      882           .
      883           if v-last-position <= v-position
      884           then do:
      885               if v-position = 0
      886               then do:
      887                   assign
      888                       p-out-string = p-in-string
      889                   .
      890               end.
      891               else do:
      892                   assign
      893                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      894                   .
      895               end.
      896               leave replace-cycle.
      897           end.
      898           else do:
      899               assign
      900                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      901                   v-position      = v-last-position
      902                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      903               .
      904               if v-current-char = "#":U
      905               then do:
      906                   assign
      907                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      908                   .
      909                   if v-last-position > 0
      910                   then do:
      911                       run xmlchar-read-integer in this-procedure
      912                        (
      913                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      914                           , output v-temp-integer
      915                           , output v-success
      916                       ).
      917                       if v-success = yes
      918                       and v-temp-integer >= 1
      919                       and v-temp-integer <= 255
      920                       then do:
      921                           assign
      922                               p-out-string = p-out-string + chr( v-temp-integer )
      923                               v-position   = v-last-position + 1
      924                           .
      925                       end.
      926                       else do:
      927                           assign
      928                               p-out-string = p-out-string + "&":U
      929                               v-position   = v-position   + 1
      930                           .
      931                       end.
      932                   end.
      933                   else do:
      934                       assign
      935                           p-out-string = p-out-string + "&":U
      936                           v-position   = v-position   + 1
      937                       .
      938                   end.
      939               end.
      940               else do:
      941                   case substring( p-in-string, v-position + 1, 3 )
      942                   :
      943                       when "lt;":U
      944                       then do:
      945                           assign
      946                               p-out-string = p-out-string + "<":U
      947                               v-position   = v-position   + 3
      948                           .
      949                       end.
      950                       when "gt;":U
      951                       then do:
      952                           assign
      953                               p-out-string = p-out-string + ">":U
      954                               v-position   = v-position   + 3
      955                           .
      956                       end.
      957                       otherwise do:
      958                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      959                           then do:
      960                               assign
      961                                   p-out-string = p-out-string + "&":U
      962                                   v-position   = v-position   + 4
      963                               .
      964                           end.
      965                           else do:
      966                               case substring( p-in-string, v-position + 1, 5 )
      967                               :
      968                                   when "quot;":U
      969                                   then do:
      970                                       assign
      971                                           p-out-string = p-out-string + '"':U
      972                                           v-position   = v-position   + 5
      973                                       .
      974                                   end.
      975                                   when "apos;":U
      976                                   then do:
      977                                       assign
      978                                           p-out-string = p-out-string + "'":U
      979                                           v-position   = v-position   + 5
      980                                       .
      981                                   end.
      982                                   otherwise do:
      983                                       assign
      984                                           p-out-string = p-out-string + "&":U
      985                                       .
      986                                   end.
      987                               end case.
      988                           end.
      989                       end.
      990                   end case.
      991               end.
      992           end.
      993       end.
      994   end.
      995   end .
      996   procedure xmlchar-read-integer :
      997   define input parameter p-input-string      as character        no-undo.
      998   define output parameter p-output-integer   as integer          no-undo.
      999   define output parameter p-success       as logical          no-undo.
     1000   do
     1001   on error undo, return error
     1002   :
     1003       assign
     1004           p-output-integer = integer( p-input-string )
     1005       no-error.
     1006       if error-status :error
     1007       then do:
     1008           assign
     1009               p-success           = no
     1010               p-output-integer    = 0
     1011           .
     1012       end.
     1013       else do:
     1014           assign
     1015               p-success           = yes
     1016           .
     1017       end.
     1018   end.
     1019   end.
     1020   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   procedure strtdate :
     1022     define input  parameter p-str         as character no-undo .
     1023     define output parameter p-value       as date      no-undo .
     1024     define output parameter p-data-valid  as logical   no-undo .
     1025     define output parameter p-message     as character no-undo .
     1026   do
     1027   on error undo, return error return-value
     1028   :
     1029     define variable v-value       as date      no-undo .
     1030     define variable v-i           as integer   no-undo .
     1031     define variable v-num         as integer   no-undo .
     1032     define variable v-delim       as character no-undo .
     1033     define variable v-delim-list  as character no-undo .
     1034     define variable v-day         as integer   no-undo .
     1035     define variable v-month       as integer   no-undo .
     1036     define variable v-year        as integer   no-undo .
     1037     define variable v-day-str     as character no-undo .
     1038     define variable v-month-str   as character no-undo .
     1039     define variable v-year-str    as character no-undo .
     1040     assign
     1041       p-value       = ?
     1042       p-data-valid  = false
     1043     .
     1044     if p-str = ?
     1045     then do:
     1046       assign
     1047         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1048       .
     1049       return .
     1050     end.
     1051     if p-str = ""
     1052     then do:
     1053       assign
     1054         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1055       .
     1056       return .
     1057     end.
     1058     if length(p-str)  > 10
     1059     then do:
     1060       assign
     1061         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1062       .
     1063       return .
     1064     end.
     1065     assign
     1066       v-delim-list = '/,-,.':U
     1067     .
     1068     _delim:
     1069     do v-i = 1 to num-entries( v-delim-list )
     1070     :
     1071       assign
     1072         v-delim = entry( v-i , v-delim-list )
     1073         v-num   = num-entries( p-str , v-delim )
     1074       .
     1075       if v-num <> 3
     1076       then do:
     1077         assign
     1078           v-delim = ''
     1079         .
     1080       end.
     1081       else do:
     1082         leave _delim.
     1083       end.
     1084     end.
     1085     if v-delim = ''
     1086     then do:
     1087       assign
     1088         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1089       .
     1090       return .
     1091     end.
     1092     assign
     1093       v-day-str   = entry( 1, p-str , v-delim)
     1094       v-month-str = entry( 2, p-str , v-delim)
     1095       v-year-str  = entry( 3, p-str , v-delim)
     1096     .
     1097     if  length(v-day-str) > 2   or
     1098         length(v-day-str) < 1   or
     1099         length(v-month-str) > 2 or
     1100         length(v-month-str) < 1 or
     1101         (
     1102           length(v-year-str) <> 2 and
     1103           length(v-year-str) <> 4
     1104         )
     1105     then do:
     1106       assign
     1107         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1108       .
     1109       return .
     1110     end.
     1111     if length( v-year-str ) = 2
     1112     then do:
     1113       assign
     1114         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1115       .
     1116     end.
     1117     assign
     1118       v-day   = integer( v-day-str )
     1119       v-month = integer( v-month-str)
     1120       v-year  = integer( v-year-str)
     1121     no-error .
     1122     if error-status :error
     1123     then do:
     1124       assign
     1125         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1126       .
     1127       return .
     1128     end.
     1129     if v-day < 1  or
     1130        v-day > 31 or
     1131        v-month < 1 or
     1132        v-month > 12 or
     1133        v-year < 0   or
     1134        v-year > 5000
     1135     then do:
     1136       assign
     1137         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1138       .
     1139       return .
     1140     end.
     1141     assign
     1142       v-value = date( v-month, v-day, v-year )
     1143     no-error .
     1144     if error-status :error
     1145     then do:
     1146       assign
     1147         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1148       .
     1149       return .
     1150     end.
     1151     assign
     1152       p-value       = v-value
     1153       p-data-valid  = true
     1154     .
     1155   end.
     1156   end procedure.
