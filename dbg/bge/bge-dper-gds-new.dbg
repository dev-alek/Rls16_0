     3543   procedure twowin_add-item :
     3544   define input parameter p-ext-key   as character        no-undo.
     3545   define input parameter p-item-name as character        no-undo.
     3546   define input parameter p-item-desc as character        no-undo.
     3547   define input parameter p-selected  as logical          no-undo.
     3548       define buffer buf_temp_twowin_items        for temp_twowin_items.
     3549   do
     3550   for buf_temp_twowin_items
     3551   on error undo, return error
     3552   :
     3553       assign
     3554           v-twowin10-itm-key = v-twowin10-itm-key + 1
     3555       .
     3556       create temp_twowin_items.
     3557       assign
     3558           temp_twowin_items.itm-key      = v-twowin10-itm-key
     3559           temp_twowin_items.itmExtKey    = p-ext-key
     3560           temp_twowin_items.itmName      = p-item-name
     3561           temp_twowin_items.itmDesc      = p-item-desc
     3562           temp_twowin_items.itmSelected  = p-selected
     3563           temp_twowin_items.selLeft      = no
     3564           temp_twowin_items.selRight     = no
     3565       .
     3566   end.
     3567   end procedure.
