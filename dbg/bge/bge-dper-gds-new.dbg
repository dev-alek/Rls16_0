      585   procedure xmlchar-test :
      586   define input parameter p-in-string          as character        no-undo.
      587   define output parameter p-out-string-enc    as character        no-undo.
      588   define output parameter p-out-string-dec    as character        no-undo.
      589   do
      590   on error undo, return error
      591   :
      592          run xmlchar-encode in this-procedure
      593       (
      594             input p-in-string
      595           , output p-out-string-enc
      596       ).
      597          run xmlchar-decode in this-procedure
      598       (
      599             input p-out-string-enc
      600           , output p-out-string-dec
      601       ).
      602   end.
      603   end .
      604   procedure xmlchar-encode :
      605   define input parameter p-in-string      as character        no-undo.
      606   define output parameter p-out-string    as character        no-undo.
      607       define variable v-position      as integer      no-undo.
      608       define variable v-current-char  as character    no-undo.
      609   do
      610   on error undo, return error
      611   :
      612       assign
      613           p-out-string = "":U
      614       .
      615       case p-in-string
      616       :
      617           when ?
      618           then do:
      619               assign
      620                   p-out-string = "?":U
      621               .
      622           end.
      623           when "?":U
      624           then do:
      625               assign
      626                   p-out-string = "&#63;":U
      627               .
      628           end.
      629           otherwise do:
      630               do v-position = 1 to length( p-in-string )
      631               :
      632                   assign
      633                       v-current-char = substring( p-in-string, v-position, 1 )
      634                   .
      635                   case v-current-char
      636                   :
      637                       when "&":U
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + "&amp;":U
      641                           .
      642                       end.
      643                       when ">":U
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + "&gt;":U
      647                           .
      648                       end.
      649                       when "<":U
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + "&lt;":U
      653                           .
      654                       end.
      655                       when "'":U
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + "&apos;":U
      659                           .
      660                       end.
      661                       when '"':U
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + "&quot;":U
      665                           .
      666                       end.
      667                       when chr(1)
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + "":U
      671                           .
      672                       end.
      673                       when chr(2)
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + "":U
      677                           .
      678                       end.
      679                       when chr(3)
      680                       then do:
      681                           assign
      682                               p-out-string = p-out-string + "":U
      683                           .
      684                       end.
      685                       when chr(4)
      686                       then do:
      687                           assign
      688                               p-out-string = p-out-string + "":U
      689                           .
      690                       end.
      691                       when chr(5)
      692                       then do:
      693                           assign
      694                               p-out-string = p-out-string + "":U
      695                           .
      696                       end.
      697                       when chr(6)
      698                       then do:
      699                           assign
      700                               p-out-string = p-out-string + "":U
      701                           .
      702                       end.
      703                       when chr(7)
      704                       then do:
      705                           assign
      706                               p-out-string = p-out-string + "":U
      707                           .
      708                       end.
      709                       when chr(8)
      710                       then do:
      711                           assign
      712                               p-out-string = p-out-string + "":U
      713                           .
      714                       end.
      715                       when chr(9)
      716                       then do:
      717                           assign
      718                               p-out-string = p-out-string + "":U
      719                           .
      720                       end.
      721                       when chr(29)
      722                       then do:
      723                           assign
      724                               p-out-string = p-out-string + "":U
      725                           .
      726                       end.
      727                       when chr(10)
      728                       then do:
      729                           assign
      730                               p-out-string = p-out-string + "&#10;":U
      731                           .
      732                       end.
      733                       when chr(13)
      734                       then do:
      735                           assign
      736                               p-out-string = p-out-string + "&#13;":U
      737                           .
      738                       end.
      739                       otherwise do:
      740                           assign
      741                               p-out-string = p-out-string + v-current-char
      742                           .
      743                       end.
      744                   end case.
      745               end.
      746           end.
      747       end case.
      748   end.
      749   end .
      750   procedure xmlchar-encode-1c :
      751   define input parameter p-in-string      as character        no-undo.
      752   define output parameter p-out-string    as character        no-undo.
      753       define variable v-position      as integer      no-undo.
      754       define variable v-current-char  as character    no-undo.
      755   do
      756   on error undo, return error
      757   :
      758       assign
      759           p-out-string = "":U
      760       .
      761       case p-in-string
      762       :
      763           when ?
      764           then do:
      765               assign
      766                   p-out-string = "?":U
      767               .
      768           end.
      769           otherwise do:
      770               do v-position = 1 to length( p-in-string )
      771               :
      772                   assign
      773                       v-current-char = substring( p-in-string, v-position, 1 )
      774                   .
      775                   case v-current-char
      776                   :
