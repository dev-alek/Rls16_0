      599   procedure xmlchar-decode :
      600   define input parameter p-in-string      as character        no-undo.
      601   define output parameter p-out-string    as character        no-undo.
      602       define variable v-position      as integer      no-undo.
      603       define variable v-last-position as integer      no-undo.
      604       define variable v-temp-integer  as integer      no-undo.
      605       define variable v-current-char  as character    no-undo.
      606       define variable v-next-char     as character    no-undo.
      607       define variable v-success       as logical      no-undo.
      608   do
      609   on error undo, return error
      610   :
      611       assign
      612           p-out-string = "":U
      613           v-position   = 0
      614       .
      615       replace-cycle:
      616       do while yes
      617       on error undo, return error
      618       :
      619           assign
      620               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      621           .
      622           if v-last-position <= v-position
      623           then do:
      624               if v-position = 0
      625               then do:
      626                   assign
      627                       p-out-string = p-in-string
      628                   .
      629               end.
      630               else do:
      631                   assign
      632                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      633                   .
      634               end.
      635               leave replace-cycle.
      636           end.
      637           else do:
      638               assign
      639                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      640                   v-position      = v-last-position
      641                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      642               .
      643               if v-current-char = "#":U
      644               then do:
      645                   assign
      646                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      647                   .
      648                   if v-last-position > 0
      649                   then do:
      650                       run xmlchar-read-integer in this-procedure
      651                        (
      652                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      653                           , output v-temp-integer
      654                           , output v-success
      655                       ).
      656                       if v-success = yes
      657                       and v-temp-integer >= 1
      658                       and v-temp-integer <= 255
      659                       then do:
      660                           assign
      661                               p-out-string = p-out-string + chr( v-temp-integer )
      662                               v-position   = v-last-position + 1
      663                           .
      664                       end.
      665                       else do:
      666                           assign
      667                               p-out-string = p-out-string + "&":U
      668                               v-position   = v-position   + 1
      669                           .
      670                       end.
      671                   end.
      672                   else do:
      673                       assign
      674                           p-out-string = p-out-string + "&":U
      675                           v-position   = v-position   + 1
      676                       .
      677                   end.
      678               end.
      679               else do:
      680                   case substring( p-in-string, v-position + 1, 3 )
      681                   :
      682                       when "lt;":U
      683                       then do:
      684                           assign
      685                               p-out-string = p-out-string + "<":U
      686                               v-position   = v-position   + 3
      687                           .
      688                       end.
      689                       when "gt;":U
      690                       then do:
      691                           assign
      692                               p-out-string = p-out-string + ">":U
      693                               v-position   = v-position   + 3
      694                           .
      695                       end.
      696                       otherwise do:
      697                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      698                           then do:
      699                               assign
      700                                   p-out-string = p-out-string + "&":U
      701                                   v-position   = v-position   + 4
      702                               .
      703                           end.
      704                           else do:
      705                               case substring( p-in-string, v-position + 1, 5 )
      706                               :
      707                                   when "quot;":U
      708                                   then do:
      709                                       assign
      710                                           p-out-string = p-out-string + '"':U
      711                                           v-position   = v-position   + 5
      712                                       .
      713                                   end.
      714                                   when "apos;":U
      715                                   then do:
      716                                       assign
      717                                           p-out-string = p-out-string + "'":U
      718                                           v-position   = v-position   + 5
      719                                       .
      720                                   end.
      721                                   otherwise do:
      722                                       assign
      723                                           p-out-string = p-out-string + "&":U
      724                                       .
      725                                   end.
      726                               end case.
      727                           end.
      728                       end.
      729                   end case.
      730               end.
      731           end.
      732       end.
      733   end.
      734   end .
      735   procedure xmlchar-read-integer :
      736   define input parameter p-input-string      as character        no-undo.
      737   define output parameter p-output-integer   as integer          no-undo.
      738   define output parameter p-success       as logical          no-undo.
      739   do
      740   on error undo, return error
      741   :
      742       assign
      743           p-output-integer = integer( p-input-string )
      744       no-error.
      745       if error-status :error
      746       then do:
      747           assign
      748               p-success           = no
      749               p-output-integer    = 0
      750           .
      751       end.
      752       else do:
      753           assign
      754               p-success           = yes
      755           .
      756       end.
      757   end.
      758   end.
      759   define variable v-bgelib-bgeclall           as logical      no-undo.
      760   define variable v-bgelib-bgedict            as logical      no-undo.
      761   define temp-table temp_ext-doc-type no-undo
      762       field edt-key               as integer
      763       field ext-doc-type          as character
      764       field ext-doc-type-label    as character
      765       index pi is primary unique
      766           edt-key
      767   .
      768   define temp-table temp_bgelib_goods no-undo
      769       field gds-code as integer
      770       index pi is primary unique
      771           gds-code
      772   .
      773   define temp-table temp_bgelib_clients no-undo
      774       field obj-type as character
      775       field obj-code as integer
      776       index pi is primary unique
      777           obj-type
      778           obj-code
      779   .
      780   define temp-table temp_bgelib_dis-card no-undo
      781       field d-card as character
      782       index pi is primary unique
      783           d-card
      784   .
      785   define temp-table temp_bgelib_trn-doc no-undo
      786       field doc-code as integer
      787   .
      788   procedure bgelib-tag-open:
      789   do
      790   on error undo, return error
      791   :
      792   define input parameter v-tag-level  as integer      no-undo.
      793   define input parameter v-tag-name   as character    no-undo.
      794   define input parameter v-tag-value  as character    no-undo.
      795       put stream stmXMLOut unformatted
      796           chr(10)
      797           + fill(" ", 4 * v-tag-level)
      798           + "<" + v-tag-name
      799           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      800           + v-tag-value + ">"
      801       .
      802   end.
      803   end procedure.
      804   procedure bgelib-tag-put:
      805   do
      806   on error undo, return error
      807   :
      808   define input parameter v-tag-level      as integer      no-undo.
      809   define input parameter v-tag-name       as character    no-undo.
      810   define input parameter v-tag-value      as character    no-undo.
      811   define input parameter v-empty-mode     as integer      no-undo.
      812       v-tag-name = trim(v-tag-name).
      813       if  v-empty-mode = 1
      814       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      815       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      816       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      817       then do:
      818           run xmlchar-encode in this-procedure (
      819                 input v-tag-value
      820               , output v-tag-value
      821           ).
      822           put stream stmXMLOut unformatted
      823               chr(10) + fill(" ", 4 * v-tag-level)
      824                           + '<' + v-tag-name + '>'
      825                           + v-tag-value
      826                           + '</' + v-tag-name + '>'
      827           .
      828       end.
      829   end.
      830   end procedure.
      831   procedure bgelib-tag-close:
      832   do
      833   on error undo, return error
      834   :
      835   define input parameter v-tag-level as integer      no-undo.
      836   define input parameter v-tag-name  as character    no-undo.
      837       put stream stmXMLOut unformatted
      838           chr(10)
      839           + fill( " ", 4 * v-tag-level)
      840           + '</' + v-tag-name + '>'
      841       .
      842   end.
      843   end procedure.
      844   procedure bgelib-write-log:
      845   do
      846   on error undo, return error
      847   :
      848   define input parameter v-filename   as character    no-undo.
      849   define input parameter v-log-level  as integer      no-undo.
      850   define input parameter v-out-string as character    no-undo.
      851       output stream stmXMLLog to value( v-filename ) append.
      852       put stream stmXMLLog unformatted
      853           chr(10)
      854       .
      855       put stream stmXMLLog unformatted
      856           ( if v-log-level = 0
      857             or v-out-string = "&DLine"
      858             or v-out-string = "&Line"
      859             then ""
      860             else cur-time-string-sec() + " " )
      861       .
      862       put stream stmXMLLog unformatted
      863           ( if v-out-string = "&Line"
      864             then fill( "-", 80 )
      865             else if v-out-string = "&DLine"
      866                  then fill( "=", 80 )
      867                  else v-out-string )
      868       .
      869       output stream stmXMLLog close.
      870   end.
      871   end procedure.
      872   procedure bgelib-write-edt:
      873   do
      874   on error undo, return error
      875   :
      876   define input parameter v-editor-handle    as handle       no-undo.
      877   define input parameter v-log-level        as integer      no-undo.
      878   define input parameter v-out-string       as character    no-undo.
      879       if valid-handle ( v-editor-handle )
      880       then do:
      881           v-editor-handle :move-to-eof().
      882           v-editor-handle :insert-string( ( if v-log-level = 0
      883                                             or v-out-string = "&DLine"
      884                                             or v-out-string = "&Line"
      885                                             then ""
      886                                             else cur-time-string-sec() + " "
      887                                         ) ).
      888           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      889                                             then fill( "-", 80 )
      890                                             else if v-out-string = "&DLine" then fill("=", 80)
      891                                             else fill( " ", v-log-level) + v-out-string
      892                                         ) ).
      893           v-editor-handle :insert-string( chr(10) ).
      894       end.
      895       process events.
      896       output to 'bgescn.txt' append.
      897           put unformatted
      898               chr(10)
      899               string( ( if v-log-level = 0
      900                         or v-out-string = "&DLine"
      901                         or v-out-string = "&Line"
      902                         then ""
      903                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      904                     ) )
      905               string( ( if v-out-string = "&Line"
      906                         then fill( "-", 80 )
      907                         else if v-out-string = "&DLine"
      908                              then fill( "=", 80 )
      909                              else fill( " ", v-log-level ) + v-out-string
      910                     ) )
      911           .
      912       output close.
      913   end.
      914   end procedure.
      915   procedure bgelib-show-cnt:
      916   do
      917   on error undo, return error
      918   :
      919   define input parameter v-fillin-handle     as handle   no-undo.
      920       if valid-handle( v-fillin-handle )
      921       then do:
      922           assign
      923               v-fillin-handle :visible = true
      924           .
      925       end.
      926   end.
      927   end procedure.
      928   procedure bgelib-hide-cnt:
      929   do
      930   on error undo, return error
      931   :
      932   define input parameter v-fillin-handle     as handle   no-undo.
      933       if valid-handle( v-fillin-handle )
      934       then do:
      935           assign v-fillin-handle :visible = false.
      936       end.
      937   end.
      938   end procedure.
      939   procedure bgelib-write-cnt:
      940   do
      941   on error undo, return error
      942   :
      943   define input parameter v-fillin-handle    as handle       no-undo.
      944   define input parameter v-fillin-string    as character    no-undo.
      945       if valid-handle( v-fillin-handle )
      946       then do:
      947           assign
      948               v-fillin-handle :SCREEN-value = v-fillin-string
      949           .
      950       end.
      951   end.
      952   end procedure.
      953   procedure bgelib-write-header:
      954   do
      955   on error undo, return error
      956   :
      957   define input parameter p-first-file     as logical      no-undo.
      958   define input parameter p-xml-file-name  as character    no-undo.
      959   define input parameter p-list-file-name as character    no-undo.
      960   define input parameter p-file-number    as integer      no-undo.
      961   define input parameter p-have-prev      as logical      no-undo.
      962   define input parameter p-prev-filename  as character    no-undo.
      963   define input parameter p-obj-list       as character    no-undo.
      964   define input parameter p-doc-type-list  as character    no-undo.
      965   define input parameter p-parameter-list as character    no-undo.
      966       define variable v-counter    as integer        no-undo.
      967       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      968       put stream stmXMLOut unformatted
      969           "<?xml version='1.0' encoding='windows-1251'?>"
      970       .
      971       run bgelib-tag-open( input 0, input "root"  , input "" ).
      972       run bgelib-tag-open( input 0, input "header", input "" ).
      973       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      974       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      975       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      976       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      977       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      978       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      979       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      980       :
      981           run bgelib-tag-put(
      982                 input 1
      983               , input entry( 2 * v-counter, p-parameter-list )
      984               , input entry( 2 * v-counter + 1, p-parameter-list )
      985               , input 0
      986           ).
      987       end.
      988       run bgelib-tag-close( input 0, input "header" ).
      989       output stream stmXMLOut close.
      990       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      991       if p-first-file = yes
      992       then do:
      993           put stream stmXMLOut unformatted
      994               "<?xml version='1.0' encoding='windows-1251'?>"
      995           .
      996           run bgelib-tag-open( input 0, input "export", input "" ).
      997       end.
      998       run bgelib-tag-open( input 1, input "file", input "" ).
      999       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1000       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1001       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1002       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1003       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1004       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1005       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1006       :
     1007           run bgelib-tag-put(
     1008                 input 2
     1009               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1010               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1011               , input 0
     1012           ).
     1013       end.
     1014       run bgelib-tag-close( input 1, input "file" ).
     1015       output stream stmXMLOut close.
     1016   end.
     1017   end procedure.
     1018   procedure bgelib-write-footer:
     1019   do
     1020   on error undo, return error
     1021   :
     1022   define input parameter p-last-file      as logical      no-undo.
     1023   define input parameter p-xml-file-name  as character    no-undo.
     1024   define input parameter p-list-file-name as character    no-undo.
     1025   define input parameter p-have-next      as logical      no-undo.
     1026   define input parameter p-next-file-name as character    no-undo.
     1027       define variable v-error-num     as integer           no-undo.
     1028       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1029       if p-have-next = yes
     1030       then do:
     1031           run bgelib-tag-open( input 0, input "footer", "" ).
     1032           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1033           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1034           run bgelib-tag-close( input 0, input "footer" ).
     1035       end.
     1036       run bgelib-tag-close( input 0, input "root" ).
     1037       output stream stmXMLOut close.
     1038       run bge/os_copy.p (
     1039             input "M"
     1040           , input p-xml-file-name + "tmp"
     1041           , input p-xml-file-name + "xml"
     1042           , output v-error-num
     1043       ).
     1044       if p-last-file = yes
     1045       then do:
     1046           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1047               run bgelib-tag-close( input 0, input "export" ).
     1048           output stream stmXMLOut close.
     1049           run bge/os_copy.p (
     1050                 input "M"
     1051               , input p-list-file-name + "tmp"
     1052               , input p-list-file-name + "xml"
     1053               , output v-error-num
     1054           ).
     1055       end.
     1056   end.
     1057   end procedure.
     1058   procedure bgelib-filename :
     1059   do
     1060   on error undo, return error
     1061   :
     1062   define input parameter p-prefix             as character    no-undo.
     1063   define output parameter p-xml-file-name     as character    no-undo.
     1064   define output parameter p-log-file-name     as character    no-undo.
     1065   define output parameter p-list-file-name    as character    no-undo.
     1066       define variable v-home-dir  as character    no-undo.
     1067       define variable v-error-num as integer      no-undo.
     1068       get-key-value section "BGE" key "outdir" value v-home-dir.
     1069       if v-home-dir = ?
     1070       then do:
     1071           message
     1072             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1073             skip(1)
     1074             skip "Обратитесь к администратору."
     1075           view-as alert-box error.
     1076           undo, return error .
     1077       end.
     1078       run gbl/dir-cre.p (
     1079           input v-home-dir
     1080       ) no-error.
     1081       if error-status :error
     1082       then do:
     1083           message
     1084             skip "Неверно задан каталог экспорта."
     1085             skip(1)
     1086             skip "Обратитесь к администратору."
     1087           view-as alert-box error.
     1088           undo, return error .
     1089       end.
     1090       run bge/genfname.p (
     1091             input v-home-dir
     1092           , input p-prefix
     1093           , input ""
     1094           , input "xml"
     1095           , input "tmp"
     1096           , output p-xml-file-name
     1097       ).
     1098       assign
     1099           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1100           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1101           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1102       .
     1103   end.
     1104   end procedure.
     1105   procedure bgelib-read-config :
     1106   do
     1107   on error undo, return error
     1108   :
     1109   define variable v-par-type as character     no-undo.
     1110     define variable v-param-type      as character  no-undo .
     1111     define variable v-value-character as character  no-undo .
     1112     define variable v-value-date      as date       no-undo .
     1113     define variable v-value-decimal   as decimal    no-undo .
     1114     define variable v-value-integer   as integer    no-undo .
     1115     define variable v-value-logical   as logical    no-undo .
     1116     define variable v-tth             as handle     no-undo .
     1117       assign
     1118           v-bgelib-bgeclall = no
     1119           v-bgelib-bgedict  = no
     1120       .
     1121       run adm/shattri.p ( input "get":U
     1122                         , input  '':u
     1123                         , input  0
     1124                         , input  'bge-export':U
     1125                         , input  'bgeclall':U
     1126                         , output v-value-character
     1127                         , output v-value-date
     1128                         , output v-value-decimal
     1129                         , output v-value-integer
     1130                         , output v-value-logical
     1131                         , output v-param-type
     1132                         , input-output table-handle v-tth
     1133                         ) no-error .
     1134       if error-status :error
     1135       then do:
     1136         assign
     1137           v-bgelib-bgeclall = no
     1138         .
     1139       end.
     1140       else do:
     1141         assign
     1142           v-bgelib-bgeclall = v-value-logical
     1143         .
     1144       end.
     1145       delete object v-tth.
     1146       run adm/shattri.p ( input "get":U
     1147                         , input  '':u
     1148                         , input  0
     1149                         , input  'bge-export':U
     1150                         , input  'bgedict':U
     1151                         , output v-value-character
     1152                         , output v-value-date
     1153                         , output v-value-decimal
     1154                         , output v-value-integer
     1155                         , output v-value-logical
     1156                         , output v-param-type
     1157                         , input-output table-handle v-tth
     1158                         ) no-error .
     1159       if error-status :error
     1160       then do:
     1161         assign
     1162           v-bgelib-bgedict = no
     1163         .
     1164       end.
     1165       else do:
     1166         assign
     1167           v-bgelib-bgedict = v-value-logical
     1168         .
     1169       end.
     1170       delete object v-tth.
     1171       run adm/shattri.p ( input "get":U
     1172                         , input  '':u
     1173                         , input  0
     1174                         , input  'bge-export':U
     1175                         , input  'bgefmt':U
     1176                         , output v-value-character
     1177                         , output v-value-date
     1178                         , output v-value-decimal
     1179                         , output v-value-integer
     1180                         , output v-value-logical
     1181                         , output v-param-type
     1182                         , input-output table-handle v-tth
     1183                         ) no-error .
     1184       if error-status :error
     1185       then do:
     1186         assign
     1187           v-bgelib-bgefmt  = "xml":U
     1188         .
     1189       end.
     1190       else do:
     1191         assign
     1192           v-bgelib-bgefmt  = v-value-character
     1193         .
     1194       end.
     1195       delete object v-tth.
     1196       run adm/shattri.p ( input "get":U
     1197                         , input  '':u
     1198                         , input  0
     1199                         , input  'bge-export':U
     1200                         , input  'bgeflold':U
     1201                         , output v-value-character
     1202                         , output v-value-date
     1203                         , output v-value-decimal
     1204                         , output v-value-integer
     1205                         , output v-value-logical
     1206                         , output v-param-type
     1207                         , input-output table-handle v-tth
     1208                         ) no-error .
     1209       if error-status :error
     1210       then do:
     1211         assign
     1212           v-bgelib-bgeflold  = "old":U
     1213         .
     1214       end.
     1215       else do:
     1216         assign
     1217           v-bgelib-bgeflold  = v-value-character
     1218         .
     1219       end.
     1220       delete object v-tth.
     1221   end.
     1222   end procedure.
     1223   procedure bgelib-check-file-size :
     1224   do
     1225   on error undo, return error
