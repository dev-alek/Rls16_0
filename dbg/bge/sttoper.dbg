     1480               run write-result in this-procedure (
     1481                     input p-obj-type
     1482                   , input p-obj-code
     1483                   , input buf_gds-obj.gds-code
     1484                   , input buf_gds-obj.free-qnty
     1485                   , input 'v':U
     1486                   , input p-fact-order-to
     1487                   , input v-r-b-is-base
     1488               ) no-error.
     1489               if error-status :error
     1490               then do:
     1491                   run bgelib-write-log in this-procedure (
     1492                         input p-log-file-name
     1493                       , input 1
     1494                       , input substitute( "*** Ошибка выгрузки по типу приобретения &1. Объект &2 &3. Код товара &4. &5. &6"
     1495                                               , "service":U
     1496                                               , p-obj-type
     1497                                               , p-obj-code
     1498                                               , buf_gds-obj.gds-code
     1499                                               , return-value
     1500                                               , trim(error-status :get-message(1))
     1501                                       )
     1502                   ).
     1503               end.
     1504               if v-hcnt-is-active = no
     1505               then do:
