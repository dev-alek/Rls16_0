     1510                       v-hcnt-is-active = yes
     1511                   .
     1512                   run bgelib-write-cnt(
     1513                         input hcnt
     1514                       , input substitute( "Объект: &1&2 Товаров: &3", p-obj-type, p-obj-code, 1 )
     1515                   ).
     1516                   process events.
     1517               end.
     1518               assign
