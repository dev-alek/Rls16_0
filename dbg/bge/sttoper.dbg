     1376                       , input ""
     1377                       , input p-parameter-list
     1378                   ).
     1379                   output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1380                   assign
     1381                       v-need-new-file = no
     1382                   .
     1383               end.
     1384               run write-result in this-procedure (
     1385                     input p-obj-type
     1386                   , input p-obj-code
     1387                   , input buf_gds-obj.gds-code
     1388                   , input buf_gds-obj.free-qnty
     1389                   , input 'r':U
     1390                   , input p-fact-order-to
     1391                   , input v-r-b-is-base
     1392               ) no-error.
     1393               if error-status :error
     1394               then do:
     1395                   run bgelib-write-log in this-procedure (
     1396                         input p-log-file-name
     1397                       , input 1
     1398                       , input substitute( "*** Ошибка выгрузки по типу приобретения &1. Объект &2 &3. Код товара &4. &5. &6"
     1399                                               , "repayment":U
     1400                                               , p-obj-type
     1401                                               , p-obj-code
     1402                                               , buf_gds-obj.gds-code
     1403                                               , return-value
     1404                                               , trim(error-status :get-message(1))
     1405                                       )
     1406                   ).
     1407               end.
     1408               run write-result in this-procedure (
     1409                     input p-obj-type
     1410                   , input p-obj-code
     1411                   , input buf_gds-obj.gds-code
     1412                   , input buf_gds-obj.free-qnty
     1413                   , input 'c':U
     1414                   , input p-fact-order-to
     1415                   , input v-r-b-is-base
     1416               ) no-error.
     1417               if error-status :error
     1418               then do:
     1419                   run bgelib-write-log in this-procedure (
     1420                         input p-log-file-name
     1421                       , input 1
     1422                       , input substitute( "*** Ошибка выгрузки по типу приобретения &1. Объект &2 &3. Код товара &4. &5. &6"
     1423                                               , "cons_acc":U
     1424                                               , p-obj-type
     1425                                               , p-obj-code
     1426                                               , buf_gds-obj.gds-code
     1427                                               , return-value
     1428                                               , trim(error-status :get-message(1))
     1429                                       )
     1430                   ).
     1431               end.
     1432               run write-result in this-procedure (
     1433                     input p-obj-type
     1434                   , input p-obj-code
     1435                   , input buf_gds-obj.gds-code
     1436                   , input buf_gds-obj.free-qnty
     1437                   , input 's':U
     1438                   , input p-fact-order-to
     1439                   , input v-r-b-is-base
     1440               ) no-error.
     1441               if error-status :error
     1442               then do:
     1443                   run bgelib-write-log in this-procedure (
     1444                         input p-log-file-name
     1445                       , input 1
     1446                       , input substitute( "*** Ошибка выгрузки по типу приобретения &1. Объект &2 &3. Код товара &4. &5. &6"
     1447                                               , "resp_stor":U
     1448                                               , p-obj-type
     1449                                               , p-obj-code
     1450                                               , buf_gds-obj.gds-code
     1451                                               , return-value
     1452                                               , trim(error-status :get-message(1))
     1453                                       )
     1454                   ).
     1455               end.
     1456               run write-result in this-procedure (
     1457                     input p-obj-type
     1458                   , input p-obj-code
     1459                   , input buf_gds-obj.gds-code
     1460                   , input buf_gds-obj.free-qnty
     1461                   , input 'o':U
     1462                   , input p-fact-order-to
     1463                   , input v-r-b-is-base
     1464               ) no-error.
     1465               if error-status :error
     1466               then do:
     1467                   run bgelib-write-log in this-procedure (
     1468                         input p-log-file-name
     1469                       , input 1
     1470                       , input substitute( "*** Ошибка выгрузки по типу приобретения &1. Объект &2 &3. Код товара &4. &5. &6"
     1471                                               , "old_cons":U
     1472                                               , p-obj-type
     1473                                               , p-obj-code
     1474                                               , buf_gds-obj.gds-code
     1475                                               , return-value
     1476                                               , trim(error-status :get-message(1))
     1477                                       )
     1478                   ).
