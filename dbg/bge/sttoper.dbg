     1534       end.
     1535       run bgelib-write-cnt(
     1536             input hcnt
     1537           , input substitute( "Объект: &1&2 Товаров: &3", p-obj-type, p-obj-code, v-goods-counter )
     1538       ).
     1539       output stream stmxmlout close.
     1540   if session :set-wait-state( "" ) then.
     1541   end.
     1542   procedure write-result :
     1543   define input parameter p-obj-type       as character        no-undo.
     1544   define input parameter p-obj-code       as integer          no-undo.
     1545   define input parameter p-gds-code       as integer          no-undo.
     1546   define input parameter p-free-qnty      as decimal          no-undo.
     1547   define input parameter p-sum-type       as character        no-undo.
     1548   define input parameter p-fact-order     as integer          no-undo.
     1549   define input parameter p-r-b-is-base    as logical          no-undo.
     1550       define variable v-gds-code          as integer      no-undo.
     1551       define variable v-gds-name          as character    no-undo.
     1552       define variable v-not-output-result as logical      no-undo.
     1553       define variable v-sum-types         as character    no-undo.
     1554       define variable v-main-tags         as character    no-undo.
     1555       define variable v-main-tag          as character    no-undo.
     1556       define buffer buf_goods             for ub.goods.
     1557       define buffer buf_aht-stk-line      for ub.aht-stk-line.
     1558       define buffer buf_benf_aht-stk-line for ub.aht-stk-line.
     1559   do
     1560   for buf_goods
     1561     , buf_aht-stk-line
     1562   on error undo, return error
     1563   :
     1564       find last buf_aht-stk-line no-lock
     1565           where buf_aht-stk-line.obj-type  = p-obj-type
     1566             and buf_aht-stk-line.obj-code  = p-obj-code
     1567             and buf_aht-stk-line.gds-code  = p-gds-code
     1568             and buf_aht-stk-line.sum-type  = p-sum-type
     1569             and buf_aht-stk-line.fact-order <= p-fact-order
     1570       use-index category
     1571       no-error.
     1572       if p-sum-type = 'c':U
     1573       then do:
     1574           find last buf_benf_aht-stk-line no-lock
     1575               where buf_benf_aht-stk-line.obj-type  = p-obj-type
     1576                 and buf_benf_aht-stk-line.obj-code  = p-obj-code
     1577                 and buf_benf_aht-stk-line.gds-code  = p-gds-code
     1578                 and buf_benf_aht-stk-line.sum-type  = 'b':U
     1579                 and buf_benf_aht-stk-line.fact-order <= p-fact-order
     1580           use-index category
     1581           no-error.
     1582       end.
     1583       assign
     1584           v-not-output-result = no
     1585       .
     1586       if ( not available buf_aht-stk-line )
     1587       or (    buf_aht-stk-line.fact-qnty              = 0
     1588           and buf_aht-stk-line.cost-sum-rubl          = 0
     1589           and buf_aht-stk-line.cost-VAT-rubl          = 0
     1590           and buf_aht-stk-line.cost-SLT-rubl          = 0
     1591           and buf_aht-stk-line.cost-road-tax-rubl     = 0
     1592           and buf_aht-stk-line.cost-transport-rubl    = 0
     1593           and buf_aht-stk-line.cost-other-rubl        = 0
     1594           and buf_aht-stk-line.cost-excise-rubl       = 0
     1595           and buf_aht-stk-line.cost-sum-base          = 0
     1596           and buf_aht-stk-line.cost-VAT-base          = 0
     1597           and buf_aht-stk-line.cost-SLT-base          = 0
     1598           and buf_aht-stk-line.cost-road-tax-base     = 0
     1599           and buf_aht-stk-line.cost-transport-base    = 0
     1600           and buf_aht-stk-line.cost-other-base        = 0
     1601           and buf_aht-stk-line.cost-excise-base       = 0 )
     1602       then do:
     1603           assign
     1604               v-not-output-result = yes
     1605           .
     1606           if p-r-b-is-base = yes
     1607           then do:
     1608               if ( not available buf_aht-stk-line )
     1609               or (    buf_aht-stk-line.crsa-sum-base       = 0
     1610                   and buf_aht-stk-line.crsa-VAT-base       = 0
     1611                   and buf_aht-stk-line.crsa-SLT-base       = 0
     1612                   and buf_aht-stk-line.crsa-road-tax-base  = 0
     1613                   and buf_aht-stk-line.crsa-transport-base = 0
     1614                   and buf_aht-stk-line.crsa-other-base     = 0
     1615                   and buf_aht-stk-line.crsa-excise-base    = 0 )
     1616               then do:
     1617                   assign
     1618                       v-not-output-result = yes
     1619                   .
     1620               end.
     1621               else do:
     1622                   assign
     1623                       v-not-output-result = no
     1624                   .
     1625               end.
     1626           end.
     1627           else do:
     1628               if ( not available buf_aht-stk-line )
     1629               or (    buf_aht-stk-line.crsa-sum-rubl       = 0
     1630                   and buf_aht-stk-line.crsa-VAT-rubl       = 0
     1631                   and buf_aht-stk-line.crsa-SLT-rubl       = 0
     1632                   and buf_aht-stk-line.crsa-road-tax-rubl  = 0
     1633                   and buf_aht-stk-line.crsa-transport-rubl = 0
     1634                   and buf_aht-stk-line.crsa-other-rubl     = 0
     1635                   and buf_aht-stk-line.crsa-excise-rubl    = 0 )
     1636               then do:
     1637                   assign
     1638                       v-not-output-result = yes
     1639                   .
     1640               end.
     1641               else do:
     1642                   assign
     1643                       v-not-output-result = no
     1644                   .
     1645               end.
     1646           end.
     1647       end.
     1648       if p-sum-type = 'c':U
     1649       then do:
     1650           if available buf_benf_aht-stk-line
     1651           and (
     1652               buf_benf_aht-stk-line.crsa-sum-rubl          <> 0
     1653               or buf_benf_aht-stk-line.crsa-VAT-rubl       <> 0
     1654               or buf_benf_aht-stk-line.crsa-SLT-rubl       <> 0
     1655               or buf_benf_aht-stk-line.crsa-road-tax-rubl  <> 0
     1656               or buf_benf_aht-stk-line.crsa-transport-rubl <> 0
     1657               or buf_benf_aht-stk-line.crsa-other-rubl     <> 0
     1658               or buf_benf_aht-stk-line.crsa-excise-rubl    <> 0 )
     1659           then do:
     1660               assign
     1661                   v-not-output-result = no
     1662               .
     1663           end.
     1664       end.
     1665       if v-not-output-result = yes
     1666       then do:
     1667           undo, return .
     1668       end.
     1669       find first buf_goods no-lock
     1670            where buf_goods.gds-code     = p-gds-code
     1671       no-error.
     1672       if available buf_goods
     1673       then do:
     1674           assign
     1675               v-gds-name              = buf_goods.gds-name
     1676           .
     1677       end.
     1678       else do:
     1679           assign
     1680               v-gds-name              = ""
     1681           .
     1682       end.
     1683       assign
     1684           v-sum-types = 'r':U
     1685                           + ",":U + 'c':U
     1686                           + ",":U + 'b':U
     1687                           + ",":U + 's':U
     1688                           + ",":U + 'o':U
     1689                           + ",":U + 'v':U
     1690       .
     1691       assign
     1692           v-main-tags = "storeGoodsRepayment"
     1693                           + ",":U + "storeGoodsCons_acc":U
     1694                           + ",":U + "storeGoodsCons_benf":U
     1695                           + ",":U + "storeGoodsResp_stor":U
     1696                           + ",":U + "storeGoodsOld_cons":U
     1697                           + ",":U + "storeGoodsService":U
     1698       .
     1699       assign
     1700           v-main-tag = entry( lookup( p-sum-type, v-sum-types ), v-main-tags )
     1701       no-error.
     1702       if error-status :error
     1703       or v-main-tag = ?
     1704       or v-main-tag = ""
     1705       then do:
     1706           undo, return error substitute( "Ошибка задания sum-type для архива по типам приобретения. Задано значение &1.", p-sum-type ).
     1707       end.
     1708       run bgelib-tag-open( input 1, input v-main-tag , input "" ).
     1709       run bgelib-tag-put( input 2, input "storeCode"      , input p-obj-type + string( p-obj-code ) , input 0 ).
     1710       run bgelib-tag-put( input 2, input "goodsCode"      , input string( p-gds-code              ) , input 0 ).
     1711       run bgelib-tag-put( input 2, input "goodsArtic"     , input string( buf_goods.artic         ) , input 0 ).
     1712       run bgelib-tag-put( input 2, input "goodsProdType"  , input string( buf_goods.prod-type     ) , input 0 ).
     1713       run bgelib-tag-put( input 2, input "goodsProdCode"  , input string( buf_goods.prod-code     ) , input 0 ).
     1714       run bgelib-tag-put( input 2, input "goodsName"      , input string( v-gds-name              ) , input 0 ).
     1715       run bgelib-tag-put( input 2, input "goodsFreeQntyDate"  , input string( v-today, "99.99.9999"   ) , input 0 ).
     1716       run bgelib-tag-put( input 2, input "goodsFreeQntyTime"  , input string( v-time , "hh:mm:ss"     ) , input 0 ).
     1717       run bgelib-tag-put( input 2, input "goodsFreeQnty"      , input string( p-free-qnty             ) , input 0 ).
     1718       if available buf_aht-stk-line
     1719       then do:
     1720           run bgelib-tag-put( input 2, input "goodsQnty"             , input string( buf_aht-stk-line.fact-qnty           ), input 2 ).
     1721           run bgelib-tag-put( input 2, input "goodsCostSumr"         , input string( buf_aht-stk-line.cost-sum-rubl       ), input 2 ).
     1722           run bgelib-tag-put( input 2, input "goodsCostVatr"         , input string( buf_aht-stk-line.cost-VAT-rubl       ), input 2 ).
     1723           run bgelib-tag-put( input 2, input "goodsCostSltr"         , input string( buf_aht-stk-line.cost-SLT-rubl       ), input 2 ).
     1724           run bgelib-tag-put( input 2, input "goodsCostRoadtaxr"     , input string( buf_aht-stk-line.cost-road-tax-rubl  ), input 2 ).
     1725           run bgelib-tag-put( input 2, input "goodsCostTransportr"   , input string( buf_aht-stk-line.cost-transport-rubl ), input 2 ).
     1726           run bgelib-tag-put( input 2, input "goodsCostOtherr"       , input string( buf_aht-stk-line.cost-other-rubl     ), input 2 ).
     1727           run bgelib-tag-put( input 2, input "goodsCostExciser"      , input string( buf_aht-stk-line.cost-excise-rubl    ), input 2 ).
     1728           run bgelib-tag-put( input 2, input "goodsCostSumb"         , input string( buf_aht-stk-line.cost-sum-base       ), input 2 ).
     1729           run bgelib-tag-put( input 2, input "goodsCostVatb"         , input string( buf_aht-stk-line.cost-VAT-base       ), input 2 ).
     1730           run bgelib-tag-put( input 2, input "goodsCostSltb"         , input string( buf_aht-stk-line.cost-SLT-base       ), input 2 ).
     1731           run bgelib-tag-put( input 2, input "goodsCostRoadtaxb"     , input string( buf_aht-stk-line.cost-road-tax-base  ), input 2 ).
     1732           run bgelib-tag-put( input 2, input "goodsCostTransportb"   , input string( buf_aht-stk-line.cost-transport-base ), input 2 ).
     1733           run bgelib-tag-put( input 2, input "goodsCostOtherb"       , input string( buf_aht-stk-line.cost-other-base     ), input 2 ).
     1734           run bgelib-tag-put( input 2, input "goodsCostExciseb"      , input string( buf_aht-stk-line.cost-excise-base    ), input 2 ).
     1735       end.
     1736       if available buf_aht-stk-line
     1737       then do:
     1738           if p-r-b-is-base = yes
     1739           then do:
     1740               if p-sum-type = 'c':U
     1741               then do:
     1742                   run bgelib-tag-put( input 2, input "goodsConsSaleSumb"         , input string( buf_aht-stk-line.crsa-sum-base        ) , input 2 ).
     1743                   run bgelib-tag-put( input 2, input "goodsConsSaleVatb"         , input string( buf_aht-stk-line.crsa-VAT-base        ) , input 2 ).
     1744                   run bgelib-tag-put( input 2, input "goodsConsSaleSltb"         , input string( buf_aht-stk-line.crsa-SLT-base        ) , input 2 ).
     1745                   run bgelib-tag-put( input 2, input "goodsConsSaleRoadtaxb"     , input string( buf_aht-stk-line.crsa-road-tax-base   ) , input 2 ).
     1746                   run bgelib-tag-put( input 2, input "goodsConsSaleTransportb"   , input string( buf_aht-stk-line.crsa-transport-base  ) , input 2 ).
     1747                   run bgelib-tag-put( input 2, input "goodsConsSaleOtherb"       , input string( buf_aht-stk-line.crsa-other-base      ) , input 2 ).
     1748                   run bgelib-tag-put( input 2, input "goodsConsSaleExciseb"      , input string( buf_aht-stk-line.crsa-excise-base     ) , input 2 ).
     1749                   if available buf_benf_aht-stk-line
     1750                   then do:
     1751                       run bgelib-tag-put( input 2, input "goodsBenfSaleSumb"         , input string( buf_benf_aht-stk-line.crsa-sum-base        ) , input 2 ).
     1752                       run bgelib-tag-put( input 2, input "goodsBenfSaleVatb"         , input string( buf_benf_aht-stk-line.crsa-VAT-base        ) , input 2 ).
     1753                       run bgelib-tag-put( input 2, input "goodsBenfSaleSltb"         , input string( buf_benf_aht-stk-line.crsa-SLT-base        ) , input 2 ).
     1754                       run bgelib-tag-put( input 2, input "goodsBenfSaleRoadtaxb"     , input string( buf_benf_aht-stk-line.crsa-road-tax-base   ) , input 2 ).
     1755                       run bgelib-tag-put( input 2, input "goodsBenfSaleTransportb"   , input string( buf_benf_aht-stk-line.crsa-transport-base  ) , input 2 ).
     1756                       run bgelib-tag-put( input 2, input "goodsBenfSaleOtherb"       , input string( buf_benf_aht-stk-line.crsa-other-base      ) , input 2 ).
     1757                       run bgelib-tag-put( input 2, input "goodsBenfSaleExciseb"      , input string( buf_benf_aht-stk-line.crsa-excise-base     ) , input 2 ).
     1758                   end.
     1759                   run bgelib-tag-put( input 2, input "goodsSaleSumb"         , input string( buf_aht-stk-line.crsa-sum-base        + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-sum-base       else 0 ) ) , input 2 ).
     1760                   run bgelib-tag-put( input 2, input "goodsSaleVatb"         , input string( buf_aht-stk-line.crsa-VAT-base        + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-VAT-base       else 0 ) ) , input 2 ).
     1761                   run bgelib-tag-put( input 2, input "goodsSaleSltb"         , input string( buf_aht-stk-line.crsa-SLT-base        + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-SLT-base       else 0 ) ) , input 2 ).
     1762                   run bgelib-tag-put( input 2, input "goodsSaleRoadtaxb"     , input string( buf_aht-stk-line.crsa-road-tax-base   + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-road-tax-base  else 0 ) ) , input 2 ).
     1763                   run bgelib-tag-put( input 2, input "goodsSaleTransportb"   , input string( buf_aht-stk-line.crsa-transport-base  + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-transport-base else 0 ) ) , input 2 ).
     1764                   run bgelib-tag-put( input 2, input "goodsSaleOtherb"       , input string( buf_aht-stk-line.crsa-other-base      + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-other-base     else 0 ) ) , input 2 ).
     1765                   run bgelib-tag-put( input 2, input "goodsSaleExciseb"      , input string( buf_aht-stk-line.crsa-excise-base     + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-excise-base    else 0 ) ) , input 2 ).
     1766               end.
     1767               else do:
     1768                   run bgelib-tag-put( input 2, input "goodsSaleSumb"         , input string( buf_aht-stk-line.crsa-sum-base        ) , input 2 ).
     1769                   run bgelib-tag-put( input 2, input "goodsSaleVatb"         , input string( buf_aht-stk-line.crsa-VAT-base        ) , input 2 ).
     1770                   run bgelib-tag-put( input 2, input "goodsSaleSltb"         , input string( buf_aht-stk-line.crsa-SLT-base        ) , input 2 ).
     1771                   run bgelib-tag-put( input 2, input "goodsSaleRoadtaxb"     , input string( buf_aht-stk-line.crsa-road-tax-base   ) , input 2 ).
     1772                   run bgelib-tag-put( input 2, input "goodsSaleTransportb"   , input string( buf_aht-stk-line.crsa-transport-base  ) , input 2 ).
     1773                   run bgelib-tag-put( input 2, input "goodsSaleOtherb"       , input string( buf_aht-stk-line.crsa-other-base      ) , input 2 ).
     1774                   run bgelib-tag-put( input 2, input "goodsSaleExciseb"      , input string( buf_aht-stk-line.crsa-excise-base     ) , input 2 ).
     1775               end.
     1776           end.
     1777           else do:
     1778               if p-sum-type = 'c':U
     1779               then do:
     1780                   run bgelib-tag-put( input 2, input "goodsConsSaleSumr"         , input string( buf_aht-stk-line.crsa-sum-rubl        ) , input 2 ).
     1781                   run bgelib-tag-put( input 2, input "goodsConsSaleVatr"         , input string( buf_aht-stk-line.crsa-VAT-rubl        ) , input 2 ).
     1782                   run bgelib-tag-put( input 2, input "goodsConsSaleSltr"         , input string( buf_aht-stk-line.crsa-SLT-rubl        ) , input 2 ).
     1783                   run bgelib-tag-put( input 2, input "goodsConsSaleRoadtaxr"     , input string( buf_aht-stk-line.crsa-road-tax-rubl   ) , input 2 ).
     1784                   run bgelib-tag-put( input 2, input "goodsConsSaleTransportr"   , input string( buf_aht-stk-line.crsa-transport-rubl  ) , input 2 ).
     1785                   run bgelib-tag-put( input 2, input "goodsConsSaleOtherr"       , input string( buf_aht-stk-line.crsa-other-rubl      ) , input 2 ).
     1786                   run bgelib-tag-put( input 2, input "goodsConsSaleExciser"      , input string( buf_aht-stk-line.crsa-excise-rubl     ) , input 2 ).
     1787                   if available buf_benf_aht-stk-line
     1788                   then do:
     1789                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfSumr"         , input string( buf_benf_aht-stk-line.crsa-sum-rubl        ) , input 2 ).
     1790                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfVatr"         , input string( buf_benf_aht-stk-line.crsa-VAT-rubl        ) , input 2 ).
     1791                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfSltr"         , input string( buf_benf_aht-stk-line.crsa-SLT-rubl        ) , input 2 ).
     1792                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfRoadtaxr"     , input string( buf_benf_aht-stk-line.crsa-road-tax-rubl   ) , input 2 ).
     1793                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfTransportr"   , input string( buf_benf_aht-stk-line.crsa-transport-rubl  ) , input 2 ).
     1794                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfOtherr"       , input string( buf_benf_aht-stk-line.crsa-other-rubl      ) , input 2 ).
     1795                       run bgelib-tag-put( input 2, input "goodsBenfSaleBenfExciser"      , input string( buf_benf_aht-stk-line.crsa-excise-rubl     ) , input 2 ).
     1796                   end.
     1797                   run bgelib-tag-put( input 2, input "goodsSaleSumr"         , input string( buf_aht-stk-line.crsa-sum-rubl        + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-sum-rubl       else 0 ) ) , input 2 ).
     1798                   run bgelib-tag-put( input 2, input "goodsSaleVatr"         , input string( buf_aht-stk-line.crsa-VAT-rubl        + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-VAT-rubl       else 0 ) ) , input 2 ).
     1799                   run bgelib-tag-put( input 2, input "goodsSaleSltr"         , input string( buf_aht-stk-line.crsa-SLT-rubl        + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-SLT-rubl       else 0 ) ) , input 2 ).
     1800                   run bgelib-tag-put( input 2, input "goodsSaleRoadtaxr"     , input string( buf_aht-stk-line.crsa-road-tax-rubl   + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-road-tax-rubl  else 0 ) ) , input 2 ).
     1801                   run bgelib-tag-put( input 2, input "goodsSaleTransportr"   , input string( buf_aht-stk-line.crsa-transport-rubl  + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-transport-rubl else 0 ) ) , input 2 ).
     1802                   run bgelib-tag-put( input 2, input "goodsSaleOtherr"       , input string( buf_aht-stk-line.crsa-other-rubl      + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-other-rubl     else 0 ) ) , input 2 ).
     1803                   run bgelib-tag-put( input 2, input "goodsSaleExciser"      , input string( buf_aht-stk-line.crsa-excise-rubl     + ( if available buf_benf_aht-stk-line then buf_benf_aht-stk-line.crsa-excise-rubl    else 0 ) ) , input 2 ).
     1804               end.
     1805               else do:
     1806                   run bgelib-tag-put( input 2, input "goodsSaleSumr"         , input string( buf_aht-stk-line.crsa-sum-rubl        ) , input 2 ).
     1807                   run bgelib-tag-put( input 2, input "goodsSaleVatr"         , input string( buf_aht-stk-line.crsa-VAT-rubl        ) , input 2 ).
     1808                   run bgelib-tag-put( input 2, input "goodsSaleSltr"         , input string( buf_aht-stk-line.crsa-SLT-rubl        ) , input 2 ).
     1809                   run bgelib-tag-put( input 2, input "goodsSaleRoadtaxr"     , input string( buf_aht-stk-line.crsa-road-tax-rubl   ) , input 2 ).
     1810                   run bgelib-tag-put( input 2, input "goodsSaleTransportr"   , input string( buf_aht-stk-line.crsa-transport-rubl  ) , input 2 ).
     1811                   run bgelib-tag-put( input 2, input "goodsSaleOtherr"       , input string( buf_aht-stk-line.crsa-other-rubl      ) , input 2 ).
     1812                   run bgelib-tag-put( input 2, input "goodsSaleExciser"      , input string( buf_aht-stk-line.crsa-excise-rubl     ) , input 2 ).
     1813               end.
     1814           end.
     1815       end.
     1816       run bgelib-tag-close( input 1, input v-main-tag ).
     1817   end.
     1818   end procedure.
     1819   procedure get-base-code-okv :
     1820   define input parameter p-base-code          as integer          no-undo.
     1821   define output parameter p-base-code-okv     as integer          no-undo.
     1822       define buffer buf_currency      for ub.currency.
     1823   do
     1824   for buf_currency
     1825   on error undo, return error
     1826   :
     1827       find first buf_currency no-lock
     1828            where buf_currency.curr-code = p-base-code
     1829       .
     1830       assign
     1831           p-base-code-okv = buf_currency.okv-code
     1832       .
     1833   end.
     1834   end procedure.
