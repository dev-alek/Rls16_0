      705   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   define variable v-waitfram-action01         as character   no-undo .
      707   define variable v-waitfram-action02         as character   no-undo .
      708   define variable v-waitfram-action03         as character   no-undo .
      709   define variable mWaitFramTextBeg            as character   no-undo.
      710   define variable mWaitFramTextEnd            as character   no-undo.
      711   define variable mWaitFramView               as logical     no-undo.
      712   define variable mWaitProcEvent              as logical     no-undo init yes.
      713   define variable mWaitFramInterval           as integer     no-undo init 1 .
      714   define variable mWaitFramStop               as logical     no-undo.
      715   define variable mWaitFramStopUser           as logical     no-undo.
      716   define variable mWaitFramStopTimeOut        as logical     no-undo.
      717   define variable mWaitFramStartProc          as datetime-tz no-undo.
      718   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      719   define button B-WaitFramStop auto-end-key
      720        label "Стоп"
      721        size 10 by 1 tooltip "Остоновить процесс".
      722   define button B-viewProcInfo
      723        label "Информация"
      724        size 15 by 1 tooltip "Информация о процесс".
      725   define frame waitfram
      726     v-waitfram-action01 format "x(72)" no-label skip
      727     v-waitfram-action02 format "x(72)" no-label skip
      728     v-waitfram-action03 format "x(72)" no-label skip
      729     B-viewProcInfo
      730     B-WaitFramStop at row 4 col 30
      731     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      732     .
      733   define new global shared variable mBatchMode as logical no-undo init ?.
      734   define variable mFramBachModHandle as handle no-undo.
      735   mFramBachModHandle = frame waitfram:handle.
      736   define variable mFameOldVis as logical no-undo.
      737   define variable mVisCUrentVin as logical no-undo.
      738   if session:batch-mode
      739   then
      740      mBatchMode = yes.
      741   if mBatchMode = ? then do:
      742     mVisCUrentVin = current-window:visible.
      743     mFameOldVis = mFramBachModHandle:visible.
      744     mFramBachModHandle:visible  = yes.
      745     mBatchMode = mFramBachModHandle:visible ne yes.
      746     mFramBachModHandle:visible = mFameOldVis.
      747     current-window:visible = mVisCUrentVin.
      748   end.
      749    if  log-manager:logfile-name ne ?
      750     then DO:
      751         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      752         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      753         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      754     end.
      755   on choose of B-WaitFramStop in frame waitfram
      756   do:
      757     mWaitFramStop = yes.
      758     mWaitFramStopUser = yes.
      759   end.
      760   function waitfram-check-timeout returns logical():
      761      define variable vtime as int64 no-undo.
      762      if mWaitFramStopTimeOut
      763      then
      764         return yes.
      765      vtime = ( now - mWaitFramStartProc ) / 1000 .
      766      if     mWaitFramTimeOut ne ?
      767         and mWaitFramTimeOut ne 0
      768         and mWaitFramTimeOut lt vtime
      769      then do:
      770         mWaitFramStopTimeOut = yes.
      771      end.
      772      return mWaitFramStopTimeOut.
      773   end.
      774   procedure waitfram-hide :
      775     if not session:batch-mode
      776     then do
      777     on error undo, return error return-value
      778     :
      779       pause 0 before-hide .
      780       if not mBatchMode then
      781         hide frame waitfram .
      782     if     not mWaitFramView
      783        and mWaitProcEvent
      784     then
      785       process events .
      786     end.
      787   end procedure.
      788   procedure waitfram-show :
      789     define input  parameter p-message as character no-undo .
      790     define variable v-left-margin as integer   no-undo .
      791     if not session:batch-mode
      792     then do
      793     on error undo, return error return-value
      794     :
      795       if length(p-message) <= 70 then do:
      796         assign
      797           v-left-margin = integer((70 - length(p-message)) / 2)
      798         .
      799         assign
      800           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      801         .
      802         assign
      803           v-waitfram-action01 = " "
      804           v-waitfram-action02 = " "
      805                                    + fill(" ", v-left-margin)
      806                                    + p-message
      807           v-waitfram-action03 = " "
      808         .
      809       end.
      810       else do:
      811         define variable vRindex1 as integer no-undo.
      812         define variable vRindex2 as integer no-undo.
      813         vRindex1 = r-index(p-message," ",70).
      814         if vRindex1 = 0
      815         then
      816            vRindex1 = 70.
      817         if length(p-message)  <= vRindex1 + 70 then do:
      818           assign
      819             v-waitfram-action01 = " "
      820             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      821             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      822           .
      823         end.
      824         else do:
      825           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      826           if vRindex2 <= vRindex1
      827           then
      828              vRindex2 = vRindex1 + 70.
      829           assign
      830             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      831             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      832             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      833           .
      834         end.
      835       end.
      836       B-viewProcInfo:visible   in frame waitfram = no.
      837       B-viewProcInfo:sensitive in frame waitfram = no.
      838       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      839       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      840       if  (   mWaitFramView
      841          or  mWaitProcEvent)
      842          and not mBatchMode
      843       then
      844          display
      845             v-waitfram-action01 skip
      846             v-waitfram-action02 skip
      847             v-waitfram-action03 skip
      848          with frame waitfram .
      849       if     mWaitFramView
      850          then do:
      851             if     mWaitFramInterval ne ?
      852                and not mBatchMode
      853             then
      854                wait-for go of frame waitfram pause mWaitFramInterval.
      855          end.
      856          else
      857             if     mWaitProcEvent
      858                and not mBatchMode
      859             then
      860                process events .
      861     end.
      862   end procedure.
      863      procedure waitfram-show-this:
      864         define input  parameter iInterval as int64 no-undo.
      865         define variable vtime as int64 no-undo.
      866         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      867         mWaitFramInterval = iInterval.
      868         run waitfram-show (substitute("&1&2 &3&4" ,
      869                                       mWaitFramTextBeg ,
      870                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      871                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      872                                       mWaitFramTextEnd
      873                                      )
      874                           ).
      875      end.
      876      procedure WaitFramRunPause:
      877         define input  parameter iInterval as dec no-undo.
      878         define variable vStart  as datetime-tz no-undo.
      879         define variable vend    as datetime-tz no-undo.
      880         define variable vint as int64 no-undo.
      881         define variable vOk as logical no-undo.
      882         vStart = now.
      883         vend   = vStart.
      884         publish "WaitFramPause" (iInterval,output vOk).
      885         vend   =  now.
      886         vint = vend - vStart.
      887         vint = iInterval - vint / 1000.
      888         if     not mWaitFramStop
      889            and (   vint > 0
      890                 or (    not vOk
      891                     and iInterval eq ?
      892                     )
      893                 )
      894         then
      895            run waitfram-show-this (iInterval).
      896         vend   =  now.
      897         vint = vend - vStart.
      898         vint = iInterval - vint / 1000.
      899         if     not mWaitFramStop
      900            and vint > 0
      901         then do:
      902            run gbl/pause.p (vint * 1000).
      903         end.
      904         if iInterval ne ?
      905         then
      906            publish "WaitFramStop".
      907         waitfram-check-timeout().
      908      end.
      909      procedure WaitFramWaitFor:
      910         define input  parameter iInterval as dec no-undo.
      911         assign
      912            mWaitFramStartProc   = now
      913            mWaitFramStopUser    = no
      914            mWaitFramStopTimeOut = no
      915         .
      916         block-wait:
      917         do while not mWaitFramStop:
      918            run WaitFramRunPause (iInterval).
      919            if  waitfram-check-timeout()
      920            then do:
      921               leave block-wait.
      922            end.
      923         end.
      924         run waitfram-hide.
      925      end.
      926   procedure waitfram-join :
      927     define input  parameter p-line-1  as character no-undo .
      928     define input  parameter p-line-2  as character no-undo .
      929     define input  parameter p-line-3  as character no-undo .
      930     define output parameter p-message as character no-undo .
      931     do
      932     on error undo, return error return-value
      933     :
      934       assign
      935         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      936                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      937                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      938       .
      939     end.
      940   end procedure.
      941   function waitfram-join-function returns character
      942     (input p-line-1 as character
      943     ,input p-line-2 as character
      944     ,input p-line-3 as character
      945     ).
      946     define variable v-message as character no-undo .
      947     run waitfram-join in this-procedure
      948       (input  p-line-1
      949       ,input  p-line-2
      950       ,input  p-line-3
      951       ,output v-message
      952       ) .
      953     return v-message .
      954   end function .
      955   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      956   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      957   define variable MarkType as ibs.th.str.marking.Types no-undo.
      958   MarkType = ObjSrv:Env:Marking:Types.
      959   define input parameter parparentproc as widget-handle no-undo .
      960   define variable conf-par             as character no-undo.
      961   define variable par-type             as character no-undo.
      962   define variable v-init-dir           as character no-undo .
      963   define variable v_os-file            as character no-undo .
      964   define variable MarkingType          as character no-undo .
      965   define variable v-marking            as logical   no-undo .
      966   define variable v-gds-attr-value-old as character no-undo .
      967   define variable v-gds-attr-type      as character no-undo .
      968   define stream str-log .
      969   define stream str-err .
      970   DEFINE TEMP-TABLE tt-goods NO-UNDO LIKE bar-code
      971      field gds-name  as character
      972      field barcode   as character
      973      field GTIN      as character
      974      field qnty      as integer
      975      field type-mark as character
      976      index pi as UNIQUE gds-code barcode GTIN.
      977   FUNCTION get-mark-char RETURNS CHARACTER
      978      ( input p-mark as character )  FORWARD.
      979   FUNCTION get-mark-list-integer RETURNS CHARACTER
      980      (input p-mark as character )  FORWARD.
      981   DEFINE BUTTON B-exit
      982        LABEL "&Ввод"
      983        SIZE 10 BY 1
      984        BGCOLOR 8 .
      985   DEFINE BUTTON B-file
      986        IMAGE-UP FILE "btn-down-arrow":U
      987        IMAGE-DOWN FILE "btn-down-arrow":U
      988        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      989        LABEL ""
      990        SIZE 3 BY 1.
      991   DEFINE BUTTON b-quit AUTO-END-KEY
      992        LABEL "&Отмена"
      993        SIZE 10 BY 1
      994        BGCOLOR 8 .
      995   DEFINE VARIABLE file-name_ AS CHARACTER FORMAT "X(256)":U
      996        LABEL "Файл загрузки"
      997        VIEW-AS FILL-IN
      998        SIZE 49.63 BY 1 NO-UNDO.
      999   DEFINE VARIABLE t-mark AS LOGICAL INITIAL no
     1000        LABEL "Установка признака требует маркировки"
     1001        VIEW-AS TOGGLE-BOX
     1002        SIZE 42.5 BY .83 NO-UNDO.
     1003   DEFINE VARIABLE t-type_mark AS LOGICAL INITIAL no
     1004        LABEL "Установка типа маркировки"
     1005        VIEW-AS TOGGLE-BOX
     1006        SIZE 42 BY .83 NO-UNDO.
     1007   DEFINE FRAME Dialog-Frame
     1008        B-exit AT ROW 1 COL 1.13 WIDGET-ID 8
     1009        b-quit AT ROW 1 COL 11.13 WIDGET-ID 10
     1010        B-file AT ROW 2.88 COL 67.38 WIDGET-ID 12
     1011        file-name_ AT ROW 2.92 COL 15.38 COLON-ALIGNED WIDGET-ID 14
     1012        t-type_mark AT ROW 4.25 COL 17.38 WIDGET-ID 16
     1013        t-mark AT ROW 5.29 COL 17.38 WIDGET-ID 18
     1014        SPACE(15.24) SKIP(0.45)
     1015       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1016            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1017            TITLE "Загрузка GTIN и штрих-кодов" WIDGET-ID 16.
     1018   ASSIGN
     1019          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1020          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1021   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1022   DO:
     1023         APPLY "END-ERROR":U TO SELF.
     1024      END.
     1025   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1026   DO:
     1027         run waitfram-show in this-procedure ( "ЖДИТЕ... Обработка файла данных") .
     1028         run imp-GTIN no-error.
     1029         if return-value = 'cancel' then return no-apply .
     1030         run check-param no-error.
     1031         if return-value = 'cancel' then return no-apply .
     1032         run waitfram-show in this-procedure ( "ЖДИТЕ... Загрузка данных") .
     1033         run proc-save no-error.
     1034         if return-value = 'cancel' then return no-apply .
     1035         run waitfram-hide in this-procedure .
     1036         apply "go".
     1037      END.
     1038   ON CHOOSE OF B-file IN FRAME Dialog-Frame
     1039   DO:
     1040         define variable ll_commit          AS LOG       NO-UNDO INIT NO.
     1041         define variable v-full-path        as character no-undo .
     1042         define variable v-path             as character no-undo .
     1043         define variable v-file-name        as character no-undo .
     1044         define variable v-file-name-no-ext as character no-undo .
     1045         define variable v-file-name-ext    as character no-undo .
     1046         SYSTEM-DIALOG GET-FILE v_os-file
     1047            TITLE "Выберите файл для импорта"
     1048            FILTERS
     1049            " MS Excel (*.xls,*.xlsx) " "*.xls,*.xlsx"
     1050            INITIAL-DIR v-init-dir
     1051            must-exist
     1052            update ll_commit
     1053            default-extension "xls"
     1054            .
     1055         IF ll_commit <> YES THEN
     1056         do:
     1057            RETURN NO-APPLY.
     1058         end.
     1059         IF v_os-file = PROGRAM-NAME( 1 ) THEN
     1060         DO:
     1061            BELL.
     1062            MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1063            RETURN NO-APPLY.
     1064         END.
     1065         ASSIGN
     1066            file-name_ = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     1067         DISP file-name_ WITH FRAME Dialog-Frame.
     1068         run gbl/filename.p (
     1069            input  file-name_
     1070            ,output v-full-path
     1071            ,output v-path
     1072            ,output v-file-name
     1073            ,output v-file-name-no-ext
     1074            ,output v-file-name-ext
     1075            ) no-error .
     1076         if not error-status:error then v-init-dir = v-path.
     1077      END.
     1078   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1079   DO:
     1080         assign
     1081            v_os-file = "".
     1082      END.
     1083   ON LEAVE OF file-name_ IN FRAME Dialog-Frame
     1084   DO:
     1085         ASSIGN file-name_.
     1086         IF SEARCH( file-name_ ) <> ? AND SEARCH( file-name_ ) <> "":U THEN
     1087         DO:
     1088            ASSIGN
     1089               FILE-INFO:FILE-NAME = file-name_.
     1090            IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name_ = FILE-INFO:FULL-PATHNAME.
     1091            DISP file-name_ WITH FRAME Dialog-Frame.
     1092         END.
     1093      END.
     1094   ON VALUE-CHANGED OF t-mark IN FRAME Dialog-Frame
     1095   DO:
     1096     assign t-mark .
     1097   END.
     1098   ON VALUE-CHANGED OF t-type_mark IN FRAME Dialog-Frame
     1099   DO:
     1100     assign t-type_mark .
     1101   END.
     1102   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1103      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1104   MAIN-BLOCK:
     1105   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1106      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1107      RUN enable_UI.
     1108      WAIT-FOR GO OF FRAME Dialog-Frame.
     1109   END.
     1110   RUN disable_UI.
     1111   PROCEDURE check-param :
     1112      define variable v-value-character as character no-undo .
     1113      define variable v-value-decimal   as decimal   no-undo .
     1114      define variable v-value-integer   as integer   no-undo .
     1115      define variable v-value-logical   as logical   no-undo .
     1116      define variable v-value-type      as character no-undo .
     1117      define variable v-value-date      as date      no-undo .
     1118      v-marking = yes .
     1119      run adm/shattri.p (
     1120         input "get":U
     1121         ,input v-cntxt-obj-type
     1122         ,input v-cntxt-obj-code
     1123         ,input 'marking':U
     1124         ,input "marking-type"
     1125         ,output v-value-character
     1126         ,output v-value-date
     1127         ,output v-value-decimal
     1128         ,output v-value-integer
     1129         ,output v-value-logical
     1130         ,output v-value-type
     1131         ,input-output TABLE thbjattr_thbj-attr
     1132         ) no-error .
     1133      MarkingType = v-value-character.
     1134   END PROCEDURE.
     1135   PROCEDURE disable_UI :
     1136     HIDE FRAME Dialog-Frame.
     1137   END PROCEDURE.
     1138   PROCEDURE enable_UI :
     1139     DISPLAY file-name_ t-type_mark t-mark
     1140         WITH FRAME Dialog-Frame.
     1141     ENABLE B-exit b-quit B-file file-name_ t-type_mark t-mark
     1142         WITH FRAME Dialog-Frame.
     1143     VIEW FRAME Dialog-Frame.
     1144   END PROCEDURE.
     1145   PROCEDURE imp-GTIN :
     1146      DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     1147      DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     1148      DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     1149      DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     1150      DEFINE VARIABLE vLine             AS INTEGER          NO-UNDO.
     1151      DEFINE VARIABLE vChLine           AS CHARACTER        NO-UNDO.
     1152      DEFINE VARIABLE vCh               AS CHARACTER        NO-UNDO.
     1153      DEFINE VARIABLE vNoLine           AS INTEGER          NO-UNDO.
     1154      define variable v-gds-code        as character        no-undo .
     1155      define variable v-gds-name        as character        no-undo .
     1156      define variable v-bar-code        as character        no-undo .
     1157      define variable v-GTIN            as character        no-undo .
     1158      define variable v-qnty            as character        no-undo .
     1159      define variable v-mark-code       as character        no-undo .
     1160      if v_os-file = "" then
     1161      do:
     1162         message "Выберите файл для загрузки"
     1163            view-as alert-box.
     1164         return 'cancel' .
     1165      end.
     1166      CREATE "Excel.Application":U mExcelApplication no-error.
     1167      if error-status :error then
     1168      do:
     1169         message
     1170            "Ошибка при запуске Excel" skip
     1171            error-status :get-message(1) skip
     1172            view-as alert-box error .
     1173         undo, return error .
     1174      end.
     1175      ASSIGN
     1176         mExcelApplication:DisplayAlerts = NO
     1177         mWorkbook                       = mExcelApplication:WorkBooks:Add(v_os-file)
     1178         mWorkSheet                      = mWorkbook:Sheets:Item(1)
     1179         .
     1180      loopbl:
     1181      do vLine = 2 to 1000000:
     1182         ASSIGN
     1183            vChLine     = STRING(vLine)
     1184            v-gds-code  = ''
     1185            v-gds-name  = ''
     1186            v-bar-code  = ''
     1187            v-GTIN      = ''
     1188            v-qnty      = ''
     1189            v-mark-code = ''
     1190            .
     1191         v-gds-code = mWorkSheet:Range("B" + vChLine):FORMULA NO-ERROR.
     1192         if v-gds-code = ? then v-gds-code = mWorkSheet:Range("B" + vChLine):VALUE NO-ERROR.
     1193         v-gds-name = mWorkSheet:Range("C" + vChLine):VALUE NO-ERROR.
     1194         if v-gds-name = ? then v-gds-name = mWorkSheet:Range("C" + vChLine):FORMULA NO-ERROR.
     1195         v-bar-code = mWorkSheet:Range("D" + vChLine):FORMULA NO-ERROR.
     1196         if v-bar-code = ? then v-bar-code = mWorkSheet:Range("D" + vChLine):VALUE NO-ERROR.
     1197         v-GTIN = mWorkSheet:Range("E" + vChLine):FORMULA NO-ERROR.
     1198         if v-GTIN = ? then v-GTIN = mWorkSheet:Range("E" + vChLine):VALUE NO-ERROR.
     1199         v-qnty = mWorkSheet:Range("F" + vChLine):FORMULA NO-ERROR.
     1200         if v-qnty = ? then v-qnty = mWorkSheet:Range("F" + vChLine):FORMULA NO-ERROR.
     1201         v-mark-code = mWorkSheet:Range("G" + vChLine):FORMULA NO-ERROR.
     1202         if v-mark-code = ? then v-mark-code = mWorkSheet:Range("G" + vChLine):VALUE NO-ERROR.
     1203         if length(v-gds-code) > 0
     1204            or length(v-gds-name) > 0
     1205            or length(v-bar-code) > 0
     1206            or length(v-GTIN) > 0
     1207            or length(v-qnty) > 0
     1208            or length(v-mark-code) > 0
     1209            then
     1210         do :
     1211            vNoLine = 0 .
     1212         end.
     1213         else
     1214         do :
     1215            vNoLine = vNoLine + 1.
     1216            IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     1217            ELSE NEXT loopbl.
     1218         end.
     1219         find first tt-goods where tt-goods.gds-code = integer(v-gds-code) and tt-goods.barcode = v-bar-code and
     1220            tt-goods.GTIN     = v-GTIN no-error .
     1221         if not available (tt-goods) then
     1222         do:
     1223            create tt-goods .
     1224            tt-goods.gds-code = integer(v-gds-code) .
     1225            tt-goods.gds-name = v-gds-name .
     1226            tt-goods.barcode = v-bar-code .
     1227            tt-goods.GTIN     = v-GTIN .
     1228            tt-goods.qnty     = integer(v-qnty) .
     1229            tt-goods.type-mark = v-mark-code .
     1230            release tt-goods .
     1231         end.
     1232      end.
     1233   END PROCEDURE.
     1234   PROCEDURE proc-save :
     1235      define buffer buf_goods         for ub.goods .
     1236      define buffer buf_bar-code      for ub.bar-code .
     1237      define buffer buf_bar-code-attr for ub.bar-code-attr .
     1238      define buffer buf_prod-bc       for ub.prod-bc .
     1239      define buffer buf_prod-bc-attr  for ub.prod-bc-attr.
     1240      define buffer buf_goods-attr    for ub.goods-attr .
     1241      define buffer base-bar-code     for ub.bar-code.
     1242      define variable v-rid             as recid     no-undo .
     1243      define variable v-b-str           like ub.prod-bc.b-str no-undo .
     1244      define variable v-load            as logical   no-undo .
     1245      define variable v-err             as logical   no-undo .
     1246      define variable v-err-log         as logical   no-undo .
     1247      define variable v-file-name-load  as character no-undo .
     1248      define variable v-file-name-error as character no-undo .
     1249      define variable v-mes as character no-undo .
     1250      v-file-name-load = v_os-file + ".log" .
     1251      v-file-name-error = v_os-file + ".err" .
     1252      output stream str-log to value(v-file-name-load) .
     1253      output stream str-err to value(v-file-name-error) .
     1254      for each tt-goods:
     1255         find first buf_goods exclusive-lock where buf_goods.gds-code = tt-goods.gds-code no-error .
     1256         if not available (buf_goods) then
     1257         do:
     1258            put stream str-err unformatted
     1259               "Не найден товар " tt-goods.gds-code " " tt-goods.gds-name " в системе." skip .
     1260            v-err = true .
     1261            v-err-log = true .
     1262            next .
     1263         end.
     1264         find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code and
     1265            buf_bar-code.cli-base-rate = tt-goods.qnty no-error .
     1266         if not available (buf_bar-code) then
     1267         do:
     1268            find base-bar-code no-lock where
     1269               base-bar-code.b-code = tt-goods.gds-code.
     1270            find gds-prt no-lock where
     1271               gds-prt.node-code = base-bar-code.node-code.
     1272            run ref/barcode1.p (
     1273               input 'ДОБАВЛЕНИЕ':U
     1274               ,input no
     1275               ,input 0
     1276               ,input buf_goods.gds-code
     1277               ,input gds-prt.node-code
     1278               ,input base-bar-code.part-code
     1279               ,input base-bar-code.in-code
     1280               ,input 'уп'
     1281               ,input tt-goods.qnty
     1282               ,output v-rid) no-error.
     1283            if not error-status:error then
     1284            do:
     1285               find first buf_bar-code no-lock where recid (buf_bar-code) = v-rid no-error .
     1286            end.
     1287            else
     1288            do:
     1289               put stream str-err unformatted
     1290                  "Ошибка при создании бар-кода для товара " tt-goods.gds-code " " tt-goods.gds-name " с коэффициентом " tt-goods.qnty skip .
     1291               v-err-log = true .
     1292               next .
     1293            end.
     1294         end.
     1295         find first buf_prod-bc exclusive-lock where buf_prod-bc.b-code = buf_bar-code.b-code and buf_prod-bc.b-str = string(tt-goods.barcode) no-error .
     1296         if not available (buf_prod-bc) then
     1297         do:
     1298            run trg/prod-bc2.p ( input parparentproc
     1299               ,input no
     1300               ,input no
     1301               ,input yes
     1302               ,input no
     1303               ,input ''
     1304               ,input ''
     1305               ,buffer buf_goods
     1306               ,input buf_bar-code.b-code
     1307               ,input t-mark
     1308               ,input-output tt-goods.barcode
     1309               ,output v-rid
     1310               ) no-error.
     1311            if error-status:error then
     1312            do:
     1313               put stream str-err unformatted
     1314               substitute("Ошибка при создании штрих-кода &1 для товара &2 &3 &4 &5"
     1315                                , tt-goods.barcode
     1316                                , tt-goods.gds-code
     1317                                , tt-goods.gds-name
     1318                                , chr(10)
     1319                                , return-value
     1320                                ) skip.
     1321               v-err-log = true .
     1322               next .
     1323            end.
     1324            else
     1325            do:
     1326               find first buf_prod-bc exclusive-lock where recid (buf_prod-bc) = v-rid no-error .
     1327            end.
     1328         end.
     1329            find first buf_prod-bc-attr where buf_prod-bc-attr.b-code = buf_prod-bc.b-code
     1330               and buf_prod-bc-attr.b-str = buf_prod-bc.b-str
     1331               and buf_prod-bc-attr.attr-code = 'mark':U no-error .
     1332            if not available (buf_prod-bc-attr) then
     1333            do:
     1334               create buf_prod-bc-attr .
     1335               buf_prod-bc-attr.b-code = buf_prod-bc.b-code .
     1336               buf_prod-bc-attr.b-str = buf_prod-bc.b-str .
     1337               buf_prod-bc-attr.attr-code = 'mark':U .
     1338            end.
     1339            buf_prod-bc-attr.attr-value = string (t-mark) .
     1340         find first buf_prod-bc exclusive-lock where buf_prod-bc.b-code = buf_bar-code.b-code and buf_prod-bc.b-str = string(tt-goods.GTIN) no-error .
     1341         if not available (buf_prod-bc) then
     1342         do:
     1343            run trg/prod-bc2.p (
     1344               input parparentproc
     1345               ,input yes
     1346               ,input no
     1347               ,input yes
     1348               ,input no
     1349               ,input 'GTIN':U
     1350               ,input ''
     1351               ,buffer buf_goods
     1352               ,input buf_bar-code.b-code
     1353               ,input no
     1354               ,input-output tt-goods.GTIN
     1355               ,output v-rid
     1356               ) no-error .
     1357            if error-status:error then
     1358            do:
     1359               put stream str-err unformatted
     1360                  ( substitute("Ошибка при создании GTIN &1 для товара &2 &3 &4 &5"
     1361                                , tt-goods.GTIN
     1362                                , tt-goods.gds-code
     1363                                , tt-goods.gds-name
     1364                                , chr(10)
     1365                                , return-value
     1366                                )) skip.
     1367               v-err-log = true .
     1368               next .
     1369            end.
     1370            else
     1371            do:
     1372               find first buf_prod-bc exclusive-lock where recid (buf_prod-bc) = v-rid no-error .
     1373            end.
     1374         end.
     1375         if t-type_mark then
     1376         do:
     1377               RUN gds-attr-value (
     1378                  INPUT buf_goods.gds-code,
     1379                  INPUT 'mark-type':U,
     1380                  OUTPUT v-gds-attr-value-old,
     1381                  OUTPUT v-gds-attr-type
     1382                  ).
     1383               if v-gds-attr-value-old <> get-mark-char(tt-goods.type-mark) then
     1384               do:
     1385                  RUN gds-attr-write (
     1386                     INPUT buf_goods.gds-code,
     1387                     INPUT 'mark-type':U,
     1388                     INPUT get-mark-char(tt-goods.type-mark)
     1389                     ).
     1390               end.
     1391         end.
     1392         put stream str-log unformatted
     1393            "Товар " tt-goods.gds-code " " tt-goods.gds-name " загружен." skip .
     1394         v-load = true .
     1395      end.
     1396      output stream str-log close.
     1397      output stream str-err close.
     1398      if not v-load then
     1399      do:
     1400         os-delete value(v-file-name-load).
     1401      end.
     1402      if not v-err-log then
     1403      do:
     1404         os-delete value(v-file-name-error).
     1405      end.
     1406      if v-err then
     1407      do:
     1408         message "В файле загрузки присутствуют товары, не найденные в БД"
     1409            view-as alert-box.
     1410      end.
     1411   END PROCEDURE.
     1412   FUNCTION get-mark-char RETURNS CHARACTER
     1413      ( input p-mark as character ) :
     1414      RETURN MarkType:GetNameProp(int(p-mark)).
     1415   END FUNCTION.
     1416   FUNCTION get-mark-list-integer RETURNS CHARACTER
     1417      (input p-mark as character ) :
     1418      define variable ii     as integer   no-undo .
     1419      define variable v-mark as character no-undo .
     1420      do ii = 0 to num-entries (p-mark,","):
     1421         v-mark = v-mark + "," + string(MarkType:GetKeyIntDB(entry(ii, p-mark,","))).
     1422      end.
     1423      v-mark = trim(v-mark,",") .
     1424      RETURN v-mark.
     1425   END FUNCTION.
