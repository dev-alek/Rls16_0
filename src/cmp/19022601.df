ADD TABLE "arh-fin-doc-contr-schet-nal"
  AREA "Fin-Arh"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Архивы по плат. налсч. по дог."
  DESCRIPTION "Архивы по плат. налсчета по дог."
  DUMP-NAME "afdcsn"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/afdcsdn.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/afdcswn.p" CRC "?" 

ADD FIELD "contract-code" OF "arh-fin-doc-contr-schet-nal" AS integer 
  DESCRIPTION "Внутренний номер договора"
  FORMAT "9999999"
  INITIAL "0"
  LABEL "Вн. номер дог."
