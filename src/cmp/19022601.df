ADD TABLE "fin-doc"
  AREA "Fin-Doc"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Финансовые документы"
  DESCRIPTION "Финансовые документы"
  DUMP-NAME "fin-doc"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/fin-docd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/fin-docw.p" CRC "?" 

ADD FIELD "fin-doc-code" OF "fin-doc" AS integer 
  DESCRIPTION "Уникальный номер, формируется автоматически, включает host-code, sequence в пределах фирмы"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Номер"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Номер"
  ORDER 10
  MANDATORY

ADD FIELD "host-code" OF "fin-doc" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`The organization (code)`Unitatea noastra (cod)"
  FORMAT "99999"
  INITIAL "0"
  LABEL "Своя организация (код)"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 20
  MANDATORY

ADD FIELD "prn-doc-code" OF "fin-doc" AS character 
  DESCRIPTION "Номер платежного документа указывается при печати - f3"
  FORMAT "X(16)"
  INITIAL ""
  LABEL "Номер"
  POSITION 4
  MAX-WIDTH 32
  COLUMN-LABEL "Номер"
  ORDER 30
  MANDATORY

ADD FIELD "doc-date" OF "fin-doc" AS date 
  DESCRIPTION "Дата создания финанс. док-та, указывается в платежке f4"
  FORMAT "99/99/9999"
