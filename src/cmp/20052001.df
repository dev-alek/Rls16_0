ADD TABLE "c-contract-specif-attr"
  AREA "History"
  LABEL "Атрибуты для contract-specif"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  DUMP-NAME "c-contract-specif-attr"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/contsacd.p" CRC "?"
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/contsacw.p" CRC "?"

ADD FIELD "host-code" OF "c-contract-specif-attr" AS integer
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`The organization (code)`Unitatea noastra (cod)"
  FORMAT "99999"
  INITIAL "0"
  LABEL "Своя организация (код)"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY 

ADD FIELD "contract-num" OF "c-contract-specif-attr" AS integer
  DESCRIPTION "Номер договора"
  FORMAT ">>>>>>>>9"
  INITIAL ?
  LABEL "Номер договора"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20
  MANDATORY 

ADD FIELD "gds-code" OF "c-contract-specif-attr" AS integer
  DESCRIPTION "уникальный код товара`Gds code`Cod marfii"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Код товара"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30
  MANDATORY 

ADD FIELD "attr-code" OF "c-contract-specif-attr" AS character
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Атрибут"
  POSITION 5
  MAX-WIDTH 16
  COLUMN-LABEL "Атрибут"
  ORDER 40
  MANDATORY 

ADD FIELD "attr-value" OF "c-contract-specif-attr" AS character
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Значение атрибута"
  POSITION 6
  MAX-WIDTH 60
  COLUMN-LABEL "Значение!атрибута"
  ORDER 50

ADD FIELD "chip-num" OF "c-contract-specif-attr" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 7
  MAX-WIDTH 4
  ORDER 60
  MANDATORY 

ADD FIELD "corr-date" OF "c-contract-specif-attr" AS date
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "corr-time" OF "c-contract-specif-attr" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80

ADD FIELD "corr-user-db-num" OF "c-contract-specif-attr" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 10
  MAX-WIDTH 4
  ORDER 90
  MANDATORY 

ADD FIELD "corr-user-name" OF "c-contract-specif-attr" AS character
  FORMAT "x(8)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 16
  ORDER 100

ADD FIELD "action" OF "c-contract-specif-attr" AS integer
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 12
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "is-del" OF "c-contract-specif-attr" AS logical
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 13
  MAX-WIDTH 16
  ORDER 120

ADD INDEX "pi-2" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "host-code" ASCENDING
  INDEX-FIELD "contract-num" ASCENDING
  INDEX-FIELD "gds-code" ASCENDING
  INDEX-FIELD "attr-code" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "by-gds-code-2" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "gds-code" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "by-host-code-2" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "host-code" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-db-num" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-name" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "pi" ON "c-contract-specif-attr"
  AREA "History_Index"
  UNIQUE 
  PRIMARY 
  INDEX-FIELD "host-code" ASCENDING
  INDEX-FIELD "contract-num" ASCENDING
  INDEX-FIELD "gds-code" ASCENDING
  INDEX-FIELD "attr-code" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

ADD INDEX "by-gds-code" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "gds-code" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

ADD INDEX "by-host-code" ON "c-contract-specif-attr"
  AREA "History_Index"
  INDEX-FIELD "host-code" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

.
PSC
cpstream=1251
.
