ADD FIELD "prt-code" OF "marking-lines" AS integer
  DESCRIPTION "Код узла дерева признаков.`Nomenclature number`N nomenclator"
  FORMAT "->,>>>,>>9"
  POSITION 28
  INITIAL "0"
  LABEL "Признак"
  COLUMN-LABEL "Признак"
  ORDER 220
  MANDATORY
  MAX-WIDTH 4

RENAME INDEX "part" TO "temp-30828" ON "marking-lines"

RENAME INDEX "pi" TO "temp-80833" ON "marking-lines"

ADD INDEX "part" ON "marking-lines"
  AREA "Primary_index"
  INDEX-FIELD "gds-code" ASCENDING
  INDEX-FIELD "obj-type" ASCENDING
  INDEX-FIELD "obj-code" ASCENDING
  INDEX-FIELD "in-code" ASCENDING
  INDEX-FIELD "out-code" ASCENDING
  INDEX-FIELD "part-code" ASCENDING
  INDEX-FIELD "prt-code" ASCENDING

ADD INDEX "pi" ON "marking-lines"
  AREA "Primary_index"
  UNIQUE
  INDEX-FIELD "mark" ASCENDING
  INDEX-FIELD "obj-type" ASCENDING
  INDEX-FIELD "obj-code" ASCENDING
  INDEX-FIELD "gds-code" ASCENDING
  INDEX-FIELD "in-code" ASCENDING
  INDEX-FIELD "out-code" ASCENDING
  INDEX-FIELD "part-code" ASCENDING
  INDEX-FIELD "prt-code" ASCENDING

UPDATE PRIMARY INDEX "pi" ON "marking-lines"

DROP INDEX "temp-30828" ON "marking-lines"
DROP INDEX "temp-80833" ON "marking-lines"

UPDATE FIELD "reserve1-char" OF "db"
  INITIAL "19"

.
PSC
cpstream=1251
.
