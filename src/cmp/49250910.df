ADD TABLE "esys-pck-rcvd-err"
  AREA "NWS"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  DESCRIPTION "Ошибки при приеме пакета новостей от внешней системы"
  DUMP-NAME "esys-pck-rcvd-err"

ADD FIELD "esys-id" OF "esys-pck-rcvd-err" AS integer 
  DESCRIPTION "Код внешней системы"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Код внешней системы"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 10
  MANDATORY

ADD FIELD "db-num" OF "esys-pck-rcvd-err" AS integer 
  DESCRIPTION "Номер БД: 0 -- главна, > 0 -- удаленные номер БД"
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Номер БД"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "БД"
  ORDER 20
  MANDATORY

ADD FIELD "espr-cr-db-num" OF "esys-pck-rcvd-err" AS integer 
  DESCRIPTION "Номер БД, создавшей пакет"
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Номер БД, создавшей пакет"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30
  MANDATORY

ADD FIELD "espr-pack-num" OF "esys-pck-rcvd-err" AS integer 
  DESCRIPTION "Номер пакета"
  FORMAT ">,>>>,>>>,>>9"
  INITIAL "0"
  LABEL "Номер пакета"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40
  MANDATORY

ADD FIELD "num" OF "esys-pck-rcvd-err" AS integer
  LABEL "Номер"
  FORMAT ">>>,>>9"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 50
  ORDER 50
  MANDATORY

ADD FIELD "msg" OF "esys-pck-rcvd-err" AS character 
  LABEL "Сообщение"
  FORMAT "x(50)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 50
  ORDER 60

ADD FIELD "section" OF "esys-pck-rcvd-err" AS character 
  LABEL "Секция"
  FORMAT "x(255)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 510
  ORDER 70

ADD FIELD "error" OF "esys-pck-rcvd-err" AS character 
  LABEL "Описание ошибки"
  FORMAT "x(255)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 510
  ORDER 80

ADD INDEX "pi" ON "esys-pck-rcvd-err" 
  AREA "NWS_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "esys-id" ASCENDING 
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "espr-cr-db-num" ASCENDING 
  INDEX-FIELD "espr-pack-num" ASCENDING 
  INDEX-FIELD "num" ASCENDING 

ADD INDEX "auto_db" ON "esys-pck-rcvd-err" 
  AREA "NWS_Index"
  INDEX-FIELD "db-num" ASCENDING 

ADD INDEX "crdbnum" ON "esys-pck-rcvd-err" 
  AREA "NWS_Index"
  INDEX-FIELD "espr-cr-db-num" ASCENDING 

.
PSC
cpstream=1251
.
0000003422
