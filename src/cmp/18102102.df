ADD FIELD "sec-vol1" OF "c-norm-loss" AS decimal
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Минимальный предел объема АЦ/секции"
  DECIMALS 2
  ORDER 90
  MAX-WIDTH 17

ADD FIELD "sec-vol2" OF "c-norm-loss" AS decimal
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Максимальный предел объема АЦ/секции"
  DECIMALS 2
  ORDER 100
  MAX-WIDTH 17

RENAME INDEX "pi" TO "temp-80833" ON "c-norm-loss"

ADD INDEX "auto_corr-user" ON "c-norm-loss"
  AREA "History"
  INDEX-FIELD "corr-user-name" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "auto_corr-user-db" ON "c-norm-loss"
  AREA "History"
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "pi" ON "c-norm-loss"
  AREA "History_Index"
  UNIQUE
  INDEX-FIELD "id" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

UPDATE PRIMARY INDEX "pi" ON "c-norm-loss"

.
PSC
cpstream=1251
