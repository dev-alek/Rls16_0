ADD TABLE "tech-prol-pwd"
  AREA "Primary_data"
  DESCRIPTION "Пароли для техпролива"
  DUMP-NAME "tech-prol-pwd"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/tppwd-d.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/tppwd-w.p" CRC "?" 

ADD FIELD "f-date" OF "tech-prol-pwd" AS date 
  DESCRIPTION "Дата"
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Дата"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Дата"
  ORDER 10

ADD FIELD "f-time" OF "tech-prol-pwd" AS datetime 
  DESCRIPTION "Время генерации"
  FORMAT "99/99/99 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Время"
  POSITION 3
  MAX-WIDTH 8
  COLUMN-LABEL "Время"
  ORDER 20

ADD FIELD "f-hostname" OF "tech-prol-pwd" AS character 
  DESCRIPTION "Имя хоста"
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Имя хоста"
  POSITION 4
  MAX-WIDTH 30
  COLUMN-LABEL "Имя хоста"
  HELP "Имя хоста"
  ORDER 30

ADD FIELD "f-user" OF "tech-prol-pwd" AS character 
  DESCRIPTION "Пользователь"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Пользователь"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Пользователь"
  HELP "Пользователь"
  ORDER 40

ADD FIELD "id" OF "tech-prol-pwd" AS int64 
  DESCRIPTION "Уникальный индентификатор записи"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Ид"
  POSITION 6
  MAX-WIDTH 8
  COLUMN-LABEL "Ид"
  ORDER 1
  MANDATORY

ADD FIELD "shop-surr" OF "tech-prol-pwd" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Суррогат магазина"
  POSITION 7
  MAX-WIDTH 40
  COLUMN-LABEL "Суррогат магазина"
  ORDER 50

ADD FIELD "cash-desk-surr" OF "tech-prol-pwd" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Суррогат ссылки на запись в таблице касс"
  POSITION 8
  MAX-WIDTH 100
  COLUMN-LABEL "Суррогат ссылки на запись в таблице касс"
  ORDER 60
  MANDATORY

ADD FIELD "f-pwd-type" OF "tech-prol-pwd" AS character 
  DESCRIPTION "Тип пароля."
  FORMAT "x(1)"
  INITIAL ""
  LABEL "Тип пароля"
  POSITION 9
  MAX-WIDTH 2
  COLUMN-LABEL "Тип пароля"
  ORDER 70

ADD FIELD "f-beg-time" OF "tech-prol-pwd" AS character 
  DESCRIPTION "Время начала для интервального пароля"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Время начала для интервального пароля"
  POSITION 10
  MAX-WIDTH 16
  COLUMN-LABEL "Время начала"
  ORDER 81

ADD FIELD "f-end-time" OF "tech-prol-pwd" AS character 
  DESCRIPTION "Время завершения для интервального пароля"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Время завершения"
  POSITION 11
  MAX-WIDTH 16
  COLUMN-LABEL "Время завершения"
  ORDER 80

ADD FIELD "f-fio" OF "tech-prol-pwd" AS character 
  DESCRIPTION "ФИО заказчика пароля"
  FORMAT "x(50)"
  INITIAL ""
  LABEL "ФИО заказчика пароля"
  POSITION 12
  MAX-WIDTH 100
  COLUMN-LABEL "ФИО заказчика пароля"
  ORDER 90

ADD FIELD "f-pwd" OF "tech-prol-pwd" AS character 
  DESCRIPTION "Пароль для техпролива"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Пароль"
  POSITION 13
  MAX-WIDTH 100
  COLUMN-LABEL "Пароль"
  ORDER 100

ADD INDEX "id" ON "tech-prol-pwd" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 

ADD INDEX "f-time" ON "tech-prol-pwd" 
  AREA "Primary_index"
  DESCRIPTION "Время"
  INDEX-FIELD "f-time" ASCENDING 


ADD INDEX "cash-desk-surr" ON "tech-prol-pwd" 
  AREA "Primary_index"
  DESCRIPTION "Касса"
  INDEX-FIELD "cash-desk-surr" ASCENDING 

ADD INDEX "shop-surr" ON "tech-prol-pwd" 
  AREA "Primary_index"
  DESCRIPTION "Магазин"
  INDEX-FIELD "shop-surr" ASCENDING 

ADD SEQUENCE "s-tech-prol-pwd"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no

