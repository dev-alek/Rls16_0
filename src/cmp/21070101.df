ADD TABLE "c-Code"
  AREA "History"
  LABEL "Справочники"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DESCRIPTION "Справочники"
  DUMP-NAME "c-code"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/ccoded.p" CRC "?"
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/ccodew.p" CRC "?"

ADD FIELD "code" OF "c-Code" AS character
  DESCRIPTION "Код"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Код"
  POSITION 2
  MAX-WIDTH 16
  COLUMN-LABEL "Код"
  ORDER 10
  MANDATORY 

ADD FIELD "CodeName" OF "c-Code" AS character
  DESCRIPTION "Наименование"
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 3
  MAX-WIDTH 120
  COLUMN-LABEL "Наименование"
  ORDER 20

ADD FIELD "CodeValue" OF "c-Code" AS character
  DESCRIPTION "Значение"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Значение"
  POSITION 4
  MAX-WIDTH 40
  COLUMN-LABEL "Значение"
  ORDER 30

ADD FIELD "misc1" OF "c-Code" AS character
  DESCRIPTION "Доп поле 1"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 1"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 1"
  ORDER 40

ADD FIELD "misc2" OF "c-Code" AS character
  DESCRIPTION "Доп поле 2"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 2"
  POSITION 6
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 2"
  ORDER 50

ADD FIELD "misc3" OF "c-Code" AS character
  DESCRIPTION "Доп поле 3"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 3"
  POSITION 7
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 3"
  ORDER 60

ADD FIELD "misc4" OF "c-Code" AS character
  DESCRIPTION "Доп поле 4"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 4"
  POSITION 8
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 4"
  ORDER 70

ADD FIELD "misc5" OF "c-Code" AS character
  DESCRIPTION "Доп поле 5"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 5"
  POSITION 9
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 5"
  ORDER 80

ADD FIELD "misc6" OF "c-Code" AS character
  DESCRIPTION "Доп поле 6"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 6"
  POSITION 10
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 6"
  ORDER 90

ADD FIELD "misc7" OF "c-Code" AS character
  DESCRIPTION "Доп поле 7"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 7"
  POSITION 11
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 7"
  ORDER 100

ADD FIELD "misc8" OF "c-Code" AS character
  DESCRIPTION "Доп поле 8"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 8"
  POSITION 12
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 8"
  ORDER 110

ADD FIELD "misc9" OF "c-Code" AS character
  DESCRIPTION "Доп поле 9"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 9"
  POSITION 13
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 9"
  ORDER 120

ADD FIELD "misc10" OF "c-Code" AS character
  DESCRIPTION "Доп поле 10"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 10"
  POSITION 14
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 10"
  ORDER 130

ADD FIELD "procview" OF "c-Code" AS character
  DESCRIPTION "Процедура просмотра"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Процедура просмотра"
  POSITION 15
  MAX-WIDTH 40
  COLUMN-LABEL "Процедура просмотра"
  ORDER 140

ADD FIELD "parent" OF "c-Code" AS character
  FORMAT "x(20)"
  INITIAL ""
  POSITION 16
  MAX-WIDTH 40
  ORDER 150
  MANDATORY 

ADD FIELD "procdel" OF "c-Code" AS character
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Процедура удаления"
  POSITION 17
  MAX-WIDTH 40
  COLUMN-LABEL "процедура удаления"
  ORDER 160

ADD FIELD "procedit" OF "c-Code" AS character
  DESCRIPTION "процедура редактирования"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "процедура редактирования"
  POSITION 18
  MAX-WIDTH 40
  COLUMN-LABEL "процедура редактирования"
  ORDER 170

ADD FIELD "status_" OF "c-Code" AS integer
  DESCRIPTION "Статус"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Статус"
  POSITION 19
  MAX-WIDTH 4
  COLUMN-LABEL "Статус"
  ORDER 180

ADD FIELD "export_" OF "c-Code" AS logical
  DESCRIPTION "Выгружать запись"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Выгружать запись"
  POSITION 20
  MAX-WIDTH 1
  COLUMN-LABEL "Выгружать запись"
  ORDER 190

ADD FIELD "nwsgbd" OF "c-Code" AS logical
  DESCRIPTION "новости с гбд"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "новости с гбд"
  POSITION 21
  MAX-WIDTH 1
  COLUMN-LABEL "новости с гбд"
  ORDER 200

ADD FIELD "nwsubd" OF "c-Code" AS logical
  DESCRIPTION "новости с убд"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "новости с убд"
  POSITION 22
  MAX-WIDTH 1
  COLUMN-LABEL "новости с убд"
  ORDER 210

ADD FIELD "chip-num" OF "c-Code" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 101
  MAX-WIDTH 4
  ORDER 1010
  MANDATORY 

ADD FIELD "corr-date" OF "c-Code" AS date
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 102
  MAX-WIDTH 4
  ORDER 1020

ADD FIELD "corr-time" OF "c-Code" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 103
  MAX-WIDTH 4
  ORDER 1030

ADD FIELD "corr-user-db-num" OF "c-Code" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 104
  MAX-WIDTH 4
  ORDER 1040
  MANDATORY 

ADD FIELD "corr-user-name" OF "c-Code" AS character
  FORMAT "x(8)"
  INITIAL ""
  POSITION 105
  MAX-WIDTH 16
  ORDER 1050

ADD FIELD "action" OF "c-Code" AS integer
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 106
  MAX-WIDTH 4
  ORDER 1060

ADD FIELD "is-del" OF "c-Code" AS logical
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 107
  MAX-WIDTH 16
  ORDER 1070

ADD INDEX "pi-2" ON "c-Code"
  AREA "History_Index"
  INDEX-FIELD "parent" ASCENDING
  INDEX-FIELD "code" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "export-rec-2" ON "c-Code"
  AREA "History_Index"
  INDEX-FIELD "export_" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-db-num" ON "c-Code"
  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-name" ON "c-Code"
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "pi" ON "c-Code"
  AREA "History_Index"
  UNIQUE 
  PRIMARY 
  INDEX-FIELD "parent" ASCENDING
  INDEX-FIELD "code" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

ADD INDEX "export-rec" ON "c-Code"
  AREA "History_Index"
  INDEX-FIELD "export_" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

.
PSC
cpstream=1251
.
0000000571
