  INITIAL ""
  POSITION 42
  MAX-WIDTH 16
  ORDER 74

ADD FIELD "parentDocumentExt" OF "c-utd" AS character 
  FORMAT "x(32)"
  INITIAL ""
  POSITION 43
  MAX-WIDTH 64
  ORDER 400

ADD FIELD "parentOrganizationExt" OF "c-utd" AS character 
  FORMAT "x(32)"
  INITIAL ""
  POSITION 44
  MAX-WIDTH 64
  ORDER 410

ADD FIELD "ModifyTime" OF "c-utd" AS integer 
  FORMAT "99999"
  INITIAL "0"
  POSITION 45
  MAX-WIDTH 4
  ORDER 175

ADD FIELD "LoadTime" OF "c-utd" AS integer 
  FORMAT "99999"
  INITIAL "0"
  POSITION 46
  MAX-WIDTH 4
  ORDER 165

ADD FIELD "AmendmentRequested" OF "c-utd" AS logical 
  DESCRIPTION "признак, был ли запрос на уточнение"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 47
  MAX-WIDTH 1
  ORDER 420

ADD FIELD "Revised" OF "c-utd" AS logical 
  DESCRIPTION "признак, было ли исправление данного документа"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 48
  MAX-WIDTH 1
  ORDER 430

ADD FIELD "Corrected" OF "c-utd" AS logical 
  DESCRIPTION "признак, была ли корректировка данного документа"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 49
  MAX-WIDTH 1
  ORDER 440

ADD FIELD "chip-num" OF "c-utd" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 50
  MAX-WIDTH 4
  ORDER 450
