  INITIAL ""
  POSITION 32
  MAX-WIDTH 16
  ORDER 310

ADD FIELD "BaseDocumentDate" OF "c-utd" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 33
  MAX-WIDTH 4
  ORDER 320

ADD FIELD "db-num" OF "c-utd" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  POSITION 34
  MAX-WIDTH 4
  ORDER 330
