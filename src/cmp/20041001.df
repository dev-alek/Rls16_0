  MAX-WIDTH 4
  ORDER 160

ADD FIELD "ModifyDate" OF "c-utd" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "ModifyDate"
  POSITION 18
  MAX-WIDTH 4
  ORDER 170

ADD FIELD "obj-inn" OF "c-utd" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "inn-firm"
