  INITIAL ""
  LABEL "cli-type"
  POSITION 11
  MAX-WIDTH 16
  ORDER 100

ADD FIELD "cli-code" OF "c-utd" AS integer 
  FORMAT "999999999"
  INITIAL "0"
  POSITION 12
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "sts-edi" OF "c-utd" AS integer 
  FORMAT "99"
  INITIAL "0"
  POSITION 13
  MAX-WIDTH 4
  ORDER 120

ADD FIELD "doc-code" OF "c-utd" AS character 
