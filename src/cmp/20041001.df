ADD TABLE "c-utd-attr"
  AREA "History"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DUMP-NAME "c-utd-attr"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/utdacd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/utdacw.p" CRC "?" 

ADD FIELD "db-num" OF "c-utd-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "doc-id" OF "c-utd-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20
  MANDATORY

ADD FIELD "attr-code" OF "c-utd-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30
  MANDATORY

ADD FIELD "attr-value" OF "c-utd-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "chip-num" OF "c-utd-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 4
  ORDER 50
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "corr-date" OF "c-utd-attr" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "corr-time" OF "c-utd-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "corr-user-db-num" OF "c-utd-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "corr-user-name" OF "c-utd-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 16
  ORDER 90

ADD FIELD "action" OF "c-utd-attr" AS integer 
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 11
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "is-del" OF "c-utd-attr" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 12
  MAX-WIDTH 16
  ORDER 110

ADD INDEX "pi" ON "c-utd-attr" 
  AREA "History_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "doc-id" ASCENDING 
  INDEX-FIELD "attr-code" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 
  INDEX-FIELD "chip-num" ASCENDING 

ADD INDEX "corr-user-db-num" ON "c-utd-attr" 
  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING 

ADD INDEX "corr-user-name" ON "c-utd-attr" 
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 

ADD INDEX "pi-2" ON "c-utd-attr" 
  AREA "History_Index"
  INDEX-FIELD "db-num" ASCENDING 
