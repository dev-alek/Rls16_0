  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Ошибки УПД"
  DUMP-NAME "c-utd-err"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/utderrcd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/utderrcw.p" CRC "?" 

