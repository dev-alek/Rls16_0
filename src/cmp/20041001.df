ADD TABLE "c-utd"
  AREA "History"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DUMP-NAME "c-utd"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/utdcd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/utdcw.p" CRC "?" 

ADD FIELD "DocumentExt" OF "c-utd" AS character 
  FORMAT "x(32)"
  INITIAL ""
  POSITION 2
  MAX-WIDTH 256
  ORDER 10

ADD FIELD "OrganizationExt" OF "c-utd" AS character 
  FORMAT "x(32)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 256
  ORDER 20

ADD FIELD "TypeId" OF "c-utd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "CounteragentId" OF "c-utd" AS character 
  FORMAT "x(32)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 256
  ORDER 40

ADD FIELD "CustomDocumentId" OF "c-utd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "obj-type" OF "c-utd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "obj-type"
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "obj-code" OF "c-utd" AS integer 
  FORMAT "999999999"
  INITIAL "0"
  LABEL "obj-code"
  POSITION 8
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "host-code" OF "c-utd" AS integer 
