  MAX-WIDTH 1
  ORDER 360

ADD FIELD "RevocationStatus" OF "c-utd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 38
  MAX-WIDTH 16
  ORDER 370

ADD FIELD "EDocType" OF "c-utd" AS integer 
  FORMAT "99999"
  INITIAL "0"
  POSITION 39
  MAX-WIDTH 4
  ORDER 380

ADD FIELD "RecipientResponseStatus" OF "c-utd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 40
  MAX-WIDTH 16
  ORDER 390

ADD FIELD "cli-info" OF "c-utd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 41
