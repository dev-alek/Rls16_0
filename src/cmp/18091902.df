ADD TABLE "c-norm-loss"
  AREA "History"
  DUMP-NAME "c-norm-loss"

ADD FIELD "type" OF "c-norm-loss" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Тип потерь"
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "clim-grp" OF "c-norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Климатическая группа"
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "position" OF "c-norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Признак расположения резервуара"
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "sec-vol" OF "c-norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Объем АЦ/секции АЦ для применения нормы"
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "oil-grp" OF "c-norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Группа нефтепродуктов"
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "season" OF "c-norm-loss" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Период"
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "value-loss" OF "c-norm-loss" AS decimal 
  FORMAT "->>,>>9.999"
  INITIAL "0"
  LABEL "Значение нормы технологических потерь"
  MAX-WIDTH 17
  DECIMALS 3
  ORDER 70

ADD FIELD "chip-num" OF "c-norm-loss" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Щепка"
  MAX-WIDTH 4
  ORDER 80
  MANDATORY

ADD FIELD "corr-user-db-num" OF "c-norm-loss" AS integer 
  DESCRIPTION "Номер БД"
  FORMAT ">>,>>9"
  INITIAL "0"
  LABEL "Номер БД"
  MAX-WIDTH 4
  ORDER 91
  MANDATORY

ADD FIELD "corr-user-name" OF "c-norm-loss" AS character 
  DESCRIPTION "ИмЯ пользователЯ"
  FORMAT "X(8)"
  INITIAL ""
  LABEL "ИмЯ"
  MAX-WIDTH 16
  ORDER 101
  MANDATORY

ADD FIELD "corr-date" OF "c-norm-loss" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Дата коррекции"
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "corr-time" OF "c-norm-loss" AS integer 
  DESCRIPTION "ВремЯ в секундах от начала суток"
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "ВремЯ в секундах"
  MAX-WIDTH 4
  COLUMN-LABEL "ВремЯ!сек"
  ORDER 120

ADD FIELD "id" OF "c-norm-loss" AS int64 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  MAX-WIDTH 8
  ORDER 130
  MANDATORY

ADD INDEX "pi" ON "c-norm-loss" 
  AREA "History_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "chip-num" ASCENDING 

ADD TABLE "norm-loss"
  AREA "Primary_data"
  LABEL "Норма технологических потерь"
  DUMP-NAME "norm-loss"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/nlossd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/nlossw.p" CRC "?" 

ADD FIELD "type" OF "norm-loss" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Тип потерь"
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "clim-grp" OF "norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Климатическая группа"
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "position" OF "norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Признак расположения резервуара"
  MAX-WIDTH 16
  ORDER 30

ADD FIELD "sec-vol" OF "norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Объем АЦ/секции АЦ для применения нормы"
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "oil-grp" OF "norm-loss" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Группа нефтепродуктов"
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "season" OF "norm-loss" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Период"
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "value-loss" OF "norm-loss" AS decimal 
  FORMAT "->>,>>9.999"
  INITIAL "0"
  LABEL "Значение нормы технологических потерь"
  MAX-WIDTH 17
  DECIMALS 3
  ORDER 70

ADD FIELD "id" OF "norm-loss" AS int64 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  MAX-WIDTH 8
  ORDER 80
  MANDATORY

ADD INDEX "pi" ON "norm-loss" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 

ADD INDEX "type" ON "norm-loss" 
  AREA "Primary_index"
  INDEX-FIELD "type" ASCENDING 

.
PSC
cpstream=1251
.
