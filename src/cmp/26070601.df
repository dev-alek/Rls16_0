ADD FIELD "CashShiftDate" OF "chk-slip-head" AS date
  FORMAT "99/99/99"
  POSITION 15
  INITIAL ?
  LABEL "Дата смены"
  COLUMN-LABEL "Дата смены"
  ORDER 120
  MAX-WIDTH 4

ADD FIELD "CashShiftNum" OF "chk-slip-head" AS integer
  FORMAT ">>>>9"
  POSITION 16
  INITIAL "0"
  LABEL "Номер смены"
  COLUMN-LABEL "Номер смены"
  ORDER 130
  MAX-WIDTH 4

ADD INDEX "CashShift" ON "chk-slip-head"
  AREA "Cheque_Index"
  INDEX-FIELD "db-num" ASCENDING
  INDEX-FIELD "obj-code" ASCENDING
  INDEX-FIELD "cash-num" ASCENDING
  INDEX-FIELD "CashShiftDate" ASCENDING
  INDEX-FIELD "CashShiftNum" ASCENDING

DROP INDEX "CheckID" ON "chk-slip-head"
DROP INDEX "reps" ON "chk-slip-head"
DROP INDEX "reps-cash" ON "chk-slip-head"
.
