ADD FIELD "sr-relative-err-dens-lgas-liquid" OF "sr-izmerenia" AS decimal 
  DESCRIPTION "Относительная погрешность измерений плотности ЖФ продукта, %"
  FORMAT "9.999"
  INITIAL ?
  LABEL "Относительная погрешность измерений плотности ЖФ"
  POSITION 25
  MAX-WIDTH 19
  COLUMN-LABEL "Относительная погрешность измерений плотности ЖФ"
  DECIMALS 4
  ORDER 215

ADD FIELD "sr-relative-err-dens-lgas-liquid" OF "c-sr-izmerenia" AS decimal 
  DESCRIPTION "Относительная погрешность измерений плотности ЖФ продукта, %"
  FORMAT "9.999"
  INITIAL ?
  LABEL "Относительная погрешность измерений плотности ЖФ"
  POSITION 106
  MAX-WIDTH 19
  COLUMN-LABEL "Относительная погрешность измерений плотности ЖФ"
  DECIMALS 4
  ORDER 215

ADD TABLE "pl-level-mm"
  AREA "Primary_data"
  LABEL "Градуировочная таблица по мм"
  DESCRIPTION "Градуировочная таблица с помиллиметровой вместимостью пояса "
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  DUMP-NAME "pl-level-mm"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/pllvlmmd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/pllvlmmw.p" CRC "?" 

ADD FIELD "obj-type" OF "pl-level-mm" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин`Type of obj`Tip obiect "
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 2
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 10
  MANDATORY

ADD FIELD "obj-code" OF "pl-level-mm" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`Code of regobj`Cod obiect evid  "
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Код объекта учета"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 20
  MANDATORY

ADD FIELD "pl-code" OF "pl-level-mm" AS integer 
  DESCRIPTION "Код резервуара`Bar-cod`Bar-cod"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Бар-код"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Бар-код"
  ORDER 30
  MANDATORY

ADD FIELD "zone" OF "pl-level-mm" AS integer 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Номер пояса"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Номер пояса"
  ORDER 40
  MANDATORY

ADD FIELD "level" OF "pl-level-mm" AS integer 
  FORMAT ">9"
  INITIAL "0"
  LABEL "Уровень"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Уровень"
  ORDER 70
  MANDATORY

ADD FIELD "capacity" OF "pl-level-mm" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Поясная вместимость"
  POSITION 9
  MAX-WIDTH 17
  COLUMN-LABEL "Поясная вместимость"
  DECIMALS 2
  ORDER 80
  MANDATORY

ADD FIELD "min-level" OF "pl-level-mm" AS decimal 
  FORMAT ">,>>>,>>9.99"
  INITIAL "0"
  LABEL "Нижний уровень пояса"
  POSITION 10
  MAX-WIDTH 17
  COLUMN-LABEL "Нижний уровень пояса"
  DECIMALS 2
  ORDER 50
  MANDATORY

ADD FIELD "max-level" OF "pl-level-mm" AS decimal 
  FORMAT ">,>>>,>>9.99"
  INITIAL "0"
  LABEL "Верхний уровень пояса"
  POSITION 11
  MAX-WIDTH 17
  COLUMN-LABEL "Верхний уровень пояса"
  DECIMALS 2
  ORDER 60
  MANDATORY

ADD INDEX "pi" ON "pl-level-mm" 
  AREA "Primary_data"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "zone" ASCENDING 
  INDEX-FIELD "level" ASCENDING 

ADD INDEX "pi-level" ON "pl-level-mm" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "min-level" ASCENDING 
  INDEX-FIELD "max-level" ASCENDING 

.
PSC
cpstream=1251
