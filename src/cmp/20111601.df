ADD TABLE "Xattr"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Словарь реквизитов"
  DESCRIPTION "Словарь реквизитов"
  DUMP-NAME "xattr"
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "trg/xattrd.p" CRC "?" 
  TABLE-TRIGGER "Write" OVERRIDE PROCEDURE "trg/xattrw.p" CRC "?" 

ADD FIELD "GroupObj-code" OF "Xattr" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Группа объекта"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  HELP "Группа объекта"
  ORDER 10
  MANDATORY

ADD FIELD "Xattr-Code" OF "Xattr" AS character 
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Код реквизита"
  POSITION 3
  MAX-WIDTH 64
  COLUMN-LABEL "КОД РЕКВИЗИТА"
  HELP "Идентификатор реквизита объекта"
  ORDER 20
  MANDATORY

ADD FIELD "Name" OF "Xattr" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 4
  MAX-WIDTH 2000
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование реквизита"
  ORDER 30

ADD FIELD "Data-Type" OF "Xattr" AS character 
  FORMAT "x(12)"
  INITIAL "character"
  LABEL "Тип реквизита"
  POSITION 6
  MAX-WIDTH 200
  COLUMN-LABEL "ТИП"
  HELP "Тип реквизита"
  ORDER 50

ADD FIELD "Data-Format" OF "Xattr" AS character 
  FORMAT "x(30)"
  INITIAL "x(12)"
  LABEL "Формат реквизита"
  POSITION 7
  MAX-WIDTH 60
  COLUMN-LABEL "ФОРМАТ"
  HELP "Формат реквизита"
  ORDER 60

ADD FIELD "Domain-Code" OF "Xattr" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Домен"
  POSITION 8
  MAX-WIDTH 1000
  COLUMN-LABEL "ДОМЕН"
  HELP "Домен, на котором определен реквизит, или имя класса или ''"
  ORDER 70

ADD FIELD "Mandatory" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Обязателен"
  POSITION 9
  MAX-WIDTH 1
  COLUMN-LABEL "ОБЯЗАТЕЛЕН"
  HELP "Признак обязательности реквизита для всех объектов"
  ORDER 80
  MANDATORY

ADD FIELD "Constant" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Неизменяемый"
  POSITION 10
  MAX-WIDTH 1
  COLUMN-LABEL "НЕИЗМЕНЯЕМЫЙ"
  HELP "Признак неизменности реквизита в течение всей жизни объекта"
  ORDER 90
  MANDATORY

ADD FIELD "Validation" OF "Xattr" AS character 
  FORMAT "x(300)"
  INITIAL "*"
  LABEL "Валидация"
  POSITION 11
  MAX-WIDTH 600
  COLUMN-LABEL "ВАЛИДАЦИЯ"
  HELP "Список допустимых выражений в формате can-do()"
  ORDER 100
  MANDATORY

ADD FIELD "Initial" OF "Xattr" AS character 
  FORMAT "x(100)"
  INITIAL ""
  LABEL "Нач. значение"
  POSITION 14
  MAX-WIDTH 4000
  COLUMN-LABEL "НАЧ. ЗНАЧЕНИЕ"
  HELP "Начальное значение реквизита объекта"
  ORDER 130

ADD FIELD "Progress-Field" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Основной"
  POSITION 15
  MAX-WIDTH 1
  COLUMN-LABEL "ОСН"
  HELP "Основной реквизит (описан в СЛОВАРЕ ДАННЫХ) или дополнительный?"
  ORDER 25

ADD FIELD "Description" OF "Xattr" AS character 
  FORMAT "x(300)"
  INITIAL ""
  LABEL "Описание"
  POSITION 17
  MAX-WIDTH 4000
  COLUMN-LABEL "ОПИСАНИЕ"
  HELP "Описание реквизита"
  ORDER 35

ADD FIELD "Overridable" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Переопределяемый"
  POSITION 18
  MAX-WIDTH 1
  COLUMN-LABEL "ПЕРЕОПРЕДЕЛЯЕМЫЙ"
  HELP "Атрибут перегружаемый (можно переопределять в потомках)"
  ORDER 160

ADD FIELD "Hidden" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Скрытый"
  POSITION 19
  MAX-WIDTH 1
  COLUMN-LABEL "СКРЫТЫЙ"
  HELP "Атрибут скрытый (по умолчанию не виден)"
  ORDER 170

ADD FIELD "ListValue" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Список"
  POSITION 21
  MAX-WIDTH 1
  COLUMN-LABEL "Список"
  ORDER 290

ADD FIELD "sign-inherit" OF "Xattr" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 24
  MAX-WIDTH 200
  COLUMN-LABEL "Наследование"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 240
  MANDATORY

ADD FIELD "order" OF "Xattr" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Номер"
  POSITION 25
  MAX-WIDTH 4
  COLUMN-LABEL "N"
  HELP "Порядковый номер реквизита для сортировки"
  ORDER 250

ADD FIELD "xattr-label" OF "Xattr" AS character 
  FORMAT "x(45)"
  INITIAL ""
  LABEL "Метка"
  POSITION 26
  MAX-WIDTH 500
  COLUMN-LABEL "МЕТКА"
  HELP "Метка"
  ORDER 260

ADD FIELD "xattr-clabel" OF "Xattr" AS character 
  FORMAT "x(45)"
  INITIAL ""
  LABEL "МЕТКА"
  POSITION 27
  MAX-WIDTH 500
  COLUMN-LABEL "Метка"
  HELP "Метка колонки"
  ORDER 270

ADD FIELD "Accuracy" OF "Xattr" AS integer 
  FORMAT "->9"
  INITIAL "2"
  LABEL "Точность"
  POSITION 28
  MAX-WIDTH 4
  COLUMN-LABEL "ТОЧНОСТЬ"
  HELP "Точность представления чисел (количество знаков после запятой)"
  ORDER 280

ADD INDEX "Class-Xattr" ON "Xattr" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "GroupObj-code" ASCENDING 
  INDEX-FIELD "Xattr-Code" ASCENDING 

ADD INDEX "data-type" ON "Xattr" 
  AREA "Primary_index"
  INDEX-FIELD "Data-Type" ASCENDING 
  INDEX-FIELD "Xattr-Code" ASCENDING 

ADD INDEX "Domain" ON "Xattr" 
  AREA "Primary_index"
  INDEX-FIELD "Domain-Code" ASCENDING 

ADD INDEX "Xattr-Class" ON "Xattr" 
  AREA "Primary_index"
  UNIQUE
  INDEX-FIELD "Xattr-Code" ASCENDING 
  INDEX-FIELD "GroupObj-code" ASCENDING 

ADD TABLE "xGroupObj"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Словарь групп объектов"
  DESCRIPTION "Словарь групп объектов"
  DUMP-NAME "GroupObj"
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "trg/xgrobjd.p" CRC "?" 
  TABLE-TRIGGER "Write" OVERRIDE PROCEDURE "trg/xgrobjw.p" CRC "?" 

ADD FIELD "GroupObj-Code" OF "xGroupObj" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Группа объектов"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "Группа объектов"
  HELP "Групп объектов"
  ORDER 10
  MANDATORY

ADD FIELD "Name" OF "xGroupObj" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 4
  MAX-WIDTH 2000
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование группы объектов"
  ORDER 30
  MANDATORY

ADD FIELD "Progress-Table" OF "xGroupObj" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Да"
  LABEL "Таблица"
  POSITION 6
  MAX-WIDTH 1
  COLUMN-LABEL "ТАБЛИЦА"
  HELP "Таблица или справочник"
  ORDER 50

ADD FIELD "Hierarchy" OF "xGroupObj" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Иерархия"
  POSITION 7
  MAX-WIDTH 1
  COLUMN-LABEL "ИЕРАРХИЯ"
  HELP "Иерархический справочник?"
  ORDER 60

ADD FIELD "Parent-GroupObj" OF "xGroupObj" AS character 
  FORMAT "X(40)"
  INITIAL ""
  LABEL "Группы объектов-родители"
  POSITION 8
  MAX-WIDTH 200
  COLUMN-LABEL "Группы объектов-РОДИТЕЛИ"
  HELP "Список групп объектов-родителей"
  ORDER 70

ADD FIELD "Description" OF "xGroupObj" AS character 
  FORMAT "x(1000)"
  INITIAL ""
  LABEL "Описание"
  POSITION 13
  MAX-WIDTH 4000
  COLUMN-LABEL "ОПИСАНИЕ"
  HELP "Описание группы объектов"
  ORDER 120

ADD FIELD "Progress-Code" OF "xGroupObj" AS character 
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Таблица Progress"
  POSITION 16
  MAX-WIDTH 200
  COLUMN-LABEL "ТАБЛИЦА Progress"
  HELP "Таблица Progress, по которой хранятся допреквизиты класса"
  ORDER 20

ADD INDEX "GroupObj-Code" ON "xGroupObj" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "GroupObj-Code" ASCENDING 

ADD INDEX "parent" ON "xGroupObj" 
  AREA "Primary_index"
  INDEX-FIELD "Parent-GroupObj" ASCENDING 

ADD INDEX "Parent-GroupObj" ON "xGroupObj" 
  AREA "Primary_index"
  INDEX-FIELD "Progress-Code" ASCENDING 
  INDEX-FIELD "GroupObj-Code" ASCENDING 

ADD INDEX "parents" ON "xGroupObj" 
  AREA "Primary_index"
  WORD
  INDEX-FIELD "Parent-GroupObj" ASCENDING 

ADD TABLE "xstatus"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Статусы класса"
  DESCRIPTION "Статусы класса"
  DUMP-NAME "xstatus"
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "trg/xstatd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/xstatw.p" CRC "?" 

ADD FIELD "GroupObj-code" OF "xstatus" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Класс объекта"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  HELP "Класс объекта"
  ORDER 10
  MANDATORY

ADD FIELD "status-code" OF "xstatus" AS character 
  DESCRIPTION "Код статуса"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Код статуса"
  POSITION 3
  MAX-WIDTH 50
  COLUMN-LABEL "КОД СТАТУСА"
  HELP "Код статуса"
  ORDER 20
  MANDATORY

ADD FIELD "id-status" OF "xstatus" AS integer 
  DESCRIPTION "Идентификатор статуса"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Идентификатор статуса"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "ИДЕНТИФИКАТОР"
  HELP "Идентификатор статуса"
  ORDER 30
  MANDATORY

ADD FIELD "name" OF "xstatus" AS character 
  DESCRIPTION "Наименование статуса"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование статуса"
  POSITION 5
  MAX-WIDTH 500
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование статуса"
  ORDER 40
  MANDATORY

ADD FIELD "sign-inherit" OF "xstatus" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 6
  MAX-WIDTH 32
  COLUMN-LABEL "Наследование"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 240
  MANDATORY

ADD FIELD "can_create" OF "xstatus" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "СОЗДАНИЕ"
  POSITION 8
  MAX-WIDTH 1
  COLUMN-LABEL "СОЗДАНИЕ"
  HELP "Возможность создания объекта в текущем статусе"
  ORDER 260
  MANDATORY

ADD FIELD "order" OF "xstatus" AS integer 
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Номер"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "НОМЕР"
  HELP "Номер для определения направления движения по статусам"
  ORDER 250

ADD FIELD "can_delete" OF "xstatus" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "УДАЛЕНИЕ"
  POSITION 10
  MAX-WIDTH 1
  COLUMN-LABEL "УДАЛЕНИЕ"
  HELP "Возможность удаления объекта в текущем статусе"
  ORDER 280
  MANDATORY

ADD FIELD "can_edit" OF "xstatus" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "РЕДАКТИРОВНИЕ"
  POSITION 11
  MAX-WIDTH 1
  COLUMN-LABEL "РЕДАКТИРОВНИЕ"
  HELP "Возможность редактирования объекта в текущем статусе"
  ORDER 270
  MANDATORY

ADD FIELD "Overridable" OF "xstatus" AS logical 
  FORMAT "Да/Нет"
  INITIAL "yes"
  LABEL "Переопределяемый"
  POSITION 12
  MAX-WIDTH 1
  COLUMN-LABEL "ПЕРЕОПРЕДЕЛЯЕМЫЙ"
  HELP "Статус перегружаемый (можно переопределять в потомках)"
  ORDER 300

ADD FIELD "Hidden" OF "xstatus" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Скрытый"
  POSITION 13
  MAX-WIDTH 1
  COLUMN-LABEL "СКРЫТЫЙ"
  HELP "Статус скрытый (по умолчанию не виден)"
  ORDER 310

ADD INDEX "GroupObj-status" ON "xstatus" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "GroupObj-code" ASCENDING 
  INDEX-FIELD "status-code" ASCENDING 

ADD INDEX "id-stat" ON "xstatus" 
  AREA "Primary_index"
  UNIQUE
  INDEX-FIELD "id-status" ASCENDING 

ADD INDEX "order" ON "xstatus" 
  AREA "Primary_index"
  INDEX-FIELD "GroupObj-code" ASCENDING 
  INDEX-FIELD "order" ASCENDING 

.
