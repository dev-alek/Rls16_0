ADD TABLE "chk-slip-head"
  AREA "Cheque"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "chk-slip-head"
  DESCRIPTION "Шапка слипа чека."
  DUMP-NAME "chk-slip-head"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/chk-shd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/chk-shw.p" CRC "?" 

ADD FIELD "ID" OF "chk-slip-head" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ID"
  POSITION 2
  MAX-WIDTH 32
  COLUMN-LABEL "ID"
  ORDER 10
  MANDATORY

ADD FIELD "CheckID" OF "chk-slip-head" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "CheckID"
  POSITION 3
  MAX-WIDTH 80
  ORDER 20
  MANDATORY

ADD FIELD "RRN" OF "chk-slip-head" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "RRN"
  POSITION 4
  MAX-WIDTH 32
  ORDER 30
  MANDATORY

ADD FIELD "db-num" OF "chk-slip-head" AS integer 
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Номер БД"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "БД"
  ORDER 40
  MANDATORY

ADD FIELD "obj-code" OF "chk-slip-head" AS integer 
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Код магазина"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Объект"
  ORDER 50

ADD FIELD "cash-num" OF "chk-slip-head" AS integer 
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Номер кассы"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Касса"
  ORDER 60

ADD FIELD "slip-dt" OF "chk-slip-head" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "slip-dt"
  POSITION 8
  MAX-WIDTH 8
  ORDER 70

ADD FIELD "proc-type" OF "chk-slip-head" AS integer 
  DESCRIPTION "0 - не заполнено,1 - банковский,2 - лояльность,3 - топливный"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Тип процессинга"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80

ADD INDEX "pi" ON "chk-slip-head" 
  AREA "Cheque_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "ID" ASCENDING 
  INDEX-FIELD "CheckID" ASCENDING 
  INDEX-FIELD "RRN" ASCENDING 

ADD INDEX "CheckID" ON "chk-slip-head" 
  AREA "Cheque_Index"
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "CheckID" ASCENDING 

ADD INDEX "CheckID_RRN" ON "chk-slip-head" 
  AREA "Cheque_Index"
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "CheckID" ASCENDING 
  INDEX-FIELD "RRN" ASCENDING 

ADD INDEX "obj-date" ON "chk-slip-head" 
  AREA "Cheque_Index"
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "cash-num" ASCENDING 
  INDEX-FIELD "slip-dt" ASCENDING 

ADD INDEX "proc-type" ON "chk-slip-head" 
  AREA "Cheque_Index"
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "CheckID" ASCENDING 
  INDEX-FIELD "proc-type" ASCENDING 

ADD TABLE "chk-slip-string"
  AREA "Cheque"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "chk-slip-string"
  DESCRIPTION "Строки слипа чека."
  DUMP-NAME "chk-slip-string"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/chk-ssd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/chk-ssw.p" CRC "?" 

ADD FIELD "ID" OF "chk-slip-string" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ID"
  POSITION 2
  MAX-WIDTH 32
  COLUMN-LABEL "ID"
  ORDER 10
  MANDATORY

ADD FIELD "CheckID" OF "chk-slip-string" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "CheckID"
  POSITION 3
  MAX-WIDTH 80
  COLUMN-LABEL "CheckID"
  ORDER 20
  MANDATORY

ADD FIELD "RRN" OF "chk-slip-string" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "RRN"
  POSITION 4
  MAX-WIDTH 32
  COLUMN-LABEL "RRN"
  ORDER 30
  MANDATORY

ADD FIELD "str-num" OF "chk-slip-string" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Номер строки"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Номер строки"
  ORDER 40
  MANDATORY

ADD FIELD "str-value" OF "chk-slip-string" AS character 
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Текст"
  POSITION 6
  MAX-WIDTH 120
  COLUMN-LABEL "Текст"
  ORDER 50

ADD FIELD "db-num" OF "chk-slip-string" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Номер БД"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "БД"
  ORDER 60
  MANDATORY

ADD INDEX "pi" ON "chk-slip-string" 
  AREA "Cheque_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "ID" ASCENDING 
  INDEX-FIELD "CheckID" ASCENDING 
  INDEX-FIELD "RRN" ASCENDING 
  INDEX-FIELD "str-num" ASCENDING 

ADD INDEX "slip" ON "chk-slip-string" 
  AREA "Cheque_Index"
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "ID" ASCENDING 
  INDEX-FIELD "CheckID" ASCENDING 
  INDEX-FIELD "RRN" ASCENDING 

.
PSC
cpstream=1251
.

