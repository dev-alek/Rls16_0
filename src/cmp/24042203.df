ADD TABLE "c-marking-chk"
  AREA "History"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DUMP-NAME "c-marking-chk"

ADD FIELD "date-modify" OF "c-marking-chk" AS date
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "time-modify" OF "c-marking-chk" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "sts" OF "c-marking-chk" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 4
  ORDER 90

ADD FIELD "comment" OF "c-marking-chk" AS character
  FORMAT "x(32)"
  INITIAL ""
  POSITION 9
  MAX-WIDTH 64
  ORDER 100

ADD FIELD "unit" OF "c-marking-chk" AS character
  FORMAT "x(8)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 16
  ORDER 110

ADD FIELD "doc-code" OF "c-marking-chk" AS character
  FORMAT "x(20)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 40
  ORDER 10
  MANDATORY 

ADD FIELD "line-num" OF "c-marking-chk" AS integer
  FORMAT "999"
  INITIAL "0"
  POSITION 12
  MAX-WIDTH 4
  ORDER 20
  MANDATORY 

ADD FIELD "mark" OF "c-marking-chk" AS character
  FORMAT "x(50)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 100
  ORDER 120
  MANDATORY 
  CASE-SENSITIVE 

ADD FIELD "chip-num" OF "c-marking-chk" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 101
  MAX-WIDTH 4
  ORDER 1010
  MANDATORY 

ADD FIELD "corr-date" OF "c-marking-chk" AS date
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 102
  MAX-WIDTH 4
  ORDER 1020

ADD FIELD "corr-time" OF "c-marking-chk" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 103
  MAX-WIDTH 4
  ORDER 1030

ADD FIELD "corr-user-db-num" OF "c-marking-chk" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 104
  MAX-WIDTH 4
  ORDER 1040
  MANDATORY 

ADD FIELD "corr-user-name" OF "c-marking-chk" AS character
  FORMAT "x(8)"
  INITIAL ""
  POSITION 105
  MAX-WIDTH 16
  ORDER 1050

ADD FIELD "action" OF "c-marking-chk" AS integer
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  POSITION 106
  MAX-WIDTH 4
  ORDER 1060
  LABEL "Описание действия"

ADD FIELD "is-del" OF "c-marking-chk" AS logical
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 107
  MAX-WIDTH 16
  ORDER 1070
  LABEL ""

ADD INDEX "pi-2" ON "c-marking-chk"
  AREA "History_Index"
  INDEX-FIELD "mark" ASCENDING
  INDEX-FIELD "doc-code" ASCENDING
  INDEX-FIELD "line-num" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "doc-code-2" ON "c-marking-chk"
  AREA "History_Index"
  INDEX-FIELD "doc-code" ASCENDING
  INDEX-FIELD "line-num" ASCENDING
  INDEX-FIELD "mark" ASCENDING
  INDEX-FIELD "corr-date" ASCENDING
  INDEX-FIELD "corr-time" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-db-num" ON "c-marking-chk"
  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-name" ON "c-marking-chk"
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "pi" ON "c-marking-chk"
  AREA "History_Index"
  UNIQUE 
  PRIMARY 
  INDEX-FIELD "mark" ASCENDING
  INDEX-FIELD "doc-code" ASCENDING
  INDEX-FIELD "line-num" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

ADD INDEX "doc-code" ON "c-marking-chk"
  AREA "History_Index"
  INDEX-FIELD "doc-code" ASCENDING
  INDEX-FIELD "line-num" ASCENDING
  INDEX-FIELD "mark" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

.
PSC
cpstream=1251
.
