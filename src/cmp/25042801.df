ADD FIELD "obj-code" OF "place-imp-attr" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника"
  FORMAT "99999"
  INITIAL "0"
  LABEL "Код объекта учета"
  POSITION 3
  MAX-WIDTH 6
  COLUMN-LABEL "Объект"
