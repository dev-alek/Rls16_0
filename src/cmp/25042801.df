ADD FIELD "attr-code" OF "place-imp-attr" AS character 
  FORMAT "X(15)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 60
  MANDATORY

ADD FIELD "attr-value" OF "place-imp-attr" AS character 
  FORMAT "X(30)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 60
  ORDER 70

ADD INDEX "pi" ON "place-imp-attr" 
  AREA "Primary_index"
  UNIQUE
