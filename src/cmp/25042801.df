ADD TABLE "pl-level-imp"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Градуировочная табл. резервуар ИМП"
  DESCRIPTION "Градуировочная таблица по резервуару импортированная из внешней системы"
  DUMP-NAME "pl-level-imp"

ADD FIELD "obj-type" OF "pl-level-imp" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин"
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 2
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 10
  MANDATORY

ADD FIELD "obj-code" OF "pl-level-imp" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника"
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Код объекта учета"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 20
  MANDATORY

ADD FIELD "pl-code" OF "pl-level-imp" AS integer 
  DESCRIPTION "Код резервуара"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Бар-код"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Бар-код"
  ORDER 30
  MANDATORY
  
ADD FIELD "table-version" OF "pl-level-imp" AS integer 
  DESCRIPTION "Номер версии таблицы"
  FORMAT ">>>>>>>>>9"
  INITIAL "0"
  LABEL "Версия"
  POSITION 5
  MAX-WIDTH 10
  COLUMN-LABEL "Версия"
  ORDER 40
  MANDATORY

ADD FIELD "pl-level" OF "pl-level-imp" AS decimal 
  DESCRIPTION "Уровень в мм"
  FORMAT "->,>>>,>>9.9999999999"
  INITIAL "0"
  LABEL "Уровень в мм"
  POSITION 6
  MAX-WIDTH 25
  COLUMN-LABEL "Уровень, мм"
  DECIMALS 10
  ORDER 50
  MANDATORY

ADD FIELD "pl-qnty" OF "pl-level-imp" AS decimal 
  DESCRIPTION "Объем соответсвующий уровню"
  FORMAT "->,>>>,>>9.999"
  INITIAL "0"
  LABEL "Объем в л"
  POSITION 7
  MAX-WIDTH 25
  COLUMN-LABEL "Объем в л"
  DECIMALS 10
  ORDER 61

ADD FIELD "tarir-delta" OF "pl-level-imp" AS decimal 
  DESCRIPTION "Погрешность составления таблицы для уровня, %"
  FORMAT ">>9.999"
  INITIAL "0"
  LABEL "Погрешность"
  POSITION 8
  MAX-WIDTH 25
  COLUMN-LABEL "Погрешность"
  DECIMALS 3
  ORDER 80

ADD INDEX "pi" ON "pl-level-imp" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  DESCRIPTION "Уровень и объем резервуара"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "table-version" ASCENDING 
  INDEX-FIELD "pl-level" ASCENDING 

ADD TABLE "pl-level-mm-imp"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Градуировочная таблица по мм ИМП"
  DESCRIPTION "Градуировочная таблица с помиллиметровой вместимостью пояса импортированная из внешней системы"
  DUMP-NAME "pl-level-mm-imp"

ADD FIELD "obj-type" OF "pl-level-mm-imp" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин"
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 2
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 10
  MANDATORY

ADD FIELD "obj-code" OF "pl-level-mm-imp" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника"
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Код объекта учета"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 20
  MANDATORY

ADD FIELD "pl-code" OF "pl-level-mm-imp" AS integer 
  DESCRIPTION "Код резервуара"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Бар-код"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Бар-код"
  ORDER 30
  MANDATORY
  
ADD FIELD "table-version" OF "pl-level-mm-imp" AS integer 
  DESCRIPTION "Номер версии таблицы"
  FORMAT ">>>>>>>>>9"
  INITIAL "0"
  LABEL "Версия"
  POSITION 5
  MAX-WIDTH 10
  COLUMN-LABEL "Версия"
  ORDER 40
  MANDATORY

ADD FIELD "zone" OF "pl-level-mm-imp" AS integer 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Номер пояса"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Номер пояса"
  ORDER 50
  MANDATORY

ADD FIELD "level" OF "pl-level-mm-imp" AS integer 
  FORMAT ">9"
  INITIAL "0"
  LABEL "Уровень"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "Уровень"
  ORDER 80
  MANDATORY

ADD FIELD "capacity" OF "pl-level-mm-imp" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Поясная вместимость"
  POSITION 10
  MAX-WIDTH 17
  COLUMN-LABEL "Поясная вместимость"
  DECIMALS 2
  ORDER 90
  MANDATORY

ADD FIELD "min-level" OF "pl-level-mm-imp" AS decimal 
  FORMAT ">,>>>,>>9.99"
  INITIAL "0"
  LABEL "Нижний уровень пояса"
  POSITION 11
  MAX-WIDTH 17
  COLUMN-LABEL "Нижний уровень пояса"
  DECIMALS 2
  ORDER 60
  MANDATORY

ADD FIELD "max-level" OF "pl-level-mm-imp" AS decimal 
  FORMAT ">,>>>,>>9.99"
  INITIAL "0"
  LABEL "Верхний уровень пояса"
  POSITION 12
  MAX-WIDTH 17
  COLUMN-LABEL "Верхний уровень пояса"
  DECIMALS 2
  ORDER 70
  MANDATORY

ADD INDEX "pi" ON "pl-level-mm-imp" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "table-version" ASCENDING 
  INDEX-FIELD "zone" ASCENDING 
  INDEX-FIELD "level" ASCENDING 

ADD INDEX "pi-level" ON "pl-level-mm-imp" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "table-version" ASCENDING
  INDEX-FIELD "min-level" ASCENDING 
  INDEX-FIELD "max-level" ASCENDING 

ADD TABLE "place-imp"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  DESCRIPTION "складские места импортированные из внешней системы"
  DUMP-NAME "place-imp"

ADD FIELD "pl-code" OF "place-imp" AS integer 
  DESCRIPTION "Код резервуара"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Бар-код"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Бар-код"
  ORDER 20
  MANDATORY

ADD FIELD "table-version" OF "place-imp" AS integer 
  DESCRIPTION "Номер версии таблицы"
  FORMAT ">>>>>>>>>9"
  INITIAL "0"
  LABEL "Версия"
  POSITION 3
  MAX-WIDTH 10
  COLUMN-LABEL "Версия"
  ORDER 30
  MANDATORY

ADD FIELD "obj-type" OF "place-imp" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин"
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 4
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 40
  MANDATORY

ADD FIELD "obj-code" OF "place-imp" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника"
  FORMAT "99999"
  INITIAL "0"
  LABEL "Код объекта учета"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Объект"
  ORDER 50
  MANDATORY

ADD FIELD "status_" OF "place-imp" AS integer 
  DESCRIPTION "Статус 0 – ожидает применения 1 – применен"
  FORMAT "9"
  INITIAL "0"
  LABEL "Статус применения данных по резервуару"
  POSITION 6
  MAX-WIDTH 10
  COLUMN-LABEL "Статус"
  ORDER 60

ADD FIELD "max-qnty" OF "place-imp" AS decimal 
  DESCRIPTION "Максимальное количество товара в базовых единицах измерения"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Максимальное количество"
  POSITION 7
  MAX-WIDTH 18
  COLUMN-LABEL "Макс. кол."
  DECIMALS 3
  ORDER 70

ADD FIELD "d-qnty" OF "place-imp" AS decimal 
  DESCRIPTION "Мертвый остаток (л)"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Мертвый остаток"
  POSITION 8
  MAX-WIDTH 17
  COLUMN-LABEL "Мертвый остаток"
  DECIMALS 3
  ORDER 80

ADD FIELD "tank-d" OF "place-imp" AS decimal 
  DESCRIPTION "Диаметр резервуара (мм)"
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Диаметр резервуара"
  POSITION 9
  MAX-WIDTH 10
  COLUMN-LABEL "Диаметр"
  DECIMALS 0
  ORDER 90

ADD FIELD "dc-height" OF "place-imp" AS decimal 
  DESCRIPTION "Высота мертвой полости(мм)"
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Высота мертвой полости(мм)"
  POSITION 10
  MAX-WIDTH 10
  COLUMN-LABEL "Высота мертвой полости(мм)"
  DECIMALS 0
  ORDER 100

ADD FIELD "dnsty" OF "place-imp" AS decimal 
  DESCRIPTION "Плотность при поверке резервуара(г/см3)"
  FORMAT "9.9999999999"
  INITIAL "0"
  LABEL "Плотность при поверке"
  POSITION 11
  MAX-WIDTH 17
  COLUMN-LABEL "Плотность при поверке"
  DECIMALS 10
  ORDER 110

ADD FIELD "main-mi-code" OF "place-imp" AS integer 
  DESCRIPTION "Код основного средства измерения"
  FORMAT ">>>>>>>>>9"
  INITIAL "0"
  LABEL "Код основного средства измерения"
  POSITION 12
  MAX-WIDTH 10
  COLUMN-LABEL "Код СИ"
  ORDER 120

ADD FIELD "position" OF "place-imp" AS integer 
  DESCRIPTION "Признак расположения резервуара 1 – наземный 2 – подземный"
  FORMAT "9"
  INITIAL "2"
  LABEL "Признак расположения резервуара"
  POSITION 13
  MAX-WIDTH 10
  COLUMN-LABEL "Признак расположения резервуара"
  ORDER 130

ADD FIELD "tank-tk" OF "place-imp" AS decimal 
  DESCRIPTION "Темп коэф линейного расширения материала стенки резервуара (1/°С)"
  FORMAT "9.9999999999"
  INITIAL "0"
  LABEL "Темп коэф"
  POSITION 14
  MAX-WIDTH 17
  COLUMN-LABEL "Темп коэф"
  DECIMALS 10
  ORDER 140

ADD FIELD "pontoon" OF "place-imp" AS integer 
  DESCRIPTION "Наличие понтона 0 – нет 1 – есть"
  FORMAT "9"
  INITIAL "2"
  LABEL "Наличие понтона"
  POSITION 15
  MAX-WIDTH 10
  COLUMN-LABEL "Наличие понтона"
  ORDER 150

ADD FIELD "wght-pntn" OF "place-imp" AS decimal 
  DESCRIPTION "Масса понтона в кг"
  FORMAT ">>>>>>9.999"
  INITIAL "0"
  LABEL "Масса понтона"
  POSITION 16
  MAX-WIDTH 14
  COLUMN-LABEL "Масса понтона"
  DECIMALS 3
  ORDER 160

ADD FIELD "srfcng-pntn" OF "place-imp" AS decimal 
  DESCRIPTION "Высота всплытия понтона в мм"
  FORMAT ">>>>>>9.9"
  INITIAL "0"
  LABEL "Высота всплытия"
  POSITION 17
  MAX-WIDTH 14
  COLUMN-LABEL "Высота всплытия"
  DECIMALS 1
  ORDER 170

ADD FIELD "corr-date" OF "place-imp" AS date 
  DESCRIPTION "Дата изменения"
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Дата"
  POSITION 18
  MAX-WIDTH 10
  COLUMN-LABEL "Дата"
  ORDER 180

ADD FIELD "corr-time" OF "place-imp" AS integer 
  DESCRIPTION "Время изменения"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Время"
  POSITION 19
  MAX-WIDTH 8
  COLUMN-LABEL "Время"
  ORDER 190

ADD INDEX "pi" ON "place-imp" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "table-version" ASCENDING 

