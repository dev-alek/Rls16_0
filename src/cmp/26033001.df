ADD TABLE "reportShift"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Сменный отчет"
  DUMP-NAME "reportshift"

ADD FIELD "id" OF "reportShift" AS integer 
  DESCRIPTION "Внутренний код шапки ABC анализа"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Внутренний код шапки ABC анализа"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "date" OF "reportShift" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Дата формирования"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Дата формирования"
  ORDER 20

ADD FIELD "time_" OF "reportShift" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Время формирования"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Время формирования"
  ORDER 30

ADD FIELD "obj-code" OF "reportShift" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`Code`Cod"
  FORMAT "99999"
  INITIAL ?
  LABEL "Код"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 40
  MANDATORY

ADD FIELD "obj-type" OF "reportShift" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин`Obj`Obiect"
  FORMAT "X(3)"
  INITIAL ?
  LABEL "Объект"
  POSITION 6
  MAX-WIDTH 6
  COLUMN-LABEL "Объект"
  ORDER 50
  MANDATORY

ADD FIELD "shift-date" OF "reportShift" AS date 
  DESCRIPTION "дата начала смены`&Shift date`&Data turei"
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "&Дата смены"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Дата!смены"
  ORDER 60
  MANDATORY

ADD FIELD "shift-num" OF "reportShift" AS integer 
  DESCRIPTION "Порядок смены в сменном дне`Order`Order "
  FORMAT ">9"
  INITIAL "0"
  LABEL "&Порядок смен"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Порядок смен"
  ORDER 70
  MANDATORY

ADD FIELD "fio" OF "reportShift" AS character 
  FORMAT "x(250)"
  INITIAL ""
  LABEL "ФИО"
  POSITION 10
  MAX-WIDTH 500
  COLUMN-LABEL "ФИО"
  ORDER 90

ADD FIELD "report-type" OF "reportShift" AS integer 
  DESCRIPTION "0 - Чек лист
1 - Сменный отчет"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Тип отчета"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "Тип отчета"
  ORDER 100
  MANDATORY

ADD FIELD "report-html" OF "reportShift" AS character 
  FORMAT "x(250)"
  INITIAL ""
  LABEL "Путь к отчету"
  POSITION 12
  MAX-WIDTH 500
  COLUMN-LABEL "Путь к отчету"
  ORDER 110

ADD FIELD "report-json" OF "reportShift" AS character 
  FORMAT "x(250)"
  INITIAL ""
  LABEL "json"
  POSITION 13
  MAX-WIDTH 500
  COLUMN-LABEL "json"
  ORDER 120

ADD FIELD "flag" OF "reportShift" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 14
  MAX-WIDTH 1
  ORDER 130

ADD FIELD "user-id" OF "reportShift" AS character 
  DESCRIPTION "Уникальный идентификатор пользователя"
  FORMAT "X(15)"
  INITIAL ""
  LABEL "Пользователь"
  POSITION 15
  MAX-WIDTH 30
  ORDER 140
  MANDATORY

ADD FIELD "shift-name" OF "reportShift" AS character 
  DESCRIPTION "Номер смены"
  FORMAT "X(2)"
  INITIAL ?
  LABEL "&Номер смены"
  POSITION 16
  MAX-WIDTH 4
  COLUMN-LABEL "&Номер смены"
  ORDER 150

ADD INDEX "pi" ON "reportShift" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "report-type" ASCENDING 

ADD INDEX "id" ON "reportShift" 
  AREA "Primary_data"
  UNIQUE
  INDEX-FIELD "id" ASCENDING 

ADD TABLE "shift-param"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Параметры для смены"
  DUMP-NAME "shift-param"

ADD FIELD "obj-type" OF "shift-param" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара`Type of obj`Tip obiect "
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 2
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 110
  MANDATORY

ADD FIELD "obj-code" OF "shift-param" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`Obj. code`Cod obiect "
  FORMAT "99999"
  INITIAL "0"
  LABEL "Код объекта"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 120
  MANDATORY

ADD FIELD "shift-num" OF "shift-param" AS integer 
  DESCRIPTION "Порядок смены в сменном дне`Order`Order "
  FORMAT ">9"
  INITIAL "0"
  LABEL "&Порядок смен"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Порядок смен"
  ORDER 130
  MANDATORY

ADD FIELD "shift-date" OF "shift-param" AS date 
  DESCRIPTION "дата начала смены`&Shift date`&Data turei"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "&Дата смены"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "&Дата смены"
  ORDER 140
  MANDATORY

ADD FIELD "shift-name" OF "shift-param" AS character 
  DESCRIPTION "Номер смены"
  FORMAT "X(2)"
  INITIAL "1"
  LABEL "&Номер смены"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "&Номер смены"
  ORDER 150
  MANDATORY

ADD FIELD "gds-code" OF "shift-param" AS integer 
  DESCRIPTION "уникальный код товара`Gds code`Cod marfii"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Код товара"
  POSITION 7
  MAX-WIDTH 4
  ORDER 160
  MANDATORY

ADD FIELD "prc-dev-mass" OF "shift-param" AS decimal 
  DESCRIPTION "% допустимого отклонения массы топлива"
  FORMAT "->9.99"
  INITIAL "0,65"
  LABEL "% допустимого отклонения массы топлива"
  POSITION 9
  MAX-WIDTH 18
  COLUMN-LABEL "% допустим. отклон.!массы топлива"
  DECIMALS 3
  ORDER 190

ADD FIELD "dev-paid-trans" OF "shift-param" AS decimal 
  DESCRIPTION "л, откл между объем топлива на кассе и по счетч"
  FORMAT "->9.99"
  INITIAL "1"
  LABEL "л, откл между объем топлива на кассе и по счетч"
  POSITION 10
  MAX-WIDTH 18
  COLUMN-LABEL "л, откл между объем топлива на кассе и по счетч"
  DECIMALS 3
  ORDER 200

ADD FIELD "diff-stock-end" OF "shift-param" AS decimal 
  DESCRIPTION "Отклонение по остаткам на конец смены, кг"
  FORMAT "->>>>>>>>>>>>>>>>>>>>>>>>>>9.99"
  INITIAL "1"
  LABEL "Отклонение по остаткам на конец смены, кг"
  POSITION 11
  MAX-WIDTH 18
  COLUMN-LABEL "Отклонение по остаткам на конец смены, кг"
  DECIMALS 3
  ORDER 210

ADD FIELD "diff-cash-trk" OF "shift-param" AS decimal 
  DESCRIPTION "л, разница СО часть 9"
  FORMAT "->>>>>>>>>>>>>>>>>9.99"
  INITIAL "1"
  LABEL "л, разница СО часть 9"
  POSITION 12
  MAX-WIDTH 18
  COLUMN-LABEL "л, разница"
  DECIMALS 3
  ORDER 220

ADD FIELD "dev-mass" OF "shift-param" AS decimal 
  DESCRIPTION "Допустимое отклонение по массе, кг"
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Допустимое отклонение по массе, кг"
  POSITION 13
  MAX-WIDTH 17
  COLUMN-LABEL "Допустимое отклонение по массе, кг"
  DECIMALS 2
  ORDER 230

ADD FIELD "pl-code" OF "shift-param" AS integer 
  DESCRIPTION "номер резервуара"
  FORMAT ">>>>>>>>>>>>>>>>>>>9"
  INITIAL "0"
  LABEL "номер резервуара"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "номер резервуара"
  ORDER 240
  MANDATORY

ADD FIELD "error-mass" OF "shift-param" AS logical 
  DESCRIPTION "Наличие отклонения остатков топлива по массе"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Наличие отклонения остатков топлива по массе"
  POSITION 15
  MAX-WIDTH 1
  COLUMN-LABEL "Наличие отклонения остатков топлива по массе"
  ORDER 250

ADD FIELD "error-paid-trans" OF "shift-param" AS logical 
  DESCRIPTION "Наличие отклонения между объемом на ТРК и продажами"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Наличие отклонения между объемом на ТРК и продаж"
  POSITION 16
  MAX-WIDTH 1
  COLUMN-LABEL "Наличие отклонения между объемом на ТРК и продаж"
  ORDER 260

ADD FIELD "disc-diffMass" OF "shift-param" AS character 
  DESCRIPTION "Комментариц по расхождению по массе"
  FORMAT "x(256)"
  INITIAL ""
  LABEL "Комментариц по расхождению по массе"
  POSITION 17
  MAX-WIDTH 512
  COLUMN-LABEL "Комментариц по расхождению по массе"
  ORDER 270

ADD FIELD "disc-diffTRK" OF "shift-param" AS character 
  DESCRIPTION "Комментариц по расхождению по массе"
  FORMAT "x(256)"
  INITIAL ""
  LABEL "Комментариц по расхождению по массе"
  POSITION 18
  MAX-WIDTH 512
  COLUMN-LABEL "Комментариц по расхождению по массе"
  ORDER 280

ADD FIELD "cash-qnty" OF "shift-param" AS decimal 
  FORMAT "->>,>>>>>>>9.99"
  INITIAL "0"
  LABEL "Объем продаж по кассе"
  POSITION 19
  MAX-WIDTH 17
  COLUMN-LABEL "Объем продаж по кассе"
  DECIMALS 2
  ORDER 300

ADD FIELD "meas-qnty" OF "shift-param" AS decimal 
  FORMAT "->>>>>>>,>>9.99"
  INITIAL "0"
  LABEL "Объем продаж по счетчикам ТРК"
  POSITION 20
  MAX-WIDTH 17
  COLUMN-LABEL "Объем продаж по счетчикам ТРК"
  DECIMALS 2
  ORDER 290

ADD FIELD "tech-refuell" OF "shift-param" AS decimal 
  FORMAT "->>,>>>>>>>>>9.99"
  INITIAL "0"
  LABEL "Техпролив"
  POSITION 21
  MAX-WIDTH 17
  COLUMN-LABEL "Техпролив"
  DECIMALS 2
  ORDER 310

ADD FIELD "system-cli-qnty" OF "shift-param" AS decimal 
  DESCRIPTION "Остаток товара по складскому месту (контейнеру) в единицах измерения поставщика (имеющийся в системе на момент сверки)`Reg.`Cntb"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Учет (ед.пост.)"
  POSITION 22
  MAX-WIDTH 25
  COLUMN-LABEL "Учет (ед.пост.)"
  DECIMALS 10
  ORDER 320

ADD FIELD "fact-stock-end" OF "shift-param" AS decimal 
  FORMAT "->>,>>>>>>>9.99"
  INITIAL "0"
  LABEL "факт. остаток на конец смены"
  POSITION 23
  MAX-WIDTH 17
  COLUMN-LABEL "факт. остаток на конец смены"
  DECIMALS 2
  ORDER 330

ADD FIELD "loc1" OF "shift-param" AS character 
  DESCRIPTION "`Coord&1`Coord&1"
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Коорд&1"
  POSITION 24
  MAX-WIDTH 16
  COLUMN-LABEL "Коорд1"
  ORDER 340

ADD INDEX "pi" ON "shift-param" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-name" ASCENDING 
  INDEX-FIELD "gds-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 

ADD INDEX "gds" ON "shift-param" 
  AREA "Primary_index"
  INDEX-FIELD "gds-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 

ADD INDEX "shift" ON "shift-param" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 

ADD TABLE "susp-chk"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Подозрительные чеки"
  DUMP-NAME "susp-chk"

ADD FIELD "chk-num" OF "susp-chk" AS integer 
  DESCRIPTION "номер чека, присваивается кассой`Chk`Bon"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Чек"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Чек"
  ORDER 10

ADD FIELD "chk-date" OF "susp-chk" AS date 
  DESCRIPTION "дата чека`Date`Data"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Дата"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Дата"
  ORDER 20

ADD FIELD "pay-desk" OF "susp-chk" AS integer 
  DESCRIPTION "номер кассы`Cash`Casa "
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Касса"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Касса"
  ORDER 30

ADD FIELD "doc-code" OF "susp-chk" AS character 
  DESCRIPTION "уникальный в системе номер чека`Numb`Numar"
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Номер"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Номер"
  ORDER 40
  MANDATORY

ADD FIELD "office" OF "susp-chk" AS character 
  DESCRIPTION "`Typ`Tip"
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Тип"
  POSITION 6
  MAX-WIDTH 16
  COLUMN-LABEL "Тип"
  ORDER 50

ADD FIELD "obj-type" OF "susp-chk" AS character 
  DESCRIPTION "Перечислимый тип объекта учета товара: склад, магазин, физ. лицо и т.д.`Type of obj`Tip obiect "
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 7
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 60
  MANDATORY

ADD FIELD "obj-code" OF "susp-chk" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`Code of regobj`Cod obiect evid "
  FORMAT "99999"
  INITIAL "0"
  LABEL "Код объекта учета"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Объект"
  ORDER 70
  MANDATORY

ADD FIELD "shift-num" OF "susp-chk" AS integer 
  DESCRIPTION "Порядок смены в сменном дне`Order`Order "
  FORMAT ">9"
  INITIAL "0"
  LABEL "&Порядок смен"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "Порядок смен"
  ORDER 80

ADD FIELD "shift-date" OF "susp-chk" AS date 
  DESCRIPTION "дата начала смены`&Shift date`&Data turei"
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "&Дата смены"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "&Дата смены"
  ORDER 90

ADD FIELD "chk-type" OF "susp-chk" AS integer 
  FORMAT "99"
  INITIAL ?
  LABEL "Тип чека"
  POSITION 11
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "shift-name" OF "susp-chk" AS character 
  DESCRIPTION "Номер смены"
  FORMAT "X(2)"
  INITIAL ?
  LABEL "&Номер смены"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "&Номер смены"
  ORDER 110

ADD FIELD "chk-time" OF "susp-chk" AS integer 
  DESCRIPTION "время чека`Time`Ora "
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Время"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "Время"
  ORDER 120

ADD FIELD "reason-name" OF "susp-chk" AS character 
  FORMAT "x(256)"
  INITIAL ""
  LABEL "Причина возникновения"
  POSITION 14
  MAX-WIDTH 512
  COLUMN-LABEL "Причина"
  ORDER 130

ADD FIELD "link-chk" OF "susp-chk" AS character 
  FORMAT "x(265)"
  INITIAL ""
  LABEL "Ссылка на правильный чек"
  POSITION 15
  MAX-WIDTH 530
  COLUMN-LABEL "Ссылка на правильный чек"
  ORDER 140

ADD INDEX "pi" ON "susp-chk" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "doc-code" ASCENDING 

ADD INDEX "shift" ON "susp-chk" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-name" ASCENDING 

ADD SEQUENCE "s-reportShift"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no
  MIN-VAL ?
  MAX-VAL ?

.
