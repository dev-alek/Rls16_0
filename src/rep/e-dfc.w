&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE my-report s-object
PROCEDURE my-report :
/*------------------------------------------------------------------------------
  Purpose:     здесь происходит вызов  процедуры отчета с любыми параметрами
------------------------------------------------------------------------------*/
define variable v-type as character no-undo .
define variable v-tmp as character no-undo .
if num-entries (reportname , "|" ) < 3 then message "Ошибка программирования".
v-tmp  = entry ( 2 , reportname , "|" ) .
v-type = entry ( 3 , reportname , "|" ) .

  run rep/r-dfc.p
      ( integer (v-tmp)  ,
        p-curr-code ,
        classify   ,
        sorttype
        ) .

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

