                                     , IF v-form-name = "torg12":U THEN SUBSTITUTE("{&abbr_inn_allshift} &1 {&abbr_kpp_allshift} &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
