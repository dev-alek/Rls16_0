<?xml version="1.0" encoding="windows-1251"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:element name="price-doc-01" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="operation" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
              <xsd:element name="codeOperation" type="xsd:string" nillable="true"/>
              <xsd:element name="host" type="xsd:int" nillable="true"/>
              <xsd:element name="store" type="xsd:string" nillable="true"/>
              <xsd:element name="factOrder" type="xsd:decimal" nillable="true"/>
              <xsd:element name="sysDateXML" type="xsd:date" nillable="true"/>
              <xsd:element name="sysTime" type="xsd:string" nillable="true"/>
              <xsd:element name="dateDocXML" type="xsd:date" nillable="true"/>
              <xsd:element name="dateFactXML" type="xsd:date" nillable="true"/>
              <xsd:element name="factTime" type="xsd:string" nillable="true"/>
              <xsd:element name="valutCode" type="xsd:int" nillable="true"/>
              <xsd:element name="valutCodeOKV" type="xsd:int" nillable="true"/>
              <xsd:element name="comment" type="xsd:string" nillable="true"/>
              <xsd:element name="suppInDocNo" type="xsd:string" nillable="true"/>
              <xsd:element name="linedoc" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
                    <xsd:element name="good" type="xsd:int" nillable="true"/>
                    <xsd:element name="bCode" type="xsd:int" nillable="true"/>
                    <xsd:element name="artic" type="xsd:string" nillable="true"/>
                    <xsd:element name="prodType" type="xsd:string" nillable="true"/>
                    <xsd:element name="prodCode" type="xsd:int" nillable="true"/>
                    <xsd:element name="type" type="xsd:string" nillable="true"/>
                    <xsd:element name="unitType" type="xsd:string" nillable="true"/>
                    <xsd:element name="unitCli" type="xsd:string" nillable="true"/>
                    <xsd:element name="cliBaseRate" type="xsd:decimal" nillable="true"/>
                    <xsd:element name="doc_ID" type="xsd:string" nillable="true"/>
                    <xsd:element name="partCode" type="xsd:string" nillable="true"/>
                    <xsd:element name="priceSale" type="xsd:decimal" nillable="true"/>
                    <xsd:element name="priceListQnty" type="xsd:decimal" nillable="true"/>
                    <xsd:element name="pricePrev" type="xsd:decimal" nillable="true"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//operation"/>
      <xsd:field xpath="referenceNo"/>
    </xsd:unique>
    <xsd:unique name="linedoc_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//linedoc"/>
      <xsd:field xpath="referenceNo"/>
      <xsd:field xpath="bCode"/>
    </xsd:unique>
    <xsd:keyref name="referenceNodoc-num" refer="pi" prodata:nested="true">
      <xsd:selector xpath=".//linedoc"/>
      <xsd:field xpath="referenceNo"/>
    </xsd:keyref>
  </xsd:element>
</xsd:schema>
