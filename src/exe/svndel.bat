rem ========================================================
rem Пометить файлы для удаления из репозитория.
rem 
rem %1 - файл со списком для удаления из репозитория.  
rem         Должны быть заданы полные имена файлов.
rem ========================================================
for /f %%i in (%~1) do (
    svn delete %%i
)
exit

