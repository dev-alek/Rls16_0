<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:element name="edoc-nn-order-01-ds" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="order-header" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="ext-obj-code" type="xsd:int" nillable="false"/>
              <xsd:element name="doc-code" type="xsd:string" nillable="false"/>
              <xsd:element name="trn-code" type="xsd:string" nillable="false"/>
              <xsd:element name="status_" type="xsd:string" nillable="false"/>
              <xsd:element name="ship-date" type="xsd:date" nillable="false"/>
              <xsd:element name="desstatus" type="xsd:string" nillable="false"/>
              <xsd:element name="contract-code" type="xsd:string" nillable="true"/>
              <xsd:element name="order-line" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="doc-code" type="xsd:string" nillable="false"/>
                    <xsd:element name="cliart" type="xsd:string" nillable="false"/>
                    <xsd:element name="artth" type="xsd:string" nillable="false"/>
                    <xsd:element name="nameth" type="xsd:string" nillable="false"/>
                    <xsd:element name="quantityquant" type="xsd:decimal" nillable="false"/>
                    <xsd:element name="pricequant" type="xsd:decimal" nillable="false"/>
                    <xsd:element name="status_" type="xsd:int" nillable="false"/>
                    <xsd:element name="desstatus" type="xsd:string" nillable="false"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//order-header"/>
      <xsd:field xpath="doc-code"/>
    </xsd:unique>
    <xsd:unique name="order-line_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//order-line"/>
      <xsd:field xpath="doc-code"/>
      <xsd:field xpath="cliart"/>
    </xsd:unique>
    <xsd:keyref name="orderdr" refer="pi" prodata:nested="true">
      <xsd:selector xpath=".//order-line"/>
      <xsd:field xpath="doc-code"/>
    </xsd:keyref>
  </xsd:element>
</xsd:schema>