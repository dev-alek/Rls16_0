<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:element name="inkas-01" prodata:proDataSet="true" prodata:datasetName="inkas-01">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="operation" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
              <xsd:element name="isDel" type="xsd:boolean" nillable="true"/>
              <xsd:element name="codeOperation" type="xsd:string" nillable="true"/>
              <xsd:element name="host" type="xsd:int" nillable="true"/>
              <xsd:element name="store" type="xsd:string" nillable="true"/>
              <xsd:element name="factOrder" type="xsd:decimal" nillable="true"/>
              <xsd:element name="sysDateXml" type="xsd:date" nillable="true"/>
              <xsd:element name="sysTime" type="xsd:string" nillable="true"/>
              <xsd:element name="dateDelXml" type="xsd:date" nillable="true"/>
              <xsd:element name="dateDocXml" type="xsd:date" nillable="true"/>
              <xsd:element name="dateFactXml" type="xsd:date" nillable="true"/>
              <xsd:element name="timeFact" type="xsd:string" nillable="true"/>
              <xsd:element name="comment" type="xsd:string" nillable="true"/>
              <xsd:element name="shiftDateXml" type="xsd:date" nillable="true"/>
              <xsd:element name="shiftNum" type="xsd:int" nillable="true"/>
              <xsd:element name="shiftName" type="xsd:string" nillable="true"/>
              <xsd:element name="techfuel" type="xsd:boolean" nillable="true"/>
              <xsd:element name="factQnty" type="xsd:decimal" nillable="true" prodata:columnLabel="Кол-во факт."/>
              <xsd:element name="totalSum" type="xsd:decimal" nillable="true" prodata:columnLabel="Сумма брутто"/>
              <xsd:element name="totalDsc" type="xsd:decimal" nillable="true" prodata:columnLabel="Скидка"/>
              <xsd:element name="totalFact" type="xsd:decimal" nillable="true" prodata:columnLabel="Сумма нетто"/>
              <xsd:element name="saleDoc" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="saleReferenceNo" type="xsd:string" nillable="true"/>
                    <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
                    <xsd:element name="codeOperation" type="xsd:string" nillable="true"/>
                    <xsd:element name="cassSum" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
                          <xsd:element name="code" type="xsd:int" nillable="true"/>
                          <xsd:element name="currCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="sum" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sumr" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sumb" type="xsd:decimal" nillable="true"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="payCode" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
                          <xsd:element name="good" type="xsd:int" nillable="true"/>
                          <xsd:element name="deskcode" type="xsd:int" nillable="true"/>
                          <xsd:element name="payCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="quantity" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sum" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sumb" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sumr" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="payCard" minOccurs="0" maxOccurs="unbounded">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
                                <xsd:element name="good" type="xsd:int" nillable="true"/>
                                <xsd:element name="deskcode" type="xsd:int" nillable="true"/>
                                <xsd:element name="payCode" type="xsd:int" nillable="true"/>
                                <xsd:element name="num" type="xsd:string" nillable="true"/>
                                <xsd:element name="quantity" type="xsd:decimal" nillable="true"/>
                                <xsd:element name="sumr" type="xsd:decimal" nillable="true"/>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="check" minOccurs="0" maxOccurs="unbounded" prodata:tableName="check1">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="referenceNo" type="xsd:string" nillable="true"/>
                    <xsd:element name="type" type="xsd:string" nillable="true"/>
                    <xsd:element name="num" type="xsd:int" nillable="true"/>
                    <xsd:element name="doccode" type="xsd:string" nillable="true"/>
                    <xsd:element name="desk" type="xsd:int" nillable="true"/>
                    <xsd:element name="dateXml" type="xsd:date" nillable="true"/>
                    <xsd:element name="time" type="xsd:string" nillable="true" prodata:fieldName="chk-time"/>
                    <xsd:element name="shiftDateXml" type="xsd:date" nillable="true"/>
                    <xsd:element name="shiftNum" type="xsd:int" nillable="true"/>
                    <xsd:element name="dCard" type="xsd:string" nillable="true"/>
                    <xsd:element name="dCardCliType" type="xsd:string" nillable="true"/>
                    <xsd:element name="dCardCliCode" type="xsd:int" nillable="true"/>
                    <xsd:element name="discnt" type="xsd:decimal" nillable="true"/>
                    <xsd:element name="cashier" type="xsd:int" nillable="true"/>
                    <xsd:element name="cashierPsnCode" type="xsd:int" nillable="true"/>
                    <xsd:element name="salesMan" type="xsd:int" nillable="true"/>
                    <xsd:element name="zNumber" type="xsd:int" nillable="true"/>
                    <xsd:element name="manualMaked" type="xsd:boolean" nillable="true"/>
                    <xsd:element name="manualChanged" type="xsd:boolean" nillable="true"/>
                    <xsd:element name="subDiscnt" type="xsd:decimal" nillable="true"/>
                    <xsd:element name="totDoc" type="xsd:decimal" nillable="true"/>
                    <xsd:element name="checkGds" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="doccode" type="xsd:string" nillable="true"/>
                          <xsd:element name="gdsCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="qnty" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="priceBase" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="priceDiscnt" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="lineNum" type="xsd:int" nillable="true"/>
                          <xsd:element name="pump" type="xsd:int" nillable="true"/>
                          <xsd:element name="roadTax" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="srcCode" type="xsd:string" nillable="true"/>
                          <xsd:element name="srcQnty" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="srcPrice" type="xsd:decimal" nillable="true"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="checkPay" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="docCode" type="xsd:string" nillable="true"/>
                          <xsd:element name="payCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="payCard" type="xsd:string" nillable="true"/>
                          <xsd:element name="currCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="sumBase" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sumRubl" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="sumTot" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="lineNum" type="xsd:int" nillable="true"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="checkDiscount" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="docCode" type="xsd:string" nillable="true"/>
                          <xsd:element name="recType" type="xsd:int" nillable="true"/>
                          <xsd:element name="lineNum" type="xsd:int" nillable="true"/>
                          <xsd:element name="discnt-id" type="xsd:int" nillable="true"/>
                          <xsd:element name="discntVCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="objectLineNum" type="xsd:int" nillable="true"/>
                          <xsd:element name="discntTargetCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="discntTypeCode" type="xsd:int" nillable="true"/>
                          <xsd:element name="discntValueAbs" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="discntValuePcnt" type="xsd:decimal" nillable="true"/>
                          <xsd:element name="srcDCard" type="xsd:string" nillable="true"/>
                          <xsd:element name="discntKategory" type="xsd:int" nillable="true"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//operation"/>
      <xsd:field xpath="referenceNo"/>
    </xsd:unique>
    <xsd:unique name="cassSum_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//cassSum"/>
      <xsd:field xpath="referenceNo"/>
      <xsd:field xpath="code"/>
    </xsd:unique>
    <xsd:unique name="payCode_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//payCode"/>
      <xsd:field xpath="referenceNo"/>
      <xsd:field xpath="good"/>
      <xsd:field xpath="deskcode"/>
      <xsd:field xpath="payCode"/>
    </xsd:unique>
    <xsd:unique name="payCard_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//payCard"/>
      <xsd:field xpath="referenceNo"/>
      <xsd:field xpath="good"/>
      <xsd:field xpath="deskcode"/>
      <xsd:field xpath="payCode"/>
      <xsd:field xpath="num"/>
    </xsd:unique>
    <xsd:unique name="check_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//check"/>
      <xsd:field xpath="referenceNo"/>
      <xsd:field xpath="doccode"/>
    </xsd:unique>
    <xsd:unique name="checkGds_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//checkGds"/>
      <xsd:field xpath="doccode"/>
      <xsd:field xpath="lineNum"/>
    </xsd:unique>
    <xsd:unique name="checkPay_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//checkPay"/>
      <xsd:field xpath="docCode"/>
      <xsd:field xpath="lineNum"/>
    </xsd:unique>
    <xsd:unique name="checkDiscount_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//checkDiscount"/>
      <xsd:field xpath="docCode"/>
      <xsd:field xpath="recType"/>
      <xsd:field xpath="lineNum"/>
      <xsd:field xpath="discnt-id"/>
    </xsd:unique>
    <xsd:keyref name="operation-saleDoc" refer="pi" prodata:nested="true">
      <xsd:selector xpath=".//saleDoc"/>
      <xsd:field xpath="saleReferenceNo"/>
    </xsd:keyref>
    <xsd:keyref name="saleDoc-payCard" refer="payCode_pi" prodata:nested="true">
      <xsd:selector xpath=".//payCard"/>
      <xsd:field xpath="referenceNo"/>
      <xsd:field xpath="good"/>
      <xsd:field xpath="deskcode"/>
      <xsd:field xpath="payCode"/>
    </xsd:keyref>
    <xsd:keyref name="operation-check1" refer="pi" prodata:nested="true">
      <xsd:selector xpath=".//check"/>
      <xsd:field xpath="referenceNo"/>
    </xsd:keyref>
  </xsd:element>
  <xsd:annotation>
    <xsd:appinfo>
      <prodata:index name="pi" prodata:primaryIndex="true">
        <prodata:table name="saleDoc"/>
        <prodata:field name="saleReferenceNo"/>
        <prodata:field name="codeOperation"/>
        <prodata:field name="referenceNo"/>
      </prodata:index>
      <prodata:relation name="saleDoc-cassSum" prodata:nested="true" prodata:parent="saleDoc" prodata:child="cassSum" prodata:relationFields="referenceNo,referenceNo"/>
      <prodata:relation name="saleDoc-payCode" prodata:nested="true" prodata:parent="saleDoc" prodata:child="payCode" prodata:relationFields="referenceNo,referenceNo"/>
      <prodata:relation name="check1-checkGds" prodata:nested="true" prodata:parent="check1" prodata:child="checkGds" prodata:relationFields="doccode,doccode"/>
      <prodata:relation name="check1-checkPay" prodata:nested="true" prodata:parent="check1" prodata:child="checkPay" prodata:relationFields="doccode,docCode"/>
      <prodata:relation name="check1-checkDiscount" prodata:nested="true" prodata:parent="check1" prodata:child="checkDiscount" prodata:relationFields="doccode,docCode"/>
    </xsd:appinfo>
  </xsd:annotation>
</xsd:schema>
