              <xsd:element name="reg-code" type="xsd:int" nillable="true"/>
              <xsd:element name="attr-cli-alc-producer" type="xsd:string" nillable="true"/>
              <xsd:element name="attr-foreign-producer" type="xsd:string" nillable="true"/>
              <xsd:element name="firm-01" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="firm-code" type="xsd:int" nillable="true"/>
                    <xsd:element name="addres1" type="xsd:string" nillable="true"/>
