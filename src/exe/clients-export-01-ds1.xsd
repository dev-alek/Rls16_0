                    <xsd:element name="firm-name" type="xsd:string" nillable="true"/>
                    <xsd:element name="gender" type="xsd:boolean" nillable="true"/>
                    <xsd:element name="given-by" type="xsd:string" nillable="true"/>
                    <xsd:element name="ind" type="xsd:string" nillable="true"/>
                    <xsd:element name="inn" type="xsd:string" nillable="true"/>
