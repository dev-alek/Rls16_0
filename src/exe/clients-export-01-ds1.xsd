                    <xsd:element name="tobj-code" type="xsd:int" nillable="true"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="person-01" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="psn-code" type="xsd:int" nillable="true"/>
