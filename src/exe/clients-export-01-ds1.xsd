    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//clients-01"/>
      <xsd:field xpath="obj-type"/>
      <xsd:field xpath="obj-code"/>
    </xsd:unique>
    <xsd:unique name="firm-01_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//firm-01"/>
      <xsd:field xpath="firm-code"/>
    </xsd:unique>
    <xsd:unique name="person-01_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//person-01"/>
      <xsd:field xpath="psn-code"/>
    </xsd:unique>
  </xsd:element>
  <xsd:annotation>
    <xsd:appinfo>
      <prodata:relation name="firm" prodata:nested="true" prodata:parent="clients-01" prodata:child="firm-01" prodata:relationFields="obj-code,firm-code"/>
      <prodata:relation name="person" prodata:nested="true" prodata:parent="clients-01" prodata:child="person-01" prodata:relationFields="obj-code,psn-code"/>
    </xsd:appinfo>
  </xsd:annotation>
