<?xml version="1.0" encoding="windows-1251"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xs:simpleType name="Line-numType">
    <xs:restriction base="xs:positiveInteger"/>
  </xs:simpleType>
  <xs:simpleType name="CliType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="орг"/>
      <xs:enumeration value="чел"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ObjType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="маг"/>
      <xs:enumeration value="скл"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CliCode">
    <xs:restriction base="xs:int">
      <xs:minExclusive value="0"/>
      <xs:maxInclusive value="999999999"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ObjCode">
    <xs:restriction base="xs:int">
      <xs:maxInclusive value="9999"/>
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
	<xs:simpleType name="THArtic">
		<xs:annotation>
			<xs:documentation>Артикул товара, запрещены символы табуляции, перевода строки и возврата каретки, а также символы пробела НЕВНУТРИ строки</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:normalizedString">
      <xs:minLength value="1"/>
			<xs:maxLength value="16"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="THGoodsType">
		<xs:annotation>
			<xs:documentation>Тип товара - товара или услуга</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(т|у)"/>
		</xs:restriction>
	</xs:simpleType>
  <xs:simpleType name="PriceType">
		<xs:restriction base="xs:decimal">
			<xs:minExclusive value="0"/>
      <xs:fractionDigits value="2"/>
		</xs:restriction>
	</xs:simpleType>
  <xs:simpleType name="posint9">
    <xs:restriction base="xs:positiveInteger">
      <xs:totalDigits value="9" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VatType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxExclusive value="100"/>
      <xs:fractionDigits value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="THDocType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="при"/>
      <xs:enumeration value="рас"/>
      <xs:enumeration value="спи"/>
      <xs:enumeration value="возврат"/>
      <xs:enumeration value="инв"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="THExtentedDocType">
		<xs:annotation>
			<xs:documentation>Перечисление всех возможных расширенных типов документов IBS TH
		ie=приход внешний,
		ee=расход внешний,
		ep=возврат поставщику,
		es=касса продажа,
		re=возврат внешний,
		rs=касса возврат,
		we=списание,
		vt=инвентаризация,
		vp=пересортица,
		iv=приход внутреннйи,
		ev=расход внутренний,
		rv=возврат внуренний,
		em=расход производство,
		wm=списание производство,
		im=приход производство,
		ot=переоценка,
		ap=коррекция учетных цен,
		mp=корректировка отрицательных партий,
		pc=смена типа приобретения</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ie"/>
			<xs:enumeration value="ee"/>
			<xs:enumeration value="ep"/>
			<xs:enumeration value="es"/>
			<xs:enumeration value="re"/>
			<xs:enumeration value="rs"/>
			<xs:enumeration value="we"/>
			<xs:enumeration value="vt"/>
			<xs:enumeration value="vp"/>
			<xs:enumeration value="iv"/>
			<xs:enumeration value="ev"/>
			<xs:enumeration value="rv"/>
			<xs:enumeration value="em"/>
			<xs:enumeration value="wm"/>
			<xs:enumeration value="im"/>
			<xs:enumeration value="ot"/>
			<xs:enumeration value="ap"/>
			<xs:enumeration value="mp"/>
			<xs:enumeration value="pc"/>
		</xs:restriction>
	</xs:simpleType>
  <xs:simpleType name="CurrCode">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="999"/>
    </xs:restriction>
  </xs:simpleType>
	<xs:simpleType name="THExchRate">
		<xs:restriction base="xs:decimal">
			<xs:minExclusive value="0"/>
			<xs:fractionDigits value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="THExchScale">
		<xs:restriction base="xs:int">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="99999"/>
		</xs:restriction>
	</xs:simpleType>
  <xs:simpleType name="StatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="N"/>
      <xs:enumeration value="U"/>
      <xs:enumeration value="D"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BarCodeType">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="100000"/>
      <xs:maxInclusive value="999999999"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Unit">
    <xs:restriction base="xs:string">
      <xs:pattern value="\w{1,3}"/>
    </xs:restriction>
  </xs:simpleType>
	<xs:simpleType name="THCliBaseRate">
		<xs:restriction base="xs:decimal">
			<xs:minExclusive value="0"/>
      <xs:fractionDigits value="4"/>
		</xs:restriction>
	</xs:simpleType>
  <xs:complexType name="HEADERType">
    <xs:sequence>
      <xs:element name="to_">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="IBS Trade House" />
            <xs:enumeration value="ESHOP" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="from_">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="ESHOP" />
            <xs:enumeration value="IBS Trade House" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="obj-type">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="скл" />
            <xs:enumeration value="маг" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="obj-code">
        <xs:simpleType>
          <xs:restriction base="xs:positiveInteger">
            <xs:totalDigits value="4" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="name" type="xs:string" />
      <xs:element name="xsd">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value=".+\.xsd" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="date-from" type="xs:dateTime" />
      <xs:element name="date-to" type="xs:dateTime" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>