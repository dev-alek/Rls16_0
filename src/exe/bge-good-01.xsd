<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:element name="bge-good-01" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="good" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="gds-code" type="xsd:int" nillable="false"/>
              <xsd:element name="deleted" type="xsd:boolean" nillable="true"/>
              <xsd:element name="artic" type="xsd:string" nillable="false"/>
              <xsd:element name="prodtype" type="xsd:string" nillable="false"/>
              <xsd:element name="prodcode" type="xsd:int" nillable="false"/>
              <xsd:element name="units" type="xsd:string" nillable="false"/>
              <xsd:element name="type" type="xsd:string" nillable="false"/>
              <xsd:element name="okdp" type="xsd:string" nillable="false"/>
              <xsd:element name="name" type="xsd:string" nillable="false"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//good"/>
      <xsd:field xpath="gds-code"/>
    </xsd:unique>
  </xsd:element>
</xsd:schema>
