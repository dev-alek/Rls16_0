ADD TABLE "xGroupObj"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Словарь групп объектов"
  DESCRIPTION "Словарь групп объектов"
  DUMP-NAME "GroupObj"
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "trg/xgrobjd.p" CRC "?" 
  TABLE-TRIGGER "Write" OVERRIDE PROCEDURE "trg/xgrobjw.p" CRC "?" 

ADD FIELD "GroupObj-Code" OF "xGroupObj" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "групп объектов"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  HELP "Групп объектов"
  ORDER 10
  MANDATORY

ADD FIELD "Name" OF "xGroupObj" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 4
  MAX-WIDTH 2000
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование группы объектов"
  ORDER 30
  MANDATORY

ADD FIELD "System" OF "xGroupObj" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Системный"
  POSITION 5
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "СИСТЕМНЫЙ"
  HELP "Признак принадлежности к ядру th"
  ORDER 40

ADD FIELD "Progress-Table" OF "xGroupObj" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Да"
  LABEL "Таблица"
  POSITION 6
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ТАБЛИЦА"
  HELP "Таблица или справочник"
  ORDER 50

ADD FIELD "Hierarchy" OF "xGroupObj" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Иерархия"
  POSITION 7
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ИЕРАРХИЯ"
  HELP "Иерархический справочник?"
  ORDER 60

ADD FIELD "Parent-GroupObj" OF "xGroupObj" AS character 
  FORMAT "X(40)"
  INITIAL ""
  LABEL "Группы объектов-родители"
  POSITION 8
  MAX-WIDTH 200
  COLUMN-LABEL "Группы объектов-РОДИТЕЛИ"
  HELP "Список групп объектов-родителей"
  ORDER 70

ADD FIELD "Description" OF "xGroupObj" AS character 
  FORMAT "x(1000)"
  INITIAL ""
  LABEL "Описание"
  POSITION 13
  MAX-WIDTH 4000
  VIEW-AS "VIEW-AS EDITOR INNER-CHARS 50 INNER-LINES 5 SCROLLBAR-VERTICAL"
  COLUMN-LABEL "ОПИСАНИЕ"
  HELP "Описание группы объектов"
  ORDER 120


ADD FIELD "Progress-Code" OF "xGroupObj" AS character 
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Таблица Progress"
  POSITION 16
  MAX-WIDTH 200
  COLUMN-LABEL "ТАБЛИЦА Progress"
  HELP "Таблица Progress, по которой хранятся допреквизиты класса"
  ORDER 20

ADD INDEX "GroupObj-Code" ON "xGroupObj" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "GroupObj-Code" ASCENDING 

ADD INDEX "parent" ON "xGroupObj" 
  AREA "Primary_index"
  INDEX-FIELD "Parent-GroupObj" ASCENDING 

ADD INDEX "Parent-GroupObj" ON "xGroupObj" 
  AREA "Primary_index"
  INDEX-FIELD "Progress-Code" ASCENDING 
  INDEX-FIELD "GroupObj-Code" ASCENDING 

ADD INDEX "parents" ON "xGroupObj" 
  AREA "Primary_index"
  WORD
  INDEX-FIELD "Parent-GroupObj" ASCENDING 
.
PSC
cpstream=ibm866
.

