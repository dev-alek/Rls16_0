ADD TABLE "class-method"
  AREA "other"
  CAN-CREATE "!,*"
  CAN-DELETE "!,*"
  CAN-READ "!,*"
  CAN-WRITE "!,*"
  DESCRIPTION "Методы классов


"
  DUMP-NAME "class-me"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "tc-xmeth.p" CRC "?" 
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "td-xmeth.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "tw-xmeth.p" CRC "?" 

ADD FIELD "Class-Code" OF "class-method" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Класс объекта"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  VALEXP "can-find(class of class-method)"
  VALMSG "Нет такого класса!"
  HELP "Класс объекта"
  ORDER 10
  MANDATORY

ADD FIELD "method-id" OF "class-method" AS character 
  DESCRIPTION "Идентификатор метода"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Тип метода"
  POSITION 3
  MAX-WIDTH 24
  COLUMN-LABEL "ТИП МЕТОДА"
  VALEXP "can-find(first code where code.class eq 'Class-Method' and code.code eq input Method-Id)"
  VALMSG "Тип метода не найден в справочнике!"
  HELP "Идентификатор метода обработки"
  ORDER 250

ADD FIELD "procedure" OF "class-method" AS character 
  FORMAT "x(30)"
  INITIAL ?
  LABEL "Процедура"
  POSITION 4
  MAX-WIDTH 400
  COLUMN-LABEL "ПРОЦЕДУРА"
  VALEXP "procedure <> """""
  VALMSG "Введите имя процедуры!"
  HELP "Название процедуры"
  ORDER 30

ADD FIELD "Params" OF "class-method" AS character 
  FORMAT "x(300)"
  INITIAL ""
  LABEL "Параметры"
  POSITION 6
  MAX-WIDTH 600
  VIEW-AS "VIEW-AS FILL-IN SIZE 30 BY 1"
  COLUMN-LABEL "ПАРАМЕТРЫ"
  HELP "Параметры процедуры"
  ORDER 130

ADD FIELD "Xattr-Code" OF "class-method" AS character 
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Код реквизита"
  POSITION 8
  MAX-WIDTH 64
  VIEW-AS "VIEW-AS FILL-IN SIZE 14 BY 1"
  COLUMN-LABEL "КОД РЕКВИЗИТА"
  HELP "Идентификатор реквизита объекта"
  ORDER 150
  MANDATORY

ADD FIELD "sign-inherit" OF "class-method" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 9
  MAX-WIDTH 200
  COLUMN-LABEL "Наследование"
  VALEXP "lookup(sign-inherit, ""с,п,н"") > 0"
  VALMSG "неверный признак!"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 240
  MANDATORY

ADD FIELD "since" OF "class-method" AS date 
  FORMAT "99/99/9999"
  INITIAL "today"
  LABEL "Дата"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "ДАТА"
  HELP "Дата начала действия метода"
  ORDER 260
  MANDATORY

ADD FIELD "method-code" OF "class-method" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Код метода"
  POSITION 12
  MAX-WIDTH 24
  COLUMN-LABEL "КОД МЕТОДА"
  VALEXP "input method-code = '' or can-find(first code where code.class = 'class-method' and code.code = input method-code and code.parent = input method-id)"
  VALMSG "Не найден такой код метода в справочнике!"
  HELP "Код метода обработки"
  ORDER 20
  MANDATORY

ADD INDEX "Method" ON "class-method" 
  AREA "other-i"
  UNIQUE
  PRIMARY
  INDEX-FIELD "Class-Code" ASCENDING 
  INDEX-FIELD "Xattr-Code" ASCENDING 
  INDEX-FIELD "method-id" ASCENDING 
  INDEX-FIELD "since" ASCENDING 

ADD INDEX "procedure" ON "class-method" 
  AREA "other-i"
  INDEX-FIELD "procedure" ASCENDING 
.
PSC
cpstream=ibm866
.
