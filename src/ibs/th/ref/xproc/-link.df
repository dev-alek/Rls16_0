
ADD TABLE "xlink"
  AREA "other"
  CAN-CREATE "!,*"
  CAN-DELETE "!,*"
  CAN-READ "!,*"
  CAN-WRITE "!,*"
  LABEL "Связи в метасхеме"
  DESCRIPTION "Связи в метасхеме"
  DUMP-NAME "xlink"
  TABLE-TRIGGER "Create" OVERRIDE PROCEDURE "tc-xlink.p" CRC "?" 
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "td-xlink.p" CRC "?" 
  TABLE-TRIGGER "Write" OVERRIDE PROCEDURE "tw-xlink.p" CRC "?" 

ADD FIELD "class-code" OF "xlink" AS character 
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Класс объекта"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  VALEXP "can-find(class of xlink)"
  VALMSG "Нет такого класса!"
  HELP "Класс объекта"
  ORDER 10
  MANDATORY

ADD FIELD "link-name" OF "xlink" AS character 
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Название связи"
  POSITION 3
  MAX-WIDTH 500
  COLUMN-LABEL "НАЗВАНИЕ"
  VALEXP "link-name <> """""
  VALMSG "хоть как-нибудь назовите!"
  HELP "Название связи"
  ORDER 20
  MANDATORY

ADD FIELD "link-id" OF "xlink" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Идентификатор"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "ИДЕНТИФИКАТОР"
  HELP "Уникальный идентификатор связи"
  ORDER 30
  MANDATORY

ADD FIELD "link-code" OF "xlink" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "Код связи"
  POSITION 5
  MAX-WIDTH 32
  COLUMN-LABEL "КОД СВЯЗИ"
  VALEXP "link-code <> ''"
  VALMSG "Назовите как-нибудь!"
  HELP "Код связи"
  ORDER 40
  MANDATORY

ADD FIELD "link-direction" OF "xlink" AS character 
  FORMAT "x(1)"
  INITIAL ?
  LABEL "Направление"
  POSITION 6
  MAX-WIDTH 10
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Источник"", ""s"" ,""Приёмник"", ""t"", ""Двунаправленная"", ?"
  COLUMN-LABEL "НАПРАВЛЕНИЕ"
  VALEXP "link-direction = ? or link-direction = 's' or link-direction = 't'"
  VALMSG "Неверный тип направления связи!"
  HELP "Направление связи"
  ORDER 50

ADD FIELD "link-type" OF "xlink" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Тип связи"
  POSITION 7
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""идентифицирующая"", yes, ""неидентифицирующая"", no"
  COLUMN-LABEL "ТИП СВЯЗИ"
  HELP "Идентифицирующая (устанавливающая зависимость) связь или нет"
  ORDER 90
  MANDATORY

ADD FIELD "cardinality" OF "xlink" AS character 
  FORMAT "x(8)"
  INITIAL "0N"
  LABEL "Мощность связи"
  POSITION 8
  MAX-WIDTH 16
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""0,1 или много"", ""0n"", ""1 или много"", ""1N"", ""0 или 1"", ""01"", ""точно N"", ""n"""
  COLUMN-LABEL "МОЩНОСТЬ"
  VALEXP "can-do(""0n,1n,01,n"", cardinality)"
  HELP "Обозначает число экземпляров родительской сущности к дочерней"
  ORDER 100

ADD FIELD "link-val" OF "xlink" AS character 
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Значение связи"
  POSITION 9
  MAX-WIDTH 120
  COLUMN-LABEL "ЗНАЧЕНИЕ СВЯЗИ"
  HELP "Значение связи по умолчанию"
  ORDER 80

ADD FIELD "sign-inherit" OF "xlink" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 10
  MAX-WIDTH 200
  COLUMN-LABEL "Наследование"
  VALEXP "lookup(sigh-inherit, ""с,п,н"") > 0"
  VALMSG "неверный признак!"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 240
  MANDATORY

ADD FIELD "target-class" OF "xlink" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Связанный класс"
  POSITION 11
  MAX-WIDTH 40
  COLUMN-LABEL "СВЯЗАННЫЙ КЛАСС"
  HELP "Верхний класс объектов для связи"
  ORDER 250
  MANDATORY

ADD FIELD "Hidden" OF "xlink" AS logical 
  DESCRIPTION "Связь скрытая (по умолчанию не видна)"
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Скрытая"
  POSITION 12
  MAX-WIDTH 1
  COLUMN-LABEL "СКРЫТАЯ"
  HELP "Связь скрытая (по умолчанию не видна)"
  ORDER 260

ADD INDEX "class-link" ON "xlink" 
  AREA "other-i"
  UNIQUE
  PRIMARY
  INDEX-FIELD "class-code" ASCENDING 
  INDEX-FIELD "link-code" ASCENDING 
  INDEX-FIELD "link-direction" ASCENDING 

ADD INDEX "link-id-direction" ON "xlink" 
  AREA "other-i"
  UNIQUE
  INDEX-FIELD "link-id" ASCENDING 
  INDEX-FIELD "link-direction" ASCENDING 
  INDEX-FIELD "class-code" ASCENDING 
.
PSC
cpstream=ibm866
.
