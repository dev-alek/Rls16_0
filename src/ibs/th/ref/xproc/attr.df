ADD TABLE "Xattr"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Словарь реквизитов"
  DESCRIPTION "Словарь реквизитов"
  DUMP-NAME "xattr"
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "trg/xattrd.p" CRC "?" 
  TABLE-TRIGGER "Write" OVERRIDE PROCEDURE "trg/xattrw.p" CRC "?" 

ADD FIELD "GroupObj-code" OF "Xattr" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Группа объекта"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  HELP "Группа объекта"
  ORDER 10
  MANDATORY

ADD FIELD "Xattr-Code" OF "Xattr" AS character 
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Код реквизита"
  POSITION 3
  MAX-WIDTH 64
  COLUMN-LABEL "КОД РЕКВИЗИТА"
  HELP "Идентификатор реквизита объекта"
  ORDER 20
  MANDATORY

ADD FIELD "Name" OF "Xattr" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 4
  MAX-WIDTH 2000
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование реквизита"
  ORDER 30

ADD FIELD "Data-Type" OF "Xattr" AS character 
  FORMAT "x(12)"
  INITIAL "character"
  LABEL "Тип реквизита"
  POSITION 6
  MAX-WIDTH 200
  VIEW-AS ""
  COLUMN-LABEL "ТИП"
  HELP "Тип реквизита"
  ORDER 50

ADD FIELD "Data-Format" OF "Xattr" AS character 
  FORMAT "x(30)"
  INITIAL "x(12)"
  LABEL "Формат реквизита"
  POSITION 7
  MAX-WIDTH 60
  COLUMN-LABEL "ФОРМАТ"
  HELP "Формат реквизита"
  ORDER 60

ADD FIELD "Domain-Code" OF "Xattr" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Домен"
  POSITION 8
  MAX-WIDTH 1000
  COLUMN-LABEL "ДОМЕН"
  HELP "Домен, на котором определен реквизит, или имя класса или ''"
  ORDER 70

ADD FIELD "Mandatory" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Обязателен"
  POSITION 9
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ОБЯЗАТЕЛЕН"
  HELP "Признак обязательности реквизита для всех объектов"
  ORDER 80
  MANDATORY

ADD FIELD "Constant" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Неизменяемый"
  POSITION 10
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "НЕИЗМЕНЯЕМЫЙ"
  HELP "Признак неизменности реквизита в течение всей жизни объекта"
  ORDER 90
  MANDATORY

ADD FIELD "Validation" OF "Xattr" AS character 
  FORMAT "x(300)"
  INITIAL "*"
  LABEL "Валидация"
  POSITION 11
  MAX-WIDTH 600
  VIEW-AS "VIEW-AS FILL-IN SIZE 40 BY 1"
  COLUMN-LABEL "ВАЛИДАЦИЯ"
  HELP "Список допустимых выражений в формате can-do()"
  ORDER 100
  MANDATORY

ADD FIELD "Initial" OF "Xattr" AS character 
  FORMAT "x(100)"
  INITIAL ""
  LABEL "Нач. значение"
  POSITION 14
  MAX-WIDTH 4000
  VIEW-AS "VIEW-AS FILL-IN SIZE 40 BY 1"
  COLUMN-LABEL "НАЧ. ЗНАЧЕНИЕ"
  HELP "Начальное значение реквизита объекта"
  ORDER 130

ADD FIELD "Progress-Field" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "Нет"
  LABEL "Основной"
  POSITION 15
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ОСН"
  HELP "Основной реквизит (описан в СЛОВАРЕ ДАННЫХ) или дополнительный?"
  ORDER 25

ADD FIELD "Description" OF "Xattr" AS character 
  FORMAT "x(300)"
  INITIAL ""
  LABEL "Описание"
  POSITION 17
  MAX-WIDTH 4000
  VIEW-AS "VIEW-AS EDITOR INNER-CHARS 40 INNER-LINES 3"
  COLUMN-LABEL "ОПИСАНИЕ"
  HELP "Описание реквизита"
  ORDER 35

ADD FIELD "Overridable" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Переопределяемый"
  POSITION 18
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ПЕРЕОПРЕДЕЛЯЕМЫЙ"
  HELP "Атрибут перегружаемый (можно переопределять в потомках)"
  ORDER 160

ADD FIELD "Hidden" OF "Xattr" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Скрытый"
  POSITION 19
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "СКРЫТЫЙ"
  HELP "Атрибут скрытый (по умолчанию не виден)"
  ORDER 170

ADD FIELD "sign-inherit" OF "Xattr" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 24
  MAX-WIDTH 200
  COLUMN-LABEL "Наследование"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 240
  MANDATORY

ADD FIELD "order" OF "Xattr" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Номер"
  POSITION 25
  MAX-WIDTH 4
  COLUMN-LABEL "N"
  HELP "Порядковый номер реквизита для сортировки"
  ORDER 250

ADD FIELD "xattr-label" OF "Xattr" AS character 
  FORMAT "x(45)"
  INITIAL ""
  LABEL "Метка"
  POSITION 26
  MAX-WIDTH 500
  COLUMN-LABEL "МЕТКА"
  HELP "Метка"
  ORDER 260

ADD FIELD "xattr-clabel" OF "Xattr" AS character 
  FORMAT "x(45)"
  INITIAL ""
  LABEL "МЕТКА"
  POSITION 27
  MAX-WIDTH 500
  COLUMN-LABEL "Метка"
  HELP "Метка колонки"
  ORDER 270

ADD FIELD "Accuracy" OF "Xattr" AS integer 
  FORMAT "->9"
  INITIAL "2"
  LABEL "Точность"
  POSITION 28
  MAX-WIDTH 4
  COLUMN-LABEL "ТОЧНОСТЬ"
  HELP "Точность представления чисел (количество знаков после запятой)"
  ORDER 280

ADD INDEX "Class-Xattr" ON "Xattr" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "GroupObj-Code" ASCENDING 
  INDEX-FIELD "Xattr-Code" ASCENDING 

ADD INDEX "data-type" ON "Xattr" 
  AREA "Primary_index"
  INDEX-FIELD "Data-Type" ASCENDING 
  INDEX-FIELD "Xattr-Code" ASCENDING 

ADD INDEX "Domain" ON "Xattr" 
  AREA "Primary_index"
  INDEX-FIELD "Domain-Code" ASCENDING 

ADD INDEX "Xattr-Class" ON "Xattr" 
  AREA "Primary_index"
  UNIQUE
  INDEX-FIELD "Xattr-Code" ASCENDING 
  INDEX-FIELD "GroupObj-Code" ASCENDING 
.
PSC
cpstream=ibm866
.
