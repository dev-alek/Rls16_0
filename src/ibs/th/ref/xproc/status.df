
ADD TABLE "xstatus"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Статусы класса"
  DESCRIPTION "Статусы класса"
  DUMP-NAME "xstatus"
  TABLE-TRIGGER "Delete" OVERRIDE PROCEDURE "trg/xstatd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/xstatw.p" CRC "?" 

ADD FIELD "GroupObj-code" OF "xstatus" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Класс объекта"
  POSITION 2
  MAX-WIDTH 200
  COLUMN-LABEL "КЛАСС"
  HELP "Класс объекта"
  ORDER 10
  MANDATORY

ADD FIELD "status-code" OF "xstatus" AS character 
  DESCRIPTION "Код статуса"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Код статуса"
  POSITION 3
  MAX-WIDTH 50
  COLUMN-LABEL "КОД СТАТУСА"
  HELP "Код статуса"
  ORDER 20
  MANDATORY

ADD FIELD "id-status" OF "xstatus" AS integer 
  DESCRIPTION "Идентификатор статуса"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Идентификатор статуса"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "ИДЕНТИФИКАТОР"
  HELP "Идентификатор статуса"
  ORDER 30
  MANDATORY

ADD FIELD "name" OF "xstatus" AS character 
  DESCRIPTION "Наименование статуса"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование статуса"
  POSITION 5
  MAX-WIDTH 500
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование статуса"
  ORDER 40
  MANDATORY

ADD FIELD "sign-inherit" OF "xstatus" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 6
  MAX-WIDTH 32
  COLUMN-LABEL "Наследование"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 240
  MANDATORY

ADD FIELD "can_create" OF "xstatus" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "СОЗДАНИЕ"
  POSITION 8
  MAX-WIDTH 1
  COLUMN-LABEL "СОЗДАНИЕ"
  HELP "Возможность создания объекта в текущем статусе"
  ORDER 260
  MANDATORY

ADD FIELD "order" OF "xstatus" AS integer 
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Номер"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "НОМЕР"
  HELP "Номер для определения направления движения по статусам"
  ORDER 250

ADD FIELD "can_delete" OF "xstatus" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "УДАЛЕНИЕ"
  POSITION 10
  MAX-WIDTH 1
  COLUMN-LABEL "УДАЛЕНИЕ"
  HELP "Возможность удаления объекта в текущем статусе"
  ORDER 280
  MANDATORY

ADD FIELD "can_edit" OF "xstatus" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "РЕДАКТИРОВНИЕ"
  POSITION 11
  MAX-WIDTH 1
  COLUMN-LABEL "РЕДАКТИРОВНИЕ"
  HELP "Возможность редактирования объекта в текущем статусе"
  ORDER 270
  MANDATORY

ADD FIELD "Overridable" OF "xstatus" AS logical 
  FORMAT "Да/Нет"
  INITIAL "yes"
  LABEL "Переопределяемый"
  POSITION 12
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ПЕРЕОПРЕДЕЛЯЕМЫЙ"
  HELP "Статус перегружаемый (можно переопределять в потомках)"
  ORDER 300

ADD FIELD "Hidden" OF "xstatus" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Скрытый"
  POSITION 13
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "СКРЫТЫЙ"
  HELP "Статус скрытый (по умолчанию не виден)"
  ORDER 310

ADD INDEX "GroupObj-status" ON "xstatus" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "GroupObj-code" ASCENDING 
  INDEX-FIELD "status-code" ASCENDING 

ADD INDEX "id-stat" ON "xstatus" 
  AREA "Primary_index"
  UNIQUE
  INDEX-FIELD "id-status" ASCENDING 

ADD INDEX "order" ON "xstatus" 
  AREA "Primary_index"
  INDEX-FIELD "GroupObj-code" ASCENDING 
  INDEX-FIELD "order" ASCENDING 
.
PSC
cpstream=ibm866
.
