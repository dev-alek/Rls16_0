
ADD TABLE "xtrans-status"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "переходы статусов"
  DESCRIPTION "Переходы статусов"
  DUMP-NAME "xtrans-s"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/xtstsd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/xtstsw.p" CRC "?" 

ADD FIELD "run-method" OF "xtrans-status" AS character 
  FORMAT "x(600)"
  INITIAL ""
  LABEL "Метод перехода"
  POSITION 6
  MAX-WIDTH 1200
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "МЕТОД ПЕРЕХОДА"
  HELP "метод или код транзакции для выполнения после перехода"
  ORDER 50

ADD FIELD "id-trans" OF "xtrans-status" AS integer 
  DESCRIPTION "Идентификатор перехода"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Идентификатор перехода"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "ИДЕНТИФИКАТОР ПЕРЕХОДА"
  HELP "Идентификатор перехода"
  ORDER 70
  MANDATORY

ADD FIELD "sign-inherit" OF "xtrans-status" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "ПРИЗНАК!НАСЛЕДОВАНИЯ"
  POSITION 10
  MAX-WIDTH 32
  COLUMN-LABEL "Наследование"
  HELP "Признак наследования - собств., наследов. или переопределенный"
  ORDER 120
  MANDATORY

ADD FIELD "GroupObj-code" OF "xtrans-status" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Группа объекта"
  POSITION 13
  MAX-WIDTH 200
  COLUMN-LABEL "Группа"
  HELP "Группа объекта"
  ORDER 110
  MANDATORY

ADD FIELD "trans-code" OF "xtrans-status" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "КОД ПЕРЕХОДА"
  POSITION 14
  MAX-WIDTH 200
  ORDER 130

ADD FIELD "status-code" OF "xtrans-status" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Старый статус"
  POSITION 15
  MAX-WIDTH 200
  ORDER 150
  MANDATORY

ADD FIELD "status-code-new" OF "xtrans-status" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Новый статус"
  POSITION 16
  MAX-WIDTH 200
  ORDER 160
  MANDATORY

ADD FIELD "name" OF "xtrans-status" AS character 
  DESCRIPTION "Наименование перехода"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Наименование перехода"
  POSITION 17
  MAX-WIDTH 500
  COLUMN-LABEL "НАИМЕНОВАНИЕ"
  HELP "Наименование перехода"
  ORDER 170
  MANDATORY

ADD FIELD "Hidden" OF "xtrans-status" AS logical 
  FORMAT "Да/Нет"
  INITIAL "no"
  LABEL "Скрытый"
  POSITION 19
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "СКРЫТЫЙ"
  HELP "Переход скрытый (по умолчанию не виден)"
  ORDER 210

ADD FIELD "Overridable" OF "xtrans-status" AS logical 
  FORMAT "Да/Нет"
  INITIAL "yes"
  LABEL "Переопределяемый"
  POSITION 21
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  COLUMN-LABEL "ПЕРЕОПРЕДЕЛЯЕМЫЙ"
  HELP "Переход перегружаемый (можно переопределять в потомках)"
  ORDER 200

ADD FIELD "order" OF "xtrans-status" AS integer 
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Номер"
  POSITION 22
  MAX-WIDTH 4
  COLUMN-LABEL "НОМЕР"
  HELP "Номер для определения порядка переходов по статусам"
  ORDER 220

ADD INDEX "GroupObj" ON "xtrans-status" 
  AREA "Primary_index"
  PRIMARY
  UNIQUE
  INDEX-FIELD "GroupObj-code" ASCENDING
  INDEX-FIELD "status-code" ASCENDING
  INDEX-FIELD "status-code-new" ASCENDING 

ADD INDEX "class-trans-code" ON "xtrans-status" 
  AREA "Primary_index"
  UNIQUE
  INDEX-FIELD "GroupObj-code" ASCENDING 
  INDEX-FIELD "trans-code" ASCENDING 

.
PSC
cpstream=ibm866
.
