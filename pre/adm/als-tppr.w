PROCEDURE fill-widgets :
define variable v-value-character as character no-undo .
define variable v-value-date as date no-undo .
define variable v-value-decimal as decimal no-undo .
define variable v-value-integer as INTEGER no-undo .
define variable v-value-logical AS LOGICAL no-undo .
define variable v-param-type as character no-undo .
define variable v-param-value as character no-undo .
FOR EACH thbjattr_thbj-attr:
  delete thbjattr_thbj-attr.
end.
FOR EACH temp-thbj-attr:
  delete temp-thbj-attr.
end.
run adm/shattri.p (
              input "init":U
            , input p-obj-type
            , input p-obj-code
            , input 'alias-tpsi':U
            , input "":U
            , output v-value-character
            , output v-value-date
            , output v-value-decimal
            , output v-value-integer
            , output v-value-logical
            , output v-param-type
            , INPUT-OUTPUT TABLE-handle v-tth
            ) no-error .
if error-status:error
and not available locked_thbj-attr then do:
  message
  "Не удалось получить начальные значения настроек" skip
  error-status:get-message(1) return-value
  view-as alert-box error .
  undo, return error .
end.
FOR EACH thbjattr_thbj-attr:
  IF thbjattr_thbj-attr.prop-code = 'alias-type-price':U THEN DO:
    rs-alias-type-price = thbjattr_thbj-attr.property-value-integer.
  END.
  IF thbjattr_thbj-attr.prop-code = 'alias-object-price':U THEN DO:
    ASSIGN
    v-obj-type = entry(1, thbjattr_thbj-attr.property-value-character)
    v-obj-code = integer(entry(2, thbjattr_thbj-attr.property-value-character))
    no-error
    .
  END.
  create temp-thbj-attr.
  buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
END.
END PROCEDURE.
PROCEDURE myenable :
DEFINE buffer b#clients for ub.clients.
RS-alias-type-price:RADIO-BUTTONS IN FRAME Dialog-Frame = "Не задан,0," +  'Учетная,1,Продажная поставщика,2,Продажная приемника,3,Цена посредника,4,Цена и ск-ка док.про-жи,5':U  .
if rs-alias-type-price = INTEGER('4':U) then do:
find first b#clients WHERE
          b#clients.obj-type = v-obj-type
      and b#clients.obj-code = v-obj-code no-lock no-error.
if avail b#clients then do:
  Assign
      v-obj-code = b#clients.obj-code
      v-obj-type = b#clients.obj-type
      v-obj-name = b#clients.obj-name .
end.
else
  Assign
  v-obj-code = 0
  v-obj-type = ""
  v-obj-name = "" .
  Display
  v-obj-code
  v-obj-name
  v-obj-type
  with frame Dialog-Frame .
end.
