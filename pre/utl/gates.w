DEFINE FRAME Dialog-Frame
     b-quit AT ROW 1 COL 1
     b-add AT ROW 1 COL 31 WIDGET-ID 2
     b-chg AT ROW 1 COL 41 WIDGET-ID 4
     b-lkp AT ROW 1 COL 51 WIDGET-ID 12
     b-del AT ROW 1 COL 61 WIDGET-ID 6
