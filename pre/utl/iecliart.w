     IMAGE-DOWN FILE "btn-down-arrow":U
     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     LABEL "":L
     size 2.5 by 1.08.
DEFINE VARIABLE fi-filename AS CHARACTER FORMAT "X(256)":U
     LABEL "Файл"
