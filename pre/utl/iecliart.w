     SIZE 10 BY 1
     BGCOLOR 8 .
DEFINE BUTTON b-exp
     LABEL "&Экспорт"
     SIZE 10 BY 1
     BGCOLOR 8 .
DEFINE BUTTON B-help
     LABEL "Помо&щь"
     SIZE 10 BY 1
     BGCOLOR 8 .
DEFINE BUTTON b-imp
