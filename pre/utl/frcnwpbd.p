  :
    define input  parameter p-code           as character no-undo .
    define output parameter p-news           as logical   no-undo .
    case p-code :
            when 'tare-weight':U then do:     assign     p-news = yes.   end.
      otherwise do:
        p-news = no.
      end.
    end.
  end.
end procedure.
