      assign
        buf_tax-rate-gds.fact-date = v-fact-date
        buf_tax-rate-gds.fact-order = v-fact-order
    .
  end.
  if buf_tax-rate-gds.rate-code <> 11 then
    buf_tax-rate-gds.rate-code = 11.
