  .
end.
else do:
  run gbl/d-askw.w
    (input "Вопрос"
    ,input "Создание бар-кодов для партий товаров," + chr(10)
      + "Которые продаются по партиям"
    ,input "|^"
    ,input "Все объекты^confirm|Выбрать объекты|Отмена"
    ,input "|"
        + "|"
        + ""
    ,input 1
    ,input 3
    ,output v-num
    ).
end.
case v-num :
  when 1
