  (input  'маг':U
  ,input  buf_shop.obj-code
  ,output v-obj-db-num
  )  .
    FOR EACH buf_cash-desk NO-LOCK WHERE
        buf_cash-desk.pos-type = 'IBM-XML':U
    AND buf_cash-desk.is-del = NO
    AND buf_cash-desk.db-num = v-obj-db-num
