      ( INPUT buf_tt-cash-desk.db-num
        ,INPUT buf_tt-cash-desk.obj-code
        ,INPUT buf_tt-cash-desk.pos-type
        ,INPUT buf_tt-cash-desk.cash-num
        ,INPUT buf_tt-cash-desk.VERSION ) NO-ERROR.
