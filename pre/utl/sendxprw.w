  WHEN '' THEN DO:
    run ref/cashlist.w (input parparentproc
                  ,INPUT "b-sel,b-mark"
                  ,INPUT (if v-cntxt-db-num = 0 then 'все':U else "db")
                  ,INPUT v-cntxt-db-num
