                       string(today , "99/99/9999")     chr(9)
                       string(time , "hh:mm:ss")        chr(9)
                       buf_assortment-matrix.obj-type
                       buf_assortment-matrix.obj-code   chr(9)
                       buf_assortment-matrix-goods.gds-code   chr(9)
                       string (v-date-corr , "99/99/9999" )   chr(9)
                       buf_goods.gds-name  chr(9)
                       return-value  chr(9)
                       error-status :get-message(1)
                       chr(10).
                output stream str-err close.
            end.
    end.
    end.
 end.
if v-kol > 0 then do:
    run gbl/prnfilen.w
      (input  substitute(" Удалены из АМ товары, срок ИЖТ превысил &1 дней" , v-srok)
      ,input  0
      ,input  "autodelAM.txt"
      ,input  7
      ,output v-user-action
      ,output v-printed
      ).
end.
