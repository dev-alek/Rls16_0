def var sort-labelbr-psn-org   as character no-undo .
def var sort-clmnbr-psn-org    as handle    no-undo .
def var cur-clmnbr-psn-org     as handle    no-undo .
def var cur-clmn-locbr-psn-org as integer   no-undo .
def var re-querybr-psn-org     as logical   initial no no-undo .
on start-search, ctrl-o of br-psn-org in frame Dialog-Frame do:
   run sort-brbr-psn-org
     (input (if available X_firm
             then recid(X_firm)
             else ?
            )
     ).
end.
PROCEDURE sort-brbr-psn-org :
  define input parameter p-recid as recid no-undo .
  if re-querybr-psn-org = no then do:
    assign
       cur-clmnbr-psn-org = br-psn-org:current-column in frame Dialog-Frame
    .
    if sort-clmnbr-psn-org <> ? then sort-clmnbr-psn-org:column-fgcolor = 0.
    if cur-clmnbr-psn-org = sort-clmnbr-psn-org then do:
      assign
         sort-labelbr-psn-org = ""
         sort-clmnbr-psn-org = ?
      .
     end.
     else do:
       assign
         sort-labelbr-psn-org = cur-clmnbr-psn-org:label
         sort-clmnbr-psn-org  = cur-clmnbr-psn-org
         sort-clmnbr-psn-org:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-psn-org = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-psn-org:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-psn-org then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-psn-org = cur-clmn-locbr-psn-org + 1
    .
  end.
  case sort-labelbr-psn-org:
        when 'Код'  then DO:   assign     sort-column-name = "X_firm.firm-code"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Название фирмы'  then DO:   assign     sort-column-name = "get-firm-name( X_firm.firm-code )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Страна, город'  then DO:   assign     sort-column-name = "X_firm.city"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Юридический Адрес'  then DO:   assign     sort-column-name = "TRIM( X_firm.addres1 ) + ' ':U + TRIM( X_firm.addres2 )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Почтовый Адрес'  then DO:   assign     sort-column-name = "TRIM( X_firm.post-addr1 ) + ' ':U + TRIM( X_firm.post-addr2 )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Индекс'  then DO:   assign     sort-column-name = "X_firm.ind"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'ИНН'  then DO:   assign     sort-column-name = "X_firm.inn"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'КПП'  then DO:   assign     sort-column-name = "X_firm.kpp"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'ОКОНХ'  then DO:   assign     sort-column-name = "X_firm.okonh"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'ОКПО'  then DO:   assign     sort-column-name = "X_firm.okpo"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Руководитель'  then DO:   assign     sort-column-name = "X_firm.director"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Главный бухгалтер'  then DO:   assign     sort-column-name = "X_firm.gen-acct"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Факс'  then DO:   assign     sort-column-name = "X_firm.fax"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Телефон'  then DO:   assign     sort-column-name = "X_firm.phone"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Примечание'  then DO:   assign     sort-column-name = "X_firm.phone1-note"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
        when 'Лимит кредита'  then DO:   assign     sort-column-name = "get-limkr( X_firm.firm-code )"   .   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).
        if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-psn-org') then do:
          run mv-brw-defaultbr-psn-org.
        end.
      if sort-labelbr-psn-org <> "" then do:
        assign
          cur-clmnbr-psn-org:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-psn-org = ?
      .
    end.
  end case.
  if p-recid <> ? then do:
    reposition br-psn-org to recid p-recid no-error.
    apply "value-changed" to br-psn-org in frame Dialog-Frame.
  end.
  apply "entry" to br-psn-org in frame Dialog-Frame.
END PROCEDURE.
procedure re-open-query-srt-clmnbr-psn-org:
if cur-clmnbr-psn-org = ? then do:
   RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U ).
end.
else do:
   assign re-querybr-psn-org = yes.
   run sort-brbr-psn-org
     (input (if available X_firm
             then recid(X_firm)
             else ?
            )
     ).
   assign re-querybr-psn-org = no.
end.
