DEF VAR cur-clmn-numbr-psn-org as INT EXTENT 16 no-undo.
DEF VAR varmvibr-psn-org       as INT no-undo.
DEF VAR varmvjbr-psn-org       as INT no-undo.
DEF VAR varmvkbr-psn-org       as INT no-undo.
DEF VAR varmvlbr-psn-org       as INT no-undo.
DEF VAR move-elementbr-psn-org as INT no-undo.
def var jjbr-psn-org           as int no-undo.
do varmvibr-psn-org = 1 to EXTENT(cur-clmn-numbr-psn-org):
  ASSIGN cur-clmn-numbr-psn-org[varmvibr-psn-org] = varmvibr-psn-org.
END.
RUN start-mv-clmnbr-psn-org.
PROCEDURE start-mv-clmnbr-psn-org:
def var old-session as logical no-undo.
   old-session = SESSION:IMMEDIATE-DISPLAY.
   IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
   SESSION:IMMEDIATE-DISPLAY = old-session.
END.
ON ctrl-cursor-right OF BROWSE br-psn-org do:
  RUN re-move-clmnbr-psn-org ( 1, 16).
END.
ON ctrl-cursor-left OF BROWSE br-psn-org do:
  RUN re-move-clmnbr-psn-org (16, 1).
END.
PROCEDURE re-move-clmnbr-psn-org:
  DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
  DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
  DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
    if cur-clmn-numbr-psn-org[varmvibr-psn-org] = source-column THEN cur-clmn-numbr-psn-org[varmvibr-psn-org] = -1.
  END.
  if br-psn-org:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
  if source-column > target-column THEN
  DO varmvjbr-psn-org = source-column - 1 to target-column BY -1:
    DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
        if cur-clmn-numbr-psn-org[varmvibr-psn-org] = varmvjbr-psn-org THEN DO:
          cur-clmn-numbr-psn-org[varmvibr-psn-org] = cur-clmn-numbr-psn-org[varmvibr-psn-org] + 1.
        END.
    END.
  END.
  ELSE
  DO varmvjbr-psn-org = source-column + 1 to target-column:
    DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
      if cur-clmn-numbr-psn-org[varmvibr-psn-org] = varmvjbr-psn-org THEN DO:
        cur-clmn-numbr-psn-org[varmvibr-psn-org] = cur-clmn-numbr-psn-org[varmvibr-psn-org] - 1.
      END.
    END.
  END.
  DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
    if cur-clmn-numbr-psn-org[varmvibr-psn-org] = -1 THEN cur-clmn-numbr-psn-org[varmvibr-psn-org] = target-column.
  END.
END PROCEDURE.
PROCEDURE ch-clmnbr-psn-org:
  DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
  if cur-clmn-loc <= 1 then do:
    return .
  end.
  DO varmvibr-psn-org = 1 TO EXTENT(cur-clmn-numbr-psn-org):
    if cur-clmn-numbr-psn-org[varmvibr-psn-org] = cur-clmn-loc THEN move-elementbr-psn-org = varmvibr-psn-org.
  END.
  RUN re-move-clmnbr-psn-org (cur-clmn-loc, 1).
END PROCEDURE.
PROCEDURE mv-brw-defaultbr-psn-org:
def var old-session as logical no-undo.
  old-session = SESSION:IMMEDIATE-DISPLAY.
  IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
  do varmvlbr-psn-org = 1 to EXTENT(cur-clmn-numbr-psn-org):
    RUN re-move-clmnbr-psn-org (cur-clmn-numbr-psn-org[varmvlbr-psn-org], varmvlbr-psn-org).
  END.
  RUN start-mv-clmnbr-psn-org.
  SESSION:IMMEDIATE-DISPLAY = old-session.
END PROCEDURE.
