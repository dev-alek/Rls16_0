              , 'стоп-карта;стоп-клиент':U)
    view-as alert-box .
    run ref/stop-ls.w ( input parparentproc
                    ,input "b-sel"
                    ,input 'все':U
                    ,input-output v-loc-rid-list) no-error.
    if v-loc-rid-list = "":U then undo, return error .
    run waitfram-show in this-procedure ( "Ждите..." ).
