PROCEDURE sort-brbr-obj-hist :
  define input parameter p-recid as recid no-undo .
  if re-querybr-obj-hist = no then do:
    assign
       cur-clmnbr-obj-hist = br-obj-hist:current-column in frame Dialog-Frame
    .
    if sort-clmnbr-obj-hist <> ? then sort-clmnbr-obj-hist:column-fgcolor = 0.
    if cur-clmnbr-obj-hist = sort-clmnbr-obj-hist then do:
      assign
         sort-labelbr-obj-hist = ""
         sort-clmnbr-obj-hist = ?
      .
     end.
     else do:
       assign
         sort-labelbr-obj-hist = cur-clmnbr-obj-hist:label
         sort-clmnbr-obj-hist  = cur-clmnbr-obj-hist
         sort-clmnbr-obj-hist:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-obj-hist = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-obj-hist:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-obj-hist then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-obj-hist = cur-clmn-locbr-obj-hist + 1
    .
  end.
  case sort-labelbr-obj-hist:
        when X_c-obj-hist.corr-date:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-date"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
        when X_c-obj-hist.corr-user-db-num:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-user-db-num"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr(yes, no, no, v-corr-user-db-num).
        if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-obj-hist') then do:
          run mv-brw-defaultbr-obj-hist.
        end.
      if sort-labelbr-obj-hist <> "" then do:
        assign
          cur-clmnbr-obj-hist:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-obj-hist = ?
      .
    end.
  end case.
    if cur-clmn-locbr-obj-hist <> ? then do:
      if can-do( this-procedure:internal-entries, 'ch-clmnbr-obj-hist') then do:
        run ch-clmnbr-obj-hist in this-procedure (cur-clmn-locbr-obj-hist).
      end.
    end.
  if p-recid <> ? then do:
    reposition br-obj-hist to recid p-recid no-error.
    apply "value-changed" to br-obj-hist in frame Dialog-Frame.
  end.
  apply "entry" to br-obj-hist in frame Dialog-Frame.
END PROCEDURE.
