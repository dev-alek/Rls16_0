def var sort-clmnbr-prop-ref    as handle    no-undo .
def var cur-clmnbr-prop-ref     as handle    no-undo .
def var cur-clmn-locbr-prop-ref as integer   no-undo .
def var re-querybr-prop-ref     as logical   initial no no-undo .
on start-search, ctrl-o of br-prop-ref in frame Dialog-Frame do:
   run sort-brbr-prop-ref
     (input (if available X_prop-ref
             then recid(X_prop-ref)
