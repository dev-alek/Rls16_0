PROCEDURE sort-brbr-prop-ref :
  define input parameter p-recid as recid no-undo .
  if re-querybr-prop-ref = no then do:
    assign
       cur-clmnbr-prop-ref = br-prop-ref:current-column in frame Dialog-Frame
    .
    if sort-clmnbr-prop-ref <> ? then sort-clmnbr-prop-ref:column-fgcolor = 0.
    if cur-clmnbr-prop-ref = sort-clmnbr-prop-ref then do:
      assign
         sort-labelbr-prop-ref = ""
         sort-clmnbr-prop-ref = ?
      .
     end.
     else do:
       assign
         sort-labelbr-prop-ref = cur-clmnbr-prop-ref:label
         sort-clmnbr-prop-ref  = cur-clmnbr-prop-ref
         sort-clmnbr-prop-ref:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-prop-ref = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-prop-ref:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-prop-ref then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-prop-ref = cur-clmn-locbr-prop-ref + 1
    .
  end.
  case sort-labelbr-prop-ref:
        when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(X_prop-ref), &1&2&1)', chr(34), v-rid-list)     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Идентификатор!итога'  then DO:    assign       sort-column-name = "X_prop-ref.sum-id"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Код!итога'  then DO:    assign       sort-column-name = "X_prop-ref.dt-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Код!объекта!операнда'  then DO:    assign       sort-column-name = "X_prop-ref.dtm-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Доп!идентификатор'  then DO:    assign       sort-column-name = "X_prop-ref.caller_id"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Задействован'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1calldscr&1, X_prop-ref.call_id)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Описание'  then DO:    assign       sort-column-name = "proprefd_sum-id-des(X_prop-ref.sum-id, X_prop-ref.ref-type)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
        when 'Код-операнд'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-dtm-name&1, X_prop-ref.dtm-code)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U) .   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr in this-procedure ( input yes, input no, input '':U).
      if sort-labelbr-prop-ref <> "" then do:
        assign
          cur-clmnbr-prop-ref:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-prop-ref = ?
      .
    end.
  end case.
  if p-recid <> ? then do:
    reposition br-prop-ref to recid p-recid no-error.
    apply "value-changed" to br-prop-ref in frame Dialog-Frame.
  end.
  apply "entry" to br-prop-ref in frame Dialog-Frame.
END PROCEDURE.
procedure re-open-query-srt-clmnbr-prop-ref:
if cur-clmnbr-prop-ref = ? then do:
   run OpenBr in this-procedure ( input yes, input no, input '':U).
end.
else do:
   assign re-querybr-prop-ref = yes.
   run sort-brbr-prop-ref
     (input (if available X_prop-ref
             then recid(X_prop-ref)
             else ?
            )
     ).
   assign re-querybr-prop-ref = no.
end.
