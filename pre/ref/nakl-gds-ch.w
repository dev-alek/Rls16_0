  .
end.
      v-log = br-gds:refresh() .
      if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
        v-log = br-gds:select-next-row ().
        apply "iteration-changed" to br-gds in frame Dialog-Frame.
      end.
    end.
    apply "entry" to br-gds in frame Dialog-Frame.
