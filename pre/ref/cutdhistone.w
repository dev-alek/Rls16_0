PROCEDURE re-move-clmnbr-obj-hist:
  DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
  DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
  DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
    if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = source-column THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1.
  END.
  if br-obj-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
  if source-column > target-column THEN
  DO varmvjbr-obj-hist = source-column - 1 to target-column BY -1:
    DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
        if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
          cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] + 1.
        END.
    END.
  END.
  ELSE
  DO varmvjbr-obj-hist = source-column + 1 to target-column:
    DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
      if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
        cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] - 1.
      END.
    END.
  END.
  DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
    if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1 THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = target-column.
  END.
END PROCEDURE.
PROCEDURE ch-clmnbr-obj-hist:
  DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
  if cur-clmn-loc <= 1 then do:
    return .
  end.
  DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
    if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-loc THEN move-elementbr-obj-hist = varmvibr-obj-hist.
  END.
  RUN re-move-clmnbr-obj-hist (cur-clmn-loc, 1).
END PROCEDURE.
