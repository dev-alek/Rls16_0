    when 'action-role':U or
    when "":U then
        do:
            run action-role-proc in this-procedure(output p-description) no-error .
        end.
    when 'action-role-item':U then
        do:
            run action-role-item-proc in this-procedure(output p-description) no-error .
        end.
END CASE.
