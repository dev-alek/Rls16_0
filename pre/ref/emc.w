PROCEDURE enable_UI :
  enable
    BROWSE-5
    b-exit
    b-add2
    b-sel
    when imode eq 'ВЫБОР':U
    b-add
    when imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
    b-del
    when imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
