def var sort-clmnbr-exmark    as handle    no-undo .
def var cur-clmnbr-exmark     as handle    no-undo .
def var cur-clmn-locbr-exmark as integer   no-undo .
def var re-querybr-exmark     as logical   initial no no-undo .
on start-search, ctrl-o of br-exmark in frame Dialog-Frame do:
   run sort-brbr-exmark
     (input (if available buf_ex-mark
             then recid(buf_ex-mark)
             else ?
            )
     ).
end.
PROCEDURE sort-brbr-exmark :
  define input parameter p-recid as recid no-undo .
  if re-querybr-exmark = no then do:
    assign
       cur-clmnbr-exmark = br-exmark:current-column in frame Dialog-Frame
    .
    if sort-clmnbr-exmark <> ? then sort-clmnbr-exmark:column-fgcolor = 0.
    if cur-clmnbr-exmark = sort-clmnbr-exmark then do:
      assign
         sort-labelbr-exmark = ""
         sort-clmnbr-exmark = ?
      .
     end.
     else do:
       assign
         sort-labelbr-exmark = cur-clmnbr-exmark:label
         sort-clmnbr-exmark  = cur-clmnbr-exmark
         sort-clmnbr-exmark:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-exmark = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-exmark:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-exmark then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-exmark = cur-clmn-locbr-exmark + 1
    .
  end.
  case sort-labelbr-exmark:
        when 'Код марки'  then DO:   assign     sort-column-name = "buf_ex-mark.mark-name"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
        when 'Тип'  then DO:   assign     sort-column-name = "dynamic-function ('exmrklib_get-type-name', buf_ex-mark.mark-type)"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
        when 'Статус'  then DO:   assign     sort-column-name = "dynamic-function ('exmrklib_get-status-name' , buf_ex-mark.stts)"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
        when 'БД создания'  then DO:   assign     sort-column-name = "buf_ex-mark.db-num"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
        when 'Внутренний код'  then DO:   assign     sort-column-name = "buf_ex-mark.mark-code"   .   run OpenBr in this-procedure (yes, no, '':U).   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr in this-procedure (yes, no, '':U).
      if sort-labelbr-exmark <> "" then do:
        assign
          cur-clmnbr-exmark:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-exmark = ?
      .
    end.
  end case.
  if p-recid <> ? then do:
    reposition br-exmark to recid p-recid no-error.
    apply "value-changed" to br-exmark in frame Dialog-Frame.
  end.
  apply "entry" to br-exmark in frame Dialog-Frame.
END PROCEDURE.
procedure re-open-query-srt-clmnbr-exmark:
if cur-clmnbr-exmark = ? then do:
   run OpenBr in this-procedure (yes, no, '':U).
end.
else do:
   assign re-querybr-exmark = yes.
   run sort-brbr-exmark
     (input (if available buf_ex-mark
             then recid(buf_ex-mark)
             else ?
            )
     ).
   assign re-querybr-exmark = no.
end.
end.
ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
MAIN-BLOCK:
DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
  run mainmenu_getcntxt in parParentProc
    (output v-cntxt-db-num
    ,output v-cntxt-userid
    ,output v-cntxt-level
    ,output v-cntxt-host-code-obj
    ,output v-cntxt-obj-type
    ,output v-cntxt-obj-code
    ,output v-cntxt-db-num-obj
    ,output v-cntxt-is-admin
    ) .
    RUN MyEnable in this-procedure.
    RUN OpenBR in this-procedure (yes, no, '':U).
    if p-rid-list <> "":U and p-rid-list <> ? then do:
      assign
        v-cur-recid = integer(entry (1, p-rid-list))
      .
      find buf_ex-mark no-lock where recid(buf_ex-mark) = v-cur-recid no-error.
      if available buf_ex-mark and
         buf_ex-mark.stts = integer('0':U)
      then do:
        reposition br-exmark to recid v-cur-recid no-error.
        if num-results("br-exmark") > 0 then do:
          br-exmark:select-focused-row( ).
        end.
      end.
    end.
    apply "entry" to br-exmark in frame Dialog-Frame.
    WAIT-FOR GO OF FRAME Dialog-Frame.
END.
RUN my-disable IN THIS-PROCEDURE.
PROCEDURE disable_UI :
  HIDE FRAME Dialog-Frame.
END PROCEDURE.
PROCEDURE my-disable :
    delete object f-query.
    delete object h-query.
    RUN DISABLE_UI IN THIS-PROCEDURE.
END PROCEDURE.
PROCEDURE MyEnable :
  assign
    r-stts:radio-buttons in frame Dialog-Frame =
               "Текущие&+"   + chr(44) + '0':U + chr(44) +
               "Все&!"       + chr(44) + "2" + chr(44) +
               "Удаленные&-" + chr(44) + '1':U
  .
  display r-stts
    with frame Dialog-Frame.
  ENABLE
      b-exit
      b-add WHEN  (lookup  ( "b-add" , bttns) > 0)
      b-sel WHEN  (lookup  ( "b-sel" , bttns) > 0)
      b-upd WHEN  (lookup  ( "b-add" , bttns) > 0)
      b-del WHEN  (lookup  ( "b-add" , bttns) > 0)
      b-help
      b-hist
      r-type
      r-stts
      sch-code
      br-exmark
    WITH FRAME Dialog-Frame.
END PROCEDURE.
PROCEDURE OpenBR :
  define input  parameter p-open-query     as logical   no-undo .
  define input  parameter p-find-next      as logical   no-undo .
  define input  parameter p-find-condition as character no-undo .
  define variable v-query-prefix   as character no-undo.
  define variable v-query-where    as character no-undo.
  define variable v-query-by       as character no-undo.
  define variable v-query-text     as character no-undo.
  define variable v-find-text      as character no-undo.
  define variable l-rec-found      as logical   no-undo.
  v-mark-type = get-type-by-filter (r-type).
  v-stts = get-stts-by-filter (r-stts).
  assign
    v-query-prefix = "for each buf_ex-mark no-lock":U
    v-query-where = "":U
    v-query-by    = "":U
    v-query-text  = "":U
  .
  if v-mark-type <> ? then do :
    assign
      v-query-where = substitute ("buf_ex-mark.mark-type = &1":U, v-mark-type)
    .
  end.
  if v-stts <> ? then do:
    assign
      v-query-where = (if v-query-where <> "":U then v-query-where + " and ":U else "":U)
                    + substitute ("buf_ex-mark.stts = &1":U, v-stts)
    .
  end.
  if v-query-where <> "":U then do:
    assign
      v-query-where = " where ":U + v-query-where
    .
  end.
  if sort-column-name = "":U or sort-column-name = "buf_ex-mark.mark-name":U then do:
    assign
      v-query-by = " by buf_ex-mark.mark-name":U
    .
  end.
  else do:
    assign
      v-query-by = " by ":U + sort-column-name
                 + " by buf_ex-mark.mark-name":U
    .
  end.
  assign
    v-query-text = v-query-prefix
                 + v-query-where
                 + v-query-by
                 + " indexed-reposition":U
  .
  run waitfram-show in this-procedure ("Подождите...").
  if p-open-query then do:
    if h-query:query-prepare(v-query-text) then do:
      h-query:query-open().
    end.
    else do:
      message
        "Ошибка при фильтрации / сортировке" skip
        "Будут показаны записи без учета фильтра" skip
        view-as alert-box .
      open query br-exmark
       for each buf_ex-mark no-lock
           by buf_ex-mark.mark-name indexed-reposition.
    end.
  end.
  else do:
    assign
      l-rec-found = no
      v-find-text = v-query-prefix
                  + v-query-where
                  + (if v-query-where <> "":U then " and ":U else "":U)
                  + p-find-condition
                  + v-query-by
                  + " indexed-reposition":U
      v-find-text = replace (v-find-text, "buf_ex-mark":U, "sch_ex-mark":U)
    .
    f-query:set-buffers(buffer sch_ex-mark:handle).
    if f-query:query-prepare(v-find-text) then do:
      f-query:query-open().
      f-query:get-first().
      if available sch_ex-mark then do:
        if p-find-next and available buf_ex-mark then do:
          if f-query:reposition-to-rowid (rowid(buf_ex-mark)) then do:
            f-query:get-next().
            if f-query:get-next() then do:
              l-rec-found = yes.
            end.
          end.
        end.
        else do:
          l-rec-found = yes.
        end.
      end.
      if l-rec-found then do:
        v-cur-recid = recid(sch_ex-mark).
        reposition br-exmark to recid v-cur-recid no-error.
        if num-results("br-exmark") > 0 then do:
          br-exmark:select-focused-row( ) in frame Dialog-Frame.
        end.
      end.
    end.
    else do:
      message
        vss-workfile vss-revision vss-description skip
        "Ошибка при формировании запроса для поиска" skip(1)
        v-find-text
        view-as alert-box warning.
    end.
  end.
  run waitfram-hide in this-procedure .
END PROCEDURE.
PROCEDURE proc-b-hist :
  run ref/ex-markh.w ( input parparentproc
                     , rowid( buf_ex-mark )
                     ) .
END PROCEDURE.
PROCEDURE proc-find :
  define input parameter p-find-next as logical   no-undo.
  define input parameter p-code      as character no-undo.
  define variable v-find-condition as character no-undo.
  assign
    v-find-condition = substitute (" buf_ex-mark.mark-name begins '&1' ", p-code)
  .
  run OpenBR in this-procedure
    (input no
    ,input p-find-next
    ,input v-find-condition
    ).
END PROCEDURE.
FUNCTION get-stts-by-filter RETURNS INTEGER
  ( input p-filter-stts as integer ) :
  define variable ret    as integer no-undo .
  if p-filter-stts = integer('0':U) or
     p-filter-stts = integer('1':U) then do:
    assign
      ret = p-filter-stts
    .
  end.
  else do:
    assign
      ret = ?
    .
  end.
  return ret .
END FUNCTION.
FUNCTION get-type-by-filter RETURNS INTEGER
  ( input p-filter-type as integer ) :
  define variable ret    as integer no-undo .
  case p-filter-type:
      when 1 then ret = 0.
      when 2 then ret = 1.
      otherwise   ret = ?.
  end case.
  return ret .
END FUNCTION.
