def var sort-labelbr-c-scales-gds   as character no-undo .
def var sort-clmnbr-c-scales-gds    as handle    no-undo .
def var cur-clmnbr-c-scales-gds     as handle    no-undo .
def var cur-clmn-locbr-c-scales-gds as integer   no-undo .
def var re-querybr-c-scales-gds     as logical   initial no no-undo .
on start-search, ctrl-o of br-c-scales-gds in frame Dialog-Frame do:
   run sort-brbr-c-scales-gds
     (input (if available X_c-scales-gds
             then recid(X_c-scales-gds)
             else ?
            )
     ).
end.
PROCEDURE sort-brbr-c-scales-gds :
  define input parameter p-recid as recid no-undo .
  if re-querybr-c-scales-gds = no then do:
    assign
       cur-clmnbr-c-scales-gds = br-c-scales-gds:current-column in frame Dialog-Frame
    .
    if sort-clmnbr-c-scales-gds <> ? then sort-clmnbr-c-scales-gds:column-fgcolor = 0.
    if cur-clmnbr-c-scales-gds = sort-clmnbr-c-scales-gds then do:
      assign
         sort-labelbr-c-scales-gds = ""
         sort-clmnbr-c-scales-gds = ?
      .
     end.
     else do:
       assign
         sort-labelbr-c-scales-gds = cur-clmnbr-c-scales-gds:label
         sort-clmnbr-c-scales-gds  = cur-clmnbr-c-scales-gds
         sort-clmnbr-c-scales-gds:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-c-scales-gds = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-c-scales-gds:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-c-scales-gds then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-c-scales-gds = cur-clmn-locbr-c-scales-gds + 1
    .
  end.
  case sort-labelbr-c-scales-gds:
        when X_c-scales-gds.corr-date:label in browse br-c-scales-gds then DO:    assign       sort-column-name = "X_c-scales-gds.corr-date"     .     run OpenBr in this-procedure ( INPUT yes, input no, input '':U).   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr in this-procedure  ( INPUT yes, input no, input '':U).
      if sort-labelbr-c-scales-gds <> "" then do:
        assign
          cur-clmnbr-c-scales-gds:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-c-scales-gds = ?
      .
    end.
  end case.
  if p-recid <> ? then do:
    reposition br-c-scales-gds to recid p-recid no-error.
    apply "value-changed" to br-c-scales-gds in frame Dialog-Frame.
  end.
  apply "entry" to br-c-scales-gds in frame Dialog-Frame.
END PROCEDURE.
procedure re-open-query-srt-clmnbr-c-scales-gds:
if cur-clmnbr-c-scales-gds = ? then do:
   run OpenBr in this-procedure  ( INPUT yes, input no, input '':U).
end.
else do:
   assign re-querybr-c-scales-gds = yes.
   run sort-brbr-c-scales-gds
     (input (if available X_c-scales-gds
             then recid(X_c-scales-gds)
             else ?
            )
     ).
   assign re-querybr-c-scales-gds = no.
end.
end.
