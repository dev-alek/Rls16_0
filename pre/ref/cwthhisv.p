 + "par-val" + chr(4) + "Номинал" + chr(4) + "" + chr(8)
 + "wth-code" + chr(4) + "Код МЦ" + chr(4) + ""  .
 run proc-full-temp-changes in this-procedure ( input (buf_c-wth-hist.action = 1 )
                                             ,input (buf_c-wth-hist.action = 99 )
                                            ,input  buffer current_c-wth-par:handle
