 + "wth-name" + chr(4) + "Название" + chr(4) + ""  + chr(8)
 + "is-ser" + chr(4) + "Серийный" + chr(4) + ""
  .
 run proc-full-temp-changes in this-procedure (input (buf_c-wth-hist.action = 1 )
                                             ,input (buf_c-wth-hist.action = 99 )
                                            ,input  buffer current_c-wealth:handle
                                            ,input  'wealth':U
