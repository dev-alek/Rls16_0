PROCEDURE proc-view-changes :
define buffer new_c-fin-code-cor-acc for ub.c-fin-code-cor-acc.
define buffer current_fin-code-cor-acc for ub.fin-code-cor-acc.
define variable v-chg-fields as character no-undo.
define variable v-old-fields as character no-undo.
define variable v-new-fields as character no-undo.
define variable ii as integer no-undo.
for each temp-changes:
    delete temp-changes.
END.
if not available buf_c-fin-code-cor-acc then do:
  Open QUery br-changes for each temp-changes.
  return.
end.
find first new_c-fin-code-cor-acc no-lock where
            new_c-fin-code-cor-acc.host-code = buf_c-fin-code-cor-acc.host-code
       AND new_c-fin-code-cor-acc.fin-code  = buf_c-fin-code-cor-acc.fin-code
       AND new_c-fin-code-cor-acc.chip-num  > buf_c-fin-code-cor-acc.chip-num no-error.
if not available new_c-fin-code-cor-acc then do:
    find first current_fin-code-cor-acc no-lock where
               current_fin-code-cor-acc.host-code = buf_c-fin-code-cor-acc.host-code
           AND current_fin-code-cor-acc.fin-code  = buf_c-fin-code-cor-acc.fin-code no-error.
         if not available current_fin-code-cor-acc then do:
         return error.
    end.
    buffer-compare current_fin-code-cor-acc to buf_c-fin-code-cor-acc
    save result in v-chg-fields.
end.
else do:
    buffer-compare new_c-fin-code-cor-acc except chip-num corr-date corr-user-name corr-user-db-num to buf_c-fin-code-cor-acc
    save result in v-chg-fields.
end.
do ii = 1 to num-entries(v-chg-fields):
CASE entry(ii, v-chg-fields):
when "code-value":U then do:     create temp-changes.     assign     temp-changes.f_name = "code-value":U     temp-changes.l_name = "Значение"     temp-changes.v_old = string(buf_c-fin-code-cor-acc.code-value)     temp-changes.v_new = (if available new_c-fin-code-cor-acc                               then string(new_c-fin-code-cor-acc.code-value)                               else string(current_fin-code-cor-acc.code-value))     .   end.
when "descr":U then do:     create temp-changes.     assign     temp-changes.f_name = "descr":U     temp-changes.l_name = "Описание"     temp-changes.v_old = string(buf_c-fin-code-cor-acc.descr)     temp-changes.v_new = (if available new_c-fin-code-cor-acc                               then string(new_c-fin-code-cor-acc.descr)                               else string(current_fin-code-cor-acc.descr))     .   end.
when "fin-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "fin-code":U     temp-changes.l_name = "Вн.Номер"     temp-changes.v_old = string(buf_c-fin-code-cor-acc.fin-code)     temp-changes.v_new = (if available new_c-fin-code-cor-acc                               then string(new_c-fin-code-cor-acc.fin-code)                               else string(current_fin-code-cor-acc.fin-code))     .   end.
when "level-1":U then do:     create temp-changes.     assign     temp-changes.f_name = "level-1":U     temp-changes.l_name = "Уровень1"     temp-changes.v_old = string(buf_c-fin-code-cor-acc.level-1)     temp-changes.v_new = (if available new_c-fin-code-cor-acc                               then string(new_c-fin-code-cor-acc.level-1)                               else string(current_fin-code-cor-acc.level-1))     .   end.
