PROCEDURE sort-brBR-gds :
  define input parameter p-recid as recid no-undo .
  if re-queryBR-gds = no then do:
    assign
       cur-clmnBR-gds = BR-gds:current-column in frame Dialog-Frame
    .
    if sort-clmnBR-gds <> ? then sort-clmnBR-gds:column-fgcolor = 0.
    if cur-clmnBR-gds = sort-clmnBR-gds then do:
      assign
         sort-labelBR-gds = ""
         sort-clmnBR-gds = ?
      .
     end.
     else do:
       assign
         sort-labelBR-gds = cur-clmnBR-gds:label
         sort-clmnBR-gds  = cur-clmnBR-gds
         sort-clmnBR-gds:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locBR-gds = 1
  .
  def var column-handle as handle no-undo .
  column-handle = BR-gds:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnBR-gds then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locBR-gds = cur-clmn-locBR-gds + 1
    .
  end.
  case sort-labelBR-gds:
        when  X_goods.artic :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.artic "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
        when  X_goods.gds-code :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.gds-code "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
        when  X_goods.gds-name :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.gds-name "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
        when  X_goods.grp-name :label in browse BR-gds then DO:    assign       sort-column-name = " X_goods.grp-name "     .     run OpenBr in this-procedure ( input yes, input no, input '':U).    . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr in this-procedure ( input yes, input no, input '':U).
        if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-gds') then do:
          run mv-brw-defaultBR-gds.
        end.
      if sort-labelBR-gds <> "" then do:
        assign
          cur-clmnBR-gds:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locBR-gds = ?
      .
    end.
  end case.
    if cur-clmn-locBR-gds <> ? then do:
      if can-do( this-procedure:internal-entries, 'ch-clmnBR-gds') then do:
        run ch-clmnBR-gds in this-procedure (cur-clmn-locBR-gds).
      end.
    end.
  if p-recid <> ? then do:
    reposition BR-gds to recid p-recid no-error.
    apply "value-changed" to BR-gds in frame Dialog-Frame.
  end.
  apply "entry" to BR-gds in frame Dialog-Frame.
END PROCEDURE.
procedure re-open-query-srt-clmnBR-gds:
if cur-clmnBR-gds = ? then do:
   run OpenBr in this-procedure ( input yes, input no, input '':U).
end.
else do:
