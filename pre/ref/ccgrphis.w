PROCEDURE sort-brbr-c-cli-grp :
  define input parameter p-recid as recid no-undo .
  if re-querybr-c-cli-grp = no then do:
    assign
       cur-clmnbr-c-cli-grp = br-c-cli-grp:current-column in frame Dialog-Frame
    .
    if sort-clmnbr-c-cli-grp <> ? then sort-clmnbr-c-cli-grp:column-fgcolor = 0.
    if cur-clmnbr-c-cli-grp = sort-clmnbr-c-cli-grp then do:
      assign
         sort-labelbr-c-cli-grp = ""
         sort-clmnbr-c-cli-grp = ?
      .
     end.
     else do:
       assign
         sort-labelbr-c-cli-grp = cur-clmnbr-c-cli-grp:label
         sort-clmnbr-c-cli-grp  = cur-clmnbr-c-cli-grp
         sort-clmnbr-c-cli-grp:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-c-cli-grp = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-c-cli-grp:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-c-cli-grp then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-c-cli-grp = cur-clmn-locbr-c-cli-grp + 1
    .
  end.
  case sort-labelbr-c-cli-grp:
        when X_c-cli-grp.corr-date:label in browse br-c-cli-grp then DO:    assign       sort-column-name = "X_c-cli-grp.corr-date"     .     run OpenBr in this-procedure.   . END.
        when X_c-cli-grp.corr-user-db-num:label in browse br-c-cli-grp then DO:    assign       sort-column-name = "X_c-cli-grp.corr-user-db-num"     .     run OpenBr in this-procedure.   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr in this-procedure.
      if sort-labelbr-c-cli-grp <> "" then do:
        assign
          cur-clmnbr-c-cli-grp:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-c-cli-grp = ?
      .
    end.
  end case.
  if p-recid <> ? then do:
    reposition br-c-cli-grp to recid p-recid no-error.
    apply "value-changed" to br-c-cli-grp in frame Dialog-Frame.
  end.
  apply "entry" to br-c-cli-grp in frame Dialog-Frame.
END PROCEDURE.
