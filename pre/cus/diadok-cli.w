    , FIRST X_clients NO-LOCK WHERE                                   X_clients.obj-type = ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)) AND                                   X_clients.obj-code = integer(ENTRY(3, X_eXt-classif.uniq-key-rec, chr(3)))
      INDEXED-REPOSITION
  .
      assign
