      string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
              ) .
end.
  end.
  else do:
  run prn-lib-prn-file in this-procedure ( input parParentProc, input 0  ).
