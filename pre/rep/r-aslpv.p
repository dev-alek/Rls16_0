        for first tt-chk where
                 tt-chk.note_ = "sum-report"
        no-lock:
            do:
                put stream OutStr-html unformatted
                    '       <tr level="1">' skip
                    '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold; padding-left: 0px">' +
