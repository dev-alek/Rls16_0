      string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
              ) .
end.
procedure round:
define input  parameter p-dec as decimal no-undo.
define output parameter p-int as decimal no-undo.
if p-dec - TRUNCATE (p-dec, 0) <> 0
then do:
    assign
      p-int = TRUNCATE (p-dec, 0) + 1
    .
end.
else do:
    assign
      p-int = p-dec
    .
end.
end procedure.
end.
