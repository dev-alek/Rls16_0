              WHEN 'wm':U
              THEN DO:
                   ASSIGN
                      tt-doc.outgo = tt-doc.outgo + buf_parts.fact-qnty * tt-alc-goods.ms-base
                      tt-doc.end-q = tt-doc.end-q - buf_parts.fact-qnty * tt-alc-goods.ms-base
