   assign
    Counter1 = 0
   .
   FOR EACH  tt-alc-goods EXCLUSIVE-LOCK,
       EACH  obj-list     NO-LOCK:
       DO v-doc-type = 1 TO NUM-ENTRIES(v-list-doc-type)
          :
          FOR EACH  buf_doc-line NO-LOCK
                                 WHERE buf_doc-line.artic        = tt-alc-goods.artic
