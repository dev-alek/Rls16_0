              output  Coast_V2   ,
              output  VAT_R2     ,
              output  VAT_V2     ,
              output  slt_R2     ,
              output  slt_V2     ).
          assign tt-gds-inv.ost = (Coast_R2 - VAT_R2)
                 tt-grp-inv.ost = tt-grp-inv.ost + tt-gds-inv.ost
