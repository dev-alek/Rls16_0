      DISPLAY stream PrnLibStream
      sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
      sym2 gds-zap.artic sym3 gds-zap.gds-name
      sym4 gds-zap.weight-bc
      sym5 free-clmn sym6
        sym7
        gds-zap.qnty
      with frame zapas .
      DOWN stream PrnLibStream
      1 with frame zapas .
    END.
  end.
  when "Classify_2" then do:
    FOR EACH gds-zap
    BREAK
    BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
    BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
      if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then  do:
        if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
            UNDERLINE stream PrnLibStream
            tb-code
            gds-zap.artic
            gds-zap.gds-name
            with frame zapas .
        end.
        DISPLAY stream PrnLibStream
        sym1
        "Производитель :" @ gds-zap.artic
        gds-zap.prod-name @ gds-zap.gds-name
        sym5 with frame zapas .
        DOWN stream PrnLibStream
        1 with frame zapas .
        UNDERLINE stream PrnLibStream
        tb-code
        gds-zap.artic
        gds-zap.gds-name
        with frame zapas .
      end.
      DISPLAY stream PrnLibStream
      sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
      sym2 gds-zap.artic sym3 gds-zap.gds-name
      sym4 gds-zap.weight-bc
      sym5 free-clmn sym6
        sym7
