    BREAK
    BY gds-zap.grp-name
    BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           )  :
      if first-of ( gds-zap.grp-name ) then do:
        if NOT first ( gds-zap.grp-name ) then do:
          UNDERLINE stream PrnLibStream
          tb-code
          gds-zap.artic
          gds-zap.gds-name
          with frame zapas .
        end.
        DISPLAY stream PrnLibStream
