    )  no-error.
    if not error-status:error then do:
      if num-entries(v-uf-List_, chr(4)) >= 17 then do:
        assign
          tog-weight                :screen-value in frame F-Main = entry(1, v-uf-List_, chr(4))
          tog-1-whole-gds           :screen-value in frame F-Main = entry(2, v-uf-List_, chr(4))
          tog-1-pump-one            :screen-value in frame F-Main = entry(3, v-uf-List_, chr(4))
          tog-2-cp-grp              :screen-value in frame F-Main = entry(4, v-uf-List_, chr(4))
          tog-1                     :screen-value in frame F-Main = entry(7, v-uf-List_, chr(4))
          tog-2                     :screen-value in frame F-Main = entry(8, v-uf-List_, chr(4))
          tog-3                     :screen-value in frame F-Main = entry(9, v-uf-List_, chr(4))
          tog-4                     :screen-value in frame F-Main = entry(10, v-uf-List_, chr(4))
          tog-5                     :screen-value in frame F-Main = entry(11, v-uf-List_, chr(4))
          tog-6                     :screen-value in frame F-Main = entry(12, v-uf-List_, chr(4))
          tog-7                     :screen-value in frame F-Main = entry(13, v-uf-List_, chr(4))
          tog-8                     :screen-value in frame F-Main = entry(14, v-uf-List_, chr(4))
          f-line-of-page            :screen-value in frame F-Main = entry(15, v-uf-List_, chr(4))
          tog-9                     :screen-value in frame F-Main = entry(16, v-uf-List_, chr(4))
          tog-10                    :screen-value in frame F-Main = entry(17, v-uf-List_, chr(4))
        .
      end.
      if num-entries(v-uf-List_, chr(4)) >= 20 then do:
        assign
          tog-81  :screen-value in frame F-Main = entry(19, v-uf-List_, chr(4))
          tog-82  :screen-value in frame F-Main = entry(20, v-uf-List_, chr(4))
        .
      end.
      assign
        v-init = true
      .
    end.
    if v-init = false then do:
      assign
        tog-1     :screen-value in frame F-Main = 'yes':u
        tog-2     :screen-value in frame F-Main = 'yes':u
        tog-3     :screen-value in frame F-Main = 'yes':u
        tog-4     :screen-value in frame F-Main = 'yes':u
        tog-5     :screen-value in frame F-Main = 'yes':u
        tog-6     :screen-value in frame F-Main = 'yes':u
        tog-7     :screen-value in frame F-Main = 'yes':u
        tog-8     :screen-value in frame F-Main = 'yes':u
        tog-9     :screen-value in frame F-Main = 'yes':u
        tog-10    :screen-value in frame F-Main = 'yes':u
        tog-81    :screen-value in frame F-Main = 'yes':u
        tog-82    :screen-value in frame F-Main = 'yes':u
      .
    end.
    if integer( f-line-of-page :screen-value in frame F-Main ) = 0
      or integer( f-line-of-page :screen-value in frame F-Main ) = ?
    then do:
      assign
        f-line-of-page :screen-value in frame F-Main = '43':U
      .
    end.
    assign
      classify = "no-classify":u
      var-level :screen-value in frame F-Main = '1':U
    .
    if is-wth = false then do:
      assign
        TOG-5 :screen-value in frame F-Main = 'no':u
      .
      hide tog-5 in frame F-Main.
      enable TOG-5-1 with frame F-Main.
    end.
    if is-elved = false then do:
      assign
        tog-8 :screen-value in frame F-Main = 'no':u
      .
      hide tog-8 in frame F-Main.
    end.
    IF NOT CAN-FIND( FIRST obj-list WHERE obj-list.obj-code = v-cntxt-obj-code AND obj-list.obj-type = v-cntxt-obj-type ) THEN DO:
define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
run create_obj-list in this-procedure
 ( input v-cntxt-obj-type ,
   input v-cntxt-obj-code )
   .
    END.
    RUN ini-from-selgds IN THIS-PROCEDURE.
    apply "value-changed":u to tog-1 in frame F-Main.
    apply "value-changed":u to tog-2 in frame F-Main.
    apply "value-changed":u to tog-3 in frame F-Main.
    apply "value-changed":u to tog-81 in frame F-Main.
  end.
end case.
END PROCEDURE.
PROCEDURE my-params :
define input parameter p-action as character no-undo .
DEFINE VARIABLE v-today as date no-undo .
DEFINE VARIABLE v-time as integer no-undo .
define variable v-obj-str as character no-undo .
define variable v-index-id as integer no-undo .
define variable v2-index-id as integer no-undo .
define variable v-value-character as character no-undo .
define variable v-value-date as date no-undo .
define variable v-value-decimal as decimal no-undo .
define variable v-value-integer as integer no-undo .
define variable v-value-logical as logical no-undo .
define variable v-last-shift as decimal no-undo .
define variable v-fact-order  as decimal no-undo .
define variable v-shift-end-fact-order as decimal no-undo .
define variable v-day-end-fact-order as decimal no-undo .
define variable v-rv as character no-undo .
CASE p-action :
  WHEN 'get' THEN DO:
    IF v-profile-id = 53  THEN DO:
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-esys-id"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-esys-id
                                         ,output v-value-logical
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-shift-days-to-report"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-shift-days-to-report
                                         ,output v-value-logical
                                         ) no-error .
      empty temp-table X-init_obj-list.
      v-index-id = 1.
      v2-index-id = 1.
      do while v-index-id >= 1 :
        RUN rcps_get-value IN parent-handle (
                                        input "p-objects"
                                        ,INPUT-output v-index-id
                                        ,output v-obj-str
                                        ,output v-value-date
                                        ,output v-value-decimal
                                        ,output v-value-integer
                                        ,output v-value-logical
                                        ) no-error .
        if error-status:error then leave.
        if v-obj-str = '' then leave.
        find first X-init_obj-list where
                  X-init_obj-list.obj-type = substring(v-obj-str, 1, 3)
              and  X-init_obj-list.obj-code = integer(substring(v-obj-str, 4)) no-error.
        if not available X-init_obj-list then do:
          create X-init_obj-list.
          assign
          X-init_obj-list.obj-type = substring(v-obj-str, 1, 3)
          X-init_obj-list.obj-code = integer(substring(v-obj-str, 4))
          .
          release X-init_obj-list.
        end.
        create last-shift.
        assign
        last-shift.obj-type = substring(v-obj-str, 1, 3)
        last-shift.obj-code = integer(substring(v-obj-str, 4))
        .
        run cur-time in this-procedure ( output v-today, output v-time).
        run factord in this-procedure
          (input  (v-today - v-shift-days-to-report)
          ,input  v-time
          ,input  1
          ,input  (v-today - v-shift-days-to-report)
          ,input  1
          ,input  yes
          ,output v-fact-order
          ,output v-shift-end-fact-order
          ,output v-day-end-fact-order
          ) no-error .
        RUN rcps_get-value IN parent-handle (
                                        input "last-shift"
                                        ,INPUT-output v2-index-id
                                        ,output v-value-character
                                        ,output v-value-date
                                        ,output v-last-shift
                                        ,output v-value-integer
                                        ,output v-value-logical
                                        ) no-error .
        if error-status:error
        and v-last-shift > 0
        then do:
          last-shift.fact-order = v-last-shift .
        end.
        else do:
          last-shift.fact-order = v-shift-end-fact-order.
        end.
        release last-shift.
        if v-index-id < 1
        then do:
          leave.
        end.
      end.
      X-selectobject =  "choice":U.
    END.
    IF v-profile-id = 68  THEN DO:
      define variable v-ii as integer no-undo .
      v-index-id = 0.
      do v-ii = 1 to 9 :
        v-index-id = v-ii.
        RUN rcps_get-value IN parent-handle (
                                        input "p-tog"
                                        ,INPUT-output v-index-id
                                        ,output v-value-character
                                        ,output v-value-date
                                        ,output v-value-decimal
                                        ,output v-value-integer
                                        ,output v-tog[v-ii]
                                        ) no-error .
        if error-status:error then leave.
      end.
      v-index-id = 0.
      RUN rcps_get-value IN parent-handle (
                                          input "p-weight"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-weight
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-classify"
                                         ,INPUT-output v-index-id
                                         ,output v-classify
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-value-logical
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-sorttype"
                                         ,INPUT-output v-index-id
                                         ,output v-sorttype
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-value-logical
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-level"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-level
                                         ,output v-value-logical
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-pump-one"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-pump-one
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-whole-gds"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-whole-gds
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-el-cnt"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-el-icnt
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-cp-grp"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-cp-grp
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-output-type"
                                         ,INPUT-output v-index-id
                                         ,output v-output-type
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-value-integer
                                         ,output v-value-logical
                                         ) no-error .
       v-index-id = 0.
       RUN rcps_get-value IN parent-handle (
                                          input "p-line-of-page"
                                         ,INPUT-output v-index-id
                                         ,output v-value-character
                                         ,output v-value-date
                                         ,output v-value-decimal
                                         ,output v-line-of-page
                                         ,output v-value-logical
                                         ) no-error .
    END.
    RUN local-initialize IN THIS-PROCEDURE.
  END.
  WHEN 'set' THEN DO:
    IF v-profile-id = 53 THEN DO:
      ASSIGN
      FRAME F-Main
      f-esys-id
      f-shift-days-to-report
      .
      RUN rcps_set-value IN parent-handle (
                                        input "p-esys-id"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input f-esys-id
                                      ,input no
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-shift-days-to-report"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input f-shift-days-to-report
                                      ,input no
                                      ) no-error .
      v-index-id = 0.
      for each obj-list :
        v-index-id = v-index-id + 1.
        RUN rcps_set-value IN parent-handle (
                                        input "p-objects"
                                        ,INPUT v-index-id
                                        ,input substitute("&1&2", obj-list.obj-type, obj-list.obj-code)
                                        ,input ?
                                        ,input 0.0
                                        ,input 0
                                        ,input no
                                        ) no-error .
        if error-status:error then do:
          message
          error-status:get-message(1) return-value
          view-as alert-box .
          undo, return error .
        end.
        find first last-shift where
                  last-shift.obj-type = obj-list.obj-type
              and last-shift.obj-code = obj-list.obj-code no-error.
        if available last-shift then do:
          RUN rcps_set-value IN parent-handle (
                                          input "p-last-shift"
                                          ,INPUT v-index-id
                                          ,input ''
                                          ,input ?
                                          ,input last-shift.fact-order
                                          ,input 0
                                          ,input no
                                          ) no-error .
        end.
      end.
      v-index-id = v-index-id + 1.
      do while true:
        run rcps_proc-b-del in parent-handle (
                                                input "p-objects"
                                              ,input v-index-id) no-error.
        v-rv = return-value .
        if error-status:error
        or v-rv = "not-found" then leave.
        run rcps_proc-b-del in parent-handle (
                                                input "p-last-shift"
                                              ,input v-index-id) no-error.
        v-index-id = v-index-id + 1.
      end.
      if error-status:error then do:
        message
        error-status:get-message(1) return-value
        view-as alert-box .
        undo, return error .
      end.
    END.
    IF v-profile-id = 68 THEN DO:
      ASSIGN
      FRAME F-Main
      tog-weight
      tog-1
      tog-1-whole-gds
      tog-1-pump-one
      tog-2
      tog-2-cp-grp
      tog-3
      tog-4
      tog-5
      tog-6
      tog-7
      tog-8
      tog-9
      tog-10
      f-line-of-page
      tog-1-out-pump-with-icnt
      classify
      var-level
      t-excel
      t-text
      v-tog[1] = tog-1
      v-tog[2] = tog-2
      v-tog[3] = tog-3
      v-tog[4] = tog-4
      v-tog[5] = tog-5
      v-tog[6] = tog-6
      v-tog[7] = tog-7
      v-tog[8] = tog-8
      v-tog[9] = tog-9
      v-tog[10] = tog-10
      v-output-type = ","
      ENTRY(1, v-output-type) = (IF t-excel THEN 'excel':U ELSE '')
      ENTRY(2, v-output-type) = (IF t-text THEN 'text':U ELSE '')
      v-output-type = TRIM(v-output-type, chr(44))
      .
      if not t-excel
      and not t-text then do:
        define variable glog as logical no-undo .
        message
        "Внимание!! Вы не выбрали ни вывод в текстовый файл, ни вывод в Excel!" skip
        "Продолжить?"
        view-as alert-box question buttons yes-no update glog.
        if not glog then return error.
      end.
      do v-ii = 1 to 9 :
        RUN rcps_set-value IN parent-handle (
                                        input "p-tog"
                                        ,INPUT v-ii
                                        ,input ''
                                        ,input ?
                                        ,input 0.0
                                        ,input 0
                                        ,input v-tog[v-ii]
                                        ) no-error .
        if error-status:error then do:
          message
          error-status:get-message(1) return-value
          view-as alert-box .
          undo, return error .
        end.
      end.
      RUN rcps_set-value IN parent-handle (
                                        input "p-weight"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input tog-weight
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-weight"
                                      ,INPUT 0
                                      ,input classify
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input no
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-sorttype"
                                      ,INPUT 0
                                      ,input sorttype
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input no
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-level"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input var-level
                                      ,input no
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-pump-one"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input tog-1-pump-one
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-whole-gds"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input tog-1-whole-gds
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-el-cnt"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input tog-1-out-pump-with-icnt
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-cp-grp"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input tog-2-cp-grp
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-output-type"
                                      ,INPUT 0
                                      ,input v-output-type
                                      ,input ?
                                      ,input 0.0
                                      ,input 0
                                      ,input no
                                      ) no-error .
      RUN rcps_set-value IN parent-handle (
                                        input "p-line-of-page"
                                      ,INPUT 0
                                      ,input ''
                                      ,input ?
                                      ,input 0.0
                                      ,input f-line-of-page
                                      ,input no
                                      ) no-error .
    END.
  END.
END CASE.
END PROCEDURE.
