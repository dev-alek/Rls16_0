      os-command silent value (v-arc + ' -size=128 -content="' + tt-marks.datamatrix + '"' + ' -filename="c:\temp\qr-code"' + string(tt-marks.ii)) .
      tt-marks.mark-level = "c:\temp\qr-code" + string(tt-marks.ii) + ".png" .
      jj = jj + 1 .
    end.
  end.
end.
