         , input 0
         , input 0
         , input IF (AVAIL doc-line) THEN doc-line.VAT-pc ELSE ?
         , input 0
         , input 0
         , input p-base-rate
         , input p-base-scale
         , input ( if tPrintRubl = yes then "rubl":U else "base":U )
         , input varcur-base
         , input varcur-road-tax
         , input varcur-excise
         , input varcur-vat-pc
         , input varcur-cons-vat-pc
