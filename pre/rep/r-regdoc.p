      first tt-gds
      where tt-gds.artic     = buf_parts.artic
        and tt-gds.prod-type = buf_parts.prod-type
        and tt-gds.prod-code = buf_parts.prod-code
      :
      for each buf_tt-clcparts
      on error undo, return error return-value
