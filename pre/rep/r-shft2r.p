procedure ot-lnrv:
define input  parameter parobj-type         like ub.clients.obj-type    no-undo.
define input  parameter parobj-code         like ub.clients.obj-code    no-undo.
define input  parameter parcli-type         like ub.clients.obj-type    no-undo.
define input  parameter parcli-code         like ub.clients.obj-code    no-undo.
define input  parameter parartic            like ub.goods.artic         no-undo.
define input  parameter parprod-type        like ub.goods.prod-type     no-undo.
define input  parameter parprod-code        like ub.goods.prod-code     no-undo.
define input  parameter parfact-order-start like ub.ot-line.fact-order no-undo.
define input  parameter parfact-order-end   like ub.ot-line.fact-order no-undo.
define input  parameter parsum-type         like ub.ot-line.sum-type   no-undo.
define input  parameter parcat-id           like ub.ot-line.cat-id     no-undo.
define output parameter table for tt-ot-line.
define variable varext-doc-type like ub.ot-line.ext-doc-type no-undo.
  FOR EACH ub.ot-line No-LOCK WHERE
            ub.ot-line.obj-type = parobj-type AND
            ub.ot-line.obj-code = parobj-code AND
            ub.ot-line.artic = parartic AND
            ub.ot-line.prod-type = parprod-type AND
            ub.ot-line.prod-code = parprod-code AND
            ub.ot-line.fact-order >= parfact-order-start AND
            ub.ot-line.fact-order <= parfact-order-end AND
            ub.ot-line.sum-type = parsum-type AND
            (parcat-id = ? OR ub.ot-line.cat-id = parcat-id),
      FIRST ub.trn-doc where
            ub.trn-doc.doc-code = ub.ot-line.doc-code AND
            ub.trn-doc.cli-type = parcli-type AND
            ub.trn-doc.cli-code = parcli-code:
    FIND FIRST tt-ot-line where
                tt-ot-line.obj-type       = parobj-type AND
                tt-ot-line.obj-code       = parobj-code AND
                tt-ot-line.artic          = parartic AND
                tt-ot-line.prod-type      = parprod-type AND
                tt-ot-line.prod-code      = parprod-code AND
                tt-ot-line.fact-order     = 0 AND
                tt-ot-line.sum-type       = parsum-type AND
                tt-ot-line.cat-id         = parcat-id AND
                tt-ot-line.ext-doc-type   = ub.ot-line.ext-doc-type AND
                tt-ot-line.cli-type       = parcli-type AND
                tt-ot-line.cli-code       = parcli-code
                No-ERROR.
    IF NOT AVAIL tt-ot-line  then do:
      create tt-ot-line.
      assign
      tt-ot-line.obj-type       = parobj-type
      tt-ot-line.obj-code       = parobj-code
      tt-ot-line.artic          = parartic
      tt-ot-line.prod-type      = parprod-type
      tt-ot-line.prod-code      = parprod-code
      tt-ot-line.cli-type       = parcli-type
      tt-ot-line.cli-code       = parcli-code
      tt-ot-line.sum-type       = parsum-type
      tt-ot-line.cat-id         = parcat-id
      tt-ot-line.ext-doc-type   = ub.ot-line.ext-doc-type
      .
    end.
    assign
    tt-ot-line.fact-qnty      = tt-ot-line.fact-qnty + ub.ot-line.fact-qnty
    tt-ot-line.sum-base       = tt-ot-line.sum-base + ub.ot-line.sum-base
    tt-ot-line.sum-rubl       = tt-ot-line.sum-rubl + ub.ot-line.sum-rubl
    tt-ot-line.SLT-base       = tt-ot-line.SLT-base + ub.ot-line.SLT-base
    tt-ot-line.SLT-rubl       = tt-ot-line.SLT-rubl + ub.ot-line.SLT-rubl
    tt-ot-line.VAT-base       = tt-ot-line.VAT-base + ub.ot-line.VAT-base
    tt-ot-line.VAT-rubl       = tt-ot-line.VAT-rubl + ub.ot-line.VAT-rubl
    tt-ot-line.excise-base    = tt-ot-line.excise-base + ub.ot-line.excise-base
    tt-ot-line.excise-rubl    = tt-ot-line.excise-rubl + ub.ot-line.excise-rubl
    tt-ot-line.other-base     = tt-ot-line.other-base + ub.ot-line.other-base
    tt-ot-line.other-rubl     = tt-ot-line.other-rubl + ub.ot-line.other-rubl
    tt-ot-line.road-tax-base  = tt-ot-line.road-tax-base + ub.ot-line.road-tax-base
    tt-ot-line.road-tax-rubl  = tt-ot-line.road-tax-rubl + ub.ot-line.road-tax-rubl
    tt-ot-line.transport-base = tt-ot-line.transport-base + ub.ot-line.transport-base
    tt-ot-line.transport-rubl = tt-ot-line.transport-rubl + ub.ot-line.transport-rubl
    .
   end.
end procedure.
