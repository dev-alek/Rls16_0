PROCEDURE gen-bc:
  def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
  def output parameter full-b-code     as character init ""    no-undo .
define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
  define variable tmp-str17  as character no-undo.
  define variable tmp-num17  as character no-undo.
  define variable i17        as integer   no-undo.
  define variable sum17      as integer   no-undo.
  define variable len-code17 as integer   no-undo.
  define variable varcont17  as logical   initial yes no-undo.
  CASE bc-frmt :
    WHEN "EAN13" THEN do:
      assign
        tmp-str17 = string( internal-b-code, "999999999999" )
      .
    end.
    WHEN "EAN8" THEN do:
      assign
        tmp-str17 = string( internal-b-code, "9999999" )
      .
    end.
    OTHERWISE DO:
        message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
        view-as alert-box error.
        return error.
    END.
  END CASE.
  if varcont17 = yes then do:
    if integer( substring( tmp-str17, 1, length( bc-pfx ) ) ) <> 0
    then do:
      message
        "Невозможно сформировать бар-код" SKIP
        "для товара с кодом: " internal-b-code
        view-as alert-box error title "подрезание кода".
      return error.
    end.
    else do:
      assign
        full-b-code = bc-pfx + substring( tmp-str17, length( bc-pfx ) + 1, length( tmp-str17 ) - length( bc-pfx ) )
        len-code17    = length( full-b-code )
      .
      define variable v-sum-char17 as character no-undo .
      assign
        sum17 = 0
      .
      do i17 = 1 to len-code17 by 2
      :
        assign
          v-sum-char17 = substr(full-b-code, len-code17 - i17 + 1, 1)
        .
        if v-sum-char17 < "0"
        or v-sum-char17 > "9"
        then do:
          message
            "Невозможно сформировать бар-код" skip
            "для товара с кодом: " internal-b-code skip
            view-as alert-box error title "подсчет контрольной суммы".
          return error.
        end.
        assign
          sum17 = sum17 + integer(v-sum-char17)
        .
      end.
      if varcont17 = yes then do:
        assign
          sum17 = sum17 * 3
        .
        do i17 = 2 to len-code17 by 2
        :
          assign
            v-sum-char17 = substr(full-b-code, len-code17 - i17 + 1, 1)
          .
          if v-sum-char17 < "0"
          or v-sum-char17 > "9"
          then do:
            message
              "Невозможно сформировать бар-код" skip
              "для товара с кодом: " internal-b-code skip
              view-as alert-box error title "подсчет контрольной суммы".
            return error.
          end.
          assign
            sum17 = sum17 + integer(v-sum-char17)
          .
        end.
        if varcont17 = yes then do:
           if sum17 mod 10 = 0 then do:
             assign
               full-b-code = full-b-code + '0'
             .
           end.
           else do:
             assign
               full-b-code = full-b-code + string(10 - sum17 mod 10)
             .
           end.
        end.
      end.
    end.
  end.
END PROCEDURE.
