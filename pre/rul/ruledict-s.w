PROCEDURE proc-b-link :
define variable v-rid-list as character no-undo .
DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
define variable v-rec as recid no-undo .
define variable v-dtm-code as integer no-undo .
define variable v-node-code as integer no-undo .
define variable v-language as character no-undo .
define variable v-script-name as character no-undo .
define variable v-dt-code as integer no-undo .
define variable v-revis-id as integer no-undo .
define variable v-rule-id as integer no-undo .
define variable v-field-list as character no-undo .
define variable v-value-list as character no-undo .
define buffer buf_ruledict-param for ub.ruledict-param.
CASE p-option:
  WHEN 'ruledict-param':U THEN DO:
    find first buf_ruledict-param no-lock where
              buf_ruledict-param.entry-id = X_ruledict.entry-id no-error.
    if not available buf_ruledict-param then do:
      message
      "Нет параметров!"
      view-as alert-box error .
      undo, return error .
    end.
    run rul/ruledict-param-s.w ( INPUT parparentproc
                              ,input ?
                              ,INPUT "":U
                              ,INPUT "entry-id"
                              ,INPUT X_ruledict.entry-id
                              ,input X_ruledict.entry-type
                              ,INPUT-OUTPUT v-rid-list) NO-ERROR.
  END.
  WHEN "uniq-key-rec" then do:
    CASE X_ruledict.entry-type:
      WHEN 'constant':U
      or when 'operator':U
      or when 'control':U
      THEN DO:
        MESSAGE
        "Нет просмотра!"
        VIEW-AS ALERT-BOX WARNING.
        RETURN NO-APPLY.
      END.
      when 'prop-name_':U
      or
      when 'prop-name_host':U
      or
      when 'prop-name_obj':U
      then do:
        run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
                                          ,output v-field-list
                                          ,output v-value-list).
        v-dtm-code = integer(entry(lookup("dtm-code":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3))).
        run rul/prop-head-i.w ( input parparentproc
                               ,input 'ПРОСМОТР':U
                               ,input v-dtm-code
                               ,input-output v-rec ) no-error.
      end.
      when 'node-name_':U
      or
      when 'node-name_host':U
      or
      when 'node-name_obj':U
      then do:
        run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
                                          ,output v-field-list
                                          ,output v-value-list).
        assign
        v-dtm-code = integer(entry(lookup("dtm-code":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3)))
        v-node-code = integer(entry(lookup("node-code":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3))).
        run rul/prop-map-i.w ( input parparentproc
                               ,input 'ПРОСМОТР':U
                               ,input v-dtm-code
                               ,input v-node-code
                               ,input-output v-rec ) no-error.
      end.
      when 'prop-script':U
      or
      when 'datatype':U
      then do:
        run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
                                          ,output v-field-list
                                          ,output v-value-list).
        assign
        v-dtm-code = integer(entry(lookup("dtm-code":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3)))
        v-language = entry(lookup("language":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3))
        v-script-name = entry(lookup("script-name":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3))
        v-revis-id = integer(entry(lookup("revis_id":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3))) no-error.
        run rul/prop-script-i.w ( input parparentproc
                               ,input 'ПРОСМОТР':U
                               ,input v-dtm-code
                               ,input v-language
                               ,input v-script-name
                               ,input v-revis-id
                               ,input-output v-rec ) no-error.
      end.
      when 'sum-id':U then do:
        run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
                                          ,output v-field-list
                                          ,output v-value-list).
        assign
        v-dt-code = integer(entry(lookup("dt-code":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3)))
        v-dtm-code = integer(entry(lookup("dtm-code":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3)))
                                      .
        run rul/prop-ref-i.w ( input parparentproc
                               ,input 'ПРОСМОТР':U
                               ,input v-dtm-code
                               ,input v-dt-code
                               ,input '':U
                               ,input-output v-rec ) no-error.
      end.
      when 'rule':U then do:
        run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
                                          ,output v-field-list
                                          ,output v-value-list).
        assign
        v-rule-id = integer(entry(lookup("rule_id":U
                                            , v-field-list
                                            , chr(3))
                                      , v-value-list, chr(3))).
        run rul/rule-i.w ( input parparentproc
                               ,input 'ПРОСМОТР':U
                               ,input v-rule-id
                               ,input-output v-rec ) no-error.
      end.
    END CASE.
  END.
END CASE.
END PROCEDURE.
