PROCEDURE set-row-color :
DEFINE INPUT PARAMETER p-ruledict-type AS character.
DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
CASE p-ruledict-type:
  WHEN 'constant':U THEN DO:
    ASSIGN
    iFGColor = WHITE_COLOR
    iBGColor = DARK_GREEN_COLOR
    .
  end.
  when 'operator':U then do:
    ASSIGN
    iFGColor = WHITE_COLOR
    iBGColor = BLUE_COLOR
    .
  end.
  when 'control':U then do:
    ASSIGN
    iFGColor = WHITE_COLOR
    iBGColor = YELLOW_COLOR
    .
  end.
  when 'prop-name_':U
  or
  when 'prop-name_host':U
  or
  when 'prop-name_obj':U
  then do:
    ASSIGN
    iFGColor = BLACK_COLOR
    iBGColor = BLUE_COLOR
    .
  end.
  when 'node-name_':U
  or
  when 'node-name_host':U
  or
  when 'node-name_obj':U
  then do:
    ASSIGN
      iFGColor = BLACK_COLOR
      iBGColor = GREY_COLOR
    .
  end.
  when 'prop-script':U then do:
    ASSIGN
      iFGColor = BLACK_COLOR
      iBGColor = RED_COLOR
    .
  end.
  when 'sum-id':U then do:
    ASSIGN
      iFGColor = RED_COLOR
      iBGColor = WHITE_COLOR
    .
  end.
  when 'sum-id':U then do:
    ASSIGN
      iFGColor = DARK_GREEN_COLOR
      iBGColor = WHITE_COLOR
    .
  end.
  when 'rule':U then do:
    ASSIGN
      iFGColor = RED_COLOR
      iBGColor = WHITE_COLOR
    .
  end.
  when 'datatype':U then do:
    ASSIGN
      iFGColor = BLACK_COLOR
      iBGColor = GREEN_COLOR
    .
  end.
  otherwise do:
    ASSIGN
      iFGColor = Black_COLOR
      iBGColor = White_COLOR
    .
  end.
END CASE.
ASSIGN
X_ruledict.entry-type:FGCOLOR IN BROWSE br-ruledict = iFGColor
X_ruledict.entry-type:BGCOLOR IN BROWSE br-ruledict = iBGColor
.
END PROCEDURE.
