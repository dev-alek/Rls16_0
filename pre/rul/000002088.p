procedure proc-main :
define variable v-i      as integer   no-undo .
define variable v-method as character no-undo .
define buffer buf_dis-some-rule for ub.dis-some-rule .
_main:
do
on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
:
    do v-i = 1 to num-entries(v-clients, chr(4)) :
define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
_buf_dis-some-rule:
for each buf_dis-some-rule no-lock
where buf_dis-some-rule.classif-type = "auto-ord-1"
:
    if buf_dis-some-rule.host-code > 0 and not get-host-true( buf_dis-some-rule.host-code, entry(v-i, v-clients, chr(4)) ) then next _buf_dis-some-rule .
    if buf_dis-some-rule.obj-code > 0 and
    not buf_dis-some-rule.obj-type + string(buf_dis-some-rule.obj-code) = entry(v-i, v-clients, chr(4)) then next _buf_dis-some-rule .
    if not get-period-true( buf_dis-some-rule.charkey_three, entry(4, buf_dis-some-rule.charkey_two, chr(3) ), buf_dis-some-rule.rl-root ) then next _buf_dis-some-rule .
    for each obj-list exclusive-lock:
       delete obj-list .
    end.
    create obj-list .
    assign
      obj-list.obj-code = int(substring( entry(v-i, v-clients, chr(4)), 4 ))
      obj-list.obj-type = substring( entry(v-i, v-clients, chr(4)), 1, 3 )
    .
    assign v-method = buf_dis-some-rule.charkey_one .
    run check-dates-method in this-procedure ( buf_dis-some-rule.key#_one,
                                               buf_dis-some-rule.key#_two,
                                               input-output v-method ) .
    run cus/cr-zakaz.p (
      input parparentproc
    , input p-log-handle
    , input buf_dis-some-rule.key#_one
    , input buf_dis-some-rule.key#_two
    , input entry(2, buf_dis-some-rule.charkey_two, chr(3) )
    , input v-method
    , input entry(1, buf_dis-some-rule.charkey_two, chr(3) )
    , input if num-entries (buf_dis-some-rule.charkey_two, chr(3)) < 7 then "no" else entry(7, buf_dis-some-rule.charkey_two, chr(3) )
    , input if num-entries (buf_dis-some-rule.charkey_two, chr(3)) < 7 then "no" else entry(6, buf_dis-some-rule.charkey_two, chr(3) )
    , input int(substring( entry(3, buf_dis-some-rule.charkey_two, chr(3) ), 4 ))
    , input substring( entry(3, buf_dis-some-rule.charkey_two, chr(3) ), 1, 3 )
    , input if num-entries (buf_dis-some-rule.charkey_two, chr(3)) < 7 then 0 else integer(entry(5, buf_dis-some-rule.charkey_two, chr(3) ))
    , input int(substring( entry(v-i, v-clients, chr(4)), 4 ))
    , input substring( entry(v-i, v-clients, chr(4)), 1, 3 )
    , 'ОП':U
    ) no-error .
end.
    end.
