procedure diasize_position-resize-button :
  do with frame d-scn-inv
  :
    hide v-diasize-resize-button .
    assign
      v-diasize-resize-button :row = frame d-scn-inv :height - v-diasize-resize-button :height
                  - 1
                  - (frame d-scn-inv :border-bottom-pixels / session :pixels-per-row)
      v-diasize-resize-button :col = frame d-scn-inv :width - v-diasize-resize-button :width
                  - 1
                  - (frame d-scn-inv :border-right-pixels / session :pixels-per-column)
    .
    view v-diasize-resize-button .
  end.
end procedure.
