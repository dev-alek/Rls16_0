END.
PROCEDURE re-move-clmnbr-nc:
  DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
  DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
  DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
    if cur-clmn-numbr-nc[varmvibr-nc] = source-column THEN cur-clmn-numbr-nc[varmvibr-nc] = -1.
  END.
  if br-nc:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
  if source-column > target-column THEN
  DO varmvjbr-nc = source-column - 1 to target-column BY -1:
    DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
        if cur-clmn-numbr-nc[varmvibr-nc] = varmvjbr-nc THEN DO:
          cur-clmn-numbr-nc[varmvibr-nc] = cur-clmn-numbr-nc[varmvibr-nc] + 1.
        END.
    END.
  END.
  ELSE
  DO varmvjbr-nc = source-column + 1 to target-column:
    DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
      if cur-clmn-numbr-nc[varmvibr-nc] = varmvjbr-nc THEN DO:
        cur-clmn-numbr-nc[varmvibr-nc] = cur-clmn-numbr-nc[varmvibr-nc] - 1.
      END.
    END.
  END.
  DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
    if cur-clmn-numbr-nc[varmvibr-nc] = -1 THEN cur-clmn-numbr-nc[varmvibr-nc] = target-column.
  END.
END PROCEDURE.
PROCEDURE ch-clmnbr-nc:
  DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
  if cur-clmn-loc <= 4 then do:
    return .
  end.
  DO varmvibr-nc = 1 TO EXTENT(cur-clmn-numbr-nc):
    if cur-clmn-numbr-nc[varmvibr-nc] = cur-clmn-loc THEN move-elementbr-nc = varmvibr-nc.
  END.
  RUN re-move-clmnbr-nc (cur-clmn-loc, 4).
END PROCEDURE.
PROCEDURE mv-brw-defaultbr-nc:
def var old-session as logical no-undo.
  old-session = SESSION:IMMEDIATE-DISPLAY.
  IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
  do varmvlbr-nc = 4 to EXTENT(cur-clmn-numbr-nc):
    RUN re-move-clmnbr-nc (cur-clmn-numbr-nc[varmvlbr-nc], varmvlbr-nc).
  END.
  RUN start-mv-clmnbr-nc.
  SESSION:IMMEDIATE-DISPLAY = old-session.
END PROCEDURE.
