if p-price-base = 0 then do:
  assign
    p-price-base = ?
  .
end.
if p-price-rubl = 0 then do:
  assign
    p-price-rubl = ?
  .
end.
if (p-price-base = ?) <> (p-price-rubl = ?) then do:
