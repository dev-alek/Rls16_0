PROCEDURE start-mv-clmnbr-badprts:
def var old-session as logical no-undo.
   old-session = SESSION:IMMEDIATE-DISPLAY.
   IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
   SESSION:IMMEDIATE-DISPLAY = old-session.
END.
ON ctrl-cursor-right OF BROWSE br-badprts do:
  RUN re-move-clmnbr-badprts ( 4, 10).
END.
ON ctrl-cursor-left OF BROWSE br-badprts do:
  RUN re-move-clmnbr-badprts (10, 4).
END.
PROCEDURE re-move-clmnbr-badprts:
  DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
  DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
  DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
    if cur-clmn-numbr-badprts[varmvibr-badprts] = source-column THEN cur-clmn-numbr-badprts[varmvibr-badprts] = -1.
  END.
  if br-badprts:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
  if source-column > target-column THEN
  DO varmvjbr-badprts = source-column - 1 to target-column BY -1:
    DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
        if cur-clmn-numbr-badprts[varmvibr-badprts] = varmvjbr-badprts THEN DO:
          cur-clmn-numbr-badprts[varmvibr-badprts] = cur-clmn-numbr-badprts[varmvibr-badprts] + 1.
        END.
    END.
  END.
  ELSE
  DO varmvjbr-badprts = source-column + 1 to target-column:
    DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
      if cur-clmn-numbr-badprts[varmvibr-badprts] = varmvjbr-badprts THEN DO:
        cur-clmn-numbr-badprts[varmvibr-badprts] = cur-clmn-numbr-badprts[varmvibr-badprts] - 1.
      END.
    END.
  END.
  DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
    if cur-clmn-numbr-badprts[varmvibr-badprts] = -1 THEN cur-clmn-numbr-badprts[varmvibr-badprts] = target-column.
  END.
END PROCEDURE.
PROCEDURE ch-clmnbr-badprts:
  DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
  if cur-clmn-loc <= 4 then do:
    return .
  end.
  DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
    if cur-clmn-numbr-badprts[varmvibr-badprts] = cur-clmn-loc THEN move-elementbr-badprts = varmvibr-badprts.
  END.
  RUN re-move-clmnbr-badprts (cur-clmn-loc, 4).
END PROCEDURE.
PROCEDURE mv-brw-defaultbr-badprts:
def var old-session as logical no-undo.
  old-session = SESSION:IMMEDIATE-DISPLAY.
  IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
  do varmvlbr-badprts = 4 to EXTENT(cur-clmn-numbr-badprts):
    RUN re-move-clmnbr-badprts (cur-clmn-numbr-badprts[varmvlbr-badprts], varmvlbr-badprts).
  END.
  RUN start-mv-clmnbr-badprts.
  SESSION:IMMEDIATE-DISPLAY = old-session.
END PROCEDURE.
