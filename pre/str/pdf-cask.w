PROCEDURE disable_UI :
  HIDE FRAME Dialog-Frame.
END PROCEDURE.
PROCEDURE enable_UI :
  DISPLAY RADIO-SET-1 TOGGLE-1
      WITH FRAME Dialog-Frame .
  ENABLE B-Quit B-save B-Help RADIO-SET-1 TOGGLE-1
      WITH FRAME Dialog-Frame.
  VIEW FRAME Dialog-Frame.
END PROCEDURE.
