PROCEDURE re-move-clmnBROWSE-3:
  DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
  DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
  DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
    if cur-clmn-numBROWSE-3[varmviBROWSE-3] = source-column THEN cur-clmn-numBROWSE-3[varmviBROWSE-3] = -1.
  END.
  if BROWSE-3:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
  if source-column > target-column THEN
  DO varmvjBROWSE-3 = source-column - 1 to target-column BY -1:
    DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
        if cur-clmn-numBROWSE-3[varmviBROWSE-3] = varmvjBROWSE-3 THEN DO:
          cur-clmn-numBROWSE-3[varmviBROWSE-3] = cur-clmn-numBROWSE-3[varmviBROWSE-3] + 1.
        END.
    END.
  END.
  ELSE
  DO varmvjBROWSE-3 = source-column + 1 to target-column:
    DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
      if cur-clmn-numBROWSE-3[varmviBROWSE-3] = varmvjBROWSE-3 THEN DO:
        cur-clmn-numBROWSE-3[varmviBROWSE-3] = cur-clmn-numBROWSE-3[varmviBROWSE-3] - 1.
      END.
    END.
  END.
  DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
    if cur-clmn-numBROWSE-3[varmviBROWSE-3] = -1 THEN cur-clmn-numBROWSE-3[varmviBROWSE-3] = target-column.
  END.
END PROCEDURE.
PROCEDURE ch-clmnBROWSE-3:
  DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
  if cur-clmn-loc <= 1 then do:
    return .
  end.
  DO varmviBROWSE-3 = 1 TO EXTENT(cur-clmn-numBROWSE-3):
    if cur-clmn-numBROWSE-3[varmviBROWSE-3] = cur-clmn-loc THEN move-elementBROWSE-3 = varmviBROWSE-3.
  END.
  RUN re-move-clmnBROWSE-3 (cur-clmn-loc, 1).
END PROCEDURE.
