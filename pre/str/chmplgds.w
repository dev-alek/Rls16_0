PROCEDURE sort-brBROWSE-3 :
  define input parameter p-recid as recid no-undo .
  if re-queryBROWSE-3 = no then do:
    assign
       cur-clmnBROWSE-3 = BROWSE-3:current-column in frame Dialog-Frame
    .
    if sort-clmnBROWSE-3 <> ? then sort-clmnBROWSE-3:column-fgcolor = 0.
    if cur-clmnBROWSE-3 = sort-clmnBROWSE-3 then do:
      assign
         sort-labelBROWSE-3 = ""
         sort-clmnBROWSE-3 = ?
      .
     end.
     else do:
       assign
         sort-labelBROWSE-3 = cur-clmnBROWSE-3:label
         sort-clmnBROWSE-3  = cur-clmnBROWSE-3
         sort-clmnBROWSE-3:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locBROWSE-3 = 1
  .
  def var column-handle as handle no-undo .
  column-handle = BROWSE-3:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnBROWSE-3 then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locBROWSE-3 = cur-clmn-locBROWSE-3 + 1
    .
  end.
  case sort-labelBROWSE-3:
        when 'Приор!итет'  then DO:    assign       sort-column-name = "tt_price-all.plt-priority"     .     run OpenBr .   . END.
        when 'Бар-код'  then DO:    assign       sort-column-name = "tt_price-all.b-code"     .     run OpenBr .   . END.
        when 'Ед!изм'  then DO:    assign       sort-column-name = "tt_price-all.unit-cli"     .     run OpenBr .   . END.
        when 'Вал!п/л'  then DO:    assign       sort-column-name = "buf_currency.curr-abbr"     .     run OpenBr .   . END.
        when 'Объект! '  then DO:    assign       sort-column-name = "tt_price-all.obj-code"     .     run OpenBr .   . END.
        when 'Ф!к'  then DO:    assign       sort-column-name = "tt_price-all.plt-fix-cource-crc-doc"     .     run OpenBr .   . END.
        when 'Курс!док-та'  then DO:    assign       sort-column-name = "tt_price-all.pdf-exch-rate"     .     run OpenBr .   . END.
        when 'Цена в вал!прайс-листа'  then DO:    assign       sort-column-name = "tt_price-all.price-sale"     .     run OpenBr .   . END.
        when 'Ф!б'  then DO:    assign       sort-column-name = "tt_price-all.plt-fix-cource-crc-base"     .     run OpenBr .   . END.
        when 'Курс!баз.вал'  then DO:    assign       sort-column-name = "tt_price-all.pdf-base-rate"     .     run OpenBr .   . END.
        when 'Цена в !баз.вал'  then DO:    assign       sort-column-name = "tt_price-all.price-sale-base"     .     run OpenBr .   . END.
        when 'Цена в !РУБ'  then DO:    assign       sort-column-name = "tt_price-all.price-sale-rubl"     .     run OpenBr .   . END.
        when 'Действие!с '  then DO:    assign       sort-column-name = "tt_price-all.date-1"     .     run OpenBr .   . END.
        when 'См!с'  then DO:    assign       sort-column-name = "tt_price-all.shift-1"     .     run OpenBr .   . END.
        when 'Время!c'  then DO:    assign       sort-column-name = "tt_price-all.time-1"     .     run OpenBr .   . END.
        when 'Действие!по '  then DO:    assign       sort-column-name = "tt_price-all.date-2"     .     run OpenBr .   . END.
        when 'См!по'  then DO:    assign       sort-column-name = "tt_price-all.shift-2"     .     run OpenBr .   . END.
        when 'Время!по'  then DO:    assign       sort-column-name = "tt_price-all.time-2"     .     run OpenBr .   . END.
        when 'Покупатели! '  then DO:    assign       sort-column-name = "tt_price-all.grp-name"     .     run OpenBr .   . END.
        when 'Интервал!группы'  then DO:    assign       sort-column-name = "tt_price-all.interv-name"     .     run OpenBr .   . END.
        when 'Тип платежа! '  then DO:    assign       sort-column-name = "tt_price-all.pay-name"     .     run OpenBr .   . END.
        when 'ТПЛ! '  then DO:    assign       sort-column-name = "tt_price-all.plt-id"     .     run OpenBr .   . END.
        when 'БД!ТПЛ'  then DO:    assign       sort-column-name = "tt_price-all.plt-db-num"     .     run OpenBr .   . END.
        when 'ДНЦ! '  then DO:    assign       sort-column-name = "tt_price-all.pdf-id"     .     run OpenBr .   . END.
        when 'БД!ДНЦ'  then DO:    assign       sort-column-name = "tt_price-all.pdf-db"     .     run OpenBr .   . END.
        when 'Переоценка! '  then DO:    assign       sort-column-name = "tt_price-all.out-code"     .     run OpenBr .   . END.
        when 'Статус! '  then DO:    assign       sort-column-name = "tt_price-all.status_"     .     run OpenBr .   . END.
        when 'Крат-!ность'  then DO:    assign       sort-column-name = "tt_price-all.cli-base-rate"     .     run OpenBr .   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr .
        if can-do( this-procedure:internal-entries, 'mv-brw-defaultBROWSE-3') then do:
          run mv-brw-defaultBROWSE-3.
        end.
      if sort-labelBROWSE-3 <> "" then do:
        assign
          cur-clmnBROWSE-3:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locBROWSE-3 = ?
