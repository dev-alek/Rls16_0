    end.
  end case.
    if cur-clmn-locBROWSE-3 <> ? then do:
      if can-do( this-procedure:internal-entries, 'ch-clmnBROWSE-3') then do:
        run ch-clmnBROWSE-3 in this-procedure (cur-clmn-locBROWSE-3).
