DO:
define variable cur-clmn-loc as integer   no-undo .
define variable column-handle as handle no-undo .
define variable v-list as character no-undo .
  assign
    cur-clmn-loc  = 1
    column-handle = BROWSE-3:first-column
    v-list        = column-handle:label + "#"
  .
  do while valid-handle(column-handle) :
    if cur-clmn-loc = BROWSE-3:num-columns then do:
      leave .
    end.
    assign
      column-handle = column-handle:NEXT-COLUMN
      cur-clmn-loc  = cur-clmn-loc + 1
      v-list        = v-list + column-handle:label + "#"
    .
  end.
   v-list = trim(v-list, "#") .
   define variable v-i        as integer   no-undo .
   define variable v-pos      as integer   no-undo .
   define variable v-list-new as character no-undo .
   define variable v-elem     as character no-undo .
   repeat v-i = 1 to BROWSE-3:num-columns :
      v-elem = entry ( v-i , v-list , "#" ) .
      v-pos  = lookup ( v-elem , 'Приор!итет'  + '#' +  'Бар-код'  + '#' +  'Ед!изм'  + '#' +  'Вал!п/л'  + '#' +  'Объект! '  + '#' +  'Ф!к'  + '#' +  'Курс!док-та'  + '#' +  'Цена в вал!прайс-листа'  + '#' +  'Ф!б'  + '#' +  'Курс!баз.вал' + '#' +  'Цена в !баз.вал' + '#' +  'Цена в !РУБ' + '#' +  'Действие!с ' + '#' +  'См!с' + '#' +  'Время!c' + '#' +  'Действие!по ' + '#' +  'См!по' + '#' +  'Время!по' + '#' +  'Покупатели! ' + '#' +  'Интервал!группы' + '#' +  'Тип платежа! ' + '#' +  'ТПЛ! ' + '#' +  'БД!ТПЛ' + '#' +  'ДНЦ! ' + '#' +  'БД!ДНЦ' + '#' +  'Переоценка! ' + '#' +  'Статус! ' + '#' +  'Крат-!ность' , "#") .
      v-list-new = v-list-new + string(v-pos) + "," .
   end.
   define variable v-list-str as character no-undo .
   define variable v-1 as integer   no-undo .
   v-list-str = "" .
   v-1 = num-entries(v-list-new)  .
   repeat v-i = 1 to v-1 :
      v-elem = entry(v-i , v-list-new ) .
      if int(v-elem) > 0 then
      v-list-str  = v-list-str + v-elem + "," .
   end.
   v-list-new = trim(v-list-str ,",")  +  chr(4)
              + string(decimal( tt_price-all.price-sale     :width in browse BROWSE-3)) +  chr(4)
              + string(decimal( tt_price-all.price-sale-rubl:width in browse BROWSE-3)) +  chr(4)
              + string(decimal( tt_price-all.price-sale-base:width in browse BROWSE-3)) +  chr(4)
              + string(decimal( tt_price-all.grp-name       :width in browse BROWSE-3)) +  chr(4)
              + string(decimal( tt_price-all.interv-name    :width in browse BROWSE-3)) +  chr(4)
              + string(decimal( tt_price-all.pay-name       :width in browse BROWSE-3)) +  chr(4)
              .
run uf-set in this-procedure(
    input  'mpl-gds-p':U
    ,input v-cntxt-userid
    ,input v-list-new
    ,input v-uf-Naim
    ,input v-uf-print-graft
    ,input v-uf-sort-gr
    ,input v-uf-type-price
    ,input v-uf-type-val
) no-error    .
    if error-status :error then
    message
      vss-workfile vss-revision vss-description skip
      error-status :get-message(1) skip
      return-value skip
      "uf-set"
      view-as alert-box error
    .
  run uf-set in this-procedure(
    input  'color-p':U
    ,input v-cntxt-userid
    ,input string(is-color)
    ,input v-uf-Naim
    ,input v-uf-print-graft
    ,input v-uf-sort-gr
    ,input v-uf-type-price
    ,input v-uf-type-val
) no-error    .
END.
ON ROW-DISPLAY OF BROWSE-3 IN FRAME Dialog-Frame
DO:
if is-color = false then return .
define variable v-color  as integer   no-undo .
define variable v-color2 as integer   no-undo .
   case tt_price-all.type-price :
        when  integer('0':U) then do:
            v-color = ?.
        end.
        when  integer('2':U) then do:
            v-color = dark_green_color.
        end.
        when  integer('1':U) then do:
            v-color = DARK_GREY_COLOR.
        end.
        when  integer('3':U) then do:
            v-color =  blue_color .
        end.
   end case.
   case tt_price-all.main-indication :
        when  integer('0':U) then do:
            if tt_price-all.plt-priority = 0 then v-color2 = ?.
                                             else v-color2 = 8.
        end.
        when  integer('2':U) then do:
            v-color2 = 11.
        end.
        when  integer('3':U) then do:
            v-color2 = 10.
        end.
        when  integer('4':U) then do:
            v-color2 =  14 .
        end.
   end case.
    tt_price-all.plt-priority :fgcolor in browse BROWSE-3 = v-color.
    tt_price-all.b-code :fgcolor in browse BROWSE-3 = v-color.
    buf_currency.curr-abbr :fgcolor in browse BROWSE-3 = v-color.
    tt_price-all.price-sale:bgcolor in browse BROWSE-3 = v-color2.
END.
ON VALUE-CHANGED OF BROWSE-3 IN FRAME Dialog-Frame
DO:
  v-node-name = "" .
  v-full-pay-name  = "" .
  if available  tt_price-all then do:
        find first buf_bar-code no-lock where buf_bar-code.b-code = tt_price-all.b-code no-error .
        find first buf_gds-prt no-lock where
                   buf_gds-prt.node-code = buf_bar-code.node-code no-error.
        if available buf_gds-prt then
           v-node-name = buf_gds-prt.f-name.
        if num-entries (tt_price-all.pay-name,":") = 2 then do:
           case entry (1, tt_price-all.pay-name,":") :
            when 'Оплата':U then do:
                find first buf_pay-type no-lock where buf_pay-type.obj-code = int (entry (2, tt_price-all.pay-name,":")) no-error .
                if available buf_pay-type
                  then v-full-pay-name = 'Оплата':U + ": " +  buf_pay-type.obj-name.
                  else v-full-pay-name = "" .
            end.
            when 'Касс.платеж':U then do:
                find first buf_cash-pay no-lock where
                           buf_cash-pay.cdpay-code = integer (entry (1,(entry (2, tt_price-all.pay-name,":")),"_" )) and
                           buf_cash-pay.curr-code  = integer (entry (2,(entry (2, tt_price-all.pay-name,":")),"_" ))
                           no-error .
                if available buf_cash-pay
                  then v-full-pay-name = 'Касс.платеж':U + ": " + buf_cash-pay.obj-name.
                  else v-full-pay-name = "" .
            end.
           end case.
        end.
  end.
  DISPLAY v-node-name v-full-pay-name  WITH FRAME Dialog-Frame.
END.
