     RUN re-move-clmnBROWSE-3 ( cur-clmn-numBROWSE-3[INTEGER(ENTRY (jjBROWSE-3, v-order-col))] , 1).
   END.
       END.
   SESSION:IMMEDIATE-DISPLAY = old-session.
END.
