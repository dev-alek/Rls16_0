PROCEDURE disable_UI :
  HIDE FRAME Dialog-Frame.
END PROCEDURE.
PROCEDURE enable_UI :
  ASSIGN  r-type       = 1
          varall-place = yes.
  DISPLAY r-type varall-place
      WITH FRAME Dialog-Frame.
  ENABLE b-cancel b-ok RECT-1 r-type varall-place b-help
      WITH FRAME Dialog-Frame.
  VIEW FRAME Dialog-Frame.
END PROCEDURE.
