ASSIGN
       FRAME d-sertif:SCROLLABLE       = FALSE.
ON GO OF FRAME d-sertif
DO:
    p-rid-list = v-rid-list.
  END.
ON CHOOSE OF b-mark IN FRAME d-sertif
DO:
    define variable g-log as logical no-undo.
    if available buf_sertif then
    do:
      v-sertif = buf_sertif.SerialNumber .
define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
define variable v-str-recid8 as character no-undo .
define variable v-num-entry8 as integer   no-undo .
assign
  v-str-recid8 = trim( string( recid( buf_sertif ) , "->>>>>>>>>>>9":U ) )
  v-num-entry8 = lookup( v-str-recid8 , v-sertif )
.
if v-num-entry8 > 0 then do:
  assign
    entry( v-num-entry8, v-sertif ) = "":U
    v-sertif = trim( replace( v-sertif , chr(44) + chr(44) , chr(44) ) , chr(44) )
  .
end.
else do:
  assign
    v-sertif = v-sertif + ( if v-sertif = "":U then "":U else chr(44) ) + v-str-recid8
  .
end.
      v-rid-list = string( buf_sertif.SerialNumber ) .
      g-log = br-sertif:refresh() .
      if last-event:function <> "mouse-select-dblclick" then
      do:
        g-log = br-sertif:select-next-row ().
        apply "value-changed" to br-sertif in frame d-sertif.
      end.
    end.
    apply "entry" to br-sertif in frame d-sertif.
  END.
ON CHOOSE OF b-sel IN FRAME d-sertif
DO:
    if ( available buf_sertif )
      AND ( v-rid-list = "" or b-mark:sensitive = no ) then
      v-rid-list = string( buf_sertif.SerialNumber ) .
  END.
ON DEFAULT-ACTION OF br-sertif IN FRAME d-sertif
DO:
    case yes:
      when  b-sel:sensitive THEN
        apply "CHOOSE":U to b-sel.
    end case.
  END.
ON INSERT-MODE OF br-sertif IN FRAME d-sertif
DO:
    if b-mark:sensitive in frame d-sertif then
      APPLY "CHOOSE" to b-mark.
    else
    do:
      if b-sel:sensitive in frame d-sertif then
        APPLY "CHOOSE" to b-sel.
    end.
  END.
ON RETURN OF br-sertif IN FRAME d-sertif
DO:
    apply "DEFAULT-ACTION":U to self.
  END.
IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sertif:PARENT eq ?
  THEN FRAME d-sertif:PARENT = ACTIVE-WINDOW.
ON WINDOW-CLOSE OF FRAME d-sertif
  APPLY "END-ERROR":U TO SELF.
