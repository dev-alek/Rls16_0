   else '':U)  CHR(9)
  (if scn-list-hist.item_ <> '':U
  then string(scn-list-hist.num-recs, ">>>>>>>>9")
  else '':U)  CHR(9)
  scn-list-hist.des
  skip.
end.
run waitfram-hide in this-procedure .
if Make-Excel then output stream ForExcel close.
run waitfram-hide in this-procedure .
if Make-Excel then do:
   run rep/runexcel.p (
                   string( session:temp-directory +
                         "rpt" +
