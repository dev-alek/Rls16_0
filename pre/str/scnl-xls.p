def new shared var bc-frmt as character no-undo .
def new shared var bc-pfx  as character no-undo .
def var bc-par-type as character no-undo .
    run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
    if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
        do:
            message "Не задан или не верно задан ТИП собственного бар-кода!"
                view-as alert-box ERROR TITLE "".
            return error.
        end.
    run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
    if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
        do:
            message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
                view-as alert-box ERROR TITLE "".
            return error.
        end.
PROCEDURE gen-bc:
  def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
  def output parameter full-b-code     as character init ""    no-undo .
define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
  define variable tmp-str23  as character no-undo.
  define variable tmp-num23  as character no-undo.
  define variable i23        as integer   no-undo.
  define variable sum23      as integer   no-undo.
  define variable len-code23 as integer   no-undo.
  define variable varcont23  as logical   initial yes no-undo.
  CASE bc-frmt :
    WHEN "EAN13" THEN do:
      assign
        tmp-str23 = string( internal-b-code, "999999999999" )
      .
    end.
    WHEN "EAN8" THEN do:
      assign
        tmp-str23 = string( internal-b-code, "9999999" )
      .
    end.
    OTHERWISE DO:
        message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
        view-as alert-box error.
        return error.
    END.
  END CASE.
  if varcont23 = yes then do:
    if integer( substring( tmp-str23, 1, length( bc-pfx ) ) ) <> 0
    then do:
      message
        "Невозможно сформировать бар-код" SKIP
        "для товара с кодом: " internal-b-code
        view-as alert-box error title "подрезание кода".
      return error.
    end.
    else do:
      assign
        full-b-code = bc-pfx + substring( tmp-str23, length( bc-pfx ) + 1, length( tmp-str23 ) - length( bc-pfx ) )
        len-code23    = length( full-b-code )
      .
      define variable v-sum-char23 as character no-undo .
      assign
        sum23 = 0
      .
      do i23 = 1 to len-code23 by 2
      :
        assign
          v-sum-char23 = substr(full-b-code, len-code23 - i23 + 1, 1)
        .
        if v-sum-char23 < "0"
        or v-sum-char23 > "9"
        then do:
          message
            "Невозможно сформировать бар-код" skip
            "для товара с кодом: " internal-b-code skip
            view-as alert-box error title "подсчет контрольной суммы".
          return error.
        end.
        assign
          sum23 = sum23 + integer(v-sum-char23)
        .
      end.
      if varcont23 = yes then do:
        assign
          sum23 = sum23 * 3
        .
        do i23 = 2 to len-code23 by 2
        :
          assign
            v-sum-char23 = substr(full-b-code, len-code23 - i23 + 1, 1)
          .
          if v-sum-char23 < "0"
          or v-sum-char23 > "9"
          then do:
            message
              "Невозможно сформировать бар-код" skip
              "для товара с кодом: " internal-b-code skip
              view-as alert-box error title "подсчет контрольной суммы".
            return error.
          end.
          assign
            sum23 = sum23 + integer(v-sum-char23)
          .
        end.
        if varcont23 = yes then do:
           if sum23 mod 10 = 0 then do:
             assign
               full-b-code = full-b-code + '0'
             .
           end.
           else do:
             assign
               full-b-code = full-b-code + string(10 - sum23 mod 10)
             .
           end.
        end.
      end.
    end.
  end.
END PROCEDURE.
