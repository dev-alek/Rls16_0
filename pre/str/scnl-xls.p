                            ,input p-curr-obj-type
                            ,input p-curr-obj-code
                            ,INPUT entry(jj-1, v-dop0, "*":U)
                            ,input yes
                            ,INPUT-OUTPUT f-value-1
                            )  NO-ERROR .
            assign
            f-value = f-value + (if f-value = "":U then "":U else chr(32)) + f-value-1
            .
          end.
        end.
        else do:
          run gds-ref-fi in this-procedure (
                           buffer ub.goods
                          ,buffer ub.gds-obj
                          ,input p-curr-obj-type
                          ,input p-curr-obj-code
                          ,INPUT v-dop0
                          ,input yes
                          ,INPUT-OUTPUT f-value
                          )  NO-ERROR .
        end.
        if Make-Excel then  put   stream ForExcel unformatted
        if entry(jj, f-name) = "artic" then chr(4) else "":U
        string(replace(f-value, chr(10), ""), substitute("X(&1)", entry(jj, ubflt.filter.Where-ysl)))
        (if jj < j-n
        then
        CHR(9)
        else chr(10))
        .
      end.
    END CASE.
  end.
END.
