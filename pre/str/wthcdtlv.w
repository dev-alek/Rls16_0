ON ROW-LEAVE OF BR-dtl IN FRAME Dialog-Frame
DO:
  CASE vardoc-status_:
    when 'накл':U then do:
      ASSIGN
      tt-par-dtl.q-ty-bef = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-bef.
      ASSIGN
      d_bef-sum = d_bef-sum - tt-par-dtl.sum-bef.
      ASSIGN
      tt-par-dtl.sum-bef = tt-par-dtl.q-ty-bef * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      ASSIGN
      d_bef-sum = d_bef-sum + tt-par-dtl.sum-bef.
      DISPLAY
      tt-par-dtl.q-ty-bef
      tt-par-dtl.sum-bef
      WITH BROWSE BR-dtl.
      DISPLAY
      d_bef-sum @ for-d_bef-sum
      WITH FRAME Dialog-Frame.
    end.
    when 'разрешен':U then do:
      ASSIGN
      tt-par-dtl.q-ty-aft = INPUT BROWSE BR-dtl tt-par-dtl.q-ty-aft.
      ASSIGN
      d_aft-sum = d_aft-sum - tt-par-dtl.sum-aft.
      ASSIGN
      tt-par-dtl.sum-aft = tt-par-dtl.q-ty-aft * tt-par-dtl.par-val * tt-par-dtl.par-rate.
      ASSIGN
      d_aft-sum = d_aft-sum + tt-par-dtl.sum-aft.
