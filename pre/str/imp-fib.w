procedure get-context :
   define output parameter p-db-num as integer          no-undo.
   define output parameter p-user-id as character        no-undo.
   define variable v-login               as character    no-undo.
   define buffer buf_sys-ctrl    for ub.sys-ctrl .
   define buffer buf_user-login  for ub.user-login .
   do
   on error undo, return error
   :
         FIND FIRST buf_sys-ctrl no-lock.
         ASSIGN
            v-login = USERID("ub")
            p-db-num = buf_sys-ctrl.db-num
         .
         FIND FIRST buf_user-login
              WHERE buf_user-login.db-num = p-db-num
                AND buf_user-login.user-login = v-login
              no-lock
              no-error
              .
         IF AVAILABLE buf_user-login
         THEN DO:
            assign
               p-user-id = buf_user-login.user-id
            .
         END.
   end.
end procedure.
    run diasize_init in this-procedure .
def var sort-labelBROWSE-ext-goods   as character no-undo .
def var sort-clmnBROWSE-ext-goods    as handle    no-undo .
def var cur-clmnBROWSE-ext-goods     as handle    no-undo .
def var cur-clmn-locBROWSE-ext-goods as integer   no-undo .
def var re-queryBROWSE-ext-goods     as logical   initial no no-undo .
on start-search, ctrl-o of BROWSE-ext-goods in frame Dialog-Frame do:
   run sort-brBROWSE-ext-goods
     (input (if available buf_ext-classif
             then recid(buf_ext-classif)
             else ?
            )
     ).
end.
PROCEDURE sort-brBROWSE-ext-goods :
  define input parameter p-recid as recid no-undo .
  if re-queryBROWSE-ext-goods = no then do:
    assign
       cur-clmnBROWSE-ext-goods = BROWSE-ext-goods:current-column in frame Dialog-Frame
    .
    if sort-clmnBROWSE-ext-goods <> ? then sort-clmnBROWSE-ext-goods:column-fgcolor = 0.
    if cur-clmnBROWSE-ext-goods = sort-clmnBROWSE-ext-goods then do:
      assign
         sort-labelBROWSE-ext-goods = ""
         sort-clmnBROWSE-ext-goods = ?
      .
     end.
     else do:
       assign
         sort-labelBROWSE-ext-goods = cur-clmnBROWSE-ext-goods:label
         sort-clmnBROWSE-ext-goods  = cur-clmnBROWSE-ext-goods
         sort-clmnBROWSE-ext-goods:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locBROWSE-ext-goods = 1
  .
  def var column-handle as handle no-undo .
  column-handle = BROWSE-ext-goods:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnBROWSE-ext-goods then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locBROWSE-ext-goods = cur-clmn-locBROWSE-ext-goods + 1
    .
  end.
  case sort-labelBROWSE-ext-goods:
        when 'Фальсификат!Серия'  then DO:    assign       sort-column-name = "buf_ext-classif.CharKey_One"     .     run OpenBr(yes,no,'':U).   . END.
        when 'Название товара!из Excel'  then DO:    assign       sort-column-name = "buf_ext-classif.CharKey_Three"     .     run OpenBr(yes,no,'':U).   . END.
        when 'Код Товара!в TH'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-gds-code&1, recid(buf_ext-classif))', chr(34))     .     run OpenBr(yes,no,'':U).   . END.
        when 'Название!в TH'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1f-gds-name&1, recid(buf_ext-classif))', chr(34))     .     run OpenBr(yes,no,'':U).   . END.
        when '§'  then DO:    assign       sort-column-name = "buf_ext-classif.whole-send-news"     .     run OpenBr(yes,no,'':U).   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run OpenBr(yes,no,'':U).
      if sort-labelBROWSE-ext-goods <> "" then do:
        assign
          cur-clmnBROWSE-ext-goods:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locBROWSE-ext-goods = ?
      .
    end.
  end case.
  if p-recid <> ? then do:
    reposition BROWSE-ext-goods to recid p-recid no-error.
    apply "value-changed" to BROWSE-ext-goods in frame Dialog-Frame.
  end.
  apply "entry" to BROWSE-ext-goods in frame Dialog-Frame.
END PROCEDURE.
procedure re-open-query-srt-clmnBROWSE-ext-goods:
if cur-clmnBROWSE-ext-goods = ? then do:
   run OpenBr(yes,no,'':U).
end.
else do:
   assign re-queryBROWSE-ext-goods = yes.
   run sort-brBROWSE-ext-goods
     (input (if available buf_ext-classif
             then recid(buf_ext-classif)
             else ?
            )
     ).
   assign re-queryBROWSE-ext-goods = no.
end.
end.
