def var sort-labelbr-docs   as character no-undo .
def var sort-clmnbr-docs    as handle    no-undo .
def var cur-clmnbr-docs     as handle    no-undo .
def var cur-clmn-locbr-docs as integer   no-undo .
def var re-querybr-docs     as logical   initial no no-undo .
on start-search, ctrl-o of br-docs in frame d-all-docs do:
   run sort-brbr-docs
     (input (if available t-doc
             then recid(t-doc)
             else ?
            )
     ).
end.
PROCEDURE sort-brbr-docs :
  define input parameter p-recid as recid no-undo .
  if re-querybr-docs = no then do:
    assign
       cur-clmnbr-docs = br-docs:current-column in frame d-all-docs
    .
    if sort-clmnbr-docs <> ? then sort-clmnbr-docs:column-fgcolor = 0.
    if cur-clmnbr-docs = sort-clmnbr-docs then do:
      assign
         sort-labelbr-docs = ""
         sort-clmnbr-docs = ?
      .
     end.
     else do:
       assign
         sort-labelbr-docs = cur-clmnbr-docs:label
         sort-clmnbr-docs  = cur-clmnbr-docs
         sort-clmnbr-docs:column-fgcolor = 4
       .
     end.
   end.
  assign
    cur-clmn-locbr-docs = 1
  .
  def var column-handle as handle no-undo .
  column-handle = br-docs:first-column.
  do while valid-handle(column-handle) :
    if column-handle = cur-clmnbr-docs then do:
      leave .
    end.
    column-handle = column-handle:NEXT-COLUMN.
    assign
      cur-clmn-locbr-docs = cur-clmn-locbr-docs + 1
    .
  end.
  case sort-labelbr-docs:
        when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Т'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1first-symb-type&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Стат'  then DO:    assign       sort-column-name = "t-doc.status_"     .     run ui-on ('open').   . END.
        when 'OK'  then DO:    assign       sort-column-name = "t-doc.flag_"     .     run ui-on ('open').   . END.
        when 'Номер'  then DO:    assign       sort-column-name = "t-doc.doc-code"     .     run ui-on ('open').   . END.
        when 'Дата'  then DO:    assign       sort-column-name = "t-doc.doc-date"     .     run ui-on ('open').   . END.
        when 'Факт'  then DO:    assign       sort-column-name = "t-doc.fact-date"     .     run ui-on ('open').   . END.
        when 'Смена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-day-month&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when '№'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1shift-name&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'В'  then DO:    assign       sort-column-name = "t-doc.internal"     .     run ui-on ('open').   . END.
        when 'Контрагент'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fcli-name&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Объект'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1object-label&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'У'  then DO:    assign       sort-column-name = "t-doc.office"     .     run ui-on ('open').   . END.
        when 'Кол-во по док.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-doc-qnty&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Кол-во факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-fact-qnty&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when '$'  then DO:    assign       sort-column-name = "t-doc.print-rubl"     .     run ui-on ('open').   . END.
        when 'Сумма по док'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-sum&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Скидка по док'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-dsc&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Сумма факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Скидка факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-dsc-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'К оплате факт'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-pay-fact&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'НДС'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-vat&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Сумма учет.'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1total-acc&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Скидка (%)'  then DO:    assign       sort-column-name = "t-doc.discnt-pc"     .     run ui-on ('open').   . END.
        when 'Тип скидки'  then DO:    assign       sort-column-name = "t-doc.discnt-type"     .     run ui-on ('open').   . END.
        when 'Курс'  then DO:    assign       sort-column-name = "t-doc.base-rate"     .     run ui-on ('open').   . END.
        when 'А'  then DO:    assign       sort-column-name = "t-doc.ov"     .     run ui-on ('open').   . END.
        when 'Авт. переоц. (прод.)'  then DO:    assign       sort-column-name = "t-doc.tot-ov"     .     run ui-on ('open').   . END.
        when 'Инв.'  then DO:    assign       sort-column-name = "t-doc.inv-num"     .     run ui-on ('open').   . END.
        when 'Запрос'  then DO:    assign       sort-column-name = "t-doc.ord-num"     .     run ui-on ('open').   . END.
        when 'Отгрузка приход'  then DO:    assign       sort-column-name = "t-doc.ship-num"     .     run ui-on ('open').   . END.
        when 'Дата отгр'  then DO:    assign       sort-column-name = "t-doc.ship-date"     .     run ui-on ('open').   . END.
        when 'На док-т'  then DO:    assign       sort-column-name = "t-doc.out-code"     .     run ui-on ('open').   . END.
        when 'Внеш.сист'  then DO:    assign       sort-column-name = "t-doc.acc-date"     .     run ui-on ('open').   . END.
        when 'Экспорт'  then DO:    assign       sort-column-name = "t-doc.bge-date"     .     run ui-on ('open').   . END.
        when 'Резерв отгрузка'  then DO:    assign       sort-column-name = "t-doc.rsrv-date"     .     run ui-on ('open').   . END.
        when 'ФО поставка'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-postavka&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'ФО реализация'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-realiz&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Счет-фактура'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1factur&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'ФО покупателя'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fo-buyer&1 , ( recid(t-doc)) )' , chr(34))     .     run ui-on ('open').   . END.
        when 'Номер партии для документа межфирменного перемещения'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'hold-part-code')     .     run ui-on ('open').   . END.
        when 'Доверенность'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'dov')     .     run ui-on ('open').   . END.
        when 'Дата приходной накладной поставщика'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'dids')     .     run ui-on ('open').   . END.
        when 'Номер приходной накладной поставщика'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'nids')     .     run ui-on ('open').   . END.
        when 'Договор: Дата'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'ddog')     .     run ui-on ('open').   . END.
        when 'Договор: Номер'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'ndog')     .     run ui-on ('open').   . END.
        when 'Счет-фактура поставщика: Дата'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'dsf')     .     run ui-on ('open').   . END.
        when 'Счет-фактура поставщика: Номер'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'nsf')     .     run ui-on ('open').   . END.
        when 'Дополнительные суммы посчитанные по документу'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'addsum')     .     run ui-on ('open').   . END.
        when 'On-line расчет дополнительных сумм основных и после документа'  then DO:   assign       sort-column-name = substitute('dynamic-function( &1f-&2&1 , (recid(t-doc)))' ,  chr(34) , 'clcasol')     .     run ui-on ('open').   . END.
    otherwise do:
      assign
        sort-column-name = ""
      .
      run ui-on ('open').
        if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-docs') then do:
          run mv-brw-defaultbr-docs.
        end.
      if sort-labelbr-docs <> "" then do:
        assign
          cur-clmnbr-docs:column-fgcolor = 0
        .
      end.
      assign
        cur-clmn-locbr-docs = ?
      .
    end.
  end case.
    if cur-clmn-locbr-docs <> ? then do:
      if can-do( this-procedure:internal-entries, 'ch-clmnbr-docs') then do:
        run ch-clmnbr-docs in this-procedure (cur-clmn-locbr-docs).
      end.
    end.
  if p-recid <> ? then do:
    reposition br-docs to recid p-recid no-error.
    apply "value-changed" to br-docs in frame d-all-docs.
  end.
  apply "entry" to br-docs in frame d-all-docs.
END PROCEDURE.
procedure re-open-query-srt-clmnbr-docs:
if cur-clmnbr-docs = ? then do:
   run ui-on ('open').
end.
else do:
   assign re-querybr-docs = yes.
   run sort-brbr-docs
     (input (if available t-doc
             then recid(t-doc)
             else ?
            )
     ).
   assign re-querybr-docs = no.
end.
end.
