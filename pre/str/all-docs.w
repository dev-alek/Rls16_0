  (output v-sys-key
  ) no-error .
    os-command silent value(search ("xml-doc.bat") + chr(32) + chr(34) +  v-file-name + chr(34) + chr(32)  + v-sys-key + chr(32) + v-cntxt-userid ).
  end.
  else do:
    if search( v-file-name ) <> ? then do:
    message
