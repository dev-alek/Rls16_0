      message "Данный документ не нуждался в генерации финобязательств по поставке."
      view-as alert-box.
      next vari-cycle.
    end.
    reposition br-docs to recid recid(bf_trn-doc) no-error.
    if not error-status:error then do:
      display fo-postavka (recid( bf_trn-doc)) @ varpost with browse br-docs.
    end.
  end.
end.
assign
  mark-list = "".
end.
