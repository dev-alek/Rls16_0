  FRAME d-all-docs :SCROLLABLE       = FALSE
 FRAME d-all-docs :visible      = FALSE
.
ASSIGN b-exp :POPUP-MENU IN FRAME d-all-docs = MENU m-export :HANDLE.
ASSIGN b-exp :MENU-MOUSE = 1.
ASSIGN b-scaner :POPUP-MENU IN FRAME d-all-docs = MENU m-scaner :HANDLE.
ASSIGN b-scaner :MENU-MOUSE = 1.
ASSIGN b-rep :POPUP-MENU IN FRAME d-all-docs = MENU m-rep :HANDLE.
ASSIGN b-rep :MENU-MOUSE = 1.
ASSIGN b-pay :POPUP-MENU IN FRAME d-all-docs = MENU POPUP-MENU-b-pay :HANDLE.
ASSIGN b-pay :MENU-MOUSE = 1.
ASSIGN b-pay :MENU-KEY   = "RETURN":U.
ASSIGN b-f-ed :POPUP-MENU IN FRAME d-all-docs = MENU POPUP-MENU-b-f-ed :HANDLE.
ASSIGN b-f-ed :MENU-MOUSE = 1.
ASSIGN b-f-ed :MENU-KEY   = "RETURN":U.
ON CHOOSE OF MENU-ITEM m-export-1 in menu m-export DO:
  if available t-doc then
   run local-export in this-procedure .
end.
ON CHOOSE OF MENU-ITEM m-export-2 in menu m-export DO:
   if available t-doc then   do:
     if t-doc.doc-type = 'инв':U  then
        run cus/z-tot2.p ( parParentProc, "trn-doc" , "inv" , t-doc.doc-code ) .
     else
        run cus/z-tot2.p ( parParentProc, "trn-doc" , "fact" , t-doc.doc-code ) .
   end.
end.
ON CHOOSE OF MENU-ITEM m-rep-1 in menu m-rep DO:
  define variable buf-handle as handle no-undo .
  define variable q-handle as handle no-undo .
  buf-handle = buffer t-doc :handle .
  q-handle   = query br-docs :handle .
  run rep/rep-par.w (input  parparentproc , input   frame d-all-docs:title , input  q-handle , input buf-handle ).
  run UI-on ("open").
  choice = ?.
END.
ON CHOOSE OF MENU-ITEM m-rep-3 in menu m-rep DO:
    run rep/rep-paro.w
      (input parparentproc
      ,input frame d-all-docs:title
      ).
