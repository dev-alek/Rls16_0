procedure OpenBr :
define input parameter p-open-query     as logical   no-undo .
define input parameter p-find-next      as logical   no-undo .
define input parameter p-find-condition as character no-undo .
define input parameter fnc              as character no-undo.
case sort-column-name :
when "" then do:
assign
  sort-column-phrase = ""
.
end.
otherwise do:
assign
  sort-column-phrase = "by " + sort-column-name
.
end.
end case.
assign
  parschdoc-code  = (if available sch-inv  then sch-inv.doc-code   else ?)
  parschcurr-code = (if available sch-curr then sch-curr.curr-code else ?)
  parschobj-code  = (if available sch-pay  then sch-pay.obj-code   else ?)
  parschcli-type  = (if available sch-cli  then sch-cli.obj-type   else ?)
  parschcli-code  = (if available sch-cli  then sch-cli.obj-code   else ?)
.
define variable l-open-query as logical   no-undo .
if v-is-lgas then do:
  run modes-lgas (
    p-open-query     ,
    p-find-next      ,
    p-find-condition ,
    fnc              ).
end.
  else do:
  if can-do ('работа':U + "," + 'фирма':U + "," + 'объект':U + "," + 'выбор':U, parlist-mode) then do:
    run modes-1-a (
      p-open-query     ,
      p-find-next      ,
      p-find-condition ,
      fnc              ).
  end.
  else do:
    if can-do ('ТИП':U + "," + 'статус':U + "," + 'status-all' +  "," + 'status-all-hold' + "," + 'ФЛАГ':U + "," + 'ВНУ':U + "," + 'отгрузка':U + "," + "invert":u, parlist-mode) then do:
      run modes-1-b (
        p-open-query     ,
        p-find-next      ,
        p-find-condition ,
        fnc              ).
    end.
    else do:
      if can-do( 'счет-фактура':U + "-host," + 'счет-фактура':U + "-obj"  + ",no-def,yes-gen-incfo,yes-gen-expfo,yes-gen-fo,yes-gen-buyer" , parlist-mode ) then do:
        run modes-2 (
          p-open-query     ,
          p-find-next      ,
          p-find-condition ,
          fnc              ).
      end.
      else do:
        if parlist-mode = "client-income":u then do:
          if fnc = "open" then do:
            assign
              frame d-all-docs:title = "Приходы от контрагента : " + sch-cli.obj-name
              objects = 1
            .
            assign filter-point = parlist-mode + chr(4) + parlist-mode + chr(4) + "yes".
define variable vss-include-info124 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
define variable  l-disable-where-125  as logical   no-undo .
define variable  l-filter-open-125    as logical   .
define variable  flt-rec-125       as recid     no-undo .
define variable  filter-name-125      as character no-undo .
define variable  where-phrase-125     as character no-undo .
define variable  sort-phrase-125      as character no-undo .
define variable  where-phrase-rus-125 as character no-undo .
define variable  sort-phrase-rus-125  as character no-undo .
run gbl/flt-get.p
  (input filter-point
  ,output flt-rec-125
  ,output filter-name-125
  ,output where-phrase-125
  ,output sort-phrase-125
  ,output where-phrase-rus-125
  ,output sort-phrase-rus-125
  ).
if p-open-query then do:
    run set-filter-name in this-procedure
      (INPUT filter-name-125
      ) no-error .
  assign
    l-filter-open-125 = false
  .
  if flt-rec-125 <> ?
    or sort-column-phrase > ""
  then do:
    define variable  parameter-2-125 as character no-undo .
    define variable  parameter-3-125 as character no-undo .
    define variable  parameter-4-125 as character no-undo .
    define variable  parameter-5-125 as character no-undo .
    define variable  parameter-6-125 as character no-undo .
    define variable  parameter-7-125 as character no-undo .
      assign
      parameter-3-125 =
                              "FOR EACH t-doc"
      parameter-4-125 =
        (
          if ("t-doc.cli-type  = parschcli-type                             and t-doc.cli-code  = parschcli-code                            and t-doc.host-code = par-host-code                             and t-doc.ext-doc-type = parext-doc-type                              " + " " + where-phrase-125) <> ""
          then  substitute ( '                                t-doc.cli-type  = &1&2&1                             and t-doc.cli-code  = &3                            and t-doc.host-code = &4                             and t-doc.ext-doc-type = &1&5&1                            ', chr(34), parschcli-type , parschcli-code, par-host-code , parext-doc-type  ) + " " + where-phrase-125
          else "true"
        )
      parameter-5-125 = (" " + " use-index cli-date " + " " + substitute(' , first temp-trn-doc where (&1 = 1 or t-doc.doc-code = temp-trn-doc.doc-code ) ' , r-2 ))
      parameter-6-125 = if sort-phrase-125 = ''
                           then
        (
        " " + "" +
          " " + sort-column-phrase +
        " " + ""
        )
                           else
        (
        " " + "" +
          " " + sort-column-phrase +
        " " + sort-phrase-125
        )
      parameter-7-125 =
        "   "
    .
    do
    on stop undo, leave
    on error undo, leave
    :
      assign
        l-disable-where-125 =
          ("t-doc.cli-type  = parschcli-type                             and t-doc.cli-code  = parschcli-code                            and t-doc.host-code = par-host-code                             and t-doc.ext-doc-type = parext-doc-type                              " + " " + where-phrase-125 = "")
      .
      run fltopend_fltopend in this-procedure  ( input this-procedure:handle
                          ,input query br-docs:handle
                          ,input parameter-3-125
                          ,input parameter-4-125
                          ,input parameter-5-125
                          ,input parameter-6-125
                          ,input parameter-7-125
                          )
      .
      assign
        l-filter-open-125 = true
      .
    end.
    if l-filter-open-125 = false then do:
      message
        "Ошибка при фильтрации / сортировке" skip
        "Будут показаны записи без учета фильтра" skip
        view-as alert-box .
    end.
    else do:
        assign
          l-query-was-opened = true
        .
    end.
  end.
  if l-filter-open-125 = false then do:
    open query br-docs for each t-doc
      where t-doc.cli-type  = parschcli-type                             and t-doc.cli-code  = parschcli-code                            and t-doc.host-code = par-host-code                             and t-doc.ext-doc-type = parext-doc-type
     use-index cli-date
    , first temp-trn-doc where (r-2 = 1 or t-doc.doc-code = temp-trn-doc.doc-code )
  .
      assign
        l-query-was-opened = true
      .
  end.
end.
else do:
  assign
    pardoc-rec = recid( t-doc )
  .
  do
  on stop undo, leave
  on error undo, leave
  :
    if query br-docs:handle:get-buffer-handle(1) = (buffer t-doc:handle) then do:
      assign
      parameter-2-125 = (if p-find-next then "true":u else "false":u )
      parameter-4-125 =
        "where ":u +  substitute ( '                                t-doc.cli-type  = &1&2&1                             and t-doc.cli-code  = &3                            and t-doc.host-code = &4                             and t-doc.ext-doc-type = &1&5&1                            ', chr(34), parschcli-type , parschcli-code, par-host-code , parext-doc-type  ) + " ":u + where-phrase-125 + " ":u + p-find-condition + " " + " use-index cli-date "
      parameter-5-125 = ""
    .
      run fltopend_fltfindd in this-procedure  (
                          input this-procedure:handle
                          ,input query br-docs:handle
                          ,input rowid(t-doc)
                          ,input logical(parameter-2-125)
                          ,input no-lock
                          ,input (buffer t-doc:handle)
                          ,input parameter-4-125
                          ,input parameter-5-125
                          ) no-error.
      .
      assign
        pardoc-rec = integer(return-value)
        v-fltopend-rowid[1] = ?
      .
    end.
    else do:
      assign
      parameter-2-125 = (if p-find-next then "true":u else "false":u )
      parameter-3-125 =  "FOR EACH t-doc"
      parameter-4-125 =
        (
          if ("t-doc.cli-type  = parschcli-type                             and t-doc.cli-code  = parschcli-code                            and t-doc.host-code = par-host-code                             and t-doc.ext-doc-type = parext-doc-type                              " + " " + where-phrase-125) <> ""
          then  substitute ( '                                t-doc.cli-type  = &1&2&1                             and t-doc.cli-code  = &3                            and t-doc.host-code = &4                             and t-doc.ext-doc-type = &1&5&1                            ', chr(34), parschcli-type , parschcli-code, par-host-code , parext-doc-type  ) + " " + where-phrase-125
          else "true"
        )
      parameter-5-125 = (" " + " use-index cli-date " + " " + substitute(' , first temp-trn-doc where (&1 = 1 or t-doc.doc-code = temp-trn-doc.doc-code ) ' , r-2 ) + " " + p-find-condition)
      parameter-6-125 = if sort-phrase-125 = ''
                           then
        (
        " " + "" +
          " " + sort-column-phrase +
        " " + ""
        )
                           else
        (
        " " + "" +
          " " + sort-column-phrase +
        " " + sort-phrase-125
        )
      parameter-7-125 =
        "   "
    .
      run fltopend_fltfindq in this-procedure  (
                          input this-procedure:handle
                          ,input query br-docs:handle
                          ,input logical(parameter-2-125)
                          ,input no-lock
                          ,input parameter-3-125
                          ,input parameter-4-125
                          ,input parameter-5-125
                          ,input parameter-6-125
                          ,input parameter-7-125
                          ,output v-fltopend-rowid
                          ) no-error.
      .
      pardoc-rec = ?.
    end.
    assign
      l-query-was-opened = true
    .
  end.
end.
          end.
        end.
        else do:
          run modes-3 (
            p-open-query     ,
            p-find-next      ,
            p-find-condition ,
            fnc              ).
        end.
      end.
    end.
  end.
end.
if pardoc-rec <> ? then do:
  if fnc <> "open" then do:
    sch-num = sch-num + 1.
    disp sch-num with frame d-all-docs.
  end.
  reposition br-docs to recid pardoc-rec no-error.
end.
else do:
  if fnc <> "open" then do:
    message "Документ не найден.".
    sch-num = 0.
  end.
end.
run waitfram-hide in this-procedure .
apply "value-changed" to br-docs in frame d-all-docs.
apply "entry" to br-docs.
end procedure.
procedure modes-3:
define input parameter p-open-query     as logical   no-undo .
define input parameter p-find-next      as logical   no-undo .
define input parameter p-find-condition as character no-undo .
define input parameter fnc              as character no-undo.
    case parlist-mode :
