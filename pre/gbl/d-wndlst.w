  RUN reopen_query.
END.
ON CHOOSE OF btn_level-5 IN FRAME D-Dialog
DO:
  ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
         show_levels = integer(self:LABEL)
         levels:SCREEN-VALUE = "Levels 1 - " + SELF:LABEL
