END.
ON CHOOSE OF btn_level-all IN FRAME D-Dialog
DO:
  ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
         show_levels = 1000000
         levels:SCREEN-VALUE = "All Levels"
         .
  RUN reopen_query.
END.
