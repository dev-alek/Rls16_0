  IF AVAILABLE tt THEN DO:
    IF CAN-FIND (FIRST child_tt WHERE child_tt.parent-recid eq RECID(tt))
    THEN DO:
      save_recid = RECID(tt).
      RUN set_expansion (RECID(tt), NOT tt.expanded).
      RUN reopen_query.
    END.
  END.
END.
