  if g#db-num > 0 then do:
      hide B-exit B-def in frame wind1 .
      b-quit:label = "Выход" .
  end.
  WAIT-FOR GO OF FRAME wind1.
END.
RUN disable_UI.
PROCEDURE def-proc :
find first ub.thbj-attr exclusive-lock where
              ub.thbj-attr.obj-code                     =  0   and
              ub.thbj-attr.obj-type                     =  ""  and
              ub.thbj-attr.prop-code                    = 'izt-rul':U  and
              ub.thbj-attr.prop-value-type              = 'character':U  and
              ub.thbj-attr.upper-prop-code              = 'izt-rul':U
              no-error  .
if available ub.thbj-attr then do:
   delete ub.thbj-attr.
end.
  run gbl/clearlib.p .
  run init-tt .
  run enable_ui .
END PROCEDURE.
PROCEDURE disable_UI :
  HIDE FRAME wind1.
END PROCEDURE.
PROCEDURE enable_UI :
