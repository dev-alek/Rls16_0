                                          ,output v-shop
                                          ,output v-store
                                          ,output v-db
                                          ) no-error.
    if error-status:error then do:
      undo main-block, return error substitute("Ошибка при определении свойств параметра &1", v-upper-code).
    end.
    if g#db-num > 0 then do:
      assign
      v-global = no
      v-host = no
      .
    end.
    case v-global:
      when yes then do:
        run adm/shattri.p (
            input "init":U
          , input '':U
