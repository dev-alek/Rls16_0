<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:xsd="undefined" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xs:include schemaLocation="exitetypes_0-01.xsd"/>
  <xs:element name="ORDER_">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ORDER">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="DOCUMENTNAME" type="order-type"/>
              <xs:element name="NUMBER" type="numbertype"/>
              <xs:element name="DATE" type="xs:date"/>
              <xs:element name="DELIVERYDATE" type="xs:date" minOccurs="0"/>
              <xs:element name="DELIVERYTIME" type="timetype" minOccurs="0"/>
              <xs:element name="CAMPAIGNNUMBER" type="numbertype" minOccurs="0"/>
              <xs:element name="CURRENCY" type="currency"/>
              <xs:element name="INFO" type="xs:string" minOccurs="0"/>
              <xs:element ref="HEAD"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="pi" prodata:primaryIndex="true">
      <xs:selector xpath=".//ORDER"/>
      <xs:field xpath="NUMBER"/>
    </xs:unique>
    <xs:unique name="HEAD_pi" prodata:primaryIndex="true">
      <xs:selector xpath=".//HEAD"/>
      <xs:field xpath="NUMBER"/>
    </xs:unique>
    <xs:unique name="POSITION_pi" prodata:primaryIndex="true">
      <xs:selector xpath=".//POSITION"/>
      <xs:field xpath="NUMBER"/>
      <xs:field xpath="POSITIONNUMBER"/>
    </xs:unique>
    <xs:unique name="CHARACTERISTIC_pi" prodata:primaryIndex="true">
      <xs:selector xpath=".//CHARACTERISTIC"/>
      <xs:field xpath="NUMBER"/>
      <xs:field xpath="POSITIONNUMBER"/>
      <xs:field xpath="CHARACTERISTICNUMBER"/>
    </xs:unique>
    <xs:keyref name="r1" refer="pi" prodata:nested="true">
      <xs:selector xpath=".//HEAD"/>
      <xs:field xpath="NUMBER"/>
    </xs:keyref>
    <xs:keyref name="r2" refer="HEAD_pi" prodata:nested="true">
      <xs:selector xpath=".//POSITION"/>
      <xs:field xpath="NUMBER"/>
    </xs:keyref>
    <xs:keyref name="r3" refer="POSITION_pi" prodata:nested="true">
      <xs:selector xpath=".//CHARACTERISTIC"/>
      <xs:field xpath="NUMBER"/>
      <xs:field xpath="POSITIONNUMBER"/>
    </xs:keyref>
  </xs:element>
  <xs:element name="HEAD">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NUMBER" type="numbertype"/>
        <xs:element name="SUPPLIER" type="gln"/>
        <xs:element name="BUYER" type="gln"/>
        <xs:element name="DELIVERYPLACE" type="gln"/>
        <xs:element name="INVOICEPARTNER" type="gln" minOccurs="0"/>
        <xs:element name="SENDER" type="mailbox"/>
        <xs:element name="RECIPIENT" type="mailbox"/>
        <xs:element name="EDIINTERCHANGEID" type="edi-interchange-id" minOccurs="1"/>
        <xs:element ref="POSITION" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="POSITION">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NUMBER" type="numbertype" minOccurs="1"/>
        <xs:element name="POSITIONNUMBER" type="positionnumbertype"/>
        <xs:element name="PRODUCT" type="gln"/>
        <xs:element name="PRODUCTIDSUPPLIER" type="numbertype"/>
        <xs:element name="PRODUCTIDBUYER" type="numbertype"/>
        <xs:element name="ORDEREDQUANTITY" type="amount"/>
        <xs:element name="QUANTITYOFCUINTU" type="amount"/>
        <xs:element name="ORDERUNIT" type="measurement-unit"/>
        <xs:element name="ORDERPRICE" type="amount"/>
        <xs:element name="VAT" type="percentage"/>
        <xs:element ref="CHARACTERISTIC" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="CHARACTERISTIC">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NUMBER" type="numbertype" minOccurs="1"/>
        <xs:element name="POSITIONNUMBER" type="positionnumbertype"/>
        <xs:element name="CHARACTERISTICNUMBER" type="positionnumbertype"/>
        <xs:element name="DESCRIPTION" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>