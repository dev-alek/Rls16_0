<xsd:schema xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="HEADER.xsd" />
  <xsd:element prodata:proDataSet="true" name="Oracle_Retail">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Header_" type="HEADERType" />
        <xsd:element minOccurs="0" maxOccurs="unbounded" name="currency">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="line-num" type="Line-numType" />
              <xsd:element name="curr-abbr">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:pattern value="\w{1,3}|\w{1,2}\." />
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="curr-code" type="CurrCode" />
              <xsd:element name="curr-name">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:normalizedString">
                    <xsd:maxLength value="40" />
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>              
              <xsd:element name="okv-code">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:int">
                    <xsd:minInclusive value="0" />
                    <xsd:maxInclusive value="999" />
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="unbounded" name="curr-accnt">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="line-num" type="Line-numType" />
              <xsd:element name="curr-code" type="CurrCode" />
              <xsd:element name="exch-date" type="xsd:date" />
              <xsd:element name="exch-rate">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:decimal">
                    <xsd:minExclusive value="0" />
                    <xsd:fractionDigits value="4" />
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="exch-scale">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:positiveInteger">
                    <xsd:minInclusive value="1" />
                    <xsd:maxInclusive value="1000" />
                    <xsd:pattern value="1(0){0,3}" />
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="status_" type="StatusType" nillable="false"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique prodata:primaryIndex="true" name="pi">
      <xsd:selector xpath=".//currency" />
      <xsd:field xpath="line-num" />
    </xsd:unique>
    <xsd:unique prodata:primaryIndex="true" name="curr-accnt_pi">
      <xsd:selector xpath=".//curr-accnt" />
      <xsd:field xpath="line-num" />
    </xsd:unique>
    <xsd:unique name="idate">
      <xsd:selector xpath=".//curr-accnt" />
      <xsd:field xpath="curr-code" />
      <xsd:field xpath="exch-date" />
    </xsd:unique>
  </xsd:element>
  <xsd:annotation>
    <xsd:appinfo>
      <prodata:index name="icode">
        <prodata:table name="currency" />
        <prodata:field name="curr-code" />
      </prodata:index>
      <prodata:index name="iabbr">
        <prodata:table name="currency" />
        <prodata:field name="curr-abbr" />
      </prodata:index>
    </xsd:appinfo>
  </xsd:annotation>
</xsd:schema>