<?xml version="1.0" encoding="windows-1251"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:complexType name="reportheaderType" prodata:proDataSet="true">
    <xsd:sequence>
      <xsd:element name="datetimeStart" type="xsd:dateTime" prodata:dataType="prodata:dateTime">
        <xsd:annotation>
          <xsd:documentation>Дата и время начала выполнения отчета</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="datetimeEnd" type="xsd:dateTime" prodata:dataType="prodata:dateTime">
        <xsd:annotation>
          <xsd:documentation>Дата и время окончания выполнения отчета</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="report-name" type="xsd:NCName">
        <xsd:annotation>
          <xsd:documentation>короткий псевдоним отчета - например dispet</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="report-label" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>Длинное человекочитаемое имя отчета - например Отчет диспетера</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="report-id">
        <xsd:annotation>
          <xsd:documentation>идентификатор отчета внутри машины отчетов виде ID профайла[/ID правила]</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:pattern value="[1-9][0-9]{0,8}/{0,1}([1-9][0-9]{0,8}){0,1}"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="report-db-num">
        <xsd:annotation>
          <xsd:documentation># БД, в которой выполнялся отчет</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:int">
            <xsd:maxInclusive value="99999"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="task-num" type="xsd:int">
        <xsd:annotation>
          <xsd:documentation>№ задачи - строки расписания</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="report-parameters" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Параметры, с которым выполнялся отчет</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="report-id">
              <xsd:annotation>
                <xsd:documentation>идентификатор отчета внутри машины отчетов виде ID профайла[/ID правила]</xsd:documentation>
              </xsd:annotation>
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:pattern value="[1-9][0-9]{0,8}/{0,1}([1-9][0-9]{0,8}){0,1}"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element name="parameter-name" type="xsd:NCName">
              <xsd:annotation>
                <xsd:documentation>Название параметра в машине правил</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="parameter-label" type="xsd:string">
              <xsd:annotation>
                <xsd:documentation>Лейбл параметра в машине правил - человекочитаемое имя</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="parameter-value-type">
              <xsd:annotation>
                <xsd:documentation>типа значения параметра - бывает например просто character
                    а бывает еще character,list</xsd:documentation>
              </xsd:annotation>
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:pattern value="(character|date|decimal|integer|logical)(,list){0,1}"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element name="parameter-value" type="xsd:string">
              <xsd:annotation>
                <xsd:documentation>значение параметра выраженное в символьном виде</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="parameter-index" type="xsd:int" minOccurs="0" default="0">
              <xsd:annotation>
                <xsd:documentation>если параметр типа list, то здесь указан индекс в списке и тогда он не может = 0</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="parameter-des" type="xsd:string">
              <xsd:annotation>
                <xsd:documentation>расширенное описание параметра</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="report-errors" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="report-id">
              <xsd:annotation>
                <xsd:documentation>идентификатор отчета внутри машины отчетов виде ID профайла[/ID правила]</xsd:documentation>
              </xsd:annotation>
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:pattern value="[1-9][0-9]{0,8}/{0,1}([1-9][0-9]{0,8}){0,1}"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element name="ErrNum" type="xsd:int" nillable="true"/>
            <xsd:element name="ErrCode" type="xsd:int" nillable="true"/>
            <xsd:element name="ErrSeverity" type="xsd:int" nillable="true"/>
            <xsd:element name="ErrMessage" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="report-destination" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="report-id">
              <xsd:annotation>
                <xsd:documentation>идентификатор отчета внутри машины отчетов виде ID профайла[/ID правила]</xsd:documentation>
              </xsd:annotation>
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:pattern value="[1-9][0-9]{0,8}/{0,1}([1-9][0-9]{0,8}){0,1}"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element name="destination-id" type="xsd:string" nillable="true"/>
            <xsd:element name="destination" type="xsd:string" nillable="true"/>
            <xsd:element name="destination-details" type="xsd:string" nillable="true"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>