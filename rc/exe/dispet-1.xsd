<?xml version="1.0" encoding="windows-1251"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:include schemaLocation="reporttypes.xsd"/>
  <xsd:element name="report-dispet-ds" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="report-header" type="reportheaderType"/>
        <xsd:element name="Dispet" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="obj-type" type="xsd:string"/>
              <xsd:element name="obj-code" type="xsd:int"/>
              <xsd:element name="obj-name" type="xsd:string" nillable="false"/>
              <xsd:element name="obj-address" type="xsd:string"/>
              <xsd:element name="obj-phone" type="xsd:string"/>
              <xsd:element name="db-num" type="xsd:int" nillable="false"/>
              <xsd:element name="dispetRow" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="obj-type" type="xsd:string"/>
                    <xsd:element name="obj-code" type="xsd:int"/>
                    <xsd:element name="gds-code" type="xsd:int"/>
                    <xsd:element name="gds-name" type="xsd:string"/>
                    <xsd:element name="loc1" type="xsd:string"/>
                    <xsd:element name="max-qnty" type="xsd:decimal"/>
                    <xsd:element name="add-qnty" type="xsd:decimal"/>
					<xsd:element name="min-qnty" type="xsd:decimal"/>
					<xsd:element name="current-sale" type="xsd:decimal"/>
					<xsd:element name="income" type="xsd:decimal"/>
                    <xsd:element name="sale-qnty-7" type="xsd:decimal"/>
                    <xsd:element name="curr-qnty" type="xsd:decimal"/>
                    <xsd:element name="doc-qnty" type="xsd:decimal"/>
                    <xsd:element name="level-water" type="xsd:decimal"/>
                    <xsd:element name="volume-water" type="xsd:decimal"/>
                    <xsd:element name="sale-qnty-1" type="xsd:decimal"/>
                    <xsd:element name="curr-date" type="xsd:date"/>
                    <xsd:element name="curr-time-str" type="xsd:string"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <!-- dispetrow-->
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <!-- Dispet-->
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//Dispet"/>
      <xsd:field xpath="obj-type"/>
      <xsd:field xpath="obj-code"/>
    </xsd:unique>
    <xsd:unique name="dispetRow_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//dispetRow"/>
      <xsd:field xpath="obj-type"/>
      <xsd:field xpath="obj-code"/>
      <xsd:field xpath="gds-code"/>
      <xsd:field xpath="loc1"/>
    </xsd:unique>
    <xsd:keyref name="r1" refer="pi" prodata:nested="true">
      <xsd:selector xpath=".//dispetRow"/>
      <xsd:field xpath="obj-type"/>
      <xsd:field xpath="obj-code"/>
    </xsd:keyref>
    <xsd:unique name="report-header_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//report-header"/>
      <xsd:field xpath="report-id"/>
    </xsd:unique>
    <xsd:unique name="report-parameters_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//report-parameters"/>
      <xsd:field xpath="report-id"/>
      <xsd:field xpath="parameter-name"/>
      <xsd:field xpath="parameter-index"/>
    </xsd:unique>
    <xsd:unique name="report-errors_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//report-errors"/>
      <xsd:field xpath="report-id"/>
      <xsd:field xpath="ErrNum"/>
    </xsd:unique>
    <xsd:unique name="report-destination_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//report-destination"/>
      <xsd:field xpath="report-id"/>
      <xsd:field xpath="destination-id"/>
    </xsd:unique>
    <xsd:keyref name="rh1" refer="report-header_pi" prodata:nested="true">
      <xsd:selector xpath=".//report-parameters"/>
      <xsd:field xpath="report-id"/>
    </xsd:keyref>
    <xsd:keyref name="rh2" refer="report-header_pi" prodata:nested="true">
      <xsd:selector xpath=".//report-errors"/>
      <xsd:field xpath="report-id"/>
    </xsd:keyref>
    <xsd:keyref name="rh3" refer="report-header_pi" prodata:nested="true">
      <xsd:selector xpath=".//report-destination"/>
      <xsd:field xpath="report-id"/>
    </xsd:keyref>
  </xsd:element>
</xsd:schema>