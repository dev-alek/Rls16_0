  <xs:simpleType name="timetype">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2}:[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positionnumbertype">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="statustype">
    <xs:restriction base="xs:int">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="doctype">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ORDERS"/>
      <xs:enumeration value="ORDRSP"/>
      <xs:enumeration value="DESADV"/>
      <xs:enumeration value="RECADV"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- Тип продукта -->
  <xs:simpleType name="producttypetype">
    <xs:restriction base="xs:int">
      <xs:enumeration value="1"/>
      <!-- Продукт будет поставлен -->
      <xs:enumeration value="2"/>
      <!-- Продукт будет поставлен с изменением количества поставки -->
      <xs:enumeration value="3"/>
      <!-- Продукт не будет поставлен -->
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="actiontype">
    <xs:restriction base="xs:int">
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
