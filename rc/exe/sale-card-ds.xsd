<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:element name="sale-card-ds" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="sale-card" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="d-card" type="xsd:string" nillable="true"/>
              <xsd:element name="obj-type" type="xsd:string" nillable="true"/>
              <xsd:element name="obj-code" type="xsd:int" nillable="true"/>
              <xsd:element name="gds-dis-base" type="xsd:decimal" nillable="true"/>
              <xsd:element name="gds-dis-rubl" type="xsd:decimal" nillable="true"/>
              <xsd:element name="gds-tot-base" type="xsd:decimal" nillable="true"/>
              <xsd:element name="gds-tot-rubl" type="xsd:decimal" nillable="true"/>
              <xsd:element name="num-chk" type="xsd:int" nillable="true"/>
              <xsd:element name="pay-tot-base" type="xsd:decimal" nillable="true"/>
              <xsd:element name="pay-tot-rubl" type="xsd:decimal" nillable="true"/>
              <xsd:element name="sale-doc" type="xsd:string" nillable="true"/>
              <xsd:element name="sale-type" type="xsd:string" nillable="true"/>
              <xsd:element name="sale-date" type="xsd:date" nillable="true"/>
              <xsd:element name="d-pcnt" type="xsd:decimal" nillable="true"/>
              <xsd:element name="cash-d-pcnt" type="xsd:decimal" nillable="true"/>
              <xsd:element name="category" type="xsd:int" nillable="true"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//sale-card"/>
      <xsd:field xpath="d-card"/>
    </xsd:unique>
  </xsd:element>
</xsd:schema>
