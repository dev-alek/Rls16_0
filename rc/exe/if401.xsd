<?xml version="1.0" encoding="windows-1251"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:include schemaLocation="HEADER.xsd"/>
  <xsd:element name="Oracle_Retail" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Header_" type="HEADERType"/>
        <xsd:element minOccurs="1" maxOccurs="unbounded" name="ord-doc">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="line-num" type="Line-numType" nillable="false"/>
              <xsd:element name="status_" type="StatusType" nillable="false"/>
              <xsd:element name="doc-date" type="xsd:date"/>
              <xsd:element name="cli-code" type="CliCode" nillable="false"/>
              <xsd:element name="obj-type" type="ObjType" nillable="false"/>
              <xsd:element name="obj-code" type="ObjCode" nillable="false"/>
              <xsd:element name="doc-code" type="xsd:string" nillable="false"/>
              <xsd:element name="corr-doc-code" type="xsd:string" minOccurs="0" nillable="false"/>
              <xsd:element name="exch-code" type="CurrCode" nillable="false"/>
              <xsd:element name="exch-rate" type="THExchRate" nillable="false"/>
              <xsd:element name="exch-scale" type="THExchScale" nillable="false"/>
              <xsd:element name="ship-date" type="xsd:date" nillable="false"/>
              <xsd:element name="ps" type="xsd:string" minOccurs="0"/>
              <xsd:element minOccurs="0" maxOccurs="unbounded" name="ord-line">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="line-num" type="Line-numType" nillable="false"/>
                    <xsd:element name="fact-qnty" nillable="false">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:decimal">
                          <xsd:minInclusive value="0"/>
                          <xsd:fractionDigits value="3"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="price-rubl" type="PriceType" nillable="false"/>
                    <xsd:element name="price-cli" type="PriceType" nillable="false"/>
                    <xsd:element name="gds-code" type="BarCodeType" nillable="false"/>
                    <xsd:element name="doc-code" type="xsd:string" nillable="false"/>
                    <xsd:element name="vat-pc" type="VatType" nillable="false"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//ord-doc"/>
      <xsd:field xpath="line-num"/>
    </xsd:unique>
    <xsd:unique name="ord-line_pi" prodata:primaryIndex="true">
      <xsd:selector xpath=".//ord-line"/>
      <xsd:field xpath="line-num"/>
      <xsd:field xpath="gds-code"/>
    </xsd:unique>
  </xsd:element>
  <xsd:annotation>
    <xsd:appinfo>
      <prodata:index name="iline">
        <prodata:table name="ord-line"/>
        <prodata:field name="doc-code"/>
        <prodata:field name="gds-code"/>
      </prodata:index>
      <prodata:relation name="doc-code" prodata:nested="true" prodata:parent="ord-doc" prodata:child="ord-line" prodata:relationFields="line-num,line-num,doc-code,doc-code"/>
    </xsd:appinfo>
  </xsd:annotation>
</xsd:schema>