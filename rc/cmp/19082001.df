ADD TABLE "Code"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Справочники"
  DESCRIPTION "Справочники"
  DUMP-NAME "code"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/coded.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/codew.p" CRC "?" 

ADD FIELD "code" OF "Code" AS character 
  DESCRIPTION "Код"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Код"
  POSITION 2
  MAX-WIDTH 16
  COLUMN-LABEL "Код"
  ORDER 10
  MANDATORY

ADD FIELD "CodeName" OF "Code" AS character 
  DESCRIPTION "Наименование"
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 3
  MAX-WIDTH 120
  COLUMN-LABEL "Наименование"
  ORDER 20

ADD FIELD "CodeValue" OF "Code" AS character 
  DESCRIPTION "Значение"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Значение"
  POSITION 4
  MAX-WIDTH 40
  COLUMN-LABEL "Значение"
  ORDER 30

ADD FIELD "misc1" OF "Code" AS character 
  DESCRIPTION "Доп поле 1"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 1"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 1"
  ORDER 40

ADD FIELD "misc2" OF "Code" AS character 
  DESCRIPTION "Доп поле 2"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 2"
  POSITION 6
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 2"
  ORDER 50

ADD FIELD "misc3" OF "Code" AS character 
  DESCRIPTION "Доп поле 3"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 3"
  POSITION 7
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 3"
  ORDER 60

ADD FIELD "misc4" OF "Code" AS character 
  DESCRIPTION "Доп поле 4"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 4"
  POSITION 8
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 4"
  ORDER 70

ADD FIELD "misc5" OF "Code" AS character 
  DESCRIPTION "Доп поле 5"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 5"
  POSITION 9
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 5"
  ORDER 80

ADD FIELD "misc6" OF "Code" AS character 
  DESCRIPTION "Доп поле 6"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 6"
  POSITION 10
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 6"
  ORDER 90

ADD FIELD "misc7" OF "Code" AS character 
  DESCRIPTION "Доп поле 7"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 7"
  POSITION 11
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 7"
  ORDER 100

ADD FIELD "misc8" OF "Code" AS character 
  DESCRIPTION "Доп поле 8"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 8"
  POSITION 12
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 8"
  ORDER 110

ADD FIELD "misc9" OF "Code" AS character 
  DESCRIPTION "Доп поле 9"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 9"
  POSITION 13
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 9"
  ORDER 120

ADD FIELD "misc10" OF "Code" AS character 
  DESCRIPTION "Доп поле 10"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Доп поле 10"
  POSITION 14
  MAX-WIDTH 40
  COLUMN-LABEL "Доп поле 10"
  ORDER 130

ADD FIELD "procview" OF "Code" AS character 
  DESCRIPTION "Процедура просмотра"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Процедура просмотра"
  POSITION 15
  MAX-WIDTH 40
  COLUMN-LABEL "Процедура просмотра"
  ORDER 140

ADD FIELD "parent" OF "Code" AS character 
  FORMAT "x(20)"
  INITIAL ""
  POSITION 16
  MAX-WIDTH 40
  ORDER 150
  MANDATORY

ADD FIELD "procdel" OF "Code" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Процедура удаления"
  POSITION 17
  MAX-WIDTH 40
  COLUMN-LABEL "процедура удаления"
  ORDER 160

ADD FIELD "procedit" OF "Code" AS character 
  DESCRIPTION "процедура редактирования"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "процедура редактирования"
  POSITION 18
  MAX-WIDTH 40
  COLUMN-LABEL "процедура редактирования"
  ORDER 170

ADD FIELD "status_" OF "Code" AS integer 
  DESCRIPTION "Статус"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Статус"
  POSITION 19
  MAX-WIDTH 4
  COLUMN-LABEL "Статус"
  ORDER 180

ADD FIELD "export_" OF "Code" AS logical
  DESCRIPTION "Выгружать запись"
  FORMAT "yes/no"
  POSITION 20
  INITIAL "no"
  LABEL "Выгружать запись"
  COLUMN-LABEL "Выгружать запись"
  ORDER 190
  MAX-WIDTH 1

ADD INDEX "export-rec" ON "Code"
  AREA "Primary_index"
  INDEX-FIELD "export_" ASCENDING

ADD INDEX "pi" ON "Code" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "parent" ASCENDING 
  INDEX-FIELD "code" ASCENDING 

