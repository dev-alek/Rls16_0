ADD TABLE "gds-mercury"
  AREA  "Primary_data"
  DUMP-NAME "gds-mercury"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/gdsmrcd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/gdsmrcw.p" CRC "?" 

ADD FIELD "ID" OF "gds-mercury" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "db-num" OF "gds-mercury" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20
  MANDATORY
  
ADD FIELD "gds-code" OF "gds-mercury" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Код товара TH"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Код товара ТН"
  ORDER 30

ADD FIELD "UUID" OF "gds-mercury" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "GUID" OF "gds-mercury" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "merc-name" OF "gds-mercury" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 60

ADD FIELD "cr-date" OF "gds-mercury" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "update-date" OF "gds-mercury" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 9
  MAX-WIDTH 4
  ORDER 80

ADD FIELD "prod-type" OF "gds-mercury" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 16
  ORDER 90

ADD FIELD "GUID-type" OF "gds-mercury" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 16
  ORDER 100

ADD FIELD "GUID-subtype" OF "gds-mercury" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 12
  MAX-WIDTH 16
  ORDER 110
  
ADD INDEX "pi" ON "gds-mercury" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ID" ASCENDING 
  INDEX-FIELD "db-num" ASCENDING
  
ADD INDEX "finddb" ON "gds-mercury" 
  AREA "Primary_index"
  INDEX-FIELD "db-num" ASCENDING 
  
ADD INDEX "findgds" ON "gds-mercury" 
  AREA "Primary_index"
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "findguid" ON "gds-mercury" 
  AREA "Primary_index"
  INDEX-FIELD "GUID" ASCENDING 

ADD INDEX "finduuid" ON "gds-mercury" 
  AREA "Primary_index"
  INDEX-FIELD "UUID" ASCENDING 

ADD TABLE "vsd"
  AREA "Doc"
  DUMP-NAME "vsd"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/vsdd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/vsdw.p" CRC "?"

ADD FIELD "ID" OF "vsd" AS integer 
  FORMAT ">"
  INITIAL "0"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "db-num" OF "vsd" AS integer 
  FORMAT ">"
  INITIAL "0"
  LABEL "База данных создания"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "База данных создания"
  ORDER 20
  MANDATORY
  
ADD FIELD "UUID" OF "vsd" AS character 
  FORMAT "x(36)"
  INITIAL ""
  LABEL "UUID ВСД"
  POSITION 4
  MAX-WIDTH 72
  COLUMN-LABEL "UUID ВСД"
  ORDER 30

ADD FIELD "economic-sub" OF "vsd" AS character 
  FORMAT "x(255)"
  INITIAL ""
  LABEL "Хоз. субъект"
  POSITION 5
  MAX-WIDTH 510
  COLUMN-LABEL "Хоз. субъект"
  ORDER 40

ADD FIELD "date-cr" OF "vsd" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Дата оформления"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Дата оформления"
  ORDER 50

ADD FIELD "date-out" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Дата выробатки"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Дата выробатки"
  ORDER 60

ADD FIELD "type-prod" OF "vsd" AS character 
  FORMAT "x(255)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 510
  ORDER 70

ADD FIELD "expiry-date-2" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Срок годости 2"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "Срок годости 2"
  ORDER 80

ADD FIELD "qnty" OF "vsd" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Количество"
  POSITION 11
  MAX-WIDTH 17
  COLUMN-LABEL "Количество"
  DECIMALS 2
  ORDER 110

ADD FIELD "expiry-out-date" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Срок выпуска"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "Срок выпуска"
  ORDER 120

ADD FIELD "num-part" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Номер партии"
  POSITION 13
  MAX-WIDTH 16
  COLUMN-LABEL "Номер партии"
  ORDER 130

ADD FIELD "note" OF "vsd" AS character 
  FORMAT "x(255)"
  INITIAL ""
  LABEL "Примечание"
  POSITION 14
  MAX-WIDTH 510
  COLUMN-LABEL "Примечание"
  ORDER 140

ADD FIELD "msg-err" OF "vsd" AS character 
  FORMAT "x(255)"
  INITIAL ""
  LABEL "Описание ошибки"
  POSITION 15
  MAX-WIDTH 510
  COLUMN-LABEL "Описание ошибки"
  ORDER 150

ADD FIELD "vsd-num" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Номер ВСД"
  POSITION 16
  MAX-WIDTH 16
  COLUMN-LABEL "Номер ВСД"
  ORDER 160

ADD FIELD "expiry-date" OF "vsd"  AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Срок годности"
  POSITION 17
  MAX-WIDTH 4
  COLUMN-LABEL "Срок годности"
  ORDER 170

ADD FIELD "vsd-type" OF "vsd" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Тип ВСД"
  POSITION 18
  MAX-WIDTH 16
  COLUMN-LABEL "Тип ВСД"
  ORDER 180

ADD FIELD "part-key" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Ключ партии"
  POSITION 19
  MAX-WIDTH 16
  COLUMN-LABEL "Ключ партии"
  ORDER 190

ADD FIELD "status_" OF "vsd" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Статус ВСД"
  POSITION 20
  MAX-WIDTH 16
  COLUMN-LABEL "Статус ВСД"
  ORDER 200

ADD FIELD "obj-type" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 21
  MAX-WIDTH 16
  ORDER 210

ADD FIELD "obj-code" OF "vsd" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 22
  MAX-WIDTH 4
  ORDER 220

ADD FIELD "gds-code" OF "vsd" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 23
  MAX-WIDTH 4
  ORDER 230
  
ADD FIELD "fact-datetime" OF "vsd" AS DATETIME-TZ 
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  POSITION 24
  MAX-WIDTH 8
  ORDER 240

ADD FIELD "cli-code" OF "vsd" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 25
  MAX-WIDTH 4
  ORDER 260

ADD FIELD "cli-type" OF "vsd" AS character
  FORMAT "x(30)"
  INITIAL ""
  POSITION 26
  MAX-WIDTH 60
  ORDER 270

ADD FIELD "gds-guid" OF "vsd" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "GUID товара"
  POSITION 27
  MAX-WIDTH 80
  COLUMN-LABEL "GUID товара"
  ORDER 280

ADD FIELD "gds-name-merc" OF "vsd" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Наименование товара в Меркурии"
  POSITION 28
  MAX-WIDTH 16
  ORDER 250

ADD INDEX "pi" ON "vsd" 
  AREA "Doc_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ID" ASCENDING 
  INDEX-FIELD "db-num" ASCENDING 

ADD INDEX "finddb" ON "vsd" 
  AREA "Doc_Index"
  INDEX-FIELD "db-num" ASCENDING   
  
ADD INDEX "finduuid" ON "vsd" 
  AREA "Doc_Index"
  INDEX-FIELD "UUID" ASCENDING 
  
ADD INDEX "findobj" ON "vsd" 
  AREA "Doc_Index"
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "obj-type" ASCENDING 

ADD INDEX "findsts" ON "vsd" 
  AREA "Doc_Index"
  INDEX-FIELD "status_" ASCENDING 

ADD INDEX "findgdscode" ON "vsd" 
  AREA "Doc_Index"
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "finddate" ON "vsd" 
  AREA "Doc_Index"
  INDEX-FIELD "fact-datetime" ASCENDING 
  
