ADD TABLE "tran-fuel"
  AREA "Cheque"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Топливные транзакции"
  DESCRIPTION "Топливные транзакции"
  DUMP-NAME "tran-fuel"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/tran-fd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/tran-fw.p" CRC "?" 

ADD FIELD "id" OF "tran-fuel" AS integer 
  DESCRIPTION "Номер записи"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Номер записи"
  POSITION 2
  MAX-WIDTH 4
  ORDER 20

ADD FIELD "db-num" OF "tran-fuel" AS integer 
  DESCRIPTION "Номер БД: 0 -- главная, > 0 -- удаленные`Numb DB`Numar BD"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Номер БД"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "БД"
  ORDER 10
  MANDATORY

ADD FIELD "tran-num" OF "tran-fuel" AS integer 
  DESCRIPTION "Номер транзакции IFSF"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Номер транзакции IFSF"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30
  MANDATORY

ADD FIELD "trk-num" OF "tran-fuel" AS integer 
  DESCRIPTION "Индекс ТРК. Индекс колонки, на которой была пролита доза."
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Индекс ТРК"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40
  MANDATORY

ADD FIELD "nozzle-num" OF "tran-fuel" AS integer 
  DESCRIPTION "Индекс пистолета. Индекс пистолета, на котором была отпущена доза"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Индекс пистолета"
  POSITION 6
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "volume" OF "tran-fuel" AS decimal 
  DESCRIPTION "Объем пролитого топлива. Количество топлива, которое было пролито."
  FORMAT ">>>>>>9.99"
  INITIAL "0"
  LABEL "Объем пролитого топлива"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60

ADD FIELD "money" OF "tran-fuel" AS decimal 
  DESCRIPTION "Объем пролитого топлива. Количество топлива, которое было пролито(в руб)"
  FORMAT ">>>>>>9.99"
  INITIAL "0"
  LABEL "Объем пролитого топлива"
  POSITION 8
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 70

ADD FIELD "req-volume" OF "tran-fuel" AS decimal 
  DESCRIPTION "Объем заказанного топлива. Количество топлива, которое было заказано(и возможно оплачено)"
  FORMAT ">>>>>>9.99"
  INITIAL "0"
  LABEL "Объем заказанного топлива"
  POSITION 9
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 80

ADD FIELD "req-money" OF "tran-fuel" AS decimal 
  DESCRIPTION "Объем заказанного топлива. Количество топлива, которое был заказано. Объем указывается в минимальных денежных единицах (в руб)"
  FORMAT ">>>>>>9.99"
  INITIAL "0"
  LABEL "Объем заказанного топлива"
  POSITION 10
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 90

ADD FIELD "pay-mode" OF "tran-fuel" AS integer 
  DESCRIPTION "Режим оплаты пролитого топлива. 1 - постоплата, 2 - предоплата"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Режим оплаты пролитого топлива"
  POSITION 11
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "price" OF "tran-fuel" AS decimal 
  DESCRIPTION "Цена, в соответствии с которой рассчитана сумма налитой дозы"
  FORMAT ">>>>>>9.99"
  INITIAL "0"
  LABEL "Цена топлива"
  POSITION 13
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 120

ADD FIELD "pay-code" OF "tran-fuel" AS integer 
  DESCRIPTION "Код платежа, по которому был оформлен заказ."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Код платежа"
  POSITION 14
  MAX-WIDTH 4
  ORDER 130

ADD FIELD "date-beg" OF "tran-fuel" AS datetime 
  DESCRIPTION "Дата и время начала транзакции"
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Дата и время начала транзакции"
  POSITION 15
  MAX-WIDTH 8
  ORDER 140

ADD FIELD "date-end" OF "tran-fuel" AS datetime 
  DESCRIPTION "Дата и время окончания транзакции"
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Дата и время окончания транзакции"
  POSITION 16
  MAX-WIDTH 8
  ORDER 150

ADD FIELD "uuid" OF "tran-fuel" AS character 
  DESCRIPTION "Uuid записи"
  FORMAT "x(36)"
  INITIAL ""
  LABEL "Uuid записи"
  POSITION 18
  MAX-WIDTH 72
  ORDER 170
  MANDATORY

ADD FIELD "client-money" OF "tran-fuel" AS decimal 
  DESCRIPTION "Сумма, которую заплатил клиент за топливо"
  FORMAT ">>>>>>9.99"
  INITIAL "0"
  LABEL "Деньги клиента"
  POSITION 19
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 180

ADD FIELD "transfer-from" OF "tran-fuel" AS integer 
  DESCRIPTION "Номер ТРК, с которой был оформлен перевод транзакции"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Номер ТРК"
  POSITION 20
  MAX-WIDTH 4
  ORDER 190

ADD FIELD "fuel-code" OF "tran-fuel" AS integer 
  DESCRIPTION "Код топлива, которое было пролито."
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Код топлива"
  POSITION 21
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "obj-code" OF "tran-fuel" AS integer 
  DESCRIPTION "Код магазина"
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Код магазина"
  POSITION 22
  MAX-WIDTH 4
  ORDER 200

ADD FIELD "cash-num" OF "tran-fuel" AS integer 
  DESCRIPTION "Номер кассы в текущей БД"
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Номер кассы"
  POSITION 23
  MAX-WIDTH 4
  ORDER 210

ADD FIELD "num-cheq" OF "tran-fuel" AS integer 
  DESCRIPTION "Номер чека"
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Номер чека"
  POSITION 24
  MAX-WIDTH 4
  ORDER 160
  MANDATORY

ADD FIELD "uuid-cheq" OF "tran-fuel" AS character 
  DESCRIPTION "Uuid чека"
  FORMAT "x(36)"
  INITIAL ""
  LABEL "Uuid чека"
  POSITION 25
  MAX-WIDTH 72
  ORDER 220
  MANDATORY

ADD INDEX "pi" ON "tran-fuel" 
  AREA "Cheque_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "uuid" ASCENDING 
  INDEX-FIELD "uuid-cheq" ASCENDING 

ADD INDEX "date" ON "tran-fuel" 
  AREA "Cheque_Index"
  INDEX-FIELD "date-beg" ASCENDING 
  INDEX-FIELD "date-end" ASCENDING 

ADD INDEX "num-cheq" ON "tran-fuel" 
  AREA "Cheque_Index"
  INDEX-FIELD "num-cheq" ASCENDING 

ADD INDEX "obj-code" ON "tran-fuel" 
  AREA "Cheque_Index"
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "cash-num" ASCENDING 
  INDEX-FIELD "date-beg" ASCENDING 

ADD INDEX "uuid-cheq" ON "tran-fuel" 
  AREA "Cheque_Index"
  INDEX-FIELD "uuid-cheq" ASCENDING 

.
PSC
cpstream=1251
.
