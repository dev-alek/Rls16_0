ADD TABLE "c-CashBook"
  AREA "History"
  LABEL "Кассовые книги"
  DESCRIPTION "Кассовые книги"
  DUMP-NAME "c-cashbook"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/ccashbd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/ccashbw.p" CRC "?" 

ADD FIELD "id" OF "c-CashBook" AS int64 
  DESCRIPTION "id"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "id"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "id"
  ORDER 10
  MANDATORY

ADD FIELD "ext-code" OF "c-CashBook" AS character 
  DESCRIPTION "ext-code"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "ext-code"
  POSITION 3
  MAX-WIDTH 16
  COLUMN-LABEL "ext-code"
  ORDER 20

ADD FIELD "CashBookName" OF "c-CashBook" AS character 
  DESCRIPTION "Наименование"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Наименование"
  POSITION 4
  MAX-WIDTH 16
  COLUMN-LABEL "Наименование"
  ORDER 30

ADD FIELD "RuleOsn" OF "c-CashBook" AS character 
  DESCRIPTION "Правило заполнения графы ""Основание"""
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Прав. запол."
  POSITION 6
  MAX-WIDTH 24
  COLUMN-LABEL "Прав.заполн."
  ORDER 50

ADD FIELD "RulePril" OF "c-CashBook" AS character 
  DESCRIPTION "Правило заполнения графы ""Приложение"""
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Прав. запол."
  POSITION 7
  MAX-WIDTH 80
  COLUMN-LABEL "Прав. запол."
  ORDER 60

ADD FIELD "Status_" OF "c-CashBook" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Статус"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "Статус"
  ORDER 90

ADD FIELD "Credit" OF "c-CashBook" AS character 
  DESCRIPTION "Значение для заполнения поля «кредит»"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "кредит"
  POSITION 12
  MAX-WIDTH 16
  COLUMN-LABEL "кредит"
  ORDER 100

ADD FIELD "FlagSepCash" OF "c-CashBook" AS logical 
  DESCRIPTION "Отдельный ПКО для каждой кассы"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Отд. для кажд. кассы"
  POSITION 13
  MAX-WIDTH 1
  COLUMN-LABEL "Отде. каж. кассы"
  ORDER 70

ADD FIELD "FlagSepFull" OF "c-CashBook" AS logical 
  DESCRIPTION "Раздельно НП и ТНП"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Раздельно НП и ТНП"
  POSITION 14
  MAX-WIDTH 1
  COLUMN-LABEL "Раздельно НП и ТНП"
  ORDER 80

ADD FIELD "Debit" OF "c-CashBook" AS character 
  DESCRIPTION "Значение для заполнения поля «дебет»"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "дебит"
  POSITION 15
  MAX-WIDTH 16
  COLUMN-LABEL "дебит"
  ORDER 110

ADD FIELD "chip-num" OF "c-CashBook" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 16
  MAX-WIDTH 4
  ORDER 121
  MANDATORY

ADD FIELD "corr-date" OF "c-CashBook" AS date 
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 17
  MAX-WIDTH 4
  ORDER 131

ADD FIELD "corr-time" OF "c-CashBook" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 18
  MAX-WIDTH 4
  ORDER 141

ADD FIELD "corr-user-db-num" OF "c-CashBook" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 19
  MAX-WIDTH 4
  ORDER 150
  MANDATORY

ADD FIELD "corr-user-name" OF "c-CashBook" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 20
  MAX-WIDTH 16
  ORDER 160

ADD FIELD "action" OF "c-CashBook" AS integer 
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 21
  MAX-WIDTH 4
  ORDER 170

ADD FIELD "is-del" OF "c-CashBook" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 22
  MAX-WIDTH 16
  ORDER 180

ADD INDEX "id" ON "c-CashBook" 
  AREA "History_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 
  INDEX-FIELD "chip-num" ASCENDING 

