  INITIAL ""
  LABEL "Имя"
  POSITION 7
  MAX-WIDTH 16
  ORDER 70
  MANDATORY

ADD FIELD "corr-date" OF "c-goods-attr-any" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Дата коррекции"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Дата коррекции"
  ORDER 80

ADD FIELD "corr-time" OF "c-goods-attr-any" AS integer 
  DESCRIPTION "Время в секундах от начала суток"
