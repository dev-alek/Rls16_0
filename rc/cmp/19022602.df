  AREA "Primary_data"
  INDEX-FIELD "corr-user-name" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 

ADD TABLE "c-goods-attr-any"
  AREA "History"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "ИСТОРИЯ атрибутов товара"
