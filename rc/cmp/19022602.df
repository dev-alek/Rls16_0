ADD TABLE "c-counter"
  AREA "Primary_data"
  DUMP-NAME "c-counter"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/ccountd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/ccountw.p" CRC "?" 

ADD FIELD "file-name" OF "c-counter" AS character 
  DESCRIPTION "Имя таблицы"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Имя таблицы"
  POSITION 3
  MAX-WIDTH 60
  COLUMN-LABEL "Имя таблицы"
  ORDER 20
  MANDATORY

ADD FIELD "key" OF "c-counter" AS character 
  DESCRIPTION "Ключ записи"
  FORMAT "x(100)"
  INITIAL ""
  LABEL "Ключ записи"
  POSITION 4
  MAX-WIDTH 200
  COLUMN-LABEL "Ключ записи"
  ORDER 30
  MANDATORY

ADD FIELD "code" OF "c-counter" AS character 
  DESCRIPTION "Код Счетчика"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Код Счетчика"
  POSITION 5
  MAX-WIDTH 80
  COLUMN-LABEL "Код Счетчика"
  ORDER 40
  MANDATORY

ADD FIELD "name" OF "c-counter" AS character 
  DESCRIPTION "Наименование счетчика"
  FORMAT "x(100)"
  INITIAL ""
  LABEL "Наименование счетчика"
  POSITION 6
  MAX-WIDTH 200
  COLUMN-LABEL "Наименование счетчика"
  ORDER 50

ADD FIELD "CountValue" OF "c-counter" AS int64 
  DESCRIPTION "Значение счетчика"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Значение счетчика"
  POSITION 7
  MAX-WIDTH 8
  COLUMN-LABEL "Значение счетчика"
  ORDER 60

ADD FIELD "Rule" OF "c-counter" AS character 
  DESCRIPTION "Правила"
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Правила"
  POSITION 8
  MAX-WIDTH 100
  COLUMN-LABEL "Правила"
  ORDER 70

ADD FIELD "sysInfo" OF "c-counter" AS character 
  DESCRIPTION "Системная информация"
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Системная информация"
  POSITION 9
  MAX-WIDTH 100
  COLUMN-LABEL "Системная информация"
  ORDER 80

ADD FIELD "chip-num" OF "c-counter" AS int64 
  DESCRIPTION "Chip-num"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "chip-num"
  POSITION 14
  MAX-WIDTH 8
  COLUMN-LABEL "chip-num"
  ORDER 104
  MANDATORY

ADD FIELD "corr-date" OF "c-counter" AS date 
  DESCRIPTION "Дата корректировки"
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "corr-date"
  POSITION 15
  MAX-WIDTH 4
  COLUMN-LABEL "corr-date"
  ORDER 103

ADD FIELD "corr-time" OF "c-counter" AS int64 
  DESCRIPTION "Время корректировки"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "corr-time"
  POSITION 16
  MAX-WIDTH 8
  COLUMN-LABEL "corr-time"
  ORDER 102

ADD FIELD "corr-user-db-num" OF "c-counter" AS int64 
  DESCRIPTION "Corr-user-db-num"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "corr-user-db-num"
  POSITION 17
  MAX-WIDTH 8
  COLUMN-LABEL "Corr-user-db-num"
  ORDER 101
  MANDATORY

ADD FIELD "corr-user-name" OF "c-counter" AS character 
  DESCRIPTION "Corr-user-name"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "corr-user-name"
  POSITION 18
  MAX-WIDTH 16
  COLUMN-LABEL "corr-user-name"
  ORDER 100

ADD FIELD "is-del" OF "c-counter" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 29
  MAX-WIDTH 16
  ORDER 250

ADD FIELD "action" OF "c-counter" AS integer 
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 30
  MAX-WIDTH 4
  ORDER 150

ADD FIELD "db" OF "c-counter" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 31
  MAX-WIDTH 4
  ORDER 260
  MANDATORY

ADD INDEX "pi" ON "c-counter" 
  AREA "Primary_data"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db" ASCENDING 
