  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 10
  MAX-WIDTH 4
  ORDER 90

ADD FIELD "is-del" OF "c-sr-izmerenia-attr" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 11
  MAX-WIDTH 16
  ORDER 100

ADD INDEX "pi" ON "c-sr-izmerenia-attr" 
  AREA "History_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "node-code" ASCENDING 
  INDEX-FIELD "attr-code" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 
  INDEX-FIELD "chip-num" ASCENDING 

ADD INDEX "corr-user-db-num" ON "c-sr-izmerenia-attr" 
  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING 

ADD INDEX "corr-user-name" ON "c-sr-izmerenia-attr" 
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 

ADD INDEX "pi-2" ON "c-sr-izmerenia-attr" 
  AREA "History_Index"
  INDEX-FIELD "node-code" ASCENDING 
  INDEX-FIELD "attr-code" ASCENDING 
  INDEX-FIELD "corr-date" ASCENDING 
  INDEX-FIELD "corr-time" ASCENDING 
  INDEX-FIELD "corr-user-db-num" ASCENDING 

ADD TABLE "sr-izmerenia-attr"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  DUMP-NAME "sr-izmerenia-attr"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/srizmad.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/srizmaw.p" CRC "?" 

ADD FIELD "node-code" OF "sr-izmerenia-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "node-code"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "attr-code" OF "sr-izmerenia-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 16
  ORDER 20
  MANDATORY

ADD FIELD "attr-value" OF "sr-izmerenia-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30

ADD INDEX "pi" ON "sr-izmerenia-attr" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "node-code" ASCENDING 
  INDEX-FIELD "attr-code" ASCENDING 

