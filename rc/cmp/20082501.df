UPDATE FIELD "reserve1-char" OF "db"
  INITIAL "23"

ADD TABLE "auto-section"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Секция автотранспорта"
  DUMP-NAME "auto-section"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/auto-tsd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/auto-tsw.p" CRC "?" 

ADD FIELD "auto-num" OF "auto-section" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Номер машины"
  POSITION 2
  MAX-WIDTH 40
  COLUMN-LABEL "Номер машины"
  ORDER 10
  MANDATORY

ADD FIELD "section-num" OF "auto-section" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Номер секции"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Номер секции"
  ORDER 20
  MANDATORY

ADD FIELD "section-depth" OF "auto-section" AS decimal 
  DESCRIPTION "Толщина стенки горловины"
  FORMAT ">>,>>9.999"
  INITIAL "0"
  LABEL "Толщина стенки горловины"
  POSITION 5
  MAX-WIDTH 17
  COLUMN-LABEL "Толщина стенки горловины"
  DECIMALS 2
  ORDER 40

ADD FIELD "diameter" OF "auto-section" AS decimal 
  DESCRIPTION "для круглой горловины"
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Диаметр"
  POSITION 6
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50

ADD FIELD "diameter-min" OF "auto-section" AS decimal 
  DESCRIPTION "Диаметр горловины малой оси эллипса"
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Диаметр малой оси"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60

ADD FIELD "diameter-max" OF "auto-section" AS decimal 
  DESCRIPTION "Диаметр горловины большой оси эллипса"
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Диаметр большой оси"
  POSITION 8
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 70

ADD FIELD "length" OF "auto-section" AS decimal 
  DESCRIPTION "Длина горловины для прямоугольной или квадратной"
  FORMAT ">>,>>9.99"
  INITIAL "0"
  LABEL "Длина"
  POSITION 9
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 80

ADD FIELD "width" OF "auto-section" AS decimal 
  DESCRIPTION "Ширина горловины для прямоугольной или квадратной"
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Ширина"
  POSITION 10
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 90

ADD FIELD "brutto-qnty" OF "auto-section" AS decimal 
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Вместимость"
  POSITION 11
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 100

ADD FIELD "add-volume" OF "auto-section" AS decimal 
  FORMAT "->>,>>9.999"
  INITIAL "0"
  POSITION 12
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 110

ADD INDEX "pi" ON "auto-section" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "auto-num" ASCENDING 
  INDEX-FIELD "section-num" ASCENDING 

ADD TABLE "auto-section-attr"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
