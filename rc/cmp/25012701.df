ADD TABLE "shift-period"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Контр. значения НП по периодам"
  DESCRIPTION "Контрольные значения НП по периодам в смене."
  DUMP-NAME "shift-period"

ADD FIELD "obj-type" OF "shift-period" AS character 
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 2
  MAX-WIDTH 6
  COLUMN-LABEL "Тип"
  ORDER 10
  MANDATORY

ADD FIELD "obj-code" OF "shift-period" AS integer 
  DESCRIPTION "Код объекта - уникальный внутри конкретного справочника`Obj. code`Cod obiect "
  FORMAT "99999"
  INITIAL "0"
  LABEL "Код объекта"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код"
  ORDER 20
  MANDATORY

ADD FIELD "shift-num" OF "shift-period" AS integer 
  DESCRIPTION "Порядок смены в сменном дне`Order`Order "
  FORMAT ">9"
  INITIAL "0"
  LABEL "&Порядок смен"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Порядок смен"
  ORDER 30
  MANDATORY

ADD FIELD "shift-date" OF "shift-period" AS date 
  DESCRIPTION "дата начала смены`&Shift date`&Data turei"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "&Дата смены"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "&Дата смены"
  ORDER 40
  MANDATORY

ADD FIELD "period-num" OF "shift-period" AS integer 
  DESCRIPTION "Порядковый номер периода внутри смены"
  FORMAT ">9"
  INITIAL "0"
  LABEL "Номер периода"
  POSITION 6
  MAX-WIDTH 4
  ORDER 50
  MANDATORY

ADD FIELD "pl-code" OF "shift-period" AS integer 
  DESCRIPTION "`Bar-cod`Bar-cod"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Бар-код"
  POSITION 7
  MAX-WIDTH 4
  ORDER 60
  MANDATORY

ADD FIELD "gds-code" OF "shift-period" AS integer 
  DESCRIPTION "уникальный код товара`Gds code`Cod marfii"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Код товара"
  POSITION 8
  MAX-WIDTH 4
  ORDER 70
  MANDATORY

ADD FIELD "period-type" OF "shift-period" AS integer 
  DESCRIPTION "0 – «От инициализации до закрытия смены, без приема НП»;1 – «От инициализации до приема НП»;2 – «От открытия смены до закрытия смены»;3 – «От открытия смены до приема НП»;4 – «От приема НП до приема НП»;5 - «От приема НП до закрытия смены»."
  FORMAT "9"
  INITIAL "0"
  LABEL "Тип периода"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80
  MANDATORY

ADD FIELD "period-name" OF "shift-period" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Наименование периода"
  POSITION 10
  MAX-WIDTH 100
  COLUMN-LABEL "Период в смене"
  ORDER 90

ADD FIELD "ost-density" OF "shift-period" AS decimal 
  DESCRIPTION "плотность остатка нефтепродукта в резервуаре, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Плотность остатка НП"
  POSITION 11
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 100

ADD FIELD "ost-temperature" OF "shift-period" AS decimal 
  DESCRIPTION "температура остатка нефтепродукта в резервуаре, ?С"
  FORMAT "->>9.9<<"
  INITIAL "0"
  LABEL "Температура остатка НП"
  POSITION 12
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 110

ADD FIELD "ost-mass" OF "shift-period" AS decimal 
  DESCRIPTION "масса остатка нефтепродукта в резервуаре, кг"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Масса остатка НП"
  POSITION 13
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 120

ADD FIELD "ost-density15" OF "shift-period" AS decimal 
  DESCRIPTION "плотность остатка в резервуаре, приведенная к 15 ?С, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Приведенная плотность остатка НП"
  POSITION 14
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 130

ADD FIELD "ost-volume15" OF "shift-period" AS decimal 
  DESCRIPTION "объем остатка НП в резервуаре, приведенный к 15 ?С, л"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Приведенный объем остатка НП"
  POSITION 15
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 140

ADD FIELD "income-mass" OF "shift-period" AS decimal 
  DESCRIPTION "масса по ТТН в документе прихода НП, кг"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Масса по ТТН по приходу"
  POSITION 16
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 150

ADD FIELD "income-density15" OF "shift-period" AS decimal 
  DESCRIPTION "плотность НП при 15 ?С по паспорту в документе прихода НП, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Плотность НП по паспорту в приходе"
  POSITION 17
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 160

ADD FIELD "income-volume15" OF "shift-period" AS decimal 
  DESCRIPTION "объем принятого в АЦ НП, л"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Объем принятого в АЦ НП"
  POSITION 18
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 170

ADD FIELD "control-density" OF "shift-period" AS decimal 
  DESCRIPTION "контрольная плотность НП в резервуаре, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Контрольная плотность НП"
  POSITION 19
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 180

ADD FIELD "last-density" OF "shift-period" AS decimal 
  DESCRIPTION "последняя рассчитанная контрольная плотность НП в резервуаре, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Последняя плотность НП"
  POSITION 20
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 190

ADD FIELD "sales-density" OF "shift-period" AS decimal 
  DESCRIPTION "плотность реализации НП за период, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Плотность реализации НП"
  POSITION 21
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 200

ADD FIELD "sales-mass" OF "shift-period" AS decimal 
  DESCRIPTION "масса реализации НП за период, кг"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Масса реализации НП"
  POSITION 22
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 210

ADD FIELD "sales-volume" OF "shift-period" AS decimal 
  DESCRIPTION "объем реализации НП за период, л"
  FORMAT "->>,>>>,>>9.<<<"
  INITIAL "0"
  LABEL "Объем реализации НП"
  POSITION 23
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 220

ADD FIELD "sales-temperature" OF "shift-period" AS decimal 
  DESCRIPTION "средняя температура реализации НП за период, ?С"
  FORMAT "->>9.9<<"
  INITIAL "0"
  LABEL "Температура реализации НП"
  POSITION 24
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 230

ADD FIELD "sales-density15" OF "shift-period" AS decimal 
  DESCRIPTION "плотность реализации НП за период, приведенная к 15 ?С, г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Приведенная плотность реализации НП"
  POSITION 25
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 240

ADD FIELD "delta-density" OF "shift-period" AS decimal 
  DESCRIPTION "отклонение (разница) плотностей НП за период (плотности реализации НП за период, приведенной к 15 ?С и контрольной плотности НП в резервуаре), г/см3"
  FORMAT ">>>9.99<<"
  INITIAL "0"
  LABEL "Отклонение плотностей НП"
  POSITION 26
  MAX-WIDTH 25
  DECIMALS 10
  ORDER 250

ADD INDEX "pi" ON "shift-period" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "period-num" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "obj-gds" ON "shift-period" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "obj-pl-gds" ON "shift-period" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 
  INDEX-FIELD "gds-code" ASCENDING 
  INDEX-FIELD "pl-code" ASCENDING 

ADD INDEX "obj-shift" ON "shift-period" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "shift-date" ASCENDING 
  INDEX-FIELD "shift-num" ASCENDING 

.
PSC
cpstream=1251
.
