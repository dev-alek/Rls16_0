ADD TABLE "Cash-param-hist"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Параметры на кассе"
  DUMP-NAME "cash-param-hist"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/cashpahd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/cashpahw.p" CRC "?" 

ADD FIELD "cash-num" OF "Cash-param-hist" AS integer 
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Номер кассы"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Номер кассы"
  ORDER 20
  MANDATORY

ADD FIELD "param_group" OF "Cash-param-hist" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Группа параметров"
  POSITION 4
  MAX-WIDTH 40
  COLUMN-LABEL "Группа параметров"
  ORDER 30
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "param_name" OF "Cash-param-hist" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Параметр"
  POSITION 5
  MAX-WIDTH 60
  COLUMN-LABEL "Параметр"
  ORDER 40
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "param_value" OF "Cash-param-hist" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Значение параметра"
  POSITION 6
  MAX-WIDTH 40
  COLUMN-LABEL "Значение параметра"
  ORDER 50

ADD FIELD "description" OF "Cash-param-hist" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Описание"
  POSITION 7
  MAX-WIDTH 100
  COLUMN-LABEL "Описание"
  ORDER 60

ADD FIELD "tstamp" OF "Cash-param-hist" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Штамп времени"
  POSITION 8
  MAX-WIDTH 17
  COLUMN-LABEL "Штамр времение"
  DECIMALS 2
  ORDER 70

ADD FIELD "obj-type" OF "Cash-param-hist" AS character 
  FORMAT "x(3)"
  INITIAL ""
  LABEL "obj-type"
  POSITION 9
  MAX-WIDTH 6
  COLUMN-LABEL "obj-type"
  ORDER 80
  MANDATORY

ADD FIELD "obj-code" OF "Cash-param-hist" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "obj-code"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "obj-code"
  ORDER 90
  MANDATORY

ADD FIELD "param_section" OF "Cash-param-hist" AS character 
  DESCRIPTION "Раздел"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Раздел"
  POSITION 12
  MAX-WIDTH 40
  COLUMN-LABEL "Раздел"
  ORDER 110
  MANDATORY

ADD FIELD "param_value_dop" OF "Cash-param-hist" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 16
  ORDER 120

ADD FIELD "device" OF "Cash-param-hist" AS integer 
 FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Устройство"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "Устройство"
  ORDER 130
  MANDATORY

ADD INDEX "pi" ON "Cash-param-hist" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "cash-num" ASCENDING 
  INDEX-FIELD "param_section" ASCENDING 
  INDEX-FIELD "param_group" ASCENDING 
  INDEX-FIELD "param_name" ASCENDING 

.
PSC
cpstream=1251
.
0000002714
