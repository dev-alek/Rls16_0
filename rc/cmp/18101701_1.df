ADD FIELD "sec-vol1" OF "norm-loss" AS decimal
  FORMAT "->>,>>9.99"
  POSITION 10
  INITIAL "0"
  LABEL "Минимальный предел объема АЦ/секции"
  DECIMALS 2
  ORDER 90
  MAX-WIDTH 17

ADD FIELD "sec-vol2" OF "norm-loss" AS decimal
  FORMAT "->>,>>9.99"
  POSITION 11
  INITIAL "0"
  LABEL "Максимальный предел объема АЦ/секции"
  DECIMALS 2
  ORDER 100
  MAX-WIDTH 17

ADD SEQUENCE "s-norm-loss"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no
  MIN-VAL ?
  MAX-VAL ?

