RENAME TABLE "chk-doc-attr" TO "chk-doc-attr_old"

UPDATE TABLE "chk-doc-attr_old"
  TABLE-TRIGGER "DELETE" DELETE
  TABLE-TRIGGER "WRITE" DELETE

ADD TABLE "chk-doc-attr"
  AREA "Cheque"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  LABEL "Атрибуты чека"
  DUMP-NAME "chkdattr"

ADD FIELD "doc-code" OF "chk-doc-attr" AS character 
  DESCRIPTION "уникальный в системе номер чека`Numb`Numar"
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Номер"
  POSITION 2
  MAX-WIDTH 40
  COLUMN-LABEL "Номер"
  ORDER 10
  MANDATORY

ADD FIELD "attr-code" OF "chk-doc-attr" AS character 
  DESCRIPTION "Код атрибута"
  FORMAT "X(8)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 16
  ORDER 20
  MANDATORY

ADD FIELD "attr-value" OF "chk-doc-attr" AS character 
  DESCRIPTION "Значение атрибута"
  FORMAT "X(30)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 60
  ORDER 30

ADD FIELD "out-code" OF "chk-doc-attr" AS character 
  DESCRIPTION "Номер РН`Number EW`Numar NC"
  FORMAT "X(14)"
  INITIAL ?
  LABEL "Номер РН"
  POSITION 5
  MAX-WIDTH 28
  COLUMN-LABEL "Номер РН"
  ORDER 40

ADD FIELD "whole-send-news" OF "chk-doc-attr" AS integer 
  DESCRIPTION "Признак отправки в новости из текущей бд"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Отправилась в новости целой записью"
  POSITION 6
  MAX-WIDTH 4
  ORDER 50

ADD INDEX "pi" ON "chk-doc-attr" 
  AREA "Cheque_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "doc-code" ASCENDING 
  INDEX-FIELD "attr-code" ASCENDING 

ADD INDEX "attrc" ON "chk-doc-attr" 
  AREA "Cheque_Index"
  UNIQUE
  INDEX-FIELD "attr-code" ASCENDING 
  INDEX-FIELD "doc-code" ASCENDING 

ADD INDEX "attrv" ON "chk-doc-attr" 
  AREA "Cheque_Index"
  UNIQUE
  INDEX-FIELD "attr-code" ASCENDING 
  INDEX-FIELD "attr-value" ASCENDING 
  INDEX-FIELD "doc-code" ASCENDING 

ADD INDEX "sale" ON "chk-doc-attr" 
  AREA "Cheque_Index"
  INDEX-FIELD "out-code" ASCENDING 

.
PSC
cpstream=1251
.
0000001689
