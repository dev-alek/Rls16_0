RENAME TABLE "marking" TO "marking_old"

UPDATE TABLE "marking_old"
  TABLE-TRIGGER "DELETE" DELETE
  TABLE-TRIGGER "WRITE" DELETE

RENAME TABLE "marking-lines" TO "marking-lines_old"

UPDATE TABLE "marking-lines_old"
  TABLE-TRIGGER "DELETE" DELETE
  TABLE-TRIGGER "WRITE" DELETE

ADD TABLE "marking"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DUMP-NAME "marking"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/markd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/markw.p" CRC "?" 

ADD FIELD "sts" OF "marking" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 6
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "unit" OF "marking" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "gds-ext-id" OF "marking" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "gds-ext-id"
  POSITION 8
  MAX-WIDTH 16
  ORDER 70

ADD FIELD "gds-code" OF "marking" AS integer 
  FORMAT "999999999"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80

ADD FIELD "unit-ext" OF "marking" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 16
  ORDER 50

ADD FIELD "comment" OF "marking" AS character 
  FORMAT "x(32)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 64
  ORDER 90

ADD FIELD "loc-key" OF "marking" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 16
  ORDER 110

ADD FIELD "box-qnty" OF "marking" AS decimal 
  FORMAT "->>,>>9.999"
  INITIAL "0"
  POSITION 14
  MAX-WIDTH 18
  DECIMALS 3
  ORDER 100

ADD FIELD "obj-type" OF "marking" AS character 
  FORMAT "x(3)"
  INITIAL ""
  POSITION 15
  MAX-WIDTH 6
  ORDER 120

ADD FIELD "obj-code" OF "marking" AS integer 
  FORMAT "99999"
  INITIAL "0"
  POSITION 16
  MAX-WIDTH 4
  ORDER 130

ADD FIELD "mark" OF "marking" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 18
  MAX-WIDTH 100
  ORDER 140
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "mark-parent" OF "marking" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 19
  MAX-WIDTH 100
  ORDER 150
  CASE-SENSITIVE

ADD FIELD "last-change" OF "marking" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Дата и время последнего изменения"
  POSITION 17
  MAX-WIDTH 8
  COLUMN-LABEL "Изменен"
  ORDER 160

ADD INDEX "pi" ON "marking" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "mark" ASCENDING 

ADD INDEX "gds-code" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "lock-key" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "loc-key" ASCENDING 

ADD INDEX "Objsts" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "sts" ASCENDING 

ADD INDEX "parent" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "mark-parent" ASCENDING 

ADD INDEX "sts" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "sts" ASCENDING 

ADD INDEX "last-change" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "last-change" ASCENDING 

ADD INDEX "sts-change" ON "marking" 
  AREA "Primary_index"
  INDEX-FIELD "sts" ASCENDING
  INDEX-FIELD "last-change" ASCENDING 

ADD TABLE "marking-lines"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DUMP-NAME "marking-line"


ADD FIELD "type-m" OF "marking-lines" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "obj-type" OF "marking-lines" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "obj-type"
  POSITION 11
  MAX-WIDTH 16
  ORDER 100
  MANDATORY

ADD FIELD "obj-code" OF "marking-lines" AS integer 
  FORMAT "999999999"
  INITIAL "0"
  LABEL "obj-code"
  POSITION 12
  MAX-WIDTH 4
  ORDER 110
  MANDATORY

ADD FIELD "mark" OF "marking-lines" AS character 
  FORMAT "x(50)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 100
  ORDER 210
  MANDATORY
  CASE-SENSITIVE

ADD FIELD "in-code" OF "marking-lines" AS character 
  FORMAT "x(14)"
  INITIAL ""
  LABEL "in-code"
  POSITION 16
  MAX-WIDTH 28
  ORDER 150
  MANDATORY

ADD FIELD "out-code" OF "marking-lines" AS character 
  FORMAT "x(14)"
  INITIAL ""
  LABEL "out-code"
  POSITION 17
  MAX-WIDTH 28
  ORDER 160
  MANDATORY

ADD FIELD "part-code" OF "marking-lines" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "part-code"
  POSITION 18
  MAX-WIDTH 40
  ORDER 170
  MANDATORY

ADD FIELD "gds-code" OF "marking-lines" AS integer 
  FORMAT "999999999"
  INITIAL "0"
  POSITION 24
  MAX-WIDTH 4
  ORDER 120
  MANDATORY

ADD FIELD "sts" OF "marking-lines" AS integer 
  FORMAT "99999"
  INITIAL "0"
  POSITION 25
  MAX-WIDTH 4
  ORDER 180

ADD FIELD "doc-level" OF "marking-lines" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 26
  MAX-WIDTH 4
  ORDER 190

ADD FIELD "fact-order" OF "marking-lines" AS decimal 
  DESCRIPTION "порядковый номер документа"
  FORMAT "999999999999999999999999999999.999999999999"
  INITIAL "0"
  POSITION 27
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 200

ADD FIELD "prt-code" OF "marking-lines" AS integer 
  DESCRIPTION "Код узла дерева признаков."
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "Признак"
  POSITION 28
  MAX-WIDTH 4
  COLUMN-LABEL "Признак"
  ORDER 220
  MANDATORY

ADD INDEX "pi" ON "marking-lines" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "mark" ASCENDING 
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "gds-code" ASCENDING 
  INDEX-FIELD "in-code" ASCENDING 
  INDEX-FIELD "out-code" ASCENDING 
  INDEX-FIELD "part-code" ASCENDING 
  INDEX-FIELD "prt-code" ASCENDING 

ADD INDEX "gds-code" ON "marking-lines" 
  AREA "Primary_index"
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "obj" ON "marking-lines" 
  AREA "Primary_index"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 

ADD INDEX "part" ON "marking-lines" 
  AREA "Primary_index"
  INDEX-FIELD "gds-code" ASCENDING 
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "in-code" ASCENDING 
  INDEX-FIELD "out-code" ASCENDING 
  INDEX-FIELD "part-code" ASCENDING 
  INDEX-FIELD "prt-code" ASCENDING 

ADD INDEX "mark" ON "marking-lines" 
  AREA "Primary_index"
  INDEX-FIELD "mark" ASCENDING 

ADD INDEX "out-code" ON "marking-lines" 
  AREA "Primary_index"
  INDEX-FIELD "out-code" ASCENDING 

ADD SEQUENCE "s-c-mark-chip-num"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no
  MIN-VAL ?
  MAX-VAL ?

