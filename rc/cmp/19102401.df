ADD TABLE "devisPC"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Устройства"
  DESCRIPTION "Устройства на PC"
  DUMP-NAME "devis"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/devisd.p" CRC "?"
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/devisw.p" CRC "?"


ADD FIELD "DB-num" OF "devisPC" AS integer 
  DESCRIPTION "DB-num"
  FORMAT "->,>>>,>>9"
  INITIAL ?
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "DB-num"
  ORDER 10
  MANDATORY

ADD FIELD "id" OF "devisPC" AS int64 
  DESCRIPTION "id"
  FORMAT "->,>>>,>>9"
  INITIAL ?
  LABEL "id"
  POSITION 3
  MAX-WIDTH 8
  COLUMN-LABEL "id"
  ORDER 20
  MANDATORY

ADD FIELD "namepc" OF "devisPC" AS character 
  DESCRIPTION "Имя ПК"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Имя ПК"
  POSITION 4
  MAX-WIDTH 60
  COLUMN-LABEL "Имя ПК"
  ORDER 30

ADD FIELD "ModelPC" OF "devisPC" AS character 
  DESCRIPTION "Модель ПК"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Модель ПК"
  POSITION 5
  MAX-WIDTH 60
  COLUMN-LABEL "Модель ПК"
  ORDER 40

ADD FIELD "modeldevice" OF "devisPC" AS character 
  DESCRIPTION "Модель диска"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Модель диска"
  POSITION 6
  MAX-WIDTH 60
  COLUMN-LABEL "Модель диска"
  ORDER 50

ADD FIELD "SerialNumber" OF "devisPC" AS character 
  DESCRIPTION "serial number"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "serial number"
  POSITION 7
  MAX-WIDTH 60
  COLUMN-LABEL "serial number"
  ORDER 60

ADD INDEX "pi" ON "devisPC" 
  AREA "Primary_index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "DB-num" ASCENDING 
  INDEX-FIELD "id" ASCENDING 

ADD TABLE "devisPC-attr"
  AREA "Primary_data"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  DUMP-NAME "devispc-attr"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/devisad.p" CRC "?"
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/devisaw.p" CRC "?"

ADD FIELD "db-num" OF "devisPC-attr" AS integer 
  DESCRIPTION "db-num"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "db-num"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "db-num"
  ORDER 10
  MANDATORY

ADD FIELD "id" OF "devisPC-attr" AS int64 
  DESCRIPTION "id"
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  LABEL "id"
  POSITION 3
  MAX-WIDTH 8
  COLUMN-LABEL "id"
  ORDER 20
  MANDATORY

ADD FIELD "attr-code" OF "devisPC-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 16
  ORDER 30
  MANDATORY

ADD FIELD "date" OF "devisPC-attr" AS date 
  DESCRIPTION "Дата теста"
  FORMAT "99/99/99"
  INITIAL ?
  LABEL "Дата теста"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Дата теста"
  ORDER 40
  MANDATORY

ADD FIELD "attr-value" OF "devisPC-attr" AS character 
  DESCRIPTION "Значение"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Значение"
  POSITION 6
  MAX-WIDTH 80
  COLUMN-LABEL "Значение"
  ORDER 50

ADD FIELD "attr-Raw-value" OF "devisPC-attr" AS character 
  DESCRIPTION "attr-Raw-value"
  FORMAT "x(40)"
  INITIAL ""
  LABEL "attr-Raw-value"
  POSITION 7
  MAX-WIDTH 80
  COLUMN-LABEL "attr-Raw-value"
  ORDER 60

ADD FIELD "type" OF "devisPC-attr" AS character 
  DESCRIPTION "Тип"
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Тип"
  POSITION 8
  MAX-WIDTH 30
  COLUMN-LABEL "Тип"
  ORDER 70

ADD FIELD "time_" OF "devisPC-attr" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 9
  MAX-WIDTH 4
  ORDER 80
  MANDATORY

ADD FIELD "tresh" OF "devisPC-attr" AS character 
  FORMAT "x(8)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 16
  ORDER 90

ADD INDEX "pi" ON "devisPC-attr" 
  AREA "Primary_data"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "attr-code" ASCENDING 
  INDEX-FIELD "date" ASCENDING 
  INDEX-FIELD "time_" ASCENDING 

ADD INDEX "date-time" ON "devisPC-attr" 
  AREA "Primary_index"
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "date" ASCENDING 
  INDEX-FIELD "time_" ASCENDING

UPDATE FIELD "reserve1-char" OF "db"
  INITIAL "16"

ADD SEQUENCE "s-devisPC-id"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no
  MIN-VAL ?
  MAX-VAL ?

.
PSC
cpstream=1251
.
