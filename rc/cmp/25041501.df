  FORMAT "X(20)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 40
  ORDER 40
  LABEL "Значение атрибута"

ADD FIELD "chip-num" OF "c-order-doc-attr" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 101
  MAX-WIDTH 4
  ORDER 1010
  MANDATORY 
  LABEL "Уникальный код"

ADD FIELD "corr-date" OF "c-order-doc-attr" AS date
  FORMAT "99/99/99"
  INITIAL ?
  POSITION 102
  MAX-WIDTH 4
  ORDER 1020
  LABEL "Дата действия"

ADD FIELD "corr-time" OF "c-order-doc-attr" AS integer
  FORMAT "->,>>>,>>9"
  INITIAL "0"
  POSITION 103
  MAX-WIDTH 4
