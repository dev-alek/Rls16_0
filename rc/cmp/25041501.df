ADD INDEX "code-value" ON "order-doc-attr"
  AREA "Orders_Index"
  INDEX-FIELD "attr-code" ASCENDING
  INDEX-FIELD "attr-value" ASCENDING

ADD INDEX "pi" ON "order-doc-attr"
  AREA "Orders_Index"
  UNIQUE 
