ADD TABLE "order-doc"
  AREA "Orders"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Заказы"
  DESCRIPTION "Предзаказы поставщикам"
  DUMP-NAME "order-doc"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/orddocd.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/orddocw.p" CRC "?" 

ADD FIELD "db-num" OF "order-doc" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Номер БД"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "БД"
  ORDER 10
  MANDATORY

ADD FIELD "obj-type" OF "order-doc" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Тип объекта"
  POSITION 3
  MAX-WIDTH 16
  COLUMN-LABEL "Тип"
  ORDER 20
  MANDATORY

ADD FIELD "obj-code" OF "order-doc" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Код объекта"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Объект"
  ORDER 30
  MANDATORY

ADD FIELD "doc-code" OF "order-doc" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Код TH"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Код заказа в TH"
  ORDER 40
  MANDATORY

ADD FIELD "order-item" OF "order-doc" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "№ заказа"
  POSITION 6
  MAX-WIDTH 40
  COLUMN-LABEL "Номер заказа в ИС УРТ"
  ORDER 50

ADD FIELD "doc-date" OF "order-doc" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS"
  INITIAL ?
  LABEL "Дата и время создания заказа"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Создан"
  ORDER 60
  MANDATORY

ADD FIELD "order-date" OF "order-doc" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Дата заказа"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Дата заказа"
  ORDER 70
  MANDATORY

ADD FIELD "cli-type" OF "order-doc" AS character 
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Тип поставщика"
  POSITION 9
  MAX-WIDTH 16
  COLUMN-LABEL "Тип контрагента"
  ORDER 80
  MANDATORY

ADD FIELD "cli-code" OF "order-doc" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Код поставщика"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "Код поставщика"
  ORDER 90
  MANDATORY

ADD FIELD "cli-name" OF "order-doc" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Поставщик"
  POSITION 11
  MAX-WIDTH 16
  COLUMN-LABEL "Поставщик"
  ORDER 100

ADD FIELD "contract-code" OF "order-doc" AS integer 
  FORMAT "9999999"
  INITIAL "0"
  LABEL "Код контракта"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "Код контракта"
  ORDER 110

ADD FIELD "contract-prn-code" OF "order-doc" AS character 
  DESCRIPTION "Наименование договора"
  FORMAT "X(16)"
  INITIAL ""
  LABEL "Номер"
  POSITION 13
  MAX-WIDTH 42
  COLUMN-LABEL "Номер"
  ORDER 120

ADD FIELD "sts" OF "order-doc" AS integer 
  DESCRIPTION "класс ibs/th/str/order/sts/order.cls"
  FORMAT "9"
  INITIAL "0"
  LABEL "Статус заказа"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "Статус"
  ORDER 130
  MANDATORY

ADD FIELD "user-id" OF "order-doc" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Исполнитель"
  POSITION 15
  MAX-WIDTH 4
  COLUMN-LABEL "Исполнитель"
  ORDER 140

ADD FIELD "info" OF "order-doc" AS character 
  DESCRIPTION "Текстовый комментарий с информацией"
  FORMAT "x(100)"
  INITIAL ""
  LABEL "Дополнительная информация"
  POSITION 16
  MAX-WIDTH 200
  COLUMN-LABEL "Доп. инфо"
  ORDER 150

ADD FIELD "params" OF "order-doc" AS character 
  DESCRIPTION "Параметры, по которым был сформирован заказ"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Параметры заказа"
  POSITION 17
  MAX-WIDTH 16
  COLUMN-LABEL "Параметры заказа"
  ORDER 160

ADD INDEX "pi" ON "order-doc" 
  AREA "Orders_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "doc-code" ASCENDING 

ADD INDEX "cli" ON "order-doc" 
  AREA "Orders_Index"
  INDEX-FIELD "cli-type" ASCENDING 
  INDEX-FIELD "cli-code" ASCENDING 

ADD INDEX "contract" ON "order-doc" 
  AREA "Orders_Index"
  INDEX-FIELD "contract-code" ASCENDING 

ADD INDEX "date-sts" ON "order-doc" 
  AREA "Orders_Index"
  INDEX-FIELD "order-date" ASCENDING 
  INDEX-FIELD "sts" ASCENDING 

ADD INDEX "doc-date-sts" ON "order-doc" 
  AREA "Orders_Index"
  INDEX-FIELD "doc-date" ASCENDING 
  INDEX-FIELD "sts" ASCENDING 

ADD INDEX "obj-doc" ON "order-doc" 
  AREA "Orders"
  INDEX-FIELD "obj-type" ASCENDING 
  INDEX-FIELD "obj-code" ASCENDING 
  INDEX-FIELD "doc-code" ASCENDING 

ADD INDEX "order-item" ON "order-doc" 
  AREA "Orders_Index"
  INDEX-FIELD "order-item" ASCENDING 

ADD INDEX "sts" ON "order-doc" 
  AREA "Orders_Index"
  INDEX-FIELD "sts" ASCENDING 

ADD TABLE "order-line"
  AREA "Orders"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!,!odbc,*"
  CAN-LOAD "!,!odbc,*"
  LABEL "Товары по заказу"
  DESCRIPTION "Товары по заказу"
  DUMP-NAME "order-line"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/ordlined.p" CRC "?" 
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/ordlinew.p" CRC "?" 

ADD FIELD "db-num" OF "order-line" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Номер БД"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "БД"
  ORDER 10
  MANDATORY

ADD FIELD "doc-code" OF "order-line" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Код заказа"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Код заказа"
  ORDER 20
  MANDATORY

ADD FIELD "line-num" OF "order-line" AS integer 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Номер"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Номер"
  ORDER 30
  MANDATORY

ADD FIELD "gds-code" OF "order-line" AS integer 
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Код товара"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Код товара"
  ORDER 40
  MANDATORY

ADD FIELD "artic" OF "order-line" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "Артикул"
  POSITION 6
  MAX-WIDTH 40
  COLUMN-LABEL "Артикул"
  ORDER 50

ADD FIELD "prod-type" OF "order-line" AS character 
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Тип производителя"
  POSITION 7
  MAX-WIDTH 40
  COLUMN-LABEL "Тип"
  ORDER 60

ADD FIELD "prod-code" OF "order-line" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Производитель"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "Производитель"
  ORDER 70

ADD FIELD "order-qnty" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.9999"
  INITIAL "0"
  LABEL "Количество предзаказа"
  POSITION 9
  MAX-WIDTH 17
  COLUMN-LABEL "Количество"
  DECIMALS 2
  ORDER 91

ADD FIELD "fact-qnty" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.9999"
  INITIAL "0"
  LABEL "Количество подтвержено"
  POSITION 10
  MAX-WIDTH 17
  COLUMN-LABEL "Количество"
  DECIMALS 2
  ORDER 90

ADD FIELD "rest" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Текущий остаток товара"
  POSITION 11
  MAX-WIDTH 17
  COLUMN-LABEL "Остаток"
  DECIMALS 2
  ORDER 100

ADD FIELD "sales" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Объем продаж за период"
  POSITION 12
  MAX-WIDTH 17
  COLUMN-LABEL "Продажи за период"
  DECIMALS 2
  ORDER 110

ADD FIELD "average-sales" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Среднесуточные продажи за период"
  POSITION 13
  MAX-WIDTH 17
  COLUMN-LABEL "Среднесуточные продажи"
  DECIMALS 2
  ORDER 120

ADD FIELD "stock-goods" OF "order-line" AS integer 
  FORMAT "->>>,>>>,>>9"
  INITIAL "0"
  LABEL "Запас товара в днях"
  POSITION 14
  MAX-WIDTH 17
  COLUMN-LABEL "Запас товара"
  ORDER 130

ADD FIELD "volume-goods" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Расчетный объем заказа"
  POSITION 15
  MAX-WIDTH 17
  COLUMN-LABEL "Расчетный объем"
  DECIMALS 2
  ORDER 140

ADD FIELD "volume-stock" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Расчетный объем заказа с учетом минимального запаса"
  POSITION 16
  MAX-WIDTH 17
  COLUMN-LABEL "Расчетный объем c учетом запаса"
  DECIMALS 2
  ORDER 150

ADD FIELD "min-stock" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Минимальный запас"
  POSITION 17
  MAX-WIDTH 17
  COLUMN-LABEL "Минимальный запас"
  DECIMALS 2
  ORDER 160

ADD FIELD "garant-stock" OF "order-line" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Гарантийный запас"
  POSITION 18
  MAX-WIDTH 17
  COLUMN-LABEL "Гарантийный запас"
  DECIMALS 2
  ORDER 170

ADD FIELD "promo" OF "order-line" AS logical 
  FORMAT "Да/Нет"
  INITIAL "false"
  LABEL "Товар участвует в промоакци"
  POSITION 19
  MAX-WIDTH 10
  COLUMN-LABEL "Участвует в промоакци"
  ORDER 180

ADD INDEX "pi" ON "order-line" 
  AREA "Orders_Index"
  UNIQUE
  PRIMARY
  INDEX-FIELD "db-num" ASCENDING 
  INDEX-FIELD "doc-code" ASCENDING 
  INDEX-FIELD "line-num" ASCENDING 

ADD INDEX "atric" ON "order-line" 
  AREA "Orders_Index"
  INDEX-FIELD "artic" ASCENDING 

ADD INDEX "gds" ON "order-line" 
  AREA "Orders_Index"
  INDEX-FIELD "gds-code" ASCENDING 

ADD INDEX "prod" ON "order-line" 
  AREA "Orders_Index"
  INDEX-FIELD "prod-type" ASCENDING 
  INDEX-FIELD "prod-code" ASCENDING 

ADD SEQUENCE "s-order-code"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no

