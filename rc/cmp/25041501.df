  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-name" ON "c-order-doc-attr"
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

