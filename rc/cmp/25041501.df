ADD FIELD "corr-user-name" OF "c-order-doc-attr" AS character
  FORMAT "x(8)"
  INITIAL ""
  POSITION 105
  MAX-WIDTH 16
  ORDER 1050
  LABEL "Изменил"

ADD FIELD "action" OF "c-order-doc-attr" AS integer
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  POSITION 106
  MAX-WIDTH 4
  ORDER 1060
  LABEL "Описание действия"

ADD FIELD "is-del" OF "c-order-doc-attr" AS logical
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 107
  MAX-WIDTH 16
  ORDER 1070
  LABEL ""

ADD INDEX "code-value" ON "c-order-doc-attr"
  AREA "History_Index"
  INDEX-FIELD "attr-code" ASCENDING
  INDEX-FIELD "attr-value" ASCENDING

