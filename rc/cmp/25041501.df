  POSITION 3
  MAX-WIDTH 4
  ORDER 20
  MANDATORY 
  LABEL "Код TH"
  COLUMN-LABEL "Код заказа в TH"

ADD FIELD "attr-code" OF "order-doc-attr" AS character
