UPDATE TABLE "marking-attr"
  TABLE-TRIGGER "DELETE" OVERRIDE PROCEDURE "trg/markattd.p" CRC "?"
  TABLE-TRIGGER "WRITE" OVERRIDE PROCEDURE "trg/markattw.p" CRC "?"

ADD TABLE "c-marking-attr"
  AREA "Schema Area"
  LABEL "История изменений по marking-attr"
  CAN-CREATE "!,!odbc,*"
  CAN-DELETE "!,!odbc,*"
  CAN-READ "!,*"
  CAN-WRITE "!,!odbc,*"
  CAN-DUMP "!odbc,*"
  CAN-LOAD "!odbc,*"
  DUMP-NAME "c-marking-attr"

ADD FIELD "attr-code" OF "c-marking-attr" AS character
  DESCRIPTION ""
  FORMAT "x(16)"
  INITIAL ""
  MANDATORY 
  LABEL ?

ADD FIELD "attr-value" OF "c-marking-attr" AS character
  DESCRIPTION ""
  FORMAT "x(32)"
  INITIAL ""
  MANDATORY 
  LABEL ?

ADD FIELD "mark" OF "c-marking-attr" AS character
  DESCRIPTION ""
  FORMAT "x(50)"
  INITIAL ""
  MANDATORY 
  LABEL ?

ADD FIELD "corr-user-db-num" OF "c-marking-attr" AS INTEGER
  DESCRIPTION "Номер БД"
  FORMAT ">>>>9"
  INITIAL ?
  MAX-WIDTH 4
  MANDATORY 
  LABEL "Номер БД"
  COLUMN-LABEL "Номер БД"

ADD FIELD "chip-num" OF "c-marking-attr" AS INTEGER
  FORMAT ">,>>>,>>9"
  INITIAL 0
  MAX-WIDTH 4
  MANDATORY 
  LABEL "Щепка"
  COLUMN-LABEL "Щепка"

ADD FIELD "corr-time" OF "c-marking-attr" AS INTEGER
  DESCRIPTION "Время изменения в секундах"
  FORMAT ">>>,>>9"
  INITIAL 0
  MAX-WIDTH 4
  LABEL "Время изменения в секундах"
  COLUMN-LABEL "Время"

ADD FIELD "corr-date" OF "c-marking-attr" AS DATE
  FORMAT "99/99/9999"
  INITIAL ?
  MAX-WIDTH 4
  LABEL "Дата коррекции"
  COLUMN-LABEL "Номер БД"

ADD FIELD "corr-user-name" OF "c-marking-attr" AS CHARACTER
  DESCRIPTION "Имя пользователя"
  FORMAT "X(8)"
  INITIAL ""
  MAX-WIDTH 16
  LABEL "Имя пользователя"
  COLUMN-LABEL "Имя"

ADD FIELD "action" OF "c-marking-attr" AS integer 
  DESCRIPTION "Описание действия"
  FORMAT "99"
  INITIAL "0"
  LABEL "Описание действия"
  POSITION 55
  MAX-WIDTH 4
  ORDER 500

ADD FIELD "is-del" OF "c-marking-attr" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL ""
  POSITION 56
  MAX-WIDTH 16
  ORDER 510

ADD INDEX "pi" ON "c-marking-attr"
  AREA "History_Index"
  UNIQUE 
  PRIMARY 
  INDEX-FIELD "mark" ASCENDING
  INDEX-FIELD "attr-code" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING
  INDEX-FIELD "chip-num" ASCENDING

ADD INDEX "corr-user-db-num" ON "c-marking-attr"
  AREA "History_Index"
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD INDEX "corr-user-name" ON "c-marking-attr"
  AREA "History_Index"
  INDEX-FIELD "corr-user-name" ASCENDING
  INDEX-FIELD "corr-user-db-num" ASCENDING

ADD SEQUENCE "s-c-mark-attr-chip-num"
  INITIAL 0
  INCREMENT 1
  CYCLE-ON-LIMIT no
  MIN-VAL ?
  MAX-VAL ?

.
PSC
cpstream=1251
.
